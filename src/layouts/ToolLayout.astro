---
import BaseLayout from './BaseLayout.astro';
import tools from '../data/tools.json';
import categories from '../data/categories.json';

interface Props {
  tool: {
    slug: string;
    name: string;
    description: string;
    category: string;
    tags: string[];
    icon: string;
    dateAdded: string;
  };
}

const { tool } = Astro.props;
const adsenseId = 'ca-pub-7704630721055432';
const isProd = import.meta.env.PROD;

const relatedTools = tools
  .filter(t => t.slug !== tool.slug)
  .map(t => ({
    ...t,
    score:
      (t.category === tool.category ? 3 : 0) +
      t.tags.filter(tag => tool.tags.includes(tag)).length,
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 6);

const categoryTools = tools
  .filter(t => t.category === tool.category && t.slug !== tool.slug)
  .slice(0, 8);

const activeCategory = categories.find(c => c.slug === tool.category);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": tool.name,
  "description": tool.description,
  "url": `https://utilifygrid.com/tools/${tool.slug}`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "datePublished": tool.dateAdded,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home",        "item": "https://utilifygrid.com" },
      { "@type": "ListItem", "position": 2, "name": tool.category, "item": `https://utilifygrid.com/category/${tool.category}` },
      { "@type": "ListItem", "position": 3, "name": tool.name }
    ]
  }
};
---

<BaseLayout
  title={`${tool.name} – Free Online Tool | UtilifyGrid`}
  description={tool.description}
  canonicalUrl={`/tools/${tool.slug}`}
  ogType="website"
  structuredData={structuredData}
>
  <div style="max-width:80rem; margin:0 auto; padding:2rem 1rem 3rem;">

    <!-- Breadcrumb -->
    <nav style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1.5rem;" aria-label="Breadcrumb">
      <ol style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap; list-style:none; padding:0; margin:0;">
        <li><a href="/" style="color:var(--text-secondary); text-decoration:none; transition:color 0.15s;" onmouseover="this.style.color='#1D4ED8';" onmouseout="this.style.color='var(--text-secondary)';">Home</a></li>
        <li style="color:var(--text-muted);">›</li>
        <li><a href={`/category/${tool.category}`} style="color:var(--text-secondary); text-decoration:none; text-transform:capitalize; transition:color 0.15s;" onmouseover="this.style.color='#1D4ED8';" onmouseout="this.style.color='var(--text-secondary)';">{tool.category.replace(/-/g, ' ')}</a></li>
        <li style="color:var(--text-muted);">›</li>
        <li style="color:var(--text-primary); font-weight:500;">{tool.name}</li>
      </ol>
    </nav>

    <div style="display:grid; grid-template-columns:1fr; gap:2rem;" class="tl-grid">

      <!-- LEFT SIDEBAR -->
      <aside class="tl-sidebar-left">
        <div style="position:sticky; top:5.5rem; display:flex; flex-direction:column; gap:1rem;">

          <div style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; overflow:hidden;">
            <div style="padding:0.75rem 1rem; border-bottom:1px solid var(--border);">
              <span style="font-size:0.7rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em;">Categories</span>
            </div>
            <nav aria-label="Tool categories" style="padding:0.375rem 0;">
              {categories.map(cat => {
                const isActive = cat.slug === tool.category;
                const catTools = tools.filter(t => t.category === cat.slug);
                return (
                  <div class="sidebar-cat-section">
                    <div style="display:flex; align-items:center;">
                      <a
                        href={`/category/${cat.slug}`}
                        class={isActive ? 'sidebar-cat-row active' : 'sidebar-cat-row'}
                        style={`flex:1; display:flex; align-items:center; gap:0.5rem; padding:0.45rem 0.75rem 0.45rem 0.875rem; text-decoration:none; transition:background 0.12s; min-width:0; ${isActive ? 'background:rgba(29,78,216,0.08); border-left:2px solid #1D4ED8;' : 'border-left:2px solid transparent;'}`}
                      >
                        <span style="font-size:1rem; flex-shrink:0; line-height:1;">{cat.icon}</span>
                        <span style={`font-size:0.82rem; font-weight:${isActive ? '700' : '500'}; color:${isActive ? '#1D4ED8' : 'var(--text-secondary)'}; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; line-height:1.3;`}>
                          {cat.name}
                        </span>
                        <span style="margin-left:auto; font-size:0.65rem; color:var(--text-muted); flex-shrink:0; padding-right:0.125rem;">{catTools.length}</span>
                      </a>
                      {isActive && categoryTools.length > 0 && (
                        <button
                          class="sidebar-expand-btn"
                          data-target={`cat-tools-${cat.slug}`}
                          aria-expanded="true"
                          aria-label={`Toggle ${cat.name} tools`}
                          style="padding:0.45rem 0.625rem; background:transparent; border:none; cursor:pointer; color:var(--text-muted); flex-shrink:0; transition:color 0.12s;"
                        >
                          <svg class="expand-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" style="transition:transform 0.2s;">
                            <path d="M2 4.5l4 3 4-3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                      )}
                    </div>
                    {isActive && categoryTools.length > 0 && (
                      <div id={`cat-tools-${cat.slug}`} class="cat-tools-list" style="padding:0.25rem 0 0.25rem 2.125rem;">
                        {categoryTools.map(t => (
                          <a
                            href={`/tools/${t.slug}`}
                            class={t.slug === tool.slug ? 'sidebar-tool-link current' : 'sidebar-tool-link'}
                            style={`display:block; padding:0.3rem 0.5rem; border-radius:0.375rem; font-size:0.775rem; line-height:1.35; text-decoration:none; transition:background 0.1s, color 0.1s; ${t.slug === tool.slug ? 'color:var(--text-primary); font-weight:600;' : 'color:var(--text-secondary);'}`}
                          >
                            {t.name}
                          </a>
                        ))}
                        {tools.filter(t => t.category === cat.slug).length > categoryTools.length && (
                          <a href={`/category/${cat.slug}`} style="display:block; padding:0.3rem 0.5rem; font-size:0.75rem; color:#1D4ED8; text-decoration:none; font-weight:600; margin-top:0.125rem;">
                            + {tools.filter(t => t.category === cat.slug).length - categoryTools.length} more →
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                );
              })}
            </nav>
          </div>

          {isProd && (
          <div style="display:flex; justify-content:center;">
            <ins class="adsbygoogle" style="display:inline-block;width:160px;height:600px;"
              data-ad-client={adsenseId} data-ad-slot="2345678901" aria-label="Advertisement"></ins>
          </div>
          )}
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <article class="tl-main">

        <!-- Tool title row with star button -->
        <div style="margin-bottom:1.5rem;">
          <div style="display:flex; align-items:flex-start; gap:0.875rem;">
            <span style="font-size:2.5rem; line-height:1; flex-shrink:0;">{tool.icon}</span>
            <div style="flex:1; min-width:0;">
              <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:0.75rem;">
                <h1 style="font-family:'Sora',sans-serif; font-size:clamp(1.4rem,3vw,1.9rem); font-weight:700; color:var(--text-primary); margin:0; min-width:0;">{tool.name}</h1>
                <!-- Star / favourite button — flex-shrink:0 keeps it from ever wrapping -->
                <button
                  class="tool-fav-btn"
                  data-fav-slug={tool.slug}
                  data-tool-name={tool.name}
                  aria-pressed="false"
                  aria-label={`Add ${tool.name} to favourites`}
                  title="Save to favourites"
                  style="flex-shrink:0; margin-top:0.25rem;"
                >
                  <svg class="star-icon" width="14" height="14" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 1.5l2.22 4.52 4.99.72-3.61 3.52.85 4.97L9 12.77l-4.45 2.46.85-4.97L1.79 6.74l4.99-.72L9 1.5z"/>
                  </svg>
                  <span class="fav-btn-label">Save</span>
                </button>
              </div>
              <p style="font-size:0.9rem; color:var(--text-secondary); margin:0.3rem 0 0;">{tool.description}</p>
            </div>
          </div>
        </div>

        <!-- Tool workspace -->
        <div class="tool-card-surface" style="border-radius:1rem; padding:1.5rem; margin-bottom:2rem;">
          <slot name="tool" />
        </div>

        {isProd && (
        <!-- Post-result ad -->
        <div style="display:flex; justify-content:center; margin-bottom:2rem;">
          <ins class="adsbygoogle" style="display:block;" data-ad-client={adsenseId} data-ad-slot="3456789012"
            data-ad-format="auto" data-full-width-responsive="true" aria-label="Advertisement"></ins>
        </div>
        )}

        <div class="seo-section" style="margin-bottom:1.5rem;"><slot name="how-to-use" /></div>
        <div class="seo-section-alt" style="margin-bottom:1.5rem;"><slot name="how-it-works" /></div>
        <div style="margin-bottom:2rem;"><slot name="faq" /></div>

        <!-- Tags -->
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:2rem;">
          {tool.tags.map(tag => (
            <span style="padding:0.2rem 0.75rem; background:var(--bg-surface-2); color:var(--text-secondary); border:1px solid var(--border); border-radius:999px; font-size:0.75rem; font-weight:500;">{tag}</span>
          ))}
        </div>

      </article>

      <!-- RIGHT SIDEBAR -->
      <aside class="tl-sidebar-right">
        <div style="position:sticky; top:5.5rem; display:flex; flex-direction:column; gap:1.5rem;">

          {isProd && (
          <div style="display:flex; justify-content:center;">
            <ins class="adsbygoogle" style="display:inline-block;width:300px;height:250px;"
              data-ad-client={adsenseId} data-ad-slot="4567890123" aria-label="Advertisement"></ins>
          </div>
          )}

          <div style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1rem;">
            <h2 style="font-size:0.72rem; font-weight:700; color:var(--text-muted); margin-bottom:0.75rem; text-transform:uppercase; letter-spacing:0.07em;">Related Tools</h2>
            <div style="display:flex; flex-direction:column; gap:0.25rem;">
              {relatedTools.map(related => (
                <div style="display:flex; align-items:center; gap:0.5rem;">
                  <a href={`/tools/${related.slug}`} class="related-tool-link"
                    style="display:flex; align-items:center; gap:0.75rem; padding:0.5rem; border-radius:0.5rem; text-decoration:none; transition:background 0.15s; flex:1; min-width:0;">
                    <span style="font-size:1.25rem; flex-shrink:0;">{related.icon}</span>
                    <span style="font-size:0.82rem; font-weight:500; color:var(--text-primary); line-height:1.3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{related.name}</span>
                  </a>
                  <!-- Inline star for related tools -->
                  <button
                    class="card-fav-btn"
                    data-fav-slug={related.slug}
                    data-tool-name={related.name}
                    aria-pressed="false"
                    aria-label={`Save ${related.name}`}
                    title="Save to favourites"
                    style="flex-shrink:0; padding:0.3rem;"
                  >
                    <svg width="14" height="14" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M9 1.5l2.22 4.52 4.99.72-3.61 3.52.85 4.97L9 12.77l-4.45 2.46.85-4.97L1.79 6.74l4.99-.72L9 1.5z"/>
                    </svg>
                  </button>
                </div>
              ))}
            </div>
          </div>

          {isProd && (
          <div style="display:flex; justify-content:center;">
            <ins class="adsbygoogle" style="display:inline-block;width:300px;height:250px;"
              data-ad-client={adsenseId} data-ad-slot="5678901234" aria-label="Advertisement"></ins>
          </div>
          )}

        </div>
      </aside>

    </div>

    <!-- More tools grid -->
    <div style="margin-top:3rem; padding-top:2.5rem; border-top:1px solid var(--border);">
      <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">More Tools You Might Like</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(140px,1fr)); gap:0.875rem;">
        {relatedTools.map(related => (
          <div style="position:relative;">
            <a href={`/tools/${related.slug}`} class="tool-card-themed"
              style="display:flex; flex-direction:column; align-items:center; text-align:center; padding:1rem 0.75rem 0.75rem; text-decoration:none;">
              <span style="font-size:1.75rem; margin-bottom:0.4rem;">{related.icon}</span>
              <span style="font-size:0.78rem; font-weight:600; color:var(--text-primary); line-height:1.3;">{related.name}</span>
            </a>
            <button
              class="card-fav-btn grid-fav-btn"
              data-fav-slug={related.slug}
              data-tool-name={related.name}
              aria-pressed="false"
              aria-label={`Save ${related.name}`}
              title="Save to favourites"
            >
              <svg width="12" height="12" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 1.5l2.22 4.52 4.99.72-3.61 3.52.85 4.97L9 12.77l-4.45 2.46.85-4.97L1.79 6.74l4.99-.72L9 1.5z"/>
              </svg>
            </button>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  /* Three-column grid */
  @media (min-width: 1024px) {
    .tl-grid { grid-template-columns: 200px 1fr 280px !important; }
    .tl-sidebar-left  { display: block !important; }
    .tl-sidebar-right { display: block !important; }
  }
  .tl-sidebar-left, .tl-sidebar-right { display: none; }

  /* Tool workspace */
  .tool-card-surface {
    background: var(--bg-surface);
    border: 1.5px solid var(--border);
    box-shadow: var(--shadow-card);
  }
  .tl-main { min-width: 0; }
  .seo-section {
    background: var(--bg-surface); border: 1.5px solid var(--border);
    border-radius: 0.875rem; padding: 1.5rem;
  }
  .seo-section-alt {
    background: var(--bg-surface-2); border: 1.5px solid var(--border);
    border-radius: 0.875rem; padding: 1.5rem;
  }

  /* ── Star button on tool title ── */
  .tool-fav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    border: 1.5px solid var(--border);
    background: var(--bg-surface-2);
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .tool-fav-btn:hover {
    border-color: #F59E0B;
    color: #F59E0B;
    background: rgba(245,158,11,0.08);
  }
  .tool-fav-btn.fav-active {
    background: rgba(245,158,11,0.12);
    border-color: #F59E0B;
    color: #D97706;
  }
  .tool-fav-btn.fav-active .star-icon {
    fill: #F59E0B;
    stroke: #F59E0B;
  }
  .tool-fav-btn.fav-active .fav-btn-label { content: 'Saved'; }

  /* ── Card star buttons (related tools, grid) ── */
  .card-fav-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 0.25rem;
    border-radius: 0.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s, transform 0.15s;
  }
  .card-fav-btn:hover { color: #F59E0B; transform: scale(1.2); }
  .card-fav-btn.fav-active { color: #F59E0B; }
  .card-fav-btn.fav-active svg { fill: #F59E0B; }

  /* Grid card star — positioned top-right */
  .grid-fav-btn {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    padding: 0.3rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    opacity: 0;
    transition: opacity 0.15s, color 0.15s, transform 0.15s;
  }
  div:hover > .grid-fav-btn,
  .grid-fav-btn.fav-active {
    opacity: 1;
  }

  /* ── Fav pop animation ── */
  @keyframes favPop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.35); }
    70%  { transform: scale(0.9); }
    100% { transform: scale(1); }
  }
  .fav-pop { animation: favPop 0.35s ease; }

  /* Sidebar */
  .sidebar-cat-row:hover { background: var(--bg-surface-2) !important; }
  .sidebar-cat-row:hover span:nth-child(2) { color: var(--text-primary) !important; }
  :root.dark .sidebar-cat-row.active {
    background: rgba(59,130,246,0.12) !important;
    border-left-color: #3B82F6 !important;
  }
  :root.dark .sidebar-cat-row.active span:nth-child(2) { color: #60A5FA !important; }
  .sidebar-tool-link:hover { background: var(--bg-surface-2); color: var(--text-primary) !important; }
  .sidebar-tool-link.current { background: var(--bg-surface-2); }
  .sidebar-expand-btn:hover { color: var(--text-primary) !important; }
  .sidebar-expand-btn[aria-expanded="false"] .expand-icon { transform: rotate(-90deg); }
  .cat-tools-list.is-collapsed { display: none; }
  .related-tool-link:hover { background: var(--bg-surface-2); }
  .related-tool-link:hover span:last-child { color: #1D4ED8; }
  :root.dark .related-tool-link:hover span:last-child { color: #60A5FA; }

  /* ── Dark mode overrides ── */
  :root.dark .tool-card-surface [style*="background:#fff"],
  :root.dark .tool-card-surface [style*="background: #fff"],
  :root.dark .tool-card-surface [style*="background:#FFFFFF"],
  :root.dark .seo-section [style*="background:#fff"],
  :root.dark .seo-section [style*="background:#FFFFFF"],
  :root.dark .seo-section-alt [style*="background:#fff"],
  :root.dark .seo-section-alt [style*="background:#FFFFFF"] {
    background: var(--bg-surface-3) !important; border-color: var(--border) !important;
  }
  :root.dark .tool-card-surface [style*="background:#F8FAFC"],
  :root.dark .tool-card-surface [style*="background:#F1F5F9"],
  :root.dark .seo-section [style*="background:#F8FAFC"],
  :root.dark .seo-section-alt [style*="background:#F8FAFC"] {
    background: var(--bg-surface-2) !important; border-color: var(--border) !important;
  }
  :root.dark .tool-card-surface [style*="color:#0F172A"],
  :root.dark .tool-card-surface [style*="color:#1E293B"],
  :root.dark .seo-section [style*="color:#0F172A"],
  :root.dark .seo-section-alt [style*="color:#0F172A"] { color: var(--text-primary) !important; }
  :root.dark .tool-card-surface [style*="color:#475569"],
  :root.dark .tool-card-surface [style*="color:#64748B"],
  :root.dark .seo-section [style*="color:#475569"],
  :root.dark .seo-section [style*="color:#64748B"],
  :root.dark .seo-section-alt [style*="color:#475569"],
  :root.dark .seo-section-alt [style*="color:#64748B"] { color: var(--text-secondary) !important; }
  :root.dark .tool-card-surface [style*="border:1px solid #E2E8F0"],
  :root.dark .tool-card-surface [style*="border:1.5px solid #E2E8F0"],
  :root.dark .seo-section [style*="border:1px solid #E2E8F0"],
  :root.dark .seo-section-alt [style*="border:1px solid #E2E8F0"] { border-color: var(--border) !important; }
  :root.dark .tool-card-surface input,
  :root.dark .tool-card-surface textarea,
  :root.dark .tool-card-surface select {
    background: var(--bg-surface-2) !important; color: var(--text-primary) !important; border-color: var(--border) !important;
  }
  :root.dark .tool-card-surface input::placeholder,
  :root.dark .tool-card-surface textarea::placeholder { color: var(--text-muted) !important; }
  :root.dark .tool-card-surface input:focus,
  :root.dark .tool-card-surface textarea:focus,
  :root.dark .tool-card-surface select:focus {
    border-color: #3B82F6 !important; box-shadow: 0 0 0 3px rgba(59,130,246,0.15) !important;
  }
  :root.dark .seo-section [style*="border:1.5px solid #E2E8F0"] {
    background: var(--bg-surface-2) !important; border-color: var(--border) !important;
  }
  :root.dark .tool-card-surface textarea[readonly] { background: var(--bg-surface-3) !important; }
  :root.dark .tool-card-surface button[style*="background:#fff"],
  :root.dark .tool-card-surface button[style*="background:#FFFFFF"] {
    background: var(--bg-surface-2) !important; border-color: var(--border) !important; color: var(--text-secondary) !important;
  }
  :root.dark .tool-card-surface h2, :root.dark .tool-card-surface h3,
  :root.dark .seo-section h2, :root.dark .seo-section h3,
  :root.dark .seo-section-alt h2, :root.dark .seo-section-alt h3 { color: var(--text-primary) !important; }
  :root.dark [itemtype*="Question"] { background: var(--bg-surface-2) !important; border-color: var(--border) !important; }
  :root.dark [itemtype*="Question"] h3 { color: var(--text-primary) !important; }
  :root.dark [itemtype*="Question"] p { color: var(--text-secondary) !important; }
  :root.dark .tool-card-surface .result-card { background: var(--bg-surface-2) !important; border-color: var(--border) !important; }
  :root.dark .tool-card-surface .result-card .result-value { color: #60A5FA !important; }
  :root.dark .tool-card-surface .btn-primary { background: #3B82F6; }
  :root.dark .tool-card-surface .btn-primary:hover { background: #2563EB; }
  :root.dark .tool-card-surface .btn-secondary { border-color: var(--border); color: var(--text-secondary); }
  :root.dark .tool-card-surface .btn-secondary:hover { background: var(--bg-surface-3); }
  :root.dark .tool-card-surface .toggle-group { background: var(--bg-surface-3); border-color: var(--border); }
  :root.dark .tool-card-surface .toggle-btn { color: var(--text-secondary); }
  :root.dark .tool-card-surface .toggle-btn.active { background: #3B82F6; color: #fff; }
  :root.dark .tool-card-surface .toggle-btn:not(.active):hover { background: var(--bg-surface-2); color: var(--text-primary); }
  :root.dark .tool-card-surface .info-row,
  :root.dark .seo-section-alt .info-row { background: var(--bg-surface-3) !important; border-color: var(--border) !important; }
  :root.dark .tool-card-surface .info-row .info-value,
  :root.dark .seo-section-alt .info-row .info-value { color: var(--text-primary) !important; }
</style>

<script>
  // AdSense — guard against missing script (dev / not yet approved)
  try {
    document.querySelectorAll('.adsbygoogle').forEach(() => {
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    });
  } catch (_) { /* AdSense not loaded */ }

  // Sidebar expand/collapse
  document.querySelectorAll<HTMLButtonElement>('.sidebar-expand-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const list = document.getElementById(btn.dataset.target!);
      if (!list) return;
      const collapsed = list.classList.contains('is-collapsed');
      list.classList.toggle('is-collapsed', !collapsed);
      btn.setAttribute('aria-expanded', String(collapsed));
    });
  });

  // ── Favourite buttons ──────────────────────────────────────
  function attachFavBtn(btn: HTMLButtonElement) {
    const slug = btn.dataset.favSlug!;
    const name = btn.dataset.toolName || slug;

    btn.addEventListener('click', () => {
      const favs = (window as any).UGFavs;
      if (!favs) return;
      favs.toggle(slug);

      // Pop animation
      btn.classList.remove('fav-pop');
      void btn.offsetWidth; // force reflow
      btn.classList.add('fav-pop');
      btn.addEventListener('animationend', () => btn.classList.remove('fav-pop'), { once: true });

      // Update label on tool title button
      if (btn.classList.contains('tool-fav-btn')) {
        const label = btn.querySelector<HTMLElement>('.fav-btn-label');
        if (label) label.textContent = favs.has(slug) ? 'Saved' : 'Save';
        btn.setAttribute('aria-label', favs.has(slug) ? `Remove ${name} from favourites` : `Add ${name} to favourites`);
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-fav-slug]').forEach(attachFavBtn);

  // Shared copy-to-clipboard helper
  (window as any).initCopyBtn = function(selector: string, getTextFn?: (btn: HTMLButtonElement) => string) {
    document.querySelectorAll<HTMLButtonElement>(selector).forEach(btn => {
      btn.addEventListener('click', async () => {
        const text = typeof getTextFn === 'function' ? getTextFn(btn) : (btn.dataset.copy || '');
        if (!text) return;
        await navigator.clipboard.writeText(text);
        const original = btn.textContent || 'Copy';
        btn.textContent = '✓ Copied!';
        btn.classList.add('btn-success');
        setTimeout(() => { btn.textContent = original; btn.classList.remove('btn-success'); }, 2000);
      });
    });
  };
</script>
