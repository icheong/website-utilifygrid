  </style>

  <script>
    /* ══════════════════════════════════════════════════════════════
       OMNIBOX — unified state management
       ══════════════════════════════════════════════════════════════ */

    /* ── Mobile menu ── */
    const mobileBtn  = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerOpen  = document.getElementById('hamburger-icon-open');
    const hamburgerClose = document.getElementById('hamburger-icon-close');
    mobileBtn?.addEventListener('click', () => {
      const open = !mobileMenu?.classList.contains('hidden');
      mobileMenu?.classList.toggle('hidden');
      mobileBtn?.setAttribute('aria-expanded', String(!open));
      mobileBtn?.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      if (hamburgerOpen && hamburgerClose) {
        hamburgerOpen.style.display  = open ? 'none'  : 'block';
        hamburgerClose.style.display = open ? 'block' : 'none';
      }
      if (open) closeAllDropdowns();
    });

    /* ── All Tools categories dropdown (desktop) ── */
    const catsTrigger = document.getElementById('omnibus-cats-trigger') as HTMLButtonElement | null;
    const catsPanel   = document.getElementById('omnibox-cats-panel')   as HTMLElement | null;
    const catsWrapper = document.getElementById('omnibox-wrapper')     as HTMLElement | null;
    let catsClose: ReturnType<typeof setTimeout> | null = null;

    function openCats() {
      if (catsClose) { clearTimeout(catsClose); catsClose = null; }
      closeSuggestions(); closeSuggestionsMobile();
      catsPanel?.classList.add('is-open');
      catsTrigger?.setAttribute('aria-expanded','true');
    }
    function closeCats(d = 0) {
      if (d) {
        catsClose = setTimeout(() => {
          catsPanel?.classList.remove('is-open');
          catsTrigger?.setAttribute('aria-expanded','false');
        }, d);
      } else {
        if (catsClose) { clearTimeout(catsClose); catsClose = null; }
        catsPanel?.classList.remove('is-open');
        catsTrigger?.setAttribute('aria-expanded','false');
      }
    }

    catsTrigger?.addEventListener('click', e => {
      e.stopPropagation();
      catsPanel?.classList.contains('is-open') ? closeCats() : openCats();
    });

    /* ── All Tools categories dropdown (mobile) ── */
    const catsTriggerMobile = document.getElementById('omnibus-cats-trigger-mobile') as HTMLButtonElement | null;
    const catsPanelMobile   = document.getElementById('omnibox-cats-panel-mobile')   as HTMLElement | null;
    let catsCloseMobile: ReturnType<typeof setTimeout> | null = null;

    function openCatsMobile() {
      if (catsCloseMobile) { clearTimeout(catsCloseMobile); catsCloseMobile = null; }
      closeSuggestionsMobile();
      closeSuggestions();
      closeCats();
      catsPanelMobile?.classList.add('is-open');
      catsTriggerMobile?.setAttribute('aria-expanded','true');
    }
    function closeCatsMobile(d = 0) {
      if (d) {
        catsCloseMobile = setTimeout(() => {
          catsPanelMobile?.classList.remove('is-open');
          catsTriggerMobile?.setAttribute('aria-expanded','false');
        }, d);
      } else {
        if (catsCloseMobile) { clearTimeout(catsCloseMobile); catsCloseMobile = null; }
        catsPanelMobile?.classList.remove('is-open');
        catsTriggerMobile?.setAttribute('aria-expanded','false');
      }
    }

    catsTriggerMobile?.addEventListener('click', e => {
      e.stopPropagation();
      catsPanelMobile?.classList.contains('is-open') ? closeCatsMobile() : openCatsMobile();
    });

    /* ── Search suggestions (desktop) ── */
    const omniboxInput      = document.getElementById('omnibox-input')      as HTMLInputElement | null;
    const omniboxSuggestions = document.getElementById('omnibox-suggestions') as HTMLElement | null;
    const omniboxInputMobile      = document.getElementById('omnibox-input-mobile')      as HTMLInputElement | null;
    const omniboxSuggestionsMobile = document.getElementById('omnibox-suggestions-mobile') as HTMLElement | null;
    const allToolsMeta: { slug: string; name: string; icon: string; category: string }[] = (window as any).__UG_TOOLS__ || [];
    let activeIdx = -1;

    function catLabel(cat: string) {
      const map: Record<string, string> = { 'personal-finance':'Personal Finance','business-metrics':'Business Metrics','maths-numbers':'Maths & Numbers','converters':'Converters','health':'Health Tools','web-tools':'Web Tools','text-processing':'Text Processing','ai-web-tools':'AI Web Tools','pdf-tools':'PDF Tools','lexical-tools':'Lexical Tools','randomizers':'Randomizers' };
      return map[cat] || cat;
    }

    function highlightMatch(text: string, query: string): string {
      if (!query) return text;
      const idx = text.toLowerCase().indexOf(query.toLowerCase());
      if (idx === -1) return text;
      const before = text.slice(0, idx);
      const match  = text.slice(idx, idx + query.length);
      const after  = text.slice(idx + query.length);
      return `${before}<mark class="omni-highlight">${match}</mark>${after}`;
    }

    function renderSuggestions(query: string, target: HTMLElement) {
      if (!query || query.length < 1) { target.style.display = 'none'; target.innerHTML = ''; activeIdx = -1; return; }
      const q = query.toLowerCase();
      const matches = allToolsMeta.filter(t =>
        t.name.toLowerCase().includes(q) || t.slug.includes(q) || t.category.includes(q)
      ).slice(0, 8);
      if (!matches.length) { target.style.display = 'none'; target.innerHTML = ''; activeIdx = -1; return; }
      activeIdx = 0;
      target.innerHTML = matches.map((t, i) => `
        <a href="/tools/${t.slug}" class="omni-suggestion${i===0?' is-active':''}" role="option" data-idx="${i}">
          <span class="omni-sug-icon">${t.icon}</span>
          <div class="omni-sug-body">
            <span class="omni-sug-name">${highlightMatch(t.name, query)}</span>
            <span class="omni-sug-cat">${highlightMatch(catLabel(t.category), query)}</span>
          </div>
          <svg class="omni-sug-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 2.5l3.5 3.5-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      `).join('');
      target.style.display = 'block';
      /* Attach mousedown handlers: preventDefault keeps focus in input so blur never fires */
      target.querySelectorAll('.omni-suggestion').forEach(el => {
        el.addEventListener('mousedown', e => {
          e.preventDefault(); /* prevents blur */
        });
        el.addEventListener('click', e => {
          e.preventDefault();
          window.location.href = (el as HTMLAnchorElement).href;
        });
      });
    }

    function closeSuggestions() {
      if (omniboxSuggestions) { omniboxSuggestions.style.display = 'none'; omniboxSuggestions.innerHTML = ''; activeIdx = -1; }
    }
    function closeSuggestionsMobile() {
      if (omniboxSuggestionsMobile) { omniboxSuggestionsMobile.style.display = 'none'; omniboxSuggestionsMobile.innerHTML = ''; }
    }

    function navigateSuggestions(target: HTMLElement, dir: number) {
      const items = target.querySelectorAll('.omni-suggestion');
      if (!items.length) return;
      items[activeIdx]?.classList.remove('is-active');
      activeIdx = (activeIdx + dir + items.length) % items.length;
      items[activeIdx]?.classList.add('is-active');
      (items[activeIdx] as HTMLElement)?.scrollIntoView({ block: 'nearest' });
    }

    /* Desktop input events */
    omniboxInput?.addEventListener('input', e => {
      const val = (e.target as HTMLInputElement).value;
      renderSuggestions(val, omniboxSuggestions!);
      if (val) closeCats();
    });
    omniboxInput?.addEventListener('keydown', e => {
      if (e.key === 'ArrowDown') { e.preventDefault(); navigateSuggestions(omniboxSuggestions!, 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); navigateSuggestions(omniboxSuggestions!, -1); }
      else if (e.key === 'Enter') {
        const active = omniboxSuggestions?.querySelector('.omni-suggestion.is-active') as HTMLAnchorElement | null;
        if (active) { e.preventDefault(); window.location.href = active.href; }
      }
      else if (e.key === 'Escape') { closeSuggestions(); closeCats(); omniboxInput.blur(); }
    });
    omniboxInput?.addEventListener('focus', () => {
      if (omniboxInput.value) renderSuggestions(omniboxInput.value, omniboxSuggestions!);
    });
    omniboxInput?.addEventListener('blur', () => {
      /* Short delay lets mousedown on suggestion fire first (which calls preventDefault) */
      setTimeout(closeSuggestions, 200);
    });

    /* Mobile input events */
    omniboxInputMobile?.addEventListener('input', e => {
      const val = (e.target as HTMLInputElement).value;
      renderSuggestions(val, omniboxSuggestionsMobile!);
      if (val) closeCatsMobile();
    });
    omniboxInputMobile?.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        const active = omniboxSuggestionsMobile?.querySelector('.omni-suggestion.is-active') as HTMLAnchorElement | null;
        if (active) { e.preventDefault(); window.location.href = active.href; }
      }
      else if (e.key === 'Escape') { closeSuggestionsMobile(); closeCatsMobile(); omniboxInputMobile.blur(); }
    });
    omniboxInputMobile?.addEventListener('focus', () => {
      if (omniboxInputMobile.value) renderSuggestions(omniboxInputMobile.value, omniboxSuggestionsMobile!);
    });
    omniboxInputMobile?.addEventListener('blur', () => {
      setTimeout(closeSuggestionsMobile, 200);
    });

    /* ── Keyboard shortcut: / to focus omnibox ── */
    document.addEventListener('keydown', e => {
      if (e.key === '/' && !e.ctrlKey && !e.metaKey && !e.altKey) {
        const tag = (e.target as HTMLElement)?.tagName;
        if (tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') {
          e.preventDefault();
          omniboxInput?.focus();
        }
      }
    });

    /* ── Unified close-all on outside click / scroll / Escape ── */
    function closeAllDropdowns() {
      closeCats();
      closeCatsMobile();
      closeSuggestions();
      closeSuggestionsMobile();
      closeFav();
    }

    document.addEventListener('click', e => {
      const target = e.target as Node;
      if (catsWrapper && !catsWrapper.contains(target)) closeCats();
      if (omniboxSuggestions && !omniboxSuggestions.contains(target) && omniboxInput !== target) closeSuggestions();
      const mobileWrap = document.getElementById('omnibox-mobile-wrap');
      if (mobileWrap && !mobileWrap.contains(target)) {
        closeSuggestionsMobile();
        closeCatsMobile();
      }
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeAllDropdowns();
    });

    let scrollTimer: ReturnType<typeof setTimeout> | null = null;
    window.addEventListener('scroll', () => {
      if (scrollTimer) return;
      scrollTimer = setTimeout(() => {
        closeAllDropdowns();
        scrollTimer = null;
      }, 100);
    }, { passive: true });

    /* ══════════════════════════════════════════════════════════════
       FAVOURITES
       ══════════════════════════════════════════════════════════════ */
    const favTrigger = document.getElementById('fav-nav-trigger') as HTMLButtonElement | null;
    const favPanel   = document.getElementById('fav-nav-panel')   as HTMLElement | null;
    const favWrapper = document.getElementById('fav-nav-wrapper') as HTMLElement | null;
    let favClose: ReturnType<typeof setTimeout> | null = null;

    function openFav()      { if (favClose) { clearTimeout(favClose); favClose = null; } renderFavPanel(); favPanel?.classList.add('is-open'); favTrigger?.setAttribute('aria-expanded','true'); }
    function closeFav(d=0)  { if (d) { favClose = setTimeout(() => { favPanel?.classList.remove('is-open'); favTrigger?.setAttribute('aria-expanded','false'); }, d); } else { if (favClose) { clearTimeout(favClose); favClose = null; } favPanel?.classList.remove('is-open'); favTrigger?.setAttribute('aria-expanded','false'); } }

    favTrigger?.addEventListener('click', e => { e.stopPropagation(); favPanel?.classList.contains('is-open') ? closeFav() : openFav(); });
    let favOpenDelay: ReturnType<typeof setTimeout> | null = null;
    favWrapper?.addEventListener('mouseenter', () => { favOpenDelay = setTimeout(() => openFav(), 200); });
    favWrapper?.addEventListener('mouseleave', () => { if (favOpenDelay) { clearTimeout(favOpenDelay); favOpenDelay = null; } closeFav(150); });
    document.addEventListener('click', e => { if (favWrapper && !favWrapper.contains(e.target as Node)) closeFav(); });

    window.addEventListener('ug:favs-changed', () => { if (favPanel?.classList.contains('is-open')) renderFavPanel(); });

    function renderFavPanel() {
      const list    = document.getElementById('fav-panel-list')!;
      const empty   = document.getElementById('fav-panel-empty')!;
      const footer  = document.getElementById('fav-panel-footer')!;
      const favs    = (window as any).UGFavs?.all() ?? [];
      const allTools: {slug:string;name:string;icon:string;category:string}[] = (window as any).__UG_TOOLS__ ?? [];

      if (favs.length === 0) {
        list.innerHTML = '';
        empty.style.display  = 'block';
        footer.style.display = 'none';
        return;
      }
      empty.style.display  = 'none';
      footer.style.display = 'block';

      const matched = favs
        .map((slug: string) => allTools.find(t => t.slug === slug))
        .filter(Boolean);

      list.innerHTML = '';
      matched.forEach((t: {slug:string;name:string;icon:string;category:string}) => {
        const row = document.createElement('div');
        row.style.cssText = 'display:flex; align-items:center; gap:0.625rem; padding:0.45rem 1rem; transition:background 0.12s;';
        row.onmouseenter = () => row.style.background = 'rgba(255,255,255,0.06)';
        row.onmouseleave = () => row.style.background = 'transparent';

        const link = document.createElement('a');
        link.href = `/tools/${t.slug}`;
        link.style.cssText = 'display:flex; align-items:center; gap:0.625rem; text-decoration:none; flex:1; min-width:0; overflow:hidden;';

        const icon = document.createElement('span');
        icon.style.cssText = 'font-size:1.2rem; flex-shrink:0; line-height:1;';
        icon.textContent = t.icon;

        const name = document.createElement('span');
        name.className = 'fav-panel-name';
        name.style.cssText = 'font-size:0.82rem; font-weight:500; color:#F1F5F9; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;';
        name.textContent = t.name;
        link.onmouseenter = () => name.style.color = '#F59E0B';
        link.onmouseleave = () => name.style.color = '#F1F5F9';

        link.appendChild(icon);
        link.appendChild(name);

        const removeBtn = document.createElement('button');
        removeBtn.style.cssText = 'flex-shrink:0; width:22px; height:22px; border-radius:50%; border:none; background:rgba(255,255,255,0.06); color:#64748B; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background 0.12s, color 0.12s;';
        removeBtn.setAttribute('aria-label', `Remove ${t.name} from favourites`);
        removeBtn.title = 'Remove';
        removeBtn.innerHTML = `<svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 2l6 6M8 2L2 8"/></svg>`;
        removeBtn.onmouseenter = () => { removeBtn.style.background = 'rgba(239,68,68,0.2)'; removeBtn.style.color = '#EF4444'; };
        removeBtn.onmouseleave = () => { removeBtn.style.background = 'rgba(255,255,255,0.06)'; removeBtn.style.color = '#64748B'; };
        removeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          (window as any).UGFavs?.remove(t.slug);
          renderFavPanel();
        });

        row.appendChild(link);
        row.appendChild(removeBtn);
        list.appendChild(row);
      });
    }

    /* ══════════════════════════════════════════════════════════════
       THEME TOGGLE
       ══════════════════════════════════════════════════════════════ */
    const html      = document.documentElement;
    const toggleBtn = document.getElementById('theme-toggle')!;
    const iconSun   = document.getElementById('icon-sun')   as HTMLElement;
    const iconMoon  = document.getElementById('icon-moon')  as HTMLElement;
    function isDark()          { return html.classList.contains('dark'); }
    function applyTheme(dark: boolean) {
      html.classList.toggle('dark', dark);
      iconSun.style.display  = dark ? 'block' : 'none';
      iconMoon.style.display = dark ? 'none'  : 'block';
    }
    applyTheme(isDark());
    toggleBtn.addEventListener('click', () => {
      const going = !isDark();
      applyTheme(going);
      try { localStorage.setItem('ug-theme', going ? 'dark' : 'light'); } catch (_) {}
    });

    /* ── AdSense ── */
    try {
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    } catch (_) {}
  </script>

</body>
</html>
