---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'thermal-conductivity-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Thermal Conductivity Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="W_mK">Watt per Meter-Kelvin (W/(m·K))</option>
          <option value="BTU_hftF">BTU per Hour-Foot-°F (BTU/(h·ft·°F))</option>
          <option value="W_cmK">Watt per Centimeter-Kelvin (W/(cm·K))</option>
          <option value="cal_scmC">Calorie per Second-Cm-°C (cal/(s·cm·°C))</option>
          <option value="kW_mK">Kilowatt per Meter-Kelvin (kW/(m·K))</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Thermal Conductivity Converter</h2>
    <p class="seo-p">Enter a value, pick a unit, and instantly see the equivalent in every supported thermal conductivity unit.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Enter Conductivity Value</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Type a numeric value into the input field. You can enter whole numbers or decimals — the converter processes them immediately.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Select Target Unit</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Choose the source unit from the dropdown — W/(m·K), BTU/(h·ft·°F), W/(cm·K), cal/(s·cm·°C), or kW/(m·K).</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">View All Conversions</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">The results panel instantly displays your value in every supported unit, so you can compare and pick the one you need.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Copy Result</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Click the Copy button next to any result to copy that converted value to your clipboard for use in documents, code, or reports.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Thermal Conductivity Converter Works</h2>
    <p class="seo-p">Every conversion normalizes the input to W/(m·K) and then converts to the target unit using fixed ratios, ensuring accurate results across all supported units.</p>
    <h3 class="font-display seo-h3-sm">Thermal Conductivity Units</h3>
    <p class="seo-p"><code class="inline-code">W/(m·K)</code> is the SI standard — watts of heat flow per meter of material thickness per kelvin of temperature difference. <code class="inline-code">BTU/(h·ft·°F)</code> is the imperial equivalent used in US engineering. <code class="inline-code">W/(cm·K)</code> scales the SI unit by centimeters. <code class="inline-code">cal/(s·cm·°C)</code> uses calories and centimeters, common in older literature. <code class="inline-code">kW/(m·K)</code> is used for very high conductivity materials.</p>
    <h3 class="font-display seo-h3-sm">Conversion Factor Mathematics</h3>
    <p class="seo-p">Each unit maps to a fixed factor relative to W/(m·K). The converter multiplies your input by the source factor to get the SI base value, then divides by the target factor to produce the result. For example, 1 BTU/(h·ft·°F) equals 0.577789 W/(m·K), so converting BTU to W/(m·K) means multiplying by that factor.</p>
    <h3 class="font-display seo-h3-sm">Material Classification</h3>
    <p class="seo-p">Materials with thermal conductivity above roughly 10 W/(m·K) — like copper at 401 W/(m·K) or aluminum at 237 W/(m·K) — are classified as thermal conductors. Materials below 0.1 W/(m·K) — like styrofoam at 0.03 W/(m·K) or aerogel at 0.001 W/(m·K) — are classified as thermal insulators. This converter helps you quickly compare values across unit systems used in different engineering disciplines.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is a typical thermal conductivity value for copper?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Copper has a thermal conductivity of approximately 401 W/(m·K), making it one of the best metallic conductors of heat. This high value is why copper is widely used in heat exchangers, cookware, and electrical wiring where efficient heat transfer is required.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does thermal conductivity differ from thermal diffusivity?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Thermal conductivity measures how much heat a material can conduct, while thermal diffusivity measures how quickly it changes temperature. A material with high conductivity but also high heat capacity may have moderate diffusivity. Both properties are important but answer different engineering questions.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why do metals conduct heat better than non-metals?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Metals have free electrons that move easily through the crystal lattice, carrying kinetic energy as heat. This electron mobility allows metals like silver, copper, and aluminum to transfer heat far more efficiently than non-metals, which rely on slower atomic vibrations (phonons) to conduct heat.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the thermal conductivity of styrofoam?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Styrofoam typically has a thermal conductivity of about 0.03 W/(m·K), which makes it an excellent insulator. This low value is due to the trapped air pockets within the foam structure, which resist heat flow and are why Styrofoam is commonly used in packaging and building insulation.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I convert BTU/(h·ft·°F) to W/(m·K)?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Multiply the BTU/(h·ft·°F) value by 0.577789 to get the equivalent in W/(m·K). For example, a material with a conductivity of 1 BTU/(h·ft·°F) equals approximately 0.578 W/(m·K). This converter does the math automatically for all supported unit pairs.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Which material has the highest known thermal conductivity?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Diamond has the highest thermal conductivity of any known material at roughly 2000 W/(m·K), far exceeding silver at 429 W/(m·K). At the opposite end, aerogels and vacuum insulation panels can have values as low as 0.001 W/(m·K), making them among the best insulators available.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'W_mK',    label: 'Watt per Meter-Kelvin (W/(m·K))',         abbr: 'W/(m·K)',         factor: 1 },
    { id: 'BTU_hftF', label: 'BTU per Hour-Foot-°F (BTU/(h·ft·°F))',  abbr: 'BTU/(h·ft·°F)',   factor: 0.577789 },
    { id: 'W_cmK',   label: 'Watt per Centimeter-Kelvin (W/(cm·K))',   abbr: 'W/(cm·K)',        factor: 100 },
    { id: 'cal_scmC', label: 'Calorie per Second-Cm-°C (cal/(s·cm·°C))', abbr: 'cal/(s·cm·°C)', factor: 418.4 },
    { id: 'kW_mK',   label: 'Kilowatt per Meter-Kelvin (kW/(m·K))',    abbr: 'kW/(m·K)',        factor: 0.001 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
