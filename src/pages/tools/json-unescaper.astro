---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'json-unescaper')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">

    <!-- ── Header ── -->
    <div style="display:flex; align-items:center; gap:0.875rem; margin-bottom:1.5rem;">
      <div style="width:2.5rem; height:2.5rem; border-radius:0.625rem; background:linear-gradient(135deg,#042f2e,#134e4a); display:flex; align-items:center; justify-content:center; flex-shrink:0; box-shadow:0 4px 16px rgba(20,184,166,0.3); border:1px solid rgba(20,184,166,0.3);">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#2dd4bf" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/>
        </svg>
      </div>
      <div>
        <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin:0 0 0.15rem;">JSON String Un-escaper</h2>
        <p style="font-size:0.76rem; color:var(--text-muted); margin:0;">Unwrap &#123;\&quot;key\&quot;: \&quot;value\&quot;&#125; → beautifully formatted JSON, through every escape layer</p>
      </div>
    </div>

    <!-- ── Input panel ── -->
    <div style="margin-bottom:0.875rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.45rem;">
        <div style="display:flex; align-items:center; gap:0.5rem;">
          <span style="font-size:0.65rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:#fb923c;">Escaped Input</span>
          <span id="escape-depth-badge" style="display:none; font-size:0.62rem; font-weight:700; font-family:'Fira Code',monospace; padding:0.1rem 0.45rem; border-radius:999px; background:rgba(251,146,60,0.15); border:1px solid rgba(251,146,60,0.35); color:#fb923c;"></span>
        </div>
        <div style="display:flex; gap:0.5rem; align-items:center;">
          <button id="btn-sample-1" style="font-size:0.65rem; color:#fb923c; background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">sample ×1</button>
          <button id="btn-sample-2" style="font-size:0.65rem; color:#fb923c; background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">sample ×2</button>
          <button id="btn-sample-3" style="font-size:0.65rem; color:#fb923c; background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">sample ×3</button>
          <button id="btn-clear" style="font-size:0.65rem; color:var(--text-muted); background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">clear</button>
        </div>
      </div>
      <textarea id="json-input"
        placeholder={'{"name": "Alice", "age": 30, "active": true}'}
        rows="6"
        style="width:100%; box-sizing:border-box; resize:vertical; background:#0a1628; border:1.5px solid rgba(251,146,60,0.25); border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; color:#fed7aa; line-height:1.7; outline:none; transition:border-color 0.15s; caret-color:#fb923c;"
        onfocus="this.style.borderColor='#fb923c'; this.style.boxShadow='0 0 0 3px rgba(251,146,60,0.1)';"
        onblur="this.style.borderColor='rgba(251,146,60,0.25)'; this.style.boxShadow='none';"
      ></textarea>
    </div>

    <!-- ── Options row ── -->
    <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.875rem; padding:0.625rem 0.875rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem; align-items:center;">
      <span style="font-size:0.65rem; font-weight:800; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted); flex-shrink:0;">Options:</span>

      <label class="ju-opt ju-active" data-key="outerQuotes"
        style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.65rem; border-radius:999px; border:1.5px solid #2dd4bf; background:rgba(45,212,191,0.08); cursor:pointer; user-select:none; transition:all 0.15s;">
        <input type="checkbox" checked style="display:none;"/>
        <span style="font-size:0.68rem; font-weight:700; color:#2dd4bf;">Strip outer quotes</span>
      </label>
      <label class="ju-opt ju-active" data-key="pretty"
        style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.65rem; border-radius:999px; border:1.5px solid #2dd4bf; background:rgba(45,212,191,0.08); cursor:pointer; user-select:none; transition:all 0.15s;">
        <input type="checkbox" checked style="display:none;"/>
        <span style="font-size:0.68rem; font-weight:700; color:#2dd4bf;">Pretty print</span>
      </label>
      <label class="ju-opt ju-active" data-key="highlight"
        style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.65rem; border-radius:999px; border:1.5px solid #2dd4bf; background:rgba(45,212,191,0.08); cursor:pointer; user-select:none; transition:all 0.15s;">
        <input type="checkbox" checked style="display:none;"/>
        <span style="font-size:0.68rem; font-weight:700; color:#2dd4bf;">Syntax highlight</span>
      </label>
      <label class="ju-opt" data-key="autoLayers"
        style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.65rem; border-radius:999px; border:1.5px solid var(--border); background:var(--bg-surface-2); cursor:pointer; user-select:none; transition:all 0.15s;">
        <input type="checkbox" style="display:none;"/>
        <span style="font-size:0.68rem; font-weight:700; color:var(--text-muted);">Auto-peel all layers</span>
      </label>

      <!-- Indent size -->
      <div style="display:flex; align-items:center; gap:0.35rem; margin-left:auto;">
        <span style="font-size:0.65rem; font-weight:700; color:var(--text-muted);">Indent:</span>
        <div style="display:flex; gap:0.25rem;">
          <button class="indent-btn selected-indent" data-n="2" style="padding:0.2rem 0.5rem; border-radius:0.3rem; border:1.5px solid #2dd4bf; background:rgba(45,212,191,0.1); font-family:'Fira Code',monospace; font-size:0.68rem; font-weight:700; color:#2dd4bf; cursor:pointer; transition:all 0.15s;">2</button>
          <button class="indent-btn" data-n="4" style="padding:0.2rem 0.5rem; border-radius:0.3rem; border:1.5px solid var(--border); background:var(--bg-surface-2); font-family:'Fira Code',monospace; font-size:0.68rem; font-weight:700; color:var(--text-secondary); cursor:pointer; transition:all 0.15s;">4</button>
          <button class="indent-btn" data-n="tab" style="padding:0.2rem 0.5rem; border-radius:0.3rem; border:1.5px solid var(--border); background:var(--bg-surface-2); font-family:'Fira Code',monospace; font-size:0.68rem; font-weight:700; color:var(--text-secondary); cursor:pointer; transition:all 0.15s;">tab</button>
        </div>
      </div>
    </div>

    <!-- ── Unescape button ── -->
    <button id="btn-unescape"
      style="width:100%; padding:0.78rem 1.5rem; background:linear-gradient(90deg,#042f2e,#134e4a 50%,#042f2e); color:#2dd4bf; border:1.5px solid rgba(45,212,191,0.35); border-radius:0.625rem; font-family:'Sora',sans-serif; font-size:0.92rem; font-weight:700; cursor:pointer; transition:all 0.15s; letter-spacing:0.03em; box-shadow:0 4px 14px rgba(20,184,166,0.15); display:flex; align-items:center; justify-content:center; gap:0.6rem; margin-bottom:1rem;"
      onmouseover="this.style.boxShadow='0 4px 22px rgba(45,212,191,0.3)'; this.style.borderColor='rgba(45,212,191,0.6)';"
      onmouseout="this.style.boxShadow='0 4px 14px rgba(20,184,166,0.15)'; this.style.borderColor='rgba(45,212,191,0.35)';"
      onmousedown="this.style.transform='scale(0.985)';"
      onmouseup="this.style.transform='scale(1)';"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
      </svg>
      Un-escape &amp; Format JSON
    </button>

    <!-- ── Pipeline depth gauge ── -->
    <div id="pipeline-wrap" style="display:none; margin-bottom:1rem;">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem; flex-wrap:wrap;">
        <span style="font-size:0.65rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted);">Unescape layers</span>
        <div id="depth-gauge" style="display:flex; gap:0.3rem; align-items:center;"></div>
      </div>
      <div id="pipeline-steps" style="display:flex; flex-direction:column; gap:0.3rem;"></div>
    </div>

    <!-- ── Error banner ── -->
    <div id="error-banner" style="display:none; margin-bottom:1rem; padding:0.75rem 1rem; background:rgba(239,68,68,0.08); border:1.5px solid rgba(239,68,68,0.3); border-radius:0.625rem;">
      <div style="font-size:0.75rem; font-weight:700; color:#f87171; margin-bottom:0.25rem;">Parse error</div>
      <div id="error-msg" style="font-family:'Fira Code',monospace; font-size:0.72rem; color:#fca5a5; line-height:1.5;"></div>
    </div>

    <!-- ── Output panel ── -->
    <div id="output-wrap" style="display:none;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.45rem; flex-wrap:wrap; gap:0.4rem;">
        <div style="display:flex; align-items:center; gap:0.5rem;">
          <span style="font-size:0.65rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:#2dd4bf;">Formatted JSON</span>
          <span id="out-stats" style="font-size:0.62rem; font-family:'Fira Code',monospace; color:var(--text-muted);"></span>
        </div>
        <div style="display:flex; gap:0.5rem;">
          <button id="btn-copy-json" style="font-size:0.68rem; color:#2dd4bf; background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">Copy JSON</button>
          <button id="btn-minify" style="font-size:0.68rem; color:var(--text-muted); background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">Minify</button>
          <button id="btn-use-output" style="font-size:0.68rem; color:#fb923c; background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">Re-escape →</button>
        </div>
      </div>

      <!-- Highlighted output -->
      <div id="json-highlighted"
        style="display:block; background:#0a1628; border:1.5px solid rgba(45,212,191,0.2); border-radius:0.625rem; padding:1rem; font-family:'Fira Code',monospace; font-size:0.76rem; line-height:1.75; overflow-x:auto; max-height:420px; overflow-y:auto; white-space:pre;">
      </div>

      <!-- Plain textarea (shown when highlight off) -->
      <textarea id="json-plain" readonly
        style="display:none; width:100%; box-sizing:border-box; background:#0a1628; border:1.5px solid rgba(45,212,191,0.2); border-radius:0.625rem; padding:1rem; font-family:'Fira Code',monospace; font-size:0.76rem; color:#a7f3d0; line-height:1.75; outline:none; cursor:default; resize:vertical; min-height:200px; max-height:420px;">
      </textarea>
    </div>

  </div>

  <!-- HOW TO USE ───────────────────────────────── -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the JSON Un-escaper</h2>
    <p class="seo-p">You have copied a JSON payload from a log file, an API error message, or a Slack message, and every quote is backslash-escaped. The string is wrapped in extra layers of escaping and you cannot paste it into your code editor without fixing it first. This tool peels every escape layer in one click and gives you clean, formatted JSON.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Debugging API error responses</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A REST API returns an error body where every quote is backslash-escaped — the kind of double-escaped JSON string you get from log files or Slack messages. Paste it, enable Strip outer quotes, and the tool outputs the nested object with proper indentation so you can read the error path at a glance.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Extracting data from double-escaped database fields</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Some databases store JSON as a string and escape it again on read. A MySQL JSON column might return a doubly-escaped string where every quote has a backslash, then another backslash wraps the whole thing. Enable Auto-peel all layers and the tool recursively unwraps every pass until it reaches the clean object with name: Alice.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Cleaning up terminal output for documentation</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A CLI tool prints escaped JSON to stdout and you need to include the output in a Markdown document. Paste it into the tool, enable Pretty print with 2-space indentation, and copy the highlighted result directly into your documentation.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Inspecting triple-escaped strings in environment configs</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Docker Compose and some CI systems triple-escape JSON values in YAML files. Use the sample x3 button to see how the tool peels three layers, then paste your own triple-escaped string to get the clean result. The pipeline display shows each intermediate step so you can verify the tool stopped at the right depth.</p>
      </div>
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/json-string-escaper" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">JSON String Escaper</a>
        <a href="/tools/json-prettifier" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">JSON Prettifier</a>
        <a href="/tools/regex-toolkit" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">RegEx Toolkit — Visualize, Extract & Replace</a>
      </div>
    </div>
</div>

  <!-- HOW IT WORKS ────────────────────────────── -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the JSON Un-escaper Works</h2>
    <p class="seo-p">The tool resolves every layer of backslash escaping in your input using sequential parse passes. Each pass calls JSON.parse on the current string, and if the result is still a string, another pass is triggered.</p>
    <h3 class="font-display seo-h3-sm">Escape Sequence Detection</h3>
    <p class="seo-p">The input string is scanned for backslash sequences. Standard JSON escapes include the escaped double quote, escaped backslash, newline, tab, carriage return, forward slash, backspace, and form feed. Each detection pass peels one layer of escaping by calling JSON.parse on the current string. For example, a string where every quote has a backslash in front of it — the kind produced by JSON.stringify — becomes a clean JSON object after one pass because the backslash-quote sequences are resolved into plain quote characters.</p>
    <h3 class="font-display seo-h3-sm">Unicode and Entity Decoding</h3>
    <p class="seo-p">The parser handles Unicode escape sequences natively through JSON.parse, converting them to their actual characters. A sequence like u0041 becomes A, and surrogate pairs like uD83DuDE00 render as a single emoji character. When the Auto-peel option is enabled, the tool recursively unwraps every JSON stringification layer until a non-string value is reached, regardless of depth.</p>
    <h3 class="font-display seo-h3-sm">Pipeline Depth Visualisation</h3>
    <p class="seo-p">After each unescape pass, the tool records the layer number, the raw input at that layer, and the parsed result. The pipeline display shows each step with a type indicator — string with an arrow means another layer is expected, while a checkmark means the final value has been reached. This lets you verify that the tool stopped at the correct depth, which matters when you have intentionally nested JSON strings.</p>
    <h3 class="font-display seo-h3-sm">Error Handling for Malformed Input</h3>
    <p class="seo-p">After each pass the tool validates whether the result is parseable as JSON. If the input contains mismatched brackets, unterminated strings, or invalid escape sequences, an error banner displays the specific parse failure and the layer number where it occurred. For instance, a string that starts with an opening brace but never closes it will fail at layer 1 with an unterminated string error.</p>
  </div>

  <!-- FAQ ─────────────────────────────────────── -->
  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What escape sequences does the JSON Un-escaper support?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The tool handles all standard JSON escape sequences: the escaped double quote, escaped backslash, newline, tab, carriage return, forward slash, backspace, form feed, and Unicode escape sequences like u0041. Non-standard escapes may cause a parse error, which the tool will report with the layer number where the failure occurred.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does the tool handle double-escaped or triple-escaped strings?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Each escape layer wraps the previous output in another round of JSON.stringify. The tool peels one layer per pass by calling JSON.parse. When Auto-peel is enabled, it recursively unwraps every layer until it reaches a non-string JSON value like an object or array. A triple-escaped string — where the JSON was stringified three times — takes three parse passes to reach the clean object with name: Alice.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How is this different from just calling JSON.parse?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A single JSON.parse call only removes one escape layer. If the JSON was stringified twice, one parse pass produces another string rather than an object. This tool runs multiple passes automatically, displays each intermediate step in a pipeline, and includes pretty printing and syntax highlighting — things a raw parse call does not provide.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the Strip outer quotes option?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Many serialisation tools wrap the entire JSON string in an extra pair of double quotes before escaping the inner content. When enabled, this option detects and removes that outermost quote pair before the first unescape pass begins, so the tool does not waste a layer resolving quotes that are not part of the data.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can the tool fix malformed or invalid escaped JSON?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The tool validates the input at each unescape pass. If the string contains mismatched brackets, unterminated strings, or invalid escape sequences, it stops and displays the specific parse error along with the layer number where the failure occurred. It does not attempt to auto-correct invalid JSON.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Is my JSON data sent to a server?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">No. All parsing is performed entirely in the browser using the built-in JSON.parse function and the Clipboard API. Your JSON data never leaves your device, and no server-side processing or analytics are involved.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
  // ── Sample data ───────────────────────────────────────────
  const BASE_JSON = {
    name: "Alice Wonderland",
    age: 30,
    active: true,
    score: 98.5,
    tags: ["developer", "designer"],
    address: { city: "Sydney", postcode: "2000", country: null },
    meta: { created: "2024-01-15T09:30:00Z", version: 3 }
  };

  function makeEscaped(depth: number): string {
    let s = JSON.stringify(BASE_JSON);
    for (let i = 0; i < depth; i++) s = JSON.stringify(s);
    return s;
  }

  // ── Options state ─────────────────────────────────────────
  const opts = { outerQuotes: true, pretty: true, highlight: true, autoLayers: false };
  let indentVal: number | string = 2;

  // ── Opt toggles ───────────────────────────────────────────
  document.querySelectorAll<HTMLLabelElement>('.ju-opt').forEach(lbl => {
    lbl.addEventListener('click', e => {
      e.preventDefault();
      const key = lbl.dataset.key as keyof typeof opts;
      opts[key] = !opts[key];
      const span = lbl.querySelector('span')!;
      if (opts[key]) {
        lbl.style.borderColor = '#2dd4bf';
        lbl.style.background  = 'rgba(45,212,191,0.08)';
        span.style.color      = '#2dd4bf';
      } else {
        lbl.style.borderColor = 'var(--border)';
        lbl.style.background  = 'var(--bg-surface-2)';
        span.style.color      = 'var(--text-muted)';
      }
    });
  });

  // ── Indent buttons ────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.indent-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const v = btn.dataset.n!;
      indentVal = v === 'tab' ? '\t' : parseInt(v);
      document.querySelectorAll<HTMLButtonElement>('.indent-btn').forEach(b => {
        const active = b === btn;
        b.style.borderColor = active ? '#2dd4bf' : 'var(--border)';
        b.style.background  = active ? 'rgba(45,212,191,0.1)' : 'var(--bg-surface-2)';
        b.style.color       = active ? '#2dd4bf' : 'var(--text-secondary)';
      });
    });
  });

  // ── Core un-escaper ───────────────────────────────────────
  type PipelineStep = { layer: number; raw: string; parsed: unknown; wasString: boolean };

  function unescape(input: string): { steps: PipelineStep[]; final: unknown; error?: string } {
    let current = input.trim();

    // Strip outer double-quotes if option enabled
    if (opts.outerQuotes && current.startsWith('"') && current.endsWith('"') && current.length > 1) {
      // Try removing outer quotes
      const inner = current.slice(1, -1);
      // Only strip if what's inside looks like escaped JSON (contains \" or starts with {)
      if (inner.includes('\\"') || inner.trimStart().startsWith('{') || inner.trimStart().startsWith('[')) {
        current = inner;
      }
    }

    const steps: PipelineStep[] = [];
    const maxLayers = opts.autoLayers ? 10 : 5;

    for (let layer = 1; layer <= maxLayers; layer++) {
      // Try to parse the current string
      let parsed: unknown;
      try {
        // Wrap in quotes if it doesn't look like a JSON value itself
        const toParse = current;
        parsed = JSON.parse(toParse);
      } catch (e1) {
        // Maybe it's a raw string without surrounding quotes — try wrapping
        try {
          parsed = JSON.parse(`"${current}"`);
        } catch (e2) {
          return { steps, final: null, error: `Layer ${layer}: ${(e2 as Error).message}` };
        }
      }

      steps.push({ layer, raw: current, parsed, wasString: typeof parsed === 'string' });

      if (typeof parsed === 'string') {
        // The result is still a string — another layer of escaping; peel again
        current = parsed;
        if (!opts.autoLayers && layer >= 1) {
          // In non-auto mode, do just one unescape pass and see if it's valid JSON
          // Try parsing current as JSON object
          try {
            const inner = JSON.parse(current);
            if (typeof inner !== 'string') {
              steps.push({ layer: layer + 1, raw: current, parsed: inner, wasString: false });
              return { steps, final: inner };
            }
          } catch {
            // Not yet an object — return what we have as string result
          }
          return { steps, final: parsed };
        }
      } else {
        // Got an object or array or primitive — done
        return { steps, final: parsed };
      }
    }

    // Exhausted max layers
    return { steps, final: current, error: 'Max unescape depth reached. The input may be valid as-is.' };
  }

  // ── Syntax highlighter ────────────────────────────────────
  function syntaxHighlight(json: string): string {
    // Token colours
    const C = {
      key:    '#2dd4bf',   // teal
      str:    '#fcd34d',   // amber
      num:    '#c4b5fd',   // lavender
      bool:   '#f9a8d4',   // rose pink
      null_:  '#94a3b8',   // slate
      punct:  '#475569',   // dim
      brace:  '#64748b',   // brackets
    };

    return json
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      // Keys: "word": → teal
      .replace(/"([^"\\]*(\\.[^"\\]*)*)"(\s*):/g,
        `<span style="color:${C.key}">"$1"</span>$3:`)
      // Strings: "value" (not keys)
      .replace(/(:\s*)"([^"\\]*(\\.[^"\\]*)*)"/g,
        `$1<span style="color:${C.str}">"$2"</span>`)
      // Numbers
      .replace(/(:\s*)(-?\d+\.?\d*([eE][+-]?\d+)?)/g,
        `$1<span style="color:${C.num}">$2</span>`)
      // Booleans
      .replace(/\b(true|false)\b/g,
        `<span style="color:${C.bool}">$1</span>`)
      // Null
      .replace(/\bnull\b/g,
        `<span style="color:${C.null_}">null</span>`)
      // Array values (strings at start of line after [)
      .replace(/(\[\s*)"([^"\\]*(\\.[^"\\]*)*)"/g,
        `$1<span style="color:${C.str}">"$2"</span>`);
  }

  // ── Depth gauge render ────────────────────────────────────
  function renderDepthGauge(depth: number) {
    const gauge = document.getElementById('depth-gauge')!;
    gauge.innerHTML = '';
    for (let i = 1; i <= Math.max(depth, 1); i++) {
      const dot = document.createElement('div');
      const filled = i <= depth;
      dot.style.cssText = `
        width:10px; height:10px; border-radius:50%;
        background:${filled ? '#2dd4bf' : 'var(--bg-surface-3)'};
        border:1.5px solid ${filled ? '#2dd4bf' : 'var(--border)'};
        box-shadow:${filled ? '0 0 6px rgba(45,212,191,0.5)' : 'none'};
        transition:all 0.3s;
        transition-delay:${(i-1)*80}ms;
      `;
      gauge.appendChild(dot);
    }
    // Label
    const lbl = document.createElement('span');
    lbl.style.cssText = 'font-family:"Fira Code",monospace; font-size:0.68rem; color:var(--text-muted); margin-left:0.3rem;';
    lbl.textContent = `${depth} layer${depth !== 1 ? 's' : ''} detected`;
    gauge.appendChild(lbl);
  }

  // ── Pipeline steps render ─────────────────────────────────
  function renderPipelineSteps(steps: PipelineStep[]) {
    const container = document.getElementById('pipeline-steps')!;
    container.innerHTML = '';

    steps.forEach((step, idx) => {
      const row = document.createElement('div');
      row.style.cssText = `
        display:flex; align-items:baseline; gap:0.625rem;
        padding:0.3rem 0; border-bottom:1px dashed var(--border);
        opacity:0; transform:translateX(-8px);
        transition:opacity 0.2s ease, transform 0.2s ease;
        transition-delay:${idx * 60}ms;
      `;

      const preview = typeof step.parsed === 'string'
        ? `"${step.parsed.slice(0, 60)}${step.parsed.length > 60 ? '…' : ''}"`
        : JSON.stringify(step.parsed, null, 0).slice(0, 80) + (JSON.stringify(step.parsed).length > 80 ? '…' : '');

      const typeLabel = typeof step.parsed === 'string' ? 'string→' : (Array.isArray(step.parsed) ? 'array ✓' : typeof step.parsed + ' ✓');
      const typeColor = step.wasString ? '#fb923c' : '#4ade80';

      row.innerHTML = `
        <span style="font-family:'Fira Code',monospace; font-size:0.65rem; font-weight:800; color:#2dd4bf; flex-shrink:0; min-width:4rem;">Layer ${step.layer}</span>
        <span style="font-size:0.62rem; font-weight:700; color:${typeColor}; flex-shrink:0; font-family:'Fira Code',monospace;">${typeLabel}</span>
        <span style="font-family:'Fira Code',monospace; font-size:0.68rem; color:var(--text-secondary); word-break:break-all; line-height:1.5;">${escHtml(preview)}</span>
      `;

      container.appendChild(row);
      // Trigger animation
      requestAnimationFrame(() => requestAnimationFrame(() => {
        row.style.opacity = '1';
        row.style.transform = 'translateX(0)';
      }));
    });
  }

  function escHtml(s: string) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── Main run ──────────────────────────────────────────────
  let lastParsed: unknown = null;

  function run() {
    const raw = (document.getElementById('json-input') as HTMLTextAreaElement).value;
    if (!raw.trim()) return;

    const errorBanner  = document.getElementById('error-banner')!;
    const errorMsg     = document.getElementById('error-msg')!;
    const outputWrap   = document.getElementById('output-wrap')!;
    const pipelineWrap = document.getElementById('pipeline-wrap')!;
    const depthBadge   = document.getElementById('escape-depth-badge')!;
    const outStats     = document.getElementById('out-stats')!;
    const highlighted  = document.getElementById('json-highlighted')!;
    const plainTA      = document.getElementById('json-plain') as HTMLTextAreaElement;

    errorBanner.style.display  = 'none';
    outputWrap.style.display   = 'none';
    pipelineWrap.style.display = 'none';

    const { steps, final, error } = unescape(raw);

    if (error && (steps.length === 0 || steps.every(s => s.wasString))) {
      errorBanner.style.display = 'block';
      errorMsg.textContent      = error;
      depthBadge.style.display  = 'none';
      return;
    }

    // Depth = how many string layers were peeled
    const realDepth = steps.length > 0 ? steps.filter(s => s.wasString).length : 0;

    depthBadge.textContent    = `×${realDepth} escape${realDepth !== 1 ? 's' : ''}`;
    depthBadge.style.display  = realDepth > 0 ? 'inline' : 'none';

    pipelineWrap.style.display = 'block';
    renderDepthGauge(realDepth > 0 ? realDepth : 1);
    renderPipelineSteps(steps);

    // Format output
    lastParsed = final;
    const indent = typeof indentVal === 'number' ? indentVal : '\t';
    const formatted = opts.pretty
      ? JSON.stringify(final, null, indent)
      : JSON.stringify(final);

    const lineCount  = formatted.split('\n').length;
    const charCount  = formatted.length;
    outStats.textContent = `${lineCount} lines · ${charCount.toLocaleString()} chars`;

    if (opts.highlight) {
      highlighted.innerHTML = syntaxHighlight(formatted);
      highlighted.style.display = 'block';
      plainTA.style.display     = 'none';
    } else {
      plainTA.value         = formatted;
      plainTA.style.display = 'block';
      highlighted.style.display = 'none';
    }

    outputWrap.style.display = 'block';

    // Error note if any
    if (error) {
      errorBanner.style.display = 'block';
      errorMsg.textContent      = error;
    }
  }

  // ── Button events ─────────────────────────────────────────
  document.getElementById('btn-unescape')!.addEventListener('click', run);

  document.getElementById('btn-sample-1')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = makeEscaped(1);
    run();
  });
  document.getElementById('btn-sample-2')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = makeEscaped(2);
    run();
  });
  document.getElementById('btn-sample-3')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = makeEscaped(3);
    run();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = '';
    document.getElementById('output-wrap')!.style.display   = 'none';
    document.getElementById('pipeline-wrap')!.style.display = 'none';
    document.getElementById('error-banner')!.style.display  = 'none';
    document.getElementById('escape-depth-badge')!.style.display = 'none';
  });

  document.getElementById('btn-copy-json')!.addEventListener('click', () => {
    const text = opts.highlight
      ? (document.getElementById('json-plain') as HTMLTextAreaElement).value ||
        document.getElementById('json-highlighted')!.textContent || ''
      : (document.getElementById('json-plain') as HTMLTextAreaElement).value;
    const toCopy = JSON.stringify(lastParsed, null, typeof indentVal === 'number' ? indentVal : '\t');
    navigator.clipboard.writeText(toCopy).then(() => {
      const btn = document.getElementById('btn-copy-json')!;
      btn.textContent = '✓ Copied!';
      setTimeout(() => { btn.textContent = 'Copy JSON'; }, 2000);
    }).catch(() => {});
  });

  document.getElementById('btn-minify')!.addEventListener('click', () => {
    if (lastParsed === null) return;
    const min = JSON.stringify(lastParsed);
    navigator.clipboard.writeText(min).then(() => {
      const btn = document.getElementById('btn-minify')!;
      btn.textContent = '✓ Copied minified!';
      setTimeout(() => { btn.textContent = 'Minify'; }, 2000);
    }).catch(() => {});
  });

  document.getElementById('btn-use-output')!.addEventListener('click', () => {
    if (lastParsed === null) return;
    const reEscaped = JSON.stringify(JSON.stringify(lastParsed));
    (document.getElementById('json-input') as HTMLTextAreaElement).value = reEscaped;
    document.getElementById('output-wrap')!.style.display   = 'none';
    document.getElementById('pipeline-wrap')!.style.display = 'none';
    document.getElementById('error-banner')!.style.display  = 'none';
  });

  // Ctrl+Enter shortcut
  document.getElementById('json-input')!.addEventListener('keydown', (e: KeyboardEvent) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); run(); }
  });

  // Auto-run on load with sample ×1
  (document.getElementById('json-input') as HTMLTextAreaElement).value = makeEscaped(1);
  run();
</script>
