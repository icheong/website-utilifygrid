---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'json-minifier')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">JSON Minifier &amp; Compact Formatter</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Strip all whitespace, line breaks, and indentation from JSON to produce a single-line payload. Shows exact size reduction.</p>

    <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
      <button id="btn-minify" class="btn-primary" type="button">Minify</button>
      <button id="btn-copy" class="btn-secondary" type="button">Copy Output</button>
      <button id="btn-clear" class="btn-secondary" type="button">Clear</button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem;">
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Input</label>
          <button id="btn-sample" class="btn-secondary" type="button" style="font-size:0.7rem; padding:0.2rem 0.55rem;">Sample</button>
        </div>
        <textarea id="json-input" class="input-themed"
          placeholder="Paste formatted JSON here…"
          rows="10"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65;"
        ></textarea>
      </div>
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Minified Output</label>
        </div>
        <textarea id="json-output" class="input-themed" readonly rows="10"
          placeholder="Minified JSON appears here…"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65; background:var(--bg-surface-2);"
        ></textarea>
      </div>
    </div>

    <div id="reduction-badge" style="display:none; margin-top:0.875rem; padding:0.75rem 1rem; background:rgba(16,185,129,0.08); border:1.5px solid rgba(16,185,129,0.3); border-radius:0.625rem; text-align:center;">
      <span style="font-size:0.85rem; font-weight:700; color:#059669;">Payload size reduced by <span id="reduction-pct">0</span>%</span>
      <span style="font-size:0.78rem; color:var(--text-muted); margin-left:0.5rem;">(<span id="reduction-bytes">0</span> bytes saved)</span>
    </div>

    <div id="error-box" style="display:none; margin-top:0.625rem; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); border-radius:0.5rem; padding:0.75rem 1rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:#DC2626;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the JSON Minifier and Compact Formatter</h2>
    <p class="seo-p">A mobile app developer receives a 50 KB prettified JSON response from a REST API and needs to reduce bandwidth consumption on cellular networks. Paste the formatted JSON into the input panel and click Minify. The tool strips all whitespace, line breaks, and indentation, producing a single-line payload. The reduction badge shows that the payload shrank from 50 KB to 15 KB, a 70 percent reduction. Copy the minified output and use it in the mobile app codebase to reduce data transfer and improve load times.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">API payload size optimisation</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A backend developer prepares API responses for a bandwidth-constrained IoT application. Paste the prettified JSON response, click Minify, and review the reduction badge. The exact byte count and percentage savings help determine whether the payload fits within the device transmission limits. The minified output is safe to embed directly in HTTP responses because it is semantically identical to the prettified version.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Configuration file storage reduction</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A DevOps engineer managing hundreds of Kubernetes ConfigMap JSON files wants to minimise storage on the Git server. Paste each file, click Minify, and review the reduction badge. The savings compound across large fleets of microservice configurations, reducing repository size and clone times. The minified JSON remains valid and parseable by any JSON consumer.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Log pipeline preprocessing</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">An observability engineer minifies JSON log entries before ingestion into a log aggregator to reduce storage costs and improve throughput. Paste a sample log entry, click Minify, and review the reduction badge to estimate savings at scale. The tool helps determine whether minification provides meaningful compression benefit for different log verbosity levels and payload structures.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Email attachment optimisation</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A consultant needs to email a large JSON data export to a client but the file exceeds the 25 MB attachment limit. Paste the JSON, click Minify, and check whether the reduced size fits within the limit. The reduction badge shows the exact byte savings, helping you decide whether minification alone is sufficient or if you need to split the file into multiple attachments.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the JSON Minifier Works</h2>
    <p class="seo-p">
      The minifier takes prettified JSON with indentation, line breaks, and spacing, and strips it down to a single continuous line. It does this by parsing the input with <code class="inline-code">JSON.parse()</code> to validate the structure, then re-serialising it with <code class="inline-code">JSON.stringify()</code> and no indentation argument. This round-trip guarantees the output is valid JSON while removing every byte of non-essential whitespace.
    </p>
    <h3 class="seo-h3-sm">Why Round-Trip Parsing Is Safer Than Regex</h3>
    <p class="seo-p">
      A naive find-and-replace approach that strips spaces and newlines would break string values containing spaces. The round-trip approach avoids this entirely: <code class="inline-code">JSON.parse()</code> correctly distinguishes structural whitespace from string content, so only formatting characters are removed. Strings like "hello world" or "line one\nline two" are preserved exactly as they appear in the original data.
    </p>
    <h3 class="seo-h3-sm">Accurate Byte-Size Calculation</h3>
    <p class="seo-p-none">
      The reduction badge uses <code class="inline-code">TextEncoder.encode()</code> with UTF-8 encoding to count bytes rather than characters. This matters because multi-byte Unicode characters like emoji or accented letters take 2-4 bytes in UTF-8 but only count as one character in string.length. The percentage is calculated as <code class="inline-code">(original bytes - minified bytes) / original bytes * 100</code>, giving you a precise measure of how much bandwidth you save.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does minification change any of the actual data?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">No. The tool uses JSON.parse followed by JSON.stringify, which guarantees the parsed data is identical before and after. String values like "hello world" retain their spaces, numbers keep their precision, and booleans stay true or false. The only thing removed is formatting whitespace outside of string literals.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How much size reduction should I expect?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">It depends on how heavily your JSON is indented. Deeply nested structures with 4-space indentation and long property names typically see 40-70% reduction. Already-minified JSON with minimal whitespace saves under 5%. The reduction badge shows the exact byte count and percentage for every input, so you can immediately see whether minification is worth the effort for your specific payload.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why not just use a text editor to remove spaces?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Find-and-replace whitespace removal would break string values that contain spaces. For example, a JSON field with the value "New York" would become "NewYork" if you naively stripped all spaces. The parse-and-serialise approach is the only safe method because the parser knows the difference between structural whitespace and content inside quoted strings.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Is the minified output always valid JSON?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. Because the tool first parses the input to validate it, then re-serialises with no indentation, the output is guaranteed to be valid RFC 8259 JSON. If the original input had syntax errors, the tool reports them before producing any output. The minified result can be used anywhere standard JSON is accepted.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What happens to values like NaN or Infinity?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">JavaScript values like NaN and Infinity are not valid JSON per the specification. When JSON.stringify encounters them, it converts them to null. If your data contains these values, the minified output may differ from the original. Review the output after minification to confirm the null substitution is acceptable for your use case.</p>
        </div>
      </div>

    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLE = JSON.stringify({name:"Alice",age:30,active:true,score:98.5,tags:["developer","designer"],address:{city:"Sydney",postcode:"2000",country:null}},null,2);

  function minify() {
    const raw = (document.getElementById('json-input') as HTMLTextAreaElement).value;
    const out = (document.getElementById('json-output') as HTMLTextAreaElement);
    const errBox = document.getElementById('error-box')!;
    const badge = document.getElementById('reduction-badge')!;
    errBox.style.display = 'none';
    badge.style.display = 'none';
    if (!raw.trim()) { out.value = ''; return; }

    try {
      const parsed = JSON.parse(raw);
      const minified = JSON.stringify(parsed);
      out.value = minified;

      const before = new TextEncoder().encode(raw).byteLength;
      const after = new TextEncoder().encode(minified).byteLength;
      const saved = before - after;
      const pct = before > 0 ? Math.round((saved / before) * 100) : 0;
      if (saved > 0) {
        (document.getElementById('reduction-pct') as HTMLElement).textContent = String(pct);
        (document.getElementById('reduction-bytes') as HTMLElement).textContent = String(saved);
        badge.style.display = 'block';
      }
    } catch (e: any) {
      errBox.textContent = e.message;
      errBox.style.display = 'block';
    }
  }

  document.getElementById('btn-minify')!.addEventListener('click', minify);
  document.getElementById('btn-sample')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = SAMPLE;
    minify();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = '';
    (document.getElementById('json-output') as HTMLTextAreaElement).value = '';
    document.getElementById('error-box')!.style.display = 'none';
    document.getElementById('reduction-badge')!.style.display = 'none';
  });
  document.getElementById('btn-copy')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy')!;
    navigator.clipboard.writeText((document.getElementById('json-output') as HTMLTextAreaElement).value).then(() => {
      btn.textContent = '✓ Copied!';
      btn.classList.add('btn-success');
      setTimeout(() => { btn.textContent = 'Copy Output'; btn.classList.remove('btn-success'); }, 2000);
    }).catch(() => {
      btn.textContent = 'Failed';
      setTimeout(() => { btn.textContent = 'Copy Output'; }, 2000);
    });
  });

  let minifyTimer: ReturnType<typeof setTimeout> | null = null;
  document.getElementById('json-input')!.addEventListener('input', () => {
    if (minifyTimer) clearTimeout(minifyTimer);
    minifyTimer = setTimeout(minify, 200);
  });
</script>
