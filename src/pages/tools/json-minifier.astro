---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'json-minifier')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">JSON Minifier &amp; Compact Formatter</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Strip all whitespace, line breaks, and indentation from JSON to produce a single-line payload. Shows exact size reduction.</p>

    <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
      <button id="btn-minify" class="btn-primary" type="button">Minify</button>
      <button id="btn-copy" class="btn-secondary" type="button">Copy Output</button>
      <button id="btn-clear" class="btn-secondary" type="button">Clear</button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem;">
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Input</label>
          <button id="btn-sample" class="btn-secondary" type="button" style="font-size:0.7rem; padding:0.2rem 0.55rem;">Sample</button>
        </div>
        <textarea id="json-input" class="input-themed"
          placeholder="Paste formatted JSON here…"
          rows="10"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65;"
        ></textarea>
      </div>
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Minified Output</label>
        </div>
        <textarea id="json-output" class="input-themed" readonly rows="10"
          placeholder="Minified JSON appears here…"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65; background:var(--bg-surface-2);"
        ></textarea>
      </div>
    </div>

    <div id="reduction-badge" style="display:none; margin-top:0.875rem; padding:0.75rem 1rem; background:rgba(16,185,129,0.08); border:1.5px solid rgba(16,185,129,0.3); border-radius:0.625rem; text-align:center;">
      <span style="font-size:0.85rem; font-weight:700; color:#059669;">Payload size reduced by <span id="reduction-pct">0</span>%</span>
      <span style="font-size:0.78rem; color:var(--text-muted); margin-left:0.5rem;">(<span id="reduction-bytes">0</span> bytes saved)</span>
    </div>

    <div id="error-box" style="display:none; margin-top:0.625rem; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); border-radius:0.5rem; padding:0.75rem 1rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:#DC2626;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">JSON Minifier and Compact Formatter Overview</h2>
    <p class="seo-p">
      This JSON minifier strips all non-essential whitespace from JSON documents to produce the most compact possible payload. Paste any formatted or prettified JSON into the input panel and click Minify to see a single-line output with all line breaks, tabs, and padding removed. The tool runs entirely in your browser using native JavaScript methods — no data is sent to any server, making it safe for minimising API payloads containing sensitive information.
    </p>
    <p class="seo-p">
      A stats badge shows the exact byte reduction: the original and minified sizes are compared using <code class="inline-code">TextEncoder</code> for accurate UTF-8 byte counts, and the percentage saved is displayed alongside the raw byte savings. This is particularly useful for estimating bandwidth savings in API calls, reducing storage for JSON configuration files, or preparing data for environments with strict payload size limits.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['API payload size optimisation', 'A mobile app developer can minimise JSON API responses to reduce bandwidth consumption on cellular networks. Reducing a 50 KB prettified response to 15 KB of minified JSON translates to faster load times and lower data costs for end users, especially in regions with expensive data plans.'],
        ['Configuration file storage reduction', 'A DevOps engineer managing hundreds of Kubernetes ConfigMap JSON files can shrink total storage by minifying before committing. The reduction badge provides immediate feedback on savings, which compound across large fleets of microservice configurations.'],
        ['Log and metrics pipeline preprocessing', 'An observability engineer can minify JSON log entries before ingestion into log aggregators, reducing storage costs and improving throughput. The tool helps estimate the compression benefit for different log verbosity levels and payload structures.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Whitespace Elimination and JSON Re-serialisation</h2>
    <p class="seo-p">
      The minifier operates through a two-step round-trip via the native JavaScript JSON parser and serialiser. First, <code class="inline-code">JSON.parse()</code> validates the input and constructs an in-memory object tree. This step enforces strict RFC 8259 compliance — any syntax error is reported immediately with the exact position of the failure. Because <code class="inline-code">JSON.parse()</code> discards all whitespace during parsing, the object tree contains only the semantic data.
    </p>
    <h3 class="seo-h3-sm">Re-serialisation without Indentation</h3>
    <p class="seo-p">
      The second step calls <code class="inline-code">JSON.stringify(obj)</code> with no arguments for the space parameter (defaulting to <code class="inline-code">undefined</code>), which produces the most compact output — a single continuous line with no spaces, line breaks, or indentation. The native implementation handles all JSON value types correctly: strings are escaped according to the JSON specification, numbers follow the IEEE 754 double-precision representation, and special values like <code class="inline-code">undefined</code>, <code class="inline-code">Infinity</code>, and <code class="inline-code">NaN</code> are serialised as <code class="inline-code">null</code> or omitted.
    </p>
    <h3 class="seo-h3-sm">Byte-Size Calculation</h3>
    <p class="seo-p-none">
      The reduction badge computes the exact byte savings using <code class="inline-code">TextEncoder.encode()</code> with UTF-8 encoding. This is more accurate than using <code class="inline-code">string.length</code> because UTF-16 surrogate pairs and multi-byte Unicode characters are counted correctly. The percentage reduction is calculated as <code class="inline-code">(original - minified) / original * 100</code>, providing a precise measure of payload compression efficiency.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does minification change the data?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">No. Minification only removes whitespace that exists outside of string literals. The round-trip through <code class="inline-code">JSON.parse()</code> and <code class="inline-code">JSON.stringify()</code> guarantees the parsed data is identical before and after. Running <code class="inline-code">JSON.parse()</code> on the minified output produces the same object tree as parsing the original input.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why not just use a find-and-replace?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Regex-based whitespace removal can break string values that contain spaces, escaped characters, or whitespace patterns that match the removal criteria. <code class="inline-code">JSON.parse()</code> followed by <code class="inline-code">JSON.stringify()</code> is the only safe approach because the parser correctly distinguishes structural whitespace from string content, guaranteeing zero data corruption.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How much space is typically saved?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Savings depend on the input. Well-indented JSON with deep nesting and long property names can see 40-70% reduction. Already-compact JSON with minimal whitespace saves very little — sometimes under 5%. The reduction badge displays the exact byte count and percentage for every input, so you always know exactly how much was saved.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Is minified JSON still valid?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. Minified output is always valid, parseable JSON. Because the tool first parses the input and then re-serialises it, the output is guaranteed to conform to RFC 8259, even if the original input had minor formatting inconsistencies. The minified output can be used anywhere standard JSON is accepted.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does it handle special numeric values like NaN or Infinity?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">JavaScript values like <code class="inline-code">NaN</code>, <code class="inline-code">Infinity</code>, and <code class="inline-code">-Infinity</code> are not valid JSON values per the specification. When encountered, <code class="inline-code">JSON.stringify()</code> converts them to <code class="inline-code">null</code>. If your input contains these values, the minified output will differ from the original — review the output to confirm this treatment is acceptable for your use case.</p>
        </div>
      </div>

    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLE = JSON.stringify({name:"Alice",age:30,active:true,score:98.5,tags:["developer","designer"],address:{city:"Sydney",postcode:"2000",country:null}},null,2);

  function minify() {
    const raw = (document.getElementById('json-input') as HTMLTextAreaElement).value;
    const out = (document.getElementById('json-output') as HTMLTextAreaElement);
    const errBox = document.getElementById('error-box')!;
    const badge = document.getElementById('reduction-badge')!;
    errBox.style.display = 'none';
    badge.style.display = 'none';
    if (!raw.trim()) { out.value = ''; return; }

    try {
      const parsed = JSON.parse(raw);
      const minified = JSON.stringify(parsed);
      out.value = minified;

      const before = new TextEncoder().encode(raw).byteLength;
      const after = new TextEncoder().encode(minified).byteLength;
      const saved = before - after;
      const pct = before > 0 ? Math.round((saved / before) * 100) : 0;
      if (saved > 0) {
        (document.getElementById('reduction-pct') as HTMLElement).textContent = String(pct);
        (document.getElementById('reduction-bytes') as HTMLElement).textContent = String(saved);
        badge.style.display = 'block';
      }
    } catch (e: any) {
      errBox.textContent = e.message;
      errBox.style.display = 'block';
    }
  }

  document.getElementById('btn-minify')!.addEventListener('click', minify);
  document.getElementById('btn-sample')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = SAMPLE;
    minify();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = '';
    (document.getElementById('json-output') as HTMLTextAreaElement).value = '';
    document.getElementById('error-box')!.style.display = 'none';
    document.getElementById('reduction-badge')!.style.display = 'none';
  });
  document.getElementById('btn-copy')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy')!;
    navigator.clipboard.writeText((document.getElementById('json-output') as HTMLTextAreaElement).value).then(() => {
      btn.textContent = '✓ Copied!';
      btn.classList.add('btn-success');
      setTimeout(() => { btn.textContent = 'Copy Output'; btn.classList.remove('btn-success'); }, 2000);
    }).catch(() => {
      btn.textContent = 'Failed';
      setTimeout(() => { btn.textContent = 'Copy Output'; }, 2000);
    });
  });

  let minifyTimer: ReturnType<typeof setTimeout> | null = null;
  document.getElementById('json-input')!.addEventListener('input', () => {
    if (minifyTimer) clearTimeout(minifyTimer);
    minifyTimer = setTimeout(minify, 200);
  });
</script>
