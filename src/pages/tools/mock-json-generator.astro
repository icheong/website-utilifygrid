---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'mock-json-generator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">Mock JSON Generator</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Generate realistic mock JSON data from a JSON Schema definition. Perfect for API testing and prototyping.</p>

    <div style="display:flex; gap:0.5rem; margin-bottom:1rem; flex-wrap:wrap; align-items:center;">
      <button id="btn-generate" class="btn-primary" type="button">Generate Mock Data</button>
      <button id="btn-copy" class="btn-secondary" type="button">Copy Output</button>
      <button id="btn-clear" class="btn-secondary" type="button">Clear</button>

      <div style="display:flex; align-items:center; gap:0.35rem; margin-left:auto;">
        <label style="font-size:0.72rem; font-weight:600; color:var(--text-secondary);">Records:</label>
        <input id="record-count" type="number" min="1" max="100" value="5"
          style="width:3.5rem; padding:0.3rem 0.5rem; border:1.5px solid var(--border); border-radius:0.375rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); background:var(--bg-surface); text-align:center;" />
      </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem;">
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">JSON Schema</label>
          <div style="display:flex; gap:0.4rem;">
            <button id="btn-sample-simple" class="btn-secondary" type="button" style="font-size:0.65rem; padding:0.15rem 0.45rem;">Simple</button>
            <button id="btn-sample-nested" class="btn-secondary" type="button" style="font-size:0.65rem; padding:0.15rem 0.45rem;">Nested</button>
          </div>
        </div>
        <textarea id="schema-input" class="input-themed" rows="14"
          placeholder='{"type":"object","properties":{"name":{"type":"string"},"age":{"type":"integer"}}}'
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65;"
        ></textarea>
      </div>
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Generated Mock Data</label>
        </div>
        <textarea id="json-output" class="input-themed" readonly rows="14"
          placeholder="Generated JSON appears here…"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65; background:var(--bg-surface-2);"
        ></textarea>
      </div>
    </div>

    <div id="error-box" style="display:none; margin-top:0.625rem; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); border-radius:0.5rem; padding:0.75rem 1rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:#DC2626;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Mock JSON Generator Overview</h2>
    <p class="seo-p">
      This mock JSON generator creates realistic sample data from a JSON Schema definition (draft-07 compatible). Running entirely in-browser with vanilla JavaScript, the tool parses your schema using <code class="inline-code">JSON.parse()</code> and recursively generates compliant data that satisfies every constraint defined in the schema. No data is sent to any server — all generation occurs client-side, ensuring complete privacy for proprietary data models or sensitive API contracts.
    </p>
    <p class="seo-p">
      Write a JSON Schema describing your desired data structure, set the number of records to generate (up to 100), and click <strong>Generate Mock Data</strong>. The generator supports <code class="inline-code">type</code>, <code class="inline-code">properties</code>, <code class="inline-code">items</code> (arrays), <code class="inline-code">enum</code>, <code class="inline-code">const</code>, <code class="inline-code">minimum/maximum</code>, <code class="inline-code">exclusiveMinimum/exclusiveMaximum</code>, <code class="inline-code">minLength/maxLength</code>, <code class="inline-code">pattern</code>, and <code class="inline-code">format</code> patterns. Use the <strong>Simple</strong> and <strong>Nested</strong> sample buttons to load pre-built schemas and see the tool in action instantly.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['API testing and staging environments', 'A frontend developer building a React or Vue component that consumes a REST API can generate dozens of realistic mock records to test rendering, pagination, and edge cases before the backend is ready. The generated data respects type constraints, so email fields contain valid emails and numeric fields stay within the defined range.'],
        ['Database seeding for development', 'A full-stack engineer setting up a local development database can define a schema for users, products, or orders and generate a batch of seed data. This eliminates the need to manually craft test records or install heavyweight mocking libraries, keeping the development environment lightweight and self-contained.'],
        ['Prototyping and design mockups', 'A UI/UX designer creating wireframes or high-fidelity prototypes needs realistic content to evaluate layout, spacing, and responsive behaviour. The generator produces data that looks like real records, making it possible to identify overflow, truncation, or alignment issues that placeholder text like "Lorem ipsum" would not reveal.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Schema-Driven Recursive Data Generation</h2>
    <p class="seo-p">
      The generator operates in three distinct stages: schema validation, recursive value generation, and output serialisation. The schema is parsed with <code class="inline-code">JSON.parse()</code>, which validates the JSON structure. The generator then traverses the schema tree recursively, producing a random value for each property based on its declared type and constraints.
    </p>
    <h3 class="seo-h3-sm">Type Detection and Constraint Resolution</h3>
    <p class="seo-p">
      For each property, the generator reads the <code class="inline-code">type</code> field and selects a generation strategy. Strings are generated using a pool of lowercase characters, with length controlled by <code class="inline-code">minLength</code> and <code class="inline-code">maxLength</code>. Integers and numbers use <code class="inline-code">minimum/maximum</code> and <code class="inline-code">exclusiveMinimum/exclusiveMaximum</code> to define the range. Booleans are random <code class="inline-code">true</code>/<code class="inline-code">false</code> values. Arrays use <code class="inline-code">minItems</code>/<code class="inline-code">maxItems</code> to control length, and each element is generated from the <code class="inline-code">items</code> schema.
    </p>
    <h3 class="seo-h3-sm">Format Pattern Generation</h3>
    <p class="seo-p">
      When a <code class="inline-code">format</code> keyword is present, the generator produces values that match the specified pattern: <code class="inline-code">email</code> generates realistic email addresses from name pools and domain lists; <code class="inline-code">date-time</code> produces ISO 8601 timestamps; <code class="inline-code">date</code> generates YYYY-MM-DD strings; <code class="inline-code">uuid</code> calls <code class="inline-code">crypto.randomUUID()</code> for v4 UUIDs; <code class="inline-code">ipv4</code>/<code class="inline-code">ipv6</code> generate valid IP address formats. The <code class="inline-code">enum</code> keyword randomly selects from a fixed list of allowed values, and <code class="inline-code">const</code> returns the specified constant.
    </p>
    <h3 class="seo-h3-sm">Nested Schema Resolution</h3>
    <p class="seo-p-none">
      Object and array types are resolved recursively. A property with <code class="inline-code">type: "object"</code> generates its own sub-properties based on the nested <code class="inline-code">properties</code> definition. Arrays generate a random number of elements (between <code class="inline-code">minItems</code> and <code class="inline-code">maxItems</code>), each conforming to the <code class="inline-code">items</code> schema. This recursive approach supports arbitrarily deep nesting, allowing complex data models with multiple levels of embedded objects and arrays.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What JSON Schema features are supported?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The generator supports <code class="inline-code">type</code>, <code class="inline-code">properties</code>, <code class="inline-code">items</code> (for arrays), <code class="inline-code">enum</code>, <code class="inline-code">const</code>, <code class="inline-code">minimum/maximum</code>, <code class="inline-code">exclusiveMinimum/exclusiveMaximum</code>, <code class="inline-code">minLength/maxLength</code>, <code class="inline-code">pattern</code>, <code class="inline-code">format</code>, and <code class="inline-code">required</code> fields. Draft-07 compatible schemas are fully supported. Keywords like <code class="inline-code">$ref</code>, <code class="inline-code">allOf</code>, and <code class="inline-code">oneOf</code> are not currently resolved.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What format patterns produce realistic data?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Supported formats include: <code class="inline-code">email</code> for realistic email addresses, <code class="inline-code">date-time</code> for ISO 8601 timestamps, <code class="inline-code">date</code> for YYYY-MM-DD strings, <code class="inline-code">time</code> for HH:mm:ss, <code class="inline-code">uri</code> for HTTPS URLs, <code class="inline-code">uuid</code> for v4 UUIDs via <code class="inline-code">crypto.randomUUID()</code>, <code class="inline-code">hostname</code> for domain names, and <code class="inline-code">ipv4</code>/<code class="inline-code">ipv6</code> for IP addresses. Each format produces contextually appropriate values rather than random strings.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does it handle nested object and array schemas?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. The generator recursively resolves nested <code class="inline-code">object</code> and <code class="inline-code">array</code> schemas. A property with <code class="inline-code">type: "object"</code> generates its own sub-properties from the nested <code class="inline-code">properties</code> definition. Arrays produce a random number of elements (between <code class="inline-code">minItems</code> and <code class="inline-code">maxItems</code>), each conforming to the <code class="inline-code">items</code> schema. This supports arbitrarily deep nesting.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Is the generated output always valid JSON?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. The output is always valid, parseable JSON. Each generated record is produced by the <code class="inline-code">generateValue()</code> function which returns a value matching the declared type and constraints. The final output is serialised with <code class="inline-code">JSON.stringify()</code> using 2-space indentation for readability.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What happens if the schema is invalid?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">If the schema is not valid JSON, the tool displays the exact error message from the JavaScript engine in a red error box below the input area. If the schema is valid JSON but does not conform to JSON Schema conventions (e.g., missing a <code class="inline-code">type</code> field), the generator will return <code class="inline-code">null</code> for unrecognised properties. Ensure your schema includes at minimum a <code class="inline-code">type</code> field at the root level.</p>
        </div>
      </div>

    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLES = {
    simple: JSON.stringify({
      type: "object",
      properties: {
        id: { type: "integer", minimum: 1, maximum: 1000 },
        name: { type: "string", minLength: 2, maxLength: 20 },
        email: { type: "string", format: "email" },
        age: { type: "integer", minimum: 18, maximum: 80 },
        active: { type: "boolean" },
        role: { type: "string", enum: ["admin", "editor", "viewer"] }
      },
      required: ["id", "name", "email"]
    }, null, 2),
    nested: JSON.stringify({
      type: "object",
      properties: {
        id: { type: "integer", minimum: 1 },
        name: { type: "string" },
        email: { type: "string", format: "email" },
        address: {
          type: "object",
          properties: {
            street: { type: "string" },
            city: { type: "string" },
            country: { type: "string" }
          }
        },
        tags: { type: "array", items: { type: "string" }, minItems: 1, maxItems: 3 },
        createdAt: { type: "string", format: "date-time" }
      }
    }, null, 2)
  };

  const FIRST_NAMES = ["Alice","Bob","Carol","Dave","Eve","Frank","Grace","Heidi","Ivan","Judy","Karl","Lena","Mike","Nina","Oscar","Pam","Quinn","Rita","Sam","Tina","Uma","Vic","Wendy","Xander","Yara","Zane"];
  const LAST_NAMES = ["Smith","Johnson","Williams","Brown","Jones","Garcia","Miller","Davis","Rodriguez","Martinez","Hernandez","Lopez","Gonzalez","Wilson","Anderson","Thomas","Taylor","Moore","Jackson","Martin"];
  const DOMAINS = ["example.com","test.org","demo.io","sample.net","mock.dev"];
  const CITIES = ["Sydney","Melbourne","Brisbane","Perth","Adelaide","Auckland","London","Berlin","Tokyo","New York"];
  const COUNTRIES = ["AU","NZ","US","UK","DE","JP","FR","CA"];
  const STREETS = ["123 Main St","456 Oak Ave","789 Pine Rd","321 Elm Blvd","654 Maple Dr"];

  function randomPick(arr: any[]) { return arr[Math.floor(Math.random() * arr.length)]; }
  function randomInt(min: number, max: number) { return Math.floor(Math.random() * (max - min + 1)) + min; }
  function randomStr(len: number) { const chars = 'abcdefghijklmnopqrstuvwxyz'; return Array.from({length: len}, () => chars[Math.floor(Math.random() * chars.length)]).join(''); }

  function generateValue(schema: any): any {
    if (schema.enum) return randomPick(schema.enum);
    if (schema.const) return schema.const;

    const type = schema.type;
    if (type === 'string') {
      if (schema.format === 'email') return `${randomStr(6)}@${randomPick(DOMAINS)}`;
      if (schema.format === 'date-time') return new Date(Date.now() - randomInt(0, 365 * 24 * 60 * 60 * 1000)).toISOString();
      if (schema.format === 'date') return new Date(Date.now() - randomInt(0, 365 * 24 * 60 * 60 * 1000)).toISOString().split('T')[0];
      if (schema.format === 'time') return `${String(randomInt(0,23)).padStart(2,'0')}:${String(randomInt(0,59)).padStart(2,'0')}:${String(randomInt(0,59)).padStart(2,'0')}`;
      if (schema.format === 'uri' || schema.format === 'url') return `https://${randomStr(8)}.${randomPick(['com','org','io','net'])}`;
      if (schema.format === 'uuid') return crypto.randomUUID();
      if (schema.format === 'hostname') return `${randomStr(8)}.${randomPick(['com','org','io'])}`;
      if (schema.format === 'ipv4') return `${randomInt(1,255)}.${randomInt(0,255)}.${randomInt(0,255)}.${randomInt(1,254)}`;
      if (schema.format === 'ipv6') return Array.from({length:8},()=>randomInt(0,65535).toString(16)).join(':');
      if (schema.pattern) {
        // Simple pattern support for common regex patterns
        const patternStr = schema.pattern;
        if (patternStr === '^[A-Z]{3}$') return randomStr(3).toUpperCase();
        if (patternStr === '^[a-z]+$') return randomStr(5);
        if (patternStr === '^\\d{4}-\\d{2}-\\d{2}$') return new Date(Date.now() - randomInt(0, 365 * 24 * 60 * 60 * 1000)).toISOString().split('T')[0];
      }
      const min = schema.minLength ?? 1;
      const max = schema.maxLength ?? 12;
      return randomStr(randomInt(min, max));
    }
    if (type === 'integer') {
      let min = schema.minimum ?? 0;
      let max = schema.maximum ?? 1000;
      if (schema.exclusiveMinimum === true) min = min + 1;
      if (schema.exclusiveMaximum === true) max = max - 1;
      if (schema.exclusiveMinimum !== undefined && schema.exclusiveMinimum !== true) min = schema.exclusiveMinimum + 1;
      if (schema.exclusiveMaximum !== undefined && schema.exclusiveMaximum !== true) max = schema.exclusiveMaximum - 1;
      return randomInt(min, max);
    }
    if (type === 'number') {
      let min = schema.minimum ?? 0;
      let max = schema.maximum ?? 1000;
      if (schema.exclusiveMinimum === true) min = min + 0.01;
      if (schema.exclusiveMaximum === true) max = max - 0.01;
      if (schema.exclusiveMinimum !== undefined && schema.exclusiveMinimum !== true) min = schema.exclusiveMinimum + 0.01;
      if (schema.exclusiveMaximum !== undefined && schema.exclusiveMaximum !== true) max = schema.exclusiveMaximum - 0.01;
      return Math.round((Math.random() * (max - min) + min) * 100) / 100;
    }
    if (type === 'boolean') return Math.random() > 0.5;
    if (type === 'null') return null;
    if (type === 'array') {
      const count = schema.minItems ?? 1;
      const maxCount = schema.maxItems ?? count + 2;
      const len = randomInt(count, maxCount);
      return Array.from({length: len}, () => generateValue(schema.items || {type: 'string'}));
    }
    if (type === 'object') {
      const obj: any = {};
      const required = schema.required || [];
      for (const [k, v] of Object.entries<any>(schema.properties || {})) {
        obj[k] = generateValue(v);
      }
      return obj;
    }
    return null;
  }

  function generate() {
    const raw = (document.getElementById('schema-input') as HTMLTextAreaElement).value;
    const out = (document.getElementById('json-output') as HTMLTextAreaElement);
    const errBox = document.getElementById('error-box')!;
    const count = Math.min(parseInt((document.getElementById('record-count') as HTMLInputElement).value) || 5, 100);
    errBox.style.display = 'none';

    if (!raw.trim()) { out.value = ''; return; }

    try {
      const schema = JSON.parse(raw);
      const data = Array.from({length: count}, () => generateValue(schema));
      out.value = JSON.stringify(data, null, 2);
    } catch (e: any) {
      errBox.textContent = e.message;
      errBox.style.display = 'block';
    }
  }

  document.getElementById('btn-generate')!.addEventListener('click', generate);
  document.getElementById('btn-sample-simple')!.addEventListener('click', () => {
    (document.getElementById('schema-input') as HTMLTextAreaElement).value = SAMPLES.simple;
    generate();
  });
  document.getElementById('btn-sample-nested')!.addEventListener('click', () => {
    (document.getElementById('schema-input') as HTMLTextAreaElement).value = SAMPLES.nested;
    generate();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('schema-input') as HTMLTextAreaElement).value = '';
    (document.getElementById('json-output') as HTMLTextAreaElement).value = '';
    document.getElementById('error-box')!.style.display = 'none';
  });
  document.getElementById('btn-copy')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy')!;
    navigator.clipboard.writeText((document.getElementById('json-output') as HTMLTextAreaElement).value).then(() => {
      btn.textContent = '✓ Copied!'; btn.classList.add('btn-success');
      setTimeout(() => { btn.textContent = 'Copy Output'; btn.classList.remove('btn-success'); }, 2000);
    }).catch(() => {});
  });
</script>
