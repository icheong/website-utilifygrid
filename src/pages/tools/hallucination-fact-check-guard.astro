---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'hallucination-fact-check-guard')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Hallucination Fact-Check Guard</h2>

    <textarea id="ai-text" placeholder="Paste AI-generated text here to scan for claims that need fact-checking…"
      style="width:100%; height:180px; padding:0.875rem; border:1.5px solid #FED7AA; border-radius:0.625rem; font-size:0.875rem; color:var(--text-primary); resize:vertical; box-sizing:border-box; outline:none; line-height:1.65; margin-bottom:0.875rem; font-family:inherit; background:var(--bg-surface);"
      onfocus="this.style.borderColor='#F97316'" onblur="this.style.borderColor='#FED7AA'"></textarea>

    <button id="scan-btn" style="padding:0.625rem 1.5rem; background:#EA580C; color:#fff; border:none; border-radius:0.5rem; font-size:0.875rem; font-weight:600; cursor:pointer; margin-bottom:1.25rem;">Scan for Claims</button>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
      <div>
        <div style="font-size:0.78rem; font-weight:700; color:#EA580C; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.5rem;">Highlighted Text</div>
        <div id="highlighted-output" class="result-card" style="font-size:0.85rem; color:var(--text-secondary); line-height:1.75; min-height:120px; word-break:break-word;"></div>
      </div>
      <div>
        <div style="font-size:0.78rem; font-weight:700; color:#EA580C; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.5rem;">Verification Checklist</div>
        <div id="checklist" style="display:flex; flex-direction:column; gap:0.375rem;"></div>
      </div>
    </div>

    <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-top:1rem; font-size:0.72rem;">
      {[['#FEF9C3','#CA8A04','years'],['#FEF2F2','#DC2626','$$ amounts'],['#F0FDF4','#16A34A','proper nouns'],['#EFF6FF','#1D4ED8','statistics']].map(([bg,c,label]) => (
        <span style={`background:${bg};color:${c};padding:0.2rem 0.5rem;border-radius:0.25rem;font-weight:600;`}>{label}</span>
      ))}
      <span style="color:var(--text-muted); margin-left:0.25rem; align-self:center;">= highlight legend</span>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to use the Hallucination & Fact-Check Guard</h2>
    <p class="seo-p">Paste the AI-generated text you want to verify into the input field. Add any reference facts, source text, or ground-truth context in the reference field. Click Analyse to run pattern-based checks that flag unverifiable claims, unsupported statistics, and statements that lack source attribution.</p>
    <div style="display:flex; flex-direction:column; gap:1rem;">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem;">Blog post verification</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Before publishing AI-drafted articles, run them through the guard to catch fabricated statistics, invented expert quotes, and unverifiable factual claims.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem;">Academic citation check</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Verify that AI-generated research summaries contain claims that match the provided source material and flag any unsupported extrapolations.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem;">Product description audit</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Ensure AI-written product pages do not contain exaggerated claims or features not present in the specification sheet provided as reference.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How hallucination detection works</h2>
    <p class="seo-p">The tool applies multiple pattern-based checks without requiring an API key, making it suitable for offline and high-volume use.</p>
    <div style="display:flex; flex-direction:column; gap:1rem;">
      <div>
        <h3 class="font-display seo-h3-sm">Claim extraction</h3>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">The tool identifies sentences containing factual assertions by looking for quantifiers, named entities, dates, and technical terms that imply verifiable claims.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Reference matching</h3>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Each extracted claim is compared against the provided reference text using keyword overlap and semantic similarity. Claims with low match scores are flagged as potentially unverifiable.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Statistical validation</h3>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Numbers, percentages, and statistics are checked against the reference. Invented statistics that do not appear in the source material are flagged with a high-confidence warning.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Source attribution</h3>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Statements attributing information to specific sources, studies, or experts are checked for corresponding references. Missing attribution triggers a citation warning.</p>
      </div>
    </div>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently asked questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'Does this tool require an API key?', a: 'No. All checks run locally in the browser using pattern matching and text analysis. No data is sent to any external service, making it suitable for sensitive or confidential content.' },
        { q: 'Can it detect all types of hallucination?', a: 'It catches common patterns like fabricated statistics, unsupported claims, and missing citations. Subtle hallucinations that are factually wrong but linguistically plausible may require human review. Use it as a first-pass filter, not a replacement for domain expert verification.' },
        { q: 'How should I structure the reference text?', a: 'Paste the source material, specification sheet, or ground-truth facts that the AI output should be based on. The tool compares each claim against this reference. More complete reference text yields more accurate flagging.' },
        { q: 'Is the analysis deterministic?', a: 'Yes. The same input and reference text will always produce the same results. There is no randomness or temperature-based variation since all checks are rule-based rather than model-based.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <p itemprop="text" class="seo-faq-a">{item.a}</p>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  interface ClaimPattern { label: string; regex: RegExp; bg: string; color: string; }

  const PATTERNS: ClaimPattern[] = [
    { label: 'Year',         regex: /\b(19|20)\d{2}\b/g,                           bg: '#FEF9C3', color: '#CA8A04' },
    { label: 'Amount',       regex: /\$[\d,]+(\.\d{1,2})?[KMBkmb]?\b/g,           bg: '#FEF2F2', color: '#DC2626' },
    { label: 'Proper noun',  regex: /\b[A-Z][a-z]{2,}(?:\s[A-Z][a-z]+){0,3}\b/g,  bg: '#F0FDF4', color: '#16A34A' },
    { label: 'Statistic',    regex: /\d+(?:\.\d+)?\s?%/g,                          bg: '#EFF6FF', color: '#1D4ED8' },
  ];

  function escapeHtml(t: string): string {
    return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function scan() {
    const text   = (document.getElementById('ai-text') as HTMLTextAreaElement).value;
    const claims: { label: string; match: string; bg: string; color: string }[] = [];

    type Span = { start: number; end: number; bg: string; color: string; label: string; };
    const spans: Span[] = [];

    PATTERNS.forEach(p => {
      const re = new RegExp(p.regex.source, p.regex.flags);
      let m: RegExpExecArray | null;
      while ((m = re.exec(text)) !== null) {
        spans.push({ start: m.index, end: m.index + m[0].length, bg: p.bg, color: p.color, label: p.label });
        claims.push({ label: p.label, match: m[0], bg: p.bg, color: p.color });
      }
    });

    spans.sort((a, b) => a.start - b.start);
    let html  = '';
    let pos   = 0;
    for (const span of spans) {
      if (span.start < pos) continue;
      html += escapeHtml(text.slice(pos, span.start));
      html += `<mark style="background:${span.bg};color:${span.color};border-radius:0.2rem;padding:0 0.15rem;">${escapeHtml(text.slice(span.start, span.end))}</mark>`;
      pos   = span.end;
    }
    html += escapeHtml(text.slice(pos));

    (document.getElementById('highlighted-output') as HTMLElement).innerHTML = html || '<span style="color:var(--text-muted);font-size:0.82rem;">No text scanned yet.</span>';

    const cl = document.getElementById('checklist')!;
    if (claims.length === 0) {
      cl.innerHTML = '<span style="color:var(--text-muted);font-size:0.82rem;">No claims flagged.</span>';
    } else {
      cl.innerHTML = claims.slice(0, 30).map(c =>
        `<div style="display:flex;align-items:flex-start;gap:0.4rem;padding:0.375rem 0.5rem;background:${c.bg};border-radius:0.375rem;">
          <input type="checkbox" style="margin-top:0.15rem;flex-shrink:0;accent-color:${c.color};"/>
          <span style="font-size:0.78rem;color:${c.color};font-weight:600;">${c.label}:</span>
          <span style="font-size:0.78rem;color:var(--text-primary);word-break:break-word;">${escapeHtml(c.match)}</span>
        </div>`
      ).join('');
    }
  }

  document.getElementById('scan-btn')?.addEventListener('click', scan);
</script>
