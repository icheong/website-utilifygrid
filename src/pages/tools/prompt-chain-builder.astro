---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'prompt-chain-builder')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Prompt Chain Builder</h2>

    <div id="chain-list" style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:0.875rem;"></div>

    <button id="add-step" class="btn-secondary" style="width:100%; border-color:#C4B5FD; color:#7C3AED; background:#F5F3FF; margin-bottom:1.25rem;">+ Add Step</button>

    <div style="display:flex; gap:0.5rem; margin-bottom:0.875rem;">
      <button id="export-json" class="btn-primary" style="background:#7C3AED;">Export JSON</button>
      <button id="export-text" class="btn-secondary">Export Text</button>
      <button id="copy-export" class="btn-secondary" style="margin-left:auto;">Copy</button>
    </div>

    <pre id="export-output" style="margin:0; background:#1E1E2E; border-radius:0.875rem; padding:1rem; font-family:'Fira Code',monospace; font-size:0.75rem; color:#E2E8F0; white-space:pre-wrap; word-break:break-all; max-height:280px; overflow-y:auto; line-height:1.7;"></pre>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to build a prompt chain</h2>
    <p class="seo-p">Add steps to your chain using the Add Step button. Each step has a role (system, user, or assistant) and a content field. Reorder steps using the up and down arrows. Export as JSON for direct API use or as a readable text preview.</p>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:0.75rem;">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Multi-turn conversation design</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Build a system-to-user-to-assistant sequence to prototype chatbot flows before writing any API code.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Few-shot prompting</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Pre-fill assistant messages with example responses to guide the model's output format and style consistently.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Iterative refinement chains</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Design a loop where the model's output feeds back into a new user message, enabling step-by-step improvement of code, text, or analysis.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">What is a prompt chain?</h2>
    <p class="seo-p">A prompt chain is a structured sequence of messages passed to an LLM API as the messages array. Rather than a single prompt, multi-turn chains let you pre-fill the conversation history to guide the model's reasoning, set up personas, provide worked examples, and build iterative refinement loops.</p>
    <h3 class="font-display seo-h3-sm">System role</h3>
    <p class="seo-p" set:html="Sets the context, persona, and constraints. Processed before any user messages. For GPT, passed as <code class='inline-code'>{role:'system'}</code>; for Claude, as a separate system parameter." />
    <h3 class="font-display seo-h3-sm">User role</h3>
    <p class="seo-p">Contains the actual task or question. In multi-step chains, later user messages can reference earlier assistant responses to create iterative refinement.</p>
    <h3 class="font-display seo-h3-sm">Assistant role</h3>
    <p class="seo-p">Pre-filling an assistant message primes the model to continue from a specific starting point. Useful for constraining output format, chain-of-thought reasoning, and few-shot examples.</p>
    <h3 class="font-display seo-h3-sm">Export formats</h3>
    <p class="seo-p">JSON export produces a valid messages array ready for OpenAI or Anthropic API calls. Text export provides a human-readable summary of each step for documentation and review.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently asked questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'How many steps should a prompt chain have?', a: 'There is no hard limit, but longer chains consume more tokens and cost more. Typical effective chains are 2 to 6 messages. Beyond that, consider whether the task should be broken into separate API calls with the output of one passed as context to the next.' },
        { q: 'Can I use this chain with Claude as well as GPT?', a: 'Yes with adaptation. The JSON format exports in OpenAI style. For Anthropic Claude API, the system message should be passed as a separate system parameter, and the remaining messages array contains only user and assistant alternating turns.' },
        { q: 'What is the difference between a chain and a single prompt?', a: 'A single prompt sends one message and gets one response. A chain pre-fills multiple turns of conversation history, letting you control the model\'s persona, show examples, and structure complex reasoning before the model generates its response.' },
        { q: 'How do I handle variable inputs in a chain?', a: 'Use placeholder text like [INSERT DATA HERE] in your step content. After exporting, replace these placeholders with actual values programmatically or manually before sending to the API. This keeps your chain template reusable across different inputs.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  interface Step { id: number; role: 'system'|'user'|'assistant'; content: string; }

  let nextId = 0;
  let steps: Step[] = [
    { id: nextId++, role: 'system',    content: 'You are a helpful expert assistant. Be concise and accurate.' },
    { id: nextId++, role: 'user',      content: 'Summarise the key principles of prompt engineering in 3 bullet points.' },
    { id: nextId++, role: 'assistant', content: '' },
  ];
  let exportMode = 'json';

  const ROLE_COLORS: Record<string, [string, string, string]> = {
    system:    ['#1E1E2E','#A78BFA','#EDE9FE'],
    user:      ['#0F172A','#38BDF8','#F0F9FF'],
    assistant: ['#064E3B','#34D399','#F0FDF4'],
  };

  function renderList() {
    const list = document.getElementById('chain-list')!;
    list.innerHTML = '';
    steps.forEach((step, idx) => {
      const [_dark, fg, bg] = ROLE_COLORS[step.role];
      const row = document.createElement('div');
      row.className = 'result-card';
      row.style.cssText = `background:${bg};border-color:${fg};padding:0.75rem;`;
      row.innerHTML = `
        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;">
          <select data-id="${step.id}" data-field="role"
            style="padding:0.25rem 0.5rem;border:none;border-radius:0.375rem;font-size:0.78rem;font-weight:700;color:${fg};background:transparent;cursor:pointer;">
            <option ${step.role==='system'?'selected':''}>system</option>
            <option ${step.role==='user'?'selected':''}>user</option>
            <option ${step.role==='assistant'?'selected':''}>assistant</option>
          </select>
          <span style="font-size:0.72rem;color:${fg};opacity:0.6;">Step ${idx + 1}</span>
          <div style="margin-left:auto;display:flex;gap:0.25rem;">
            <button data-id="${step.id}" data-action="up"
              style="background:none;border:none;cursor:pointer;color:${fg};font-size:0.9rem;padding:0 2px;" ${idx===0?'disabled':''}title="Move up">↑</button>
            <button data-id="${step.id}" data-action="down"
              style="background:none;border:none;cursor:pointer;color:${fg};font-size:0.9rem;padding:0 2px;" ${idx===steps.length-1?'disabled':''}title="Move down">↓</button>
            <button data-id="${step.id}" data-action="remove"
              style="background:none;border:none;cursor:pointer;color:${fg};font-size:1rem;padding:0 4px;">×</button>
          </div>
        </div>
        <textarea data-id="${step.id}" data-field="content" rows="3"
          placeholder="${step.role === 'assistant' ? 'Leave empty to let the model respond, or pre-fill to guide output…' : 'Enter message content…'}"
          style="width:100%;border:none;outline:none;background:transparent;font-size:0.82rem;color:var(--text-primary);resize:vertical;line-height:1.55;box-sizing:border-box;">${step.content}</textarea>
      `;
      list.appendChild(row);
    });

    list.querySelectorAll('select,textarea').forEach(el => {
      el.addEventListener('input', (e) => {
        const target = e.target as HTMLSelectElement | HTMLTextAreaElement;
        const id     = parseInt(target.dataset.id!);
        const field  = target.dataset.field!;
        const step   = steps.find(s => s.id === id)!;
        (step as any)[field] = target.value;
        if (field === 'role') { renderList(); }
        updateExport();
      });
    });

    list.querySelectorAll('[data-action]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const el     = e.currentTarget as HTMLElement;
        const id     = parseInt(el.dataset.id!);
        const action = el.dataset.action!;
        const idx    = steps.findIndex(s => s.id === id);
        if (action === 'remove') { steps.splice(idx, 1); }
        else if (action === 'up' && idx > 0) { [steps[idx-1], steps[idx]] = [steps[idx], steps[idx-1]]; }
        else if (action === 'down' && idx < steps.length-1) { [steps[idx], steps[idx+1]] = [steps[idx+1], steps[idx]]; }
        renderList(); updateExport();
      });
    });
  }

  function updateExport() {
    const out = document.getElementById('export-output')!;
    if (exportMode === 'json') {
      out.textContent = JSON.stringify(steps.map(s => ({ role: s.role, content: s.content })), null, 2);
    } else {
      out.textContent = steps.map((s, i) => `--- Step ${i+1}: ${s.role.toUpperCase()} ---\n${s.content || '(empty)'}`).join('\n\n');
    }
  }

  document.getElementById('add-step')?.addEventListener('click', () => {
    steps.push({ id: nextId++, role: 'user', content: '' });
    renderList(); updateExport();
  });

  document.getElementById('export-json')?.addEventListener('click', () => { exportMode = 'json'; updateExport(); });
  document.getElementById('export-text')?.addEventListener('click', () => { exportMode = 'text'; updateExport(); });

  document.getElementById('copy-export')?.addEventListener('click', () => {
    navigator.clipboard.writeText(document.getElementById('export-output')!.textContent || '');
    const btn = document.getElementById('copy-export')!;
    btn.textContent = '✓ Copied'; setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
  });

  renderList();
  updateExport();
</script>
