---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'density-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Density Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a density value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.25rem;">
      <div>
        <label class="tool-label" for="dens-input">Density</label>
        <input id="dens-input" type="number" value="1000" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="dens-unit">Unit</label>
        <select id="dens-unit" class="select-themed" style="min-width:12rem;">
          <option value="kgm3" selected>kg/m³</option>
          <option value="gcm3">g/cm³</option>
          <option value="gmL">g/mL</option>
          <option value="kgl">kg/L</option>
          <option value="gl">g/L</option>
          <option value="lbft3">lb/ft³</option>
          <option value="lbin3">lb/in³</option>
          <option value="lbgal">lb/US gal</option>
          <option value="lbigal">lb/imp gal</option>
          <option value="sg">Specific Gravity</option>
          <option value="slugsft3">slugs/ft³</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Material Densities</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Density Converter Overview</h2>
    <p class="seo-p">
      This density converter computes precise conversions between 11 density units — kilograms per cubic meter, grams per cubic centimeter, grams per milliliter, kilograms per liter, grams per liter, pounds per cubic foot, pounds per cubic inch, pounds per US gallon, pounds per imperial gallon, specific gravity, and slugs per cubic foot — entirely within your browser. Built with modern vanilla JavaScript, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your calculations, whether you are working in materials science, chemical engineering, food production, or construction.
    </p>
    <p class="seo-p">
      The converter supports the most commonly used density units across metric, imperial, and dimensionless systems. <strong>Specific Gravity</strong> (SG) is a dimensionless ratio comparing a substance's density to that of water at 4°C, making it invaluable for quick comparisons. The material density reference section provides benchmarks from air (1.225 kg/m³) to osmium (22,590 kg/m³), covering common engineering materials, precious metals, and everyday substances.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        [`Chemical engineering and process design`, `Chemical engineers design mixing, separation, and storage systems that depend on fluid densities. A reactor vessel holding a mixture of ethanol (SG ≈ 0.789) and water (SG = 1.0) requires density calculations to determine fluid levels, pump sizing, and heat transfer coefficients. Converting between kg/m³ and lb/ft³ is essential when working with international standards — a US-designed plant may specify fluids in lb/ft³ while European plants use kg/m³.`],
        [`Construction and building materials`, `Construction professionals specify concrete, asphalt, and aggregate densities for structural calculations. Normal-weight concrete has a density of approximately 2,400 kg/m³ (150 lb/ft³), while lightweight concrete ranges from 1,200 to 1,800 kg/m³. Converting between metric and imperial units is critical when sourcing materials from different regions — a specification calling for 145 lb/ft³ aggregate must be matched to the correct metric equivalent.`],
        [`Food and beverage quality control`, `Food scientists measure density to verify product concentration and quality. Honey (SG ≈ 1.42) is denser than water, while olive oil (SG ≈ 0.92) floats. Brix measurements (sugar content) correlate with density — a Brix 10° syrup has a density of approximately 1,040 kg/m³. Converting between g/mL (common in lab settings) and kg/m³ (common in industrial specifications) ensures consistent quality across production facilities.`]
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      All conversions use kilograms per cubic meter (kg/m³) as the universal base unit. Each supported density unit is defined by a fixed conversion factor relative to one kg/m³. To convert from unit A to unit B, the tool multiplies the input value by A's factor to obtain kg/m³, then divides by B's factor to obtain the target value. This hub-and-spoke model guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">kgm3</code>, <code class="inline-code">gcm3</code>, <code class="inline-code">lbft3</code>) to its conversion factor relative to kg/m³. Metric units use powers of 10: <code class="inline-code">1 g/cm³ = 1,000 kg/m³</code>. Imperial units use exact definitions: <code class="inline-code">1 lb/ft³ = 16.0185 kg/m³</code> (derived from <code class="inline-code">1 lb = 0.45359237 kg</code> and <code class="inline-code">1 ft = 0.3048 m</code>).
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion to kg/m³:</strong> The input value is multiplied by the source unit's factor. For example, converting 8.96 g/cm³ (copper) to kg/m³: <code class="inline-code">8.96 × 1,000 = 8,960 kg/m³</code>. Converting 557 lb/ft³ to kg/m³: <code class="inline-code">557 × 16.0185 ≈ 8,922 kg/m³</code>.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion from kg/m³:</strong> The kg/m³ value is divided by the target unit's factor. Converting 8,960 kg/m³ to lb/ft³: <code class="inline-code">8,960 / 16.0185 ≈ 559 lb/ft³</code>. Converting to Specific Gravity: <code class="inline-code">8,960 / 1,000 = 8.96</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>.
    </p>
    <p class="seo-p-sm">
      <strong>4. Dynamic formatting:</strong> The display format adapts to the magnitude of the result. Very large values (10⁹ or greater) use scientific notation. Values between 1,000 and 10⁹ use locale-formatted numbers with 2 decimal places. Values between 1 and 1,000 use 4 to 6 decimal places. Values below 0.001 use scientific notation. This ensures readability across the full range from air density to heavy metal alloys.
    </p>
    <p class="seo-p-none">
      <strong>Exact conversion factors:</strong> All factors are derived from exact international definitions: <code class="inline-code">1 lb = 0.45359237 kg</code> (exactly), <code class="inline-code">1 ft = 0.3048 m</code> (exactly), <code class="inline-code">1 in = 0.0254 m</code> (exactly), <code class="inline-code">1 US gallon = 3.785411784 L</code> (exactly), <code class="inline-code">1 imp gallon = 4.54609 L</code> (exactly), and <code class="inline-code">1 slug = 14.59390 kg</code> (derived from <code class="inline-code">1 lbf = 4.448221615 N</code>). The Specific Gravity factor is exactly <code class="inline-code">1,000</code> (the density of water at 4°C in kg/m³). These are all exact rational values, so the IEEE 754 approximations provide full double-precision accuracy.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is density?",
          a: "Density is the mass per unit volume of a substance, typically expressed as kg/m³ or g/cm³. Water has a density of 1,000 kg/m³ (1 g/cm³) at 4°C, which is used as the reference standard for specific gravity. Materials denser than water (SG > 1) sink, while less dense materials (SG < 1) float. Density is an intrinsic property — it does not depend on the sample size."
        },
        {
          q: "What is Specific Gravity?",
          a: "Specific Gravity (SG) is the dimensionless ratio of a substance's density to that of water at 4°C (1,000 kg/m³). An SG of 0.5 means the substance is half as dense as water and will float. An SG of 11.3 means it is 11.3 times denser than water and will sink rapidly. Specific Gravity is widely used in brewing, wine-making, and petroleum engineering because it provides an intuitive comparison without units."
        },
        {
          q: "What is the densest material on Earth?",
          a: "Osmium is the densest naturally occurring element at 22,590 kg/m³ (22.59 g/cm³). Iridium is nearly identical at 22,560 kg/m³. For comparison, gold is 19,300 kg/m³, lead is 11,340 kg/m³, and water is 1,000 kg/m³. Osmium is so dense that a sphere of osmium with a diameter of 1 metre would weigh approximately 11.8 metric tonnes."
        },
        {
          q: "Why does ice float on water?",
          a: "Ice has a density of approximately 917 kg/m³, which is less than water's 1,000 kg/m³. This occurs because water expands when it freezes, increasing its volume by approximately 9% while keeping the same mass. Hydrogen bonding in solid water creates an open hexagonal crystal structure that occupies more volume than the disordered liquid phase. This property is critical for aquatic ecosystems, as it insulates lakes and oceans in winter."
        },
        {
          q: "What is a slug?",
          a: "A slug is the imperial unit of mass, equal to approximately 14.594 kg. It is defined as the mass that accelerates at 1 ft/s² when a force of 1 pound-force (lbf) is applied, following F = ma. Slugs are used in engineering contexts where the foot-pound-second (FPS) system is standard, particularly in aerospace and structural engineering. The related unit lb/ft³ uses pounds-mass rather than slugs."
        },
        {
          q: "How do I convert between g/cm³ and kg/m³?",
          a: "To convert g/cm³ to kg/m³, multiply by 1,000. To convert kg/m³ to g/cm³, divide by 1,000. For example, aluminum has a density of 2.70 g/cm³ = 2,700 kg/m³. This simple factor of 1,000 comes from the relationship: 1 g/cm³ = (0.001 kg) / (0.000001 m³) = 1,000 kg/m³. The same factor applies to g/mL and kg/L since 1 mL = 1 cm³ and 1 L = 1,000 cm³."
        },
        {
          q: "How does temperature affect density?",
          a: "Density generally decreases as temperature increases because most materials expand when heated (thermal expansion). Water is an exception between 0°C and 4°C, where it becomes denser as it warms — this is why 4°C water sinks to the bottom of lakes. For most engineering calculations, density is specified at a standard temperature (often 20°C or 25°C) to ensure consistency across measurements."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to kg/m³ ─────────────────────────────────
  const TO_KGM3 = {
    kgm3:    1,
    gcm3:    1000,
    gmL:     1000,
    kgl:     1000,
    gl:      1,
    lbft3:   16.0184634,
    lbin3:   27679.90471,
    lbgal:   119.826,
    lbigal:  99.7763177,
    sg:      1000,
    slugsft3: 515.3788184,
  };

  const UNITS = [
    { id: 'kgm3',    label: 'kg/m³',   name: 'Kilogram per m³' },
    { id: 'gcm3',    label: 'g/cm³',   name: 'Gram per cm³' },
    { id: 'gmL',     label: 'g/mL',    name: 'Gram per mL' },
    { id: 'kgl',     label: 'kg/L',    name: 'Kilogram per Liter' },
    { id: 'gl',      label: 'g/L',     name: 'Gram per Liter' },
    { id: 'lbft3',   label: 'lb/ft³',  name: 'Pound per ft³' },
    { id: 'lbin3',   label: 'lb/in³',  name: 'Pound per in³' },
    { id: 'lbgal',   label: 'lb/gal',  name: 'Pound per US gal' },
    { id: 'lbigal',  label: 'lb/igal', name: 'Pound per imp gal' },
    { id: 'sg',      label: 'SG',      name: 'Specific Gravity' },
    { id: 'slugsft3',label: 'slug/ft³', name: 'Slug per ft³' },
  ];

  const REFS = [
    { name: 'Air (sea level)',     kgm3: 1.225 },
    { name: 'Oak Wood',            kgm3: 750 },
    { name: 'Ice',                 kgm3: 917 },
    { name: 'Water (4°C)',         kgm3: 1000 },
    { name: 'Seawater',            kgm3: 1025 },
    { name: 'Aluminum',            kgm3: 2700 },
    { name: 'Iron',                kgm3: 7874 },
    { name: 'Copper',              kgm3: 8960 },
    { name: 'Silver',              kgm3: 10490 },
    { name: 'Gold',                kgm3: 19300 },
    { name: 'Lead',                kgm3: 11340 },
    { name: 'Osmium',              kgm3: 22590 },
  ];

  const input    = document.getElementById('dens-input') as HTMLInputElement;
  const select   = document.getElementById('dens-unit') as HTMLSelectElement;
  const grid     = document.getElementById('results')!;
  const refsDiv  = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    return value.toExponential(4);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const kgm3     = val * TO_KGM3[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = kgm3 / TO_KGM3[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refsDiv.innerHTML = '';
    REFS.forEach(r => {
      const value = r.kgm3 / TO_KGM3[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refsDiv.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
