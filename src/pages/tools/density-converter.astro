---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'density-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Density Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a density value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.25rem;">
      <div>
        <label class="tool-label" for="dens-input">Density</label>
        <input id="dens-input" type="number" value="1000" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="dens-unit">Unit</label>
        <select id="dens-unit" class="select-themed" style="min-width:12rem;">
          <option value="kgm3" selected>kg/m³</option>
          <option value="gcm3">g/cm³</option>
          <option value="gmL">g/mL</option>
          <option value="kgl">kg/L</option>
          <option value="gl">g/L</option>
          <option value="lbft3">lb/ft³</option>
          <option value="lbin3">lb/in³</option>
          <option value="lbgal">lb/US gal</option>
          <option value="lbigal">lb/imp gal</option>
          <option value="sg">Specific Gravity</option>
          <option value="slugsft3">slugs/ft³</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Material Densities</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Convert Between Kg/m³, G/cm³, Lb/ft³, and Specific Gravity</h2>
    <p class="seo-p">
      A concrete specification calls for 150 lb/ft³ aggregate. Your supplier quotes in kg/m³. Type 150, select lb/ft³, and see that it equals 2,403 kg/m³, 2.403 g/cm³, and 2.403 SG. The material reference section confirms normal-weight concrete is around 2,400 kg/m³, so the numbers match.
    </p>
    <p class="seo-p">
      The converter handles 11 units: kg/m³, g/cm³, g/mL, kg/L, g/L, lb/ft³, lb/in³, lb/US gal, lb/imp gal, specific gravity, and slug/ft³. A food scientist measuring honey at SG 1.42 sees it equals 1,420 kg/m³ and 88.6 lb/ft³. A chemical engineer working with ethanol at 0.789 g/cm³ sees it equals 789 kg/m³ and 49.3 lb/ft³. The material reference shows air at 1.225 kg/m³ to osmium at 22,590 kg/m³.
    </p>

    <h3 class="font-display seo-h3-sm">Why density units confuse engineers across borders</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['US plants use lb/ft³, European plants use kg/m³', 'A US-designed chemical plant specifies a fluid at 62.4 lb/ft³. The European team needs kg/m³. The conversion factor is 16.0185: 62.4 x 16.0185 = 1,000 kg/m³ (water). If the engineer mistakenly uses 62.4 kg/m³ instead of 1,000, the pipe sizing is wrong by a factor of 16, and the pump cannot deliver the required flow rate.'],
        ['Specific gravity eliminates unit confusion', 'Specific gravity (SG) is dimensionless: the ratio of a substance density to water density (1,000 kg/m³ at 4°C). Gold at SG 19.3 means 19.3x denser than water. A jeweller verifying gold purity measures SG: 19.3 = pure, 18.0 = 14-karat alloy. SG works because it is the same number in any unit system.'],
        ['Lab measurements use g/mL, industrial specs use kg/m³', 'A lab technician measures a polymer at 1.15 g/mL. The factory specification requires kg/m³. Since 1 g/mL = 1,000 kg/m³, the polymer is 1,150 kg/m³. If the technician reports 1.15 kg/m³ (forgetting the factor of 1,000), the factory rejects the batch as too light. The converter prevents this error.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/weight-mass-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Weight & Mass Converter</a>
        <a href="/tools/volume-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Volume Converter</a>
        <a href="/tools/specific-volume-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Specific Volume Converter</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Density Converter Handles Kg/m³, G/cm³, and Lb/ft³</h2>
    <p class="seo-p">
      All conversions pass through kilograms per cubic meter (kg/m³). When you enter 8.96 g/cm³ (copper), the tool multiplies by 1,000 to get 8,960 kg/m³. Then it divides by each target unit's factor: by 16.0185 for lb/ft³, by 1,000 for specific gravity, by 0.03613 for lb/in³. The result: 8.96 g/cm³ = 8,960 kg/m³ = 559.1 lb/ft³ = 8.96 SG.
    </p>

    <h3 class="font-display seo-h3-sm">Why g/cm³ and kg/m³ differ by exactly 1,000</h3>
    <p class="seo-p-sm">
      1 g/cm³ = (0.001 kg) / (0.000001 m³) = 1,000 kg/m³. This factor of 1,000 comes from the centi prefix (10^-2) cubed: (10^-2)^3 = 10^-6 for volume, and the kilo prefix (10^3) for mass. The same factor applies to g/mL and kg/L since 1 mL = 1 cm³ and 1 L = 1,000 cm³. This is why specific gravity (which compares to water at 1,000 kg/m³) numerically equals g/cm³.
    </p>

    <h3 class="font-display seo-h3-sm">Imperial conversion factors from exact definitions</h3>
    <p class="seo-p-sm">
      lb/ft³ = 16.0185 kg/m³, derived from 1 lb = 0.45359237 kg and 1 ft = 0.3048 m. So 1 lb/ft³ = 0.45359237 / (0.3048)^3 = 0.45359237 / 0.0283168 = 16.0185. The US gallon factor is 8.3454 lb/US gal (from 1 US gal = 3.78541 L and water density). The imperial gallon factor is 10.022 lb/imp gal (from 1 imp gal = 4.54609 L). The slug is 14.5939 kg, derived from 1 lbf = 4.44822 N and g = 9.80665 m/s².
    </p>
    <p class="seo-p-none">
      Specific gravity is dimensionless: the ratio of a substance density to water density at 4°C (1,000 kg/m³). So SG = density in kg/m³ divided by 1,000. Gold at 19,300 kg/m³ has SG = 19.3. Air at 1.225 kg/m³ has SG = 0.001225. The converter handles SG as a unit with factor 1,000 (since SG x 1,000 = kg/m³).
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How do I convert 2.7 g/cm³ to lb/ft³?",
          a: "First convert to kg/m³: 2.7 x 1,000 = 2,700 kg/m³. Then divide by 16.0185: 2,700 / 16.0185 = 168.6 lb/ft³. This is the density of aluminum. The quick shortcut is to multiply g/cm³ by 62.43 to get lb/ft³ directly (since 1,000 / 16.0185 = 62.43). The converter shows all units simultaneously."
        },
        {
          q: "What material has a density of 1 g/cm³?",
          a: "Water at 4°C has a density of exactly 1 g/cm³ = 1,000 kg/m³ = 62.43 lb/ft³ = 1.0 SG. This is why water is the reference standard for specific gravity. Many common materials cluster around this value: wood (0.4-0.8 g/cm³), oil (0.8-0.9 g/cm³), ice (0.917 g/cm³). Materials above 1.0 sink in water, below 1.0 float."
        },
        {
          q: "Why does ice float if it is solid water?",
          a: "Water expands about 9% when it freezes because hydrogen bonding creates an open hexagonal crystal structure. This increases volume while keeping the same mass, reducing density from 1.0 g/cm³ to 0.917 g/cm³. Most materials contract when they solidify and become denser. Water is unusual, and this property is critical for aquatic life because lakes freeze from the top down."
        },
        {
          q: "What is the density of common metals?",
          a: "Aluminum: 2.70 g/cm³ (2,700 kg/m³). Iron: 7.87 g/cm³ (7,870 kg/m³). Copper: 8.96 g/cm³ (8,960 kg/m³). Silver: 10.49 g/cm³ (10,490 kg/m³). Gold: 19.32 g/cm³ (19,320 kg/m³). Osmium: 22.59 g/cm³ (22,590 kg/m³). The density reference section in the converter shows these values for quick lookup."
        },
        {
          q: "How accurate is specific gravity for quality control?",
          a: "Specific gravity is precise to about 0.1% with a standard hydrometer. Honey at SG 1.42 +/- 0.001 indicates about 82% sugar content. Wine at SG 0.995 indicates fermentation is complete (all sugar converted to alcohol). Petroleum products are graded by API gravity, which is a modified specific gravity scale. SG is reliable for quality control because temperature corrections are well-established."
        },
        {
          q: "What is the density of air and why does it matter?",
          a: "Air at sea level and 15°C has a density of 1.225 kg/m³ (0.0765 lb/ft³). This matters for aircraft performance (lift depends on air density), HVAC system sizing (fan capacity depends on air mass flow), and combustion calculations (stoichiometric air-fuel ratio depends on air density). At 3,000 m altitude, air density drops to about 0.91 kg/m³, reducing aircraft lift by 25%."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to kg/m³ ─────────────────────────────────
  const TO_KGM3 = {
    kgm3:    1,
    gcm3:    1000,
    gmL:     1000,
    kgl:     1000,
    gl:      1,
    lbft3:   16.0184634,
    lbin3:   27679.90471,
    lbgal:   119.826,
    lbigal:  99.7763177,
    sg:      1000,
    slugsft3: 515.3788184,
  };

  const UNITS = [
    { id: 'kgm3',    label: 'kg/m³',   name: 'Kilogram per m³' },
    { id: 'gcm3',    label: 'g/cm³',   name: 'Gram per cm³' },
    { id: 'gmL',     label: 'g/mL',    name: 'Gram per mL' },
    { id: 'kgl',     label: 'kg/L',    name: 'Kilogram per Liter' },
    { id: 'gl',      label: 'g/L',     name: 'Gram per Liter' },
    { id: 'lbft3',   label: 'lb/ft³',  name: 'Pound per ft³' },
    { id: 'lbin3',   label: 'lb/in³',  name: 'Pound per in³' },
    { id: 'lbgal',   label: 'lb/gal',  name: 'Pound per US gal' },
    { id: 'lbigal',  label: 'lb/igal', name: 'Pound per imp gal' },
    { id: 'sg',      label: 'SG',      name: 'Specific Gravity' },
    { id: 'slugsft3',label: 'slug/ft³', name: 'Slug per ft³' },
  ];

  const REFS = [
    { name: 'Air (sea level)',     kgm3: 1.225 },
    { name: 'Oak Wood',            kgm3: 750 },
    { name: 'Ice',                 kgm3: 917 },
    { name: 'Water (4°C)',         kgm3: 1000 },
    { name: 'Seawater',            kgm3: 1025 },
    { name: 'Aluminum',            kgm3: 2700 },
    { name: 'Iron',                kgm3: 7874 },
    { name: 'Copper',              kgm3: 8960 },
    { name: 'Silver',              kgm3: 10490 },
    { name: 'Gold',                kgm3: 19300 },
    { name: 'Lead',                kgm3: 11340 },
    { name: 'Osmium',              kgm3: 22590 },
  ];

  const input    = document.getElementById('dens-input') as HTMLInputElement;
  const select   = document.getElementById('dens-unit') as HTMLSelectElement;
  const grid     = document.getElementById('results')!;
  const refsDiv  = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    return value.toExponential(4);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const kgm3     = val * TO_KGM3[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = kgm3 / TO_KGM3[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refsDiv.innerHTML = '';
    REFS.forEach(r => {
      const value = r.kgm3 / TO_KGM3[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refsDiv.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
