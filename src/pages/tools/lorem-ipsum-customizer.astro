// ═══════════════════════════════════════════════════════════
// SENTENCE LENGTH CONFIG
// ═══════════════════════════════════════════════════════════
const SENT_LENGTHS: Record<string,[number,number][]> = {
  short:  [[6,10]],
  medium: [[8,18]],
  long:   [[15,30]],
  mixed:  [[6,10],[8,18],[15,30],[8,14]],
};

// ═══════════════════════════════════════════════════════════
// GENERATION CORE
// ═══════════════════════════════════════════════════════════

function randInt(min: number, max: number): number {
  return Math.floor(Math.random() * (max - min + 1)) + min;
}

function capitalize(s: string): string {
  return s.charAt(0).toUpperCase() + s.slice(1);
}

function pickWord(words: string[]): string {
  return words[Math.floor(Math.random() * words.length)];
}

function buildSentence(words: string[], sentLenKey: string, idx: number): string {
  const ranges = SENT_LENGTHS[sentLenKey];
  const [min, max] = ranges[Math.floor(Math.random() * ranges.length)];
  const len = randInt(min, max);
  const picked: string[] = [];
  for (let i = 0; i < len; i++) picked.push(pickWord(words));
  // Capitalise first word, end with . or ? or !
  const punct = Math.random() < 0.08 ? (Math.random() < 0.5 ? '?' : '!') : '.';
  return capitalize(picked.join(' ')) + punct;
}

function buildSentenceWithOpener(words: string[], openers: string[], sentLenKey: string): string {
  const opener = pickWord(openers);
  const ranges = SENT_LENGTHS[sentLenKey];
  const [min, max] = ranges[Math.floor(Math.random() * ranges.length)];
  const len = randInt(Math.max(3, min - 2), max - 2);
  const picked: string[] = [];
  for (let i = 0; i < len; i++) picked.push(pickWord(words));
  const punct = Math.random() < 0.08 ? (Math.random() < 0.5 ? '?' : '!') : '.';
  return `${capitalize(opener)} ${picked.join(' ')}${punct}`;
}

function buildParagraph(
  words: string[],
  openers: string[],
  sentLenKey: string,
  sentCount: number
): string {
  const sents: string[] = [];
  for (let i = 0; i < sentCount; i++) {
    if (openers.length && Math.random() < 0.4) {
      sents.push(buildSentenceWithOpener(words, openers, sentLenKey));
    } else {
      sents.push(buildSentence(words, sentLenKey, i));
    }
  }
  return sents.join(' ');
}

function generateText(
  unit: string,
  amount: number,
  variantKey: string,
  sentLenKey: string,
  startLorem: boolean,
  allCaps: boolean
): string[] {
  const pool   = POOLS[variantKey];
  const words  = pool.words;
  const openers = pool.sentenceOpeners ?? [];

  const paragraphs: string[] = [];

  if (unit === 'paragraphs') {
    for (let p = 0; p < amount; p++) {
      const sentCount = randInt(3, 7);
      let para = buildParagraph(words, openers, sentLenKey, sentCount);
      if (p === 0 && startLorem && pool.opener) {
        para = pool.opener + ' ' + buildParagraph(words, openers, sentLenKey, sentCount - 1);
      }
      paragraphs.push(para);
    }

  } else if (unit === 'sentences') {
    const sents: string[] = [];
    if (startLorem && pool.opener) sents.push(pool.opener);
    while (sents.length < amount) {
      if (openers.length && Math.random() < 0.4) {
        sents.push(buildSentenceWithOpener(words, openers, sentLenKey));
      } else {
        sents.push(buildSentence(words, sentLenKey, sents.length));
      }
    }
    // Group into paragraphs of 3–5 sentences
    for (let i = 0; i < sents.length; i += randInt(3,5)) {
      paragraphs.push(sents.slice(i, i + randInt(3,5)).join(' '));
    }

  } else if (unit === 'words') {
    let wordList: string[] = [];
    if (startLorem && pool.opener) wordList = pool.opener.split(' ');
    while (wordList.length < amount) wordList.push(pickWord(words));
    wordList = wordList.slice(0, amount);
    // Build into sentences then paragraphs
    let buf = '';
    for (let i = 0; i < wordList.length; i++) {
      const w = wordList[i];
      buf += (buf ? ' ' : '') + (i === 0 ? capitalize(w) : w);
      if (i === wordList.length - 1 || (i > 0 && i % randInt(8,15) === 0)) {
        buf += '.';
        if (buf.length > 0) { paragraphs.push(buf); buf = ''; }
      }
    }
    if (buf) paragraphs.push(buf + '.');

  } else if (unit === 'characters') {
    let text = '';
    if (startLorem && pool.opener) text = pool.opener + ' ';
    while (text.length < amount) {
      text += buildParagraph(words, openers, sentLenKey, randInt(3,6)) + '\n\n';
    }
    text = text.slice(0, amount);
    paragraphs.push(text.trim());

  } else if (unit === 'bytes') {
    let text = '';
    if (startLorem && pool.opener) text = pool.opener + ' ';
    while (new TextEncoder().encode(text).length < amount) {
      text += buildParagraph(words, openers, sentLenKey, randInt(3,6)) + '\n\n';
    }
    // Truncate at byte boundary
    const enc = new TextEncoder();
    let b = 0;
    let truncated = '';
    for (const char of text) {
      const cb = enc.encode(char).length;
      if (b + cb > amount) break;
      truncated += char;
      b += cb;
    }
    paragraphs.push(truncated.trim());

  } else if (unit === 'list') {
    for (let i = 0; i < amount; i++) {
      if (i === 0 && startLorem && pool.opener) { paragraphs.push(pool.opener); continue; }
      paragraphs.push(buildSentence(words, sentLenKey, i));
    }
  }

  return paragraphs.map(p => allCaps ? p.toUpperCase() : p);
}

// ═══════════════════════════════════════════════════════════
// FORMAT WRAPPING
// ═══════════════════════════════════════════════════════════
function formatOutput(paragraphs: string[], format: string, unit: string): string {
  switch (format) {
    case 'plain':
      return paragraphs.join(unit === 'list' ? '\n' : '\n\n');

    case 'html-p':
      return paragraphs.map(p => `<p>${p}</p>`).join('\n');

    case 'html-div':
      return paragraphs.map(p => `<div>${p}</div>`).join('\n');

    case 'html-li':
      return `<ul>\n${paragraphs.map(p => `  <li>${p}</li>`).join('\n')}\n</ul>`;

    case 'html-h2p': {
      const fakeHeadings = ['Introduction','Background','Overview','Details','Summary','Context','Discussion','Notes','Remarks','Further Reading'];
      return paragraphs.map((p, i) =>
        `<h2>${fakeHeadings[i % fakeHeadings.length]}</h2>\n<p>${p}</p>`
      ).join('\n\n');
    }

    case 'md-para':
      return paragraphs.join('\n\n');

    case 'md-list':
      return paragraphs.map(p => `- ${p}`).join('\n');

    case 'md-h2': {
      const headings = ['Introduction','Background','Overview','Details','Summary','Context','Discussion','Notes'];
      return paragraphs.map((p, i) =>
        `## ${headings[i % headings.length]}\n\n${p}`
      ).join('\n\n');
    }

    case 'json-array':
      return JSON.stringify(paragraphs, null, 2);

    case 'json-obj':
      return JSON.stringify(
        paragraphs.map((p, i) => ({ id: i + 1, content: p })),
        null, 2
      );

    case 'csv': {
      const rows = paragraphs.map((p, i) =>
        `${i+1},"${p.replace(/"/g,'""')}"`
      );
      return `id,content\n${rows.join('\n')}`;
    }

    case 'sql': {
      const rows = paragraphs.map((p, i) =>
        `(${i+1}, '${p.replace(/'/g,"''")}')`
      );
      return `INSERT INTO lorem_ipsum (id, content) VALUES\n${rows.join(',\n')};`;
    }

    default:
      return paragraphs.join('\n\n');
  }
}

// ═══════════════════════════════════════════════════════════
// STATS
// ═══════════════════════════════════════════════════════════
function calcStats(text: string) {
  const words = text.trim().split(/\s+/).filter(Boolean).length;
  const chars = text.length;
  const bytes = new TextEncoder().encode(text).length;
  const paras = text.split(/\n{2,}/).filter(s => s.trim()).length;
  return { words, chars, bytes, paras };
}

// ═══════════════════════════════════════════════════════════
// DOM REFS
// ═══════════════════════════════════════════════════════════
const amountInput    = document.getElementById('amount-input')    as HTMLInputElement;
const amountSlider   = document.getElementById('amount-slider')   as HTMLInputElement;
const amountUnitLabel= document.getElementById('amount-unit-label')!;
const sliderMinLabel = document.getElementById('slider-min-label')!;
const sliderMidLabel = document.getElementById('slider-mid-label')!;
const sliderMaxLabel = document.getElementById('slider-max-label')!;
const variantSelect  = document.getElementById('variant-select')  as HTMLSelectElement;
const formatSelect   = document.getElementById('format-select')   as HTMLSelectElement;
const sentLengthSel  = document.getElementById('sent-length')     as HTMLSelectElement;
const optStartLorem  = document.getElementById('opt-startlorem')  as HTMLInputElement;
const optAllCaps     = document.getElementById('opt-allcaps')     as HTMLInputElement;
const optHtmlDecode  = document.getElementById('opt-html-decode') as HTMLInputElement;
const btnGenerate    = document.getElementById('btn-generate')!;
const btnCopy        = document.getElementById('btn-copy')!;
const btnDownload    = document.getElementById('btn-download')!;
const btnRegen       = document.getElementById('btn-regen')!;
const outputSection  = document.getElementById('output-section')!;
const outputText     = document.getElementById('output-text')     as HTMLTextAreaElement;
const outputPreview  = document.getElementById('output-preview')!;
const statParas      = document.getElementById('stat-paras')!;
const statWords      = document.getElementById('stat-words')!;
const statChars      = document.getElementById('stat-chars')!;
const statBytes      = document.getElementById('stat-bytes')!;

// ═══════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════
let currentUnit = 'paragraphs';
let lastGenerated = '';

// ═══════════════════════════════════════════════════════════
// UNIT BUTTONS
// ═══════════════════════════════════════════════════════════
document.querySelectorAll('.unit-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.unit-btn').forEach(b => {
      (b as HTMLElement).style.borderColor = 'var(--border)';
      (b as HTMLElement).style.background  = 'var(--bg-surface-2)';
      (b as HTMLElement).style.color       = 'var(--text-secondary)';
      b.classList.remove('active-unit');
    });
    (btn as HTMLElement).style.borderColor = '#C2410C';
    (btn as HTMLElement).style.background  = 'rgba(194,65,12,0.1)';
    (btn as HTMLElement).style.color       = '#C2410C';
    btn.classList.add('active-unit');
    currentUnit = (btn as HTMLElement).dataset.unit!;
    applySliderCfg(currentUnit);
  });
});

// ═══════════════════════════════════════════════════════════
// SLIDER CONFIG — per-unit ranges and slider scale
// ═══════════════════════════════════════════════════════════
type SliderCfg = { min: number; max: number; step: number; default: number; label: string; midLabel: string };
const SLIDER_CFG: Record<string, SliderCfg> = {
  paragraphs:  { min:1,   max:20,   step:1,    default:5,   label:'paragraphs',  midLabel:'10' },
  sentences:   { min:1,   max:50,   step:1,    default:10,  label:'sentences',   midLabel:'25' },
  words:       { min:10,  max:1000, step:10,   default:100, label:'words',       midLabel:'500' },
  characters:  { min:50,  max:5000, step:50,   default:500, label:'characters',  midLabel:'2,500' },
  bytes:       { min:64,  max:4096, step:64,   default:512, label:'bytes',       midLabel:'2,048' },
  list:        { min:1,   max:30,   step:1,    default:8,   label:'list items',  midLabel:'15' },
};

function applySliderCfg(unit: string) {
  const cfg = SLIDER_CFG[unit] ?? SLIDER_CFG['paragraphs'];
  amountSlider.min   = String(cfg.min);
  amountSlider.max   = String(cfg.max);
  amountSlider.step  = String(cfg.step);
  amountSlider.value = String(cfg.default);
  amountInput.min    = String(cfg.min);
  amountInput.max    = String(cfg.max);
  amountInput.value  = String(cfg.default);
  sliderMinLabel.textContent = String(cfg.min);
  sliderMaxLabel.textContent = String(cfg.max);
  sliderMidLabel.textContent = cfg.midLabel;
  amountUnitLabel.textContent = cfg.label;
}

// ─ slider ↔ number input sync
amountSlider.addEventListener('input', () => {
  amountInput.value = amountSlider.value;
});
amountInput.addEventListener('input', () => {
  const v = parseInt(amountInput.value) || 1;
  const cfg = SLIDER_CFG[currentUnit];
  const clamped = Math.max(cfg.min, Math.min(cfg.max, v));
  amountSlider.value = String(clamped);
});

// ═══════════════════════════════════════════════════════════
// GENERATE
// ═══════════════════════════════════════════════════════════
function generate() {
  const amount    = Math.max(1, Math.min(9999, parseInt(amountInput.value)||5));
  const variant   = variantSelect.value;
  const format    = formatSelect.value;
  const sentLen   = sentLengthSel.value;
  const startLorem= optStartLorem.checked;
  const allCaps   = optAllCaps.checked;

  const paragraphs = generateText(currentUnit, amount, variant, sentLen, startLorem, allCaps);
  const formatted  = formatOutput(paragraphs, format, currentUnit);
  lastGenerated    = formatted;

  outputText.value       = formatted;
  outputSection.style.display = 'block';

  const s = calcStats(formatted);
  statParas.textContent = `${paragraphs.length} blocks`;
  statWords.textContent = `${s.words.toLocaleString()} words`;
  statChars.textContent = `${s.chars.toLocaleString()} chars`;
  statBytes.textContent = `${s.bytes.toLocaleString()} bytes`;

  // HTML preview
  const showPreview = optHtmlDecode.checked && (format.startsWith('html') || format.startsWith('md'));
  outputPreview.style.display = showPreview ? 'block' : 'none';
  if (showPreview) {
    if (format.startsWith('html')) {
      outputPreview.innerHTML = formatted;
    } else {
      // Simple markdown → html for preview
      outputPreview.innerHTML = formatted
        .replace(/^## (.+)$/gm, '<h2>$1</h2>')
        .replace(/^- (.+)$/gm, '<li>$1</li>')
        .replace(/<li>/g, '<ul><li>').replace(/<\/li>\n/g, '</li></ul>\n')
        .replace(/\n\n/g, '</p><p>')
        .replace(/^([^<].+)$/gm, '<p>$1</p>');
    }
  }
}

btnGenerate.addEventListener('click', generate);
btnRegen.addEventListener('click', generate);

// ─ copy
btnCopy.addEventListener('click', () => {
  navigator.clipboard.writeText(lastGenerated).then(() => {
    btnCopy.textContent = '✓ Copied!';
    setTimeout(() => { btnCopy.textContent = 'Copy'; }, 2000);
  });
});

// ─ download
btnDownload.addEventListener('click', () => {
  const ext = formatSelect.value.startsWith('html') ? 'html' :
              formatSelect.value.startsWith('md')   ? 'md'   :
              formatSelect.value === 'json-array' || formatSelect.value === 'json-obj' ? 'json' :
              formatSelect.value === 'csv' ? 'csv' :
              formatSelect.value === 'sql' ? 'sql' : 'txt';
  const blob = new Blob([lastGenerated], { type: 'text/plain' });
  const a    = document.createElement('a');
  a.href     = URL.createObjectURL(blob);
  a.download = `lorem-ipsum.${ext}`;
  a.click();
  URL.revokeObjectURL(a.href);
});

// ─ responsive controls grid
function adjustLayout() {
  const g = document.getElementById('controls-grid')!;
  g.style.gridTemplateColumns = window.innerWidth < 500 ? '1fr' : '1fr 1fr';
}
window.addEventListener('resize', adjustLayout);
adjustLayout();

// ─ init slider for default unit
applySliderCfg('paragraphs');

// ─ generate on load
generate();
</script>
