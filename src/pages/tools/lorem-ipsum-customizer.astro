---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'lorem-ipsum-customizer')!;
---

<ToolLayout tool={tool}>
  <div slot="tool">

    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.2rem;">
      Lorem Ipsum &amp; Dummy Text Customizer
    </h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">
      Slide to your exact count — paragraphs, sentences, words, characters, bytes, or list items — every format, every flavour.
    </p>

    <!-- ══ Controls grid ══ -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:0.875rem;" id="controls-grid">

      <!-- Unit type -->
      <div>
        <label style="display:block;font-size:0.68rem;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.4rem;">Generate</label>
        <div style="display:flex;gap:0.3rem;flex-wrap:wrap;" id="unit-group">
          <button class="unit-btn active-unit" data-unit="paragraphs" style="padding:0.35rem 0.65rem;border-radius:0.4rem;border:1.5px solid #C2410C;background:rgba(194,65,12,0.1);color:#C2410C;font-size:0.75rem;font-weight:700;cursor:pointer;transition:all 0.15s;">Paragraphs</button>
          <button class="unit-btn" data-unit="sentences" style="padding:0.35rem 0.65rem;border-radius:0.4rem;border:1.5px solid var(--border);background:var(--bg-surface-2);color:var(--text-secondary);font-size:0.75rem;font-weight:700;cursor:pointer;transition:all 0.15s;">Sentences</button>
          <button class="unit-btn" data-unit="words" style="padding:0.35rem 0.65rem;border-radius:0.4rem;border:1.5px solid var(--border);background:var(--bg-surface-2);color:var(--text-secondary);font-size:0.75rem;font-weight:700;cursor:pointer;transition:all 0.15s;">Words</button>
          <button class="unit-btn" data-unit="characters" style="padding:0.35rem 0.65rem;border-radius:0.4rem;border:1.5px solid var(--border);background:var(--bg-surface-2);color:var(--text-secondary);font-size:0.75rem;font-weight:700;cursor:pointer;transition:all 0.15s;">Characters</button>
          <button class="unit-btn" data-unit="bytes" style="padding:0.35rem 0.65rem;border-radius:0.4rem;border:1.5px solid var(--border);background:var(--bg-surface-2);color:var(--text-secondary);font-size:0.75rem;font-weight:700;cursor:pointer;transition:all 0.15s;">Bytes</button>
          <button class="unit-btn" data-unit="list" style="padding:0.35rem 0.65rem;border-radius:0.4rem;border:1.5px solid var(--border);background:var(--bg-surface-2);color:var(--text-secondary);font-size:0.75rem;font-weight:700;cursor:pointer;transition:all 0.15s;">List items</button>
        </div>
      </div>

      <!-- Amount slider -->
      <div>
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:0.4rem;">
          <label for="amount-slider" style="font-size:0.68rem;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.07em;">Amount</label>
          <!-- Value badge + fine-tune input -->
          <div style="display:flex;align-items:center;gap:0.35rem;">
            <input id="amount-input" type="number" min="1" max="9999" value="5"
              style="width:4.5rem;padding:0.2rem 0.4rem;background:var(--bg-surface-2);border:1.5px solid var(--border);border-radius:0.375rem;font-family:'Fira Code',monospace;font-size:0.82rem;font-weight:700;color:#C2410C;text-align:center;outline:none;" />
            <span id="amount-unit-label" style="font-size:0.7rem;color:var(--text-muted);white-space:nowrap;">paragraphs</span>
          </div>
        </div>
        <input id="amount-slider" type="range" min="1" max="20" value="5"
          style="width:100%;accent-color:#C2410C;cursor:pointer;margin-bottom:0.25rem;" />
        <div style="display:flex;justify-content:space-between;">
          <span id="slider-min-label" style="font-size:0.65rem;color:var(--text-muted);font-family:'Fira Code',monospace;">1</span>
          <span id="slider-mid-label" style="font-size:0.65rem;color:var(--text-muted);font-family:'Fira Code',monospace;"></span>
          <span id="slider-max-label" style="font-size:0.65rem;color:var(--text-muted);font-family:'Fira Code',monospace;">20</span>
        </div>
      </div>

    </div>

    <!-- ══ Variant + Format row ══ -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:0.875rem;">

      <!-- Variant / flavour -->
      <div>
        <label style="display:block;font-size:0.68rem;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.4rem;">Text variant</label>
        <select id="variant-select"
          style="width:100%;padding:0.45rem 0.6rem;background:var(--bg-surface-2);border:1.5px solid var(--border);border-radius:0.4rem;font-size:0.82rem;color:var(--text-primary);outline:none;cursor:pointer;">
          <option value="classic">Classic Lorem Ipsum</option>
          <option value="cicero">Cicero (original Latin)</option>
          <option value="corporate">Corporate Buzzword</option>
          <option value="pirate">Pirate Speak</option>
          <option value="hipster">Hipster Ipsum</option>
          <option value="tech">Tech / Startup</option>
          <option value="legal">Legal / Boilerplate</option>
          <option value="medieval">Medieval / Fantasy</option>
          <option value="emoji">Emoji Ipsum</option>
        </select>
      </div>

      <!-- Output format -->
      <div>
        <label style="display:block;font-size:0.68rem;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.4rem;">Output format</label>
        <select id="format-select"
          style="width:100%;padding:0.45rem 0.6rem;background:var(--bg-surface-2);border:1.5px solid var(--border);border-radius:0.4rem;font-size:0.82rem;color:var(--text-primary);outline:none;cursor:pointer;">
          <option value="plain">Plain text</option>
          <option value="html-p">HTML &lt;p&gt; tags</option>
          <option value="html-div">HTML &lt;div&gt; tags</option>
          <option value="html-li">HTML &lt;li&gt; list items</option>
          <option value="html-h2p">HTML h2 + paragraphs</option>
          <option value="md-para">Markdown paragraphs</option>
          <option value="md-list">Markdown unordered list</option>
          <option value="md-h2">Markdown ## headings + body</option>
          <option value="json-array">JSON array of strings</option>
          <option value="json-obj">JSON array of objects</option>
          <option value="csv">CSV rows</option>
          <option value="sql">SQL INSERT values</option>
        </select>
      </div>

    </div>

    <!-- ══ Options row ══ -->
    <div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center;padding:0.625rem 0.875rem;background:var(--bg-surface-2);border:1.5px solid var(--border);border-radius:0.625rem;margin-bottom:0.875rem;">
      <label style="display:flex;align-items:center;gap:0.4rem;cursor:pointer;font-size:0.78rem;font-weight:600;color:var(--text-secondary);user-select:none;">
        <input id="opt-startlorem" type="checkbox" checked style="accent-color:#C2410C;width:0.85rem;height:0.85rem;" />
        Start with "Lorem ipsum…"
      </label>
      <span style="color:var(--border);">·</span>
      <label style="display:flex;align-items:center;gap:0.4rem;cursor:pointer;font-size:0.78rem;font-weight:600;color:var(--text-secondary);user-select:none;">
        <input id="opt-allcaps" type="checkbox" style="accent-color:#C2410C;width:0.85rem;height:0.85rem;" />
        ALL CAPS
      </label>
      <span style="color:var(--border);">·</span>
      <label style="display:flex;align-items:center;gap:0.4rem;cursor:pointer;font-size:0.78rem;font-weight:600;color:var(--text-secondary);user-select:none;">
        <input id="opt-html-decode" type="checkbox" style="accent-color:#C2410C;width:0.85rem;height:0.85rem;" />
        Render HTML preview
      </label>
      <span style="color:var(--border);">·</span>
      <!-- Paragraph length (min/max words per sentence) -->
      <div style="display:flex;align-items:center;gap:0.35rem;font-size:0.78rem;font-weight:600;color:var(--text-secondary);">
        Sentence length:
        <select id="sent-length"
          style="padding:0.2rem 0.35rem;background:var(--bg-surface);border:1.5px solid var(--border);border-radius:0.3rem;font-size:0.75rem;color:var(--text-primary);outline:none;cursor:pointer;">
          <option value="short">Short (6–10 w)</option>
          <option value="medium" selected>Medium (8–18 w)</option>
          <option value="long">Long (15–30 w)</option>
          <option value="mixed">Mixed</option>
        </select>
      </div>
    </div>

    <!-- ══ Generate button ══ -->
    <button id="btn-generate"
      style="width:100%;padding:0.75rem 1.5rem;background:#C2410C;color:#fff;border:none;border-radius:0.625rem;font-family:'Sora',sans-serif;font-size:0.95rem;font-weight:700;cursor:pointer;transition:background 0.15s,transform 0.1s;display:flex;align-items:center;justify-content:center;gap:0.5rem;margin-bottom:1rem;"
      onmouseover="this.style.background='#9A3412';"
      onmouseout="this.style.background='#C2410C';"
      onmousedown="this.style.transform='scale(0.98)';"
      onmouseup="this.style.transform='scale(1)';">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
      </svg>
      Generate
    </button>

    <!-- ══ Output area ══ -->
    <div id="output-section" style="display:none;">

      <!-- Stats bar -->
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.4rem;margin-bottom:0.5rem;">
        <div style="display:flex;gap:0.625rem;flex-wrap:wrap;">
          <span id="stat-paras"  style="font-size:0.7rem;font-family:'Fira Code',monospace;color:var(--text-muted);"></span>
          <span id="stat-words"  style="font-size:0.7rem;font-family:'Fira Code',monospace;color:var(--text-muted);"></span>
          <span id="stat-chars"  style="font-size:0.7rem;font-family:'Fira Code',monospace;color:var(--text-muted);"></span>
          <span id="stat-bytes"  style="font-size:0.7rem;font-family:'Fira Code',monospace;color:var(--text-muted);"></span>
        </div>
        <div style="display:flex;gap:0.4rem;">
          <button id="btn-copy" style="padding:0.3rem 0.65rem;background:rgba(194,65,12,0.1);border:1px solid rgba(194,65,12,0.3);border-radius:0.375rem;font-size:0.72rem;font-weight:700;color:#C2410C;cursor:pointer;transition:all 0.15s;"
            onmouseover="this.style.background='rgba(194,65,12,0.2)';" onmouseout="this.style.background='rgba(194,65,12,0.1)';">Copy</button>
          <button id="btn-download" style="padding:0.3rem 0.65rem;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:0.375rem;font-size:0.72rem;font-weight:700;color:var(--text-secondary);cursor:pointer;transition:all 0.15s;"
            onmouseover="this.style.borderColor='#C2410C';this.style.color='#C2410C';" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-secondary)';">↓ .txt</button>
          <button id="btn-regen" style="padding:0.3rem 0.65rem;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:0.375rem;font-size:0.72rem;font-weight:700;color:var(--text-secondary);cursor:pointer;transition:all 0.15s;"
            onmouseover="this.style.borderColor='#0D9488';this.style.color='#0D9488';" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-secondary)';">↺ Regenerate</button>
        </div>
      </div>

      <!-- Preview rendered (HTML mode) -->
      <div id="output-preview" style="display:none;padding:1.25rem 1.5rem;background:var(--bg-surface);border:1.5px solid var(--border);border-radius:0.75rem;font-family:'Lora',Georgia,serif;font-size:0.9rem;line-height:1.8;color:var(--text-secondary);margin-bottom:0.5rem;max-height:320px;overflow-y:auto;"></div>

      <!-- Raw output textarea -->
      <textarea id="output-text" readonly
        style="width:100%;height:260px;padding:1rem 1.1rem;background:var(--bg-surface-2);border:1.5px solid var(--border);border-radius:0.75rem;font-family:'Fira Code',monospace;font-size:0.75rem;color:var(--text-primary);resize:vertical;outline:none;line-height:1.65;box-sizing:border-box;cursor:default;"
        spellcheck="false"></textarea>

    </div>

  </div>

  <!-- HOW TO USE -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Lorem Ipsum Customizer</h2>
    <p class="seo-p">Generate placeholder text in seconds with full control over unit type, length, variant, and output format.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Set Paragraph Count</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Choose how many paragraphs to generate using the slider or type an exact number. You can switch between paragraphs, sentences, words, characters, bytes, and list items.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Configure Length</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Set the sentence length to Short, Medium, Long, or Mixed to control how many words appear per sentence. This gives you fine-grained control over text density and reading complexity.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Choose Style</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Select from Classic Latin, Cicero, Corporate Buzzword, Pirate Speak, Hipster, Tech, Legal, Medieval, or Emoji. Each variant pulls from a curated vocabulary that matches its tone and register.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Copy Output</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Once generated, copy the text to your clipboard, download it as a .txt file, or use Regenerate to reshuffle with the same settings. Choose from 12 output formats including HTML, Markdown, JSON, CSV, and SQL.</p>
      </div>
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/word-counter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Word Counter</a>
        <a href="/tools/slug-generator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Slug Generator</a>
        <a href="/tools/whitespace-trimmer" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Whitespace & Line Break Trimmer</a>
      </div>
    </div>
</div>

  <!-- HOW IT WORKS -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Lorem Ipsum Customizer Works</h2>
    <p class="seo-p">The tool generates placeholder text by sampling words from curated vocabularies and assembling them into natural-looking sentences with configurable structure.</p>
    <h3 class="font-display seo-h3-sm">Text Generation Algorithm</h3>
    <p class="seo-p">Each text variant maintains its own word pool — a curated list of 80 to 200 words authentic to that register. The algorithm picks words at random from the <code class="inline-code">pool</code> and assembles them into sentences whose length is determined by the selected <code class="inline-code">sentLengthKey</code> range. Sentences are grouped into paragraphs of three to seven, and a percentage of sentences open with a themed phrase from the variant's <code class="inline-code">sentenceOpeners</code> array for natural flow. The optional "Start with Lorem ipsum" toggle prepends the variant's canonical opening sentence to the first paragraph.</p>
    <h3 class="font-display seo-h3-sm">Customization Options</h3>
    <p class="seo-p">The <code class="inline-code">unit</code> setting controls how output is structured: paragraphs and sentences generate discrete blocks, words and characters generate in a loop and truncate to the exact count, bytes encode as UTF-8 and truncate at the byte boundary to avoid splitting multi-byte characters, and list items produce one sentence per item. After generation, the <code class="inline-code">formatOutput</code> post-processor wraps the text in the selected output format — whether plain text, HTML tags, Markdown, JSON arrays, CSV rows, or SQL INSERT statements — producing production-ready output you can paste directly into your project.</p>
  </div>

  <!-- FAQ -->
  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between Classic Lorem Ipsum and Cicero?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Classic Lorem Ipsum is a scrambled version of Cicero's "De Finibus" with missing and rearranged words, making it look like Latin without being readable. The Cicero variant uses the original, unscrambled Latin text for a more authentic and complete passage. Both serve as placeholder text, but Cicero is truer to the source material.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How can I prevent word repetition in the generated text?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Each variant's word pool contains 80 to 200 unique words, and sentences are assembled by randomly sampling from that pool. The more text you generate, the more likely words will repeat. To reduce repetition, choose a longer sentence length like Mixed or Long, which gives each sentence more variety in word selection across a wider range.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What are the best use cases for Lorem Ipsum text?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Lorem Ipsum is ideal for design mockups, wireframes, website templates, and layout testing where you need realistic-looking text without meaningful content distracting from the visual design. It is also useful for testing database field limits, API payload sizes, and UI components that display dynamic text.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why use this tool instead of a simple Lorem Ipsum generator?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">This customizer goes beyond basic paragraph generation by offering multiple unit types (words, characters, bytes, list items), 12 production-ready output formats (HTML, Markdown, JSON, CSV, SQL), 9 themed text variants, and precise sentence length control. It is a single tool that replaces multiple specialized generators.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What does the Bytes unit type do?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The Bytes option generates text and truncates it to an exact byte count when UTF-8 encoded. This is useful for testing database field limits, API payload sizes, or any system where the byte length matters more than the character count. The truncation avoids splitting multi-byte characters mid-codepoint to prevent encoding errors.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I use the generated text in commercial projects?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. All generated text is procedurally created by the tool and is not copyrighted material. The Classic and Cicero variants are derived from a public domain text written in 45 BC, and all other variants are original vocabulary lists. You can freely use the output in any project, commercial or otherwise.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
// ═══════════════════════════════════════════════════════════
// WORD POOLS — each variant has its own authentic vocabulary
// ═══════════════════════════════════════════════════════════

const POOLS: Record<string, { words: string[]; opener?: string; sentenceOpeners?: string[] }> = {

  classic: {
    opener: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
    words: ['lorem','ipsum','dolor','sit','amet','consectetur','adipiscing','elit','sed','do','eiusmod','tempor','incididunt','ut','labore','et','dolore','magna','aliqua','enim','ad','minim','veniam','quis','nostrud','exercitation','ullamco','laboris','nisi','aliquip','ex','ea','commodo','consequat','duis','aute','irure','in','reprehenderit','voluptate','velit','esse','cillum','fugiat','nulla','pariatur','excepteur','sint','occaecat','cupidatat','non','proident','sunt','culpa','qui','officia','deserunt','mollit','anim','id','est','laborum','curabitur','pretium','tincidunt','lacus','nec','rutrum','volutpat','pellentesque','habitant','morbi','tristique','senectus','netus','malesuada','fames','ac','turpis','egestas','integer','eget','aliquet','nibh','praesent','tristique','magna','sit','amet','purus','gravida','quis','blandit','turpis','cursus','nunc','id','cursus','metus','aliquam','eleifend','mi','in','nulla','posuere','sollicitudin','aliquam','ultrices','sagittis','orci','faucibus','purus','ut','faucibus','pulvinar','elementum'],
    sentenceOpeners: ['Ut','Nam','Sed','Nunc','Proin','Cras','Etiam','Mauris','Fusce','Aliquam','Donec','Vivamus','Integer','Nullam','Vestibulum','Phasellus','Morbi','Aenean','Pellentesque','Duis'],
  },

