---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'sql-to-nosql')!;
---

<ToolLayout tool={tool}>

  <!-- ═══ THE TOOL ═══ -->
  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">
      Paste your SQL query
    </h2>

    <!-- Output format toggle -->
    <div class="toggle-group" style="margin-bottom:1.25rem;">
      {[
        ['shell',    'MongoDB Shell'],
        ['nodejs',   'Node.js Driver'],
        ['mongoose', 'Mongoose'],
      ].map(([mode, label], i) => (
        <button
          class={`toggle-btn${i === 0 ? ' active' : ''}`}
          data-format={mode}
        >
          {label}
        </button>
      ))}
    </div>

    <!-- Two-panel workspace -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;" id="panels-grid">

      <!-- Input -->
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <span style="font-size:0.78rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em;">SQL Input</span>
          <button id="load-sample-btn" class="btn-secondary" style="padding:0.25rem 0.65rem; font-size:0.75rem;">
            Load sample
          </button>
        </div>
        <textarea
          id="sql-input"
          class="input-themed"
          spellcheck="false"
          placeholder={`Paste your SQL query here…\n\nSELECT name, email\nFROM users\nWHERE age > 25\nORDER BY name ASC\nLIMIT 10`}
          style="height:280px; font-family:'Fira Code',monospace; font-size:0.82rem; line-height:1.6; resize:vertical;"
        ></textarea>
        <div id="sql-error" style="display:none; margin-top:0.5rem; color:#DC2626; font-size:0.8rem; background:#FEF2F2; border:1px solid #FECACA; border-radius:0.5rem; padding:0.5rem 0.75rem;"></div>
      </div>

      <!-- Output -->
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <span style="font-size:0.78rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em;" id="output-label">MongoDB Shell Output</span>
          <button id="copy-output-btn" class="btn-secondary" style="padding:0.25rem 0.65rem; font-size:0.75rem;">
            Copy
          </button>
        </div>
        <textarea
          id="nosql-output"
          class="input-themed"
          readonly
          placeholder="Converted NoSQL query will appear here…"
          style="height:280px; font-family:'Fira Code',monospace; font-size:0.82rem; line-height:1.6; resize:vertical; background:var(--bg-surface-2);"
        ></textarea>
      </div>

    </div>

    <!-- Pipeline stage breakdown -->
    <div id="pipeline-breakdown" style="display:none; margin-top:1rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:1rem 1.25rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
        <span style="font-size:0.78rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em;">Pipeline Stages</span>
      </div>
      <div id="stages-list" style="display:flex; flex-direction:column; gap:0.5rem;"></div>
    </div>

    <!-- Buttons -->
    <div style="margin-top:1rem; display:flex; gap:0.75rem; align-items:center;">
      <button id="convert-btn" class="btn-primary">
        Convert
      </button>
      <button id="clear-btn" class="btn-secondary">
        Clear
      </button>
      <span id="success-msg" style="display:none; font-size:0.82rem; color:#16A34A; font-weight:500;">✓ Converted successfully</span>
    </div>

  </div>

  <!-- ═══ HOW TO USE ═══ -->
  <div slot="how-to-use">
    <h2 class="seo-h2">Convert a SQL SELECT query into a MongoDB aggregation pipeline</h2>
    <p class="seo-p">
      You are migrating a MySQL database to MongoDB and you have a stack of SQL queries that your app relies on. This tool takes each SELECT statement and outputs the equivalent MongoDB aggregation pipeline so you can see exactly how the query translates — without spending hours reading MongoDB docs.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1.25rem 0 0.5rem">Step 1: Paste your SQL query</h3>
    <p class="seo-p">
      Type or paste a SELECT query into the SQL input field. The tool understands WHERE conditions with AND/OR, ORDER BY, LIMIT, GROUP BY with aggregate functions (COUNT, SUM, AVG, MIN, MAX), and JOIN or LEFT JOIN clauses. A SELECT * query against a users table is the simplest starting point — the converter outputs a pipeline with no stages since MongoDB returns all documents by default.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Step 2: Pick your output format</h3>
    <p class="seo-p">
      Choose between MongoDB Shell, Node.js Driver, or Mongoose. All three produce the same aggregation pipeline — only the surrounding boilerplate differs. MongoDB Shell outputs db.collection.aggregate([...]) which you can paste into a terminal. Node.js Driver outputs async code using the official mongodb package. Mongoose outputs Model.aggregate() code. Pick the format that matches your project.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Step 3: Review the pipeline stages</h3>
    <p class="seo-p">
      Below the output, a colour-coded panel shows each aggregation stage in order. A $match stage comes from your WHERE clause, $sort from ORDER BY, $group from GROUP BY, and $lookup from JOINs. Each stage includes a brief description of what it does. Check the pipeline order — $match should generally come before $group to filter early and reduce the amount of data flowing through the pipeline.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Step 4: Copy and adapt</h3>
    <p class="seo-p">
      Click the copy button to grab the generated code. The converter gives you a working starting point — you may still need to adjust field names, add index hints, or handle edge cases specific to your schema. For example, a SQL BETWEEN clause translates to $gte and $lte in MongoDB, but you might need to add a $type stage if the field stores mixed types.
    </p>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/csv-to-json-xml-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">CSV to JSON & XML Data Converter</a>
        <a href="/tools/json-yaml-toml-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">JSON to YAML / TOML Converter</a>
        <a href="/tools/sql-schema-syntax-translator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">SQL Schema Syntax Translator</a>
      </div>
    </div>
</div>

  <!-- ═══ HOW IT WORKS ═══ -->
  <div slot="how-it-works">
    <h2 class="seo-h2">How the SQL to NoSQL conversion works</h2>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">SQL parsing happens in three steps</h3>
    <p class="seo-p">
      The converter first tokenises your SQL input using a regular expression that preserves quoted strings and numeric literals. It then splits the token stream into clause blocks — SELECT, FROM, WHERE, JOIN, GROUP BY, ORDER BY, LIMIT — by scanning for keyword positions. Each block body is parsed by a dedicated sub-parser. The SELECT sub-parser handles aggregate functions, column aliases, and table-qualified field names. The WHERE sub-parser handles AND/OR logic and operator mapping. The result is a structured abstract syntax tree that the pipeline builder consumes.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Each SQL clause maps to a MongoDB aggregation stage</h3>
    <p class="seo-p">
      The pipeline builder walks the AST and emits MongoDB stages in the correct order. JOINs become $lookup followed by $unwind. WHERE conditions map operators directly — equals becomes $eq, greater-than becomes $gt, LIKE becomes $regex, and BETWEEN becomes a combined $gte/$lte. AND logic produces an $and array and OR logic produces an $or array. GROUP BY triggers a $group stage with accumulator expressions like $sum and $avg. ORDER BY maps to $sort, LIMIT to $limit, and SELECT column list to $project. The pipeline is built in the order MongoDB expects: $match first for early filtering, then $lookup, $unwind, $group, $sort, $project, and $limit.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Why $unwind follows $lookup</h3>
    <p class="seo-p">
      MongoDB's $lookup always returns matched documents as an array, even when a single document matches. For a standard JOIN (not LEFT JOIN), the converter adds an $unwind stage to flatten this array into individual documents, matching SQL INNER JOIN behaviour where each match produces one row. For LEFT JOINs, $unwind includes preserveNullAndEmptyArrays: true so unmatched documents are retained with a null value instead of being dropped.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Output wrapping is the only difference between formats</h3>
    <p class="seo-p">
      Once the pipeline array is built, the output formatter wraps it in the syntax required by your chosen target. MongoDB Shell outputs db.collection.aggregate([...]) for direct pasting into a terminal. Node.js Driver outputs an async function using the official mongodb package with connection handling. Mongoose outputs a Model.aggregate() call with schema-aware model references. All three produce identical aggregation logic — only the surrounding boilerplate differs.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">A concrete conversion example</h3>
    <p class="seo-p">
      Consider: SELECT u.name, COUNT(o.id) AS order_count FROM users u JOIN orders o ON u.id = o.user_id WHERE u.active = 1 GROUP BY u.name ORDER BY order_count DESC LIMIT 10. The converter produces a pipeline with $match (filter active users), $lookup (join orders on user_id), $unwind (flatten the orders array), $group (group by name, count orders), $sort (descending by order_count), and $limit (top 10). The generated code wraps this pipeline in your chosen output format, ready to paste into your project.
    </p>
  </div>

  <!-- ═══ FAQ ═══ -->
  <div slot="faq">
    <h2 class="seo-h2-faq">Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">

      {[
        {
          q: 'What SQL statements does this tool support?',
          a: 'The converter handles SELECT queries including WHERE conditions with AND/OR, ORDER BY, LIMIT, GROUP BY with aggregate functions (COUNT, SUM, AVG, MIN, MAX), and JOIN or LEFT JOIN clauses. INSERT, UPDATE, DELETE, and DDL statements are not supported — the focus is on read queries, which are the most common use case when migrating from SQL to MongoDB.',
        },
        {
          q: 'What is a MongoDB aggregation pipeline?',
          a: 'An aggregation pipeline is MongoDB\'s framework for data processing. Documents pass through a sequence of stages — $match, $project, $sort, $group, $lookup — with each stage transforming the data before passing it to the next. Pipelines are more powerful than simple find() queries and are the closest equivalent to complex SQL SELECT statements.',
        },
        {
          q: 'How are SQL JOINs translated?',
          a: 'SQL JOINs are converted to the $lookup aggregation stage, which performs a left outer join between two collections. The converter maps the JOIN\'s ON clause to the lookup fields: from (the foreign collection), localField, foreignField, and as (the output array field name). For standard JOINs, an additional $unwind stage flattens the joined array into individual documents.',
        },
        {
          q: 'Does the converter handle subqueries or nested SELECTs?',
          a: 'Not currently. The parser handles single-level SELECT queries with standard clauses. Subqueries and correlated subqueries require a more complex AST traversal and are beyond the scope of this tool. For complex queries, the converter provides a solid starting point that you can extend manually in your MongoDB code.',
        },
        {
          q: 'What is the difference between the three output formats?',
          a: 'MongoDB Shell produces mongosh syntax you can paste directly into a terminal. Node.js Driver outputs JavaScript code using the official mongodb package with async/await and connection handling. Mongoose generates code using the Mongoose ODM\'s Model.aggregate() method. All three produce the same pipeline — only the wrapper syntax differs.',
        },
        {
          q: 'Is my SQL query sent to any server?',
          a: 'No. The entire parsing and conversion runs locally in your browser using JavaScript. Your SQL queries never leave your device — there is no backend, no API call, and no data stored anywhere. This makes the tool suitable for converting queries that reference sensitive or proprietary database schemas.',
        },
        {
          q: 'Why does the pipeline include $unwind after $lookup?',
          a: 'MongoDB\'s $lookup always returns matched documents as an array, even when a single document matches. For standard JOINs, the converter adds $unwind to flatten this array into individual documents, matching SQL INNER JOIN behaviour. For LEFT JOINs, $unwind includes preserveNullAndEmptyArrays: true so unmatched documents are retained with a null value.',
        },
        {
          q: 'Can I convert COUNT(DISTINCT col) queries?',
          a: 'The current parser handles standard aggregate functions with a single field argument. COUNT(DISTINCT col) is not yet supported. For these cases, the converted pipeline gives you a working foundation — you can manually add $group accumulators with $addToSet and $size to approximate DISTINCT behaviour in MongoDB.',
        },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}

    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What SQL statements does this tool support?",
          "acceptedAnswer": { "@type": "Answer", "text": "The converter handles SELECT queries including WHERE conditions (with AND/OR), ORDER BY, LIMIT, GROUP BY with aggregate functions (COUNT, SUM, AVG, MIN, MAX), and JOIN / LEFT JOIN clauses. INSERT, UPDATE, DELETE, and DDL statements are not supported." }
        },
        {
          "@type": "Question",
          "name": "What is a MongoDB aggregation pipeline?",
          "acceptedAnswer": { "@type": "Answer", "text": "An aggregation pipeline is MongoDB's framework for data processing. Documents pass through a sequence of stages — $match, $project, $sort, $group, $lookup — each transforming the data before passing it to the next." }
        },
        {
          "@type": "Question",
          "name": "How are SQL JOINs translated?",
          "acceptedAnswer": { "@type": "Answer", "text": "SQL JOINs are converted to the $lookup aggregation stage, which performs a left outer join between two collections. The JOIN's ON clause maps to the lookup fields: from, localField, foreignField, and as." }
        },
        {
          "@type": "Question",
          "name": "Does the converter handle subqueries?",
          "acceptedAnswer": { "@type": "Answer", "text": "Not currently. The parser handles single-level SELECT queries with standard clauses. Subqueries require a more complex AST traversal and are beyond the scope of this tool." }
        },
        {
          "@type": "Question",
          "name": "What is the difference between the three output formats?",
          "acceptedAnswer": { "@type": "Answer", "text": "MongoDB Shell produces mongosh syntax for direct terminal use. Node.js Driver outputs async JavaScript using the official mongodb package. Mongoose generates Model.aggregate() code. All three produce the same pipeline." }
        },
        {
          "@type": "Question",
          "name": "Is my SQL query sent to any server?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. The entire parsing and conversion runs locally in your browser. Your SQL queries never leave your device." }
        },
        {
          "@type": "Question",
          "name": "Why does the pipeline include $unwind after $lookup?",
          "acceptedAnswer": { "@type": "Answer", "text": "MongoDB's $lookup returns matched documents as an array. For standard JOINs, $unwind flattens this array into individual documents. For LEFT JOINs, it preserves unmatched documents with a null value." }
        },
        {
          "@type": "Question",
          "name": "Can I convert COUNT(DISTINCT col) queries?",
          "acceptedAnswer": { "@type": "Answer", "text": "The current parser handles standard aggregate functions. COUNT(DISTINCT col) is not yet supported but you can approximate it with $addToSet and $size in a $group stage." }
        },
      ]
    })} />
  </div>

</ToolLayout>

<style>
  @media (max-width: 768px) {
    #panels-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  // ── DOM refs ───────────────────────────────────────────────────
  const sqlInput      = document.getElementById('sql-input')       as HTMLTextAreaElement;
  const nosqlOutput   = document.getElementById('nosql-output')    as HTMLTextAreaElement;
  const sqlError      = document.getElementById('sql-error')!;
  const convertBtn    = document.getElementById('convert-btn')     as HTMLButtonElement;
  const clearBtn      = document.getElementById('clear-btn')       as HTMLButtonElement;
  const copyBtn       = document.getElementById('copy-output-btn') as HTMLButtonElement;
  const loadSampleBtn = document.getElementById('load-sample-btn') as HTMLButtonElement;
  const successMsg    = document.getElementById('success-msg')!;
  const outputLabel   = document.getElementById('output-label')!;
  const formatBtns    = document.querySelectorAll<HTMLButtonElement>('.toggle-btn');
  const pipelineBreakdown = document.getElementById('pipeline-breakdown')!;
  const stagesList    = document.getElementById('stages-list')!;

  let activeFormat: 'shell' | 'nodejs' | 'mongoose' = 'shell';

  // ── Sample SQL queries ────────────────────────────────────────
  const SAMPLES = [
    `SELECT u.name, u.email, o.total, o.created_at
FROM users u
JOIN orders o ON u.id = o.user_id
WHERE o.total > 50 AND u.status = 'active'
ORDER BY o.created_at DESC
LIMIT 20`,
    `SELECT category, COUNT(*) as total, AVG(price) as avg_price
FROM products
WHERE price > 10
GROUP BY category
ORDER BY total DESC`,
    `SELECT name, email, age
FROM users
WHERE age BETWEEN 18 AND 35 AND name LIKE 'J%'
ORDER BY age ASC
LIMIT 100`,
  ];

  let sampleIndex = 0;

  // ── SQL Parser Types ──────────────────────────────────────────
  interface ParsedQuery {
    select: SelectField[];
    from: TableRef;
    joins: JoinClause[];
    where: WhereCondition[];
    whereLogic: string;
    orderBy: OrderField[];
    limit: number | null;
    groupBy: string[];
    hasAggregate: boolean;
  }

  interface SelectField {
    expression: string;
    alias: string | null;
    aggregate: string | null;   // COUNT, SUM, AVG, MIN, MAX
    field: string;              // inner field for aggregates, or column name
    table: string | null;       // table alias prefix
  }

  interface TableRef {
    table: string;
    alias: string | null;
  }

  interface JoinClause {
    type: string;    // JOIN, LEFT JOIN, etc.
    table: string;
    alias: string | null;
    localField: string;
    foreignField: string;
  }

  interface WhereCondition {
    field: string;
    operator: string;
    value: any;
    logic: string;   // AND / OR
    table: string | null;
  }

  interface OrderField {
    field: string;
    direction: 1 | -1;
    table: string | null;
  }

  interface PipelineStage {
    name: string;
    stage: Record<string, any>;
  }

  // ── Tokeniser ─────────────────────────────────────────────────
  function tokenize(sql: string): string[] {
    // Preserve strings, split on whitespace/punctuation while keeping operators
    const tokens: string[] = [];
    const regex = /('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*"|\d+\.?\d*|[a-zA-Z_]\w*(?:\.[a-zA-Z_]\w*)*|[<>!=]+|\*|\(|\)|,)/g;
    let match;
    while ((match = regex.exec(sql)) !== null) {
      tokens.push(match[0]);
    }
    return tokens;
  }

  // ── SQL Parser ────────────────────────────────────────────────
  function parseSQL(sql: string): ParsedQuery {
    const cleaned = sql.replace(/;[\s]*$/, '').trim();
    const upper = cleaned.toUpperCase();

    if (!upper.startsWith('SELECT')) {
      throw new Error('Only SELECT queries are supported.');
    }

    const result: ParsedQuery = {
      select: [],
      from: { table: '', alias: null },
      joins: [],
      where: [],
      whereLogic: 'AND',
      orderBy: [],
      limit: null,
      groupBy: [],
      hasAggregate: false,
    };

    // Split into major clause blocks using regex
    // We need to find the positions of FROM, WHERE, JOIN, ORDER BY, GROUP BY, LIMIT
    const clauseRegex = /\b(SELECT|FROM|(?:LEFT\s+|RIGHT\s+|INNER\s+|OUTER\s+|CROSS\s+)?JOIN|WHERE|GROUP\s+BY|ORDER\s+BY|LIMIT)\b/gi;
    const clauses: { keyword: string; start: number; }[] = [];
    let m;
    while ((m = clauseRegex.exec(cleaned)) !== null) {
      clauses.push({ keyword: m[1].toUpperCase().replace(/\s+/g, ' '), start: m.index });
    }

    function getClauseBody(idx: number): string {
      const start = clauses[idx].start + clauses[idx].keyword.length;
      const end = idx + 1 < clauses.length ? clauses[idx + 1].start : cleaned.length;
      return cleaned.substring(start, end).trim();
    }

    for (let i = 0; i < clauses.length; i++) {
      const kw = clauses[i].keyword;
      const body = getClauseBody(i);

      if (kw === 'SELECT') {
        result.select = parseSelectFields(body);
        result.hasAggregate = result.select.some(f => f.aggregate !== null);
      } else if (kw === 'FROM') {
        result.from = parseTableRef(body);
      } else if (kw.includes('JOIN')) {
        result.joins.push(parseJoin(kw, body));
      } else if (kw === 'WHERE') {
        const parsed = parseWhere(body);
        result.where = parsed.conditions;
        result.whereLogic = parsed.logic;
      } else if (kw === 'ORDER BY') {
        result.orderBy = parseOrderBy(body);
      } else if (kw === 'GROUP BY') {
        result.groupBy = parseGroupBy(body);
      } else if (kw === 'LIMIT') {
        result.limit = parseInt(body, 10) || null;
      }
    }

    if (!result.from.table) {
      throw new Error('Could not parse FROM clause. Make sure your query has a valid FROM table.');
    }

    return result;
  }

  function parseSelectFields(body: string): SelectField[] {
    if (body.trim() === '*') {
      return [{ expression: '*', alias: null, aggregate: null, field: '*', table: null }];
    }

    // Split by commas, respecting parentheses
    const fields = splitRespectingParens(body);
    return fields.map(f => {
      const trimmed = f.trim();

      // Check for aggregate: COUNT(*), SUM(col), AVG(col), MIN(col), MAX(col)
      const aggMatch = trimmed.match(/^(COUNT|SUM|AVG|MIN|MAX)\s*\(\s*(\*|[\w.]+)\s*\)(?:\s+(?:AS\s+)?(\w+))?$/i);
      if (aggMatch) {
        return {
          expression: trimmed,
          alias: aggMatch[3] || null,
          aggregate: aggMatch[1].toUpperCase(),
          field: aggMatch[2],
          table: null,
        };
      }

      // Check for alias: col AS alias or col alias
      const aliasMatch = trimmed.match(/^([\w.]+)\s+(?:AS\s+)?(\w+)$/i);
      if (aliasMatch) {
        const parts = aliasMatch[1].split('.');
        return {
          expression: trimmed,
          alias: aliasMatch[2],
          aggregate: null,
          field: parts.length > 1 ? parts[1] : parts[0],
          table: parts.length > 1 ? parts[0] : null,
        };
      }

      // Simple column, possibly with table prefix
      const parts = trimmed.split('.');
      return {
        expression: trimmed,
        alias: null,
        aggregate: null,
        field: parts.length > 1 ? parts[1] : parts[0],
        table: parts.length > 1 ? parts[0] : null,
      };
    });
  }

  function splitRespectingParens(str: string): string[] {
    const result: string[] = [];
    let depth = 0;
    let current = '';
    for (const ch of str) {
      if (ch === '(') depth++;
      else if (ch === ')') depth--;
      if (ch === ',' && depth === 0) {
        result.push(current);
        current = '';
      } else {
        current += ch;
      }
    }
    if (current.trim()) result.push(current);
    return result;
  }

  function parseTableRef(body: string): TableRef {
    const parts = body.trim().split(/\s+/);
    // Filter out any trailing keywords that might be misinterpreted
    return {
      table: parts[0],
      alias: parts.length > 1 && !['JOIN','LEFT','RIGHT','INNER','WHERE','ORDER','GROUP','LIMIT'].includes(parts[1].toUpperCase()) ? parts[1] : null,
    };
  }

  function parseJoin(type: string, body: string): JoinClause {
    // body: "orders o ON u.id = o.user_id"
    const onIdx = body.toUpperCase().indexOf(' ON ');
    if (onIdx === -1) throw new Error(`JOIN clause missing ON condition: ${body}`);

    const tablePart = body.substring(0, onIdx).trim();
    const onPart = body.substring(onIdx + 4).trim();

    const tableParts = tablePart.split(/\s+/);
    const table = tableParts[0];
    const alias = tableParts.length > 1 ? tableParts[1] : null;

    // Parse ON condition: a.field = b.field
    const onMatch = onPart.match(/^([\w.]+)\s*=\s*([\w.]+)$/);
    if (!onMatch) throw new Error(`Could not parse JOIN ON condition: ${onPart}`);

    const leftParts = onMatch[1].split('.');
    const rightParts = onMatch[2].split('.');

    return {
      type: type.replace(/\s+/g, ' ').toUpperCase(),
      table,
      alias,
      localField: leftParts.length > 1 ? leftParts[1] : leftParts[0],
      foreignField: rightParts.length > 1 ? rightParts[1] : rightParts[0],
    };
  }

  function parseWhere(body: string): { conditions: WhereCondition[]; logic: string } {
    // Split by AND/OR while tracking the logic operator
    const conditions: WhereCondition[] = [];
    let mainLogic = 'AND';

    // Simple split: handle AND / OR at top level
    const parts = body.split(/\b(AND|OR)\b/i);
    for (let i = 0; i < parts.length; i++) {
      const part = parts[i].trim();
      if (!part) continue;
      if (part.toUpperCase() === 'AND' || part.toUpperCase() === 'OR') {
        mainLogic = part.toUpperCase();
        continue;
      }

      const cond = parseCondition(part);
      if (cond) conditions.push(cond);
    }

    return { conditions, logic: mainLogic };
  }

  function parseCondition(expr: string): WhereCondition | null {
    const trimmed = expr.trim();

    // BETWEEN: field BETWEEN val1 AND val2
    const betweenMatch = trimmed.match(/^([\w.]+)\s+BETWEEN\s+(.+?)\s+AND\s+(.+)$/i);
    if (betweenMatch) {
      const parts = betweenMatch[1].split('.');
      return {
        field: parts.length > 1 ? parts[1] : parts[0],
        operator: 'BETWEEN',
        value: [parseValue(betweenMatch[2].trim()), parseValue(betweenMatch[3].trim())],
        logic: 'AND',
        table: parts.length > 1 ? parts[0] : null,
      };
    }

    // IN: field IN (val1, val2, ...)
    const inMatch = trimmed.match(/^([\w.]+)\s+(NOT\s+)?IN\s*\((.+)\)$/i);
    if (inMatch) {
      const parts = inMatch[1].split('.');
      const values = inMatch[3].split(',').map(v => parseValue(v.trim()));
      return {
        field: parts.length > 1 ? parts[1] : parts[0],
        operator: inMatch[2] ? 'NOT IN' : 'IN',
        value: values,
        logic: 'AND',
        table: parts.length > 1 ? parts[0] : null,
      };
    }

    // LIKE: field LIKE 'pattern'
    const likeMatch = trimmed.match(/^([\w.]+)\s+(NOT\s+)?LIKE\s+'(.+)'$/i);
    if (likeMatch) {
      const parts = likeMatch[1].split('.');
      return {
        field: parts.length > 1 ? parts[1] : parts[0],
        operator: likeMatch[2] ? 'NOT LIKE' : 'LIKE',
        value: likeMatch[3],
        logic: 'AND',
        table: parts.length > 1 ? parts[0] : null,
      };
    }

    // IS NULL / IS NOT NULL
    const nullMatch = trimmed.match(/^([\w.]+)\s+IS\s+(NOT\s+)?NULL$/i);
    if (nullMatch) {
      const parts = nullMatch[1].split('.');
      return {
        field: parts.length > 1 ? parts[1] : parts[0],
        operator: nullMatch[2] ? 'IS NOT NULL' : 'IS NULL',
        value: null,
        logic: 'AND',
        table: parts.length > 1 ? parts[0] : null,
      };
    }

    // Standard comparison: field OP value
    const compMatch = trimmed.match(/^([\w.]+)\s*(!=|<>|>=|<=|>|<|=)\s*(.+)$/);
    if (compMatch) {
      const parts = compMatch[1].split('.');
      return {
        field: parts.length > 1 ? parts[1] : parts[0],
        operator: compMatch[2],
        value: parseValue(compMatch[3].trim()),
        logic: 'AND',
        table: parts.length > 1 ? parts[0] : null,
      };
    }

    return null;
  }

  function parseValue(val: string): any {
    // String literal
    if ((val.startsWith("'") && val.endsWith("'")) || (val.startsWith('"') && val.endsWith('"'))) {
      return val.slice(1, -1);
    }
    // Number
    const num = Number(val);
    if (!isNaN(num)) return num;
    // Boolean
    if (val.toUpperCase() === 'TRUE') return true;
    if (val.toUpperCase() === 'FALSE') return false;
    if (val.toUpperCase() === 'NULL') return null;
    return val;
  }

  function parseOrderBy(body: string): OrderField[] {
    return body.split(',').map(part => {
      const tokens = part.trim().split(/\s+/);
      const fieldParts = tokens[0].split('.');
      const dir = tokens.length > 1 && tokens[1].toUpperCase() === 'DESC' ? -1 : 1;
      return {
        field: fieldParts.length > 1 ? fieldParts[1] : fieldParts[0],
        direction: dir as 1 | -1,
        table: fieldParts.length > 1 ? fieldParts[0] : null,
      };
    });
  }

  function parseGroupBy(body: string): string[] {
    return body.split(',').map(col => {
      const parts = col.trim().split('.');
      return parts.length > 1 ? parts[1] : parts[0];
    });
  }

  // ── Pipeline Builder ──────────────────────────────────────────
  function buildPipeline(parsed: ParsedQuery): PipelineStage[] {
    const stages: PipelineStage[] = [];

    // 1. $lookup for JOINs
    for (const join of parsed.joins) {
      stages.push({
        name: '$lookup',
        stage: {
          $lookup: {
            from: join.table,
            localField: join.localField,
            foreignField: join.foreignField,
            as: join.alias || join.table,
          }
        }
      });

      // Unwind the joined array for INNER/regular JOINs
      const asField = join.alias || join.table;
      if (!join.type.includes('LEFT')) {
        stages.push({
          name: '$unwind',
          stage: { $unwind: `$${asField}` }
        });
      } else {
        stages.push({
          name: '$unwind',
          stage: {
            $unwind: {
              path: `$${asField}`,
              preserveNullAndEmptyArrays: true,
            }
          }
        });
      }
    }

    // 2. $match for WHERE
    if (parsed.where.length > 0) {
      const matchConditions = parsed.where.map(cond => buildMatchCondition(cond));

      let matchStage: Record<string, any>;
      if (matchConditions.length === 1) {
        matchStage = matchConditions[0];
      } else if (parsed.whereLogic === 'OR') {
        matchStage = { $or: matchConditions };
      } else {
        // For AND, merge if possible, otherwise use $and
        const canMerge = matchConditions.every(c => Object.keys(c).length === 1);
        const hasOverlap = new Set(matchConditions.flatMap(c => Object.keys(c))).size < matchConditions.reduce((s, c) => s + Object.keys(c).length, 0);
        if (canMerge && !hasOverlap) {
          matchStage = Object.assign({}, ...matchConditions);
        } else {
          matchStage = { $and: matchConditions };
        }
      }

      stages.push({ name: '$match', stage: { $match: matchStage } });
    }

    // 3. $group for GROUP BY
    if (parsed.groupBy.length > 0 || parsed.hasAggregate) {
      const groupId: Record<string, any> = {};
      if (parsed.groupBy.length === 1) {
        // Single group key
      }
      const groupStage: Record<string, any> = { _id: null as any };

      if (parsed.groupBy.length === 1) {
        groupStage._id = `$${parsed.groupBy[0]}`;
      } else if (parsed.groupBy.length > 1) {
        const id: Record<string, string> = {};
        for (const col of parsed.groupBy) {
          id[col] = `$${col}`;
        }
        groupStage._id = id;
      }

      // Add aggregate accumulators
      for (const sel of parsed.select) {
        if (sel.aggregate) {
          const outputName = sel.alias || `${sel.aggregate.toLowerCase()}_${sel.field}`.replace('*', 'all');
          switch (sel.aggregate) {
            case 'COUNT':
              groupStage[outputName] = { $sum: 1 };
              break;
            case 'SUM':
              groupStage[outputName] = { $sum: `$${sel.field}` };
              break;
            case 'AVG':
              groupStage[outputName] = { $avg: `$${sel.field}` };
              break;
            case 'MIN':
              groupStage[outputName] = { $min: `$${sel.field}` };
              break;
            case 'MAX':
              groupStage[outputName] = { $max: `$${sel.field}` };
              break;
          }
        }
      }

      stages.push({ name: '$group', stage: { $group: groupStage } });
    }

    // 4. $sort for ORDER BY
    if (parsed.orderBy.length > 0) {
      const sortObj: Record<string, number> = {};
      for (const ord of parsed.orderBy) {
        // If we have a GROUP BY, the field might be an alias
        const matchingSelect = parsed.select.find(s => s.alias === ord.field);
        const key = matchingSelect ? (matchingSelect.alias || ord.field) : ord.field;
        sortObj[key] = ord.direction;
      }
      stages.push({ name: '$sort', stage: { $sort: sortObj } });
    }

    // 5. $limit
    if (parsed.limit !== null) {
      stages.push({ name: '$limit', stage: { $limit: parsed.limit } });
    }

    // 6. $project for SELECT (only if specific fields, not *)
    if (!parsed.hasAggregate && !parsed.select.some(s => s.field === '*')) {
      const projectObj: Record<string, any> = { _id: 0 };
      for (const sel of parsed.select) {
        const fieldName = sel.alias || sel.field;
        // If field comes from a joined table, use dot notation
        if (sel.table) {
          const joinMatch = parsed.joins.find(j => j.alias === sel.table || j.table === sel.table);
          if (joinMatch) {
            const joinAs = joinMatch.alias || joinMatch.table;
            projectObj[fieldName] = `$${joinAs}.${sel.field}`;
          } else if (sel.table === parsed.from.alias || sel.table === parsed.from.table) {
            projectObj[fieldName] = 1;
          } else {
            projectObj[fieldName] = 1;
          }
        } else {
          projectObj[fieldName] = 1;
        }
      }
      stages.push({ name: '$project', stage: { $project: projectObj } });
    }

    return stages;
  }

  function buildMatchCondition(cond: WhereCondition): Record<string, any> {
    const field = cond.field;

    switch (cond.operator) {
      case '=':
        return { [field]: cond.value };
      case '!=':
      case '<>':
        return { [field]: { $ne: cond.value } };
      case '>':
        return { [field]: { $gt: cond.value } };
      case '>=':
        return { [field]: { $gte: cond.value } };
      case '<':
        return { [field]: { $lt: cond.value } };
      case '<=':
        return { [field]: { $lte: cond.value } };
      case 'LIKE': {
        // Convert SQL LIKE to MongoDB regex
        const regex = cond.value
          .replace(/%/g, '.*')
          .replace(/_/g, '.');
        return { [field]: { $regex: `^${regex}$`, $options: 'i' } };
      }
      case 'NOT LIKE': {
        const regex = cond.value
          .replace(/%/g, '.*')
          .replace(/_/g, '.');
        return { [field]: { $not: { $regex: `^${regex}$`, $options: 'i' } } };
      }
      case 'IN':
        return { [field]: { $in: cond.value } };
      case 'NOT IN':
        return { [field]: { $nin: cond.value } };
      case 'BETWEEN':
        return { [field]: { $gte: cond.value[0], $lte: cond.value[1] } };
      case 'IS NULL':
        return { [field]: null };
      case 'IS NOT NULL':
        return { [field]: { $ne: null } };
      default:
        return { [field]: cond.value };
    }
  }

  // ── Output Formatters ─────────────────────────────────────────
  function formatShell(collection: string, stages: PipelineStage[]): string {
    const pipeline = stages.map(s => s.stage);
    const pipelineStr = JSON.stringify(pipeline, null, 2);
    return `db.${collection}.aggregate(${pipelineStr})`;
  }

  function formatNodeJS(collection: string, stages: PipelineStage[]): string {
    const pipeline = stages.map(s => s.stage);
    const pipelineStr = JSON.stringify(pipeline, null, 2);
    return `const { MongoClient } = require('mongodb');

async function runQuery() {
  const client = new MongoClient('mongodb://localhost:27017');
  try {
    await client.connect();
    const db = client.db('your_database');

    const pipeline = ${pipelineStr.split('\n').map((line, i) => i === 0 ? line : '    ' + line).join('\n')};

    const results = await db
      .collection('${collection}')
      .aggregate(pipeline)
      .toArray();

    console.log(results);
    return results;
  } finally {
    await client.close();
  }
}

runQuery();`;
  }

  function formatMongoose(collection: string, stages: PipelineStage[]): string {
    const pipeline = stages.map(s => s.stage);
    const pipelineStr = JSON.stringify(pipeline, null, 2);
    // Capitalize first letter for model name
    const modelName = collection.charAt(0).toUpperCase() + collection.slice(1);

    return `const mongoose = require('mongoose');
const ${modelName} = require('./models/${modelName}');

async function runQuery() {
  await mongoose.connect('mongodb://localhost:27017/your_database');

  const pipeline = ${pipelineStr.split('\n').map((line, i) => i === 0 ? line : '  ' + line).join('\n')};

  const results = await ${modelName}.aggregate(pipeline);
  console.log(results);
  return results;
}

runQuery();`;
  }

  // ── Stage Breakdown UI ────────────────────────────────────────
  const stageColors: Record<string, { bg: string; text: string; border: string }> = {
    '$match':   { bg: '#FEF3C7', text: '#92400E', border: '#FDE68A' },
    '$project': { bg: '#DBEAFE', text: '#1E40AF', border: '#BFDBFE' },
    '$sort':    { bg: '#E0E7FF', text: '#3730A3', border: '#C7D2FE' },
    '$limit':   { bg: '#FCE7F3', text: '#9D174D', border: '#FBCFE8' },
    '$lookup':  { bg: '#D1FAE5', text: '#065F46', border: '#A7F3D0' },
    '$unwind':  { bg: '#F0FDF4', text: '#166534', border: '#BBF7D0' },
    '$group':   { bg: '#FFF7ED', text: '#9A3412', border: '#FED7AA' },
  };

  function renderStages(stages: PipelineStage[]) {
    stagesList.innerHTML = '';
    if (stages.length === 0) {
      pipelineBreakdown.style.display = 'none';
      return;
    }

    pipelineBreakdown.style.display = 'block';

    stages.forEach((s, i) => {
      const colors = stageColors[s.name] || { bg: '#F1F5F9', text: '#475569', border: '#E2E8F0' };
      const stageDiv = document.createElement('div');
      stageDiv.style.cssText = `display:flex; align-items:flex-start; gap:0.75rem; padding:0.65rem 0.875rem; background:${colors.bg}; border:1px solid ${colors.border}; border-radius:0.5rem;`;

      const badge = document.createElement('span');
      badge.style.cssText = `display:inline-flex; align-items:center; padding:0.2rem 0.6rem; background:${colors.text}; color:#fff; border-radius:0.35rem; font-size:0.72rem; font-weight:700; font-family:'Fira Code',monospace; white-space:nowrap; flex-shrink:0;`;
      badge.textContent = `${i + 1}. ${s.name}`;

      const code = document.createElement('code');
      code.style.cssText = `font-size:0.78rem; font-family:'Fira Code',monospace; color:${colors.text}; line-height:1.5; word-break:break-all;`;
      code.textContent = JSON.stringify(s.stage[s.name], null, 2);

      stageDiv.appendChild(badge);
      stageDiv.appendChild(code);
      stagesList.appendChild(stageDiv);
    });
  }

  // ── Main convert ──────────────────────────────────────────────
  function convert() {
    sqlError.style.display = 'none';
    successMsg.style.display = 'none';
    nosqlOutput.value = '';
    pipelineBreakdown.style.display = 'none';

    const raw = sqlInput.value.trim();
    if (!raw) {
      showError('Please paste a SQL query to convert.');
      return;
    }

    let parsed: ParsedQuery;
    try {
      parsed = parseSQL(raw);
    } catch (e: any) {
      showError(`Parse error: ${e.message}`);
      return;
    }

    let stages: PipelineStage[];
    try {
      stages = buildPipeline(parsed);
    } catch (e: any) {
      showError(`Conversion error: ${e.message}`);
      return;
    }

    const collection = parsed.from.table;

    switch (activeFormat) {
      case 'shell':
        nosqlOutput.value = formatShell(collection, stages);
        break;
      case 'nodejs':
        nosqlOutput.value = formatNodeJS(collection, stages);
        break;
      case 'mongoose':
        nosqlOutput.value = formatMongoose(collection, stages);
        break;
    }

    renderStages(stages);

    successMsg.style.display = 'inline';
    setTimeout(() => { successMsg.style.display = 'none'; }, 3000);
  }

  function showError(msg: string) {
    sqlError.textContent = msg;
    sqlError.style.display = 'block';
  }

  // ── Format switching ──────────────────────────────────────────
  const formatLabels: Record<string, string> = {
    shell:    'MongoDB Shell Output',
    nodejs:   'Node.js Driver Output',
    mongoose: 'Mongoose Output',
  };

  formatBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeFormat = btn.dataset.format as typeof activeFormat;
      formatBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      outputLabel.textContent = formatLabels[activeFormat];
      if (sqlInput.value.trim()) convert();
    });
  });

  // ── Buttons ───────────────────────────────────────────────────
  convertBtn.addEventListener('click', convert);

  clearBtn.addEventListener('click', () => {
    sqlInput.value    = '';
    nosqlOutput.value = '';
    sqlError.style.display  = 'none';
    successMsg.style.display = 'none';
    pipelineBreakdown.style.display = 'none';
  });

  copyBtn.addEventListener('click', () => {
    if (!nosqlOutput.value) return;
    navigator.clipboard.writeText(nosqlOutput.value).then(() => {
      copyBtn.textContent = '✓ Copied!';
      copyBtn.classList.add('btn-success');
      setTimeout(() => {
        copyBtn.textContent = 'Copy';
        copyBtn.classList.remove('btn-success');
      }, 2000);
    });
  });

  loadSampleBtn.addEventListener('click', () => {
    sqlInput.value = SAMPLES[sampleIndex % SAMPLES.length];
    sampleIndex++;
    convert();
  });

  // ── Live conversion on input ──────────────────────────────────
  let debounceTimer: ReturnType<typeof setTimeout>;
  sqlInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(convert, 400);
  });
</script>
