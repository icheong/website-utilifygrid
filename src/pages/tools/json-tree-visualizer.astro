---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'json-tree-visualizer')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">JSON Tree Visualizer</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Visualise nested JSON as an interactive expandable tree. Click nodes to collapse/expand, hover for types and values.</p>

    <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
      <button id="btn-render" class="btn-primary" type="button">Visualise</button>
      <button id="btn-sample" class="btn-secondary" type="button">Load Sample</button>
      <button id="btn-clear" class="btn-secondary" type="button">Clear</button>
      <div style="margin-left:auto; display:flex; gap:0.5rem; align-items:center;">
        <button id="btn-expand-all" class="btn-secondary" type="button" style="font-size:0.72rem; padding:0.25rem 0.6rem;">Expand All</button>
        <button id="btn-collapse-all" class="btn-secondary" type="button" style="font-size:0.72rem; padding:0.25rem 0.6rem;">Collapse All</button>
      </div>
    </div>

    <textarea id="json-input" class="input-themed" rows="6"
      placeholder='Paste JSON to visualise as a tree…'
      style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65; margin-bottom:1rem;"
    ></textarea>

    <div id="error-box" style="display:none; margin-bottom:0.625rem; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); border-radius:0.5rem; padding:0.75rem 1rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:#DC2626;"></div>

    <div id="tree-container" style="border:1.5px solid var(--border); border-radius:0.625rem; padding:1rem; overflow:auto; max-height:500px; background:var(--bg-surface); display:none;">
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the JSON Tree Visualizer</h2>
    <p class="seo-p">
      Paste any valid JSON into the input field and click Visualise. The tree renders with collapsible object and array nodes, letting you click any branch to expand or collapse its children. Hover over a key to see its data type and raw value in a tooltip. Use Expand All and Collapse All for quick navigation of deeply nested structures.
    </p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Debugging complex API responses</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A backend developer inspecting a deeply nested REST API response pastes the raw payload into the tree visualizer to immediately understand the structure, identify unexpected null values, and verify that all expected fields are present without manually parsing flat JSON text.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Inspecting configuration files</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">DevOps engineers working with multi-level JSON configuration files for Kubernetes, Docker Compose, or CI/CD pipelines use the tree view to navigate nested objects and arrays without losing context, making it easy to spot misconfigurations or missing keys in deeply nested sections.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Teaching JSON structure</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Students and educators use the visualizer to demonstrate how JSON objects, arrays, and primitive values relate to each other in a hierarchical structure. The color-coded type badges and expand/collapse interaction make abstract data structures concrete and tangible.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Validating data migration output</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A data engineer migrating records between databases pastes a sample JSON export into the tree view to visually verify that nested objects and arrays were preserved correctly during the transformation, catching structural issues that flat text comparison would miss.</p>
      </div>
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/json-prettifier" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">JSON Prettifier</a>
        <a href="/tools/json-path-query-evaluator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">JSON Path Query Evaluator</a>
        <a href="/tools/json-to-html-table" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">JSON to HTML Table</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the JSON Tree Visualizer Works</h2>
    <p class="seo-p">
      The visualizer parses your input with the native <code class="inline-code">JSON.parse()</code> method, which validates the JSON against strict grammar rules. Any deviation, such as trailing commas or single quotes, triggers a SyntaxError displayed in the error panel. The parsed object is then walked using a recursive depth-first traversal to build the interactive DOM tree.
    </p>
    <h3 class="seo-h3-sm">Recursive DOM Construction</h3>
    <p class="seo-p">
      For each object or array node, the algorithm creates a collapsible row element with a toggle indicator and a badge showing the type and child count, such as Object(3) or Array(5). Primitive values are rendered as leaf nodes with color-coded type badges: green for strings, purple for numbers, pink for booleans, and grey for null. Each node determines its type using a strict classification function that checks Array.isArray first, then null by strict equality, then the typeof operator for remaining types.
    </p>
    <h3 class="seo-h3-sm">Lazy Rendering for Performance</h3>
    <p class="seo-p-none">
      To handle large JSON structures efficiently, child nodes are only constructed in the DOM when the parent node is first expanded. This means a 10,000-node JSON object only renders the top-level keys initially, and deeper levels are built on demand. This approach keeps the initial render fast and reduces memory consumption for structures that are only partially explored.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How large can the JSON input be?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The tool handles most practical JSON payloads. Because child nodes are only built when first expanded (lazy rendering), the initial render remains fast even for large structures. Very large inputs with 100,000 or more nodes may take a moment to parse, but collapsed branches do not consume DOM resources until expanded.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I copy a subtree as JSON?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The current version does not include a right-click context menu for copying subtrees. For full JSON output, paste the original input into the JSON Prettifier tool, which formats and copies the complete structure. A future update may add subtree export functionality.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does the tool display different data types?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Each node is assigned a type badge with a distinct color: green for String, purple for Number, pink for Boolean, grey for Null, and blue labels for Array and Object. Hovering over any key displays a tooltip with the full type and raw value, making it easy to distinguish between types at a glance without expanding nested structures.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does it support circular references in JSON?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Standard JSON per RFC 8259 cannot contain circular references, and JSON.parse will reject such input. If your data structure contains cycles, you need to serialise it with a library that handles circular references, then manually break the cycles before pasting into this tool.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What happens if the JSON is invalid?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">If the input is not valid JSON, the tool displays the exact error message from the JavaScript engine in a red error box below the input area. Common issues include trailing commas, single-quoted strings, unquoted keys, and missing closing brackets. Fix the reported error and click Visualise again.</p>
        </div>
      </div>

    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLE = JSON.stringify({
    name: "Alice", age: 30, active: true, score: null,
    address: { city: "Sydney", postcode: "2000", geo: { lat: -33.87, lng: 151.21 } },
    tags: ["developer", "designer"],
    projects: [
      { name: "UtilifyGrid", status: "active", stars: 42 },
      { name: "Old Project", status: "archived", stars: 12 }
    ]
  }, null, 2);

  function getType(v: any): string {
    if (v === null) return 'null';
    if (Array.isArray(v)) return 'array';
    return typeof v;
  }

  function typeColor(type: string): string {
    switch (type) {
      case 'string': return '#4ade80';
      case 'number': return '#c4b5fd';
      case 'boolean': return '#f9a8d4';
      case 'null': return '#94a3b8';
      default: return '#60a5fa';
    }
  }

  function buildTree(data: any, container: HTMLElement, depth = 0) {
    if (data !== null && typeof data === 'object') {
      const isArray = Array.isArray(data);
      const entries = isArray ? data.map((v, i) => [i, v]) : Object.entries(data);
      const count = entries.length;

      entries.forEach(([key, value]) => {
        const isComplex = value !== null && typeof value === 'object';
        const node = document.createElement('div');
        node.style.cssText = `margin-left:${depth * 1.25}rem;`;

        const row = document.createElement('div');
        row.style.cssText = `display:flex; align-items:center; gap:0.4rem; padding:0.25rem 0.5rem; border-radius:0.375rem; cursor:${isComplex ? 'pointer' : 'default'}; transition:background 0.1s; user-select:none;`;
        row.onmouseenter = () => row.style.background = 'var(--bg-surface-2)';
        row.onmouseleave = () => row.style.background = 'transparent';

        const type = getType(value);

        if (isComplex) {
          const toggle = document.createElement('span');
          toggle.style.cssText = 'font-size:0.65rem; color:var(--text-muted); width:1rem; text-align:center; transition:transform 0.2s; flex-shrink:0;';
          toggle.textContent = '▶';
          row.appendChild(toggle);

          const childContainer = document.createElement('div');
          childContainer.style.display = 'none';
          childContainer.style.marginTop = '0.15rem';

          let expanded = false;
          row.addEventListener('click', () => {
            expanded = !expanded;
            childContainer.style.display = expanded ? 'block' : 'none';
            toggle.textContent = expanded ? '▼' : '▶';
            toggle.style.transform = expanded ? 'rotate(90deg)' : 'rotate(0deg)';
            if (expanded && childContainer.children.length === 0) {
              buildTree(value, childContainer, depth + 1);
            }
          });

          // Tooltip on hover
          const rawVal = JSON.stringify(value);
          row.title = `Type: ${type}\n${rawVal.length > 120 ? rawVal.slice(0, 120) + '…' : rawVal}`;

          const label = document.createElement('span');
          label.style.cssText = `font-size:0.75rem; font-weight:600; color:#60a5fa;`;
          label.textContent = String(key);
          row.appendChild(label);

          const badge = document.createElement('span');
          badge.style.cssText = `font-size:0.6rem; font-family:'Fira Code',monospace; padding:0.05rem 0.35rem; border-radius:0.25rem; background:rgba(96,165,250,0.12); color:#60a5fa; font-weight:600;`;
          badge.textContent = `${type === 'array' ? 'Array' : 'Object'}(${count})`;
          row.appendChild(badge);

          node.appendChild(row);
          node.appendChild(childContainer);
        } else {
          const spacer = document.createElement('span');
          spacer.style.cssText = 'width:1rem; flex-shrink:0;';
          row.appendChild(spacer);

          const label = document.createElement('span');
          label.style.cssText = `font-size:0.75rem; font-weight:600; color:var(--text-primary);`;
          label.textContent = String(key);
          row.appendChild(label);

          const colon = document.createElement('span');
          colon.style.cssText = 'color:var(--text-muted); font-size:0.75rem;';
          colon.textContent = ':';
          row.appendChild(colon);

          const valSpan = document.createElement('span');
          valSpan.style.cssText = `font-size:0.75rem; font-family:'Fira Code',monospace; color:${typeColor(type)}; font-weight:500;`;
          valSpan.textContent = type === 'string' ? `"${value}"` : String(value);
          row.appendChild(valSpan);

          const typeBadge = document.createElement('span');
          typeBadge.style.cssText = `font-size:0.55rem; padding:0.05rem 0.3rem; border-radius:0.25rem; background:${typeColor(type)}15; color:${typeColor(type)}; font-weight:600; font-family:'Fira Code',monospace;`;
          typeBadge.textContent = type;
          row.appendChild(typeBadge);

          // Tooltip on hover
          row.title = `Type: ${type}\nValue: ${String(value)}`;

          node.appendChild(row);
        }

        container.appendChild(node);
      });
    }
  }

  function render() {
    const raw = (document.getElementById('json-input') as HTMLTextAreaElement).value;
    const container = document.getElementById('tree-container')!;
    const errBox = document.getElementById('error-box')!;
    errBox.style.display = 'none';
    container.style.display = 'none';
    container.innerHTML = '';

    if (!raw.trim()) return;

    try {
      const data = JSON.parse(raw);
      if (data !== null && typeof data === 'object') {
        buildTree(data, container);
      } else {
        // Handle primitives (string, number, boolean, null)
        const type = getType(data);
        const row = document.createElement('div');
        row.style.cssText = 'padding:0.5rem; font-size:0.85rem;';
        const typeBadge = document.createElement('span');
        typeBadge.style.cssText = `font-size:0.6rem; padding:0.1rem 0.4rem; border-radius:0.25rem; background:${typeColor(type)}15; color:${typeColor(type)}; font-weight:600; font-family:'Fira Code',monospace; margin-right:0.5rem;`;
        typeBadge.textContent = type;
        row.appendChild(typeBadge);
        const valSpan = document.createElement('span');
        valSpan.style.cssText = `font-family:'Fira Code',monospace; color:${typeColor(type)}; font-weight:500;`;
        valSpan.textContent = type === 'string' ? `"${data}"` : String(data);
        row.appendChild(valSpan);
        container.appendChild(row);
      }
      container.style.display = 'block';
    } catch (e: any) {
      errBox.textContent = e.message;
      errBox.style.display = 'block';
    }
  }

  function expandAll() {
    const container = document.getElementById('tree-container')!;
    container.querySelectorAll('div[style*="display: none"]').forEach(el => {
      (el as HTMLElement).style.display = 'block';
    });
    container.querySelectorAll('span').forEach(span => {
      if (span.textContent === '▶') span.textContent = '▼';
      if (span.style.transition.includes('transform')) span.style.transform = 'rotate(90deg)';
    });
  }

  function collapseAll() {
    const container = document.getElementById('tree-container')!;
    container.querySelectorAll('div[style*="display: block"]').forEach(el => {
      if (el.parentElement && el.previousElementSibling) {
        el.style.display = 'none';
      }
    });
    container.querySelectorAll('span').forEach(span => {
      if (span.textContent === '▼') span.textContent = '▶';
      if (span.style.transition.includes('transform')) span.style.transform = 'rotate(0deg)';
    });
  }

  document.getElementById('btn-render')!.addEventListener('click', render);
  document.getElementById('btn-sample')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = SAMPLE;
    render();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = '';
    document.getElementById('tree-container')!.style.display = 'none';
    document.getElementById('error-box')!.style.display = 'none';
  });
  document.getElementById('btn-expand-all')!.addEventListener('click', expandAll);
  document.getElementById('btn-collapse-all')!.addEventListener('click', collapseAll);
</script>
