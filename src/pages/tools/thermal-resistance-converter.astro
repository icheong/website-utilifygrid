---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'thermal-resistance-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Thermal Resistance Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="K_W">Kelvin per Watt (K/W)</option>
          <option value="C_W">Celsius per Watt (°C/W)</option>
          <option value="F_BTU">Fahrenheit per BTU/h (°F·h/BTU)</option>
          <option value="Rval">R-Value Imperial (°F·ft²·h/BTU)</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Thermal Resistance Converter</h2>
    <p class="seo-p">Enter a thermal resistance value, pick its source unit, and instantly see the equivalent in all supported units.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Enter R-Value</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Input the thermal resistance value in the text field and select the source unit from the dropdown menu.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Select Target Unit</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Choose the thermal resistance unit you want to convert to, such as K/W, °C/W, or R-value.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">View All Results</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">See the converted value displayed in all supported units simultaneously, updated in real time.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Copy Result</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Click the Copy button next to any result to copy the converted value to your clipboard for use in documents or calculations.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Thermal Resistance Converter Works</h2>
    <p class="seo-p">The converter translates thermal resistance values between different unit systems using standardized conversion factors, all computed instantly in your browser.</p>
    <h3 class="font-display seo-h3-sm">Thermal Resistance Units</h3>
    <p class="seo-p">Thermal resistance is measured in several units depending on the system. The SI unit is <code class="inline-code">m²K/W</code> (square meter kelvin per watt). In the US, the <code class="inline-code">R-value</code> expressed as <code class="inline-code">ft²·°F·h/BTU</code> is standard for building insulation. Other units include <code class="inline-code">K/W</code> and <code class="inline-code">°C/W</code> for component-level thermal management, plus <code class="inline-code">clo</code> (used for clothing insulation) and <code class="inline-code">tog</code> (used for bedding warmth ratings).</p>
    <h3 class="font-display seo-h3-sm">Conversion Between Unit Systems</h3>
    <p class="seo-p">All conversions route through <code class="inline-code">K/W</code> as the base unit. Since Kelvin and Celsius share the same degree size, <code class="inline-code">1 K/W = 1 °C/W</code> exactly. Imperial units use different temperature and energy scales: <code class="inline-code">1 °F·h/BTU = 0.527528 K/W</code> and <code class="inline-code">1 R-value (ft²·°F·h/BTU) = 0.176110 K/W</code>. The converter multiplies the input by its source factor and divides by the target factor.</p>
    <h3 class="font-display seo-h3-sm">Relationship to Thermal Conductivity</h3>
    <p class="seo-p">Thermal resistance <code class="inline-code">R</code> is related to thermal conductivity <code class="inline-code">k</code> by the formula <code class="inline-code">R = thickness / k</code>. A material with lower conductivity or greater thickness produces a higher R-value, meaning better insulation. This relationship lets you derive R-value from material properties or calculate required thickness for a target insulation level.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is thermal resistance (R-value)?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Thermal resistance measures a material's ability to resist heat flow. It is defined as the temperature difference across a material divided by the heat transfer rate. Higher thermal resistance means better insulation performance in building envelopes and thermal systems.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between R-value and U-value?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">R-value measures thermal resistance (how well a material blocks heat), while U-value measures thermal transmittance (how much heat passes through). They are inverses of each other: U = 1/R. A high R-value means good insulation, whereas a low U-value indicates the same.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What are typical R-values for wall insulation?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Typical residential wall insulation ranges from R-13 to R-21 depending on climate zone and wall construction. Roof and attic insulation generally requires higher values, often R-30 to R-60, to prevent heat loss in colder regions.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between clo and tog?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Both clo and tog measure thermal insulation but for different applications. Clo is used for clothing insulation where 1 clo = 0.155 m²K/W. Tog is used for bedding and quilts where 1 tog = 0.1 m²K/W. Higher values in either scale indicate warmer insulation.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I convert between SI and Imperial R-value units?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">To convert from SI (m²K/W) to Imperial R-value (ft²·°F·h/BTU), multiply by 5.678. To convert in the opposite direction, divide by 5.678. This converter handles these conversions automatically when you select the source and target units.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why is thermal resistance important for energy efficiency?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Higher thermal resistance reduces heat transfer through walls, roofs, and floors, lowering heating and cooling energy demands. Proper insulation with adequate R-values helps maintain indoor comfort while minimizing energy consumption and utility costs.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'K_W',   label: 'Kelvin per Watt (K/W)',                    abbr: 'K/W',     factor: 1 },
    { id: 'C_W',   label: 'Celsius per Watt (°C/W)',                  abbr: '°C/W',    factor: 1 },
    { id: 'F_BTU', label: 'Fahrenheit per BTU/h (°F·h/BTU)',          abbr: '°F·h/BTU', factor: 0.527528 },
    { id: 'Rval',  label: 'R-Value Imperial (°F·ft²·h/BTU)',          abbr: 'R-value',  factor: 0.176110 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
