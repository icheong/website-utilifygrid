---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'thermal-resistance-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Thermal Resistance Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="K_W">Kelvin per Watt (K/W)</option>
          <option value="C_W">Celsius per Watt (°C/W)</option>
          <option value="F_BTU">Fahrenheit per BTU/h (°F·h/BTU)</option>
          <option value="Rval">R-Value Imperial (°F·ft²·h/BTU)</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Thermal Resistance Converter</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Enter a <strong>numeric value</strong> and select its <strong>unit</strong> from the dropdown. All other thermal resistance units update instantly — no buttons to click.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      This converter handles <strong>thermal resistance</strong> units, which measure a material's resistance to heat flow. It is commonly used in building insulation (R-value) and electronics thermal management.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      Click any <strong>Copy</strong> button to copy that unit's result to your clipboard — handy for pasting into documents, code, or messages.
    </p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How thermal resistance conversions work</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.875rem;">
      All conversions go through <strong>Kelvin per Watt (K/W)</strong> as the base unit. Since °C and K have the same degree size, K/W = °C/W. Imperial units use the BTU and Fahrenheit scales:
    </p>
    <pre style="font-family:'Fira Code',monospace;font-size:.85rem;padding:1rem;border-radius:.5rem;background:var(--bg-surface-2);color:var(--text-primary);overflow-x:auto;white-space:pre-wrap;">1 °C/W    = 1 K/W          (exact — same degree size)
1 °F·h/BTU = 0.527528 K/W
1 R-value  = 0.176110 K/W   (°F·ft²·h/BTU)

Result = Input × (FromFactor / ToFactor)</pre>
    <p style="color:var(--text-secondary); font-size:0.85rem; line-height:1.75;">
      Thermal resistance (R) is the inverse of thermal conductance. In building insulation, the R-value measures how well a material resists heat flow — higher R-values mean better insulation. The imperial R-value (°F·ft²·h/BTU) is the standard unit in the US construction industry. All calculations run in your browser.
    </p>
  </div>

  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is thermal resistance?",
          "acceptedAnswer": { "@type": "Answer", "text": "Thermal resistance measures a material's ability to resist heat flow. It is defined as the temperature difference across a material divided by the heat flow rate (R = ΔT / Q). Higher thermal resistance means better insulation. In building construction, the R-value is the standard measure of insulation effectiveness." }
        },
        {
          "@type": "Question",
          "name": "What is an R-value?",
          "acceptedAnswer": { "@type": "Answer", "text": "The R-value is an imperial measure of thermal resistance used primarily in building insulation in the United States. It is expressed in °F·ft²·h/BTU. A higher R-value indicates better insulating properties. For example, typical wall insulation has an R-value of R-13 to R-21, while roof insulation may be R-30 to R-60." }
        },
        {
          "@type": "Question",
          "name": "How do K/W and °C/W relate?",
          "acceptedAnswer": { "@type": "Answer", "text": "K/W and °C/W are numerically identical because the Kelvin and Celsius scales have the same degree size — they differ only in their zero point. Since thermal resistance involves temperature *differences* (not absolute temperatures), 1 K/W = 1 °C/W exactly." }
        }
      ]
    }
    </script>

    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What is thermal resistance?', a: 'Thermal resistance measures a material\'s ability to resist heat flow. It is defined as the temperature difference across a material divided by the heat flow rate (R = ΔT / Q). Higher thermal resistance means better insulation. In building construction, the R-value is the standard measure of insulation effectiveness.' },
        { q: 'What is an R-value?', a: 'The R-value is an imperial measure of thermal resistance used primarily in building insulation in the United States. It is expressed in °F·ft²·h/BTU. A higher R-value indicates better insulating properties. For example, typical wall insulation has an R-value of R-13 to R-21, while roof insulation may be R-30 to R-60.' },
        { q: 'How do K/W and °C/W relate?', a: 'K/W and °C/W are numerically identical because the Kelvin and Celsius scales have the same degree size — they differ only in their zero point. Since thermal resistance involves temperature *differences* (not absolute temperatures), 1 K/W = 1 °C/W exactly.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'K_W',   label: 'Kelvin per Watt (K/W)',                    abbr: 'K/W',     factor: 1 },
    { id: 'C_W',   label: 'Celsius per Watt (°C/W)',                  abbr: '°C/W',    factor: 1 },
    { id: 'F_BTU', label: 'Fahrenheit per BTU/h (°F·h/BTU)',          abbr: '°F·h/BTU', factor: 0.527528 },
    { id: 'Rval',  label: 'R-Value Imperial (°F·ft²·h/BTU)',          abbr: 'R-value',  factor: 0.176110 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
