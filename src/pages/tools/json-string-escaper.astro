---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'json-string-escaper')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">JSON String Escaper / Unescaper</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Escape JSON into source-code string literals, or unescape escaped strings back to readable JSON.</p>

    <div class="toggle-group" style="margin-bottom:1rem;" role="group" aria-label="Mode">
      <button class="toggle-btn active" data-mode="escape" type="button">Escape Mode</button>
      <button class="toggle-btn" data-mode="unescape" type="button">Unescape Mode</button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label id="input-label" style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">JSON Input</label>
          <button id="btn-sample" class="btn-secondary" type="button" style="font-size:0.7rem; padding:0.2rem 0.55rem;">Sample</button>
        </div>
        <textarea id="json-input" class="input-themed" rows="10"
          placeholder='{"key": "value"}'
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65;"
        ></textarea>
      </div>
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label id="output-label" style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Escaped Output</label>
          <button id="btn-copy" class="btn-secondary" type="button" style="font-size:0.7rem; padding:0.2rem 0.55rem;">Copy</button>
        </div>
        <textarea id="json-output" class="input-themed" readonly rows="10"
          placeholder="Escaped string appears here…"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65; background:var(--bg-surface-2);"
        ></textarea>
      </div>
    </div>

    <div style="display:flex; gap:0.5rem;">
      <button id="btn-run" class="btn-primary" type="button">Escape</button>
      <button id="btn-clear" class="btn-secondary" type="button">Clear</button>
    </div>

    <div id="error-box" style="display:none; margin-top:0.625rem; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); border-radius:0.5rem; padding:0.75rem 1rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:#DC2626;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">JSON String Escaper and Unescaper Overview</h2>
    <p class="seo-p">
      This JSON string escaper converts between raw JSON documents and backslash-escaped string literals suitable for embedding in source code. Two modes are available: Escape Mode takes valid JSON and produces a single-line string with all special characters escaped, ready to paste into Java, C#, Python, or any language that uses backslash-escape sequences. Unescape Mode reverses the process, taking an escaped string literal and producing a readable, formatted JSON document.
    </p>
    <p class="seo-p">
      The tool operates entirely client-side. In Escape mode, it parses the input with <code class="inline-code">JSON.parse()</code>, then uses <code class="inline-code">JSON.stringify()</code> to produce the escaped representation. In Unescape mode, it reverses the backslash sequences using the JavaScript parser's built-in unescaping, then optionally re-formats the result as pretty-printed JSON. An error is shown immediately for invalid input.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Embedding JSON in unit test fixtures', 'A developer writing unit tests in Java or C# can escape a JSON fixture object and paste the result directly into a string literal within the test method. This avoids the tedious manual process of escaping each double quote and backslash, and eliminates syntax errors from incomplete escaping.'],
        ['Recovering JSON from log files and error traces', 'A DevOps engineer investigating a production incident finds an escaped JSON string in a log file. Using Unescape mode, they can convert the log entry back to formatted JSON in one click, making it possible to inspect the original data structure and identify the root cause of the error.'],
        ['Preparing JSON for shell script variables', 'A developer writing a Bash or PowerShell script that passes JSON as an environment variable or command-line argument can use Escape mode to produce a safe, single-line string. The escaped output is guaranteed not to break the quoting of the enclosing shell script.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Escape and Unescape Mechanics</h2>
    <p class="seo-p">
      The escape process uses a well-known technique: double-serialisation with <code class="inline-code">JSON.stringify()</code>. The input JSON is first parsed into an object via <code class="inline-code">JSON.parse()</code>, which validates it. This object is then passed to <code class="inline-code">JSON.stringify()</code> which produces a JavaScript string representation. Calling <code class="inline-code">JSON.stringify()</code> again on that string produces the final output — a JSON string literal whose value is the original JSON document. Every special character is correctly escaped according to the ECMAScript specification: double quotes become <code class="inline-code">\"</code>, backslashes become <code class="inline-code">\\</code>, and control characters like newline and tab become <code class="inline-code">\n</code> and <code class="inline-code">\t</code>.
    </p>
    <h3 class="seo-h3-sm">Unescape Process</h3>
    <p class="seo-p">
      The unescape mode reverses each layer of escaping. It first strips the outer JSON string encoding via <code class="inline-code">JSON.parse()</code>, which interprets all backslash-escape sequences and returns the raw string value. If that raw string is itself valid JSON, it is parsed and re-formatted with indentation. If the unescaped result is not valid JSON (for example, if the original input was a plain escaped string), it is returned as-is. This layered approach handles both fully escaped JSON documents and partially escaped strings.
    </p>
    <h3 class="seo-h3-sm">Character Escape Reference</h3>
    <p class="seo-p-none">
      The JSON escape specification (RFC 8259) requires escaping of the following characters: double quote (<code class="inline-code">"</code> → <code class="inline-code">\"</code>), backslash (<code class="inline-code">\</code> → <code class="inline-code">\\</code>), forward slash (<code class="inline-code">/</code> → <code class="inline-code">\/</code>), backspace (<code class="inline-code">\b</code>), form feed (<code class="inline-code">\f</code>), newline (<code class="inline-code">\n</code>), carriage return (<code class="inline-code">\r</code>), tab (<code class="inline-code">\t</code>), and all non-ASCII or non-printable Unicode characters using <code class="inline-code">\uXXXX</code> hexadecimal escape sequences.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">When would I use escape mode?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Escape mode is useful when you need to embed JSON inside a string literal in source code — for example, test fixtures in Java or C#, environment variables in shell scripts, or JSON payloads in Python string templates. The escaped output can be pasted directly into a quoted string in any language that uses backslash-escape conventions.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What characters are escaped?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">All characters required by the JSON specification (RFC 8259) are escaped: double quotes (<code class="inline-code">"</code>), backslashes, and control characters including backspace, form feed, newline, carriage return, and tab. Non-ASCII and non-printable Unicode characters are represented using <code class="inline-code">\uXXXX</code> hexadecimal escape sequences. Forward slashes may optionally be escaped.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I escape invalid JSON?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">No. The tool first parses the input with <code class="inline-code">JSON.parse()</code> to validate it. If the input is not valid JSON, an error message is displayed showing the parser's position information. You must fix the JSON syntax first, then run the escape operation. Invalid input cannot be meaningfully escaped because the parser cannot determine the intended structure.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What languages does the escaped output work with?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The escaped output is valid in any language that uses backslash-escape sequences for string literals: Java, C#, C++, JavaScript, TypeScript, Python, Go, Rust, Ruby, PHP, Kotlin, Swift, and many others. The escaping follows the universal JSON string encoding, which is compatible with the common subset of escape sequences across these languages.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does the tool handle Unicode surrogate pairs correctly?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. <code class="inline-code">JSON.stringify()</code> handles UTF-16 surrogate pairs natively. Emoji and other characters outside the Basic Multilingual Plane are either passed through as-is in the escaped output (if the runtime supports direct encoding) or represented as two <code class="inline-code">\uXXXX</code> surrogate escapes. The round-trip through parse and stringify preserves all Unicode characters correctly.</p>
        </div>
      </div>

    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLE_JSON = JSON.stringify({name:"Alice",age:30,message:'She said "hello"',path:"C:\\Users\\Alice"},null,2);
  const SAMPLE_ESCAPED = '{"name":"Alice","age":30,"message":"She said \\\\"hello\\\\\"","path":"C:\\\\\\\\Users\\\\\\\\Alice"}';

  let mode = 'escape';

  const modeBtns = document.querySelectorAll<HTMLButtonElement>('[data-mode]');
  modeBtns.forEach(btn => btn.addEventListener('click', () => {
    mode = btn.dataset.mode!;
    modeBtns.forEach(b => b.classList.toggle('active', b.dataset.mode === mode));
    (document.getElementById('input-label') as HTMLElement).textContent = mode === 'escape' ? 'JSON Input' : 'Escaped Input';
    (document.getElementById('output-label') as HTMLElement).textContent = mode === 'escape' ? 'Escaped Output' : 'Unescaped Output';
    (document.getElementById('btn-run') as HTMLElement).textContent = mode === 'escape' ? 'Escape' : 'Unescape';
  }));

  function run() {
    const raw = (document.getElementById('json-input') as HTMLTextAreaElement).value;
    const out = (document.getElementById('json-output') as HTMLTextAreaElement);
    const errBox = document.getElementById('error-box')!;
    errBox.style.display = 'none';
    if (!raw.trim()) { out.value = ''; return; }

    try {
      if (mode === 'escape') {
        const parsed = JSON.parse(raw);
        out.value = JSON.stringify(JSON.stringify(parsed));
      } else {
        // Try to unescape
        let str = raw.trim();
        // First try to parse as-is (might be valid JSON)
        try {
          const parsed = JSON.parse(str);
          if (typeof parsed === 'object' && parsed !== null) {
            out.value = JSON.stringify(parsed, null, 2);
            return;
          }
        } catch {}
        // Strip surrounding quotes if present
        if ((str.startsWith('"') && str.endsWith('"')) || (str.startsWith("'") && str.endsWith("'"))) {
          str = JSON.parse(str);
        } else {
          str = JSON.parse(`"${str}"`);
        }
        // Try to parse as JSON
        try {
          out.value = JSON.stringify(JSON.parse(str), null, 2);
        } catch {
          out.value = str;
        }
      }
    } catch (e: any) {
      errBox.textContent = e.message;
      errBox.style.display = 'block';
    }
  }

  document.getElementById('btn-run')!.addEventListener('click', run);
  document.getElementById('btn-sample')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = mode === 'escape' ? SAMPLE_JSON : SAMPLE_ESCAPED;
    run();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = '';
    (document.getElementById('json-output') as HTMLTextAreaElement).value = '';
    document.getElementById('error-box')!.style.display = 'none';
  });
  document.getElementById('btn-copy')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy')!;
    navigator.clipboard.writeText((document.getElementById('json-output') as HTMLTextAreaElement).value).then(() => {
      btn.textContent = '✓ Copied!'; btn.classList.add('btn-success');
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
    }).catch(() => {});
  });
</script>
