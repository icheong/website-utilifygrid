---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'mortgage-calculator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">Mortgage Amortization Calculator</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">See how extra repayments reduce your loan term and total interest paid.</p>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.25rem;">

      <div>
        <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.375rem;">Loan Amount ($)</label>
        <input id="loan-amount" type="number" value="600000" min="10000" step="1000" class="input-themed" style="width:100%; padding:0.625rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;"/>
      </div>

      <div>
        <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.375rem;">Interest Rate (% p.a.)</label>
        <div style="display:flex; align-items:center; gap:0.625rem;">
          <input id="interest-rate" type="range" min="1" max="12" value="6" step="0.05" style="flex:1; accent-color:#1D4ED8;"/>
          <span id="interest-rate-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:var(--text-primary); min-width:2.75rem;">6.00%</span>
        </div>
      </div>

      <div>
        <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.375rem;">Loan Term (years)</label>
        <select id="loan-term" class="select-themed" style="width:100%; padding:0.625rem 0.875rem; border-radius:0.5rem; font-size:0.875rem;">
          <option value="10">10 years</option>
          <option value="15">15 years</option>
          <option value="20">20 years</option>
          <option value="25">25 years</option>
          <option value="30" selected>30 years</option>
        </select>
      </div>

      <div>
        <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.375rem;">Extra Monthly Payment ($)</label>
        <div style="display:flex; align-items:center; gap:0.625rem;">
          <input id="extra-payment" type="range" min="0" max="5000" value="0" step="50" style="flex:1; accent-color:#10B981;"/>
          <span id="extra-payment-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#10B981; min-width:3.5rem;">$0</span>
        </div>
      </div>

    </div>

    <!-- KPI cards -->
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.75rem; margin-bottom:1rem;">

      <div class="result-card accent-blue">
        <div class="result-value" id="out-monthly">—</div>
        <div class="result-label">Monthly Payment</div>
      </div>

      <div class="result-card accent-success">
        <div class="result-value" style="color:#10B981;" id="out-interest-saved">—</div>
        <div class="result-label">Interest Saved</div>
      </div>

      <div class="result-card accent-warning">
        <div class="result-value" style="color:#D97706;" id="out-time-saved">—</div>
        <div class="result-label">Time Saved</div>
      </div>

    </div>

    <!-- Summary row -->
    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:0.5rem; margin-bottom:1.25rem;">
      <div style="background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.5rem; padding:0.625rem 0.75rem; text-align:center;">
        <div id="out-total-interest" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:var(--text-secondary);">—</div>
        <div style="font-size:0.65rem; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-muted); margin-top:0.2rem;">Total Interest (base)</div>
      </div>
      <div style="background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.5rem; padding:0.625rem 0.75rem; text-align:center;">
        <div id="out-total-interest-extra" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#16A34A;">—</div>
        <div style="font-size:0.65rem; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-muted); margin-top:0.2rem;">Total Interest (extra)</div>
      </div>
      <div style="background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.5rem; padding:0.625rem 0.75rem; text-align:center;">
        <div id="out-payoff-date" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:var(--text-primary);">—</div>
        <div style="font-size:0.65rem; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-muted); margin-top:0.2rem;">Loan paid off</div>
      </div>
    </div>

    <!-- Balance chart -->
    <div style="margin-bottom:1.25rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.625rem;">
        <div style="font-size:0.72rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.07em;">Balance Over Time</div>
        <div style="display:flex; align-items:center; gap:1rem; font-size:0.7rem; font-weight:600; color:var(--text-muted);">
          <span style="display:flex; align-items:center; gap:0.3rem;"><span style="width:10px; height:3px; background:#1D4ED8; border-radius:2px; display:inline-block;"></span>Base</span>
          <span style="display:flex; align-items:center; gap:0.3rem;"><span style="width:10px; height:3px; background:#10B981; border-radius:2px; display:inline-block;"></span>With extra</span>
        </div>
      </div>
      <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.75rem; overflow:hidden;">
        <svg id="balance-chart" width="100%" height="180" viewBox="0 0 600 180" preserveAspectRatio="none" style="display:block; overflow:visible;">
          <!-- Y axis labels -->
          <text id="chart-y-top"    x="0"   y="12"  font-size="9" fill="currentColor" style="fill:var(--text-muted); font-family:'Fira Code',monospace;"></text>
          <text id="chart-y-mid"    x="0"   y="97"  font-size="9" fill="currentColor" style="fill:var(--text-muted); font-family:'Fira Code',monospace;"></text>
          <text id="chart-y-bottom" x="0"   y="174" font-size="9" fill="currentColor" style="fill:var(--text-muted); font-family:'Fira Code',monospace;">$0</text>
          <!-- Grid lines -->
          <line x1="48" y1="10"  x2="598" y2="10"  stroke="currentColor" stroke-width="0.5" style="stroke:var(--border);"/>
          <line x1="48" y1="95"  x2="598" y2="95"  stroke="currentColor" stroke-width="0.5" style="stroke:var(--border);"/>
          <line x1="48" y1="170" x2="598" y2="170" stroke="currentColor" stroke-width="0.5" style="stroke:var(--border);"/>
          <!-- X axis labels -->
          <text id="chart-x-0"   x="48"  y="180" font-size="9" text-anchor="middle" style="fill:var(--text-muted); font-family:'Fira Code',monospace;">Yr 0</text>
          <text id="chart-x-mid" x="323" y="180" font-size="9" text-anchor="middle" style="fill:var(--text-muted); font-family:'Fira Code',monospace;"></text>
          <text id="chart-x-end" x="598" y="180" font-size="9" text-anchor="end"    style="fill:var(--text-muted); font-family:'Fira Code',monospace;"></text>
          <!-- Base balance area (blue, behind) -->
          <path id="chart-base-area" fill="#1D4ED8" fill-opacity="0.12" stroke="none" d=""/>
          <!-- Extra balance area (green, in front) -->
          <path id="chart-extra-area" fill="#10B981" fill-opacity="0.18" stroke="none" d=""/>
          <!-- Base balance line -->
          <path id="chart-base-line" fill="none" stroke="#1D4ED8" stroke-width="2" stroke-linejoin="round" d=""/>
          <!-- Extra balance line -->
          <path id="chart-extra-line" fill="none" stroke="#10B981" stroke-width="2" stroke-linejoin="round" d=""/>
          <!-- Payoff marker for extra (vertical dashed) -->
          <line id="chart-payoff-line" x1="0" y1="10" x2="0" y2="170" stroke="#10B981" stroke-width="1.5" stroke-dasharray="4,3" style="display:none;"/>
          <text id="chart-payoff-label" x="0" y="8" font-size="8" text-anchor="middle" style="fill:#10B981; font-family:'Fira Code',monospace; display:none;"></text>
        </svg>
      </div>
    </div>

    <!-- Amortization toggle -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
      <div style="font-size:0.72rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.07em;">Amortization Schedule</div>
      <button id="btn-toggle-schedule" class="btn-secondary" style="padding:0.3rem 0.75rem; font-size:0.75rem;">Show</button>
    </div>

    <div id="schedule-wrap" style="display:none; max-height:280px; overflow-y:auto; border:1.5px solid var(--border); border-radius:0.625rem;">
      <table style="width:100%; border-collapse:collapse; font-size:0.75rem; font-family:'Fira Code',monospace;">
        <thead>
          <tr style="background:var(--bg-surface-2); position:sticky; top:0;">
            <th style="padding:0.5rem 0.625rem; text-align:right; font-weight:700; color:var(--text-muted); font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; border-bottom:1px solid var(--border);">Month</th>
            <th style="padding:0.5rem 0.625rem; text-align:right; font-weight:700; color:var(--text-muted); font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; border-bottom:1px solid var(--border);">Payment</th>
            <th style="padding:0.5rem 0.625rem; text-align:right; font-weight:700; color:var(--text-muted); font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; border-bottom:1px solid var(--border);">Principal</th>
            <th style="padding:0.5rem 0.625rem; text-align:right; font-weight:700; color:var(--text-muted); font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; border-bottom:1px solid var(--border);">Interest</th>
            <th style="padding:0.5rem 0.625rem; text-align:right; font-weight:700; color:var(--text-muted); font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em; border-bottom:1px solid var(--border);">Balance</th>
          </tr>
        </thead>
        <tbody id="schedule-body"></tbody>
      </table>
    </div>

  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >See exactly where your mortgage payments go</h2>
    <p class="seo-p" >
      When you take out a 30-year home loan, most of your early payments go toward interest rather than paying down the principal. On a $600,000 mortgage at 6.5%, the first month's payment of $3,796 allocates $3,250 to interest and only $546 to principal — a split that most borrowers never see laid out clearly. This calculator breaks down that split month by month, shows you the full amortization schedule, and lets you model how extra repayments change the trajectory of your loan.
    </p>
    <p class="seo-p" >
      Adjust the loan amount, interest rate, term, and extra monthly payment using the sliders. The three result cards update instantly: your monthly payment, how much interest you save by making extra repayments, and how many years you cut from the loan term. A balance-over-time chart plots two lines — your baseline loan trajectory and the accelerated one — so you can see the crossover where extra payments pull ahead. Toggle the amortization table to inspect every single payment down to the dollar.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Who uses this calculator</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['First-home buyers comparing loan terms', 'A couple looking at a $550,000 loan can instantly see that a 25-year term costs $873/month more than a 30-year term but saves $142,000 in total interest. That concrete dollar figure helps them decide whether the higher monthly commitment is worth it before they apply with a lender.'],
        ['Homeowners testing extra repayment strategies', 'If you receive a $12,000 annual bonus, you can model the impact of putting $1,000/month extra toward the mortgage versus making a single $12,000 lump-sum payment once a year. The amortization table shows exactly how each approach shifts the interest-to-principal ratio month by month.'],
        ['Mortgage brokers walking clients through options', 'A broker comparing a 5.9% variable rate against a 6.3% fixed rate can pull up this tool during a meeting and show the client the real monthly and total-interest difference on their specific loan amount — no spreadsheets required.'],
        ['Refinancing homeowners evaluating a rate switch', 'Someone currently paying 7.2% who has been offered 6.1% by a new lender can enter both scenarios and see the monthly savings, total interest reduction, and how long it takes for the refinancing costs to pay for themselves.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/compound-interest-retirement" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Compound Interest & Early Retirement Visualizer</a>
        <a href="/tools/car-loan-amortization-calculator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Car Loan Amortization & Lease Calculator</a>
        <a href="/tools/home-renovation-cost-estimator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Home Renovation Cost Range Estimator</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >How the amortization schedule is calculated</h2>
    <p class="seo-p" >
      Every mortgage payment covers two things: interest on the outstanding balance and repayment of the principal. The split between these two shifts every month — early payments are mostly interest, later payments are mostly principal. This tool computes that split using the standard annuity formula that lenders worldwide use to structure principal-and-interest loans.
    </p>
    <p class="seo-p" >
      All calculations run locally in your browser. No financial data you enter is transmitted anywhere.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">The fixed-payment formula</h3>
    <div class="seo-card-code" style="background:var(--bg-surface-2); border:1px solid var(--border); color:var(--text-primary)">
      Monthly rate r = Annual rate / 12<br/>
      n = Total months = Years × 12<br/>
      Payment M = P × [r(1+r)ⁿ] / [(1+r)ⁿ − 1]<br/>
      Each month: Interest = Balance × r<br/>
              Principal = M − Interest + Extra<br/>
              Balance = Balance − Principal
    </div>
    <p class="seo-p-sm" >
      The monthly payment <strong>M</strong> is calculated once at the start and stays fixed for the life of the loan. On a $600,000 loan at 6.5% over 30 years, that works out to $3,796 per month. In month one, interest is $600,000 × 0.065 ÷ 12 = $3,250, leaving only $546 to reduce the principal. By month 120 (year 10), the balance has dropped enough that roughly $1,200 of each payment goes to principal. By month 300 (year 25), the split has flipped — about $2,800 goes to principal and $1,000 to interest. This gradual shift is why a 30-year loan costs so much more total interest than a 15-year loan, even though the monthly payment is lower.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">How extra payments shorten the loan</h3>
    <p class="seo-p-sm" >
      When you add an extra amount each month, the entire extra payment goes directly to reducing the principal. Because interest for the next month is calculated on the now-smaller balance, you pay less interest the following month — and every month after that. The effect compounds: an extra $500/month on a $600,000 loan at 6% saves approximately $152,000 in total interest and pays off the loan about 8 years early. The chart on this page shows this visually — the green "with extra" line diverges from the blue baseline, and the dashed vertical line marks the point where the accelerated loan is fully paid off.
    </p>
    <p class="seo-p-sm" >
      The amortization table lets you verify this month by month. Each row shows the payment, the interest portion, the principal portion, and the remaining balance. You can watch the interest column shrink and the principal column grow as you scroll through the schedule.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Daily vs. monthly interest calculation</h3>
    <p class="seo-p-sm" >
      Most Australian lenders calculate interest daily on the outstanding balance rather than monthly. A daily-method lender charges interest on day 1 based on the full balance, applies your payment, then charges interest on day 2 based on the reduced balance, and so on for 365 days. This tool uses standard monthly compounding — one calculation per month — which produces results within approximately 0.5% of the daily method. The difference on a $600,000 loan over 30 years is typically a few hundred dollars in total interest, which is negligible for planning purposes but worth knowing about if you're comparing these figures to your lender's official statements.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Edge cases the tool handles</h3>
    <p class="seo-p-sm" >
      A 0% interest rate produces linear amortization — the monthly payment is simply the loan amount divided by the number of months, with no interest component. Very short terms (10 years) are fully supported. When extra payments are large enough to retire the loan before the end of the term, the final payment is automatically adjusted to zero out the remaining balance exactly, avoiding rounding artefacts that could leave a residual cent.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How much does an extra $500/month save on a $600k mortgage?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">On a $600,000 mortgage at 6% over 30 years, an extra $500 per month reduces the loan term by approximately 8 years and saves roughly $152,000 in total interest. The savings compound because each extra dollar reduces the principal immediately, meaning every subsequent month calculates interest on a smaller balance. Over 30 years, that $500/month extra — totalling $180,000 in additional contributions — avoids $152,000 in interest charges, effectively earning a risk-free 84% return on the extra money deployed. Use the extra payment slider to see the precise figure for your exact rate, term, and repayment amount.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does this calculator account for offset accounts?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">No — this tool models a standard principal-and-interest loan without an offset facility. An offset account works by reducing the balance that interest is calculated on each day. To approximate the effect, subtract your typical offset balance from the loan amount before entering it into the calculator. For example, if you have a $600,000 loan and $50,000 in an offset account, enter $550,000 as the loan amount. The approximation is close but not exact because most lenders calculate offset interest daily while this tool uses monthly compounding.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between P&amp;I and interest-only loans?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">This calculator models a principal-and-interest (P&amp;I) loan where each payment reduces the outstanding balance. Interest-only loans charge only the interest for an initial period — typically 1 to 5 years — after which they revert to P&amp;I with significantly higher payments to cover the original principal within the remaining term. On a $600,000 loan at 6%, interest-only for 5 years means you pay $30,000/year in interest for 5 years without reducing the principal at all, then face P&amp;I payments on the full $600,000 for the remaining 25 years. That structure adds roughly $90,000 in total interest compared to P&amp;I from day one.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why does the schedule show slightly different numbers to my bank?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Most Australian lenders calculate interest daily on the outstanding balance rather than monthly. A daily-method lender applies your payment on the day it's received, then recalculates interest on the new balance for the next day. This tool uses monthly compounding — one interest calculation per month — which produces results within approximately 0.5% of the daily method. On a $600,000 loan over 30 years, the difference is typically $200–$500 in total interest. Some lenders also include monthly account-keeping fees ($8–$15/month) in their statements, which this tool does not capture. For exact figures, always refer to your lender's official loan contract and periodic statements.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I use this calculator for an investment property loan?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes — the amortization mathematics are identical for owner-occupied and investment property loans. The key difference is that investment loans often carry a 0.2–0.5% higher interest rate, and you may be able to claim tax deductions on the interest portion. This tool does not model tax deductions or negative gearing. Enter your investment loan's actual rate and term to see the repayment schedule, then consult a qualified accountant for the tax implications specific to your situation.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What happens if I make extra payments irregularly rather than monthly?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">This calculator assumes a consistent extra payment each month. In practice, irregular extra payments — such as a $12,000 annual bonus deposited once a year — still reduce total interest, but the savings are slightly less than spreading the same $1,000/month across 12 months. The reason is timing: the $1,000 paid in January starts saving interest for 12 months, while the $12,000 deposited the following January only saves interest for 11 months. For irregular scenarios, divide your annual extra amount by 12 and enter that as the monthly figure to get a realistic estimate.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does this compare to my bank's mortgage calculator?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Bank calculators typically show you the minimum monthly repayment and little else. This tool goes further: it displays the full amortization schedule month by month, shows the interest-versus-principal split for every payment, plots a balance-over-time chart, and lets you model extra repayments to see the exact interest savings and term reduction. Bank calculators also often exclude fees, charges, and LMI (lenders mortgage insurance), while this tool focuses purely on the loan principal and interest — giving you a cleaner picture of the core loan mechanics.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Should I use the offset account or make extra repayments?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Both strategies reduce interest, but they work differently. Extra repayments permanently reduce your loan balance, which means you can't redraw the money without a formal loan increase. An offset account keeps your money liquid — you can withdraw it at any time — while still reducing the interest charged each day. The trade-off is that offset accounts often come with higher loan fees ($10–$25/month) and slightly higher interest rates. If you have disciplined savings habits and want to minimise total interest, extra repayments usually win. If you need emergency fund access, an offset account provides flexibility that extra repayments don't.</p>
        </div>
      </div>

    </div>

    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7">
      <strong class="text-primary" style="color:var(--text-secondary)">Disclaimer:</strong> This calculator is provided for educational and illustrative purposes only. It does not constitute financial, lending, or tax advice. The results are estimates based on standard amortization formulas and may differ from your lender's actual figures due to rounding, fee structures, daily interest calculations, or alternative compounding conventions. Always consult a licensed financial advisor or your lender for decisions related to mortgage financing.
    </div>
  </div>

</ToolLayout>

<script>
  // ── Shared state ──────────────────────────────────────────
  let scheduleData: { mo: number; pmt: number; prin: number; int: number; bal: number }[] = [];
  let baseScheduleData: typeof scheduleData = [];

  // ── Helpers ───────────────────────────────────────────────
  function fmtCcy(n: number): string {
    return '$' + Math.round(n).toLocaleString('en-AU');
  }

  // ── renderChart (declared before calc which calls it) ─────
  function renderChart(baseData: typeof scheduleData, extraData: typeof scheduleData, P: number): void {
    const CHART_X0 = 48, CHART_X1 = 598, CHART_Y0 = 10, CHART_Y1 = 170;
    const W = CHART_X1 - CHART_X0;
    const H = CHART_Y1 - CHART_Y0;

    function sampleBalances(data: typeof scheduleData, points: number): number[] {
      if (data.length === 0) return [P, 0];
      const result: number[] = [P];
      const step = Math.max(1, Math.floor(data.length / points));
      for (let i = step - 1; i < data.length; i += step) result.push(data[i].bal);
      result.push(data[data.length - 1].bal);
      return result;
    }

    const POINTS = 60;
    const baseSamples  = sampleBalances(baseData,  POINTS);
    const extraSamples = sampleBalances(extraData, POINTS);
    const maxLen = Math.max(baseSamples.length, extraSamples.length);

    function toSVG(samples: number[], totalPoints: number): { x: number; y: number }[] {
      return samples.map((bal, i) => ({
        x: CHART_X0 + (i / Math.max(totalPoints - 1, 1)) * W,
        y: CHART_Y0 + H - (P > 0 ? (bal / P) * H : 0),
      }));
    }

    const basePoints  = toSVG(baseSamples,  maxLen);
    const extraPoints = toSVG(extraSamples, maxLen);

    function pointsToLine(pts: { x: number; y: number }[]): string {
      return pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
    }
    function pointsToArea(pts: { x: number; y: number }[], yFloor: number): string {
      if (pts.length === 0) return '';
      const lastX  = pts[pts.length - 1].x.toFixed(1);
      const firstX = pts[0].x.toFixed(1);
      return `${pointsToLine(pts)} L${lastX},${yFloor} L${firstX},${yFloor} Z`;
    }

    document.getElementById('chart-base-line')!.setAttribute('d',  pointsToLine(basePoints));
    document.getElementById('chart-base-area')!.setAttribute('d',  pointsToArea(basePoints, CHART_Y1));
    document.getElementById('chart-extra-line')!.setAttribute('d', pointsToLine(extraPoints));
    document.getElementById('chart-extra-area')!.setAttribute('d', pointsToArea(extraPoints, CHART_Y1));

    const fmtK = (n: number) => n >= 1_000_000 ? '$' + (n / 1_000_000).toFixed(1) + 'M' : '$' + Math.round(n / 1000) + 'k';
    (document.getElementById('chart-y-top') as SVGTextElement).textContent = fmtK(P);
    (document.getElementById('chart-y-mid') as SVGTextElement).textContent = fmtK(P / 2);

    const baseTerm  = baseData.length;
    const extraTerm = extraData.length;
    (document.getElementById('chart-x-mid') as SVGTextElement).textContent = `Yr ${Math.round(baseTerm / 2 / 12)}`;
    (document.getElementById('chart-x-end') as SVGTextElement).textContent = `Yr ${Math.ceil(baseTerm / 12)}`;

    const payoffLine  = document.getElementById('chart-payoff-line') as SVGLineElement;
    const payoffLabel = document.getElementById('chart-payoff-label') as SVGTextElement;
    if (extraTerm < baseTerm && extraTerm > 0) {
      const px = (CHART_X0 + (extraTerm / baseTerm) * W).toFixed(1);
      payoffLine.setAttribute('x1', px); payoffLine.setAttribute('x2', px);
      payoffLabel.setAttribute('x', px);
      payoffLabel.textContent = `Yr ${Math.ceil(extraTerm / 12)} paid off`;
      payoffLine.style.display = ''; payoffLabel.style.display = '';
    } else {
      payoffLine.style.display = 'none'; payoffLabel.style.display = 'none';
    }
  }

  // ── renderSchedule (declared before calc which calls it) ──
  function renderSchedule(): void {
    const tbody = document.getElementById('schedule-body')!;
    tbody.innerHTML = '';
    const frag = document.createDocumentFragment();
    scheduleData.forEach(({ mo, pmt, prin, int, bal }) => {
      const tr = document.createElement('tr');
      tr.style.borderBottom = '1px solid var(--border)';
      [
        { val: String(mo),   color: 'var(--text-muted)' },
        { val: fmtCcy(pmt),  color: 'var(--text-secondary)' },
        { val: fmtCcy(prin), color: '#1D4ED8' },
        { val: fmtCcy(int),  color: '#DC2626' },
        { val: fmtCcy(bal),  color: 'var(--text-secondary)' },
      ].forEach(({ val, color }) => {
        const td = document.createElement('td');
        td.textContent = val;
        td.style.cssText = `padding:0.45rem 0.625rem; text-align:right; color:${color};`;
        tr.appendChild(td);
      });
      frag.appendChild(tr);
    });
    tbody.appendChild(frag);
  }

  // ── calc (uses renderChart + renderSchedule, so declared after both) ──
  function calc(): void {
    const P     = parseFloat((document.getElementById('loan-amount') as HTMLInputElement).value) || 0;
    const annR  = parseFloat((document.getElementById('interest-rate') as HTMLInputElement).value) || 0;
    const years = parseInt((document.getElementById('loan-term') as HTMLSelectElement).value) || 30;
    const extra = parseFloat((document.getElementById('extra-payment') as HTMLInputElement).value) || 0;

    if (P <= 0) return;

    const r = annR / 100 / 12;
    const n = years * 12;
    const M = r > 0
      ? P * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1)
      : P / n;

    // Base schedule — no extra payments
    let balBase = P;
    let totalIntBase = 0;
    baseScheduleData = [];
    for (let i = 0; i < n; i++) {
      const intPmt  = balBase * r;
      const prinPmt = M - intPmt;
      totalIntBase += intPmt;
      balBase = Math.max(0, balBase - prinPmt);
      baseScheduleData.push({ mo: i + 1, pmt: M, prin: prinPmt, int: intPmt, bal: balBase });
    }

    // Extra payment schedule
    let bal = P;
    let totalInt = 0;
    let month = 0;
    scheduleData = [];

    while (bal > 0.01 && month < n) {
      const intPmt  = bal * r;
      const prinPmt = Math.min(bal, M - intPmt + extra);
      totalInt += intPmt;
      bal = Math.max(0, bal - prinPmt);
      month++;
      scheduleData.push({ mo: month, pmt: M + extra, prin: prinPmt, int: intPmt, bal });
    }

    const interestSaved = Math.max(0, totalIntBase - totalInt);
    const monthsSaved   = n - month;
    const yearsS  = Math.floor(monthsSaved / 12);
    const mosS    = monthsSaved % 12;
    const timeSavedStr = monthsSaved <= 0
      ? '—'
      : yearsS > 0 ? `${yearsS}y ${mosS}m` : `${mosS} months`;

    const payoffDate = new Date();
    payoffDate.setMonth(payoffDate.getMonth() + month);
    const payoffStr = payoffDate.toLocaleDateString('en-AU', { month: 'short', year: 'numeric' });

    (document.getElementById('out-monthly') as HTMLElement).textContent             = fmtCcy(M + extra);
    (document.getElementById('out-interest-saved') as HTMLElement).textContent      = fmtCcy(interestSaved);
    (document.getElementById('out-time-saved') as HTMLElement).textContent          = timeSavedStr;
    (document.getElementById('out-total-interest') as HTMLElement).textContent      = fmtCcy(totalIntBase);
    (document.getElementById('out-total-interest-extra') as HTMLElement).textContent = fmtCcy(totalInt);
    (document.getElementById('out-payoff-date') as HTMLElement).textContent         = payoffStr;

    // Render chart
    renderChart(baseScheduleData, scheduleData, P);

    // Re-render schedule if visible
    const wrap = document.getElementById('schedule-wrap')!;
    if (wrap.style.display !== 'none') renderSchedule();
  }

  // ── Wire up event listeners after all functions are defined ──

  // Interest rate slider
  const rateSlider   = document.getElementById('interest-rate') as HTMLInputElement;
  const rateDisplay  = document.getElementById('interest-rate-val')!;
  rateSlider.addEventListener('input', () => {
    rateDisplay.textContent = parseFloat(rateSlider.value).toFixed(2) + '%';
    calc();
  });

  // Extra payment slider
  const extraSlider  = document.getElementById('extra-payment') as HTMLInputElement;
  const extraDisplay = document.getElementById('extra-payment-val')!;
  extraSlider.addEventListener('input', () => {
    extraDisplay.textContent = '$' + extraSlider.value;
    calc();
  });

  // Number input + select
  document.getElementById('loan-amount')!.addEventListener('input',  calc);
  document.getElementById('loan-amount')!.addEventListener('change', calc);
  document.getElementById('loan-term')!.addEventListener('change',   calc);

  // Schedule toggle
  const scheduleWrap = document.getElementById('schedule-wrap')!;
  const toggleBtn    = document.getElementById('btn-toggle-schedule') as HTMLButtonElement;
  toggleBtn.addEventListener('click', () => {
    const isHidden = scheduleWrap.style.display === 'none';
    scheduleWrap.style.display = isHidden ? 'block' : 'none';
    toggleBtn.textContent = isHidden ? 'Hide' : 'Show';
    if (isHidden) renderSchedule();
  });

  // ── Initial render ──
  calc();
</script>
