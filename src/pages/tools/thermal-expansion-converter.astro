---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'thermal-expansion-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Thermal Expansion Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="K">Per Kelvin (1/K)</option>
          <option value="C">Per Celsius (1/°C)</option>
          <option value="F">Per Fahrenheit (1/°F)</option>
          <option value="R">Per Rankine (1/°R)</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Thermal Expansion Converter</h2>
    <p class="seo-p">Convert any thermal expansion coefficient between Kelvin, Celsius, Fahrenheit, and Rankine scales instantly.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Select Expansion Type</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Choose between linear, area, or volumetric thermal expansion depending on your application. Each type uses a different coefficient but shares the same unit conversion logic.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Enter Coefficient Value</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Input the thermal expansion coefficient in its current unit. The value updates in real time as you type.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Select Target Unit</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Pick the source unit from the dropdown. The converter will display equivalent values in all other supported scales.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">View Results</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">See the converted coefficient in all units displayed below the input. Click any Copy button to save a value to your clipboard.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Thermal Expansion Converter Works</h2>
    <p class="seo-p">This tool converts thermal expansion coefficients between four temperature scales using a simple unit-factor method. All calculations happen locally in your browser.</p>
    <h3 class="font-display seo-h3-sm">Types of Thermal Expansion</h3>
    <p class="seo-p">Thermal expansion describes how materials change size with temperature. The <code class="inline-code">linear expansion coefficient (α)</code> measures fractional change in length per degree. The <code class="inline-code">area expansion coefficient (β)</code> is roughly 2α and applies to surfaces. The <code class="inline-code">volumetric expansion coefficient (γ)</code> is roughly 3α and applies to three-dimensional bodies. For isotropic materials, β = 2α and γ = 3α.</p>
    <h3 class="font-display seo-h3-sm">Unit Systems</h3>
    <p class="seo-p">The Celsius and Kelvin scales share the same degree size, so <code class="inline-code">1/°C = 1/K</code> exactly. Fahrenheit and Rankine degrees are smaller by a factor of 5/9, which means <code class="inline-code">1/°F = 1.8 × 1/K</code>. The converter multiplies by the ratio of source-to-target factors to produce the result.</p>
    <h3 class="font-display seo-h3-sm">Material Reference Values</h3>
    <p class="seo-p">Typical linear expansion coefficients: aluminum <code class="inline-code">≈ 23 × 10⁻⁶ 1/K</code>, steel <code class="inline-code">≈ 12 × 10⁻⁶ 1/K</code>, copper <code class="inline-code">≈ 17 × 10⁻⁶ 1/K</code>, concrete <code class="inline-code">≈ 12 × 10⁻⁶ 1/K</code>, and common plastics <code class="inline-code">50–200 × 10⁻⁶ 1/K</code>. Materials like Invar have extremely low CTE values for precision applications.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between linear and volumetric thermal expansion?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Linear expansion (α) measures the fractional change in length per degree, while volumetric expansion (γ) measures the fractional change in volume per degree. For isotropic materials, γ is approximately three times α. Use linear for rods or beams, and volumetric for liquids, gases, or three-dimensional solids.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the typical thermal expansion coefficient of steel?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The linear coefficient for most structural steels is approximately 12 × 10⁻⁶ per Kelvin (12 µm/m·°C). This means a 1-meter steel bar expands by about 0.012 mm for each degree Celsius temperature increase.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why is 1/°C equal to 1/K?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The Celsius and Kelvin scales have identical degree sizes — they differ only in their zero points. Since thermal expansion is about the change in temperature rather than absolute temperature, the offset is irrelevant. A 1°C change equals a 1 K change, so 1/°C = 1/K.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does temperature range affect thermal expansion?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The coefficient of thermal expansion is not perfectly constant — it can vary with temperature. Most published values are averages over a common range (e.g., 20–100°C). For precise engineering over wide temperature ranges, temperature-dependent CTE data should be used.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Which materials have the highest thermal expansion?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Polymers and plastics typically have the highest CTEs, ranging from 50 to 200 × 10⁻⁶ 1/K. Among metals, aluminum (≈ 23 × 10⁻⁶ 1/K) and copper (≈ 17 × 10⁻⁶ 1/K) expand more than steel. Ceramics and Invar alloys have very low expansion for precision applications.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why does thermal expansion matter in engineering?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Uncontrolled thermal expansion can cause structural stress, warping, or failure in bridges, rails, pipes, and electronic assemblies. Engineers account for expansion using joints, expansion loops, or materials with low CTE to prevent damage from temperature changes.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'K', label: 'Per Kelvin (1/K)',      abbr: '1/K',  factor: 1 },
    { id: 'C', label: 'Per Celsius (1/°C)',     abbr: '1/°C', factor: 1 },
    { id: 'F', label: 'Per Fahrenheit (1/°F)',  abbr: '1/°F', factor: 1.8 },
    { id: 'R', label: 'Per Rankine (1/°R)',     abbr: '1/°R', factor: 1.8 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
