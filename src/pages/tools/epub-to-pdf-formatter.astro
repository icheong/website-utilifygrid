---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'epub-to-pdf-formatter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Document to Print-Ready PDF</h2>

    <div style="display:grid; grid-template-columns:1fr auto; gap:0.75rem; margin-bottom:0.875rem; align-items:end;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Document Title</label>
        <input id="doc-title" type="text" value="My Document"
          class="input-themed" style="width:100%;"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Font Size</label>
        <select id="font-size" class="select-themed">
          <option value="11">11pt</option>
          <option value="12" selected>12pt</option>
          <option value="14">14pt</option>
        </select>
      </div>
    </div>

    <div style="margin-bottom:0.875rem;">
      <label style="font-size:0.78rem; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Content (supports Markdown headings and paragraphs)</label>
      <textarea id="doc-content" rows="12"
        placeholder="# Chapter 1: Introduction&#10;&#10;Your content here. Separate paragraphs with a blank line.&#10;&#10;## Section 1.1&#10;&#10;More text goes here..."
        class="input-themed"
        style="width:100%; font-family:'Inter',sans-serif; resize:vertical; line-height:1.7;"></textarea>
    </div>

    <div style="display:flex; gap:0.75rem;">
      <button id="preview-btn" class="btn-primary" type="button" style="flex:1;">
        Preview &amp; Print to PDF
      </button>
    </div>

    <p style="font-size:0.78rem; color:var(--text-muted); margin-top:0.625rem; line-height:1.5;">
      Opens a print-ready preview in a new window. Use your browser's Print dialog (Ctrl+P / Cmd+P) and select "Save as PDF" as the destination.
    </p>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to format your document</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">Paste your manuscript or document text into the content area. Use standard Markdown for structure: <code style="background:var(--bg-surface-2); padding:0.1rem 0.3rem; border-radius:0.25rem;"># Heading 1</code>, <code style="background:var(--bg-surface-2); padding:0.1rem 0.3rem; border-radius:0.25rem;">## Heading 2</code>, and blank lines between paragraphs.</p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">Set your title, choose a font size, then click "Preview & Print to PDF". In the print dialog, select "Save as PDF" and choose A4 or Letter paper size. Margins are pre-set to publishing standard (2.5cm).</p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How the formatting works</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">The tool applies a minimal Markdown parser that converts heading syntax and paragraph breaks into HTML. A print-specific CSS stylesheet applies page margins, typography, and page-break rules appropriate for printed documents.</p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">The browser's native <code style="background:var(--bg-surface-2); padding:0.1rem 0.3rem; border-radius:0.25rem;">window.print()</code> API handles the actual PDF generation via the OS print dialog. Nothing is uploaded to any server.</p>
  </div>

  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What Markdown syntax is supported?', a: '# H1, ## H2, ### H3 for headings; blank lines for paragraph breaks; **bold** and *italic* text. Tables and code blocks are not currently supported.' },
        { q: 'Can I control the page size?', a: 'Page size is set in your browser\'s print dialog when you export to PDF. Select A4 for international standard or Letter for North American standard. The tool\'s CSS margins are sized for either.' },
        { q: 'Why is the output not perfectly formatted?', a: 'This tool provides clean, readable document formatting — not desktop publishing. For complex layouts with columns, custom fonts, headers/footers, and precise image placement, use dedicated software like LibreOffice Writer, Word, or Adobe InDesign.' },
        { q: 'Is my document content private?', a: 'Yes. All processing happens in your browser. Your document text is never sent to any server and is lost when you close or refresh the page. Nothing is stored.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  function mdToHtml(md: string): string {
    return md
      .replace(/^### (.+)$/gm, '<h3>$1</h3>')
      .replace(/^## (.+)$/gm, '<h2>$1</h2>')
      .replace(/^# (.+)$/gm, '<h1>$1</h1>')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .split(/\n\s*\n/)
      .map(block => block.trim().startsWith('<h') ? block : `<p>${block.replace(/\n/g, ' ').trim()}</p>`)
      .filter(b => b !== '<p></p>')
      .join('\n');
  }

  document.getElementById('preview-btn')?.addEventListener('click', () => {
    const title   = (document.getElementById('doc-title') as HTMLInputElement).value || 'Document';
    const content = (document.getElementById('doc-content') as HTMLTextAreaElement).value;
    const fontSize = (document.getElementById('font-size') as HTMLSelectElement).value;
    const html = mdToHtml(content);

    const win = window.open('', '_blank');
    if (!win) return;
    win.document.write(`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>${title}</title><style>
      @page { size: A4; margin: 2.5cm; }
      body { font-family: Georgia, 'Times New Roman', serif; font-size: ${fontSize}pt; line-height: 1.8; color: #1a1a1a; max-width: 100%; }
      h1 { font-size: ${parseFloat(fontSize)*1.8}pt; margin: 2em 0 0.5em; page-break-after: avoid; }
      h2 { font-size: ${parseFloat(fontSize)*1.4}pt; margin: 1.5em 0 0.4em; page-break-after: avoid; }
      h3 { font-size: ${parseFloat(fontSize)*1.15}pt; margin: 1.2em 0 0.3em; page-break-after: avoid; }
      p { margin: 0 0 1em; text-align: justify; orphans: 3; widows: 3; }
      strong { font-weight: bold; }
      em { font-style: italic; }
    </style></head><body>${html}</body></html>`);
    win.document.close();
    win.print();
  });
</script>
