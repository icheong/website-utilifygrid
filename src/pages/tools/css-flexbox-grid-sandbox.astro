---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'css-flexbox-grid-sandbox')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">CSS Flexbox &amp; Grid Sandbox</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Adjust properties visually and copy production-ready CSS instantly.</p>

    <!-- Mode toggle -->
    <div class="toggle-group" style="margin-bottom:1.25rem;">
      <button id="btn-flex" class="toggle-btn active" aria-pressed="true">⬛ Flexbox</button>
      <button id="btn-grid" class="toggle-btn" aria-pressed="false">⬜ Grid</button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;">

      <!-- Controls panel -->
      <div style="display:flex; flex-direction:column; gap:0.875rem;">

        <!-- FLEX CONTROLS -->
        <div id="flex-controls">
          <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted); margin-bottom:0.625rem;">Flexbox Properties</div>

          {[
            { id:'flex-direction',    label:'flex-direction',    opts:['row','row-reverse','column','column-reverse'] },
            { id:'flex-wrap',         label:'flex-wrap',         opts:['nowrap','wrap','wrap-reverse'] },
            { id:'justify-content',   label:'justify-content',   opts:['flex-start','flex-end','center','space-between','space-around','space-evenly'] },
            { id:'align-items',       label:'align-items',       opts:['stretch','flex-start','flex-end','center','baseline'] },
            { id:'align-content',     label:'align-content',     opts:['normal','flex-start','flex-end','center','space-between','space-around','stretch'] },
          ].map(({ id, label, opts }) => (
            <div style="margin-bottom:0.625rem;">
              <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">{label}</label>
              <select id={id} class="select-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.82rem; font-family:'Fira Code',monospace;">
                {opts.map(o => <option value={o}>{o}</option>)}
              </select>
            </div>
          ))}

          <div>
            <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">gap</label>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <input id="flex-gap" type="range" min="0" max="32" value="8" style="flex:1; accent-color:#1D4ED8;"/>
              <span id="flex-gap-val" style="font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); min-width:2.5rem;">8px</span>
            </div>
          </div>
        </div>

        <!-- GRID CONTROLS -->
        <div id="grid-controls" style="display:none;">
          <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted); margin-bottom:0.625rem;">Grid Properties</div>

          {[
            { id:'grid-cols', label:'grid-template-columns' },
            { id:'grid-rows', label:'grid-template-rows' },
          ].map(({ id, label }) => (
            <div style="margin-bottom:0.625rem;">
              <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">{label}</label>
              <input id={id} type="text" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.82rem; font-family:'Fira Code',monospace; box-sizing:border-box;"/>
            </div>
          ))}

          {[
            { id:'justify-items',   label:'justify-items',   opts:['stretch','start','end','center'] },
            { id:'align-items-g',   label:'align-items',     opts:['stretch','start','end','center'] },
            { id:'justify-content-g', label:'justify-content', opts:['start','end','center','stretch','space-between','space-around','space-evenly'] },
            { id:'align-content-g', label:'align-content',   opts:['start','end','center','stretch','space-between','space-around'] },
          ].map(({ id, label, opts }) => (
            <div style="margin-bottom:0.625rem;">
              <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">{label}</label>
              <select id={id} class="select-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.82rem; font-family:'Fira Code',monospace;">
                {opts.map(o => <option value={o}>{o}</option>)}
              </select>
            </div>
          ))}

          <div>
            <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">gap</label>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <input id="grid-gap" type="range" min="0" max="32" value="8" style="flex:1; accent-color:#1D4ED8;"/>
              <span id="grid-gap-val" style="font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); min-width:2.5rem;">8px</span>
            </div>
          </div>

          <div style="margin-top:0.625rem;">
            <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">items</label>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <input id="grid-items" type="range" min="2" max="12" value="6" style="flex:1; accent-color:#1D4ED8;"/>
              <span id="grid-items-val" style="font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); min-width:1.5rem;">6</span>
            </div>
          </div>
        </div>

        <!-- Item count (flex) -->
        <div id="flex-item-count">
          <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">items</label>
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <input id="flex-items" type="range" min="2" max="12" value="5" style="flex:1; accent-color:#1D4ED8;"/>
            <span id="flex-items-val" style="font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); min-width:1.5rem;">5</span>
          </div>
        </div>

      </div>

      <!-- Preview + output -->
      <div style="display:flex; flex-direction:column; gap:0.875rem;">

        <!-- Live preview -->
        <div>
          <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted); margin-bottom:0.5rem;">Preview</div>
          <div id="preview-box" style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; height:220px; overflow:auto; padding:0.75rem;"></div>
        </div>

        <!-- Generated CSS -->
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
            <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted);">Generated CSS</div>
            <button id="btn-copy-css" class="btn-secondary" style="padding:0.3rem 0.75rem; font-size:0.75rem;">Copy CSS</button>
          </div>
          <pre id="css-output" style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem; padding:0.875rem; font-family:'Fira Code',monospace; font-size:0.75rem; color:var(--text-primary); overflow-x:auto; white-space:pre-wrap; margin:0; line-height:1.6;"></pre>
        </div>

      </div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >Experiment with Flexbox and Grid — see the CSS output instantly</h2>
    <p class="seo-p" >
      You're building a navbar and can't get the links to centre vertically inside the container. You need a three-column card layout but the middle column won't stretch to match the others. You've read the MDN docs on <code>justify-content</code> and <code>align-items</code> but the difference still doesn't click. Switch between Flexbox and Grid mode, adjust the dropdowns and sliders, and watch the numbered boxes in the preview area rearrange in real time. When the layout looks right, click <strong>Copy CSS</strong> to grab the production-ready block.
    </p>
    <p class="seo-p" >
      In Flexbox mode, adjust <code>flex-direction</code>, <code>flex-wrap</code>, <code>justify-content</code>, <code>align-items</code>, <code>align-content</code>, and <code>gap</code>. In Grid mode, type any valid CSS into the <code>grid-template-columns</code> and <code>grid-template-rows</code> fields — including <code>repeat(3, 1fr)</code>, <code>minmax(200px, 1fr)</code>, or <code>auto-fill</code> — and see how items reflow. The generated CSS block updates with every change.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Who uses this sandbox</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Developers prototyping layout options', 'A front-end developer needs a responsive card grid that works at 320px and 1,440px. Instead of writing CSS, saving, refreshing the browser, adjusting, and repeating, they type grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)) into the Grid input and immediately see 1 card on mobile, 2 on tablet, and 4 on desktop. The Copy CSS button gives them the exact declaration to paste into their stylesheet.'],
        ['Instructors teaching CSS layout', 'CSS layout is hard to learn from documentation because property interactions are not intuitive — how flex-wrap changes what align-content does, or why justify-content behaves differently in column direction. The numbered boxes in the preview make these relationships visible. An instructor can toggle flex-direction from row to column and the class instantly sees the main axis flip.'],
        ['Designers debugging responsive layouts', 'When a client says "the cards don\'t line up on mobile," the designer needs to isolate whether it\'s a gap issue, a wrapping issue, or a sizing issue. The sandbox lets them reproduce the exact property combination, test fixes, and copy the corrected CSS without touching the production codebase.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >How the sandbox works — two layout modes, one live preview</h2>

    <h3 class="font-display seo-h3-sm" >Flexbox mode: one dimension at a time</h3>
    <p class="seo-p" >
      Flexbox handles layout in one direction — either a row (horizontal) or a column (vertical). The <code>flex-direction</code> property sets which axis is the main axis. <code>justify-content</code> distributes items along that main axis, while <code>align-items</code> positions them along the cross axis. When you set <code>flex-wrap: wrap</code>, items spill onto multiple lines and <code>align-content</code> controls how those lines are spaced. The <code>gap</code> property adds consistent spacing between items without creating edge overflow.
    </p>

    <h3 class="font-display seo-h3-sm" >Grid mode: two dimensions at once</h3>
    <p class="seo-p" >
      Grid controls both rows and columns simultaneously. The <code>grid-template-columns</code> field accepts any valid CSS value — fixed (<code>200px</code>), flexible (<code>1fr</code>), intrinsic (<code>auto</code>), or repeating (<code>repeat(3, 1fr)</code>). You can type anything here: <code>repeat(auto-fill, minmax(200px, 1fr))</code> for a responsive card grid, or <code>1fr 2fr 1fr</code> for a three-column layout where the middle is twice as wide. The preview immediately shows how items reflow within the 220px-tall container.
    </p>

    <h3 class="font-display seo-h3-sm" >What happens when you adjust a property</h3>
    <p class="seo-p" >
      Every dropdown, slider, and text input fires an event listener on change. The update function reads the current value of every active control, builds an inline style string for the preview container, generates a formatted CSS block, and sets both the preview's style attribute and the output pre element's text content. The CSS output uses standard property names without vendor prefixes — Flexbox and Grid have been unprefixed in all major browsers since 2015–2017.
    </p>

    <h3 class="font-display seo-h3-sm" >Worked example: centring items with Flexbox</h3>
    <p class="seo-p" >
      A common problem: you have a div with three child elements and you want them centred both horizontally and vertically. Set <code>flex-direction: row</code>, <code>justify-content: center</code>, <code>align-items: center</code>, and <code>gap: 16px</code>. The preview shows the three numbered boxes centred in the container with 16px between them. The generated CSS gives you display: flex with those four properties — ready to paste into your stylesheet.
    </p>

    <h3 class="font-display seo-h3-sm" >Worked example: responsive card grid with Grid</h3>
    <p class="seo-p" >
      Set <code>grid-template-columns: repeat(auto-fill, minmax(200px, 1fr))</code> and <code>gap: 12px</code>. With the preview container at 220px wide, you see 1 column. Drag the container wider and items reflow — 2 columns at 400px, 3 at 600px. The <code>auto-fill</code> with <code>minmax</code> means columns are always at least 200px but stretch to fill available space. The generated CSS works identically in production at any container width.
    </p>

    <h3 class="font-display seo-h3-sm" >Edge cases and limitations</h3>
    <p class="seo-p" >
      The Grid text inputs accept any valid CSS — malformed values won't render a valid grid, which mirrors real browser behaviour. The preview container is fixed at 220px height with overflow scroll, so tall layouts are scrollable. The item count slider ranges from 2 to 12, sufficient to demonstrate wrapping, overflow, and alignment. The sandbox doesn't generate media queries — use it to determine your ideal property values, then wrap them in <code>@media</code> blocks in your stylesheet.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What is the difference between Flexbox and Grid?', a: 'Flexbox handles one dimension at a time — either a row or a column. Grid handles both dimensions simultaneously. Use Flexbox for component-level layouts: navbars, toolbars, button groups, or any layout where items flow in one direction. Use Grid for page-level layouts: card grids, dashboard panels, or any layout where you need to control both rows and columns. Most production sites use both — Grid for the page skeleton, Flexbox for components within grid areas.' },
        { q: 'What does justify-content vs align-items do?', a: 'In Flexbox, justify-content controls alignment along the main axis (the direction of flex-direction), and align-items controls the cross axis. For a row container, that means justify-content is horizontal and align-items is vertical. In Grid, justify-content and align-content position the entire grid within its container, while justify-items and align-items control how individual cells are positioned within their grid area.' },
        { q: 'Can I use the generated CSS directly in production?', a: 'Yes. The generated CSS uses standard property names without vendor prefixes. Flexbox and Grid have full support in all modern browsers — Chrome 29+, Firefox 28+, Safari 9+, Edge 12+. The output is valid CSS3 that can be pasted directly into a stylesheet, CSS module, or Tailwind @layer block. No autoprefixer needed for current browser targets.' },
        { q: 'What does fr mean in grid-template-columns?', a: 'fr is a fractional unit defined in the CSS Grid specification. It represents a share of the available space after fixed-size tracks are resolved. grid-template-columns: 1fr 2fr 1fr creates three columns where the middle is twice as wide as the others. fr units are ideal for responsive layouts because they automatically redistribute space when the container changes size.' },
        { q: 'When should I use gap instead of margins?', a: 'Gap sets spacing between items without creating space at the container edges. This avoids the common first/last item margin collapse problem. Use gap for consistent spacing between siblings in Flexbox or Grid containers. Use margin for external spacing — the distance between a container and its neighbours — or for asymmetric spacing on individual items.' },
        { q: 'How does this tool handle responsive breakpoints?', a: 'The sandbox focuses on property experimentation, not media query generation. Use it to find your ideal property values, then wrap the generated CSS in @media queries in your stylesheet. For example, test grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)) in Grid mode to see how items reflow, then apply that inside a breakpoint-specific media query.' },
        { q: 'Why do my grid items overlap?', a: 'Overlap happens when the grid defines fewer tracks than you have items, or when items are explicitly placed outside the defined grid area. In the sandbox, try adding more columns to grid-template-columns — for example, repeat(4, 1fr) for 6 items gives 4 columns with 2 wrapping to a second row. If items still overlap, check that no item has a grid-column or grid-row value that places it on top of another.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a" set:html={item.a} />
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  // ── Mode toggle ────────────────────────────────────────────
  const btnFlex     = document.getElementById('btn-flex')!;
  const btnGrid     = document.getElementById('btn-grid')!;
  const flexCtrls   = document.getElementById('flex-controls')!;
  const gridCtrls   = document.getElementById('grid-controls')!;
  const flexItems   = document.getElementById('flex-item-count')!;

  let mode: 'flex' | 'grid' = 'flex';

  function setMode(m: 'flex' | 'grid') {
    mode = m;
    btnFlex.classList.toggle('active', m === 'flex');
    btnFlex.setAttribute('aria-pressed', String(m === 'flex'));
    btnGrid.classList.toggle('active', m === 'grid');
    btnGrid.setAttribute('aria-pressed', String(m === 'grid'));
    flexCtrls.style.display  = m === 'flex' ? 'block' : 'none';
    gridCtrls.style.display  = m === 'grid' ? 'block' : 'none';
    flexItems.style.display  = m === 'flex' ? 'block' : 'none';
    update();
  }

  btnFlex.addEventListener('click', () => setMode('flex'));
  btnGrid.addEventListener('click', () => setMode('grid'));

  // ── Helpers ────────────────────────────────────────────────
  function val(id: string) {
    const el = document.getElementById(id) as HTMLSelectElement | HTMLInputElement;
    return el ? el.value : '';
  }

  // ── Sliders ────────────────────────────────────────────────
  function bindSlider(sliderId: string, displayId: string, suffix = '') {
    const slider  = document.getElementById(sliderId) as HTMLInputElement;
    const display = document.getElementById(displayId)!;
    slider.addEventListener('input', () => {
      display.textContent = slider.value + suffix;
      update();
    });
    display.textContent = slider.value + suffix;
  }

  bindSlider('flex-gap',   'flex-gap-val',   'px');
  bindSlider('grid-gap',   'grid-gap-val',   'px');
  bindSlider('flex-items', 'flex-items-val', '');
  bindSlider('grid-items', 'grid-items-val', '');

  // ── Selects & inputs ───────────────────────────────────────
  ['flex-direction','flex-wrap','justify-content','align-items','align-content',
   'justify-items','align-items-g','justify-content-g','align-content-g',
   'grid-cols','grid-rows'
  ].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('change', update);
    if (el) el.addEventListener('input',  update);
  });

  // Default values for grid inputs
  (document.getElementById('grid-cols') as HTMLInputElement).value = 'repeat(3, 1fr)';
  (document.getElementById('grid-rows') as HTMLInputElement).value = 'auto';

  // ── Item colour palette ────────────────────────────────────
  const ITEM_COLORS = [
    '#DBEAFE','#EDE9FE','#DCFCE7','#FEF3C7','#FFE4E6',
    '#CCFBF1','#FEE2E2','#E0F2FE','#F3E8FF','#FEF9C3',
    '#D1FAE5','#FFEDD5',
  ];
  const ITEM_TEXT = [
    '#1E40AF','#4C1D95','#14532D','#78350F','#881337',
    '#134E4A','#7F1D1D','#0C4A6E','#581C87','#713F12',
    '#064E3B','#7C2D12',
  ];

  // ── Render ─────────────────────────────────────────────────
  function buildItems(count: number) {
    let html = '';
    for (let i = 1; i <= count; i++) {
      const bg   = ITEM_COLORS[(i - 1) % ITEM_COLORS.length];
      const text = ITEM_TEXT[(i - 1) % ITEM_TEXT.length];
      html += `<div style="background:${bg}; color:${text}; border-radius:0.375rem; display:flex; align-items:center; justify-content:center; font-family:'Fira Code',monospace; font-size:0.75rem; font-weight:700; min-width:36px; min-height:36px; padding:0.375rem;">${i}</div>`;
    }
    return html;
  }

  function buildFlexCSS() {
    const gap = val('flex-gap') + 'px';
    return `.container {
  display: flex;
  flex-direction: ${val('flex-direction')};
  flex-wrap: ${val('flex-wrap')};
  justify-content: ${val('justify-content')};
  align-items: ${val('align-items')};
  align-content: ${val('align-content')};
  gap: ${gap};
}`;
  }

  function buildGridCSS() {
    const gap = val('grid-gap') + 'px';
    return `.container {
  display: grid;
  grid-template-columns: ${val('grid-cols')};
  grid-template-rows: ${val('grid-rows')};
  justify-items: ${val('justify-items')};
  align-items: ${val('align-items-g')};
  justify-content: ${val('justify-content-g')};
  align-content: ${val('align-content-g')};
  gap: ${gap};
}`;
  }

  function update() {
    const preview = document.getElementById('preview-box')!;
    const cssOut  = document.getElementById('css-output')!;

    let containerStyle = '';
    let css = '';
    const count = parseInt(
      mode === 'flex'
        ? (document.getElementById('flex-items') as HTMLInputElement).value
        : (document.getElementById('grid-items') as HTMLInputElement).value
    );

    if (mode === 'flex') {
      css = buildFlexCSS();
      containerStyle = `display:flex; flex-direction:${val('flex-direction')}; flex-wrap:${val('flex-wrap')}; justify-content:${val('justify-content')}; align-items:${val('align-items')}; align-content:${val('align-content')}; gap:${val('flex-gap')}px; width:100%; height:100%; box-sizing:border-box;`;
    } else {
      css = buildGridCSS();
      containerStyle = `display:grid; grid-template-columns:${val('grid-cols')}; grid-template-rows:${val('grid-rows')}; justify-items:${val('justify-items')}; align-items:${val('align-items-g')}; justify-content:${val('justify-content-g')}; align-content:${val('align-content-g')}; gap:${val('grid-gap')}px; width:100%; height:100%; box-sizing:border-box;`;
    }

    preview.innerHTML = `<div style="${containerStyle}">${buildItems(count)}</div>`;
    cssOut.textContent = css;
  }

  // ── Copy CSS ───────────────────────────────────────────────
  document.getElementById('btn-copy-css')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy-css') as HTMLButtonElement;
    const css = (document.getElementById('css-output') as HTMLElement).textContent || '';
    navigator.clipboard.writeText(css).then(() => {
      const orig = btn.textContent;
      btn.textContent = '✓ Copied!';
      btn.classList.add('btn-success');
      setTimeout(() => {
        btn.textContent = orig;
        btn.classList.remove('btn-success');
      }, 2000);
    });
  });

  // ── Init ───────────────────────────────────────────────────
  update();
</script>
