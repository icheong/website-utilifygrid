---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'css-flexbox-grid-sandbox')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">CSS Flexbox &amp; Grid Sandbox</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Adjust properties visually and copy production-ready CSS instantly.</p>

    <!-- Mode toggle -->
    <div class="toggle-group" style="margin-bottom:1.25rem;">
      <button id="btn-flex" class="toggle-btn active" aria-pressed="true">⬛ Flexbox</button>
      <button id="btn-grid" class="toggle-btn" aria-pressed="false">⬜ Grid</button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;">

      <!-- Controls panel -->
      <div style="display:flex; flex-direction:column; gap:0.875rem;">

        <!-- FLEX CONTROLS -->
        <div id="flex-controls">
          <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted); margin-bottom:0.625rem;">Flexbox Properties</div>

          {[
            { id:'flex-direction',    label:'flex-direction',    opts:['row','row-reverse','column','column-reverse'] },
            { id:'flex-wrap',         label:'flex-wrap',         opts:['nowrap','wrap','wrap-reverse'] },
            { id:'justify-content',   label:'justify-content',   opts:['flex-start','flex-end','center','space-between','space-around','space-evenly'] },
            { id:'align-items',       label:'align-items',       opts:['stretch','flex-start','flex-end','center','baseline'] },
            { id:'align-content',     label:'align-content',     opts:['normal','flex-start','flex-end','center','space-between','space-around','stretch'] },
          ].map(({ id, label, opts }) => (
            <div style="margin-bottom:0.625rem;">
              <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">{label}</label>
              <select id={id} class="select-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.82rem; font-family:'Fira Code',monospace;">
                {opts.map(o => <option value={o}>{o}</option>)}
              </select>
            </div>
          ))}

          <div>
            <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">gap</label>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <input id="flex-gap" type="range" min="0" max="32" value="8" style="flex:1; accent-color:#1D4ED8;"/>
              <span id="flex-gap-val" style="font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); min-width:2.5rem;">8px</span>
            </div>
          </div>
        </div>

        <!-- GRID CONTROLS -->
        <div id="grid-controls" style="display:none;">
          <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted); margin-bottom:0.625rem;">Grid Properties</div>

          {[
            { id:'grid-cols', label:'grid-template-columns' },
            { id:'grid-rows', label:'grid-template-rows' },
          ].map(({ id, label }) => (
            <div style="margin-bottom:0.625rem;">
              <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">{label}</label>
              <input id={id} type="text" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.82rem; font-family:'Fira Code',monospace; box-sizing:border-box;"/>
            </div>
          ))}

          {[
            { id:'justify-items',   label:'justify-items',   opts:['stretch','start','end','center'] },
            { id:'align-items-g',   label:'align-items',     opts:['stretch','start','end','center'] },
            { id:'justify-content-g', label:'justify-content', opts:['start','end','center','stretch','space-between','space-around','space-evenly'] },
            { id:'align-content-g', label:'align-content',   opts:['start','end','center','stretch','space-between','space-around'] },
          ].map(({ id, label, opts }) => (
            <div style="margin-bottom:0.625rem;">
              <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">{label}</label>
              <select id={id} class="select-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.82rem; font-family:'Fira Code',monospace;">
                {opts.map(o => <option value={o}>{o}</option>)}
              </select>
            </div>
          ))}

          <div>
            <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">gap</label>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <input id="grid-gap" type="range" min="0" max="32" value="8" style="flex:1; accent-color:#1D4ED8;"/>
              <span id="grid-gap-val" style="font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); min-width:2.5rem;">8px</span>
            </div>
          </div>

          <div style="margin-top:0.625rem;">
            <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">items</label>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <input id="grid-items" type="range" min="2" max="12" value="6" style="flex:1; accent-color:#1D4ED8;"/>
              <span id="grid-items-val" style="font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); min-width:1.5rem;">6</span>
            </div>
          </div>
        </div>

        <!-- Item count (flex) -->
        <div id="flex-item-count">
          <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); font-family:'Fira Code',monospace; margin-bottom:0.3rem;">items</label>
          <div style="display:flex; align-items:center; gap:0.5rem;">
            <input id="flex-items" type="range" min="2" max="12" value="5" style="flex:1; accent-color:#1D4ED8;"/>
            <span id="flex-items-val" style="font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); min-width:1.5rem;">5</span>
          </div>
        </div>

      </div>

      <!-- Preview + output -->
      <div style="display:flex; flex-direction:column; gap:0.875rem;">

        <!-- Live preview -->
        <div>
          <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted); margin-bottom:0.5rem;">Preview</div>
          <div id="preview-box" style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; height:220px; overflow:auto; padding:0.75rem;"></div>
        </div>

        <!-- Generated CSS -->
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
            <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted);">Generated CSS</div>
            <button id="btn-copy-css" class="btn-secondary" style="padding:0.3rem 0.75rem; font-size:0.75rem;">Copy CSS</button>
          </div>
          <pre id="css-output" style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem; padding:0.875rem; font-family:'Fira Code',monospace; font-size:0.75rem; color:var(--text-primary); overflow-x:auto; white-space:pre-wrap; margin:0; line-height:1.6;"></pre>
        </div>

      </div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >CSS Flexbox &amp; Grid Sandbox — Overview &amp; Modern Technical Context</h2>
    <p class="seo-p" >
      Modern CSS layout is built on two specification-driven modules: Flexbox (CSS Flexible Box Layout Level 1) and CSS Grid Layout Level 2. Both are W3C standards with full browser support across Chrome, Firefox, Safari, and Edge. This interactive sandbox lets developers visually experiment with every property in both layout systems — adjusting values in real time and instantly copying production-ready CSS. The tool runs entirely in your browser using vanilla JavaScript and the CSSOM (CSS Object Model) — no server calls, no data transmission, no tracking.
    </p>
    <p class="seo-p" >
      Switch between <strong>Flexbox</strong> and <strong>Grid</strong> modes using the toggle at the top. In Flexbox mode, adjust <code>flex-direction</code>, <code>flex-wrap</code>, <code>justify-content</code>, <code>align-items</code>, <code>align-content</code>, and <code>gap</code>. In Grid mode, configure <code>grid-template-columns</code>, <code>grid-template-rows</code>, <code>justify-items</code>, <code>align-items</code>, <code>justify-content</code>, <code>align-content</code>, and <code>gap</code>. The left panel provides dropdown selectors and range sliders for each property; the right panel renders a live preview with numbered child elements and outputs the corresponding CSS block.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Rapid prototyping and layout iteration', 'Front-end developers frequently need to test multiple layout configurations before committing to a design. Instead of manually writing CSS, toggling between browser devtools, and refreshing, this sandbox provides a single interface for experimenting with property combinations. The live preview updates on every input change, eliminating the compile-refresh cycle and reducing the time to reach a working layout from minutes to seconds.'],
        ['Teaching and learning CSS layout', 'CSS layout is notoriously difficult to learn from documentation alone because the interaction between properties (e.g., how flex-wrap affects align-content) is not intuitive. This sandbox renders numbered boxes inside a container, making it immediately visible how each property change affects item positioning, sizing, and alignment. Instructors can use it in classroom demos, and students can experiment independently without setting up a development environment.'],
        ['Responsive design debugging', 'When building responsive layouts, developers need to understand how fr units, minmax(), and auto-fill/auto-fit interact with container dimensions. The Grid mode accepts any valid CSS value in the grid-template-columns and grid-template-rows fields, allowing developers to test complex track definitions and immediately see how items reflow — without writing a single line of code.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >Deep-Dive: Flexbox &amp; Grid Property Mechanics</h2>

    <h3 class="font-display seo-h3-sm" >Flexbox Properties</h3>
    <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1rem">
      {[
        ['flex-direction', 'Defines the main axis direction. <code>row</code> lays items left-to-right, <code>column</code> lays them top-to-bottom. Reversed variants reverse the visual order without changing DOM sequence.'],
        ['flex-wrap', 'Controls whether items stay on one line (<code>nowrap</code>) or wrap to multiple lines (<code>wrap</code>). Wrapping interacts with <code>align-content</code> to distribute space between lines.'],
        ['justify-content', 'Aligns items along the main axis. <code>space-between</code> distributes items with no gap at edges; <code>space-around</code> adds half-size gaps at edges; <code>space-evenly</code> equalises all gaps.'],
        ['align-items', 'Aligns items along the cross axis within their line. <code>stretch</code> fills the available cross-axis space; <code>center</code> centres items; <code>baseline</code> aligns text baselines across items.'],
        ['align-content', 'Positions lines when there is extra cross-axis space (multi-line flex containers). Single-line containers ignore this property entirely.'],
        ['gap', 'Sets the spacing between items along both axes. Unlike <code>margin</code>, gap does not create overflow at container edges.'],
      ].map(([label, desc]) => (
        <div class="surface-2" style="background:var(--bg-surface); border:1px solid var(--border); border-radius:0.625rem; padding:0.875rem 1rem">
          <div style="font-size:0.82rem; font-weight:700; color:var(--text-primary); margin-bottom:0.3rem">{label}</div>
          <p class="text-secondary" style="font-size:0.82rem; line-height:1.6; margin:0" set:html={desc} />
        </div>
      ))}
    </div>

    <h3 class="font-display seo-h3-sm" >Grid Properties</h3>
    <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1rem">
      {[
        ['grid-template-columns', 'Defines column track sizes. Accepts any valid CSS value: fixed (<code>200px</code>), flexible (<code>1fr</code>), intrinsic (<code>auto</code>), or repeating (<code>repeat(3, 1fr)</code>).'],
        ['grid-template-rows', 'Defines row track sizes using the same syntax as columns. Defaults to <code>auto</code> if omitted, sizing rows to content.'],
        ['justify-items / align-items', 'Position individual items within their grid area. <code>stretch</code> fills the area; <code>start</code>/<code>end</code>/<code>center</code> position the item within the area bounds.'],
        ['justify-content / align-content', 'Positions the entire grid within its container when the grid is smaller than the container. Controls alignment of the grid tracks as a group.'],
        ['gap', 'Sets spacing between grid rows and columns. Accepts two values for independent row/column gaps: <code>row-gap column-gap</code>.'],
      ].map(([label, desc]) => (
        <div class="surface-2" style="background:var(--bg-surface); border:1px solid var(--border); border-radius:0.625rem; padding:0.875rem 1rem">
          <div style="font-size:0.82rem; font-weight:700; color:var(--text-primary); margin-bottom:0.3rem">{label}</div>
          <p class="text-secondary" style="font-size:0.82rem; line-height:1.6; margin:0" set:html={desc} />
        </div>
      ))}
    </div>

    <h3 class="font-display seo-h3-sm" >How the Sandbox Computes Output</h3>
    <p class="seo-p" >
      Each control binds to a <code>change</code>/<code>input</code> event listener. On every change, the <code>update()</code> function reads current values from all active controls, constructs an inline style string for the preview container, generates a formatted CSS block, and sets both the preview container's <code>style</code> attribute and the output <code>&lt;pre&gt;</code> element's text content. The CSS output uses standard property names without vendor prefixes — Flexbox and Grid have been unprefixed in all major browsers since 2015–2017. The <code>fr</code> unit, <code>gap</code>, and <code>minmax()</code> are all part of the CSS Grid Level 1 specification and require no polyfill.
    </p>
    <p class="seo-p-none" >
      <strong>Edge cases:</strong> The Grid mode accepts arbitrary CSS values in the columns/rows text inputs — malformed values will simply not render a valid grid, mirroring real browser behaviour. The preview container has a fixed height with overflow scroll, so layouts that exceed the viewport are scrollable. The item count slider ranges from 2 to 12, sufficient to demonstrate wrapping, overflow, and alignment behaviour across typical use cases.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What is the difference between Flexbox and Grid?', a: 'Flexbox is a one-dimensional layout model — it handles either a row or a column at a time. CSS Grid is two-dimensional and can control both rows and columns simultaneously. Flexbox is ideal for navigation bars, toolbars, and component-level layouts. Grid is ideal for full page layouts, card grids, and any layout where alignment in both axes matters. In practice, the two systems are complementary — many production layouts use Grid for the page skeleton and Flexbox for individual components within grid areas.' },
        { q: 'What does justify-content vs align-items do?', a: 'In Flexbox, <code>justify-content</code> controls alignment along the main axis (the direction of <code>flex-direction</code>), while <code>align-items</code> controls alignment along the cross axis. For a row-direction container, <code>justify-content</code> aligns horizontally and <code>align-items</code> aligns vertically. In Grid, <code>justify-content</code> and <code>align-content</code> position the entire grid within its container, while <code>justify-items</code> and <code>align-items</code> control how individual cells are positioned within their grid area.' },
        { q: 'Can I use the generated CSS directly in production?', a: 'Yes. The generated CSS uses standard property names without vendor prefixes, as Flexbox and Grid have full browser support in all modern browsers (Chrome 29+, Firefox 28+, Safari 9+, Edge 12+). The output is valid CSS3 that can be pasted directly into a stylesheet, CSS module, or inline style block. No post-processing or autoprefixing is required for current browser targets.' },
        { q: 'What does fr mean in grid-template-columns?', a: '<code>fr</code> is a fractional unit defined in the CSS Grid Level 1 specification that represents a share of the available space in a grid container. For example, <code>grid-template-columns: 1fr 2fr 1fr</code> creates three columns where the middle column is twice as wide as the others. <code>fr</code> units are distributed after fixed-size (<code>px</code>) and <code>auto</code>-sized tracks are resolved, making them ideal for flexible, responsive layouts.' },
        { q: 'When should I use gap instead of margins?', a: 'The <code>gap</code> property (available in both Flexbox and Grid) sets spacing between items without creating space at the container edges. This avoids the common "first/last item margin collapse" problem that occurs with <code>margin</code>. Use <code>gap</code> for consistent, predictable spacing between siblings. Use <code>margin</code> for external spacing — the distance between a container and its neighbours, or for asymmetric spacing on individual items.' },
        { q: 'How does this tool handle responsive breakpoints?', a: 'This sandbox focuses on property experimentation rather than media query generation. To create responsive layouts, use the sandbox to determine your ideal property values, then wrap the generated CSS in appropriate <code>@media</code> queries in your stylesheet. For example, experiment with <code>grid-template-columns: repeat(auto-fill, minmax(250px, 1fr))</code> in Grid mode to see how items reflow at different widths, then apply that declaration inside a breakpoint-specific media query.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a" set:html={item.a} />
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  // ── Mode toggle ────────────────────────────────────────────
  const btnFlex     = document.getElementById('btn-flex')!;
  const btnGrid     = document.getElementById('btn-grid')!;
  const flexCtrls   = document.getElementById('flex-controls')!;
  const gridCtrls   = document.getElementById('grid-controls')!;
  const flexItems   = document.getElementById('flex-item-count')!;

  let mode: 'flex' | 'grid' = 'flex';

  function setMode(m: 'flex' | 'grid') {
    mode = m;
    btnFlex.classList.toggle('active', m === 'flex');
    btnFlex.setAttribute('aria-pressed', String(m === 'flex'));
    btnGrid.classList.toggle('active', m === 'grid');
    btnGrid.setAttribute('aria-pressed', String(m === 'grid'));
    flexCtrls.style.display  = m === 'flex' ? 'block' : 'none';
    gridCtrls.style.display  = m === 'grid' ? 'block' : 'none';
    flexItems.style.display  = m === 'flex' ? 'block' : 'none';
    update();
  }

  btnFlex.addEventListener('click', () => setMode('flex'));
  btnGrid.addEventListener('click', () => setMode('grid'));

  // ── Helpers ────────────────────────────────────────────────
  function val(id: string) {
    const el = document.getElementById(id) as HTMLSelectElement | HTMLInputElement;
    return el ? el.value : '';
  }

  // ── Sliders ────────────────────────────────────────────────
  function bindSlider(sliderId: string, displayId: string, suffix = '') {
    const slider  = document.getElementById(sliderId) as HTMLInputElement;
    const display = document.getElementById(displayId)!;
    slider.addEventListener('input', () => {
      display.textContent = slider.value + suffix;
      update();
    });
    display.textContent = slider.value + suffix;
  }

  bindSlider('flex-gap',   'flex-gap-val',   'px');
  bindSlider('grid-gap',   'grid-gap-val',   'px');
  bindSlider('flex-items', 'flex-items-val', '');
  bindSlider('grid-items', 'grid-items-val', '');

  // ── Selects & inputs ───────────────────────────────────────
  ['flex-direction','flex-wrap','justify-content','align-items','align-content',
   'justify-items','align-items-g','justify-content-g','align-content-g',
   'grid-cols','grid-rows'
  ].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('change', update);
    if (el) el.addEventListener('input',  update);
  });

  // Default values for grid inputs
  (document.getElementById('grid-cols') as HTMLInputElement).value = 'repeat(3, 1fr)';
  (document.getElementById('grid-rows') as HTMLInputElement).value = 'auto';

  // ── Item colour palette ────────────────────────────────────
  const ITEM_COLORS = [
    '#DBEAFE','#EDE9FE','#DCFCE7','#FEF3C7','#FFE4E6',
    '#CCFBF1','#FEE2E2','#E0F2FE','#F3E8FF','#FEF9C3',
    '#D1FAE5','#FFEDD5',
  ];
  const ITEM_TEXT = [
    '#1E40AF','#4C1D95','#14532D','#78350F','#881337',
    '#134E4A','#7F1D1D','#0C4A6E','#581C87','#713F12',
    '#064E3B','#7C2D12',
  ];

  // ── Render ─────────────────────────────────────────────────
  function buildItems(count: number) {
    let html = '';
    for (let i = 1; i <= count; i++) {
      const bg   = ITEM_COLORS[(i - 1) % ITEM_COLORS.length];
      const text = ITEM_TEXT[(i - 1) % ITEM_TEXT.length];
      html += `<div style="background:${bg}; color:${text}; border-radius:0.375rem; display:flex; align-items:center; justify-content:center; font-family:'Fira Code',monospace; font-size:0.75rem; font-weight:700; min-width:36px; min-height:36px; padding:0.375rem;">${i}</div>`;
    }
    return html;
  }

  function buildFlexCSS() {
    const gap = val('flex-gap') + 'px';
    return `.container {
  display: flex;
  flex-direction: ${val('flex-direction')};
  flex-wrap: ${val('flex-wrap')};
  justify-content: ${val('justify-content')};
  align-items: ${val('align-items')};
  align-content: ${val('align-content')};
  gap: ${gap};
}`;
  }

  function buildGridCSS() {
    const gap = val('grid-gap') + 'px';
    return `.container {
  display: grid;
  grid-template-columns: ${val('grid-cols')};
  grid-template-rows: ${val('grid-rows')};
  justify-items: ${val('justify-items')};
  align-items: ${val('align-items-g')};
  justify-content: ${val('justify-content-g')};
  align-content: ${val('align-content-g')};
  gap: ${gap};
}`;
  }

  function update() {
    const preview = document.getElementById('preview-box')!;
    const cssOut  = document.getElementById('css-output')!;

    let containerStyle = '';
    let css = '';
    const count = parseInt(
      mode === 'flex'
        ? (document.getElementById('flex-items') as HTMLInputElement).value
        : (document.getElementById('grid-items') as HTMLInputElement).value
    );

    if (mode === 'flex') {
      css = buildFlexCSS();
      containerStyle = `display:flex; flex-direction:${val('flex-direction')}; flex-wrap:${val('flex-wrap')}; justify-content:${val('justify-content')}; align-items:${val('align-items')}; align-content:${val('align-content')}; gap:${val('flex-gap')}px; width:100%; height:100%; box-sizing:border-box;`;
    } else {
      css = buildGridCSS();
      containerStyle = `display:grid; grid-template-columns:${val('grid-cols')}; grid-template-rows:${val('grid-rows')}; justify-items:${val('justify-items')}; align-items:${val('align-items-g')}; justify-content:${val('justify-content-g')}; align-content:${val('align-content-g')}; gap:${val('grid-gap')}px; width:100%; height:100%; box-sizing:border-box;`;
    }

    preview.innerHTML = `<div style="${containerStyle}">${buildItems(count)}</div>`;
    cssOut.textContent = css;
  }

  // ── Copy CSS ───────────────────────────────────────────────
  document.getElementById('btn-copy-css')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy-css') as HTMLButtonElement;
    const css = (document.getElementById('css-output') as HTMLElement).textContent || '';
    navigator.clipboard.writeText(css).then(() => {
      const orig = btn.textContent;
      btn.textContent = '✓ Copied!';
      btn.classList.add('btn-success');
      setTimeout(() => {
        btn.textContent = orig;
        btn.classList.remove('btn-success');
      }, 2000);
    });
  });

  // ── Init ───────────────────────────────────────────────────
  update();
</script>
