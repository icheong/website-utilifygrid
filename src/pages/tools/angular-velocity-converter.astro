---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'angular-velocity-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Angular Velocity Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter an angular velocity and select its unit — all others update instantly with a live rotating diagram.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.25rem;">
      <div>
        <label class="tool-label" for="ang-input">Angular Velocity</label>
        <input id="ang-input" type="number" value="60" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="ang-unit">Unit</label>
        <select id="ang-unit" class="select-themed" style="min-width:10rem;">
          <option value="rads" selected>Rad/s</option>
          <option value="degs">Deg/s</option>
          <option value="rpm">RPM</option>
          <option value="rps">Rev/s</option>
          <option value="hz">Hertz (Hz)</option>
          <option value="degm">Deg/min</option>
          <option value="degh">Deg/hr</option>
          <option value="as">Arcsec/s</option>
        </select>
      </div>
    </div>

    <!-- Live diagram -->
    <div style="display:flex;gap:1.5rem;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;">
      <svg id="ang-svg" viewBox="0 0 200 200" width="180" height="180" style="flex-shrink:0;">
        <defs>
          <marker id="arrowhead" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" fill="var(--color-brand-blue)" />
          </marker>
        </defs>
        <!-- Circle -->
        <circle cx="100" cy="100" r="85" fill="none" stroke="var(--border)" stroke-width="1.5" />
        <!-- Degree marks -->
        <line x1="100" y1="18" x2="100" y2="28" stroke="var(--text-muted)" stroke-width="1" />
        <line x1="182" y1="100" x2="172" y2="100" stroke="var(--text-muted)" stroke-width="1" />
        <line x1="100" y1="182" x2="100" y2="172" stroke="var(--text-muted)" stroke-width="1" />
        <line x1="18" y1="100" x2="28" y2="100" stroke="var(--text-muted)" stroke-width="1" />
        <!-- Angle arc -->
        <path id="ang-arc" fill="none" stroke="var(--color-brand-blue)" stroke-width="2.5" stroke-linecap="round" opacity="0.3" />
        <!-- Rotating arm -->
        <line id="ang-arm" x1="100" y1="100" x2="100" y2="25" stroke="var(--color-brand-blue)" stroke-width="3" stroke-linecap="round" />
        <!-- Tip dot -->
        <circle id="ang-tip" cx="100" cy="25" r="5" fill="var(--color-brand-blue)" />
        <!-- Center dot -->
        <circle cx="100" cy="100" r="4" fill="var(--text-secondary)" />
      </svg>
      <div style="min-width:0;">
        <p id="ang-display" style="font-size:1.8rem;font-weight:700;font-family:'Fira Code',monospace;color:var(--text-primary);margin-bottom:0.25rem;">60 RPM</p>
        <p class="seo-p-sm" style="margin-bottom:0;">= <span id="ang-rads">6.2832</span> rad/s</p>
        <p class="seo-p-sm">= <span id="ang-degs">360</span> °/s</p>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Angular Velocity Converter Overview</h2>
    <p class="seo-p">
      This angular velocity converter computes precise conversions between 8 rotational speed units — radians per second, degrees per second, revolutions per minute, revolutions per second, hertz, degrees per minute, degrees per hour, and arcseconds per second — entirely within your browser. Built with modern vanilla JavaScript and SVG animation APIs, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your calculations, whether you are working in mechanical engineering, physics, astronomy, or signal processing.
    </p>
    <p class="seo-p">
      The converter features a live rotating SVG diagram that visually demonstrates the entered angular velocity, providing immediate intuitive feedback on the speed being converted. The tool handles the full range from extremely slow astronomical rotations (arcseconds per hour) to extremely fast centrifuge speeds (50,000+ RPM), with dynamic formatting that adapts to the magnitude of each result. The quick-reference section provides real-world benchmarks from clock hands to jet turbines for context.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        [`Mechanical engineering and motor specification`, `Engineers specifying motors, gearboxes, and rotating machinery must convert between RPM (the standard motor rating), rad/s (used in torque and power calculations), and Hz (used in vibration analysis). A motor rated at 3,600 RPM operates at 60 Hz and 377 rad/s. When calculating angular momentum (L = Iω), the angular velocity must be in rad/s — using RPM directly produces incorrect results. This tool provides instant conversion between all commonly used units.`],
        [`Astronomical observation and telescope tracking`, `Astronomers measure celestial object rotations and telescope tracking rates in arcseconds per second or degrees per hour. Earth rotates at approximately 15°/hr (360° in 24 hours), which equals 0.004167°/s or 7.27 × 10⁻⁵ rad/s. Telescope mounts must track at precisely this rate to compensate for Earth's rotation. Converting between arcsec/s (observation) and rad/s (mount motor control) is essential for accurate celestial tracking.`],
        [`Physics education and rotational dynamics`, `Students learning rotational mechanics need to convert between angular velocity units to apply formulas correctly. The relationship v = rω (linear velocity equals radius times angular velocity) requires ω in rad/s. A flywheel spinning at 600 RPM has an angular velocity of 62.83 rad/s. Converting to Hz gives 10 Hz, meaning it completes 10 full revolutions per second. The live rotating diagram helps students visualise these relationships.`]
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      All conversions use radians per second (rad/s) as the universal base unit. Each supported angular velocity unit is defined by a fixed conversion factor relative to one rad/s. To convert from unit A to unit B, the tool multiplies the input value by A's factor to obtain rad/s, then divides by B's factor to obtain the target value. This hub-and-spoke model guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">rads</code>, <code class="inline-code">rpm</code>, <code class="inline-code">hz</code>) to its conversion factor relative to rad/s. The radian is the natural angular unit, so its factor is exactly 1. Degree-based units use <code class="inline-code">π/180</code> per degree. Revolution-based units use <code class="inline-code">2π</code> per revolution.
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion to rad/s:</strong> The input value is multiplied by the source unit's factor. For example, converting 60 RPM to rad/s: <code class="inline-code">60 × (2π/60) = 2π ≈ 6.2832 rad/s</code>. Converting 360°/s: <code class="inline-code">360 × (π/180) = 2π ≈ 6.2832 rad/s</code>. The key relationship is that 1 revolution = 2π radians = 360° = 1 Hz × 2π.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion from rad/s:</strong> The rad/s value is divided by the target unit's factor. Converting 2π rad/s to Hz: <code class="inline-code">2π / (2π) = 1 Hz</code>. Converting to arcsec/s: <code class="inline-code">2π / (π/648000) = 1,296,000 arcsec/s</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>.
    </p>
    <p class="seo-p-sm">
      <strong>4. Live SVG animation:</strong> The rotating diagram uses <code class="inline-code">requestAnimationFrame</code> to update the arm position at the display refresh rate. The angular increment per frame is calculated as <code class="inline-code">ω × dt</code>, where <code class="inline-code">dt</code> is the time delta between frames in seconds. The arm length is 75 SVG units from the centre, and the arc path is computed using standard parametric circle equations.
    </p>
    <p class="seo-p-none">
      <strong>Exact conversion factors:</strong> All factors are derived from exact mathematical definitions: <code class="inline-code">1 revolution = 2π radians = 360°</code>. The radian factor is exactly 1. The degree factor is exactly <code class="inline-code">π/180</code>. The RPM factor is exactly <code class="inline-code">2π/60 = π/30</code>. The Hz factor is exactly <code class="inline-code">2π</code>. The arcsecond factor is exactly <code class="inline-code">π/648000</code> (since 1 arcsecond = 1/3600 of a degree, and 1 degree = π/180 radians). These are irrational values (involving π), so the JavaScript factors are IEEE 754 double-precision approximations providing approximately 15 to 17 significant decimal digits of precision.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is angular velocity?",
          a: "Angular velocity is the rate of change of angular position — how fast something rotates around an axis. It is measured as the angle swept per unit time. Common units include radians per second (rad/s) for physics calculations, revolutions per minute (RPM) for motor ratings, and hertz (Hz) for frequency of rotation. Angular velocity is a vector quantity; its magnitude is the angular speed, and its direction follows the right-hand rule."
        },
        {
          q: "What is the difference between RPM and Hz?",
          a: "RPM (revolutions per minute) counts full rotations per minute. Hz (hertz) counts full rotations per second. The conversion is straightforward: 1 Hz = 60 RPM, so divide RPM by 60 to get Hz. A washing machine spin cycle at 1200 RPM equals 20 Hz. A 60 Hz AC power supply rotates at 3600 RPM. In physics formulas, always convert to rad/s first."
        },
        {
          q: "How many radians are in a revolution?",
          a: "One full revolution equals exactly 2π radians (approximately 6.28319 rad). This is because the circumference of a circle is 2πr, and the angle swept when traveling the full circumference divided by the radius equals 2π. This relationship is the foundation of radian measure and is used in virtually all rotational physics formulas."
        },
        {
          q: "What is a radian?",
          a: "A radian is the angle subtended at the centre of a circle by an arc whose length equals the radius. One full circle equals 2π radians. Radians are dimensionless (the radius cancels out) and are the standard angular unit in mathematics and physics because they simplify derivatives and integrals of trigonometric functions. For example, d/dx sin(x) = cos(x) only when x is in radians."
        },
        {
          q: "What is the angular velocity of a clock's hour hand?",
          a: "The hour hand completes one full revolution (2π radians) in 12 hours = 43,200 seconds. Its angular velocity is 2π/43200 ≈ 0.0001454 rad/s, or about 0.00833 RPM. The minute hand is 12× faster at approximately 0.1 RPM (0.01745 rad/s). The second hand rotates at exactly 1 RPM (0.1047 rad/s)."
        },
        {
          q: "Why is rad/s preferred over RPM in physics?",
          a: "The radian is a dimensionless unit that directly relates arc length to radius (s = rθ). This makes rad/s the natural unit for rotational kinematics and dynamics. Formulas like torque (τ = Iα), angular momentum (L = Iω), and rotational kinetic energy (KE = ½Iω²) all require ω in rad/s. Using RPM in these formulas produces incorrect results and requires additional conversion factors."
        },
        {
          q: "What is the relationship between angular velocity and linear velocity?",
          a: "Linear velocity equals radius times angular velocity: v = rω, where ω must be in rad/s. For a point on the rim of a disk with radius 0.5 m spinning at 600 RPM (62.83 rad/s), the linear velocity is 0.5 × 62.83 = 31.42 m/s (approximately 113 km/h). This relationship connects rotational and translational motion and is fundamental in mechanical engineering."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to rad/s ─────────────────────────────────
  const TO_RADS = {
    rads: 1,
    degs: Math.PI / 180,
    rpm:  (2 * Math.PI) / 60,
    rps:  2 * Math.PI,
    hz:   2 * Math.PI,
    degm: Math.PI / 10800,
    degh: Math.PI / 648000,
    as:   Math.PI / 648000,
  };

  const UNITS = [
    { id: 'rads', label: 'rad/s',   name: 'Radian per Second' },
    { id: 'degs', label: '°/s',      name: 'Degree per Second' },
    { id: 'rpm',  label: 'RPM',      name: 'Revolutions per Minute' },
    { id: 'rps',  label: 'rev/s',    name: 'Revolutions per Second' },
    { id: 'hz',   label: 'Hz',       name: 'Hertz' },
    { id: 'degm', label: '°/min',    name: 'Degree per Minute' },
    { id: 'degh', label: '°/hr',     name: 'Degree per Hour' },
    { id: 'as',   label: '″/s',      name: 'Arcsecond per Second' },
  ];

  const REFS = [
    { name: 'Clock Hour Hand',         rads: 0.0001454 },
    { name: 'Clock Minute Hand',       rads: 0.001745 },
    { name: 'Clock Second Hand',       rads: 0.1047 },
    { name: 'Vinyl Record (33⅓ RPM)', rads: 3.4907 },
    { name: 'Washing Machine',         rads: 125.66 },
    { name: 'Car Engine (3000 RPM)',   rads: 314.16 },
    { name: 'Jet Turbine',             rads: 4188.79 },
    { name: 'Centrifuge (50,000 RPM)', rads: 5235.99 },
  ];

  const input    = document.getElementById('ang-input') as HTMLInputElement;
  const select   = document.getElementById('ang-unit') as HTMLSelectElement;
  const grid     = document.getElementById('results')!;
  const refsDiv  = document.getElementById('refs')!;
  const angArm   = document.getElementById('ang-arm')!;
  const angTip   = document.getElementById('ang-tip')!;
  const angArc   = document.getElementById('ang-arc')!;
  const angDisp  = document.getElementById('ang-display')!;
  const angRads  = document.getElementById('ang-rads')!;
  const angDegs  = document.getElementById('ang-degs')!;

  let currentAngle = 0;
  let animId: number | null = null;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e12) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    return value.toExponential(4);
  }

  function svgArc(angle: number): string {
    const r = 55;
    const cx = 100, cy = 100;
    const a = Math.min(angle, 2 * Math.PI);
    const x = cx + r * Math.sin(a);
    const y = cy - r * Math.cos(a);
    const large = a > Math.PI ? 1 : 0;
    return `M ${cx} ${cy - r} A ${r} ${r} 0 ${large} 1 ${x} ${y}`;
  }

  function animate(speed: number) {
    if (animId) cancelAnimationFrame(animId);
    const rpmSpeed = speed / (2 * Math.PI) * 60;
    const degPerFrame = rpmSpeed * 360 / 60;

    let last = performance.now();
    function tick(now: number) {
      const dt = (now - last) / 1000;
      last = now;
      currentAngle += speed * dt;
      currentAngle %= 2 * Math.PI;

      const cx = 100, cy = 100, armLen = 75;
      const tipX = cx + armLen * Math.sin(currentAngle);
      const tipY = cy - armLen * Math.cos(currentAngle);

      angArm.setAttribute('x2', String(tipX));
      angArm.setAttribute('y2', String(tipY));
      angTip.setAttribute('cx', String(tipX));
      angTip.setAttribute('cy', String(tipY));

      if (currentAngle > 0.01) {
        angArc.setAttribute('d', svgArc(currentAngle));
      } else {
        angArc.setAttribute('d', '');
      }

      animId = requestAnimationFrame(tick);
    }
    animId = requestAnimationFrame(tick);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const radsVal  = val * TO_RADS[fromUnit];

    // Summary
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    angDisp.textContent = `${fmt(val)} ${unitLabel}`;
    angRads.textContent = fmt(radsVal);
    angDegs.textContent = fmt(radsVal * 180 / Math.PI);

    // Animate
    animate(Math.min(Math.abs(radsVal), 200));

    // Results grid
    grid.innerHTML = '';
    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = radsVal / TO_RADS[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // Quick references
    refsDiv.innerHTML = '';
    REFS.forEach(r => {
      const value = r.rads / TO_RADS[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refsDiv.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
