---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'angular-velocity-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Angular Velocity Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter an angular velocity and select its unit — all others update instantly with a live rotating diagram.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.25rem;">
      <div>
        <label class="tool-label" for="ang-input">Angular Velocity</label>
        <input id="ang-input" type="number" value="60" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="ang-unit">Unit</label>
        <select id="ang-unit" class="select-themed" style="min-width:10rem;">
          <option value="rads" selected>Rad/s</option>
          <option value="degs">Deg/s</option>
          <option value="rpm">RPM</option>
          <option value="rps">Rev/s</option>
          <option value="hz">Hertz (Hz)</option>
          <option value="degm">Deg/min</option>
          <option value="degh">Deg/hr</option>
          <option value="as">Arcsec/s</option>
        </select>
      </div>
    </div>

    <!-- Live diagram -->
    <div style="display:flex;gap:1.5rem;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;">
      <svg id="ang-svg" viewBox="0 0 200 200" width="180" height="180" style="flex-shrink:0;">
        <defs>
          <marker id="arrowhead" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" fill="var(--color-brand-blue)" />
          </marker>
        </defs>
        <!-- Circle -->
        <circle cx="100" cy="100" r="85" fill="none" stroke="var(--border)" stroke-width="1.5" />
        <!-- Degree marks -->
        <line x1="100" y1="18" x2="100" y2="28" stroke="var(--text-muted)" stroke-width="1" />
        <line x1="182" y1="100" x2="172" y2="100" stroke="var(--text-muted)" stroke-width="1" />
        <line x1="100" y1="182" x2="100" y2="172" stroke="var(--text-muted)" stroke-width="1" />
        <line x1="18" y1="100" x2="28" y2="100" stroke="var(--text-muted)" stroke-width="1" />
        <!-- Angle arc -->
        <path id="ang-arc" fill="none" stroke="var(--color-brand-blue)" stroke-width="2.5" stroke-linecap="round" opacity="0.3" />
        <!-- Rotating arm -->
        <line id="ang-arm" x1="100" y1="100" x2="100" y2="25" stroke="var(--color-brand-blue)" stroke-width="3" stroke-linecap="round" />
        <!-- Tip dot -->
        <circle id="ang-tip" cx="100" cy="25" r="5" fill="var(--color-brand-blue)" />
        <!-- Center dot -->
        <circle cx="100" cy="100" r="4" fill="var(--text-secondary)" />
      </svg>
      <div style="min-width:0;">
        <p id="ang-display" style="font-size:1.8rem;font-weight:700;font-family:'Fira Code',monospace;color:var(--text-primary);margin-bottom:0.25rem;">60 RPM</p>
        <p class="seo-p-sm" style="margin-bottom:0;">= <span id="ang-rads">6.2832</span> rad/s</p>
        <p class="seo-p-sm">= <span id="ang-degs">360</span> °/s</p>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Convert Between RPM, Rad/s, and Hz</h2>
    <p class="seo-p">
      A motor spec sheet says 3,600 RPM. Your physics formula needs rad/s. Type 3600, select RPM, and see that it equals 376.99 rad/s, 60 Hz, and 21,600 degrees per second. The live rotating diagram speeds up or slows down to match your input, giving you visual confirmation that the number makes sense.
    </p>
    <p class="seo-p">
      The converter handles 8 units: rad/s, degrees/s, RPM, rev/s, Hz, degrees/min, degrees/hr, and arcsec/s. An astronomy student calculating Earth's rotation rate enters 15 degrees/hr and sees it equals 0.004167 deg/s, 7.27e-5 rad/s, or 0.000417 RPM. A vibration engineer measuring 120 Hz on a motor sees it equals 7,200 RPM and 753.98 rad/s. The quick-reference row shows clock hands, vinyl records, washing machines, and jet turbines for context.
    </p>

    <h3 class="font-display seo-h3-sm">Why the wrong unit gives wrong answers in formulas</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Angular momentum requires rad/s', 'The formula L = Iω (angular momentum = moment of inertia x angular velocity) only works when ω is in rad/s. A flywheel with I = 2 kg*m² spinning at 600 RPM does NOT have L = 2 x 600 = 1200. You must convert first: 600 RPM = 62.83 rad/s. Then L = 2 x 62.83 = 125.66 kg*m²/s. Using RPM directly gives an answer that is 9.55x too large.'],
        ['Vibration analysis uses Hz, not RPM', 'A motor vibrates at 120 Hz. To convert to RPM: multiply by 60 = 7,200 RPM. To convert to rad/s: multiply by 2π = 753.98 rad/s. If you use 120 in a formula that expects rad/s, you are off by a factor of 6.28. If you use 7,200 in a formula that expects Hz, you are off by a factor of 60.'],
        ['Telescope tracking needs arcsec/s precision', 'Earth rotates at 15 degrees per hour. In arcsec/s: 15 x 3600 / 3600 = 15 arcsec/s. A telescope mount must track at exactly this rate. If you program the mount motor using degrees/hr (15) instead of arcsec/s (15), the units are numerically equal but the conversion factor is wrong if you mix them. The converter eliminates this ambiguity.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Angular Velocity Converter Handles RPM, Rad/s, and Hz</h2>
    <p class="seo-p">
      All conversions pass through radians per second (rad/s). When you enter 60 RPM, the tool multiplies by (2π)/60 = π/30 = 0.10472 to get 6.2832 rad/s. Then it divides by each target unit's factor: by 1 for rad/s, by π/180 for degrees/s, by 2π for Hz, by 1/60 for rev/s. The result: 60 RPM = 6.2832 rad/s = 360 deg/s = 1 Hz = 1 rev/s.
    </p>

    <h3 class="font-display seo-h3-sm">Conversion factors derived from one revolution = 2π radians</h3>
    <p class="seo-p-sm">
      The fundamental relationship is: 1 revolution = 2π radians = 360 degrees = 1 Hz (if per second). From this: rad/s to RPM multiply by 60/(2π) = 9.5493. RPM to Hz divide by 60. Degrees/s to rad/s multiply by π/180 = 0.01745. Arcsec/s to rad/s multiply by π/648,000 = 4.8481e-6. All factors are irrational (involving π), so they are stored as IEEE 754 double-precision approximations with 15-17 significant digits.
    </p>

    <h3 class="font-display seo-h3-sm">The live SVG animation and its timing</h3>
    <p class="seo-p-sm">
      The rotating arm uses requestAnimationFrame to update at 60 fps. Each frame calculates the time delta dt in seconds, then adds ω × dt to the current angle. The arm tip coordinates are computed using standard parametric circle equations: x = cx + r × sin(θ), y = cy - r × cos(θ). The animation speed is capped at 200 rad/s to prevent the arm from spinning too fast to see. The arc path shows the swept angle as a blue curve.
    </p>
    <p class="seo-p-none">
      The converter handles the full range from arcsec/s (for astronomical tracking) to 50,000+ RPM (for centrifuges). Very small values use scientific notation (e.g., 7.27e-5 rad/s for Earth's rotation). Very large values use locale-formatted numbers. The dynamic formatting ensures readability whether you are working with clock hands (0.0001454 rad/s) or jet turbines (4,188.79 rad/s).
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How do I convert 3000 RPM to rad/s?",
          a: "Multiply by π/30: 3000 x π/30 = 314.16 rad/s. Or divide by 9.5493: 3000 / 9.5493 = 314.16 rad/s. In Hz: 3000 / 60 = 50 Hz. This is a typical car engine speed. At 50 Hz, the engine completes 50 full revolutions per second, with each cylinder firing every other revolution."
        },
        {
          q: "What is the angular velocity of a clock's second hand?",
          a: "The second hand completes one revolution (2π radians) in 60 seconds. So its angular velocity is 2π/60 = 0.1047 rad/s = 1 RPM = 0.0167 Hz. The minute hand is 60x slower: 0.001745 rad/s = 1/60 RPM. The hour hand is 12x slower than the minute hand: 0.0001454 rad/s = 1/720 RPM."
        },
        {
          q: "Why must physics formulas use rad/s instead of RPM?",
          a: "Radian is a dimensionless ratio (arc length / radius). This makes rad/s compatible with formulas like torque (τ = Iα), angular momentum (L = Iω), and power (P = τω). If you use RPM directly, you get wrong answers. For example: P = τ × ω. If τ = 10 N*m and ω = 100 RPM, you cannot just multiply. Convert first: 100 RPM = 10.47 rad/s. Then P = 10 x 10.47 = 104.7 W."
        },
        {
          q: "What is the relationship between Hz and RPM?",
          a: "1 Hz = 60 RPM. So divide RPM by 60 to get Hz. A 60 Hz motor spins at 3600 RPM. A 50 Hz motor spins at 3000 RPM. A washing machine at 1200 RPM = 20 Hz. A centrifuge at 50,000 RPM = 833.3 Hz. In the US, mains electricity is 60 Hz = 3600 RPM. In Europe, it is 50 Hz = 3000 RPM."
        },
        {
          q: "How do I calculate linear velocity from angular velocity?",
          a: "Use v = rω, where ω is in rad/s. A point on the rim of a 0.5 m radius disk spinning at 600 RPM has: ω = 62.83 rad/s, v = 0.5 x 62.83 = 31.42 m/s = 113 km/h. For a car wheel with 0.35 m radius at 60 km/h: v = 16.67 m/s, so ω = v/r = 16.67 / 0.35 = 47.62 rad/s = 454.8 RPM."
        },
        {
          q: "What is Earth's rotation rate in different units?",
          a: "Earth rotates 360 degrees in 24 hours = 15 deg/hr = 0.004167 deg/s = 7.27e-5 rad/s = 0.000417 RPM = 1.157e-5 Hz. In arcsec/s: 15 arcsec/s (since 15 deg/hr = 15 x 3600 arcsec / 3600 sec = 15 arcsec/s). Telescope mounts must track at exactly this rate to compensate for Earth's rotation."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to rad/s ─────────────────────────────────
  const TO_RADS = {
    rads: 1,
    degs: Math.PI / 180,
    rpm:  (2 * Math.PI) / 60,
    rps:  2 * Math.PI,
    hz:   2 * Math.PI,
    degm: Math.PI / 10800,
    degh: Math.PI / 648000,
    as:   Math.PI / 648000,
  };

  const UNITS = [
    { id: 'rads', label: 'rad/s',   name: 'Radian per Second' },
    { id: 'degs', label: '°/s',      name: 'Degree per Second' },
    { id: 'rpm',  label: 'RPM',      name: 'Revolutions per Minute' },
    { id: 'rps',  label: 'rev/s',    name: 'Revolutions per Second' },
    { id: 'hz',   label: 'Hz',       name: 'Hertz' },
    { id: 'degm', label: '°/min',    name: 'Degree per Minute' },
    { id: 'degh', label: '°/hr',     name: 'Degree per Hour' },
    { id: 'as',   label: '″/s',      name: 'Arcsecond per Second' },
  ];

  const REFS = [
    { name: 'Clock Hour Hand',         rads: 0.0001454 },
    { name: 'Clock Minute Hand',       rads: 0.001745 },
    { name: 'Clock Second Hand',       rads: 0.1047 },
    { name: 'Vinyl Record (33⅓ RPM)', rads: 3.4907 },
    { name: 'Washing Machine',         rads: 125.66 },
    { name: 'Car Engine (3000 RPM)',   rads: 314.16 },
    { name: 'Jet Turbine',             rads: 4188.79 },
    { name: 'Centrifuge (50,000 RPM)', rads: 5235.99 },
  ];

  const input    = document.getElementById('ang-input') as HTMLInputElement;
  const select   = document.getElementById('ang-unit') as HTMLSelectElement;
  const grid     = document.getElementById('results')!;
  const refsDiv  = document.getElementById('refs')!;
  const angArm   = document.getElementById('ang-arm')!;
  const angTip   = document.getElementById('ang-tip')!;
  const angArc   = document.getElementById('ang-arc')!;
  const angDisp  = document.getElementById('ang-display')!;
  const angRads  = document.getElementById('ang-rads')!;
  const angDegs  = document.getElementById('ang-degs')!;

  let currentAngle = 0;
  let animId: number | null = null;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e12) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    return value.toExponential(4);
  }

  function svgArc(angle: number): string {
    const r = 55;
    const cx = 100, cy = 100;
    const a = Math.min(angle, 2 * Math.PI);
    const x = cx + r * Math.sin(a);
    const y = cy - r * Math.cos(a);
    const large = a > Math.PI ? 1 : 0;
    return `M ${cx} ${cy - r} A ${r} ${r} 0 ${large} 1 ${x} ${y}`;
  }

  function animate(speed: number) {
    if (animId) cancelAnimationFrame(animId);
    const rpmSpeed = speed / (2 * Math.PI) * 60;
    const degPerFrame = rpmSpeed * 360 / 60;

    let last = performance.now();
    function tick(now: number) {
      const dt = (now - last) / 1000;
      last = now;
      currentAngle += speed * dt;
      currentAngle %= 2 * Math.PI;

      const cx = 100, cy = 100, armLen = 75;
      const tipX = cx + armLen * Math.sin(currentAngle);
      const tipY = cy - armLen * Math.cos(currentAngle);

      angArm.setAttribute('x2', String(tipX));
      angArm.setAttribute('y2', String(tipY));
      angTip.setAttribute('cx', String(tipX));
      angTip.setAttribute('cy', String(tipY));

      if (currentAngle > 0.01) {
        angArc.setAttribute('d', svgArc(currentAngle));
      } else {
        angArc.setAttribute('d', '');
      }

      animId = requestAnimationFrame(tick);
    }
    animId = requestAnimationFrame(tick);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const radsVal  = val * TO_RADS[fromUnit];

    // Summary
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    angDisp.textContent = `${fmt(val)} ${unitLabel}`;
    angRads.textContent = fmt(radsVal);
    angDegs.textContent = fmt(radsVal * 180 / Math.PI);

    // Animate
    animate(Math.min(Math.abs(radsVal), 200));

    // Results grid
    grid.innerHTML = '';
    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = radsVal / TO_RADS[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // Quick references
    refsDiv.innerHTML = '';
    REFS.forEach(r => {
      const value = r.rads / TO_RADS[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refsDiv.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
