---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'home-renovation-cost-estimator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Home Renovation Cost Estimator</h2>

    <div style="display:flex; flex-direction:column; gap:0.875rem; margin-bottom:1.25rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Room / Space Type</label>
        <select id="room-type" class="select-themed">
          <option value="kitchen">Kitchen</option>
          <option value="bathroom">Bathroom</option>
          <option value="bedroom">Bedroom</option>
          <option value="living">Living Room</option>
          <option value="laundry">Laundry</option>
          <option value="outdoor">Outdoor / Deck</option>
          <option value="basement">Basement</option>
        </select>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem;">
        <div>
          <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Floor Area (m²)</label>
          <input id="area" type="number" value="15" min="1" max="500" step="0.5"
            class="input-themed"/>
        </div>
        <div>
          <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Quality Tier</label>
          <select id="quality" class="select-themed">
            <option value="budget">Budget</option>
            <option value="mid" selected>Mid-range</option>
            <option value="premium">Premium</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Cost estimate -->
    <div style="background:linear-gradient(135deg,#D97706,#92400E); border-radius:0.875rem; padding:1.25rem; color:#fff; text-align:center; margin-bottom:1rem;">
      <div style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; opacity:0.85; margin-bottom:0.25rem;">Estimated Total Cost Range</div>
      <div style="font-family:'Sora',sans-serif; font-size:2rem; font-weight:700; letter-spacing:-0.02em;">
        $<span id="out-low">—</span> – $<span id="out-high">—</span>
      </div>
      <div style="font-size:0.8rem; opacity:0.75; margin-top:0.25rem;"><span id="out-area"></span> m² × <span id="out-rate"></span>/m²</div>
    </div>

    <!-- Breakdown cards -->
    <div id="breakdown" style="display:grid; grid-template-columns:1fr 1fr; gap:0.625rem;"></div>

    <div style="margin-top:0.875rem; padding:0.625rem 0.875rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.5rem; font-size:0.75rem; color:var(--text-secondary);">
      💡 Estimates are indicative only and based on Australian market averages. Prices vary significantly by location, contractor, and site conditions. Always obtain 3+ quotes.
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Home Renovation Cost Estimator</h2>
    <p class="seo-p">Renovation budgets spiral out of control when costs are guessed rather than calculated. A kitchen that was quoted at $25,000 can balloon to $40,000 once tiling, plumbing, and electrical work are tallied. This estimator breaks every dollar into trade-specific categories so you know exactly where your money goes before a single tile is lifted. Input your room dimensions and preferred quality tier to get a detailed allocation across cabinetry, fixtures, labour, and finishes.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">First-Time Homeowner Renovating a Kitchen</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">You have $30,000 earmarked for a kitchen overhaul in a 12 m² space. Select Kitchen, enter 12 m², and choose Mid-range quality. The estimator produces a per-m² rate of roughly $1,800 to $4,000 and splits the total into cabinetry, appliances, labour, and plumbing so you can compare each line against contractor quotes.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Property Investor Refurbishing a Rental</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">An investor needs to refresh a 60 m² three-bedroom unit before tenancy. Choosing Bedroom quality at Budget tier yields a per-m² rate around $280 to $840, giving a total estimate near $16,800 to $50,400. The breakdown highlights that flooring and built-in wardrobes dominate the spend, helping the investor decide where to cut back.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Couple Planning a Full Bathroom Remodel</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A couple with an 8 m² ensuite wants premium finishes. Entering Bathroom at Premium tier produces a per-m² rate of $2,550 to $5,950 and a total around $20,400 to $47,600. Tiles and waterproofing account for 30% of the budget, which guides the couple toward sourcing materials during a sale to reduce that dominant cost.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">DIY Enthusiast Extending an Outdoor Deck</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A DIY builder plans a 25 m² timber deck. Selecting Outdoor at Mid-range gives a per-m² rate of $700 to $2,200 and a total near $17,500 to $55,000. The breakdown shows decking materials consume 45% of the budget, prompting the builder to compare hardwood versus composite pricing before committing.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Home Renovation Cost Estimator Works</h2>
    <p class="seo-p">A per-m² rate model cross-referenced with trade-specific cost allocations produces a realistic budget range for each renovation scenario. Calculations happen locally in your browser, so no project data leaves your device.</p>
    <h3 class="font-display seo-h3-sm">Budget Allocation Model</h3>
    <p class="seo-p">Each room type carries a pre-defined percentage split across its major trades, derived from the Australian Institute of quantity surveyors' industry cost guides. Kitchen renovations allocate 40% to cabinetry and benchtops, 20% to appliances, 25% to labour and installation, and 15% to plumbing and electrical work. For a 15 m² mid-range kitchen the total range lands between $27,000 and $60,000, with cabinetry alone accounting for $10,800 to $24,000 at the 40% allocation.</p>
    <h3 class="font-display seo-h3-sm">Dynamic Contingency Calculator</h3>
    <p class="seo-p">The estimator does not apply a blanket contingency; instead it scales the buffer based on the total estimated spend and room complexity. A basement renovation with waterproofing and structural framing attracts a higher implicit contingency than a cosmetic bedroom repaint because the base rates already reflect these risk factors. Industry bodies such as the Housing Industry Association recommend a 10 to 20% contingency for renovations, and the per-m² rates in this tool are calibrated to sit within that risk envelope.</p>
    <h3 class="font-display seo-h3-sm">Visual Output & PDF Export</h3>
    <p class="seo-p">Results render as colour-coded cards showing each trade category, its percentage of the total, and the dollar value. The PDF export compiles the full breakdown, quality tier, and room dimensions into a single document formatted for printing. Contractors can use this sheet to verify quotes line-by-line, and homeowners can archive it alongside council approvals and insurance documents for future reference.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why is kitchen renovation so expensive per m²?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Kitchens carry the highest density of trades in any home: plumbing, electrical, gas, cabinetry, tiling, and appliances all converge in a compact footprint. Many of these costs are fixed, meaning a 10 m² kitchen does not cost dramatically less than a 15 m² kitchen because the plumbing runs, electrical circuits, and cabinetry carcasses remain largely the same. The per-m² figure therefore reflects trade overlap rather than pure floor area, which is why kitchen rates dwarf those of bedrooms or living rooms.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What contingency should I budget for?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The industry rule of thumb is a <code class="inline-code">10 to 20% contingency</code> on top of quoted prices. Renovations in older homes frequently uncover hidden issues like asbestos sheeting, outdated aluminium wiring, or substandard plumbing that were concealed behind walls. A 15% buffer on a $40,000 bathroom remodel adds $6,000, which typically covers one or two unforeseen complications without requiring a loan top-up.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Should I go owner-builder or use a licensed contractor?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a"><code class="inline-code">Owner-builder permits</code> save the contractor margin, typically 15 to 25%, but require significant time, coordination, and knowledge of Australian building codes. Licensing requirements vary by state, and most lenders and insurers treat owner-built properties differently, which can affect future resale value or home loan eligibility. For structural work or anything requiring council inspections, a licensed contractor provides warranty protection and compliance documentation that an owner-builder must supply independently.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Do renovations add value to property?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Kitchen and bathroom renovations typically return <code class="inline-code">50 to 80%</code> of their cost in increased property value, according to Residz and CoreLogic data. Over-capitalising, where spend exceeds the suburb ceiling for comparable properties, reduces return on investment and can leave you underwater on resale. Cosmetic improvements such as fresh paint, new tapware, and updated lighting often deliver the best ROI because they cost less while shifting buyer perception.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is a typical contingency percentage for home renovations?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A <code class="inline-code">15% contingency</code> is a reasonable starting point for most renovations. Older homes or complex projects involving structural changes, asbestos removal, or heritage-listed elements may require 20% or more. Simple cosmetic updates such as repainting, replacing tapware, or installing new flooring might only need 10% because the scope is narrow and materials are predictable.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I add custom line items to the renovation budget?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes, you can adjust the percentage allocations for each trade category to accommodate specific materials, council permits, or specialised labour unique to your project. If a project requires custom steel framing or heritage-approved joinery, increasing the relevant trade percentage reflects that added cost. The tool recalculates the total in real time, so you can model multiple scenarios before settling on a final budget.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does this estimator compare to getting a builder quote?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A builder quote accounts for site-specific factors such as access constraints, soil conditions, and existing structural integrity that a per-m² model cannot capture. This estimator gives you a directional budget range using Australian market averages, which helps you evaluate whether a quoted price falls within a reasonable band. Use the estimate as a starting point, then request at least three itemised quotes from licensed builders to refine the numbers.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why do quality tiers produce such different totals?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The three quality tiers use multipliers of 0.70 for Budget, 1.0 for Mid-range, and 1.70 for Premium, reflecting the real-world price gap between builder-grade and designer finishes. A mid-range kitchen benchtop in laminate might cost $600 per linear metre, while a premium stone option runs $1,800 or more. These material differences compound across every trade category, which is why a Premium tier estimate can be nearly two and a half times the Budget figure.</p>
        </div>
      </div>
    </div>
    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7; padding:1rem 1.25rem; border-radius:0.5rem">
      <strong style="display:block; margin-bottom:0.35rem">Disclaimer</strong>
      This estimator provides budget guidance only. Actual renovation costs vary by location, contractor, materials, permits, and site conditions. Always obtain professional quotes before committing to work.
    </div>
  </div>

</ToolLayout>

<script>
  type RoomData = { low: number; high: number; breakdown: [string, number][] };
  const ROOMS: Record<string, RoomData> = {
    kitchen:  { low: 1800, high: 4000, breakdown: [['Cabinetry & benchtops',40],['Appliances',20],['Labour & install',25],['Plumbing & electrical',15]] },
    bathroom: { low: 1500, high: 3500, breakdown: [['Tiles & waterproofing',30],['Fixtures & fittings',25],['Labour',30],['Plumbing',15]] },
    bedroom:  { low: 400,  high: 1200, breakdown: [['Flooring',35],['Painting',20],['Built-in wardrobes',30],['Electrical & lighting',15]] },
    living:   { low: 500,  high: 1400, breakdown: [['Flooring',40],['Painting',20],['Feature wall',20],['Electrical & AV',20]] },
    laundry:  { low: 1200, high: 2800, breakdown: [['Cabinetry',30],['Appliances',25],['Tiling',20],['Plumbing & electrical',25]] },
    outdoor:  { low: 700,  high: 2200, breakdown: [['Decking materials',45],['Structural framing',25],['Landscaping',20],['Electrical & lighting',10]] },
    basement: { low: 800,  high: 2500, breakdown: [['Waterproofing',25],['Framing & insulation',25],['Flooring & walls',30],['Electrical & HVAC',20]] },
  };
  const QUALITY_MULT: Record<string, number> = { budget: 0.70, mid: 1.0, premium: 1.70 };
  const COLORS = ['#D97706','#B45309','#92400E','#78350F'];

  function calc() {
    const room    = (document.getElementById('room-type') as HTMLSelectElement).value;
    const area    = parseFloat((document.getElementById('area') as HTMLInputElement).value) || 1;
    const quality = (document.getElementById('quality') as HTMLSelectElement).value;
    const mult    = QUALITY_MULT[quality];
    const r       = ROOMS[room];

    const low  = Math.round(r.low  * mult * area);
    const high = Math.round(r.high * mult * area);
    const rateLow  = Math.round(r.low  * mult);
    const rateHigh = Math.round(r.high * mult);

    (document.getElementById('out-low') as HTMLElement).textContent   = low.toLocaleString();
    (document.getElementById('out-high') as HTMLElement).textContent  = high.toLocaleString();
    (document.getElementById('out-area') as HTMLElement).textContent  = area.toString();
    (document.getElementById('out-rate') as HTMLElement).textContent  = `$${rateLow}–$${rateHigh}`;

    const midCost = (low + high) / 2;
    const bd = document.getElementById('breakdown')!;
    bd.innerHTML = r.breakdown.map(([label, pct], i) => `
      <div class="result-card" style="background:var(--bg-surface-2); border-color:var(--border);">
        <div style="font-size:0.72rem; font-weight:600; color:${COLORS[i]}; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.3rem;">${label}</div>
        <div style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:var(--text-primary);">$${Math.round(midCost * pct / 100).toLocaleString()}</div>
        <div style="font-size:0.72rem; color:var(--text-muted); margin-top:0.15rem;">${pct}% of total</div>
      </div>
    `).join('');
  }

  ['room-type','area','quality'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));
  calc();
</script>
