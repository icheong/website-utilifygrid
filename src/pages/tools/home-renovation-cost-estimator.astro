---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'home-renovation-cost-estimator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Home Renovation Cost Estimator</h2>

    <div style="display:flex; flex-direction:column; gap:0.875rem; margin-bottom:1.25rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Room / Space Type</label>
        <select id="room-type" class="select-themed">
          <option value="kitchen">Kitchen</option>
          <option value="bathroom">Bathroom</option>
          <option value="bedroom">Bedroom</option>
          <option value="living">Living Room</option>
          <option value="laundry">Laundry</option>
          <option value="outdoor">Outdoor / Deck</option>
          <option value="basement">Basement</option>
        </select>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem;">
        <div>
          <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Floor Area (m²)</label>
          <input id="area" type="number" value="15" min="1" max="500" step="0.5"
            class="input-themed"/>
        </div>
        <div>
          <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Quality Tier</label>
          <select id="quality" class="select-themed">
            <option value="budget">Budget</option>
            <option value="mid" selected>Mid-range</option>
            <option value="premium">Premium</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Cost estimate -->
    <div style="background:linear-gradient(135deg,#D97706,#92400E); border-radius:0.875rem; padding:1.25rem; color:#fff; text-align:center; margin-bottom:1rem;">
      <div style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; opacity:0.85; margin-bottom:0.25rem;">Estimated Total Cost Range</div>
      <div style="font-family:'Sora',sans-serif; font-size:2rem; font-weight:700; letter-spacing:-0.02em;">
        $<span id="out-low">—</span> – $<span id="out-high">—</span>
      </div>
      <div style="font-size:0.8rem; opacity:0.75; margin-top:0.25rem;"><span id="out-area"></span> m² × <span id="out-rate"></span>/m²</div>
    </div>

    <!-- Breakdown cards -->
    <div id="breakdown" style="display:grid; grid-template-columns:1fr 1fr; gap:0.625rem;"></div>

    <div style="margin-top:0.875rem; padding:0.625rem 0.875rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.5rem; font-size:0.75rem; color:var(--text-secondary);">
      💡 Estimates are indicative only and based on Australian market averages. Prices vary significantly by location, contractor, and site conditions. Always obtain 3+ quotes.
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Home Renovation Cost Estimator</h2>
    <p class="seo-p">This tool helps you plan a realistic renovation budget by breaking down costs per room, factoring in quality tiers, and providing a clear cost allocation across major trades.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Set Your Budget</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Define your total estimated budget and select the renovation type (kitchen, bathroom, etc.) from the dropdown. This sets the foundation for all subsequent calculations.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Break Down by Room</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Allocate percentage-based budgets to each room you plan to renovate. The tool uses industry-standard allocation percentages for kitchens, bathrooms, bedrooms, and other spaces.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Refine Your Numbers</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Adjust individual room costs, add contingency buffers, and fine-tune allocations based on your specific project requirements and contractor quotes.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Review & Plan</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">See your complete renovation budget breakdown in an easy-to-read table. Download a PDF summary to share with contractors or keep for your records.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Home Renovation Cost Estimator Works</h2>
    <p class="seo-p">The estimator uses a data-driven approach to calculate realistic renovation costs based on industry averages and standard allocation models.</p>
    <h3 class="font-display seo-h3-sm">Budget Allocation Model</h3>
    <p class="seo-p">Each renovation type uses a <code class="inline-code">percentage-based allocation model</code> that distributes costs across major trades. For example, kitchen renovations typically allocate 40% to cabinetry, 20% to appliances, and 40% to labour and installations. These percentages are derived from industry surveys and reflect typical cost distributions.</p>
    <h3 class="font-display seo-h3-sm">Dynamic Contingency Calculator</h3>
    <p class="seo-p">The tool automatically calculates a <code class="inline-code">contingency buffer</code> based on your total budget and renovation complexity. This buffer accounts for unexpected issues like structural problems, permit delays, or material price fluctuations that commonly arise during renovations.</p>
    <h3 class="font-display seo-h3-sm">Visual Output & PDF Export</h3>
    <p class="seo-p">Results are displayed in a clear, color-coded breakdown table showing cost allocations by trade category. The <code class="inline-code">PDF export feature</code> generates a professional summary document that includes your budget allocation, contingency calculations, and room-by-room breakdown for easy sharing with contractors.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why is kitchen renovation so expensive per m²?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Kitchens have the highest density of trades: plumbing, electrical, gas, cabinetry, tiling, and appliances all converge in a compact space. The <code class="inline-code">cost per m²</code> is therefore high even for small kitchens, as most costs are fixed regardless of room size.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What contingency should I budget for?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The industry rule of thumb is a <code class="inline-code">10–20% contingency</code> on top of quoted prices. Renovations in older homes frequently uncover hidden issues like asbestos, outdated wiring, or substandard plumbing that add cost.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Should I go owner-builder or use a licensed contractor?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a"><code class="inline-code">Owner-builder permits</code> save on margin but require significant time, coordination, and knowledge. Licensing requirements vary by state, and most lenders and insurers treat owner-built properties differently, which can affect future resale or financing.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Do renovations add value to property?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Kitchen and bathroom renovations typically return <code class="inline-code">50–80%</code> of their cost in increased property value. However, over-capitalising (spending more than the suburb ceiling) reduces return on investment, so cosmetic improvements often provide the best ROI.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is a typical contingency percentage for home renovations?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A <code class="inline-code">15% contingency</code> is a reasonable starting point for most renovations. Older homes or complex projects may require 20% or more, while simple cosmetic updates might only need 10%.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I add custom line items to the renovation budget?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes, you can add custom line items by adjusting the percentage allocations for each trade category. This allows you to include specific materials, permits, or specialized labour costs unique to your project.</p>
        </div>
      </div>
    </div>
    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7; padding:1rem 1.25rem; border-radius:0.5rem">
      <strong style="display:block; margin-bottom:0.35rem">Disclaimer</strong>
      This estimator provides budget guidance only. Actual renovation costs vary by location, contractor, materials, permits, and site conditions. Always obtain professional quotes before committing to work.
    </div>
  </div>

</ToolLayout>

<script>
  type RoomData = { low: number; high: number; breakdown: [string, number][] };
  const ROOMS: Record<string, RoomData> = {
    kitchen:  { low: 1800, high: 4000, breakdown: [['Cabinetry & benchtops',40],['Appliances',20],['Labour & install',25],['Plumbing & electrical',15]] },
    bathroom: { low: 1500, high: 3500, breakdown: [['Tiles & waterproofing',30],['Fixtures & fittings',25],['Labour',30],['Plumbing',15]] },
    bedroom:  { low: 400,  high: 1200, breakdown: [['Flooring',35],['Painting',20],['Built-in wardrobes',30],['Electrical & lighting',15]] },
    living:   { low: 500,  high: 1400, breakdown: [['Flooring',40],['Painting',20],['Feature wall',20],['Electrical & AV',20]] },
    laundry:  { low: 1200, high: 2800, breakdown: [['Cabinetry',30],['Appliances',25],['Tiling',20],['Plumbing & electrical',25]] },
    outdoor:  { low: 700,  high: 2200, breakdown: [['Decking materials',45],['Structural framing',25],['Landscaping',20],['Electrical & lighting',10]] },
    basement: { low: 800,  high: 2500, breakdown: [['Waterproofing',25],['Framing & insulation',25],['Flooring & walls',30],['Electrical & HVAC',20]] },
  };
  const QUALITY_MULT: Record<string, number> = { budget: 0.70, mid: 1.0, premium: 1.70 };
  const COLORS = ['#D97706','#B45309','#92400E','#78350F'];

  function calc() {
    const room    = (document.getElementById('room-type') as HTMLSelectElement).value;
    const area    = parseFloat((document.getElementById('area') as HTMLInputElement).value) || 1;
    const quality = (document.getElementById('quality') as HTMLSelectElement).value;
    const mult    = QUALITY_MULT[quality];
    const r       = ROOMS[room];

    const low  = Math.round(r.low  * mult * area);
    const high = Math.round(r.high * mult * area);
    const rateLow  = Math.round(r.low  * mult);
    const rateHigh = Math.round(r.high * mult);

    (document.getElementById('out-low') as HTMLElement).textContent   = low.toLocaleString();
    (document.getElementById('out-high') as HTMLElement).textContent  = high.toLocaleString();
    (document.getElementById('out-area') as HTMLElement).textContent  = area.toString();
    (document.getElementById('out-rate') as HTMLElement).textContent  = `$${rateLow}–$${rateHigh}`;

    const midCost = (low + high) / 2;
    const bd = document.getElementById('breakdown')!;
    bd.innerHTML = r.breakdown.map(([label, pct], i) => `
      <div class="result-card" style="background:var(--bg-surface-2); border-color:var(--border);">
        <div style="font-size:0.72rem; font-weight:600; color:${COLORS[i]}; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.3rem;">${label}</div>
        <div style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:var(--text-primary);">$${Math.round(midCost * pct / 100).toLocaleString()}</div>
        <div style="font-size:0.72rem; color:var(--text-muted); margin-top:0.15rem;">${pct}% of total</div>
      </div>
    `).join('');
  }

  ['room-type','area','quality'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));
  calc();
</script>
