---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'fuel-efficiency-volume-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Fuel Efficiency — Volume Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="kmL">Kilometer per Liter (km/L)</option>
          <option value="miL">Mile per Liter (mi/L)</option>
          <option value="miGalUS">Mile per US Gallon (mi/gal)</option>
          <option value="miGalUK">Mile per UK Gallon (mi/gal UK)</option>
          <option value="kmGalUS">Kilometer per US Gallon (km/gal)</option>
          <option value="kmGalUK">Kilometer per UK Gallon (km/gal UK)</option>
          <option value="L100km">Liter per 100 km (L/100km)</option>
          <option value="GalUS100mi">US Gallon per 100 Miles (gal/100mi)</option>
          <option value="GalUK100mi">UK Gallon per 100 Miles (gal/100mi UK)</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Fuel Efficiency - Volume Converter</h2>
    <p class="seo-p">You are comparing two cars — a European model rated at 5.8 L/100km and a Japanese import rated at 17.2 km/L. The numbers look completely different but they describe the same thing. Enter either value and this converter shows both cars in the same unit so you can compare them directly. Nine volume-based fuel economy units are supported, covering metric, US, and UK standards.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Car buyers comparing vehicles across regions</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A German sedan lists 6.2 L/100km on the window sticker. An American counterpart advertises 38 mpg US. Enter 6.2 in L/100km and the converter shows it equals 37.9 mpg US — nearly identical efficiency. The tool also shows 45.5 mpg UK, which explains why British car ads sometimes look more impressive than American ones.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Fleet managers standardising fuel reporting</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A logistics company operates vehicles across the US and Europe. US trucks report gallons per 100 miles while European trucks report L/100km. Enter 12 gal/100mi and the converter shows 20.1 L/100km, giving the fleet manager a single metric to compare fuel costs across both continents.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Mechanics diagnosing fuel consumption issues</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A customer complains their car used to achieve 9.5 km/L but now only manages 7.8 km/L. Enter both values to see the change in L/100km: from 10.5 to 12.8 L/100km. That is a 22 percent increase in consumption, which points to a tune-up issue rather than normal driving variation.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Importing a vehicle and need the correct fuel economy rating</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A UK-market car shows 52 mpg UK on the dashboard. The US Customs form requires mpg US. Enter 52 in mpg UK and the result shows 43.3 mpg US. The 20 percent difference comes from the imperial gallon being larger than the US gallon — 4.546 litres versus 3.785 litres.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Fuel Efficiency - Volume Converter Works</h2>
    <p class="seo-p">The converter normalises all inputs to kilometers per litre (km/L) as the common intermediate, then converts from km/L to each target unit. Inverted units like L/100km are handled with a reciprocal calculation.</p>
    <h3 class="font-display seo-h3-sm">Distance-Per-Volume Units</h3>
    <p class="seo-p">Kilometres per litre (km/L) is the base unit. Miles per litre (mi/L) equals 0.621371 km/L. Miles per US gallon (mpg US) equals 2.35215 km/L because one US gallon holds 3.785 litres. Miles per UK gallon (mpg UK) equals 2.82481 km/L because the imperial gallon holds 4.546 litres. Higher values always mean better efficiency — the vehicle travels farther on the same volume of fuel.</p>
    <h3 class="font-display seo-h3-sm">Volume-Per-Distance Units</h3>
    <p class="seo-p">Units like L/100km and gal/100mi are mathematical inverses. To convert from 7 L/100km to km/L, the tool computes 100 / 7 = 14.286 km/L. The converter stores an inverted flag for these units and applies the reciprocal automatically. For gal/100mi, the tool first converts to L/100km using the appropriate gallon-to-litre factor, then applies the reciprocal to get km/L.</p>
    <h3 class="font-display seo-h3-sm">US vs UK Gallon Difference</h3>
    <p class="seo-p">The US gallon is defined as 231 cubic inches (3.785 litres) while the imperial gallon is 4.546 litres — about 20 percent larger. This means 50 mpg UK is only about 41.6 mpg US for the same actual fuel consumption. The converter stores separate factors for each gallon variant so you get accurate results without manually adjusting for the 1.20095 ratio.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between mpg US and mpg UK?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A US gallon contains approximately 3.785 liters, while a UK imperial gallon contains approximately 4.546 liters. Because the imperial gallon is larger, the same vehicle will show a higher mpg UK number than mpg US for the same actual fuel consumption. UK mpg figures are roughly 20 percent higher than their US equivalent.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I compare L/100km with mpg?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">You cannot compare them directly because they measure opposite things — L/100km is a volume-per-distance metric where lower is better, while mpg is a distance-per-volume metric where higher is better. Use this converter to translate between them. For example, 7 L/100km equals about 33.6 mpg US or 40.4 mpg UK.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why is a lower L/100km value better?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">L/100km tells you how many liters of fuel the vehicle consumes to travel 100 kilometers. A car that uses 5 liters to cover 100 km is more efficient than one that uses 8 liters. Therefore, the lower the L/100km number, the less fuel the vehicle needs per unit of distance, which means better fuel economy.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Which fuel economy unit should I use?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Use the unit standard in your region. L/100km is the official metric in most of Europe, Asia, and Oceania. mpg US is the standard in the United States, while mpg UK is used in the United Kingdom. If you are comparing vehicles across regions, convert them all to the same unit using this tool for an accurate side-by-side comparison.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What are gal/100mi and how do they relate to L/100km?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">gal/100mi is the US or UK gallon equivalent of L/100km — it measures fuel consumed per fixed distance. Just as L/100km tells you liters used per 100 km, gal/100mi tells you gallons used per 100 miles. Both are volume-per-distance metrics where lower values indicate better fuel efficiency. This converter supports both US and UK gallon variants.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Are the conversions in this tool accurate?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. The tool uses standard conversion factors between gallons and liters and applies exact reciprocal math for inverted units. All calculations run in your browser with no rounding errors introduced by external APIs. The results are accurate to the precision of JavaScript floating-point arithmetic.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'kmL',        label: 'Kilometer per Liter (km/L)',           abbr: 'km/L',        factor: 1, inverted: false },
    { id: 'miL',        label: 'Mile per Liter (mi/L)',               abbr: 'mi/L',        factor: 0.621371, inverted: false },
    { id: 'miGalUS',    label: 'Mile per US Gallon (mi/gal)',         abbr: 'mi/gal',      factor: 2.35215, inverted: false },
    { id: 'miGalUK',    label: 'Mile per UK Gallon (mi/gal UK)',      abbr: 'mi/gal UK',   factor: 2.82481, inverted: false },
    { id: 'kmGalUS',    label: 'Kilometer per US Gallon (km/gal)',    abbr: 'km/gal',      factor: 0.264172, inverted: false },
    { id: 'kmGalUK',    label: 'Kilometer per UK Gallon (km/gal UK)', abbr: 'km/gal UK',   factor: 0.354006, inverted: false },
    { id: 'L100km',     label: 'Liter per 100 km (L/100km)',          abbr: 'L/100km',     factor: 1, inverted: true },
    { id: 'GalUS100mi', label: 'US Gallon per 100 Miles (gal/100mi)', abbr: 'gal/100mi',   factor: 1, inverted: true },
    { id: 'GalUK100mi', label: 'UK Gallon per 100 Miles (gal/100mi UK)', abbr: 'gal/100mi UK', factor: 1, inverted: true },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function convertFuelVol(val: number, fromId: string, toId: string): number {
    const from = UNITS.find(u => u.id === fromId)!;
    const to = UNITS.find(u => u.id === toId)!;
    let kmPerL: number;
    if (from.inverted) {
      kmPerL = 100 / val;
    } else {
      kmPerL = val * from.factor;
    }
    if (to.inverted) {
      return kmPerL === 0 ? 0 : 100 / kmPerL;
    } else {
      return kmPerL / to.factor;
    }
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = convertFuelVol(val, fromUnit, unit.id);
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
