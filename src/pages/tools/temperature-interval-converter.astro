---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'temperature-interval-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Temperature Interval Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="K">Kelvin (K)</option>
          <option value="C">Celsius Degree (°C)</option>
          <option value="F">Fahrenheit Degree (°F)</option>
          <option value="R">Rankine (°R)</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Temperature Interval Converter</h2>
    <p class="seo-p">This converter transforms temperature differences (deltas) between Celsius, Fahrenheit, Kelvin, and Rankine scales in real time.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Enter Temperature Difference</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Input the delta temperature value and select the source unit from the dropdown menu. The converter accepts any positive or negative number.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Select Target Unit</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Choose the temperature difference unit you want to convert from. Available options include Kelvin, Celsius degree, Fahrenheit degree, and Rankine.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">View All Results</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">See the delta value converted into every other temperature interval unit instantly. Results update as you type or change the source unit.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Copy Result</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Click any Copy button to copy that unit's converted value to your clipboard for easy pasting into documents, code, or messages.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Temperature Interval Converter Works</h2>
    <p class="seo-p">This tool converts between temperature differences (deltas) using direct linear scaling factors. Unlike absolute temperature conversions, no offset is involved because intervals measure the gap between two temperatures, not a specific point on a scale.</p>
    <h3 class="font-display seo-h3-sm">Temperature Interval vs Absolute Temperature</h3>
    <p class="seo-p">A temperature interval (or delta) represents the difference between two temperatures. For example, a rise from 20°C to 30°C is a delta of 10°C. Because the Celsius and Kelvin scales have identical degree sizes, a 1°C interval equals exactly 1 K. However, a 1°F interval equals only 5/9 K because the Fahrenheit degree is smaller. This is fundamentally different from converting absolute temperatures (e.g., 25°C to 77°F), which requires adding or subtracting offset constants like <code class="inline-code">+32</code> or <code class="inline-code">-273.15</code>.</p>
    <h3 class="font-display seo-h3-sm">Conversion Factors</h3>
    <p class="seo-p">All conversions route through Kelvin intervals as the reference unit. The exact ratios are: 1°C delta = 1 K, 1°F delta = 5/9 K, and 1°R delta = 5/9 K. The formula is <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>. For example, converting 10°F delta to Celsius: 10 × (5/9) ÷ 1 = 5.556°C delta. These are pure multiplicative ratios with no additive offset.</p>
    <h3 class="font-display seo-h3-sm">Common Use Cases</h3>
    <p class="seo-p">Temperature interval conversions are essential in <strong>HVAC engineering</strong> for calculating heating and cooling loads, in <strong>chemistry</strong> for expressing enthalpy changes and reaction temperature ranges, and in <strong>mechanical engineering</strong> for thermal expansion calculations. Meteorologists also use deltas when reporting daily temperature swings or climate anomalies across different measurement systems.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why is a 1°C temperature difference equal to 1 K?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The Celsius and Kelvin scales use the same degree size — they differ only in their zero points (0 K = -273.15°C). Because the spacing between degrees is identical, a change of 1°C is physically the same temperature change as 1 K. This equivalence does not hold for Fahrenheit, where 1°F delta equals 5/9 K.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do temperature differences differ from absolute temperature conversions?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Absolute temperature conversions (like 25°C to °F) use formulas with an offset constant (°F = °C × 9/5 + 32). Interval conversions use only multiplication by a ratio with no offset. A 10°C difference is 50°F difference, but 10°C as an absolute temperature is 50°F. This tool handles only the interval case.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What are temperature intervals used for in HVAC?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">HVAC engineers work with temperature differences constantly — calculating the delta between supply and return air, determining heating or cooling capacity in BTUs, and sizing equipment based on expected temperature swings. A cooling system that drops air by 10°C is removing the same heat whether you express that delta as 10 K, 18°F, or 18°R.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why does this converter include Rankine?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Rankine is the absolute scale based on Fahrenheit, used in some aerospace and thermodynamics contexts. A Rankine interval has the same size as a Fahrenheit interval (1°R delta = 1°F delta = 5/9 K). Including it makes the converter useful for engineers working across both metric and imperial absolute systems.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I use this converter for negative temperature differences?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. Negative values represent a temperature decrease rather than an increase. A delta of -5°C means the temperature dropped by 5 degrees Celsius. The conversion math is the same — just multiply by the ratio. A decrease of 5°C equals a decrease of 9°F or 5 K.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why can't I convert absolute temperatures with this tool?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Absolute temperature conversion requires offset formulas because the scales have different zero points. For example, 0°C = 32°F and 0 K = -459.67°F. This converter deliberately omits offsets to focus purely on interval math, which keeps the formulas simple and error-free for delta-based calculations in science and engineering.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'K', label: 'Kelvin (K)',            abbr: 'K',  factor: 1 },
    { id: 'C', label: 'Celsius Degree (°C)',   abbr: '°C', factor: 1 },
    { id: 'F', label: 'Fahrenheit Degree (°F)', abbr: '°F', factor: 0.55555556 },
    { id: 'R', label: 'Rankine (°R)',          abbr: '°R', factor: 0.55555556 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
