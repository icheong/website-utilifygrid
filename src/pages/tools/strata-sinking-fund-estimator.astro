---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'strata-sinking-fund-estimator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Strata Sinking Fund Estimator</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Number of Units</label>
        <input id="units" type="number" value="12" min="1" max="500" class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Current Fund Balance ($)</label>
        <input id="current-fund" type="number" value="80000" min="0" step="1000" class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Building Age (years)</label>
        <input id="building-age" type="number" value="10" min="0" max="100" class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Planning Horizon (years)</label>
        <input id="horizon" type="number" value="10" min="1" max="30" class="input-themed"/>
      </div>
    </div>

    <div id="assets-list" style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:0.875rem;"></div>
    <button id="add-asset" class="btn-secondary" style="width:100%; margin-bottom:1.25rem;">+ Add Asset</button>

    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.75rem; margin-bottom:1rem;">
      <div class="result-card" style="text-align:center;">
        <div id="out-required" style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary);">—</div>
        <div style="font-size:0.68rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.04em;">Required Fund</div>
      </div>
      <div class="result-card" style="text-align:center;">
        <div id="out-adequacy" style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary);">—%</div>
        <div style="font-size:0.68rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.04em;">Adequacy</div>
      </div>
      <div class="result-card" style="text-align:center;">
        <div id="out-levy" style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary);">—</div>
        <div style="font-size:0.68rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.04em;">Annual Levy/Unit</div>
      </div>
    </div>

    <div id="adequacy-bar-wrap" style="margin-bottom:0.5rem;">
      <div style="height:10px; background:var(--bg-surface-2); border-radius:999px; overflow:hidden;">
        <div id="adequacy-bar" style="height:100%; width:0%; background:var(--text-secondary); border-radius:999px; transition:width 0.4s ease, background 0.3s;"></div>
      </div>
    </div>
    <div id="adequacy-msg" style="font-size:0.78rem; color:var(--text-secondary); text-align:right;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Strata Sinking Fund Estimator</h2>
    <p class="seo-p">Plan your strata property's capital works fund by entering building details, asset lifespans, and replacement costs. The estimator calculates the total fund required and the annual per-unit contribution needed to keep the fund on track.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Set Building Details</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Enter the number of units in your scheme, the current sinking fund balance, and the building's age in years.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Define Asset Lifespan</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">For each common property asset such as the roof, paint, lift, or common areas, set the remaining useful life before replacement is needed.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Enter Cost Estimates</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Input the estimated replacement cost for each asset. These figures are typically sourced from a quantity surveyor or recent maintenance quotes.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Review Fund Plan</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">See the total required fund, your fund's adequacy percentage, and the annual levy per unit needed to meet future capital works obligations.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Strata Sinking Fund Estimator Works</h2>
    <p class="seo-p">The estimator uses an asset lifecycle model to determine how much each common property asset should contribute to the sinking fund over the chosen planning horizon.</p>
    <h3 class="font-display seo-h3-sm">Asset Lifecycle Model</h3>
    <p class="seo-p">Each asset is assigned a total <code class="inline-code">lifespan</code> in years. The tool calculates what portion of that lifespan falls within the planning horizon. For example, if a roof has a 30-year lifespan and the horizon is 10 years, one-third of the replacement cost is allocated to the fund. This remaining-life-based approach ensures contributions are spread evenly over the asset's useful life.</p>
    <h3 class="font-display seo-h3-sm">Per-Unit Contribution Calculation</h3>
    <p class="seo-p">The total required fund is the sum of all per-asset allocations. The tool then subtracts the <code class="inline-code">current fund balance</code> to find any shortfall. This shortfall is divided evenly across the planning horizon and the number of units, giving the <code class="inline-code">annual levy per unit</code> required to fully fund all anticipated capital works.</p>
    <h3 class="font-display seo-h3-sm">Escalation and Inflation Adjustment</h3>
    <p class="seo-p">Cost estimates entered in the tool represent today's dollars. Real-world sinking funds should factor in <code class="inline-code">cost escalation</code> for construction and materials inflation, which typically runs above general CPI. Adjust your replacement cost estimates upward to account for expected price growth over the planning horizon.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is a sinking fund?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A sinking fund, also known as a capital works fund, is money collected from owners in advance to pay for major repairs and replacements of common property assets such as roofs, lifts, pools, and driveways. It is separate from the administrative fund, which covers day-to-day running costs like insurance and cleaning.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What happens if the sinking fund is inadequate?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">When the sinking fund does not have enough to cover upcoming capital works, the owners corporation must raise a special levy. These one-off charges can be thousands of dollars per unit, are a frequent source of strata disputes, and can negatively affect property values and saleability.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Is there a legal minimum for sinking funds?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Australian strata legislation requires that contributions be sufficient to fund anticipated capital works. NSW requires a 10-year capital works fund plan, Victoria requires a maintenance plan, and Queensland requires a sinking fund forecast. Exact requirements and penalties differ by state, so check your local strata legislation for compliance obligations.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How often should a capital works plan be reviewed?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Most states require a formal review every five years. The plan should also be updated after any major unexpected expenditure, significant changes to the building, or when asset lifespans are revised following new inspections or engineering reports.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How often should a sinking fund valuation be updated?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A sinking fund valuation should be updated at least every five years in line with the capital works plan review cycle. More frequent updates are recommended if major works are brought forward, asset conditions change, or construction costs rise faster than expected.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between a sinking fund and a maintenance fund?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A sinking fund, or capital works fund, covers major future expenses like roof replacements and lift refurbishments. A maintenance fund, part of the administrative fund, pays for ongoing day-to-day repairs such as gardening, minor plumbing fixes, and cleaning. Both are essential for keeping a strata property in good condition.</p>
        </div>
      </div>
    </div>
    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7; padding:1rem 1.25rem; border-radius:0.5rem">
      <strong style="display:block; margin-bottom:0.35rem">Disclaimer</strong>
      This calculator provides estimates for budgeting purposes only. Actual sinking fund contributions depend on building age, condition, local regulations, and professional valuations. Consult a strata management professional for accurate fund planning.
    </div>
  </div>

</ToolLayout>

<script>
  interface Asset { id: number; label: string; cost: number; lifespan: number; }

  let nextId = 0;
  let assets: Asset[] = [
    { id: nextId++, label: 'Roof replacement',        cost: 120000, lifespan: 30 },
    { id: nextId++, label: 'Lift / elevator',         cost: 80000,  lifespan: 25 },
    { id: nextId++, label: 'Driveway & car park',     cost: 40000,  lifespan: 20 },
    { id: nextId++, label: 'Exterior painting',       cost: 60000,  lifespan: 10 },
    { id: nextId++, label: 'Plumbing & drainage',     cost: 30000,  lifespan: 30 },
    { id: nextId++, label: 'Common area flooring',    cost: 20000,  lifespan: 15 },
    { id: nextId++, label: 'Pool / spa equipment',    cost: 25000,  lifespan: 15 },
  ];

  function getN(id: string): number { return parseFloat((document.getElementById(id) as HTMLInputElement)?.value) || 0; }

  function updateTotals() {
    const units   = getN('units')        || 1;
    const fund    = getN('current-fund');
    const age     = getN('building-age');
    const horizon = getN('horizon')      || 10;

    let required = 0;
    assets.forEach(a => {
      const ageAtEnd   = age + horizon;
      const portion    = Math.min(horizon, a.lifespan) / a.lifespan;
      const contribution = a.cost * portion;
      required += contribution;
    });

    const adequacy = required > 0 ? fund / required * 100 : 100;
    const shortfall = Math.max(required - fund, 0);
    const annualLevy = shortfall > 0 ? shortfall / horizon / units : 0;

    (document.getElementById('out-required') as HTMLElement).textContent  = '$' + Math.round(required).toLocaleString();
    (document.getElementById('out-adequacy') as HTMLElement).textContent  = adequacy.toFixed(0) + '%';
    const color = adequacy >= 90 ? '#16A34A' : adequacy >= 60 ? '#F97316' : '#DC2626';
    (document.getElementById('out-adequacy') as HTMLElement).style.color = color;
    (document.getElementById('out-levy') as HTMLElement).textContent      = '$' + Math.round(annualLevy).toLocaleString() + '/yr';
    (document.getElementById('adequacy-bar') as HTMLElement).style.width  = Math.min(adequacy, 100) + '%';
    (document.getElementById('adequacy-bar') as HTMLElement).style.background = color;
    (document.getElementById('adequacy-msg') as HTMLElement).textContent  =
      adequacy >= 90 ? 'Fund is well-funded ✓' : adequacy >= 60 ? 'Moderately funded — consider increasing contributions' : 'Under-funded — special levies may be required';
  }

  function renderAssets() {
    const list = document.getElementById('assets-list')!;
    list.innerHTML = '';
    assets.forEach(a => {
      const row = document.createElement('div');
      row.className = 'result-card';
      row.style.cssText = 'display:flex;align-items:center;gap:0.5rem;padding:0.45rem 0.625rem;';
      row.innerHTML = `
        <input type="text" value="${a.label}" data-id="${a.id}" data-field="label"
          class="input-themed" style="flex:1;border:none;min-width:0;"/>
        <span style="font-size:0.72rem;color:var(--text-muted);white-space:nowrap;">Cost $</span>
        <input type="number" value="${a.cost}" min="0" step="1000" data-id="${a.id}" data-field="cost"
          class="input-themed" style="width:80px;text-align:right;"/>
        <span style="font-size:0.72rem;color:var(--text-muted);">Life</span>
        <input type="number" value="${a.lifespan}" min="1" max="100" data-id="${a.id}" data-field="lifespan"
          class="input-themed" style="width:46px;text-align:center;"/>
        <span style="font-size:0.72rem;color:var(--text-muted);">yr</span>
        <button data-id="${a.id}" style="background:none;border:none;cursor:pointer;color:var(--text-muted);font-size:1.1rem;padding:0;">×</button>
      `;
      list.appendChild(row);
    });

    list.querySelectorAll('input').forEach(el => {
      el.addEventListener('input', (e) => {
        const inp   = e.target as HTMLInputElement;
        const id    = parseInt(inp.dataset.id!);
        const field = inp.dataset.field!;
        const asset = assets.find(x => x.id === id)!;
        if (field === 'label') asset.label = inp.value;
        else (asset as any)[field] = parseFloat(inp.value) || 0;
        updateTotals();
      });
    });

    list.querySelectorAll('button').forEach(el => {
      el.addEventListener('click', (e) => {
        const id = parseInt((e.currentTarget as HTMLElement).dataset.id!);
        assets = assets.filter(x => x.id !== id);
        renderAssets(); updateTotals();
      });
    });
  }

  document.getElementById('add-asset')?.addEventListener('click', () => {
    assets.push({ id: nextId++, label: 'New asset', cost: 20000, lifespan: 20 });
    renderAssets(); updateTotals();
  });

  ['units','current-fund','building-age','horizon'].forEach(id => document.getElementById(id)?.addEventListener('input', updateTotals));

  renderAssets();
  updateTotals();
</script>
