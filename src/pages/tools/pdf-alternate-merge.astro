---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'pdf-alternate-merge')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Alternate Merge</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Merge two PDFs by alternating their pages — perfect for front/back double-sided scans.</p>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
      <div>
        <p class="tool-label" style="margin-bottom:0.4rem;">PDF A — Pages 1, 3, 5…</p>
        <div id="drop-a" class="pdf-drop" style="border:2px dashed var(--border);border-radius:0.875rem;padding:1.5rem 0.5rem;text-align:center;cursor:pointer;transition:border-color 0.2s,background 0.2s;background:var(--bg-surface);min-height:100px;display:flex;flex-direction:column;align-items:center;justify-content:center;">
          <p style="font-size:0.85rem;font-weight:600;color:var(--text-primary);margin-bottom:0.3rem;">Drop PDF A</p>
          <p class="seo-p-sm">Front pages</p>
          <input id="input-a" type="file" accept=".pdf" style="display:none;" />
        </div>
        <p id="info-a" class="seo-p-sm" style="margin-top:0.3rem;text-align:center;"></p>
      </div>
      <div>
        <p class="tool-label" style="margin-bottom:0.4rem;">PDF B — Pages 2, 4, 6…</p>
        <div id="drop-b" class="pdf-drop" style="border:2px dashed var(--border);border-radius:0.875rem;padding:1.5rem 0.5rem;text-align:center;cursor:pointer;transition:border-color 0.2s,background 0.2s;background:var(--bg-surface);min-height:100px;display:flex;flex-direction:column;align-items:center;justify-content:center;">
          <p style="font-size:0.85rem;font-weight:600;color:var(--text-primary);margin-bottom:0.3rem;">Drop PDF B</p>
          <p class="seo-p-sm">Back pages</p>
          <input id="input-b" type="file" accept=".pdf" style="display:none;" />
        </div>
        <p id="info-b" class="seo-p-sm" style="margin-top:0.3rem;text-align:center;"></p>
      </div>
    </div>

    <div id="options" style="display:none;margin-bottom:1rem;">
      <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:0.75rem;">
        <label style="font-size:0.78rem;color:var(--text-secondary);font-weight:600;">Order:</label>
        <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.78rem;color:var(--text-primary);cursor:pointer;">
          <input type="radio" name="order" value="ab" checked /> A, B, A, B…
        </label>
        <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.78rem;color:var(--text-primary);cursor:pointer;">
          <input type="radio" name="order" value="ba" /> B, A, B, A…
        </label>
      </div>
      <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
        <label style="font-size:0.78rem;color:var(--text-secondary);font-weight:600;">When lengths differ:</label>
        <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.78rem;color:var(--text-primary);cursor:pointer;">
          <input type="radio" name="pad" value="append" checked /> Append remaining
        </label>
        <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.78rem;color:var(--text-primary);cursor:pointer;">
          <input type="radio" name="pad" value="truncate" /> Truncate to shorter
        </label>
      </div>
    </div>

    <div id="preview-wrap" style="display:none;margin-bottom:1rem;">
      <p class="tool-label" style="margin-bottom:0.5rem;">Merged Preview (first 10 pages)</p>
      <div id="preview" style="display:flex;flex-wrap:wrap;gap:0.5rem;"></div>
    </div>

    <div style="text-align:center;">
      <button id="merge-btn" class="btn-primary" type="button" style="font-size:0.95rem;padding:0.7rem 2rem;display:none;">Merge &amp; Download</button>
      <button id="reset-btn" class="btn-secondary" type="button" style="font-size:0.78rem;margin-left:0.5rem;display:none;">Reset</button>
      <p id="status" style="font-size:0.78rem;color:var(--text-muted);margin-top:0.5rem;display:none;"></p>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Alternate Merge Overview</h2>
    <p class="seo-p">
      This PDF alternate merge tool interleaves pages from two PDF documents into a single file — entirely within your browser. Built with <strong>pdf-lib</strong> (for page interleaving) and <strong>PDF.js</strong> (for thumbnail preview), both running via WebAssembly and Canvas, the tool provides complete privacy and zero server latency. The primary use case is combining front/back double-sided scans: when you scan the fronts of all pages into one PDF and the backs into another, this tool merges them into the correct reading order (A1, B1, A2, B2, …).
    </p>
    <p class="seo-p">
      The tool supports two merge orders (A-first or B-first) and two length-handling modes (append remaining pages or truncate to the shorter document). A live preview shows the first 10 pages of the interleaved result with color-coded borders (blue for PDF A, green for PDF B) so you can verify the merge pattern before downloading.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        [`Double-sided scan reassembly`, `The most common use case is combining separately scanned front and back pages. When you scan a 20-page double-sided document with an auto-feed scanner, the scanner produces two separate PDFs: one with odd pages (1, 3, 5, … 19) and one with even pages (2, 4, 6, … 20). This tool interleaves them into the correct order: A1, B1, A2, B2, … A10, B10. The preview lets you confirm the pattern before downloading.`],
        [`Deck and handout assembly`, `Presenters sometimes create slide decks in two parts — content slides and speaker notes, or main slides and supplementary materials. The alternate merge combines them into a single interleaved document where each content page is followed by its corresponding note or supplement. The B-first order option is useful when the supplementary material should appear before the main content.`],
        [`Parallel document comparison`, `Legal and research teams use alternate merge to create interleaved comparison documents. By placing the original document in PDF A and the revised version in PDF B, the merged output alternates between original and revised pages, making side-by-side comparison straightforward when printed or viewed in a two-page spread layout.`]
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Technical Architecture and Interleave Algorithm</h2>
    <p class="seo-p">
      The tool uses a two-library architecture: <strong>PDF.js</strong> (Mozilla’s PDF renderer) handles thumbnail preview rendering, while <strong>pdf-lib</strong> (a lightweight PDF manipulation library) performs the actual interleaving by copying pages from both source documents in an alternating sequence. Both libraries execute entirely in the browser via WebAssembly — no server round-trips occur at any stage.
    </p>

    <h3 class="font-display seo-h3-sm">The Interleave Algorithm</h3>
    <p class="seo-p-sm">
      The core algorithm builds a page index array by alternating between the two source documents. For the A-first order with append mode, the algorithm iterates up to the maximum page count of either document. At each index <code class="inline-code">i</code>, it adds a page from PDF A (if <code class="inline-code">i &lt; pagesA</code>) followed by a page from PDF B (if <code class="inline-code">i &lt; pagesB</code>). For the truncate mode, it iterates only up to the minimum page count, discarding excess pages from the longer document.
    </p>
    <p class="seo-p-sm">
      <strong>1. File ingestion:</strong> Each PDF is loaded via drag-and-drop or file browse. PDF.js parses each document to extract the page count. The raw <code class="inline-code">ArrayBuffer</code> data is stored for later processing. The tool displays the file name and page count for each input.
    </p>
    <p class="seo-p-sm">
      <strong>2. Preview generation:</strong> When both files are loaded, the tool generates a preview of the first 10 interleaved pages. For each page in the index array, PDF.js renders a thumbnail at 20% scale. Blue-bordered thumbnails represent pages from PDF A, green-bordered thumbnails represent pages from PDF B. The source label (A1, B1, etc.) appears below each thumbnail.
    </p>
    <p class="seo-p-sm">
      <strong>3. Merge execution:</strong> When the user clicks “Merge &amp; Download”, pdf-lib loads both source documents, iterates through the full page index array, copies each page from its source document using <code class="inline-code">copyPages()</code>, and adds it to the merged document. The resulting PDF is serialised to bytes and offered as a download.
    </p>
    <p class="seo-p-none">
      <strong>Feature preservation:</strong> Pages are copied byte-for-byte from the source documents, preserving text, images, vectors, bookmarks, and annotations. Embedded fonts are kept without re-encoding. The merge is a pure interleaving operation — it changes the page sequence without modifying any page content.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is alternate merge used for?",
          a: "Alternate merge is ideal for combining front/back double-sided scans. If you scanned the fronts of all pages into one PDF and the backs into another, this tool interleaves them into the correct reading order. It is also useful for assembling parallel documents, combining content with speaker notes, or creating interleaved comparison documents."
        },
        {
          q: "What if the PDFs have different numbers of pages?",
          a: "You can choose between two modes: 'Append remaining' adds the extra pages from the longer PDF at the end of the merged document. 'Truncate to shorter' cuts both PDFs to the length of the shorter one, discarding excess pages. The append mode is the default and most common choice."
        },
        {
          q: "Are my files uploaded to a server?",
          a: "No. All processing happens entirely in your browser using WebAssembly (pdf-lib) and Canvas (PDF.js). Your files never leave your device — there is no server upload at any point. This provides complete privacy for confidential documents."
        },
        {
          q: "Does interleaving reduce PDF quality?",
          a: "No. Pages are copied losslessly from both source documents — text, vectors, images, and bookmarks are preserved byte-for-byte. There is no re-encoding, recompression, or rasterisation. The merged PDF has exactly the same visual quality as the originals."
        },
        {
          q: "Can I merge more than two PDFs?",
          a: "This tool is designed for interleaving exactly two PDFs. To merge more than two PDFs, use the standard PDF Merge tool for sequential concatenation, or use this tool in multiple passes — first merge two files, then merge the result with the third file."
        },
        {
          q: "What is the difference between A-first and B-first order?",
          a: "A-first (A, B, A, B, …) places a page from PDF A first, then PDF B, alternating. B-first (B, A, B, A, …) places a page from PDF B first, then PDF A. Choose B-first when the back pages (PDF B) should appear before the front pages in the merged output."
        },
        {
          q: "Can I preview the result before downloading?",
          a: "Yes. The tool displays a preview of the first 10 interleaved pages with color-coded borders (blue for PDF A, green for PDF B). The source label (A1, B1, etc.) appears below each thumbnail. The preview updates automatically when you change the merge order or length-handling mode."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
<script is:inline src="https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.min.js"></script>

<script>
(function () {
  const { PDFDocument } = (window as any).PDFLib;
  const pdfjsLib = (window as any).pdfjsLib;
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.worker.min.js';

  const dropA = document.getElementById('drop-a')!;
  const dropB = document.getElementById('drop-b')!;
  const inputA = document.getElementById('input-a') as HTMLInputElement;
  const inputB = document.getElementById('input-b') as HTMLInputElement;
  const infoA = document.getElementById('info-a')!;
  const infoB = document.getElementById('info-b')!;
  const options = document.getElementById('options')!;
  const previewWrap = document.getElementById('preview-wrap')!;
  const previewDiv = document.getElementById('preview')!;
  const mergeBtn = document.getElementById('merge-btn')!;
  const resetBtn = document.getElementById('reset-btn')!;
  const statusEl = document.getElementById('status')!;

  let bytesA: ArrayBuffer | null = null;
  let bytesB: ArrayBuffer | null = null;
  let pagesA = 0;
  let pagesB = 0;

  function setupDrop(dropEl: HTMLDivElement, inputEl: HTMLInputElement, label: 'a' | 'b') {
    dropEl.addEventListener('dragover', e => { e.preventDefault(); dropEl.style.borderColor = 'var(--color-brand-blue)'; });
    dropEl.addEventListener('dragleave', () => { dropEl.style.borderColor = ''; });
    dropEl.addEventListener('drop', e => { e.preventDefault(); dropEl.style.borderColor = ''; if (e.dataTransfer!.files.length) handleFile(e.dataTransfer!.files[0], label); });
    dropEl.addEventListener('click', () => inputEl.click());
    inputEl.addEventListener('change', () => { if (inputEl.files.length) handleFile(inputEl.files[0], label); inputEl.value = ''; });
  }

  setupDrop(dropA as any, inputA, 'a');
  setupDrop(dropB as any, inputB, 'b');

  async function handleFile(file: File, label: 'a' | 'b') {
    if (file.type !== 'application/pdf') return;
    const buf = await file.arrayBuffer();
    const pdf = await pdfjsLib.getDocument({ data: buf.slice(0) }).promise;
    if (label === 'a') { bytesA = buf; pagesA = pdf.numPages; infoA.textContent = file.name.replace(/\.pdf$/i, '') + ' \u2014 ' + pagesA + ' pages'; }
    else { bytesB = buf; pagesB = pdf.numPages; infoB.textContent = file.name.replace(/\.pdf$/i, '') + ' \u2014 ' + pagesB + ' pages'; }
    checkReady();
  }

  function checkReady() {
    if (bytesA && bytesB) {
      options.style.display = '';
      mergeBtn.style.display = '';
      resetBtn.style.display = '';
      renderPreview();
    }
  }

  async function renderPreview() {
    previewWrap.style.display = '';
    previewDiv.innerHTML = '';
    const order = (document.querySelector('input[name="order"]:checked') as HTMLInputElement).value;
    const pad = (document.querySelector('input[name="pad"]:checked') as HTMLInputElement).value;
    const indices = buildOrder(pagesA, pagesB, order, pad).slice(0, 10);

    for (const { src, page } of indices) {
      const docBytes = src === 'a' ? bytesA! : bytesB!;
      const pdfDoc = await pdfjsLib.getDocument({ data: docBytes.slice(0) }).promise;
      const pdfPage = await pdfDoc.getPage(page);
      const viewport = pdfPage.getViewport({ scale: 0.2 });
      const canvas = document.createElement('canvas');
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      canvas.style.cssText = 'width:70px;height:auto;border:1px solid ' + (src === 'a' ? 'var(--border)' : '#10B981') + ';border-radius:4px;background:#fff;';
      await pdfPage.render({ canvasContext: canvas.getContext('2d')!, viewport }).promise;
      const wrap = document.createElement('div');
      wrap.style.cssText = 'text-align:center;flex-shrink:0;';
      const num = document.createElement('div');
      num.style.cssText = 'font-size:0.55rem;color:' + (src === 'a' ? 'var(--text-muted)' : '#10B981') + ';margin-top:0.15rem;';
      num.textContent = src.toUpperCase() + page;
      wrap.appendChild(canvas);
      wrap.appendChild(num);
      previewDiv.appendChild(wrap);
    }
    if (buildOrder(pagesA, pagesB, order, pad).length > 10) {
      const more = document.createElement('div');
      more.style.cssText = 'display:flex;align-items:center;font-size:0.72rem;color:var(--text-muted);';
      more.textContent = '+' + (buildOrder(pagesA, pagesB, order, pad).length - 10) + ' more';
      previewDiv.appendChild(more);
    }
  }

  document.querySelectorAll('input[name="order"], input[name="pad"]').forEach(r => r.addEventListener('change', () => { if (bytesA && bytesB) renderPreview(); }));

  function buildOrder(a: number, b: number, order: string, pad: string) {
    const result: { src: string; page: number }[] = [];
    const maxLen = pad === 'truncate' ? Math.min(a, b) : Math.max(a, b);
    for (let i = 0; i < maxLen; i++) {
      if (order === 'ab') {
        if (i < a) result.push({ src: 'a', page: i + 1 });
        if (i < b) result.push({ src: 'b', page: i + 1 });
      } else {
        if (i < b) result.push({ src: 'b', page: i + 1 });
        if (i < a) result.push({ src: 'a', page: i + 1 });
      }
    }
    return result;
  }

  resetBtn.addEventListener('click', () => {
    bytesA = null; bytesB = null; pagesA = 0; pagesB = 0;
    infoA.textContent = ''; infoB.textContent = '';
    options.style.display = 'none'; mergeBtn.style.display = 'none'; resetBtn.style.display = 'none';
    previewWrap.style.display = 'none'; statusEl.style.display = 'none';
  });

  mergeBtn.addEventListener('click', async () => {
    if (!bytesA || !bytesB) return;
    mergeBtn.setAttribute('disabled', '');
    mergeBtn.textContent = 'Merging\u2026';
    const order = (document.querySelector('input[name="order"]:checked') as HTMLInputElement).value;
    const pad = (document.querySelector('input[name="pad"]:checked') as HTMLInputElement).value;
    try {
      const merged = await PDFDocument.create();
      const docA = await PDFDocument.load(bytesA);
      const docB = await PDFDocument.load(bytesB);
      const indices = buildOrder(pagesA, pagesB, order, pad);
      for (const { src, page } of indices) {
        const srcDoc = src === 'a' ? docA : docB;
        const [copied] = await merged.copyPages(srcDoc, [page - 1]);
        merged.addPage(copied);
      }
      const bytes = await merged.save();
      const blob = new Blob([bytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = 'alternate_merged.pdf'; a.click();
      URL.revokeObjectURL(url);
      statusEl.style.display = ''; statusEl.style.color = '#10B981'; statusEl.textContent = `Merged ${indices.length} pages. Downloaded alternate_merged.pdf.`;
    } catch (e: any) { statusEl.style.display = ''; statusEl.style.color = '#EF4444'; statusEl.textContent = 'Error: ' + e.message; }
    finally { mergeBtn.removeAttribute('disabled'); mergeBtn.textContent = 'Merge & Download'; }
  });
})();
</script>
