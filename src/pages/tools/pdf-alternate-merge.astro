---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'pdf-alternate-merge')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Alternate Merge</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Merge two PDFs by alternating their pages — perfect for front/back double-sided scans.</p>

    <!-- Two drop zones side by side -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
      <div>
        <p style="font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem;">PDF A — Pages 1, 3, 5…</p>
        <div id="drop-a" class="pdf-drop" style="border:2px dashed var(--border);border-radius:0.875rem;padding:1.5rem 0.5rem;text-align:center;cursor:pointer;transition:border-color 0.2s,background 0.2s;background:var(--bg-surface);min-height:100px;display:flex;flex-direction:column;align-items:center;justify-content:center;">
          <p style="font-size:0.85rem;font-weight:600;color:var(--text-primary);margin-bottom:0.3rem;">Drop PDF A</p>
          <p style="font-size:0.72rem;color:var(--text-muted);">Front pages</p>
          <input id="input-a" type="file" accept=".pdf" style="display:none;" />
        </div>
        <p id="info-a" style="font-size:0.72rem;color:var(--text-muted);margin-top:0.3rem;text-align:center;"></p>
      </div>
      <div>
        <p style="font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.4rem;">PDF B — Pages 2, 4, 6…</p>
        <div id="drop-b" class="pdf-drop" style="border:2px dashed var(--border);border-radius:0.875rem;padding:1.5rem 0.5rem;text-align:center;cursor:pointer;transition:border-color 0.2s,background 0.2s;background:var(--bg-surface);min-height:100px;display:flex;flex-direction:column;align-items:center;justify-content:center;">
          <p style="font-size:0.85rem;font-weight:600;color:var(--text-primary);margin-bottom:0.3rem;">Drop PDF B</p>
          <p style="font-size:0.72rem;color:var(--text-muted);">Back pages</p>
          <input id="input-b" type="file" accept=".pdf" style="display:none;" />
        </div>
        <p id="info-b" style="font-size:0.72rem;color:var(--text-muted);margin-top:0.3rem;text-align:center;"></p>
      </div>
    </div>

    <!-- Options -->
    <div id="options" style="display:none;margin-bottom:1rem;">
      <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:0.75rem;">
        <label style="font-size:0.78rem;color:var(--text-secondary);font-weight:600;">Order:</label>
        <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.78rem;color:var(--text-primary);cursor:pointer;">
          <input type="radio" name="order" value="ab" checked /> A, B, A, B…
        </label>
        <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.78rem;color:var(--text-primary);cursor:pointer;">
          <input type="radio" name="order" value="ba" /> B, A, B, A…
        </label>
      </div>
      <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
        <label style="font-size:0.78rem;color:var(--text-secondary);font-weight:600;">When lengths differ:</label>
        <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.78rem;color:var(--text-primary);cursor:pointer;">
          <input type="radio" name="pad" value="append" checked /> Append remaining
        </label>
        <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.78rem;color:var(--text-primary);cursor:pointer;">
          <input type="radio" name="pad" value="truncate" /> Truncate to shorter
        </label>
      </div>
    </div>

    <div id="preview-wrap" style="display:none;margin-bottom:1rem;">
      <p style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Merged Preview (first 10 pages)</p>
      <div id="preview" style="display:flex;flex-wrap:wrap;gap:0.5rem;"></div>
    </div>

    <div style="text-align:center;">
      <button id="merge-btn" class="btn-primary" type="button" style="font-size:0.95rem;padding:0.7rem 2rem;display:none;">Merge &amp; Download</button>
      <button id="reset-btn" class="btn-secondary" type="button" style="font-size:0.78rem;margin-left:0.5rem;display:none;">Reset</button>
      <p id="status" style="font-size:0.78rem;color:var(--text-muted);margin-top:0.5rem;display:none;"></p>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use Alternate Merge</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      <strong>Step 1:</strong> Drop or browse for two PDF files — <strong>PDF A</strong> (front pages) and <strong>PDF B</strong> (back pages).
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      <strong>Step 2:</strong> Choose the merge order (A,B,A,B… or B,A,B,A…) and how to handle different lengths.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      <strong>Step 3:</strong> Click <strong>Merge &amp; Download</strong> to get the interleaved PDF.
    </p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How Alternate Merge works</h2>
    <pre style="font-family:'Fira Code',monospace;font-size:.85rem;padding:1rem;border-radius:.5rem;background:var(--bg-surface-2);color:var(--text-primary);overflow-x:auto;white-space:pre-wrap;">PDF A: [A1, A2, A3]  PDF B: [B1, B2, B3, B4]

Merge order A,B,A,B… (append remaining):
Result: [A1, B1, A2, B2, A3, B3, B4]

Merge order B,A,B,A… (truncate):
Result: [B1, A1, B2, A2, B3, A3]

All client-side — no server upload.</pre>
  </div>

  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is alternate merge used for?",
          "acceptedAnswer": { "@type": "Answer", "text": "Alternate merge is ideal for combining front/back double-sided scans. If you scanned the fronts of all pages into one PDF and the backs into another, this tool interleaves them into the correct order." }
        },
        {
          "@type": "Question",
          "name": "What if the PDFs have different numbers of pages?",
          "acceptedAnswer": { "@type": "Answer", "text": "You can choose to append remaining pages (the longer PDF's extra pages are added at the end) or truncate (both PDFs are cut to the shorter length)." }
        },
        {
          "@type": "Question",
          "name": "Are my files uploaded?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. All processing happens in your browser using pdf-lib. Your files never leave your device." }
        }
      ]
    }
    </script>
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What is alternate merge used for?', a: 'Alternate merge is ideal for combining front/back double-sided scans. If you scanned the fronts of all pages into one PDF and the backs into another, this tool interleaves them into the correct order.' },
        { q: 'What if the PDFs have different numbers of pages?', a: "You can choose to append remaining pages (the longer PDF's extra pages are added at the end) or truncate (both PDFs are cut to the shorter length)." },
        { q: 'Are my files uploaded?', a: 'No. All processing happens in your browser using pdf-lib. Your files never leave your device.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
<script is:inline src="https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.min.js"></script>

<script>
(function () {
  const { PDFDocument } = (window as any).PDFLib;
  const pdfjsLib = (window as any).pdfjsLib;
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.worker.min.js';

  const dropA = document.getElementById('drop-a')!;
  const dropB = document.getElementById('drop-b')!;
  const inputA = document.getElementById('input-a') as HTMLInputElement;
  const inputB = document.getElementById('input-b') as HTMLInputElement;
  const infoA = document.getElementById('info-a')!;
  const infoB = document.getElementById('info-b')!;
  const options = document.getElementById('options')!;
  const previewWrap = document.getElementById('preview-wrap')!;
  const previewDiv = document.getElementById('preview')!;
  const mergeBtn = document.getElementById('merge-btn')!;
  const resetBtn = document.getElementById('reset-btn')!;
  const statusEl = document.getElementById('status')!;

  let bytesA: ArrayBuffer | null = null;
  let bytesB: ArrayBuffer | null = null;
  let pagesA = 0;
  let pagesB = 0;

  function setupDrop(dropEl: HTMLDivElement, inputEl: HTMLInputElement, label: 'a' | 'b') {
    dropEl.addEventListener('dragover', e => { e.preventDefault(); dropEl.style.borderColor = 'var(--color-brand-blue)'; });
    dropEl.addEventListener('dragleave', () => { dropEl.style.borderColor = ''; });
    dropEl.addEventListener('drop', e => { e.preventDefault(); dropEl.style.borderColor = ''; if (e.dataTransfer!.files.length) handleFile(e.dataTransfer!.files[0], label); });
    dropEl.addEventListener('click', () => inputEl.click());
    inputEl.addEventListener('change', () => { if (inputEl.files.length) handleFile(inputEl.files[0], label); inputEl.value = ''; });
  }

  setupDrop(dropA as any, inputA, 'a');
  setupDrop(dropB as any, inputB, 'b');

  async function handleFile(file: File, label: 'a' | 'b') {
    if (file.type !== 'application/pdf') return;
    const buf = await file.arrayBuffer();
    const pdf = await pdfjsLib.getDocument({ data: buf.slice(0) }).promise;
    if (label === 'a') { bytesA = buf; pagesA = pdf.numPages; infoA.textContent = file.name.replace(/\.pdf$/i, '') + ' — ' + pagesA + ' pages'; }
    else { bytesB = buf; pagesB = pdf.numPages; infoB.textContent = file.name.replace(/\.pdf$/i, '') + ' — ' + pagesB + ' pages'; }
    checkReady();
  }

  function checkReady() {
    if (bytesA && bytesB) {
      options.style.display = '';
      mergeBtn.style.display = '';
      resetBtn.style.display = '';
      renderPreview();
    }
  }

  async function renderPreview() {
    previewWrap.style.display = '';
    previewDiv.innerHTML = '';
    const order = (document.querySelector('input[name="order"]:checked') as HTMLInputElement).value;
    const pad = (document.querySelector('input[name="pad"]:checked') as HTMLInputElement).value;
    const indices = buildOrder(pagesA, pagesB, order, pad).slice(0, 10);

    for (const { src, page } of indices) {
      const docBytes = src === 'a' ? bytesA! : bytesB!;
      const pdfDoc = await pdfjsLib.getDocument({ data: docBytes.slice(0) }).promise;
      const pdfPage = await pdfDoc.getPage(page);
      const viewport = pdfPage.getViewport({ scale: 0.2 });
      const canvas = document.createElement('canvas');
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      canvas.style.cssText = 'width:70px;height:auto;border:1px solid ' + (src === 'a' ? 'var(--border)' : '#10B981') + ';border-radius:4px;background:#fff;';
      await pdfPage.render({ canvasContext: canvas.getContext('2d')!, viewport }).promise;
      const wrap = document.createElement('div');
      wrap.style.cssText = 'text-align:center;flex-shrink:0;';
      const num = document.createElement('div');
      num.style.cssText = 'font-size:0.55rem;color:' + (src === 'a' ? 'var(--text-muted)' : '#10B981') + ';margin-top:0.15rem;';
      num.textContent = src.toUpperCase() + page;
      wrap.appendChild(canvas);
      wrap.appendChild(num);
      previewDiv.appendChild(wrap);
    }
    if (buildOrder(pagesA, pagesB, order, pad).length > 10) {
      const more = document.createElement('div');
      more.style.cssText = 'display:flex;align-items:center;font-size:0.72rem;color:var(--text-muted);';
      more.textContent = '+' + (buildOrder(pagesA, pagesB, order, pad).length - 10) + ' more';
      previewDiv.appendChild(more);
    }
  }

  document.querySelectorAll('input[name="order"], input[name="pad"]').forEach(r => r.addEventListener('change', () => { if (bytesA && bytesB) renderPreview(); }));

  function buildOrder(a: number, b: number, order: string, pad: string) {
    const result: { src: string; page: number }[] = [];
    const maxLen = pad === 'truncate' ? Math.min(a, b) : Math.max(a, b);
    for (let i = 0; i < maxLen; i++) {
      if (order === 'ab') {
        if (i < a) result.push({ src: 'a', page: i + 1 });
        if (i < b) result.push({ src: 'b', page: i + 1 });
      } else {
        if (i < b) result.push({ src: 'b', page: i + 1 });
        if (i < a) result.push({ src: 'a', page: i + 1 });
      }
    }
    return result;
  }

  resetBtn.addEventListener('click', () => {
    bytesA = null; bytesB = null; pagesA = 0; pagesB = 0;
    infoA.textContent = ''; infoB.textContent = '';
    options.style.display = 'none'; mergeBtn.style.display = 'none'; resetBtn.style.display = 'none';
    previewWrap.style.display = 'none'; statusEl.style.display = 'none';
  });

  mergeBtn.addEventListener('click', async () => {
    if (!bytesA || !bytesB) return;
    mergeBtn.setAttribute('disabled', '');
    mergeBtn.textContent = 'Merging…';
    const order = (document.querySelector('input[name="order"]:checked') as HTMLInputElement).value;
    const pad = (document.querySelector('input[name="pad"]:checked') as HTMLInputElement).value;
    try {
      const merged = await PDFDocument.create();
      const docA = await PDFDocument.load(bytesA);
      const docB = await PDFDocument.load(bytesB);
      const indices = buildOrder(pagesA, pagesB, order, pad);
      for (const { src, page } of indices) {
        const srcDoc = src === 'a' ? docA : docB;
        const [copied] = await merged.copyPages(srcDoc, [page - 1]);
        merged.addPage(copied);
      }
      const bytes = await merged.save();
      const blob = new Blob([bytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = 'alternate_merged.pdf'; a.click();
      URL.revokeObjectURL(url);
      statusEl.style.display = ''; statusEl.style.color = '#10B981'; statusEl.textContent = `Merged ${indices.length} pages. Downloaded alternate_merged.pdf.`;
    } catch (e: any) { statusEl.style.display = ''; statusEl.style.color = '#EF4444'; statusEl.textContent = 'Error: ' + e.message; }
    finally { mergeBtn.removeAttribute('disabled'); mergeBtn.textContent = 'Merge & Download'; }
  });
})();
</script>
