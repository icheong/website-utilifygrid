---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'compound-interest-wealth-calculator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:#0F172A; margin-bottom:1.25rem;">
      Wealth Growth Projector
    </h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.25rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Initial Investment ($)</label>
        <input id="principal" type="number" value="10000" min="0" step="1000"
          style="width:100%; padding:0.625rem 0.875rem; border:1.5px solid #E2E8F0; border-radius:0.625rem; font-size:0.95rem; color:#0F172A; box-sizing:border-box; outline:none;"
          onfocus="this.style.borderColor='#16A34A'" onblur="this.style.borderColor='#E2E8F0'"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Monthly Contribution ($)</label>
        <input id="monthly" type="number" value="500" min="0" step="50"
          style="width:100%; padding:0.625rem 0.875rem; border:1.5px solid #E2E8F0; border-radius:0.625rem; font-size:0.95rem; color:#0F172A; box-sizing:border-box; outline:none;"
          onfocus="this.style.borderColor='#16A34A'" onblur="this.style.borderColor='#E2E8F0'"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Annual Interest Rate (%)</label>
        <input id="rate" type="number" value="7" min="0" max="100" step="0.5"
          style="width:100%; padding:0.625rem 0.875rem; border:1.5px solid #E2E8F0; border-radius:0.625rem; font-size:0.95rem; color:#0F172A; box-sizing:border-box; outline:none;"
          onfocus="this.style.borderColor='#16A34A'" onblur="this.style.borderColor='#E2E8F0'"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Investment Period (Years)</label>
        <input id="years" type="number" value="20" min="1" max="50" step="1"
          style="width:100%; padding:0.625rem 0.875rem; border:1.5px solid #E2E8F0; border-radius:0.625rem; font-size:0.95rem; color:#0F172A; box-sizing:border-box; outline:none;"
          onfocus="this.style.borderColor='#16A34A'" onblur="this.style.borderColor='#E2E8F0'"/>
      </div>
    </div>

    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.75rem; margin-bottom:1.25rem;">
      <div style="background:#F0FDF4; border:1.5px solid #BBF7D0; border-radius:0.75rem; padding:1rem; text-align:center;">
        <div id="out-final" style="font-family:'Sora',sans-serif; font-size:1.4rem; font-weight:700; color:#16A34A;">$0</div>
        <div style="font-size:0.72rem; font-weight:600; color:#4ADE80; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.05em;">Final Balance</div>
      </div>
      <div style="background:#EFF6FF; border:1.5px solid #BFDBFE; border-radius:0.75rem; padding:1rem; text-align:center;">
        <div id="out-contributed" style="font-family:'Sora',sans-serif; font-size:1.4rem; font-weight:700; color:#1D4ED8;">$0</div>
        <div style="font-size:0.72rem; font-weight:600; color:#60A5FA; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.05em;">Total Contributed</div>
      </div>
      <div style="background:#FFF7ED; border:1.5px solid #FED7AA; border-radius:0.75rem; padding:1rem; text-align:center;">
        <div id="out-interest" style="font-family:'Sora',sans-serif; font-size:1.4rem; font-weight:700; color:#EA580C;">$0</div>
        <div style="font-size:0.72rem; font-weight:600; color:#FB923C; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.05em;">Interest Earned</div>
      </div>
    </div>

    <div style="border:1px solid #E2E8F0; border-radius:0.75rem; overflow:hidden;">
      <div style="background:#F8FAFC; padding:0.75rem 1rem; border-bottom:1px solid #E2E8F0; display:flex; justify-content:space-between; align-items:center;">
        <span style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em;">Year-by-Year Breakdown</span>
        <button id="toggle-table" style="font-size:0.75rem; color:#1D4ED8; background:none; border:none; cursor:pointer; font-weight:600;">Show all</button>
      </div>
      <div style="overflow-x:auto; max-height:320px; overflow-y:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:0.82rem;">
          <thead style="position:sticky; top:0; background:#F8FAFC;">
            <tr>
              {['Year','Balance','Contributed','Interest'].map(h => (
                <th style="padding:0.6rem 1rem; text-align:right; color:#475569; font-weight:600; white-space:nowrap; border-bottom:1px solid #E2E8F0;">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody id="table-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="seo-h2" >Overview and Technical Context</h2>
    <p class="seo-p" >
      The Compound Interest Wealth Calculator is a client-side financial projection tool that models how an initial investment grows over time with regular monthly contributions and compound interest. Built with vanilla JavaScript and running entirely in the browser, it computes a year-by-year breakdown table showing balance, total contributed, and interest earned at each stage. No data is sent to any server — your financial inputs remain entirely private.
    </p>
    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Planning a long-term retirement savings strategy', 'A 30-year-old employee wants to know how much their $10,000 emergency fund plus $500 monthly contributions will grow by age 60 at a 7% average annual return. The calculator shows the year-by-year trajectory, making the abstract concept of compound growth tangible and actionable for retirement planning conversations.'],
        ['Comparing investment timing scenarios', 'A recent graduate is deciding whether to start investing $300/month now or wait five years and invest $500/month later. The calculator demonstrates that starting earlier — even with smaller contributions — often produces a larger final balance due to the exponential nature of compounding over a longer period.'],
        ['Evaluating the impact of increasing monthly contributions', 'A financial planner is advising a client on whether increasing monthly contributions from $400 to $600 is worth the lifestyle trade-off. Running both scenarios through the calculator quantifies the exact difference in final balance and interest earned, providing concrete numbers for the decision.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:#0F172A; font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="seo-h2" >Deep-Dive Technical Mechanics</h2>
    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Monthly Compounding Formula</h3>
    <p class="seo-p" >
      The calculator applies monthly compounding, which is more accurate than simple annual compounding for regular contribution scenarios. Each month, the current balance is multiplied by <code style="background:#F1F5F9; padding:0.1rem 0.35rem; border-radius:0.25rem; font-size:0.85rem">(1 + annual rate ÷ 12)</code>, then the monthly contribution is added. This process repeats for every month across the investment period. Monthly compounding captures the effect of interest earning interest more frequently, which is how most savings accounts, ETFs, and retirement funds actually compound.
    </p>
    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Exponential Growth Dynamics</h3>
    <p class="seo-p" >
      The year-by-year breakdown table reveals the fundamental principle of compound interest: in the early years, most of the balance growth comes from your contributions. In later years, interest on interest begins to dominate. This crossover point — where accumulated interest exceeds total contributions — is the visual demonstration of why time in the market matters more than timing the market. The 7% default rate is based on the historical average real return of the S&P 500 after adjusting for inflation over the past century.
    </p>
    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Important Limitations</h3>
    <p class="seo-p" >
      The calculation does not account for taxes, inflation, management fees, or variable returns. Real-world investment returns fluctuate year to year — the 7% used here is an average, not a guarantee. The tool is designed to illustrate the mathematical principle of compound growth and to help with initial scenario planning. For personalised financial advice, consult a qualified financial advisor.
    </p>
    <div class="border-theme surface-2 seo-disclaimer" style="margin-top:0.75rem">
      <div style="font-size:0.78rem; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.5rem">Core Formula</div>
      <p class="seo-card-body" style="font-family:'Fira Code',monospace; color:#0F172A; margin:0">
        Balance<sub>n+1</sub> = Balance<sub>n</sub> × (1 + r ÷ 12) + Monthly Contribution
      </p>
      <p style="font-size:0.82rem; line-height:1.6; margin:0.5rem 0 0">
        Where r = annual interest rate (e.g., 0.07 for 7%). Applied monthly for each month of the investment period.
      </p>
    </div>
  </div>

  <div slot="faq">
    <h2 class="seo-h2-faq" >Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: 'What is compound interest?',
          a: 'Compound interest is interest calculated on the initial principal plus all previously accumulated interest. Unlike simple interest, which only applies to the original principal, compounding means you earn interest on your interest, leading to exponential growth over time. This is the fundamental mechanism behind wealth accumulation through long-term investing.',
        },
        {
          q: 'What annual return rate should I use?',
          a: 'For long-term stock market investments, 7% is a commonly used real return (after inflation) based on historical S&P 500 averages spanning over a century. For high-yield savings accounts, use 4% to 5%. For bonds, 2% to 4%. These are estimates only — past performance does not guarantee future results, and actual returns will vary year to year.',
        },
        {
          q: 'How much should I invest per month?',
          a: 'A common guideline is to save 15% to 20% of your gross income for retirement. Even small amounts benefit enormously from time due to compounding. Starting 10 years earlier can roughly double the final balance even with the same total contributions, which is why starting early matters more than investing a large amount later.',
        },
        {
          q: 'Does this account for inflation?',
          a: 'No. The calculator shows nominal returns. To estimate inflation-adjusted (real) returns, subtract your expected inflation rate from your interest rate input. A 7% nominal return with 3% inflation equates to roughly 4% real growth, which still compounds significantly over long periods.',
        },
        {
          q: 'Why does the year-by-year table show interest growing faster in later years?',
          a: 'This is the core effect of compounding. In early years, your monthly contributions make up most of the balance growth. As interest accumulates, you begin earning interest on increasingly larger amounts, creating a snowball effect. In later years, interest earned can exceed your annual contributions — this is the crossover point where compound growth truly accelerates.',
        },
        {
          q: 'Should I prioritise increasing contributions or finding a higher return rate?',
          a: 'For most investors, increasing contributions has a larger impact than chasing higher returns. A 1% increase in annual return is meaningful, but doubling your monthly contribution has a far greater effect on the final balance. Additionally, higher returns typically come with higher risk, while increasing contributions is a guaranteed improvement to your outcome.',
        },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is compound interest?",
          "acceptedAnswer": { "@type": "Answer", "text": "Compound interest is interest calculated on the initial principal plus all previously accumulated interest, leading to exponential growth over time." }
        },
        {
          "@type": "Question",
          "name": "What annual return rate should I use?",
          "acceptedAnswer": { "@type": "Answer", "text": "For long-term stock market investments, 7% is a commonly used real return based on historical S&P 500 averages. For savings accounts, use 4-5%. For bonds, 2-4%. These are estimates only." }
        },
        {
          "@type": "Question",
          "name": "Does this account for inflation?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. The calculator shows nominal returns. Subtract your expected inflation rate from the interest rate input to estimate real returns." }
        },
        {
          "@type": "Question",
          "name": "How much should I invest per month?",
          "acceptedAnswer": { "@type": "Answer", "text": "A common guideline is 15-20% of gross income for retirement. Starting 10 years earlier can roughly double the final balance even with the same total contributions." }
        }
      ]
    })} />

    <p class="seo-card-body" style="margin-top:1.25rem">
      <strong style="color:var(--text-secondary)">Disclaimer:</strong> This calculator is provided for educational and illustrative purposes only. It does not constitute financial, investment, or tax advice. The projections are based on simplified mathematical models and fixed assumptions that do not reflect real market conditions. Actual investment returns will vary and may be negative in any given year. Factors such as taxes, fees, inflation, and market volatility are not separately modelled. Always consult a qualified financial advisor before making investment decisions.
    </p>
  </div>

</ToolLayout>

<script>
  let showAll = false;
  let rows: { year: number; balance: number; contributed: number; interest: number }[] = [];

  function fmt(n: number) { return '$' + Math.round(n).toLocaleString('en-US'); }

  function calc() {
    const principal = parseFloat((document.getElementById('principal') as HTMLInputElement).value) || 0;
    const monthly   = parseFloat((document.getElementById('monthly') as HTMLInputElement).value)   || 0;
    const rate      = parseFloat((document.getElementById('rate') as HTMLInputElement).value)      || 0;
    const years     = Math.min(Math.max(Math.round(parseFloat((document.getElementById('years') as HTMLInputElement).value) || 1), 1), 50);

    const monthlyRate = rate / 100 / 12;
    rows = [];
    let balance = principal;
    let totalContributed = principal;

    for (let y = 1; y <= years; y++) {
      for (let m = 0; m < 12; m++) {
        balance = balance * (1 + monthlyRate) + monthly;
        totalContributed += monthly;
      }
      rows.push({ year: y, balance, contributed: totalContributed, interest: balance - totalContributed });
    }

    const last = rows[rows.length - 1] || { balance: 0, contributed: principal, interest: 0 };
    document.getElementById('out-final')!.textContent       = fmt(last.balance);
    document.getElementById('out-contributed')!.textContent = fmt(last.contributed);
    document.getElementById('out-interest')!.textContent    = fmt(last.interest);
    renderTable();
  }

  function renderTable() {
    const body = document.getElementById('table-body')!;
    const display = showAll ? rows : rows.slice(0, 10);
    body.innerHTML = display.map((r, i) => `
      <tr style="border-bottom:1px solid #F1F5F9; background:${i % 2 === 0 ? '#fff' : '#F8FAFC'};">
        <td style="padding:0.5rem 1rem; text-align:right; color:#64748B; font-weight:600;">Year ${r.year}</td>
        <td style="padding:0.5rem 1rem; text-align:right; color:#16A34A; font-weight:700;">${fmt(r.balance)}</td>
        <td style="padding:0.5rem 1rem; text-align:right; color:#1D4ED8;">${fmt(r.contributed)}</td>
        <td style="padding:0.5rem 1rem; text-align:right; color:#EA580C;">${fmt(r.interest)}</td>
      </tr>`).join('');
    const btn = document.getElementById('toggle-table')!;
    btn.textContent = showAll ? 'Show less' : (rows.length > 10 ? `Show all ${rows.length} years` : '');
    btn.style.display = rows.length <= 10 ? 'none' : 'inline';
  }

  document.getElementById('toggle-table')?.addEventListener('click', () => { showAll = !showAll; renderTable(); });
  ['principal','monthly','rate','years'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));
  calc();
</script>
