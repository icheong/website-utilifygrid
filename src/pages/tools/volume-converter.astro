---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'volume-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Volume Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="vol-input">Value</label>
        <input id="vol-input" type="number" value="1" min="0" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="vol-unit">Unit</label>
        <select id="vol-unit" class="select-themed" style="min-width:10rem;">
          <option value="ml">Milliliters (mL)</option>
          <option value="l" selected>Liters (L)</option>
          <option value="m3">Cubic Meters (m³)</option>
          <option value="tsp">Teaspoons (tsp)</option>
          <option value="tbsp">Tablespoons (tbsp)</option>
          <option value="floz">Fluid Ounces (fl oz)</option>
          <option value="cup">Cups</option>
          <option value="pt">Pints (pt)</option>
          <option value="qt">Quarts (qt)</option>
          <option value="gal-us">US Gallons</option>
          <option value="gal-uk">Imperial Gallons</option>
        </select>
      </div>
    </div>

    <!-- Results grid -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Volume Converter</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Enter a <strong>numeric value</strong> and select its <strong>unit</strong> from the dropdown. All other volume and capacity units update instantly — no buttons to click.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      The converter covers <strong>metric</strong> units (milliliters, liters, cubic meters) and <strong>imperial/US customary</strong> units (teaspoons, tablespoons, fluid ounces, cups, pints, quarts, gallons), plus both US and imperial gallons. Results use high-precision floating-point math.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      Click any <strong>Copy</strong> button to copy that unit's result to your clipboard — handy for pasting into recipes, documents, or messages.
    </p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How volume conversions work</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.875rem;">
      All conversions go through <strong>milliliters</strong> as the base unit. Each unit has a fixed factor relative to one milliliter:
    </p>
    <pre style="font-family:'Fira Code',monospace;font-size:.85rem;padding:1rem;border-radius:.5rem;background:var(--bg-surface-2);color:var(--text-primary);overflow-x:auto;white-space:pre-wrap;">1 L      = 1000 mL
1 m³     = 1,000,000 mL
1 tsp    = 4.92892 mL
1 tbsp   = 14.7868 mL
1 fl oz  = 29.5735 mL
1 cup    = 236.588 mL
1 pt     = 473.176 mL
1 qt     = 946.353 mL
1 gal US = 3785.41 mL
1 gal UK = 4546.09 mL

Result = Input × (FromFactor / ToFactor)</pre>
    <p style="color:var(--text-secondary); font-size:0.85rem; line-height:1.75;">
      US customary units are defined in terms of the international inch (2.54 cm exactly). The imperial gallon is defined as exactly 4.54609 liters. All calculations run in your browser — no data is sent anywhere.
    </p>
  </div>

  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the difference between a US gallon and an imperial gallon?",
          "acceptedAnswer": { "@type": "Answer", "text": "A US gallon equals 3.785 liters, while an imperial gallon (used in the UK) equals 4.546 liters — about 20% larger. When following British recipes, make sure to use imperial gallons, not US gallons." }
        },
        {
          "@type": "Question",
          "name": "How many milliliters are in a cup?",
          "acceptedAnswer": { "@type": "Answer", "text": "One US cup equals approximately 236.588 milliliters. An imperial cup (used in the UK) is slightly larger at 284.131 mL. This tool uses the US cup measurement, which is the most common in cooking." }
        },
        {
          "@type": "Question",
          "name": "What is a fluid ounce?",
          "acceptedAnswer": { "@type": "Answer", "text": "A fluid ounce (fl oz) is a unit of volume, not weight. One US fluid ounce equals approximately 29.57 mL. It is commonly used in the United States for measuring liquids in recipes and beverage containers." }
        },
        {
          "@type": "Question",
          "name": "Why are there different tablespoon sizes?",
          "acceptedAnswer": { "@type": "Answer", "text": "A US tablespoon is approximately 14.79 mL, while an Australian tablespoon is exactly 20 mL, and a UK tablespoon is 15 mL. This tool uses the US tablespoon. Always check which standard your recipe uses." }
        },
        {
          "@type": "Question",
          "name": "How do I convert liters to gallons?",
          "acceptedAnswer": { "@type": "Answer", "text": "To convert liters to US gallons, divide by 3.78541. To convert to imperial gallons, divide by 4.54609. For example, 10 liters equals approximately 2.64 US gallons or 2.20 imperial gallons." }
        }
      ]
    }
    </script>

    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What is the difference between a US gallon and an imperial gallon?', a: 'A US gallon equals 3.785 liters, while an imperial gallon (used in the UK) equals 4.546 liters — about 20% larger. When following British recipes, make sure to use imperial gallons, not US gallons.' },
        { q: 'How many milliliters are in a cup?', a: 'One US cup equals approximately 236.588 milliliters. An imperial cup (used in the UK) is slightly larger at 284.131 mL. This tool uses the US cup measurement, which is the most common in cooking.' },
        { q: 'What is a fluid ounce?', a: 'A fluid ounce (fl oz) is a unit of volume, not weight. One US fluid ounce equals approximately 29.57 mL. It is commonly used in the United States for measuring liquids in recipes and beverage containers.' },
        { q: 'Why are there different tablespoon sizes?', a: 'A US tablespoon is approximately 14.79 mL, while an Australian tablespoon is exactly 20 mL, and a UK tablespoon is 15 mL. This tool uses the US tablespoon. Always check which standard your recipe uses.' },
        { q: 'How do I convert liters to gallons?', a: 'To convert liters to US gallons, divide by 3.78541. To convert to imperial gallons, divide by 4.54609. For example, 10 liters equals approximately 2.64 US gallons or 2.20 imperial gallons.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Unit definitions: factor to milliliters ──────────────────────
  const UNITS = [
    { id: 'ml',     label: 'Milliliters',       abbr: 'mL',    factor: 1 },
    { id: 'l',      label: 'Liters',             abbr: 'L',     factor: 1000 },
    { id: 'm3',     label: 'Cubic Meters',       abbr: 'm³',    factor: 1_000_000 },
    { id: 'tsp',    label: 'Teaspoons',          abbr: 'tsp',   factor: 4.92892 },
    { id: 'tbsp',   label: 'Tablespoons',        abbr: 'tbsp',  factor: 14.7868 },
    { id: 'floz',   label: 'Fluid Ounces',       abbr: 'fl oz', factor: 29.5735 },
    { id: 'cup',    label: 'Cups',               abbr: 'cup',   factor: 236.588 },
    { id: 'pt',     label: 'Pints',              abbr: 'pt',    factor: 473.176 },
    { id: 'qt',     label: 'Quarts',             abbr: 'qt',    factor: 946.353 },
    { id: 'gal-us', label: 'US Gallons',         abbr: 'gal',   factor: 3785.41 },
    { id: 'gal-uk', label: 'Imperial Gallons',   abbr: 'imp gal', factor: 4546.09 },
  ];

  const input  = document.getElementById('vol-input') as HTMLInputElement;
  const select = document.getElementById('vol-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  // ── Quick-reference objects (stored in milliliters) ─────────────
  const REFS = [
    { name: 'Teaspoon',         ml: 4.929 },
    { name: 'Tablespoon',       ml: 14.787 },
    { name: 'Shot Glass',       ml: 44.36 },
    { name: 'Coffee Mug',       ml: 350.0 },
    { name: 'Wine Bottle',      ml: 750.0 },
    { name: 'Bathtub',          ml: 300_000.0 },
    { name: 'Swimming Pool',    ml: 2_500_000_000.0 },
    { name: 'Olympic Pool',     ml: 2_500_000_000.0 },
  ];

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9)  return value.toExponential(4);
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6)  return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;

    grid.innerHTML = '';

    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.abbr;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = (r.ml * 1) / fromFactor;
      const display = formatResult(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
