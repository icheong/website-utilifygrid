---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'volume-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Volume Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly. All calculations run in your browser.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="vol-input">Value</label>
        <input id="vol-input" type="number" value="1" min="0" step="any" placeholder="Enter value"
          class="input-themed" />
      </div>
      <div>
        <label class="tool-label" for="vol-unit">Unit</label>
        <select id="vol-unit" class="select-themed" style="min-width:10rem;">
          <option value="ml">Milliliters (mL)</option>
          <option value="l" selected>Liters (L)</option>
          <option value="m3">Cubic Meters (m³)</option>
          <option value="tsp">Teaspoons (tsp)</option>
          <option value="tbsp">Tablespoons (tbsp)</option>
          <option value="floz">Fluid Ounces (fl oz)</option>
          <option value="cup">Cups</option>
          <option value="pt">Pints (pt)</option>
          <option value="qt">Quarts (qt)</option>
          <option value="gal-us">US Gallons</option>
          <option value="gal-uk">Imperial Gallons</option>
        </select>
      </div>
    </div>

    <!-- Results grid -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Volume Converter Overview</h2>
    <p class="seo-p">
      This volume converter computes precise conversions between 11 metric and imperial volume units entirely within your browser. Built with modern vanilla JavaScript, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your measurements, whether you are working in cooking, engineering, chemistry, or logistics.
    </p>
    <p class="seo-p">
      The converter supports the most commonly used volume units across metric and imperial systems: milliliters, liters, and cubic meters for metric; teaspoons, tablespoons, fluid ounces, cups, pints, quarts, US gallons, and imperial gallons for imperial/US customary. The imperial gallon is defined as exactly 4.54609 liters, while the US gallon is defined via the international inch (2.54 cm exactly). Results are dynamically formatted based on magnitude, switching between fixed notation, locale-formatted numbers, and scientific notation as appropriate.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Cooking and recipe conversion', 'Recipes from different countries use different volume units — milliliters and liters for metric recipes, cups and tablespoons for US recipes, and fluid ounces for UK recipes. A baker scaling a recipe from 4 US cups of flour to metric needs to know that 1 US cup equals approximately 236.588 mL. This tool provides instant, exact conversions with copy-to-clipboard functionality, eliminating manual lookup errors when scaling recipes up or down.'],
        ['Laboratory and chemical measurements', 'Chemists and biology researchers frequently convert between milliliters, liters, and cubic meters when preparing solutions, measuring reagents, or scaling experiments. A 0.5 M NaCl solution requiring 250 mL of stock solution must be measured precisely — a conversion error of even 1% can invalidate experimental results. The tool handles the full range from microliter-scale measurements to cubic-meter-scale industrial volumes with IEEE 754 double-precision accuracy.'],
        ['Industrial and logistics planning', 'Shipping companies, beverage manufacturers, and fuel distributors routinely convert between liters, US gallons, and imperial gallons when processing international orders. A tanker carrying 50,000 US gallons of fuel must be converted to liters for metric-market invoicing, or to imperial gallons for UK delivery. The quick-reference section helps visualise everyday volumes like a teaspoon (4.93 mL), a wine bottle (750 mL), or a swimming pool (2.5 million liters) for intuitive scale comparison.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      The converter employs a hub-and-spoke conversion model using milliliters as the universal base unit. Every supported volume unit is defined by a fixed conversion factor relative to one milliliter. To convert from unit A to unit B, the tool multiplies the input value by A's factor to obtain milliliters, then divides by B's factor to obtain the target value. This approach guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">ml</code>, <code class="inline-code">gal-us</code>, <code class="inline-code">cup</code>) to its exact factor in milliliters. Metric units use powers of 10 (e.g. <code class="inline-code">1 L = 1000 mL</code>, <code class="inline-code">1 m³ = 1,000,000 mL</code>), while imperial/US customary units use internationally defined values.
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion:</strong> The input value is multiplied by the source unit's factor to convert to milliliters. For example, converting 2 US gallons to milliliters: <code class="inline-code">2 × 3785.41 = 7570.82 mL</code>. This intermediate result is an IEEE 754 double-precision floating-point number, which provides approximately 15 to 17 significant decimal digits of precision.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion:</strong> The milliliter value is divided by the target unit's factor. Converting 7570.82 mL to liters: <code class="inline-code">7570.82 / 1000 = 7.57082 L</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>.
    </p>
    <p class="seo-p-sm">
      <strong>4. Dynamic formatting:</strong> The display format adapts to the magnitude of the result. Large values (1 billion or greater) use scientific notation. Values between 1,000 and 1 billion use locale-formatted numbers with 2 to 4 decimal places. Values between 0.001 and 1,000 use 6 to 8 decimal places. Values below 0.001 use scientific notation. This ensures readability across the full 12-order-of-magnitude range (milliliters to cubic meters).
    </p>
    <p class="seo-p-none">
      <strong>Exact vs. approximate factors:</strong> The metric factors are exact by definition: <code class="inline-code">1 L = 1000 mL</code>, <code class="inline-code">1 m³ = 1,000,000 mL</code>. The imperial gallon is defined as exactly 4.54609 liters, making <code class="inline-code">1 imp gal = 4546.09 mL</code> exact. US customary units are derived from the international inch (2.54 cm exactly), so <code class="inline-code">1 US gal = 231 cubic inches = 3785.411784 mL</code> is also exact. Smaller US units (teaspoons, tablespoons, fluid ounces, cups, pints, quarts) are derived by exact factors of 2 within the US system, though their milliliter equivalents are rounded to 5–6 decimal places for display.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is the difference between a US gallon and an imperial gallon?",
          a: "A US gallon equals exactly 3.78541 liters (231 cubic inches), while an imperial gallon (used in the UK) equals exactly 4.54609 liters — about 20% larger. The US gallon is subdivided into 4 US quarts, 8 US pints, or 128 US fluid ounces. The imperial gallon is subdivided into 4 imperial quarts, 8 imperial pints, or 160 imperial fluid ounces. When following British recipes or reading UK product labels, always use imperial gallons, not US gallons."
        },
        {
          q: "How many milliliters are in a cup?",
          a: "One US cup equals exactly 236.5882365 milliliters (derived from the US gallon). An imperial cup (used in some UK recipes) is slightly larger at 284.131 mL. A metric cup (used in Australia, Canada, and New Zealand) is exactly 250 mL. This tool uses the US cup measurement, which is the most common standard in cooking worldwide."
        },
        {
          q: "What is a fluid ounce and how does it differ from a regular ounce?",
          a: "A fluid ounce (fl oz) is a unit of volume, not weight. One US fluid ounce equals approximately 29.5735 mL. An imperial fluid ounce is slightly smaller at approximately 28.4131 mL. A regular ounce (oz) measures weight, so comparing fluid ounces to ounces requires knowing the density of the substance. Water, for example, has approximately 1 gram per fluid ounce at room temperature."
        },
        {
          q: "Why are there different tablespoon sizes around the world?",
          a: "A US tablespoon is approximately 14.7868 mL (defined as exactly 1/2 US fluid ounce). An Australian tablespoon is exactly 20 mL (defined metrically). A UK tablespoon is 15 mL. A Canadian tablespoon is typically 15 mL but varies by province. This tool uses the US tablespoon. Always check which standard your recipe uses — using an Australian tablespoon (20 mL) in a US recipe (14.79 mL) introduces a 35% error per tablespoon."
        },
        {
          q: "How do I convert liters to US gallons?",
          a: "To convert liters to US gallons, divide by 3.78541. To convert to imperial gallons, divide by 4.54609. For example, 10 liters equals approximately 2.64 US gallons or 2.20 imperial gallons. A quick mental shortcut: 1 US gallon is roughly 3.785 liters, and 1 imperial gallon is roughly 4.546 liters."
        },
        {
          q: "Can I use this converter for fuel economy calculations?",
          a: "Yes. Fuel economy is typically measured in miles per gallon (MPG) in the US/UK, or liters per 100 kilometers (L/100km) in metric countries. To convert between these, you need both a volume conversion and a distance conversion. This tool handles the volume component: for example, converting 30 MPG (US) to L/100km requires dividing 235.215 by the MPG value, giving approximately 7.84 L/100km."
        },
        {
          q: "What is the relationship between teaspoons, tablespoons, and cups?",
          a: "In the US system, 1 tablespoon = 3 teaspoons, 1 cup = 16 tablespoons, and 1 pint = 2 cups. This creates a clean base-2 subdivision: 1 US pint = 32 teaspoons. The imperial system uses a different subdivision: 1 imperial tablespoon = approximately 1.67 imperial teaspoons, and 1 imperial cup = 10 imperial fluid ounces. This tool handles all these conversions automatically."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Unit definitions: factor to milliliters ──────────────────────
  const UNITS = [
    { id: 'ml',     label: 'Milliliters',       abbr: 'mL',    factor: 1 },
    { id: 'l',      label: 'Liters',             abbr: 'L',     factor: 1000 },
    { id: 'm3',     label: 'Cubic Meters',       abbr: 'm³',    factor: 1_000_000 },
    { id: 'tsp',    label: 'Teaspoons',          abbr: 'tsp',   factor: 4.92892 },
    { id: 'tbsp',   label: 'Tablespoons',        abbr: 'tbsp',  factor: 14.7868 },
    { id: 'floz',   label: 'Fluid Ounces',       abbr: 'fl oz', factor: 29.5735 },
    { id: 'cup',    label: 'Cups',               abbr: 'cup',   factor: 236.588 },
    { id: 'pt',     label: 'Pints',              abbr: 'pt',    factor: 473.176 },
    { id: 'qt',     label: 'Quarts',             abbr: 'qt',    factor: 946.353 },
    { id: 'gal-us', label: 'US Gallons',         abbr: 'gal',   factor: 3785.41 },
    { id: 'gal-uk', label: 'Imperial Gallons',   abbr: 'imp gal', factor: 4546.09 },
  ];

  const input  = document.getElementById('vol-input') as HTMLInputElement;
  const select = document.getElementById('vol-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  // ── Quick-reference objects (stored in milliliters) ─────────────
  const REFS = [
    { name: 'Teaspoon',         ml: 4.929 },
    { name: 'Tablespoon',       ml: 14.787 },
    { name: 'Shot Glass',       ml: 44.36 },
    { name: 'Coffee Mug',       ml: 350.0 },
    { name: 'Wine Bottle',      ml: 750.0 },
    { name: 'Bathtub',          ml: 300_000.0 },
    { name: 'Swimming Pool',    ml: 2_500_000_000.0 },
    { name: 'Olympic Pool',     ml: 2_500_000_000.0 },
  ];

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9)  return value.toExponential(4);
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6)  return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;

    grid.innerHTML = '';

    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.abbr;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = (r.ml * 1) / fromFactor;
      const display = formatResult(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
