---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'volume-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Volume Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly. All calculations run in your browser.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="vol-input">Value</label>
        <input id="vol-input" type="number" value="1" min="0" step="any" placeholder="Enter value"
          class="input-themed" />
      </div>
      <div>
        <label class="tool-label" for="vol-unit">Unit</label>
        <select id="vol-unit" class="select-themed" style="min-width:10rem;">
          <option value="ml">Milliliters (mL)</option>
          <option value="l" selected>Liters (L)</option>
          <option value="m3">Cubic Meters (m³)</option>
          <option value="tsp">Teaspoons (tsp)</option>
          <option value="tbsp">Tablespoons (tbsp)</option>
          <option value="floz">Fluid Ounces (fl oz)</option>
          <option value="cup">Cups</option>
          <option value="pt">Pints (pt)</option>
          <option value="qt">Quarts (qt)</option>
          <option value="gal-us">US Gallons</option>
          <option value="gal-uk">Imperial Gallons</option>
        </select>
      </div>
    </div>

    <!-- Results grid -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Convert Between Cups, Liters, Gallons, and Other Volume Units</h2>
    <p class="seo-p">
      You found a British baking recipe that lists milk as 300 mL, but your measuring cups are marked in US cups. Pouring 300 mL into a "1 cup" measure would overfill it by nearly a quarter. Enter 300, select mL, and the converter instantly shows 1.268 US cups, 10.56 fl oz, and every other equivalent. The copy button beside each result means you can paste the right measurement straight into your recipe notes.
    </p>
    <p class="seo-p">
      The converter covers 11 units from milliliters through cubic meters, including the US and imperial gallons that differ by about 20%. A homebrewer converting a 5-gallon batch recipe to liters (18.93 L) for a metric brewing kit, a nurse converting fluid ounces to milliliters for medication dosing, or a fuel buyer comparing pump prices in liters versus gallons — all get their answer without leaving the page. The quick-reference row at the bottom translates the current value into everyday objects: a teaspoon at 4.93 mL, a wine bottle at 750 mL, a bathtub at 300,000 mL.
    </p>

    <h3 class="font-display seo-h3-sm">Cooking conversions where precision actually matters</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Scaling a British recipe for a US kitchen', 'A Mary Berry cake recipe calls for 225 g of butter — but your US measuring cup reads volume, not weight. Butter has a density of about 0.911 g/mL, so 225 g equals roughly 247 mL. A US cup is 236.588 mL, so you need just over 1 cup. The volume converter helps you cross-reference: enter 247 mL and see that equals 1.044 US cups, 8.35 US fl oz, or 15.74 metric tablespoons. Getting this right means the difference between a cake that rises and one that collapses.'],
        ['Medication dosing across measurement systems', 'A pharmacist in the US receives a prescription written in milliliters but the measuring syringe is marked in teaspoons. A 10 mL dose equals exactly 2.029 US teaspoons. For pediatric dosing, where a 0.5 mL error can mean a 10% overdose on a 5 mL dose, the exact conversion matters. The tool converts between mL, tsp, tbsp, and fl oz so the pharmacist can select the closest safe mark on the syringe.'],
        ['Homebrewing beer with imperial-to-metric ingredients', 'A homebrewer in Canada follows an American recipe calling for 5 US gallons of wort. Converting to liters gives 18.927 L. But the yeast pitching rate is specified per liter, and the malt extract is sold in kilograms per liter. The volume converter bridges the gap: 5 US gal = 18.927 L, which means at 0.75 million cells per mL per degree Plato, the brewer needs roughly 14.2 billion cells for a moderate-gravity ale.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/weight-mass-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Weight & Mass Converter</a>
        <a href="/tools/length-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Length Converter</a>
        <a href="/tools/temperature-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Temperature Converter</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Volume Converter Handles Cups, Gallons, and Liters</h2>
    <p class="seo-p">
      Every unit in the converter is stored as a multiple of one milliliter. When you enter 2 US gallons, the tool multiplies 2 by 3785.411784 to get 7570.823568 mL, then divides by each target unit's factor. Because all conversions pass through milliliters in a single step, there is no cascade of intermediate rounding. The result for 1 US gallon to imperial gallons is 0.832674 imp gal — not an approximation derived from rounding the individual factors first.
    </p>

    <h3 class="font-display seo-h3-sm">Why US and imperial gallons differ by exactly 20%</h3>
    <p class="seo-p-sm">
      The US gallon traces back to the wine gallon defined by Queen Anne in 1707, which was based on the medieval English wine measure of 231 cubic inches. When the British Empire reformed its measures in 1824, the imperial gallon was redefined as the volume of 10 pounds of water at 62°F — which works out to approximately 277.42 cubic inches, about 20% larger than the US gallon. The US never adopted the 1824 reform, keeping the older wine gallon. This historical accident means a US gas station selling "a gallon" is selling about 3.785 liters, while a British petrol station sells 4.546 liters per gallon.
    </p>
    <p class="seo-p-sm">
      US smaller units derive from the gallon by exact factors of 2: 1 gallon = 4 quarts = 8 pints = 16 cups = 128 fluid ounces. The metric equivalents are exact to 6+ decimal places: 1 US cup = 236.5882365 mL, 1 US fl oz = 29.5735295625 mL. The metric units (mL, L, m³) are exact powers of 10. The imperial gallon is exactly 4.54609 liters, making all imperial volume factors exact as well.
    </p>

    <h3 class="font-display seo-h3-sm">The teaspoon-tablespoon-cup hierarchy in US customary</h3>
    <p class="seo-p-sm">
      In the US system, volumes follow a clean binary subdivision: 1 cup = 16 tablespoons = 48 teaspoons. A tablespoon is exactly 3 teaspoons, and a cup is exactly 2 tablespoons times 8 (16 tbsp). This is convenient for recipe scaling — doubling a recipe that calls for 1.5 tsp of vanilla means 3 tsp = 1 tbsp exactly. The metric system does not have this hierarchical relationship: a metric tablespoon is 15 mL, a metric teaspoon is 5 mL, and a metric cup is 250 mL — so 1 metric cup = 5 tablespoons, not 16.
    </p>
    <p class="seo-p-none">
      The converter's formatting adapts to the magnitude of the result. Cubic meters for a swimming pool (2.5 million mL) display with locale separators and two decimal places. Milliliters for a single teaspoon (4.929 mL) show six decimal places. Very large or very small values switch to scientific notation. This keeps the output readable whether you are measuring a single drop or a tanker load.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How many milliliters are in 3 US cups?",
          a: "Three US cups equals exactly 709.765 mL. One US cup is 236.5882365 mL, and multiplying by 3 gives 709.7647095 mL, which rounds to 709.765 for display. If your recipe calls for 3 cups of milk, you need a measuring container marked to at least 710 mL. Most metric measuring jugs have mL markings every 25 mL, so you would fill to the 700 mL line and add roughly 10 more mL — about two-thirds of a metric tablespoon."
        },
        {
          q: "Why is a metric cup 250 mL when a US cup is 236.588 mL?",
          a: "The metric cup was defined in 1970 by the Canadian government as exactly 250 mL — a round number in the metric system. The US cup traces back to the 19th century and is defined as half a US pint (231 cubic inches), which works out to 236.588 mL. The 13.4 mL difference seems small, but over 8 cups (a common baking quantity) it adds up to 107 mL — nearly half a cup of extra flour if you use a metric cup for a US recipe."
        },
        {
          q: "How do I convert a recipe from liters to gallons?",
          a: "Divide the liter value by 3.78541 for US gallons, or by 4.54609 for imperial gallons. A recipe making 4 liters of soup equals 1.057 US gal or 0.880 imp gal. For quick mental estimates, 4 liters is roughly 1 US gallon — close enough for home cooking. The exact figure matters more when scaling commercial food production, where a 1% error across a 500-gallon batch means 5 gallons of wasted product."
        },
        {
          q: "What is the difference between a fluid ounce and a regular ounce?",
          a: "A fluid ounce measures volume, while a regular ounce measures weight. One US fluid ounce of water weighs approximately 1.043 oz (29.57 g) at room temperature — close to one ounce by weight, which is why the names are confusing. For water and similar liquids, 1 fl oz ≈ 1.04 oz weight. For denser liquids like honey (1.42 g/mL), 1 fl oz weighs about 1.47 oz. This converter handles volume only; for weight conversions, use the weight converter."
        },
        {
          q: "Can I use this to calculate fuel costs for a road trip?",
          a: "Yes, as part of a two-step calculation. If fuel is sold by the liter at $1.85/L and your car consumes 8.5 L/100km, you can use the volume converter to translate between liters and gallons. A 500 km trip uses 42.5 L of fuel. In US gallons that is 11.23 gal. At $1.85/L, the trip costs $78.63. At US prices (around $3.50/gal), the same trip costs $39.30 — demonstrating why fuel economy comparisons between metric and imperial countries can be misleading."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Unit definitions: factor to milliliters ──────────────────────
  const UNITS = [
    { id: 'ml',     label: 'Milliliters',       abbr: 'mL',    factor: 1 },
    { id: 'l',      label: 'Liters',             abbr: 'L',     factor: 1000 },
    { id: 'm3',     label: 'Cubic Meters',       abbr: 'm³',    factor: 1_000_000 },
    { id: 'tsp',    label: 'Teaspoons',          abbr: 'tsp',   factor: 4.92892 },
    { id: 'tbsp',   label: 'Tablespoons',        abbr: 'tbsp',  factor: 14.7868 },
    { id: 'floz',   label: 'Fluid Ounces',       abbr: 'fl oz', factor: 29.5735 },
    { id: 'cup',    label: 'Cups',               abbr: 'cup',   factor: 236.588 },
    { id: 'pt',     label: 'Pints',              abbr: 'pt',    factor: 473.176 },
    { id: 'qt',     label: 'Quarts',             abbr: 'qt',    factor: 946.353 },
    { id: 'gal-us', label: 'US Gallons',         abbr: 'gal',   factor: 3785.41 },
    { id: 'gal-uk', label: 'Imperial Gallons',   abbr: 'imp gal', factor: 4546.09 },
  ];

  const input  = document.getElementById('vol-input') as HTMLInputElement;
  const select = document.getElementById('vol-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  // ── Quick-reference objects (stored in milliliters) ─────────────
  const REFS = [
    { name: 'Teaspoon',         ml: 4.929 },
    { name: 'Tablespoon',       ml: 14.787 },
    { name: 'Shot Glass',       ml: 44.36 },
    { name: 'Coffee Mug',       ml: 350.0 },
    { name: 'Wine Bottle',      ml: 750.0 },
    { name: 'Bathtub',          ml: 300_000.0 },
    { name: 'Swimming Pool',    ml: 2_500_000_000.0 },
    { name: 'Olympic Pool',     ml: 2_500_000_000.0 },
  ];

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9)  return value.toExponential(4);
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6)  return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;

    grid.innerHTML = '';

    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.abbr;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = (r.ml * 1) / fromFactor;
      const display = formatResult(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
