---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'percentage-calculator')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">
      Percentage Calculator
    </h2>

    <!-- Mode selector — .toggle-group / .toggle-btn -->
    <div class="toggle-group" style="margin-bottom:1.5rem; width:100%;" role="group" aria-label="Calculation mode">
      <button class="toggle-btn active" data-mode="of" type="button" style="flex:1; text-align:center;">What is X% of Y?</button>
      <button class="toggle-btn"        data-mode="is" type="button" style="flex:1; text-align:center;">X is what % of Y?</button>
      <button class="toggle-btn"        data-mode="change" type="button" style="flex:1; text-align:center;">% Change</button>
    </div>

    <!-- Mode: "What is X% of Y?" -->
    <div id="mode-of" class="calc-mode">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Percentage (%)</label>
          <input id="of-pct" type="number" placeholder="e.g. 20" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Of value</label>
          <input id="of-val" type="number" placeholder="e.g. 500" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
      </div>
      <div class="result-card accent-blue" id="res-of" style="display:none; text-align:center;">
        <div id="res-of-sentence" style="font-family:'Sora',sans-serif; font-size:1.15rem; font-weight:500; color:var(--text-primary); line-height:1.6;"></div>
      </div>
    </div>

    <!-- Mode: "X is what % of Y?" -->
    <div id="mode-is" class="calc-mode" style="display:none;">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Value (X)</label>
          <input id="is-x" type="number" placeholder="e.g. 80" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Of total (Y)</label>
          <input id="is-y" type="number" placeholder="e.g. 200" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
      </div>
      <div class="result-card accent-blue" id="res-is" style="display:none; text-align:center;">
        <div id="res-is-sentence" style="font-family:'Sora',sans-serif; font-size:1.15rem; font-weight:500; color:var(--text-primary); line-height:1.6;"></div>
      </div>
    </div>

    <!-- Mode: "% Change" -->
    <div id="mode-change" class="calc-mode" style="display:none;">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Original value</label>
          <input id="chg-from" type="number" placeholder="e.g. 80" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">New value</label>
          <input id="chg-to" type="number" placeholder="e.g. 100" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
      </div>
      <div class="result-card" id="res-chg" style="display:none; text-align:center;">
        <div id="res-chg-sentence" style="font-family:'Sora',sans-serif; font-size:1.15rem; font-weight:500; color:var(--text-primary); line-height:1.6;"></div>
      </div>
    </div>

    <!-- Action bar -->
    <div style="display:flex; gap:0.75rem; margin-top:1.25rem; flex-wrap:wrap;">
      <button id="calc-btn" class="btn-primary" type="button">Calculate</button>
      <button id="reset-btn" class="btn-secondary" type="button">Reset</button>
    </div>

    <p id="error-msg" style="display:none; color:#EF4444; font-size:0.82rem; margin-top:0.75rem;"></p>
  </div>

  <!-- ══════════════════════════════════════════════
       SEO CONTENT — OVERVIEW & HOW TO USE
  ══════════════════════════════════════════════ -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >Three percentage calculations you probably do weekly</h2>
    <p class="seo-p" >
      You're at a restaurant and the bill is $186. You want to leave 15% but don't want to do mental math. A supplier quotes $4,200 for a project but you need to know what 22% VAT adds to the total. Your marketing dashboard shows conversions went from 340 to 415 last month and you need the percentage increase for your report. All three are the same fundamental operation — percentages — but most people reach for a spreadsheet or Google search each time. This calculator handles all three in one place: enter your numbers, pick the mode, and get the answer instantly.
    </p>
    <p class="seo-p" >
      The tool has three modes. <strong>What is X% of Y?</strong> calculates a percentage of a number — the discount amount, the tax, the tip. <strong>X is what % of Y?</strong> tells you what percentage one number is of another — your score on a test, how much of the budget you've spent, what share of the market you hold. <strong>% Change</strong> shows the relative difference between two values — useful for month-over-month growth, price increases, or performance comparisons.
    </p>
    <p class="seo-p-none" >
      Results update as you type. No button click required. Use the <em>Reset</em> button to clear everything and start over.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Who uses this calculator</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Shoppers and diners working out discounts and tips', 'A $240 jacket at 30% off costs $168 — but the "% of" mode also handles the reverse: if the jacket is now $168 and you know it was 30% off, what was the original price? Divide 168 by 0.7 to get $240. The calculator does this in one step.'],
        ['Accountants and bookkeepers reconciling invoices', 'When a supplier invoice shows a subtotal of $3,850 and a total of $4,620, the "% Change" mode instantly confirms 20% VAT was applied. Quick verification without a spreadsheet row.'],
        ['Students checking exam scores and grade boundaries', 'If you scored 67 out of 85 on a maths test, the "X is what % of Y" mode returns 78.8%. You can immediately compare that against the grade boundary — 80% for an A — to see how many more marks you needed.'],
        ['Marketing and sales teams tracking KPIs', 'Conversions jumped from 2,400 to 3,120 this quarter. The "% Change" mode returns +30% — the figure that goes straight into your slide deck. No formula in Excel, no Google search, no rounding confusion.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/compound-interest-wealth-calculator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Compound Interest & Wealth Growth Calculator</a>
        <a href="/tools/mortgage-calculator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Mortgage Amortization Calculator</a>
        <a href="/tools/cpm-ad-spend-calculator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">CPM & Digital Ad Spend ROI Calculator</a>
      </div>
    </div>
</div>

  <!-- ══════════════════════════════════════════════
       SEO CONTENT — TECHNICAL MECHANICS & APPLICATIONS
  ══════════════════════════════════════════════ -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >The three formulas and when each one applies</h2>
    <p class="seo-p" >
      Every percentage problem reduces to one of three arithmetic expressions. This calculator identifies which one you need based on which mode tab you select, then executes it on every keystroke so the answer is always current.
    </p>

    <h3 class="font-display seo-h3-sm" >The formulas</h3>
    <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1rem">
      <div class="info-row">
        <span class="info-label">X% of Y</span>
        <span class="info-value">Result = Y × (X ÷ 100)</span>
      </div>
      <div class="info-row">
        <span class="info-label">X is what % of Y</span>
        <span class="info-value">Result = (X ÷ Y) × 100</span>
      </div>
      <div class="info-row">
        <span class="info-label">% Change</span>
        <span class="info-value">Result = ((New − Old) ÷ |Old|) × 100</span>
      </div>
    </div>

    <h3 class="font-display seo-h3-sm" >How each formula works in practice</h3>
    <p class="seo-p" >
      <strong>X% of Y</strong> is the most straightforward: divide the percentage by 100 to get a decimal, then multiply. A 20% discount on $150 is 150 × 0.20 = $30. A 7% tax on $84.50 is 84.50 × 0.07 = $5.915, which rounds to $5.92. The division by 100 is the key step that most people skip when doing this in their head — "20% of 150" feels like it should be 150 × 20, but it's 150 × 0.20.
    </p>
    <p class="seo-p" >
      <strong>X is what % of Y</strong> flips the operation: you know the part and the whole, and need the ratio. 45 out of 180 on a test is (45 ÷ 180) × 100 = 25%. Your team closed 12 out of 48 deals this quarter: (12 ÷ 48) × 100 = 25% close rate. The same formula works for market share: if your company has $3.2M in revenue out of a $28M market, your share is (3.2 ÷ 28) × 100 = 11.4%.
    </p>
    <p class="seo-p" >
      <strong>% Change</strong> is the most error-prone because the order matters. Going from 80 to 100 is a +25% increase: ((100 − 80) ÷ 80) × 100 = 25%. But going from 100 back to 80 is a −20% decrease: ((80 − 100) ÷ 100) × 100 = −20%. The same absolute difference (20 units) produces different percentages because the base changes. The formula uses the absolute value of the original to handle negative inputs correctly — a price drop from −$5 to −$3 is a 40% change, not a sign-flipped result.
    </p>

    <h3 class="font-display seo-h3-sm" >Why results update as you type</h3>
    <p class="seo-p" >
      The calculator attaches an <code>input</code> event listener to every field. Each keystroke triggers a recalculation, so the answer is always current without pressing a button. This is faster than a "Calculate" button workflow for quick checks — you type "20" and "150" and the answer "30" appears before your finger leaves the keyboard. If any field is empty or contains non-numeric text, the result clears automatically to avoid showing a stale number.
    </p>

    <h3 class="font-display seo-h3-sm" >Handling edge cases</h3>
    <p class="seo-p" >
      Division by zero is the most dangerous percentage error. If the denominator is zero — for example, asking "what % of 0 is 5?" — the calculator catches it before computing and shows a clear error message instead of <code>Infinity</code> or <code>NaN</code>. Negative denominators in "% Change" mode are handled correctly: a price going from −$50 to −$30 is a 40% increase (the formula divides by the absolute value of the original). Empty fields are treated as <code>NaN</code>, which triggers the validation check and prevents partial results from displaying.
    </p>
  </div>

  <!-- ══════════════════════════════════════════════
       SEO CONTENT — FAQ
  ══════════════════════════════════════════════ -->
  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How do I calculate a percentage increase?",
          a: "Switch to the '% Change' mode. Enter the original value (the lower number) in the 'Original value' field and the new value (the higher number) in the 'New value' field. The calculator returns the percentage increase as a positive number. For example, going from 80 to 100 yields +25%. The same mode handles decreases — entering a higher original and lower new value produces a negative percentage. A price drop from $200 to $150 shows −25%, which is the correct figure for your margin calculation."
        },
        {
          q: "What is the formula for a percentage discount?",
          a: "Use the 'What is X% of Y?' mode: enter the discount percentage (e.g. 20) and the original price (e.g. 150). The result (30) is the discount amount. Subtract it from the original price to get the final sale price ($120). For a quick check: a 20% discount means you pay 80% of the original, so multiply 150 by 0.80 directly. Both methods give $120. This two-step approach works for any discount structure, including stacked promotions where a second discount applies to the already-reduced price."
        },
        {
          q: "Can I calculate reverse percentages?",
          a: "Yes — the 'X is what % of Y?' mode handles this directly. Enter the part value (X) and the total (Y). The calculator returns what percentage the part represents. If a product is now $168 after a 30% discount, you can verify the original price by entering 168 as X and working backward: 168 ÷ 0.70 = $240. This is also useful for determining completion rates, market share, or what fraction of a budget has been spent."
        },
        {
          q: "How do I work out a tip?",
          a: "Enter the tip percentage (e.g. 15 or 20) and the bill total in the 'What is X% of Y?' mode. The result is the tip amount in dollars. For a $186 bill at 15%, the tip is $27.90, making the total $213.90. For split bills, divide the tip amount by the number of people before adding each person's share of the food cost. If four people split a $186 bill with a $27.90 tip, each person pays $53.48 ($46.50 food + $6.98 tip)."
        },
        {
          q: "What happens if I enter zero as the denominator?",
          a: "The calculator catches division by zero before computing and shows a clear error message instead of Infinity or NaN. In '% Change' mode, the original value cannot be zero because the formula divides by it — a move from $0 to $50 is mathematically undefined as a percentage. In 'X is what % of Y?' mode, Y cannot be zero for the same reason. This validation runs on every keystroke, so you'll see the error immediately rather than after clicking a button."
        },
        {
          q: "Why does the result update as I type instead of only after clicking Calculate?",
          a: "The tool listens for the 'input' event on every field, triggering a recalculation on each keystroke. This gives immediate feedback — you type '20' in the percentage field and '150' in the value field, and '30' appears before your finger leaves the keyboard. The Calculate button still works if you prefer a deliberate action, but the auto-update is faster for quick checks. If any field is empty or contains non-numeric text, the result clears automatically to prevent showing a stale number."
        },
        {
          q: "How do I find what percentage one number is of another?",
          a: "Use the 'X is what % of Y?' mode. Enter the first number as X (the part) and the second as Y (the whole). The result is the percentage. For example, 45 out of 180 on a test returns 25%. Your team's $3.2M revenue in a $28M market gives 11.4% market share. A completed project showing 847 out of 1,200 tasks done returns 70.6% — useful for status reports. This is the most versatile of the three modes because it answers 'how much of the total do I have?'"
        },
        {
          q: "Can I use this calculator for compound percentage changes?",
          a: "This tool handles single-step calculations. For compound changes — for example, a 10% price increase followed by a 15% discount — apply each change sequentially: calculate the first percentage, note the result, then use that as the input for the second. On a $200 item: 10% increase = $220, then 15% discount on $220 = $33 off, final price $187. The net effect is actually a −7% change overall, which the '% Change' mode confirms when you compare $200 to $187."
        },
        {
          q: "How is this different from Excel's percentage formulas?",
          a: "Excel requires you to remember formula syntax (=A1*20%, =B1/A1*100, =(B1-A1)/ABS(A1)*100) and set up cells correctly. This calculator gives you three clearly labelled modes with no formula setup. For quick, one-off percentage calculations — a discount at the store, a tip, a test score — it's faster than opening a spreadsheet. For ongoing calculations with linked data, Excel is more powerful. Use whichever fits the task."
        },
        {
          q: "Why does a 50% decrease require a 100% increase to get back to the original?",
          a: "This is the base-change problem that catches everyone. A $100 item at 50% off costs $50. To get back to $100 from $50, you need a $50 increase on a $50 base — which is 100%, not 50%. The '% Change' mode handles this correctly because it always divides by the current value, not the original. This asymmetry is why percentage changes are misleading without specifying the base: '50% off' sounds equal to '50% increase' but they aren't inverse operations."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>

    <div style="margin-top:1.25rem; padding-top:1rem; border-top:1px solid var(--border); font-size:0.78rem; color:var(--text-muted); line-height:1.8">
      <strong class="text-primary" style="color:var(--text-secondary)">References:</strong>
      <a href="https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Number/toLocaleString" target="_blank" rel="noopener noreferrer" style="color:#1D4ED8; text-decoration:none">MDN — Number.toLocaleString()</a> ·
      <a href="https://tc39.es/ecma262/#sec-ecmascript-language-types-number-type" target="_blank" rel="noopener noreferrer" style="color:#1D4ED8; text-decoration:none">ECMA-262 Number Type (IEEE 754)</a> ·
      <a href="https://www.investopedia.com/terms/p/percentage-change.asp" target="_blank" rel="noopener noreferrer" style="color:#1D4ED8; text-decoration:none">Investopedia — Percentage Change</a>
    </div>
  </div>

</ToolLayout>

<script>
  // ── Mode switching ────────────────────────────────────────
  const modeBtns  = document.querySelectorAll<HTMLButtonElement>('[data-mode]');
  const modePanels: Record<string, HTMLElement> = {
    of:     document.getElementById('mode-of')!,
    is:     document.getElementById('mode-is')!,
    change: document.getElementById('mode-change')!,
  };
  let activeMode = 'of';

  modeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.mode!;
      activeMode = mode;

      modeBtns.forEach(b => {
        b.classList.toggle('active', b.dataset.mode === mode);
        b.setAttribute('aria-pressed', String(b.dataset.mode === mode));
      });

      Object.entries(modePanels).forEach(([key, panel]) => {
        panel.style.display = key === mode ? '' : 'none';
      });

      hideResults();
      clearError();
    });
  });

  // ── Helpers ───────────────────────────────────────────────
  function hideResults() {
    ['res-of','res-is','res-chg'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });
  }

  function clearError() {
    const err = document.getElementById('error-msg')!;
    err.style.display = 'none';
  }

  function showError(msg: string) {
    const err = document.getElementById('error-msg')!;
    err.textContent = msg;
    err.style.display = 'block';
  }

  function fmt(n: number) {
    return parseFloat(n.toFixed(6)).toLocaleString();
  }

  function showSentence(cardId: string, sentenceId: string, html: string, isNegative = false) {
    const card = document.getElementById(cardId)!;
    const el = document.getElementById(sentenceId)!;
    card.classList.remove('accent-blue','accent-success','accent-warning','accent-red');
    card.classList.add(isNegative ? 'accent-warning' : 'accent-success');
    el.innerHTML = html;
    card.style.display = '';
  }

  // ── Calculations ──────────────────────────────────────────
  function calculate() {
    clearError();
    hideResults();

    if (activeMode === 'of') {
      const pct = parseFloat((document.getElementById('of-pct') as HTMLInputElement).value);
      const val = parseFloat((document.getElementById('of-val') as HTMLInputElement).value);
      if (isNaN(pct) || isNaN(val)) { showError('Please enter both values.'); return; }
      const result = val * (pct / 100);
      showSentence('res-of', 'res-of-sentence',
        `${fmt(pct)}% of ${fmt(val)} is <span style="color:var(--color-brand-blue);">${fmt(result)}</span>`
      );
    }

    else if (activeMode === 'is') {
      const x = parseFloat((document.getElementById('is-x') as HTMLInputElement).value);
      const y = parseFloat((document.getElementById('is-y') as HTMLInputElement).value);
      if (isNaN(x) || isNaN(y) || y === 0) { showError('Please enter two values (Y cannot be zero).'); return; }
      const result = (x / y) * 100;
      showSentence('res-is', 'res-is-sentence',
        `${fmt(x)} is <span style="color:var(--color-brand-blue);">${parseFloat(result.toFixed(2))}%</span> of ${fmt(y)}`
      );
    }

    else if (activeMode === 'change') {
      const from = parseFloat((document.getElementById('chg-from') as HTMLInputElement).value);
      const to   = parseFloat((document.getElementById('chg-to') as HTMLInputElement).value);
      if (isNaN(from) || isNaN(to) || from === 0) { showError('Please enter both values (original cannot be zero).'); return; }
      const change = ((to - from) / Math.abs(from)) * 100;
      const isDecrease = change < 0;
      const sign = isDecrease ? '' : '+';
      showSentence('res-chg', 'res-chg-sentence',
        `<span style="color:var(--color-brand-blue);">${fmt(from)}</span> became <span style="color:var(--color-brand-blue);">${fmt(to)}</span> — a <span style="color:${isDecrease ? '#D97706' : 'var(--color-brand-blue)'};">${sign}${parseFloat(change.toFixed(2))}%</span> ${isDecrease ? 'decrease' : 'increase'}`,
        isDecrease
      );
    }
  }

  function reset() {
    document.querySelectorAll<HTMLInputElement>('.tool-card-surface input[type="number"]')
      .forEach(el => { el.value = ''; });
    hideResults();
    clearError();
  }

  document.getElementById('calc-btn')!.addEventListener('click', calculate);
  document.getElementById('reset-btn')!.addEventListener('click', reset);

  // Auto-calculate on input
  document.querySelectorAll<HTMLInputElement>('.tool-card-surface input').forEach(input => {
    input.addEventListener('input', calculate);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') calculate(); });
  });
</script>
