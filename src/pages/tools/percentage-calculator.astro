---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'percentage-calculator')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">
      Percentage Calculator
    </h2>

    <!-- Mode selector — .toggle-group / .toggle-btn -->
    <div class="toggle-group" style="margin-bottom:1.5rem; width:100%;" role="group" aria-label="Calculation mode">
      <button class="toggle-btn active" data-mode="of" type="button" style="flex:1; text-align:center;">What is X% of Y?</button>
      <button class="toggle-btn"        data-mode="is" type="button" style="flex:1; text-align:center;">X is what % of Y?</button>
      <button class="toggle-btn"        data-mode="change" type="button" style="flex:1; text-align:center;">% Change</button>
    </div>

    <!-- Mode: "What is X% of Y?" -->
    <div id="mode-of" class="calc-mode">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Percentage (%)</label>
          <input id="of-pct" type="number" placeholder="e.g. 20" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Of value</label>
          <input id="of-val" type="number" placeholder="e.g. 500" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
      </div>
      <div class="result-card accent-blue" id="res-of" style="display:none; text-align:center;">
        <div id="res-of-sentence" style="font-family:'Sora',sans-serif; font-size:1.15rem; font-weight:500; color:var(--text-primary); line-height:1.6;"></div>
      </div>
    </div>

    <!-- Mode: "X is what % of Y?" -->
    <div id="mode-is" class="calc-mode" style="display:none;">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Value (X)</label>
          <input id="is-x" type="number" placeholder="e.g. 80" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Of total (Y)</label>
          <input id="is-y" type="number" placeholder="e.g. 200" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
      </div>
      <div class="result-card accent-blue" id="res-is" style="display:none; text-align:center;">
        <div id="res-is-sentence" style="font-family:'Sora',sans-serif; font-size:1.15rem; font-weight:500; color:var(--text-primary); line-height:1.6;"></div>
      </div>
    </div>

    <!-- Mode: "% Change" -->
    <div id="mode-change" class="calc-mode" style="display:none;">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Original value</label>
          <input id="chg-from" type="number" placeholder="e.g. 80" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">New value</label>
          <input id="chg-to" type="number" placeholder="e.g. 100" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
      </div>
      <div class="result-card" id="res-chg" style="display:none; text-align:center;">
        <div id="res-chg-sentence" style="font-family:'Sora',sans-serif; font-size:1.15rem; font-weight:500; color:var(--text-primary); line-height:1.6;"></div>
      </div>
    </div>

    <!-- Action bar -->
    <div style="display:flex; gap:0.75rem; margin-top:1.25rem; flex-wrap:wrap;">
      <button id="calc-btn" class="btn-primary" type="button">Calculate</button>
      <button id="reset-btn" class="btn-secondary" type="button">Reset</button>
    </div>

    <p id="error-msg" style="display:none; color:#EF4444; font-size:0.82rem; margin-top:0.75rem;"></p>
  </div>

  <!-- HOW TO USE ───────────────────────────────── -->
  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Percentage Calculator</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Choose a calculation mode using the tabs. <strong>What is X% of Y?</strong> finds a percentage of a value — for example, 20% of 500. <strong>X is what % of Y?</strong> calculates what percentage one number is of another. <strong>% Change</strong> calculates the percentage increase or decrease between two values.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      Enter your values and click Calculate — or just tab between fields and the result updates automatically.
    </p>
  </div>

  <!-- HOW IT WORKS ────────────────────────────── -->
  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.875rem;">Formulas used</h2>
    <div style="display:flex; flex-direction:column; gap:0.5rem;">
      <div class="info-row">
        <span class="info-label">X% of Y</span>
        <span class="info-value">Result = Y × (X ÷ 100)</span>
      </div>
      <div class="info-row">
        <span class="info-label">X is what % of Y</span>
        <span class="info-value">Result = (X ÷ Y) × 100</span>
      </div>
      <div class="info-row">
        <span class="info-label">% Change</span>
        <span class="info-value">Result = ((New − Old) ÷ Old) × 100</span>
      </div>
    </div>
  </div>

  <!-- FAQ ─────────────────────────────────────── -->
  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How do I calculate a percentage increase?",
          a: "Use the % Change mode. Enter the original value, then the new (higher) value. The calculator returns the percentage increase. For example, going from 80 to 100 is a 25% increase."
        },
        {
          q: "What is the formula for percentage discount?",
          a: "To find the discounted price, use the 'What is X% of Y?' mode: enter the discount percentage and the original price. Subtract the result from the original price to get the sale price."
        },
        {
          q: "Can I calculate reverse percentages?",
          a: "Yes — use the 'X is what % of Y?' mode. Enter the part value and the total, and the calculator returns what percentage the part represents."
        },
        {
          q: "How do I work out a tip?",
          a: "Enter the tip percentage (e.g. 15) and the bill total in the 'What is X% of Y?' mode. The result is the tip amount. Add it to your bill total for the final amount."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  // ── Mode switching ────────────────────────────────────────
  const modeBtns  = document.querySelectorAll<HTMLButtonElement>('[data-mode]');
  const modePanels: Record<string, HTMLElement> = {
    of:     document.getElementById('mode-of')!,
    is:     document.getElementById('mode-is')!,
    change: document.getElementById('mode-change')!,
  };
  let activeMode = 'of';

  modeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.mode!;
      activeMode = mode;

      modeBtns.forEach(b => {
        b.classList.toggle('active', b.dataset.mode === mode);
        b.setAttribute('aria-pressed', String(b.dataset.mode === mode));
      });

      Object.entries(modePanels).forEach(([key, panel]) => {
        panel.style.display = key === mode ? '' : 'none';
      });

      hideResults();
      clearError();
    });
  });

  // ── Helpers ───────────────────────────────────────────────
  function hideResults() {
    ['res-of','res-is','res-chg'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });
  }

  function clearError() {
    const err = document.getElementById('error-msg')!;
    err.style.display = 'none';
  }

  function showError(msg: string) {
    const err = document.getElementById('error-msg')!;
    err.textContent = msg;
    err.style.display = 'block';
  }

  function fmt(n: number) {
    return parseFloat(n.toFixed(6)).toLocaleString();
  }

  function showSentence(cardId: string, sentenceId: string, html: string, isNegative = false) {
    const card = document.getElementById(cardId)!;
    const el = document.getElementById(sentenceId)!;
    card.classList.remove('accent-blue','accent-success','accent-warning','accent-red');
    card.classList.add(isNegative ? 'accent-warning' : 'accent-success');
    el.innerHTML = html;
    card.style.display = '';
  }

  // ── Calculations ──────────────────────────────────────────
  function calculate() {
    clearError();
    hideResults();

    if (activeMode === 'of') {
      const pct = parseFloat((document.getElementById('of-pct') as HTMLInputElement).value);
      const val = parseFloat((document.getElementById('of-val') as HTMLInputElement).value);
      if (isNaN(pct) || isNaN(val)) { showError('Please enter both values.'); return; }
      const result = val * (pct / 100);
      showSentence('res-of', 'res-of-sentence',
        `${fmt(pct)}% of ${fmt(val)} is <span style="color:var(--color-brand-blue);">${fmt(result)}</span>`
      );
    }

    else if (activeMode === 'is') {
      const x = parseFloat((document.getElementById('is-x') as HTMLInputElement).value);
      const y = parseFloat((document.getElementById('is-y') as HTMLInputElement).value);
      if (isNaN(x) || isNaN(y) || y === 0) { showError('Please enter two values (Y cannot be zero).'); return; }
      const result = (x / y) * 100;
      showSentence('res-is', 'res-is-sentence',
        `${fmt(x)} is <span style="color:var(--color-brand-blue);">${parseFloat(result.toFixed(2))}%</span> of ${fmt(y)}`
      );
    }

    else if (activeMode === 'change') {
      const from = parseFloat((document.getElementById('chg-from') as HTMLInputElement).value);
      const to   = parseFloat((document.getElementById('chg-to') as HTMLInputElement).value);
      if (isNaN(from) || isNaN(to) || from === 0) { showError('Please enter both values (original cannot be zero).'); return; }
      const change = ((to - from) / Math.abs(from)) * 100;
      const isDecrease = change < 0;
      const sign = isDecrease ? '' : '+';
      showSentence('res-chg', 'res-chg-sentence',
        `<span style="color:var(--color-brand-blue);">${fmt(from)}</span> became <span style="color:var(--color-brand-blue);">${fmt(to)}</span> — a <span style="color:${isDecrease ? '#D97706' : 'var(--color-brand-blue)'};">${sign}${parseFloat(change.toFixed(2))}%</span> ${isDecrease ? 'decrease' : 'increase'}`,
        isDecrease
      );
    }
  }

  function reset() {
    document.querySelectorAll<HTMLInputElement>('.tool-card-surface input[type="number"]')
      .forEach(el => { el.value = ''; });
    hideResults();
    clearError();
  }

  document.getElementById('calc-btn')!.addEventListener('click', calculate);
  document.getElementById('reset-btn')!.addEventListener('click', reset);

  // Auto-calculate on input
  document.querySelectorAll<HTMLInputElement>('.tool-card-surface input').forEach(input => {
    input.addEventListener('input', calculate);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') calculate(); });
  });
</script>
