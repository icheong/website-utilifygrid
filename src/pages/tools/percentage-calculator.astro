---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'percentage-calculator')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">
      Percentage Calculator
    </h2>

    <!-- Mode selector — .toggle-group / .toggle-btn -->
    <div class="toggle-group" style="margin-bottom:1.5rem; width:100%;" role="group" aria-label="Calculation mode">
      <button class="toggle-btn active" data-mode="of" type="button" style="flex:1; text-align:center;">What is X% of Y?</button>
      <button class="toggle-btn"        data-mode="is" type="button" style="flex:1; text-align:center;">X is what % of Y?</button>
      <button class="toggle-btn"        data-mode="change" type="button" style="flex:1; text-align:center;">% Change</button>
    </div>

    <!-- Mode: "What is X% of Y?" -->
    <div id="mode-of" class="calc-mode">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Percentage (%)</label>
          <input id="of-pct" type="number" placeholder="e.g. 20" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Of value</label>
          <input id="of-val" type="number" placeholder="e.g. 500" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
      </div>
      <div class="result-card accent-blue" id="res-of" style="display:none; text-align:center;">
        <div id="res-of-sentence" style="font-family:'Sora',sans-serif; font-size:1.15rem; font-weight:500; color:var(--text-primary); line-height:1.6;"></div>
      </div>
    </div>

    <!-- Mode: "X is what % of Y?" -->
    <div id="mode-is" class="calc-mode" style="display:none;">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Value (X)</label>
          <input id="is-x" type="number" placeholder="e.g. 80" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Of total (Y)</label>
          <input id="is-y" type="number" placeholder="e.g. 200" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
      </div>
      <div class="result-card accent-blue" id="res-is" style="display:none; text-align:center;">
        <div id="res-is-sentence" style="font-family:'Sora',sans-serif; font-size:1.15rem; font-weight:500; color:var(--text-primary); line-height:1.6;"></div>
      </div>
    </div>

    <!-- Mode: "% Change" -->
    <div id="mode-change" class="calc-mode" style="display:none;">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Original value</label>
          <input id="chg-from" type="number" placeholder="e.g. 80" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">New value</label>
          <input id="chg-to" type="number" placeholder="e.g. 100" class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
      </div>
      <div class="result-card" id="res-chg" style="display:none; text-align:center;">
        <div id="res-chg-sentence" style="font-family:'Sora',sans-serif; font-size:1.15rem; font-weight:500; color:var(--text-primary); line-height:1.6;"></div>
      </div>
    </div>

    <!-- Action bar -->
    <div style="display:flex; gap:0.75rem; margin-top:1.25rem; flex-wrap:wrap;">
      <button id="calc-btn" class="btn-primary" type="button">Calculate</button>
      <button id="reset-btn" class="btn-secondary" type="button">Reset</button>
    </div>

    <p id="error-msg" style="display:none; color:#EF4444; font-size:0.82rem; margin-top:0.75rem;"></p>
  </div>

  <!-- ══════════════════════════════════════════════
       SEO CONTENT — OVERVIEW & HOW TO USE
  ══════════════════════════════════════════════ -->
  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.875rem;">Percentage Calculator — Instant Browser-Based Math</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Percentage calculations appear in everyday work — invoice discounts, tax estimates, grade conversions, and KPI dashboards. This tool computes three core percentage operations entirely in-browser using vanilla JavaScript. No data leaves your device; there is no server round-trip, no account required, and no tracking. The computation runs on the IEEE 754 double-precision floating-point pipeline that every modern browser provides, delivering sub-millisecond results.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      <strong>What is X% of Y?</strong> multiplies a percentage by a base value — useful for discounts, tips, or tax. <strong>X is what % of Y?</strong> divides a part by the whole and scales to 100 — useful for scoring, completion rates, and market share. <strong>% Change</strong> computes the relative difference between two values — useful for growth metrics, price changes, and performance deltas.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      Select a mode tab, enter your numbers, and click <em>Calculate</em> — or press Tab to move between fields; the result updates on every keystroke. Use <em>Reset</em> to clear all fields and return to the initial state.
    </p>
  </div>

  <!-- ══════════════════════════════════════════════
       SEO CONTENT — TECHNICAL MECHANICS & APPLICATIONS
  ══════════════════════════════════════════════ -->
  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.875rem;">Formulas, Technical Mechanics &amp; Use Cases</h2>

    <h3 style="font-size:0.95rem; font-weight:600; color:var(--text-primary); margin:1rem 0 0.5rem;">Core Formulas</h3>
    <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1rem;">
      <div class="info-row">
        <span class="info-label">X% of Y</span>
        <span class="info-value">Result = Y × (X ÷ 100)</span>
      </div>
      <div class="info-row">
        <span class="info-label">X is what % of Y</span>
        <span class="info-value">Result = (X ÷ Y) × 100</span>
      </div>
      <div class="info-row">
        <span class="info-label">% Change</span>
        <span class="info-value">Result = ((New − Old) ÷ |Old|) × 100</span>
      </div>
    </div>

    <h3 style="font-size:0.95rem; font-weight:600; color:var(--text-primary); margin:1rem 0 0.5rem;">How the Computation Works</h3>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Each mode follows a single arithmetic expression. <strong>X% of Y</strong> divides the percentage by 100 to produce a decimal multiplier, then multiplies by the base value. <strong>X is what % of Y</strong> divides the part by the whole, then multiplies by 100 to express the ratio as a percentage. <strong>% Change</strong> subtracts the original from the new value, divides by the absolute value of the original (to handle both increases and decreases correctly), and multiplies by 100. The absolute-value step prevents a sign flip when the original value is negative — a common source of errors in manual calculations.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Results are rounded to at most six decimal places before formatting, then displayed with locale-aware thousand separators via <code>toLocaleString()</code>. This avoids floating-point display artefacts such as <code>0.30000000000000004</code> while preserving full precision during intermediate steps. Division-by-zero is caught before computation: if the denominator is zero, the tool returns a clear error instead of <code>Infinity</code> or <code>NaN</code>.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:1rem;">
      Edge cases handled include negative inputs (valid — the % Change mode uses the absolute value of the original), zero denominators (blocked with an error), and empty fields (treated as <code>NaN</code>, which triggers validation). The auto-calculate listener fires on every <code>input</code> event, so partial entries do not produce stale results.
    </p>

    <h3 style="font-size:0.95rem; font-weight:600; color:var(--text-primary); margin:1rem 0 0.5rem;">Real-World Applications</h3>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.5rem;">
      <strong>Retail and invoicing.</strong> Apply a 15% discount to a line-item total, or calculate 8% sales tax on an invoice subtotal. The "What is X% of Y?" mode returns the exact amount to deduct or add, eliminating manual multiplication errors on receipts and purchase orders.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.5rem;">
      <strong>Academic grading.</strong> A student scored 42 out of 60 on an exam. The "X is what % of Y?" mode returns 70%, which maps directly to a letter grade. Teachers and students use this to convert raw scores to percentages without a spreadsheet.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      <strong>Business metrics.</strong> Monthly active users grew from 8,200 to 11,500. The "% Change" mode returns +40.24%, giving product managers an instant growth figure for stakeholder reports. This avoids the common mistake of dividing by the new value instead of the original.
    </p>
  </div>

  <!-- ══════════════════════════════════════════════
       SEO CONTENT — FAQ
  ══════════════════════════════════════════════ -->
  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How do I calculate a percentage increase?",
          a: "Switch to the '% Change' mode. Enter the original (lower) value in the 'Original value' field and the new (higher) value in the 'New value' field. The calculator returns the percentage increase as a positive number. For example, going from 80 to 100 yields +25%. The same mode handles decreases — entering a higher original and lower new value produces a negative percentage."
        },
        {
          q: "What is the formula for a percentage discount?",
          a: "Use the 'What is X% of Y?' mode: enter the discount percentage (e.g. 20) and the original price (e.g. 150). The result (30) is the discount amount. Subtract it from the original price to get the final sale price (120). This two-step approach works for any discount structure, including stacked or tiered promotions."
        },
        {
          q: "Can I calculate reverse percentages?",
          a: "Yes — the 'X is what % of Y?' mode is designed for this. Enter the part value (X) and the total (Y). The calculator returns what percentage the part represents out of 100. This is useful for determining completion rates, market share, or what fraction of a budget has been spent."
        },
        {
          q: "How do I work out a tip?",
          a: "Enter the tip percentage (e.g. 15 or 20) and the bill total in the 'What is X% of Y?' mode. The result is the tip amount in dollars. Add it to the original bill to get the total you should pay. For split bills, divide the tip amount by the number of people before adding each person's share of the food cost."
        },
        {
          q: "What happens if I enter zero as the denominator?",
          a: "The calculator detects division by zero before performing the operation and displays a clear error message. In '% Change' mode, the original value cannot be zero because the formula divides by it. In 'X is what % of Y?' mode, Y cannot be zero. This prevents IEEE 754 Infinity or NaN results from appearing in the output."
        },
        {
          q: "Why does the result update as I type instead of only after clicking Calculate?",
          a: "The tool listens for the 'input' event on every field, triggering a recalculation on each keystroke. This gives immediate feedback and eliminates the need to press a button for quick checks. If any field is empty or contains non-numeric text, the result clears automatically until valid numbers are provided."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  // ── Mode switching ────────────────────────────────────────
  const modeBtns  = document.querySelectorAll<HTMLButtonElement>('[data-mode]');
  const modePanels: Record<string, HTMLElement> = {
    of:     document.getElementById('mode-of')!,
    is:     document.getElementById('mode-is')!,
    change: document.getElementById('mode-change')!,
  };
  let activeMode = 'of';

  modeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.mode!;
      activeMode = mode;

      modeBtns.forEach(b => {
        b.classList.toggle('active', b.dataset.mode === mode);
        b.setAttribute('aria-pressed', String(b.dataset.mode === mode));
      });

      Object.entries(modePanels).forEach(([key, panel]) => {
        panel.style.display = key === mode ? '' : 'none';
      });

      hideResults();
      clearError();
    });
  });

  // ── Helpers ───────────────────────────────────────────────
  function hideResults() {
    ['res-of','res-is','res-chg'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });
  }

  function clearError() {
    const err = document.getElementById('error-msg')!;
    err.style.display = 'none';
  }

  function showError(msg: string) {
    const err = document.getElementById('error-msg')!;
    err.textContent = msg;
    err.style.display = 'block';
  }

  function fmt(n: number) {
    return parseFloat(n.toFixed(6)).toLocaleString();
  }

  function showSentence(cardId: string, sentenceId: string, html: string, isNegative = false) {
    const card = document.getElementById(cardId)!;
    const el = document.getElementById(sentenceId)!;
    card.classList.remove('accent-blue','accent-success','accent-warning','accent-red');
    card.classList.add(isNegative ? 'accent-warning' : 'accent-success');
    el.innerHTML = html;
    card.style.display = '';
  }

  // ── Calculations ──────────────────────────────────────────
  function calculate() {
    clearError();
    hideResults();

    if (activeMode === 'of') {
      const pct = parseFloat((document.getElementById('of-pct') as HTMLInputElement).value);
      const val = parseFloat((document.getElementById('of-val') as HTMLInputElement).value);
      if (isNaN(pct) || isNaN(val)) { showError('Please enter both values.'); return; }
      const result = val * (pct / 100);
      showSentence('res-of', 'res-of-sentence',
        `${fmt(pct)}% of ${fmt(val)} is <span style="color:var(--color-brand-blue);">${fmt(result)}</span>`
      );
    }

    else if (activeMode === 'is') {
      const x = parseFloat((document.getElementById('is-x') as HTMLInputElement).value);
      const y = parseFloat((document.getElementById('is-y') as HTMLInputElement).value);
      if (isNaN(x) || isNaN(y) || y === 0) { showError('Please enter two values (Y cannot be zero).'); return; }
      const result = (x / y) * 100;
      showSentence('res-is', 'res-is-sentence',
        `${fmt(x)} is <span style="color:var(--color-brand-blue);">${parseFloat(result.toFixed(2))}%</span> of ${fmt(y)}`
      );
    }

    else if (activeMode === 'change') {
      const from = parseFloat((document.getElementById('chg-from') as HTMLInputElement).value);
      const to   = parseFloat((document.getElementById('chg-to') as HTMLInputElement).value);
      if (isNaN(from) || isNaN(to) || from === 0) { showError('Please enter both values (original cannot be zero).'); return; }
      const change = ((to - from) / Math.abs(from)) * 100;
      const isDecrease = change < 0;
      const sign = isDecrease ? '' : '+';
      showSentence('res-chg', 'res-chg-sentence',
        `<span style="color:var(--color-brand-blue);">${fmt(from)}</span> became <span style="color:var(--color-brand-blue);">${fmt(to)}</span> — a <span style="color:${isDecrease ? '#D97706' : 'var(--color-brand-blue)'};">${sign}${parseFloat(change.toFixed(2))}%</span> ${isDecrease ? 'decrease' : 'increase'}`,
        isDecrease
      );
    }
  }

  function reset() {
    document.querySelectorAll<HTMLInputElement>('.tool-card-surface input[type="number"]')
      .forEach(el => { el.value = ''; });
    hideResults();
    clearError();
  }

  document.getElementById('calc-btn')!.addEventListener('click', calculate);
  document.getElementById('reset-btn')!.addEventListener('click', reset);

  // Auto-calculate on input
  document.querySelectorAll<HTMLInputElement>('.tool-card-surface input').forEach(input => {
    input.addEventListener('input', calculate);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') calculate(); });
  });
</script>
