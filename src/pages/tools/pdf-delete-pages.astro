---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'pdf-delete-pages')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Delete Pages</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Click pages to select them for removal, then download the PDF without those pages.</p>

    <div id="drop-zone" style="border:2px dashed var(--border);border-radius:0.875rem;padding:2.5rem 1rem;text-align:center;cursor:pointer;transition:border-color 0.2s,background 0.2s;background:var(--bg-surface);">
      <p style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:0.4rem;">Drop a PDF file here</p>
      <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:0.75rem;">or click to browse</p>
      <input id="file-input" type="file" accept=".pdf" style="display:none;" />
      <button id="browse-btn" class="btn-secondary" type="button" style="font-size:0.82rem;">Browse File</button>
    </div>

    <div id="workspace" style="display:none;margin-top:1.25rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
        <p class="seo-p-sm" style="font-weight:600;">
          <span id="doc-name"></span> — <span id="doc-pages" style="font-weight:400;"></span>
        </p>
        <div style="display:flex;gap:0.5rem;align-items:center;">
          <span id="sel-count" class="seo-p-sm">0 selected</span>
          <button id="reset-btn" class="btn-secondary" type="button" style="font-size:0.7rem;padding:0.25rem 0.6rem;">New File</button>
        </div>
      </div>

      <div style="display:flex;gap:0.5rem;margin-bottom:1rem;flex-wrap:wrap;">
        <button id="select-all" class="btn-secondary" type="button" style="font-size:0.75rem;">Select All</button>
        <button id="deselect-all" class="btn-secondary" type="button" style="font-size:0.75rem;">Deselect All</button>
        <button id="select-odd" class="btn-secondary" type="button" style="font-size:0.75rem;">Select Odd</button>
        <button id="select-even" class="btn-secondary" type="button" style="font-size:0.75rem;">Select Even</button>
      </div>

      <div id="pages-grid" style="display:flex;flex-wrap:wrap;gap:0.6rem;"></div>

      <div style="margin-top:1.25rem;text-align:center;">
        <button id="delete-btn" class="btn-primary" type="button" style="font-size:0.95rem;padding:0.7rem 2rem;background:#EF4444;">
          Delete Selected Pages
        </button>
        <p id="status" style="font-size:0.78rem;color:var(--text-muted);margin-top:0.5rem;display:none;"></p>
      </div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Remove Specific Pages From a PDF</h2>
    <p class="seo-p">
      A 100-page double-sided scan has 50 blank pages between content pages. Click Select Even to mark all even-numbered pages (the blank ones), see them highlighted with red borders, and click Delete. The output is a 50-page PDF with only the content pages. The thumbnails show every page so you can verify your selection before deleting.
    </p>
    <p class="seo-p">
      The delete tool renders every page as a thumbnail. Click to select pages for removal (they get a red border). Bulk buttons speed up common patterns: Select All, Deselect All, Select Odd, Select Even. The delete operation copies only the unselected pages to a new PDF, producing a smaller file without the removed content.
    </p>

    <h3 class="font-display seo-h3-sm">Cleaning up scans and removing unwanted sections</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Double-sided scans produce blank intermediates', 'A 50-page document scanned double-sided produces 100 pages: content, blank, content, blank... The blank pages are the backs of the previous sheet. Select Even marks all 50 blank pages. Delete them. The output is a clean 50-page PDF. The thumbnails let you verify that the even pages are indeed blank before deleting.'],
        ['Board decks need sections removed before sharing', 'A 40-page board deck has financial projections on pages 15-20 that cannot be shared with external partners. Select pages 15-20 by clicking each one. The red borders show exactly which pages will be deleted. The remaining 34 pages are copied to a new PDF. The original file is never modified.'],
        ['Appendices bloat file size unnecessarily', 'A 200-page technical report has 40 pages of raw data appendices. Only the 160-page main report is needed for the client presentation. Select the 40 appendix pages and delete them. The output is 60% smaller and easier to email. The remaining pages are copied losslessly.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/pdf-split" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Split PDF</a>
        <a href="/tools/pdf-organize" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Organize PDF</a>
        <a href="/tools/pdf-rotate" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Rotate PDF</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the PDF Delete Pages Tool Removes Pages Without Upload</h2>
    <p class="seo-p">
      When you drop a PDF, every page is rendered as a thumbnail at 25% scale. Click a page to toggle its selection (red border means selected for deletion). Bulk buttons mark all odd, all even, all pages, or no pages. The tool prevents deleting all pages: at least one must remain. When you click Delete, pdf-lib creates a new PDF with only the unselected pages.
    </p>

    <h3 class="font-display seo-h3-sm">How the bulk selection buttons save time</h3>
    <p class="seo-p-sm">
      Select Even marks all even-numbered pages (2, 4, 6...) for deletion. This is the fastest way to clean up double-sided scans where blank pages appear on even numbers. Select Odd marks pages 1, 3, 5... Select All marks every page (the tool prevents this from being the final state). Deselect All clears the selection. These buttons update the selection state and red borders instantly.
    </p>

    <h3 class="font-display seo-h3-sm">What happens to the remaining pages</h3>
    <p class="seo-p-sm">
      The delete operation copies only unselected pages using copyPages(). Text, images, vectors, and embedded fonts are transferred byte-for-byte. The remaining pages are identical to the originals. Bookmarks and annotations are preserved on the remaining pages. The output PDF is smaller because it contains fewer pages, but the content of each remaining page is unchanged.
    </p>
    <p class="seo-p-none">
      The original file is never modified. The delete operation produces a new PDF. If you delete the wrong pages, re-upload the original and select different pages. The tool does not maintain an undo stack within a session, so the original file serves as your backup.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How do I remove blank pages from a double-sided scan?",
          a: "Click Select Even to mark all even-numbered pages. The thumbnails show which pages are blank. If some even pages have content, deselect them manually. Click Delete Selected Pages. The output is a clean PDF with only the content pages. The thumbnails let you verify before deleting."
        },
        {
          q: "Can I delete pages from a password-protected PDF?",
          a: "PDFs with an owner password (restricting editing) can be processed because they open without a password. PDFs with a user password (requiring a password to open) cannot be processed. Remove the password first using a PDF reader that supports decryption."
        },
        {
          q: "What happens to the page numbers after deletion?",
          a: "The output PDF renumbers pages starting from 1. If you delete pages 5-10 from a 20-page document, the output has 14 pages numbered 1-14. Internal links and bookmarks that referenced the deleted pages will break. For complex documents, edit bookmarks after deleting."
        },
        {
          q: "Can I delete the same page multiple times?",
          a: "Each page appears once in the thumbnail grid. You can only delete it once. If you need to remove duplicate content from different positions, use the organize tool instead, which lets you reorder and delete individual page instances."
        },
        {
          q: "Does deleting pages reduce the file size?",
          a: "Yes, proportionally. A 100-page PDF with 30 pages deleted becomes a 70-page PDF. The file size reduction depends on the content of the deleted pages. Text-heavy pages reduce size more than image-heavy pages. The remaining pages are copied without re-encoding."
        },
        {
          q: "Is there a limit to how many pages I can delete?",
          a: "You can select and delete as many pages as you want, as long as at least one page remains. The tool prevents the final state where all pages are selected for deletion. For a 50-page document, you can delete 49 pages and keep 1."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
<script is:inline src="https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.min.js"></script>

<script>
(function () {
  const { PDFDocument } = (window as any).PDFLib;
  const pdfjsLib = (window as any).pdfjsLib;
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.worker.min.js';

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const browseBtn = document.getElementById('browse-btn')!;
  const workspace = document.getElementById('workspace')!;
  const docName = document.getElementById('doc-name')!;
  const docPages = document.getElementById('doc-pages')!;
  const resetBtn = document.getElementById('reset-btn')!;
  const selCount = document.getElementById('sel-count')!;
  const pagesGrid = document.getElementById('pages-grid')!;
  const deleteBtn = document.getElementById('delete-btn')!;
  const statusEl = document.getElementById('status')!;
  const selectAll = document.getElementById('select-all')!;
  const deselectAll = document.getElementById('deselect-all')!;
  const selectOdd = document.getElementById('select-odd')!;
  const selectEven = document.getElementById('select-even')!;

  let pdfBytes: ArrayBuffer | null = null;
  let pdfDoc: any = null;
  let totalPages = 0;
  let selected = new Set<number>();

  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.style.borderColor = 'var(--color-brand-blue)'; });
  dropZone.addEventListener('dragleave', () => { dropZone.style.borderColor = ''; });
  dropZone.addEventListener('drop', e => { e.preventDefault(); dropZone.style.borderColor = ''; if (e.dataTransfer!.files.length) loadFile(e.dataTransfer!.files[0]); });
  browseBtn.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('click', e => { if (e.target === dropZone || e.target === browseBtn) fileInput.click(); });
  fileInput.addEventListener('change', () => { if (fileInput.files.length) loadFile(fileInput.files[0]); fileInput.value = ''; });
  resetBtn.addEventListener('click', () => { pdfBytes = null; pdfDoc = null; selected.clear(); workspace.style.display = 'none'; dropZone.style.display = ''; });
  selectAll.addEventListener('click', () => { for (let i = 1; i <= totalPages; i++) selected.add(i); renderPages(); });
  deselectAll.addEventListener('click', () => { selected.clear(); renderPages(); });
  selectOdd.addEventListener('click', () => { selected.clear(); for (let i = 1; i <= totalPages; i++) { if (i % 2 === 1) selected.add(i); } renderPages(); });
  selectEven.addEventListener('click', () => { selected.clear(); for (let i = 1; i <= totalPages; i++) { if (i % 2 === 0) selected.add(i); } renderPages(); });

  async function loadFile(file: File) {
    if (file.type !== 'application/pdf') return;
    pdfBytes = await file.arrayBuffer();
    pdfDoc = await pdfjsLib.getDocument({ data: pdfBytes.slice(0) }).promise;
    totalPages = pdfDoc.numPages;
    docName.textContent = file.name.replace(/\.pdf$/i, '');
    docPages.textContent = totalPages + ' page' + (totalPages > 1 ? 's' : '');
    selected.clear();
    dropZone.style.display = 'none';
    workspace.style.display = '';
    renderPages();
  }

  async function renderPages() {
    pagesGrid.innerHTML = '';
    selCount.textContent = selected.size + ' selected';
    selCount.style.color = selected.size > 0 ? '#EF4444' : 'var(--text-muted)';

    for (let i = 1; i <= totalPages; i++) {
      const page = await pdfDoc.getPage(i);
      const viewport = page.getViewport({ scale: 0.25 });
      const canvas = document.createElement('canvas');
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      const isSelected = selected.has(i);
      canvas.style.cssText = `width:100px;height:auto;border:2px solid ${isSelected ? '#EF4444' : 'var(--border)'};border-radius:6px;cursor:pointer;transition:border-color 0.15s,box-shadow 0.15s;background:#fff;${isSelected ? 'box-shadow:0 0 0 3px rgba(239,68,68,0.2);' : ''}`;
      await page.render({ canvasContext: canvas.getContext('2d')!, viewport }).promise;

      const wrap = document.createElement('div');
      wrap.style.cssText = 'position:relative;flex-shrink:0;text-align:center;';

      const numBadge = document.createElement('div');
      numBadge.style.cssText = `position:absolute;top:-6px;left:-6px;background:${isSelected ? '#EF4444' : 'var(--text-muted)'};color:#fff;font-size:0.6rem;font-weight:700;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;z-index:2;`;
      numBadge.textContent = String(i);

      const label = document.createElement('div');
      label.style.cssText = 'font-size:0.65rem;color:var(--text-muted);margin-top:0.2rem;';
      label.textContent = 'Page ' + i;

      wrap.appendChild(numBadge);
      wrap.appendChild(canvas);
      wrap.appendChild(label);

      canvas.addEventListener('click', () => {
        if (selected.has(i)) selected.delete(i); else selected.add(i);
        renderPages();
      });

      pagesGrid.appendChild(wrap);
    }
  }

  deleteBtn.addEventListener('click', async () => {
    if (selected.size === 0) { statusEl.style.display = ''; statusEl.style.color = '#EF4444'; statusEl.textContent = 'Select at least one page to delete.'; return; }
    if (selected.size === totalPages) { statusEl.style.display = ''; statusEl.style.color = '#EF4444'; statusEl.textContent = 'Cannot delete all pages.'; return; }
    deleteBtn.setAttribute('disabled', '');
    deleteBtn.textContent = 'Deleting…';
    try {
      const srcDoc = await PDFDocument.load(pdfBytes!);
      const newDoc = await PDFDocument.create();
      const keep = Array.from({ length: totalPages }, (_, i) => i + 1).filter(p => !selected.has(p));
      const copied = await newDoc.copyPages(srcDoc, keep.map(p => p - 1));
      copied.forEach(p => newDoc.addPage(p));
      const bytes = await newDoc.save();
      const blob = new Blob([bytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = 'deleted_pages.pdf'; a.click();
      URL.revokeObjectURL(url);
      statusEl.style.display = ''; statusEl.style.color = '#10B981'; statusEl.textContent = `Deleted ${selected.size} page${selected.size > 1 ? 's' : ''}. Downloaded deleted_pages.pdf (${keep.length} pages remaining).`;
    } catch (e: any) { statusEl.style.display = ''; statusEl.style.color = '#EF4444'; statusEl.textContent = 'Error: ' + e.message; }
    finally { deleteBtn.removeAttribute('disabled'); deleteBtn.textContent = 'Delete Selected Pages'; }
  });
})();
</script>
