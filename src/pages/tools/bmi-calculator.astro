---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'bmi-calculator')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">
      Calculate Your BMI
    </h2>

    <!-- Unit toggle — standardised .toggle-group / .toggle-btn -->
    <div class="toggle-group" style="margin-bottom:1.5rem;" role="group" aria-label="Unit system">
      <button id="btn-metric" class="toggle-btn active" aria-pressed="true" type="button">
        Metric (kg / cm)
      </button>
      <button id="btn-imperial" class="toggle-btn" aria-pressed="false" type="button">
        Imperial (lbs / in)
      </button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.25rem;">

      <!-- Metric inputs -->
      <div id="metric-inputs">
        <div style="margin-bottom:0.875rem;">
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;" for="weight-kg">Weight (kg)</label>
          <input id="weight-kg" type="number" min="1" max="500" placeholder="e.g. 70"
            class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;" for="height-cm">Height (cm)</label>
          <input id="height-cm" type="number" min="1" max="300" placeholder="e.g. 175"
            class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
      </div>

      <!-- Imperial inputs -->
      <div id="imperial-inputs" style="display:none;">
        <div style="margin-bottom:0.875rem;">
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;" for="weight-lbs">Weight (lbs)</label>
          <input id="weight-lbs" type="number" min="1" max="1100" placeholder="e.g. 154"
            class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
          <div>
            <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;" for="height-ft">Feet</label>
            <input id="height-ft" type="number" min="1" max="9" placeholder="5"
              class="input-themed"
              style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
          </div>
          <div>
            <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;" for="height-in">Inches</label>
            <input id="height-in" type="number" min="0" max="11" placeholder="9"
              class="input-themed"
              style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
          </div>
        </div>
      </div>

      <!-- Result panel — standardised .result-card -->
      <div>
        <div id="result-panel" style="display:none;">
          <div class="result-card accent-blue" style="height:100%; display:flex; flex-direction:column; justify-content:center; text-align:center;">
            <div id="bmi-value" class="result-value" style="font-size:3rem; text-align:center;"></div>
            <div class="result-label" style="text-align:center; margin-bottom:0.75rem;">Your BMI</div>
            <div id="bmi-category" style="display:inline-block; align-self:center; padding:0.3rem 1rem; border-radius:999px; font-size:0.8rem; font-weight:600;"></div>
          </div>
        </div>

        <div id="empty-panel" class="result-card" style="height:100%; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; border-style:dashed;">
          <div style="font-size:2.5rem; margin-bottom:0.5rem;">⚖️</div>
          <p style="font-size:0.82rem; color:var(--text-muted); margin:0;">Enter your details to calculate your BMI</p>
        </div>
      </div>

    </div>

    <!-- Actions row -->
    <div style="display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap;">
      <button id="calculate-btn" class="btn-primary" type="button">
        Calculate BMI
      </button>
      <button id="reset-btn" class="btn-secondary" type="button">
        Reset
      </button>
    </div>

    <p id="error-msg" style="display:none; color:#EF4444; font-size:0.82rem; margin-top:0.75rem;"></p>
  </div>

  <!-- HOW TO USE ───────────────────────────────── -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >Check your BMI in ten seconds — no sign-up, no data stored</h2>
    <p class="seo-p" >
      Your doctor mentioned BMI at your last check-up but you forgot what the number means. A friend posted their BMI on social media and you're curious where you land. Your life insurance form asks for your BMI category and you don't have it handy. Enter your weight and height — either metric or imperial — and this calculator gives you your BMI number and its WHO category (underweight, normal, overweight, or obese) in a colour-coded label. The whole thing takes about ten seconds.
    </p>
    <p class="seo-p" >
      Toggle between metric (kilograms and centimetres) and imperial (pounds, feet, and inches) using the tabs at the top. Enter your numbers and click <strong>Calculate BMI</strong>. The result appears immediately: your BMI value rounded to one decimal place, and a colour-coded badge showing your category. Blue for underweight, green for healthy weight, amber for overweight, red for obese.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Who uses this calculator</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['People filling out health or insurance forms', 'Life insurance applications, workplace health assessments, and occupational health questionnaires frequently ask for BMI. If you don\'t have a recent measurement from a clinic, this calculator gives you the number in seconds. A 75kg person who is 170cm tall has a BMI of 25.95 — just into the overweight category — and knowing that before a form avoids guessing.'],
        ['Patients preparing for a GP appointment', 'If your doctor has asked you to track your weight between visits, calculating BMI at home lets you monitor the trend. A 5kg weight loss for someone at 175cm shifts BMI from 27.1 (overweight) to 25.5 (still overweight, but moving in the right direction). The colour-coded category makes it easy to see progress without interpreting raw numbers.'],
        ['Parents checking their own numbers', 'Many parents calculate their own BMI while researching their child\'s health. This calculator is designed for adults aged 20+, and knowing your own BMI first helps you understand the context before looking at age-specific percentile charts for children.'],
        ['Fitness enthusiasts tracking changes over time', 'If you\'re building muscle through strength training, your BMI may increase even as your body composition improves. Tracking BMI alongside waist circumference and body fat percentage gives a fuller picture. A regular check every 4-6 weeks during a training block reveals whether the trend is heading in the right direction.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/bmr-katch-mcardle-calculator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">BMR Katch-McArdle & TDEE Calculator</a>
        <a href="/tools/macro-calorie-deficit-allocator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Macro Nutrient & Calorie Deficit Allocator</a>
        <a href="/tools/hydration-fluid-loss-calculator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Hydration & Sweat-Rate Fluid Loss Calculator</a>
      </div>
    </div>
</div>

  <!-- HOW IT WORKS ────────────────────────────── -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >How BMI is calculated — and where the number comes from</h2>

    <h3 class="font-display seo-h3-sm" >The two formulas behind your result</h3>
    <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1rem">
      <div class="info-row">
        <span class="info-label">Metric</span>
        <span class="info-value">BMI = weight (kg) ÷ height (m)²</span>
      </div>
      <div class="info-row">
        <span class="info-label">Imperial</span>
        <span class="info-value">BMI = (weight (lbs) ÷ height (in)²) × 703</span>
      </div>
    </div>

    <h3 class="font-display seo-h3-sm" >What happens when you enter your numbers</h3>
    <p class="seo-p" >
      When you type in your weight and height and hit Calculate, the calculator converts your measurements into the standard units the formula expects. If you're using metric, your height in centimetres is converted to metres by dividing by 100, then squared, then your weight is divided by that squared value. If you're using imperial, your feet are converted to inches (multiplied by 12), added to any extra inches, then your weight in pounds is divided by the square of total inches and multiplied by 703 — a constant that makes imperial inputs equivalent to metric results.
    </p>
    <p class="seo-p" >
      The number that comes out is rounded to one decimal place and matched against four WHO thresholds: under 18.5 is underweight, 18.5 to 24.9 is normal weight, 25 to 29.9 is overweight, and 30 or above is obese. Each category gets its own colour so you can see at a glance where you land. No health data leaves your device — the calculation runs locally in your browser and nothing is stored or sent anywhere.
    </p>

    <h3 class="font-display seo-h3-sm" >Worked example: 82 kg, 175 cm</h3>
    <p class="seo-p" >
      A 175cm person weighing 82kg: height in metres is 1.75, squared is 3.0625, weight divided by that gives <strong>26.8</strong> — just into the overweight category. That person would need to weigh under 76.2kg (a loss of about 5.8kg) to reach the healthy weight range. At 76kg, their BMI would be 24.8 — green.
    </p>

    <h3 class="font-display seo-h3-sm" >Worked example: 11 stone 4 lbs, 5 ft 7 in</h3>
    <p class="seo-p" >
      Converting: 11 stone 4 lbs equals 158 lbs, and 5 ft 7 in equals 67 inches. Squaring 67 gives 4,489. Dividing 158 by 4,489 and multiplying by 703 gives <strong>24.7</strong> — healthy weight, just under the 25 threshold. If that person gained half a stone (7 lbs) to 165 lbs, the BMI would rise to 25.8, crossing into overweight.
    </p>

    <h3 class="font-display seo-h3-sm" >Why BMI matters — and when it doesn't</h3>
    <p class="seo-p" >
      BMI is a quick screening tool, not a diagnosis. It correlates with chronic disease risk at a population level — people in the overweight and obese categories statistically face higher rates of type 2 diabetes, heart disease, and certain cancers. But it has real blind spots: a muscular 85kg rugby player and a sedentary 85kg office worker at the same height produce the same BMI, despite having very different body compositions. BMI also doesn't account for where fat is distributed — abdominal fat is more metabolically harmful than fat on the hips or thighs. For a complete picture, pair BMI with waist circumference and, if available, body fat percentage.
    </p>

    <h3 class="font-display seo-h3-sm" >What the calculator does with edge cases</h3>
    <p class="seo-p" >
      Entering zero or leaving fields blank produces an error message instead of an invalid result. Negative numbers are rejected. Extremely large values — someone weighing 400kg or standing 220cm tall — are accepted without capping, because legitimate measurements do exist at those extremes. The result is computed to full decimal accuracy before rounding to one decimal place for display.
    </p>
  </div>

  <!-- FAQ ─────────────────────────────────────── -->
  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is a healthy BMI?",
          a: "The WHO classifies a BMI between 18.5 and 24.9 as a healthy weight range for most adults. Under 18.5 is underweight, 25–29.9 is overweight, and 30 or above is obese. These thresholds are based on population-level studies linking BMI to chronic disease risk. They apply to adults aged 20 and over — children and adolescents use different, age-specific percentile charts."
        },
        {
          q: "Is BMI accurate for athletes?",
          a: "BMI can overestimate body fat in athletes and muscular people because it doesn't distinguish between muscle and fat. Muscle tissue is roughly 18% denser than fat, so a fit person with significant lean mass may register as overweight despite having a low body fat percentage. For athletes, BMI works best when paired with other measurements like waist circumference, skinfold thickness, or DEXA scans."
        },
        {
          q: "Can I use this calculator for children?",
          a: "No — this calculator is designed for adults aged 20 and older. For children and adolescents aged 2–19, BMI is interpreted using age- and sex-specific percentile charts published by the CDC. A child's BMI percentile, not the raw number, determines their weight category. A 12-year-old boy with a BMI of 21 might be in the 75th percentile (normal), while an adult with the same BMI would also be normal — but the interpretation process is entirely different. Consult your paediatrician or use the CDC's BMI-for-age growth charts."
        },
        {
          q: "How often should I check my BMI?",
          a: "For most adults, checking every few months or whenever you notice significant weight changes is sufficient. BMI is a single snapshot — it doesn't tell you about body composition, fat distribution, or metabolic health. If you're actively managing your weight, tracking BMI every 4–6 weeks alongside waist circumference gives you a useful trend without obsessing over daily fluctuations."
        },
        {
          q: "Why does the imperial formula multiply by 703?",
          a: "The factor 703 converts pounds-and-inches measurements into the same BMI scale used by the metric formula. It's derived from the mathematical relationship between kilograms and pounds (1 kg ≈ 2.2046 lbs) and centimetres and metres (100 cm = 1 m). Without this conversion, the same person would get different BMI values depending on which units they used, which would make the WHO thresholds meaningless."
        },
        {
          q: "What is the difference between BMI and body fat percentage?",
          a: "BMI is a ratio of weight to height — it doesn't measure fat directly. Body fat percentage tells you what proportion of your total weight is fat. Two people with the same BMI can have very different body compositions: one might carry excess fat while the other has high muscle mass. BMI is faster and cheaper to calculate, but body fat percentage is a more precise indicator of metabolic health."
        },
        {
          q: "How does BMI compare to waist circumference as a health indicator?",
          a: "Waist circumference measures abdominal fat, which is more metabolically dangerous than fat stored on the hips or thighs. A person with a normal BMI but a large waist (over 94cm for men, 80cm for women) may still face elevated health risks — a condition sometimes called 'normal weight obesity.' The NHS recommends checking both BMI and waist circumference together for a more complete picture. A tape measure around your navel gives you the waist number in seconds."
        },
        {
          q: "Does BMI change as I get older?",
          a: "BMI thresholds don't change with age for adults, but body composition does. After about age 30, most people lose muscle mass gradually and gain fat, even if their weight stays the same. This means two 70kg people aged 25 and 65 might have the same BMI, but the older person likely has a higher body fat percentage. For people over 65, BMI is less reliable as a standalone measure — pairing it with waist circumference and functional strength assessments gives better insight."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>

    <div style="margin-top:1.25rem; padding-top:1rem; border-top:1px solid var(--border); font-size:0.78rem; color:var(--text-muted); line-height:1.8">
      <strong class="text-primary" style="color:var(--text-secondary)">Disclaimer:</strong> This calculator is provided for educational and informational purposes only. It does not constitute medical, nutritional, or health advice. BMI is a screening tool with known limitations — it does not account for muscle mass, bone density, age, sex, or fat distribution. Always consult a qualified healthcare professional for personalised health assessments and treatment decisions.
    </div>
  </div>

</ToolLayout>

<script>
  const btnMetric     = document.getElementById('btn-metric')!;
  const btnImperial   = document.getElementById('btn-imperial')!;
  const metricInputs  = document.getElementById('metric-inputs')!;
  const imperialInputs= document.getElementById('imperial-inputs')!;
  const calcBtn       = document.getElementById('calculate-btn')!;
  const resetBtn      = document.getElementById('reset-btn')!;
  const resultPanel   = document.getElementById('result-panel')!;
  const emptyPanel    = document.getElementById('empty-panel')!;
  const bmiValue      = document.getElementById('bmi-value')!;
  const bmiCategory   = document.getElementById('bmi-category')!;
  const errorMsg      = document.getElementById('error-msg')!;

  let isMetric = true;

  function switchUnit(metric: boolean) {
    isMetric = metric;
    metricInputs.style.display  = metric ? '' : 'none';
    imperialInputs.style.display= metric ? 'none' : '';

    btnMetric.classList.toggle('active', metric);
    btnMetric.setAttribute('aria-pressed', String(metric));
    btnImperial.classList.toggle('active', !metric);
    btnImperial.setAttribute('aria-pressed', String(!metric));
  }

  btnMetric.addEventListener('click', () => switchUnit(true));
  btnImperial.addEventListener('click', () => switchUnit(false));

  interface Category {
    label: string;
    bg: string;
    color: string;
    accent: string;
  }

  function getCategory(bmi: number): Category {
    if (bmi < 18.5) return { label: 'Underweight',    bg: 'rgba(59,130,246,0.12)',  color: '#2563EB', accent: 'accent-blue' };
    if (bmi < 25)   return { label: 'Healthy Weight', bg: 'rgba(16,185,129,0.12)', color: '#059669', accent: 'accent-success' };
    if (bmi < 30)   return { label: 'Overweight',     bg: 'rgba(245,158,11,0.12)', color: '#D97706', accent: 'accent-warning' };
    return             { label: 'Obese',           bg: 'rgba(239,68,68,0.12)',  color: '#DC2626', accent: 'accent-red' };
  }

  calcBtn.addEventListener('click', () => {
    errorMsg.style.display = 'none';
    let bmi: number;

    if (isMetric) {
      const weight   = parseFloat((document.getElementById('weight-kg') as HTMLInputElement).value);
      const heightCm = parseFloat((document.getElementById('height-cm') as HTMLInputElement).value);
      if (!weight || !heightCm) {
        errorMsg.textContent = 'Please enter both weight and height.';
        errorMsg.style.display = 'block';
        return;
      }
      bmi = weight / Math.pow(heightCm / 100, 2);
    } else {
      const weightLbs  = parseFloat((document.getElementById('weight-lbs') as HTMLInputElement).value);
      const ft         = parseFloat((document.getElementById('height-ft') as HTMLInputElement).value) || 0;
      const inches     = parseFloat((document.getElementById('height-in') as HTMLInputElement).value) || 0;
      const totalInches= ft * 12 + inches;
      if (!weightLbs || !totalInches) {
        errorMsg.textContent = 'Please enter both weight and height.';
        errorMsg.style.display = 'block';
        return;
      }
      bmi = (weightLbs / (totalInches * totalInches)) * 703;
    }

    const cat = getCategory(bmi);
    bmiValue.textContent = bmi.toFixed(1);

    // Update result card accent class
    const card = resultPanel.querySelector('.result-card')!;
    card.classList.remove('accent-blue','accent-success','accent-warning','accent-red');
    card.classList.add(cat.accent);

    // Update bmi-value colour inline (canvas/SVG-level colour — only place hex is acceptable)
    (bmiValue as HTMLElement).style.color = cat.color;

    bmiCategory.textContent = cat.label;
    bmiCategory.style.background = cat.bg;
    bmiCategory.style.color      = cat.color;

    resultPanel.style.display = '';
    emptyPanel.style.display  = 'none';
  });

  resetBtn.addEventListener('click', () => {
    errorMsg.style.display = 'none';
    document.querySelectorAll<HTMLInputElement>('.tool-card-surface input[type="number"]')
      .forEach(el => { el.value = ''; });
    resultPanel.style.display = 'none';
    emptyPanel.style.display  = '';
  });
</script>
