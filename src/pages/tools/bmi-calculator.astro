---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'bmi-calculator')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">
      Calculate Your BMI
    </h2>

    <!-- Unit toggle — standardised .toggle-group / .toggle-btn -->
    <div class="toggle-group" style="margin-bottom:1.5rem;" role="group" aria-label="Unit system">
      <button id="btn-metric" class="toggle-btn active" aria-pressed="true" type="button">
        Metric (kg / cm)
      </button>
      <button id="btn-imperial" class="toggle-btn" aria-pressed="false" type="button">
        Imperial (lbs / in)
      </button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.25rem;">

      <!-- Metric inputs -->
      <div id="metric-inputs">
        <div style="margin-bottom:0.875rem;">
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;" for="weight-kg">Weight (kg)</label>
          <input id="weight-kg" type="number" min="1" max="500" placeholder="e.g. 70"
            class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;" for="height-cm">Height (cm)</label>
          <input id="height-cm" type="number" min="1" max="300" placeholder="e.g. 175"
            class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
      </div>

      <!-- Imperial inputs -->
      <div id="imperial-inputs" style="display:none;">
        <div style="margin-bottom:0.875rem;">
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;" for="weight-lbs">Weight (lbs)</label>
          <input id="weight-lbs" type="number" min="1" max="1100" placeholder="e.g. 154"
            class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
          <div>
            <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;" for="height-ft">Feet</label>
            <input id="height-ft" type="number" min="1" max="9" placeholder="5"
              class="input-themed"
              style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
          </div>
          <div>
            <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;" for="height-in">Inches</label>
            <input id="height-in" type="number" min="0" max="11" placeholder="9"
              class="input-themed"
              style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;" />
          </div>
        </div>
      </div>

      <!-- Result panel — standardised .result-card -->
      <div>
        <div id="result-panel" style="display:none;">
          <div class="result-card accent-blue" style="height:100%; display:flex; flex-direction:column; justify-content:center; text-align:center;">
            <div id="bmi-value" class="result-value" style="font-size:3rem; text-align:center;"></div>
            <div class="result-label" style="text-align:center; margin-bottom:0.75rem;">Your BMI</div>
            <div id="bmi-category" style="display:inline-block; align-self:center; padding:0.3rem 1rem; border-radius:999px; font-size:0.8rem; font-weight:600;"></div>
          </div>
        </div>

        <div id="empty-panel" class="result-card" style="height:100%; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; border-style:dashed;">
          <div style="font-size:2.5rem; margin-bottom:0.5rem;">⚖️</div>
          <p style="font-size:0.82rem; color:var(--text-muted); margin:0;">Enter your details to calculate your BMI</p>
        </div>
      </div>

    </div>

    <!-- Actions row -->
    <div style="display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap;">
      <button id="calculate-btn" class="btn-primary" type="button">
        Calculate BMI
      </button>
      <button id="reset-btn" class="btn-secondary" type="button">
        Reset
      </button>
    </div>

    <p id="error-msg" style="display:none; color:#EF4444; font-size:0.82rem; margin-top:0.75rem;"></p>
  </div>

  <!-- HOW TO USE ───────────────────────────────── -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >BMI Calculator Overview &amp; Technical Context</h2>
    <p class="text-secondary seo-p" >
      This Body Mass Index (BMI) calculator computes your BMI using the standardised formula published by the World Health Organisation (WHO) and the National Institutes of Health (NIH). The tool runs entirely in your browser using vanilla JavaScript — no data is transmitted to any server, no cookies are set, and no tracking scripts execute. The 100% client-side architecture means your health metrics remain completely private, with zero server latency and zero data retention.
    </p>
    <p class="text-secondary seo-p" >
      Select your preferred unit system — metric (kilograms and centimetres) or imperial (pounds and inches). Enter your weight and height, then click <strong>Calculate BMI</strong>. The result appears instantly with a colour-coded category label indicating whether the value falls into the underweight, normal weight, overweight, or obese range. The calculator handles both unit systems natively: the metric path divides weight in kilograms by height in metres squared, while the imperial path applies the standard 703 conversion factor to produce an equivalent result.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Clinical triage and health screenings', 'General practitioners and practice nurses routinely calculate BMI as a first-step screening metric during routine health assessments. This tool replicates the exact computation used in clinical settings, enabling patients to understand their own readings before or after a consultation. The instant result and clear category labelling remove ambiguity when interpreting a BMI figure against WHO thresholds.'],
        ['Fitness tracking and goal-setting', 'Personal trainers and individuals following a structured fitness programme use BMI as a baseline reference point. When paired with body composition measurements (such as waist circumference or body fat percentage), BMI provides a quick longitudinal indicator of weight management progress. This calculator\'s instant feedback loop makes it suitable for repeated use during training cycles.'],
        ['Insurance and occupational health assessments', 'Many life insurance providers and occupational health programmes reference BMI categories when assessing risk profiles. Understanding your BMI category before completing a health declaration form helps you provide accurate information. The metric and imperial toggle ensures compatibility with measurement systems used across different countries and industries.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- HOW IT WORKS ────────────────────────────── -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >Deep-Dive: BMI Formulas, Technical Mechanics &amp; Use Cases</h2>

    <h3 class="font-display seo-h3-sm" >Core Formulas</h3>
    <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1rem">
      <div class="info-row">
        <span class="info-label">Metric</span>
        <span class="info-value">BMI = weight (kg) ÷ height² (m²)</span>
      </div>
      <div class="info-row">
        <span class="info-label">Imperial</span>
        <span class="info-value">BMI = (weight (lbs) ÷ height² (in²)) × 703</span>
      </div>
    </div>

    <h3 class="font-display seo-h3-sm" >How the Computation Works</h3>
    <p class="text-secondary seo-p" >
      The BMI formula was devised by Adolphe Quetelet in the 1830s and remains the internationally standardised method for classifying adult body weight relative to height. The metric path converts the user's height from centimetres to metres (dividing by 100), squares the result, then divides weight by that squared value. The imperial path applies the constant factor of 703 — derived from the ratio of pounds-per-square-inch to kilograms-per-square-metre — to produce a dimensionless number comparable to the metric result.
    </p>
    <p class="text-secondary seo-p" >
      Both paths compute BMI to full IEEE 754 double-precision floating-point accuracy before rounding to one decimal place for display. The result is then classified against the WHO's widely adopted thresholds: Underweight (&lt;18.5), Normal weight (18.5–24.9), Overweight (25–29.9), and Obese (≥30). Each category is assigned a distinct colour — blue for underweight, green for normal, amber for overweight, and red for obese — to provide immediate visual context.
    </p>
    <p class="text-secondary seo-p" >
      <strong>Edge cases handled:</strong> The calculator validates that both weight and height are positive, non-zero numbers before computing. Entering zero or leaving fields blank triggers a clear error message rather than producing <code>Infinity</code> or <code>NaN</code>. Very extreme inputs (e.g. 500 kg or 300 cm) are accepted without capping, allowing the tool to handle legitimately large values while remaining transparent about its output.
    </p>
    <p class="text-secondary seo-p-none" >
      <strong>Note on BMI limitations:</strong> BMI does not distinguish between muscle mass, bone density, and fat mass. An athletic individual with significant muscle may register as overweight or obese despite having low body fat. For a complete health picture, BMI should be interpreted alongside additional metrics such as waist circumference, waist-to-hip ratio, body fat percentage, and blood markers. The WHO explicitly states that BMI is a screening tool, not a diagnostic instrument.
    </p>
  </div>

  <!-- FAQ ─────────────────────────────────────── -->
  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is a healthy BMI?",
          a: "According to the WHO, a BMI between 18.5 and 24.9 is considered a healthy weight range for most adults. Values below 18.5 indicate underweight, 25–29.9 is overweight, and 30 or above is classified as obese. These thresholds apply to adults aged 20 and over and are based on population-level data correlating BMI with chronic disease risk."
        },
        {
          q: "Is BMI accurate for athletes?",
          a: "BMI can overestimate body fat in athletes and muscular individuals, since muscle tissue is approximately 18% denser than fat tissue. An athletic person with significant lean mass may register as overweight or obese on the BMI scale despite having a low body fat percentage. For athletes, BMI should be interpreted alongside body composition measurements such as skinfold thickness, DEXA scans, or bioelectrical impedance analysis."
        },
        {
          q: "Can I use this BMI calculator for children?",
          a: "This calculator is designed for adults aged 20 and older. For children and adolescents aged 2–19, BMI is interpreted differently using age- and sex-specific percentile charts published by the CDC. A child's BMI percentile — not the raw number — determines their weight status category. Consult your paediatrician or use the CDC's BMI-for-age growth charts for accurate paediatric assessment."
        },
        {
          q: "How often should I check my BMI?",
          a: "For most adults, checking BMI every few months is sufficient, or whenever you experience significant weight changes. BMI is just one indicator of health — it does not account for muscle mass, bone density, age, or fat distribution. Frequent BMI monitoring is most useful during structured weight management programmes where trend direction matters more than any single reading."
        },
        {
          q: "Why does the imperial formula multiply by 703?",
          a: "The factor 703 converts from the imperial unit system (pounds and inches) to the metric-based BMI scale. It is derived from the conversion ratio of kilograms to pounds (2.2046) squared and multiplied by the centimetre-to-metre conversion (100²), yielding approximately 703.069. This ensures that an imperial input produces the same BMI classification as the equivalent metric measurement."
        },
        {
          q: "What is the difference between BMI and body fat percentage?",
          a: "BMI is a ratio of weight to height and does not directly measure body fat. Body fat percentage quantifies the actual proportion of fat mass relative to total body weight. Two individuals with identical BMIs can have very different body compositions — one may carry excess fat while the other has high muscle mass. BMI is a faster, cheaper screening tool, but body fat percentage is a more precise indicator of metabolic health."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>

    <div style="margin-top:1.25rem; padding-top:1rem; border-top:1px solid var(--border); font-size:0.78rem; color:var(--text-muted); line-height:1.8">
      <strong class="text-primary" style="color:var(--text-secondary)">Disclaimer:</strong> This calculator is provided for educational and informational purposes only. It does not constitute medical, nutritional, or health advice. BMI is a screening tool with known limitations — it does not account for muscle mass, bone density, age, sex, or fat distribution. Always consult a qualified healthcare professional for personalised health assessments and treatment decisions.
    </div>
  </div>

</ToolLayout>

<script>
  const btnMetric     = document.getElementById('btn-metric')!;
  const btnImperial   = document.getElementById('btn-imperial')!;
  const metricInputs  = document.getElementById('metric-inputs')!;
  const imperialInputs= document.getElementById('imperial-inputs')!;
  const calcBtn       = document.getElementById('calculate-btn')!;
  const resetBtn      = document.getElementById('reset-btn')!;
  const resultPanel   = document.getElementById('result-panel')!;
  const emptyPanel    = document.getElementById('empty-panel')!;
  const bmiValue      = document.getElementById('bmi-value')!;
  const bmiCategory   = document.getElementById('bmi-category')!;
  const errorMsg      = document.getElementById('error-msg')!;

  let isMetric = true;

  function switchUnit(metric: boolean) {
    isMetric = metric;
    metricInputs.style.display  = metric ? '' : 'none';
    imperialInputs.style.display= metric ? 'none' : '';

    btnMetric.classList.toggle('active', metric);
    btnMetric.setAttribute('aria-pressed', String(metric));
    btnImperial.classList.toggle('active', !metric);
    btnImperial.setAttribute('aria-pressed', String(!metric));
  }

  btnMetric.addEventListener('click', () => switchUnit(true));
  btnImperial.addEventListener('click', () => switchUnit(false));

  interface Category {
    label: string;
    bg: string;
    color: string;
    accent: string;
  }

  function getCategory(bmi: number): Category {
    if (bmi < 18.5) return { label: 'Underweight',    bg: 'rgba(59,130,246,0.12)',  color: '#2563EB', accent: 'accent-blue' };
    if (bmi < 25)   return { label: 'Healthy Weight', bg: 'rgba(16,185,129,0.12)', color: '#059669', accent: 'accent-success' };
    if (bmi < 30)   return { label: 'Overweight',     bg: 'rgba(245,158,11,0.12)', color: '#D97706', accent: 'accent-warning' };
    return             { label: 'Obese',           bg: 'rgba(239,68,68,0.12)',  color: '#DC2626', accent: 'accent-red' };
  }

  calcBtn.addEventListener('click', () => {
    errorMsg.style.display = 'none';
    let bmi: number;

    if (isMetric) {
      const weight   = parseFloat((document.getElementById('weight-kg') as HTMLInputElement).value);
      const heightCm = parseFloat((document.getElementById('height-cm') as HTMLInputElement).value);
      if (!weight || !heightCm) {
        errorMsg.textContent = 'Please enter both weight and height.';
        errorMsg.style.display = 'block';
        return;
      }
      bmi = weight / Math.pow(heightCm / 100, 2);
    } else {
      const weightLbs  = parseFloat((document.getElementById('weight-lbs') as HTMLInputElement).value);
      const ft         = parseFloat((document.getElementById('height-ft') as HTMLInputElement).value) || 0;
      const inches     = parseFloat((document.getElementById('height-in') as HTMLInputElement).value) || 0;
      const totalInches= ft * 12 + inches;
      if (!weightLbs || !totalInches) {
        errorMsg.textContent = 'Please enter both weight and height.';
        errorMsg.style.display = 'block';
        return;
      }
      bmi = (weightLbs / (totalInches * totalInches)) * 703;
    }

    const cat = getCategory(bmi);
    bmiValue.textContent = bmi.toFixed(1);

    // Update result card accent class
    const card = resultPanel.querySelector('.result-card')!;
    card.classList.remove('accent-blue','accent-success','accent-warning','accent-red');
    card.classList.add(cat.accent);

    // Update bmi-value colour inline (canvas/SVG-level colour — only place hex is acceptable)
    (bmiValue as HTMLElement).style.color = cat.color;

    bmiCategory.textContent = cat.label;
    bmiCategory.style.background = cat.bg;
    bmiCategory.style.color      = cat.color;

    resultPanel.style.display = '';
    emptyPanel.style.display  = 'none';
  });

  resetBtn.addEventListener('click', () => {
    errorMsg.style.display = 'none';
    document.querySelectorAll<HTMLInputElement>('.tool-card-surface input[type="number"]')
      .forEach(el => { el.value = ''; });
    resultPanel.style.display = 'none';
    emptyPanel.style.display  = '';
  });
</script>
