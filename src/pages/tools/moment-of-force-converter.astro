---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'moment-of-force-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Moment of Force Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a moment of force (torque) and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="mof-input">Moment of Force</label>
        <input id="mof-input" type="number" value="1" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="mof-unit">Unit</label>
        <select id="mof-unit" class="select-themed" style="min-width:12rem;">
          <option value="Nm" selected>N·m</option>
          <option value="kNm">kN·m</option>
          <option value="mNm">mN·m</option>
          <option value="lfft">lbf·ft</option>
          <option value="lfin">lbf·in</option>
          <option value="ozfin">ozf·in</option>
          <option value="kgfm">kgf·m</option>
          <option value="kgfcm">kgf·cm</option>
          <option value="gfcm">gf·cm</option>
          <option value="gfm">gf·m</option>
          <option value="cNm">cN·m</option>
          <option value="muNm">μN·m</option>
          <option value="dyncm">dyn·cm</option>
          <option value="dynm">dyn·m</option>
        </select>
      </div>
    </div>

    <!-- Results grid -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Concept Visualisation: Wrench + Lever Arm -->
    <div style="margin-top:1.5rem;background:var(--bg-surface);border:1.5px solid var(--border);border-radius:0.875rem;padding:1.25rem;">
      <p style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.75rem;">Why Lever Arm Length Matters — τ = F × r</p>
      <div style="display:flex;align-items:flex-start;justify-content:center;gap:2rem;flex-wrap:wrap;">
        <!-- Left: wrench diagram -->
        <svg width="300" height="200" viewBox="0 0 300 200" id="wrench-svg">
          <!-- Ground / axis -->
          <circle cx="50" cy="140" r="18" fill="var(--bg-surface-2)" stroke="var(--border)" stroke-width="2"/>
          <circle cx="50" cy="140" r="5" fill="var(--text-muted)"/>
          <text x="50" y="175" text-anchor="middle" font-size="9" font-weight="600" fill="var(--text-muted)" font-family="'Sora',sans-serif">AXIS</text>
          <!-- Lever arm -->
          <line x1="50" y1="140" x2="260" y2="140" stroke="var(--text-primary)" stroke-width="4" stroke-linecap="round"/>
          <!-- Force arrow -->
          <defs>
            <marker id="arrowF" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
              <path d="M 0,0 L 10,3.5 L 0,7 Z" fill="#EF4444"/>
            </marker>
          </defs>
          <line x1="260" y1="140" x2="260" y2="50" stroke="#EF4444" stroke-width="3" marker-end="url(#arrowF)"/>
          <text x="272" y="95" text-anchor="start" font-size="12" font-weight="700" fill="#EF4444" font-family="'Fira Code',monospace">F</text>
          <!-- Torque arc -->
          <defs>
            <marker id="arrowT" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
              <path d="M 0,0 L 8,3 L 0,6 Z" fill="#10B981"/>
            </marker>
          </defs>
          <path d="M 68,120 A 22,22 0 0,1 68,160" fill="none" stroke="#10B981" stroke-width="2.5" marker-end="url(#arrowT)"/>
          <text x="82" y="144" text-anchor="start" font-size="12" font-weight="700" fill="#10B981" font-family="'Fira Code',monospace">τ</text>
          <!-- r label -->
          <line x1="50" y1="124" x2="260" y2="124" stroke="#3B82F6" stroke-width="1.5" stroke-dasharray="5 3"/>
          <text x="155" y="118" text-anchor="middle" font-size="11" font-weight="600" fill="#3B82F6" font-family="'Fira Code',monospace">r (lever arm)</text>
          <!-- Formulas -->
          <text x="150" y="20" text-anchor="middle" font-size="13" font-weight="700" fill="var(--text-primary)" font-family="'Fira Code',monospace">τ = F × r</text>
          <text x="150" y="38" text-anchor="middle" font-size="9" fill="var(--text-muted)" font-family="'Sora',sans-serif">Same force, longer arm → more torque</text>
        </svg>
        <!-- Right: comparison -->
        <div style="flex:1;min-width:220px;max-width:300px;">
          <p style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);margin-bottom:0.75rem;">Same force, different lever arms:</p>
          <svg width="100%" viewBox="0 0 260 150" id="bar-svg">
            <!-- Short arm: 0.25 m -->
            <rect x="0" y="8" width="64" height="22" rx="4" fill="#3B82F6"/>
            <text x="72" y="23" font-size="10" font-weight="600" fill="var(--text-primary)" font-family="'Fira Code',monospace">0.25 m → 0.25F</text>
            <!-- Medium arm: 0.5 m -->
            <rect x="0" y="46" width="128" height="22" rx="4" fill="#3B82F6"/>
            <text x="136" y="61" font-size="10" font-weight="600" fill="var(--text-primary)" font-family="'Fira Code',monospace">0.50 m → 0.50F</text>
            <!-- Long arm: 1.0 m -->
            <rect x="0" y="84" width="256" height="22" rx="4" fill="#3B82F6"/>
            <text x="0" y="122" font-size="10" font-weight="700" fill="#3B82F6" font-family="'Fira Code',monospace">1.00 m → 1.00F</text>
            <text x="0" y="140" font-size="9" fill="var(--text-muted)" font-family="'Sora',sans-serif">Double the arm → double the torque (linear relationship)</text>
            <!-- Grid -->
            <line x1="128" y1="6" x2="128" y2="108" stroke="var(--border)" stroke-width="0.5" stroke-dasharray="2 2"/>
          </svg>
        </div>
      </div>
      <p style="font-size:0.78rem;color:var(--text-muted);text-align:center;margin-top:1rem;line-height:1.6;">
        Moment of force (torque) = <strong style="color:var(--text-primary);">Force × Perpendicular distance</strong> from the axis.
        Doubling the lever arm <strong style="color:#3B82F6;">doubles</strong> the torque — unlike moment of inertia where distance is <strong style="color:#EF4444;">squared</strong>.
      </p>
    </div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Common Moment of Force Values</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Moment of Force Converter</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Enter a <strong>numeric moment of force (torque) value</strong> and select its <strong>unit</strong> from the dropdown. All other units update instantly as you type — no buttons to click.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      The converter supports 14 units: <strong>N·m</strong>, <strong>kN·m</strong>, <strong>mN·m</strong>, <strong>cN·m</strong>, <strong>μN·m</strong>, <strong>lbf·ft</strong>, <strong>lbf·in</strong>, <strong>ozf·in</strong>, <strong>kgf·m</strong>, <strong>kgf·cm</strong>, <strong>gf·cm</strong>, <strong>gf·m</strong>, <strong>dyn·cm</strong>, and <strong>dyn·m</strong>.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      Click any <strong>Copy</strong> button to copy that unit's result to your clipboard. The wrench diagram below shows how torque relates to force and lever arm length.
    </p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How moment of force conversions work</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.875rem;">
      Moment of force (torque) is the <strong>rotational equivalent of force</strong>. It measures how much a force acting at a distance tends to rotate an object. All conversions use <strong>N·m</strong> as the base unit:
    </p>
    <pre style="font-family:'Fira Code',monospace;font-size:.85rem;padding:1rem;border-radius:.5rem;background:var(--bg-surface-2);color:var(--text-primary);overflow-x:auto;white-space:pre-wrap;">1 kN·m    = 1000 N·m
1 mN·m    = 0.001 N·m
1 cN·m    = 0.01 N·m
1 μN·m    = 1 × 10⁻⁶ N·m
1 lbf·ft  = 1.35581796 N·m
1 lbf·in  = 0.11298483 N·m
1 ozf·in  = 0.00706155 N·m
1 kgf·m   = 9.80665 N·m
1 kgf·cm  = 0.0980665 N·m
1 gf·cm   = 9.80665 × 10⁻⁵ N·m
1 gf·m    = 0.00980665 N·m
1 dyn·cm  = 1 × 10⁻⁷ N·m
1 dyn·m   = 1 × 10⁻⁵ N·m

τ = F × r

Result = Input × (FromFactor / ToFactor)</pre>
    <p style="color:var(--text-secondary); font-size:0.85rem; line-height:1.75;">
      Unlike moment of inertia (where distance is squared), torque depends <strong>linearly</strong> on distance. Doubling the lever arm doubles the torque — which is why a longer wrench makes bolts easier to loosen.
    </p>
  </div>

  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is moment of force (torque)?",
          "acceptedAnswer": { "@type": "Answer", "text": "Moment of force, commonly called torque, is the rotational effect of a force applied at a distance from a pivot point. It equals Force × perpendicular distance (τ = F × r). The SI unit is the Newton-meter (N·m)." }
        },
        {
          "@type": "Question",
          "name": "What is the difference between moment of force and moment of inertia?",
          "acceptedAnswer": { "@type": "Answer", "text": "Moment of force (torque) is the cause of rotational acceleration — it equals F × r. Moment of inertia is the resistance to rotational acceleration — it equals Σmr². Torque is linear with distance; moment of inertia is quadratic. A long wrench gives more torque, but a heavy rim gives more moment of inertia." }
        },
        {
          "@type": "Question",
          "name": "Why are N·m and J·m used interchangeably?",
          "acceptedAnswer": { "@type": "Answer", "text": "N·m and J (joules) have the same dimensions (kg·m²/s²), but they represent different physical quantities. N·m is torque (force × distance), while J is energy (work done). The数值 may be the same, but the units are not interchangeable in physics. Torque is a vector; energy is a scalar." }
        },
        {
          "@type": "Question",
          "name": "What is a common torque value?",
          "acceptedAnswer": { "@type": "Answer", "text": "A car engine typically produces 100–500 N·m. A smartphone vibration motor produces about 0.001 N·m. A lug nut requires about 110 N·m (80 ft·lbf) to tighten. Earth's gravitational pull on the Moon produces about 4.7 × 10²⁶ N·m of torque." }
        },
        {
          "@type": "Question",
          "name": "How does a longer wrench help?",
          "acceptedAnswer": { "@type": "Answer", "text": "Torque = Force × distance. If you double the wrench length, you double the torque for the same applied force. This is why mechanics use breaker bars and cheater pipes — they increase the lever arm to generate more torque with less effort." }
        }
      ]
    }
    </script>

    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What is moment of force (torque)?', a: 'Moment of force, commonly called torque, is the rotational effect of a force applied at a distance from a pivot point. It equals Force × perpendicular distance (τ = F × r). The SI unit is the Newton-meter (N·m).' },
        { q: 'What is the difference between moment of force and moment of inertia?', a: 'Moment of force (torque) is the cause of rotational acceleration — it equals F × r. Moment of inertia is the resistance to rotational acceleration — it equals Σmr². Torque is linear with distance; moment of inertia is quadratic. A long wrench gives more torque, but a heavy rim gives more moment of inertia.' },
        { q: 'Why are N·m and J used in different contexts?', a: 'N·m and J (joules) have the same dimensions (kg·m²/s²), but they represent different physical quantities. N·m is torque (force × distance), while J is energy (work done). The numbers may be the same, but the units are not interchangeable in physics. Torque is a vector; energy is a scalar.' },
        { q: 'What is a common torque value?', a: 'A car engine typically produces 100–500 N·m. A smartphone vibration motor produces about 0.001 N·m. A lug nut requires about 110 N·m (80 ft·lbf) to tighten. Earth\'s gravitational pull on the Moon produces about 4.7 × 10²⁶ N·m of torque.' },
        { q: 'How does a longer wrench help?', a: 'Torque = Force × distance. If you double the wrench length, you double the torque for the same applied force. This is why mechanics use breaker bars and cheater pipes — they increase the lever arm to generate more torque with less effort.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to N·m ──────────────────────────────────
  const TO_NM = {
    Nm:    1,
    kNm:   1000,
    mNm:   0.001,
    cNm:   0.01,
    muNm:  1e-6,
    lfft:  1.35581796192,
    lfin:  0.11298483016,
    ozfin: 0.00706155189,
    kgfm:  9.80665,
    kgfcm: 0.0980665,
    gfcm:  9.80665e-5,
    gfm:   0.00980665,
    dyncm: 1e-7,
    dynm:  1e-5,
  };

  const UNITS = [
    { id: 'Nm',    label: 'N·m',     name: 'Newton-meter' },
    { id: 'kNm',   label: 'kN·m',    name: 'Kilonewton-meter' },
    { id: 'mNm',   label: 'mN·m',    name: 'Millinewton-meter' },
    { id: 'cNm',   label: 'cN·m',    name: 'Centinewton-meter' },
    { id: 'muNm',  label: 'μN·m',    name: 'Micronewton-meter' },
    { id: 'lfft',  label: 'lbf·ft',  name: 'Pound-foot' },
    { id: 'lfin',  label: 'lbf·in',  name: 'Pound-inch' },
    { id: 'ozfin', label: 'ozf·in',  name: 'Ounce-inch' },
    { id: 'kgfm',  label: 'kgf·m',   name: 'Kilogram-force meter' },
    { id: 'kgfcm', label: 'kgf·cm',  name: 'Kilogram-force cm' },
    { id: 'gfcm',  label: 'gf·cm',   name: 'Gram-force cm' },
    { id: 'gfm',   label: 'gf·m',    name: 'Gram-force meter' },
    { id: 'dyncm', label: 'dyn·cm',  name: 'Dyne-centimeter' },
    { id: 'dynm',  label: 'dyn·m',   name: 'Dyne-meter' },
  ];

  const REFS = [
    { name: 'Smartphone Vibration',   Nm: 0.001 },
    { name: 'Staple Gun',             Nm: 0.05 },
    { name: 'Hand Screwdriver',       Nm: 2 },
    { name: 'Bicycle Pedal',          Nm: 25 },
    { name: 'Car Lug Nut',            Nm: 110 },
    { name: 'Car Engine (avg)',        Nm: 300 },
    { name: 'Formula 1 Engine',       Nm: 450 },
    { name: 'Tractor Trailer Lug',    Nm: 680 },
  ];

  const input    = document.getElementById('mof-input') as HTMLInputElement;
  const select   = document.getElementById('mof-unit') as HTMLSelectElement;
  const grid     = document.getElementById('results')!;
  const refsDiv  = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e30) return value.toExponential(4);
    if (abs >= 1e15) return value.toLocaleString('en-US', { maximumFractionDigits: 0 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6)  return value.toLocaleString('en-US', { maximumFractionDigits: 12 });
    return value.toExponential(4);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const nm       = val * TO_NM[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = nm / TO_NM[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refsDiv.innerHTML = '';
    REFS.forEach(r => {
      const value = r.Nm / TO_NM[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refsDiv.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
