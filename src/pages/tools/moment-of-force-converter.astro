---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'moment-of-force-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Moment of Force Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a moment of force (torque) and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="mof-input">Moment of Force</label>
        <input id="mof-input" type="number" value="1" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="mof-unit">Unit</label>
        <select id="mof-unit" class="select-themed" style="min-width:12rem;">
          <option value="Nm" selected>N·m</option>
          <option value="kNm">kN·m</option>
          <option value="mNm">mN·m</option>
          <option value="lfft">lbf·ft</option>
          <option value="lfin">lbf·in</option>
          <option value="ozfin">ozf·in</option>
          <option value="kgfm">kgf·m</option>
          <option value="kgfcm">kgf·cm</option>
          <option value="gfcm">gf·cm</option>
          <option value="gfm">gf·m</option>
          <option value="cNm">cN·m</option>
          <option value="muNm">μN·m</option>
          <option value="dyncm">dyn·cm</option>
          <option value="dynm">dyn·m</option>
        </select>
      </div>
    </div>

    <!-- Results grid -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Concept Visualisation: Wrench + Lever Arm -->
    <div style="margin-top:1.5rem;background:var(--bg-surface);border:1.5px solid var(--border);border-radius:0.875rem;padding:1.25rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.75rem;">Why Lever Arm Length Matters — τ = F × r</p>
      <div style="display:flex;align-items:flex-start;justify-content:center;gap:2rem;flex-wrap:wrap;">
        <!-- Left: wrench diagram -->
        <svg width="300" height="200" viewBox="0 0 300 200" id="wrench-svg">
          <!-- Ground / axis -->
          <circle cx="50" cy="140" r="18" fill="var(--bg-surface-2)" stroke="var(--border)" stroke-width="2"/>
          <circle cx="50" cy="140" r="5" fill="var(--text-muted)"/>
          <text x="50" y="175" text-anchor="middle" font-size="9" font-weight="600" fill="var(--text-muted)" font-family="'Sora',sans-serif">AXIS</text>
          <!-- Lever arm -->
          <line x1="50" y1="140" x2="260" y2="140" stroke="var(--text-primary)" stroke-width="4" stroke-linecap="round"/>
          <!-- Force arrow -->
          <defs>
            <marker id="arrowF" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
              <path d="M 0,0 L 10,3.5 L 0,7 Z" fill="#EF4444"/>
            </marker>
          </defs>
          <line x1="260" y1="140" x2="260" y2="50" stroke="#EF4444" stroke-width="3" marker-end="url(#arrowF)"/>
          <text x="272" y="95" text-anchor="start" font-size="12" font-weight="700" fill="#EF4444" font-family="'Fira Code',monospace">F</text>
          <!-- Torque arc -->
          <defs>
            <marker id="arrowT" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
              <path d="M 0,0 L 8,3 L 0,6 Z" fill="#10B981"/>
            </marker>
          </defs>
          <path d="M 68,120 A 22,22 0 0,1 68,160" fill="none" stroke="#10B981" stroke-width="2.5" marker-end="url(#arrowT)"/>
          <text x="82" y="144" text-anchor="start" font-size="12" font-weight="700" fill="#10B981" font-family="'Fira Code',monospace">τ</text>
          <!-- r label -->
          <line x1="50" y1="124" x2="260" y2="124" stroke="#3B82F6" stroke-width="1.5" stroke-dasharray="5 3"/>
          <text x="155" y="118" text-anchor="middle" font-size="11" font-weight="600" fill="#3B82F6" font-family="'Fira Code',monospace">r (lever arm)</text>
          <!-- Formulas -->
          <text x="150" y="20" text-anchor="middle" font-size="13" font-weight="700" fill="var(--text-primary)" font-family="'Fira Code',monospace">τ = F × r</text>
          <text x="150" y="38" text-anchor="middle" font-size="9" fill="var(--text-muted)" font-family="'Sora',sans-serif">Same force, longer arm → more torque</text>
        </svg>
        <!-- Right: comparison -->
        <div style="flex:1;min-width:220px;max-width:300px;">
          <p class="text-secondary" style="font-size:0.78rem;font-weight:600;margin-bottom:0.75rem;">Same force, different lever arms:</p>
          <svg width="100%" viewBox="0 0 260 150" id="bar-svg">
            <!-- Short arm: 0.25 m -->
            <rect x="0" y="8" width="64" height="22" rx="4" fill="#3B82F6"/>
            <text x="72" y="23" font-size="10" font-weight="600" fill="var(--text-primary)" font-family="'Fira Code',monospace">0.25 m → 0.25F</text>
            <!-- Medium arm: 0.5 m -->
            <rect x="0" y="46" width="128" height="22" rx="4" fill="#3B82F6"/>
            <text x="136" y="61" font-size="10" font-weight="600" fill="var(--text-primary)" font-family="'Fira Code',monospace">0.50 m → 0.50F</text>
            <!-- Long arm: 1.0 m -->
            <rect x="0" y="84" width="256" height="22" rx="4" fill="#3B82F6"/>
            <text x="0" y="122" font-size="10" font-weight="700" fill="#3B82F6" font-family="'Fira Code',monospace">1.00 m → 1.00F</text>
            <text x="0" y="140" font-size="9" fill="var(--text-muted)" font-family="'Sora',sans-serif">Double the arm → double the torque (linear relationship)</text>
            <!-- Grid -->
            <line x1="128" y1="6" x2="128" y2="108" stroke="var(--border)" stroke-width="0.5" stroke-dasharray="2 2"/>
          </svg>
        </div>
      </div>
      <p class="seo-p-sm" style="text-align:center;margin-top:1rem;">
        Moment of force (torque) = <strong style="color:var(--text-primary);">Force × Perpendicular distance</strong> from the axis.
        Doubling the lever arm <strong style="color:#3B82F6;">doubles</strong> the torque — unlike moment of inertia where distance is <strong style="color:#EF4444;">squared</strong>.
      </p>
    </div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Common Moment of Force Values</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Convert Between N·m, Lbf·Ft, and Kgf·Cm</h2>
    <p class="seo-p">
      Your torque wrench is calibrated in lbf·ft, but the engine manual specifies 110 N·m for the cylinder head bolts. Type 110, select N·m, and see that it equals 81.13 lbf·ft, 11,217 kgf·cm, and 973 lbf·in. The wrench diagram shows the linear relationship between lever arm length and torque.
    </p>
    <p class="seo-p">
      The converter handles 14 units: N·m, kN·m, mN·m, cN·m, μN·m, lbf·ft, lbf·in, oz·in, kgf·m, kgf·cm, gf·cm, gf·m, dyn·cm, and dyn·m. A mechanic tightening wheel nuts at 100 lbf·ft sees it equals 135.6 N·m. A physicist measuring 2,500 dyn·cm from a torsion balance sees it equals 0.00025 N·m. The material reference covers torque values from smartphone vibration motors to Formula 1 engines.
    </p>

    <h3 class="font-display seo-h3-sm">Why N·m and Joules are not interchangeable</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['N·m is torque, Joule is energy', 'Both have dimensions of kg·m²/s², but torque is a vector (force x distance) and energy is a scalar (work done). A motor producing 100 N·m does not produce 100 J unless it rotates through 1 radian. Energy = torque x angle in radians. Using N·m when you mean J (or vice versa) produces wrong results in power calculations.'],
        ['Longer wrench means more torque', 'A mechanic using a 0.25 m wrench with 200 N force gets 50 N·m. Switching to a 0.5 m wrench doubles the torque to 100 N·m with the same force. This is why breaker bars and cheater pipes exist: they increase the lever arm. The wrench diagram on this page demonstrates this linear relationship.'],
        ['Car lug nut torque specs are critical', 'Under-torqued lug nuts can vibrate loose. Over-torqued nuts can strip threads or crack the wheel hub. A typical car requires 80-110 N·m (60-80 lbf·ft). A truck requires 300-600 N·m. If you use a wrench calibrated in lbf·ft but read the N·m specification without converting, you under-torque by 36% (since 1 lbf·ft = 1.356 N·m).']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Moment of Force Converter Handles N·m and Lbf·Ft</h2>
    <p class="seo-p">
      All conversions pass through Newton-meters (N·m). When you enter 100 lbf·ft, the tool multiplies by 1.35582 to get 135.58 N·m. Then it divides by each target unit's factor: by 1,000 for kN·m, by 0.09807 for kgf·cm, by 0.11298 for lbf·in. The result: 100 lbf·ft = 135.58 N·m = 1,627 lbf·in = 13,826 kgf·cm.
    </p>

    <h3 class="font-display seo-h3-sm">The lbf·ft factor of 1.35582 comes from two exact definitions</h3>
    <p class="seo-p-sm">
      1 lbf·ft = 1 lbf x 1 ft = 4.44822 N x 0.3048 m = 1.35582 N·m. The lbf (pound-force) is defined as the force on 1 pound mass in standard gravity: 1 lbf = 0.45359237 kg x 9.80665 m/s² = 4.44822 N. The foot is exactly 0.3048 m. Multiplying gives 1.35582 N·m exactly.
    </p>

    <h3 class="font-display seo-h3-sm">Why kgf·cm is still common in Asian manufacturing</h3>
    <p class="seo-p-sm">
      1 kgf·cm = 0.0980665 N·m (since 1 kgf = 9.80665 N and 1 cm = 0.01 m). Japanese and Chinese motor datasheets often specify torque in kgf·cm because it relates directly to the force a 1 kg mass exerts at 1 cm lever arm. A servo motor rated at 50 kgf·cm produces 4.903 N·m. Converting to N·m: 50 x 0.09807 = 4.903 N·m. Converting to lbf·ft: 4.903 / 1.35582 = 3.62 lbf·ft.
    </p>
    <p class="seo-p-none">
      The dynamic formatting handles the full range from micronewton-meters (MEMS devices, 10^-9 N·m) to kilonewton-meters (heavy machinery, 10^5 N·m). Very small values use scientific notation. Very large values use locale-formatted numbers. The converter also handles dyne-centimeters (CGS, 10^-7 N·m) for physics lab work with torsion balances.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How do I convert 100 lbf·ft to N·m?",
          a: "Multiply by 1.35582: 100 x 1.35582 = 135.58 N·m. For a quick estimate, multiply by 1.36: 100 x 1.36 = 136 N·m. The reverse: divide by 1.35582 or multiply by 0.7376. So 200 N·m = 147.5 lbf·ft. The converter shows all 14 units simultaneously."
        },
        {
          q: "What is the torque of a car engine?",
          a: "A typical gasoline engine produces 100-300 N·m (74-221 lbf·ft). A diesel engine produces 250-600 N·m (184-443 lbf·ft) because diesel combustion creates higher cylinder pressure. A Formula 1 engine produces about 450 N·m (332 lbf·ft) but at 15,000 RPM. A motorcycle produces 50-200 N·m at much higher RPM."
        },
        {
          q: "Why are N·m and Joules different if they look the same?",
          a: "N·m is torque: force x distance (a vector). J is energy: work done (a scalar). A motor producing 100 N·m does 100 J of work only if it rotates through 1 radian (57.3 degrees). Through a full revolution (2π radians), it does 628 J. Using N·m when you mean J produces wrong power calculations: P = torque x angular velocity, not P = energy x angular velocity."
        },
        {
          q: "How does a longer wrench help?",
          a: "Torque = force x distance. Double the wrench length, double the torque for the same force. A mechanic using 200 N on a 0.25 m wrench gets 50 N·m. On a 0.5 m wrench, the same 200 N produces 100 N·m. This is why breaker bars and cheater pipes exist: they increase the lever arm. The wrench diagram on this page shows this linear relationship."
        },
        {
          q: "What is the torque of a smartphone vibration motor?",
          a: "About 0.001 N·m (1 mN·m or 0.1 dyn·cm). This is enough to make the phone vibrate against your hand. The motor spins an eccentric mass at 10,000-20,000 RPM. The torque is tiny because the mass is small (a few grams) and the lever arm is short (a few millimetres). The converter handles this micro-torque range alongside engine-scale torque."
        },
        {
          q: "What is the difference between lbf·ft and lb·ft?",
          a: "lbf·ft (pound-force foot) is torque: force x distance. lb·ft (pound foot) is ambiguous and sometimes used for moment of inertia (lb·ft²). Always use lbf·ft for torque to avoid confusion. The lbf (pound-force) is the force on 1 lb mass in standard gravity: 1 lbf = 4.44822 N. The converter uses lbf·ft for clarity."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to N·m ──────────────────────────────────
  const TO_NM = {
    Nm:    1,
    kNm:   1000,
    mNm:   0.001,
    cNm:   0.01,
    muNm:  1e-6,
    lfft:  1.35581796192,
    lfin:  0.11298483016,
    ozfin: 0.00706155189,
    kgfm:  9.80665,
    kgfcm: 0.0980665,
    gfcm:  9.80665e-5,
    gfm:   0.00980665,
    dyncm: 1e-7,
    dynm:  1e-5,
  };

  const UNITS = [
    { id: 'Nm',    label: 'N·m',     name: 'Newton-meter' },
    { id: 'kNm',   label: 'kN·m',    name: 'Kilonewton-meter' },
    { id: 'mNm',   label: 'mN·m',    name: 'Millinewton-meter' },
    { id: 'cNm',   label: 'cN·m',    name: 'Centinewton-meter' },
    { id: 'muNm',  label: 'μN·m',    name: 'Micronewton-meter' },
    { id: 'lfft',  label: 'lbf·ft',  name: 'Pound-foot' },
    { id: 'lfin',  label: 'lbf·in',  name: 'Pound-inch' },
    { id: 'ozfin', label: 'ozf·in',  name: 'Ounce-inch' },
    { id: 'kgfm',  label: 'kgf·m',   name: 'Kilogram-force meter' },
    { id: 'kgfcm', label: 'kgf·cm',  name: 'Kilogram-force cm' },
    { id: 'gfcm',  label: 'gf·cm',   name: 'Gram-force cm' },
    { id: 'gfm',   label: 'gf·m',    name: 'Gram-force meter' },
    { id: 'dyncm', label: 'dyn·cm',  name: 'Dyne-centimeter' },
    { id: 'dynm',  label: 'dyn·m',   name: 'Dyne-meter' },
  ];

  const REFS = [
    { name: 'Smartphone Vibration',   Nm: 0.001 },
    { name: 'Staple Gun',             Nm: 0.05 },
    { name: 'Hand Screwdriver',       Nm: 2 },
    { name: 'Bicycle Pedal',          Nm: 25 },
    { name: 'Car Lug Nut',            Nm: 110 },
    { name: 'Car Engine (avg)',        Nm: 300 },
    { name: 'Formula 1 Engine',       Nm: 450 },
    { name: 'Tractor Trailer Lug',    Nm: 680 },
  ];

  const input    = document.getElementById('mof-input') as HTMLInputElement;
  const select   = document.getElementById('mof-unit') as HTMLSelectElement;
  const grid     = document.getElementById('results')!;
  const refsDiv  = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e30) return value.toExponential(4);
    if (abs >= 1e15) return value.toLocaleString('en-US', { maximumFractionDigits: 0 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6)  return value.toLocaleString('en-US', { maximumFractionDigits: 12 });
    return value.toExponential(4);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const nm       = val * TO_NM[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = nm / TO_NM[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refsDiv.innerHTML = '';
    REFS.forEach(r => {
      const value = r.Nm / TO_NM[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refsDiv.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
