---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'moment-of-force-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Moment of Force Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a moment of force (torque) and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="mof-input">Moment of Force</label>
        <input id="mof-input" type="number" value="1" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="mof-unit">Unit</label>
        <select id="mof-unit" class="select-themed" style="min-width:12rem;">
          <option value="Nm" selected>N·m</option>
          <option value="kNm">kN·m</option>
          <option value="mNm">mN·m</option>
          <option value="lfft">lbf·ft</option>
          <option value="lfin">lbf·in</option>
          <option value="ozfin">ozf·in</option>
          <option value="kgfm">kgf·m</option>
          <option value="kgfcm">kgf·cm</option>
          <option value="gfcm">gf·cm</option>
          <option value="gfm">gf·m</option>
          <option value="cNm">cN·m</option>
          <option value="muNm">μN·m</option>
          <option value="dyncm">dyn·cm</option>
          <option value="dynm">dyn·m</option>
        </select>
      </div>
    </div>

    <!-- Results grid -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Concept Visualisation: Wrench + Lever Arm -->
    <div style="margin-top:1.5rem;background:var(--bg-surface);border:1.5px solid var(--border);border-radius:0.875rem;padding:1.25rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.75rem;">Why Lever Arm Length Matters — τ = F × r</p>
      <div style="display:flex;align-items:flex-start;justify-content:center;gap:2rem;flex-wrap:wrap;">
        <!-- Left: wrench diagram -->
        <svg width="300" height="200" viewBox="0 0 300 200" id="wrench-svg">
          <!-- Ground / axis -->
          <circle cx="50" cy="140" r="18" fill="var(--bg-surface-2)" stroke="var(--border)" stroke-width="2"/>
          <circle cx="50" cy="140" r="5" fill="var(--text-muted)"/>
          <text x="50" y="175" text-anchor="middle" font-size="9" font-weight="600" fill="var(--text-muted)" font-family="'Sora',sans-serif">AXIS</text>
          <!-- Lever arm -->
          <line x1="50" y1="140" x2="260" y2="140" stroke="var(--text-primary)" stroke-width="4" stroke-linecap="round"/>
          <!-- Force arrow -->
          <defs>
            <marker id="arrowF" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
              <path d="M 0,0 L 10,3.5 L 0,7 Z" fill="#EF4444"/>
            </marker>
          </defs>
          <line x1="260" y1="140" x2="260" y2="50" stroke="#EF4444" stroke-width="3" marker-end="url(#arrowF)"/>
          <text x="272" y="95" text-anchor="start" font-size="12" font-weight="700" fill="#EF4444" font-family="'Fira Code',monospace">F</text>
          <!-- Torque arc -->
          <defs>
            <marker id="arrowT" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
              <path d="M 0,0 L 8,3 L 0,6 Z" fill="#10B981"/>
            </marker>
          </defs>
          <path d="M 68,120 A 22,22 0 0,1 68,160" fill="none" stroke="#10B981" stroke-width="2.5" marker-end="url(#arrowT)"/>
          <text x="82" y="144" text-anchor="start" font-size="12" font-weight="700" fill="#10B981" font-family="'Fira Code',monospace">τ</text>
          <!-- r label -->
          <line x1="50" y1="124" x2="260" y2="124" stroke="#3B82F6" stroke-width="1.5" stroke-dasharray="5 3"/>
          <text x="155" y="118" text-anchor="middle" font-size="11" font-weight="600" fill="#3B82F6" font-family="'Fira Code',monospace">r (lever arm)</text>
          <!-- Formulas -->
          <text x="150" y="20" text-anchor="middle" font-size="13" font-weight="700" fill="var(--text-primary)" font-family="'Fira Code',monospace">τ = F × r</text>
          <text x="150" y="38" text-anchor="middle" font-size="9" fill="var(--text-muted)" font-family="'Sora',sans-serif">Same force, longer arm → more torque</text>
        </svg>
        <!-- Right: comparison -->
        <div style="flex:1;min-width:220px;max-width:300px;">
          <p class="text-secondary" style="font-size:0.78rem;font-weight:600;margin-bottom:0.75rem;">Same force, different lever arms:</p>
          <svg width="100%" viewBox="0 0 260 150" id="bar-svg">
            <!-- Short arm: 0.25 m -->
            <rect x="0" y="8" width="64" height="22" rx="4" fill="#3B82F6"/>
            <text x="72" y="23" font-size="10" font-weight="600" fill="var(--text-primary)" font-family="'Fira Code',monospace">0.25 m → 0.25F</text>
            <!-- Medium arm: 0.5 m -->
            <rect x="0" y="46" width="128" height="22" rx="4" fill="#3B82F6"/>
            <text x="136" y="61" font-size="10" font-weight="600" fill="var(--text-primary)" font-family="'Fira Code',monospace">0.50 m → 0.50F</text>
            <!-- Long arm: 1.0 m -->
            <rect x="0" y="84" width="256" height="22" rx="4" fill="#3B82F6"/>
            <text x="0" y="122" font-size="10" font-weight="700" fill="#3B82F6" font-family="'Fira Code',monospace">1.00 m → 1.00F</text>
            <text x="0" y="140" font-size="9" fill="var(--text-muted)" font-family="'Sora',sans-serif">Double the arm → double the torque (linear relationship)</text>
            <!-- Grid -->
            <line x1="128" y1="6" x2="128" y2="108" stroke="var(--border)" stroke-width="0.5" stroke-dasharray="2 2"/>
          </svg>
        </div>
      </div>
      <p class="seo-p-sm" style="text-align:center;margin-top:1rem;">
        Moment of force (torque) = <strong style="color:var(--text-primary);">Force × Perpendicular distance</strong> from the axis.
        Doubling the lever arm <strong style="color:#3B82F6;">doubles</strong> the torque — unlike moment of inertia where distance is <strong style="color:#EF4444;">squared</strong>.
      </p>
    </div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Common Moment of Force Values</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Moment of Force Converter Overview</h2>
    <p class="seo-p">
      This moment of force converter computes precise conversions between 14 torque units — Newton-meters, kilonewton-meters, millinewton-meters, centinewton-meters, micronewton-meters, pound-feet, pound-inches, ounce-inches, kilogram-force meters, kilogram-force centimeters, gram-force centimeters, gram-force meters, dyne-centimeters, and dyne-meters — entirely within your browser. Built with modern vanilla JavaScript, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your calculations, whether you are working in automotive engineering, mechanical design, aerospace, or physics education.
    </p>
    <p class="seo-p">
      Torque is defined as force multiplied by the perpendicular distance from the pivot axis (<code class="inline-code">τ = F × r</code>). Unlike moment of inertia where distance is squared, torque depends <strong>linearly</strong> on distance — doubling the lever arm doubles the torque. The wrench diagram below demonstrates this principle visually. The converter handles the full range from micronewton-meters (microelectronics) to kilonewton-meters (heavy machinery), with dynamic formatting that adapts to each result's magnitude.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        [`Automotive maintenance and fastener specifications`, `Mechanics specify lug nut tightening torque in N·m or lbf·ft to ensure proper clamping force without stripping threads. A typical passenger car lug nut requires 80–110 N·m (60–80 lbf·ft). A heavy truck might require 300–600 N·m. Converting between N·m (metric specifications) and lbf·ft (US tools) is essential when using torque wrenches calibrated in different unit systems.`],
        [`Industrial automation and servo motor sizing`, `Engineers specify servo motor torque in N·m or kgf·cm to ensure sufficient force for the application. A pick-and-place robot might require 0.5 N·m at the joint, while a CNC machine spindle might need 50 N·m. Converting between N·m (motor datasheets) and kgf·cm (legacy specifications) ensures proper motor selection and prevents under-powered designs.`],
        [`Physics experiments and rotational mechanics labs`, `University physics labs measure torque using force sensors and lever arms, then verify it against calculated values. A 10 N force applied at 0.25 m produces 2.5 N·m of torque. Students need to convert between N·m (SI calculations), dyn·cm (CGS output from some sensors), and lbf·in (imperial lab equipment) when comparing results across different measurement systems.`]
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      All conversions use Newton-meters (N·m) as the universal base unit. Each supported torque unit is defined by a fixed conversion factor relative to one N·m. To convert from unit A to unit B, the tool multiplies the input value by A's factor to obtain N·m, then divides by B's factor to obtain the target value. This hub-and-spoke model guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">Nm</code>, <code class="inline-code">lfft</code>, <code class="inline-code">kgfcm</code>) to its conversion factor relative to N·m. SI units use powers of 10: <code class="inline-code">1 kN·m = 1,000 N·m</code>. Force-based units use standard definitions: <code class="inline-code">1 lbf·ft = 1.35582 N·m</code> (derived from <code class="inline-code">1 lbf = 4.44822 N</code> and <code class="inline-code">1 ft = 0.3048 m</code>).
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion to N·m:</strong> The input value is multiplied by the source unit's factor. For example, converting 100 lbf·ft to N·m: <code class="inline-code">100 × 1.35582 = 135.582 N·m</code>. Converting 50 kgf·cm to N·m: <code class="inline-code">50 × 0.0980665 = 4.9033 N·m</code>.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion from N·m:</strong> The N·m value is divided by the target unit's factor. Converting 135.582 N·m to lbf·in: <code class="inline-code">135.582 / 0.112985 ≈ 1,200 lbf·in</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>.
    </p>
    <p class="seo-p-sm">
      <strong>4. Dynamic formatting:</strong> The display format adapts to the magnitude of the result. Very large values (10³⁰ or greater) use scientific notation. Values between 1 and 10¹⁵ use locale-formatted numbers with 6 decimal places. Values between 0.001 and 1 use 8 decimal places. Values between 10⁻⁶ and 0.001 use 12 decimal places. Values below 10⁻⁶ use scientific notation. This ensures readability across the full range from dyne-centimeters to kilonewton-meters.
    </p>
    <p class="seo-p-none">
      <strong>Exact conversion factors:</strong> All factors are derived from exact international definitions: <code class="inline-code">1 lbf = 4.448221615367 N</code> (derived from <code class="inline-code">1 lb = 0.45359237 kg</code> and <code class="inline-code">1 ft = 0.3048 m</code>), <code class="inline-code">1 kgf = 9.80665 N</code> (exactly, standard gravity), <code class="inline-code">1 dyn = 10⁻⁵ N</code> (exactly), and <code class="inline-code">1 ozf = 0.27801385 N</code> (derived from <code class="inline-code">1 oz = 1/16 lb</code>). These are all exact by definition, so the IEEE 754 approximations provide full double-precision accuracy.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is moment of force (torque)?",
          a: "Moment of force, commonly called torque, is the rotational effect of a force applied at a distance from a pivot point. It equals force multiplied by the perpendicular distance from the axis: <code class='inline-code'>τ = F × r</code>. The SI unit is the Newton-meter (N·m). Torque is a vector quantity; its direction indicates the axis and sense of rotation."
        },
        {
          q: "What is the difference between moment of force and moment of inertia?",
          a: "Moment of force (torque) is the cause of rotational acceleration — it equals F × r. Moment of inertia is the resistance to rotational acceleration — it equals Σmr². Torque depends linearly on distance; moment of inertia depends on the square of distance. A long wrench gives more torque, but a heavy rim gives more moment of inertia."
        },
        {
          q: "Why are N·m and J used in different contexts?",
          a: "N·m and J (joules) have the same dimensions (kg·m²/s²), but they represent different physical quantities. N·m is torque (force × distance), while J is energy (work done). The numerical values may be identical, but the units are not interchangeable in physics. Torque is a vector quantity; energy is a scalar. Using the wrong unit in equations produces incorrect results."
        },
        {
          q: "What is a common torque value?",
          a: "A car engine typically produces 100–500 N·m. A smartphone vibration motor produces approximately 0.001 N·m. A lug nut requires approximately 110 N·m (80 lbf·ft) to tighten properly. A bicycle pedal applies approximately 25 N·m. A Formula 1 engine produces approximately 450 N·m at over 15,000 RPM."
        },
        {
          q: "How does a longer wrench help?",
          a: "Torque equals force multiplied by distance. If you double the wrench length, you double the torque for the same applied force. This is why mechanics use breaker bars and cheater pipes — they increase the lever arm to generate more torque with less effort. The wrench diagram on this page demonstrates this linear relationship visually."
        },
        {
          q: "What is the relationship between torque and power?",
          a: "Power equals torque multiplied by angular velocity: <code class='inline-code'>P = τ × ω</code>, where τ is in N·m and ω is in rad/s. A motor producing 100 N·m at 3,000 RPM (314.16 rad/s) delivers approximately 31.4 kW (42 hp). This relationship is fundamental in engine and motor sizing — high torque at low RPM (diesel) vs. low torque at high RPM (gasoline) can produce the same power."
        },
        {
          q: "How do I convert between lbf·ft and N·m?",
          a: "To convert lbf·ft to N·m, multiply by 1.35582. To convert N·m to lbf·ft, divide by 1.35582 (or multiply by 0.73756). For example, 100 lbf·ft equals approximately 135.6 N·m, and 200 N·m equals approximately 147.5 lbf·ft. This conversion is essential when working with US tool specifications and metric engineering calculations."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to N·m ──────────────────────────────────
  const TO_NM = {
    Nm:    1,
    kNm:   1000,
    mNm:   0.001,
    cNm:   0.01,
    muNm:  1e-6,
    lfft:  1.35581796192,
    lfin:  0.11298483016,
    ozfin: 0.00706155189,
    kgfm:  9.80665,
    kgfcm: 0.0980665,
    gfcm:  9.80665e-5,
    gfm:   0.00980665,
    dyncm: 1e-7,
    dynm:  1e-5,
  };

  const UNITS = [
    { id: 'Nm',    label: 'N·m',     name: 'Newton-meter' },
    { id: 'kNm',   label: 'kN·m',    name: 'Kilonewton-meter' },
    { id: 'mNm',   label: 'mN·m',    name: 'Millinewton-meter' },
    { id: 'cNm',   label: 'cN·m',    name: 'Centinewton-meter' },
    { id: 'muNm',  label: 'μN·m',    name: 'Micronewton-meter' },
    { id: 'lfft',  label: 'lbf·ft',  name: 'Pound-foot' },
    { id: 'lfin',  label: 'lbf·in',  name: 'Pound-inch' },
    { id: 'ozfin', label: 'ozf·in',  name: 'Ounce-inch' },
    { id: 'kgfm',  label: 'kgf·m',   name: 'Kilogram-force meter' },
    { id: 'kgfcm', label: 'kgf·cm',  name: 'Kilogram-force cm' },
    { id: 'gfcm',  label: 'gf·cm',   name: 'Gram-force cm' },
    { id: 'gfm',   label: 'gf·m',    name: 'Gram-force meter' },
    { id: 'dyncm', label: 'dyn·cm',  name: 'Dyne-centimeter' },
    { id: 'dynm',  label: 'dyn·m',   name: 'Dyne-meter' },
  ];

  const REFS = [
    { name: 'Smartphone Vibration',   Nm: 0.001 },
    { name: 'Staple Gun',             Nm: 0.05 },
    { name: 'Hand Screwdriver',       Nm: 2 },
    { name: 'Bicycle Pedal',          Nm: 25 },
    { name: 'Car Lug Nut',            Nm: 110 },
    { name: 'Car Engine (avg)',        Nm: 300 },
    { name: 'Formula 1 Engine',       Nm: 450 },
    { name: 'Tractor Trailer Lug',    Nm: 680 },
  ];

  const input    = document.getElementById('mof-input') as HTMLInputElement;
  const select   = document.getElementById('mof-unit') as HTMLSelectElement;
  const grid     = document.getElementById('results')!;
  const refsDiv  = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e30) return value.toExponential(4);
    if (abs >= 1e15) return value.toLocaleString('en-US', { maximumFractionDigits: 0 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6)  return value.toLocaleString('en-US', { maximumFractionDigits: 12 });
    return value.toExponential(4);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const nm       = val * TO_NM[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = nm / TO_NM[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refsDiv.innerHTML = '';
    REFS.forEach(r => {
      const value = r.Nm / TO_NM[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refsDiv.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
