---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'solar-panel-roi-estimator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Solar Panel ROI Estimator</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1.25rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Monthly Electricity Bill ($)</label>
        <input id="monthly-bill" type="number" value="200" min="10" step="5"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Electricity Rate ($/kWh)</label>
        <input id="rate" type="number" value="0.28" min="0.05" step="0.01"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Available Roof Area (m²)</label>
        <input id="roof-area" type="number" value="30" min="5" step="1"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Peak Sun Hours / Day</label>
        <input id="sun-hours" type="number" value="5" min="2" max="8" step="0.5"
          class="input-themed"/>
      </div>
    </div>

    <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:0.75rem; margin-bottom:1rem;">
      <div class="result-card" style="background:#FEFCE8; border-color:#FEF08A; text-align:center;">
        <div id="out-size" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#CA8A04;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#EAB308; margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.04em;">System Size (kW)</div>
      </div>
      <div class="result-card" style="background:#FFF7ED; border-color:#FED7AA; text-align:center;">
        <div id="out-system-cost" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#D97706;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#FB923C; margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.04em;">Est. System Cost</div>
      </div>
      <div class="result-card" style="background:#F0FDF4; border-color:#BBF7D0; text-align:center;">
        <div id="out-savings" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#16A34A;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#4ADE80; margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.04em;">Monthly Savings</div>
      </div>
      <div class="result-card" style="background:#EFF6FF; border-color:#BFDBFE; text-align:center;">
        <div id="out-payback" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#1D4ED8;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#60A5FA; margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.04em;">Payback Period</div>
      </div>
    </div>

    <div style="background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.5rem; padding:0.625rem 0.875rem; font-size:0.75rem; color:var(--text-secondary);">
      💡 Peak sun hours for Australian cities: Darwin 6.0, Brisbane 5.2, Perth 5.0, Adelaide 4.8, Sydney 4.5, Melbourne 4.0, Hobart 3.5. International: Phoenix USA 6.5, London 2.5, Dubai 6.0.
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Solar Panel ROI Estimator</h2>
    <p class="seo-p">Enter your electricity details and system preferences to estimate solar payback period, lifetime savings, and levelized cost of energy for your home or business.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Set System Size</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Enter the kWp capacity of your proposed solar array and the wattage per panel to determine the total number of panels required.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Configure Location</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Select your average peak sun hours per day and electricity rate to reflect local solar irradiance and utility costs.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Add Cost Details</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Input the total installation cost, optional battery storage price, and annual maintenance expenses for an accurate financial picture.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Review ROI</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Instantly see your estimated payback period, total 25-year savings, and levelized cost of energy to decide if the investment is worthwhile.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Solar Panel ROI Estimator Works</h2>
    <p class="seo-p">The estimator uses a production-based model to predict solar output and financial returns based on your location, system size, and cost inputs.</p>
    <h3 class="font-display seo-h3-sm">Solar Production Model</h3>
    <p class="seo-p">Daily energy generation is calculated as <code class="inline-code">System kW × Peak Sun Hours × 0.8</code>, where the 0.8 factor accounts for real-world losses from inverter inefficiency, wiring resistance, panel mismatch, and temperature derating. Annual production is then projected by multiplying daily output by 365 days.</p>
    <h3 class="font-display seo-h3-sm">Financial Payback Analysis</h3>
    <p class="seo-p">The payback period is determined by dividing the total system cost by the annual electricity savings. The estimator also computes net present value using a <code class="inline-code">3% discount rate</code> over 25 years, accounting for panel degradation of 0.5% per year to give a realistic picture of long-term returns.</p>
    <h3 class="font-display seo-h3-sm">LCOE and Savings Projection</h3>
    <p class="seo-p">Levelized cost of energy is calculated as <code class="inline-code">Total Lifetime Cost / Total Lifetime Generation</code>, expressed in cents per kilowatt-hour. This allows direct comparison with your utility rate to determine whether solar is cost-effective in your area.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What system size do I actually need?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A common rule of thumb is 1 kW of solar for every $200-$250 of quarterly electricity bills. For Australian homes, 6.6 kW systems are the most popular as they qualify for maximum STC incentives. This estimator helps you cross-check against that benchmark using your actual consumption.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do solar feed-in tariffs affect ROI?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Feed-in tariffs compensate you for surplus solar energy exported to the grid, typically ranging from 2-10 cents per kWh in Australia. Higher self-consumption during daylight hours is generally more valuable than exporting at feed-in rates, which is why timers or battery storage can improve overall returns.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Should I add a battery?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Home battery systems typically cost $8,000-$15,000 and currently have payback periods of 12-20 years in most Australian states. Batteries make financial sense if you have high evening usage, frequent blackouts, or very low feed-in tariff rates that make self-consumption more economical.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How long do solar panels last?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Quality panels from tier-1 manufacturers typically degrade less than 0.5% per year and carry 25-30 year performance warranties. After 25 years, panels still produce approximately 80-85% of original capacity. Inverters typically need replacement every 10-15 years at a cost of $1,500-$3,000.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does battery storage affect solar ROI?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Battery storage increases self-consumption of solar energy by storing excess daytime generation for evening use. This improves ROI when feed-in tariffs are low, but the upfront cost extends the overall payback period. This estimator lets you model the financial impact of adding battery storage to your system.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What government incentives are available for solar panels?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">In Australia, the main federal incentive is Small-scale Technology Certificates (STCs), which provide an upfront discount on installation costs based on system size and location. Some states and territories offer additional rebates or interest-free loans. Check the Clean Energy Regulator website for current incentive amounts in your area.</p>
        </div>
      </div>
    </div>
    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7; padding:1rem 1.25rem; border-radius:0.5rem">
      <strong style="display:block; margin-bottom:0.35rem">Disclaimer</strong>
      This calculator provides estimates only. Actual savings depend on local sunlight, utility rates, panel orientation, shading, installation costs, and government incentives. Consult a certified solar installer for accurate quotes.
    </div>
  </div>

</ToolLayout>

<script>
  function calc() {
    const bill     = parseFloat((document.getElementById('monthly-bill') as HTMLInputElement).value)  || 0;
    const rate     = parseFloat((document.getElementById('rate') as HTMLInputElement).value)          || 0.28;
    const roofArea = parseFloat((document.getElementById('roof-area') as HTMLInputElement).value)     || 0;
    const sunHrs   = parseFloat((document.getElementById('sun-hours') as HTMLInputElement).value)     || 5;

    const dailyUsage    = bill / rate / 30;
    const sizeByUsage   = dailyUsage / (sunHrs * 0.8);
    const panelCount    = Math.floor(roofArea / 1.8);
    const sizeByRoof    = panelCount * 0.4;
    const systemKw      = Math.min(sizeByUsage, sizeByRoof);
    const systemCost    = systemKw * 1000;
    const dailyGen      = systemKw * sunHrs * 0.8;
    const monthlySavings = Math.min(bill, dailyGen * rate * 30);
    const paybackYears  = monthlySavings > 0 ? systemCost / (monthlySavings * 12) : 0;

    (document.getElementById('out-size') as HTMLElement).textContent        = systemKw.toFixed(1) + ' kW';
    (document.getElementById('out-system-cost') as HTMLElement).textContent = '$' + Math.round(systemCost).toLocaleString();
    (document.getElementById('out-savings') as HTMLElement).textContent     = '$' + Math.round(monthlySavings) + '/mo';
    (document.getElementById('out-payback') as HTMLElement).textContent     = paybackYears > 0 ? paybackYears.toFixed(1) + ' yrs' : '—';
  }

  ['monthly-bill','rate','roof-area','sun-hours'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));
  calc();
</script>
