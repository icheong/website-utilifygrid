---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'power-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Power Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a power value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="pwr-input">Power</label>
        <input id="pwr-input" type="number" value="1000" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="pwr-unit">Unit</label>
        <select id="pwr-unit" class="select-themed" style="min-width:10rem;">
          <option value="w" selected>Watt (W)</option>
          <option value="mw">Milliwatt (mW)</option>
          <option value="kw">Kilowatt (kW)</option>
          <option value="mwatt">Megawatt (MW)</option>
          <option value="gw">Gigawatt (GW)</option>
          <option value="hp-mech">Horsepower (mech)</option>
          <option value="hp-metric">Horsepower (metric)</option>
          <option value="hp-elec">Horsepower (elec)</option>
          <option value="btu-hr">BTU/hr</option>
          <option value="btu-min">BTU/min</option>
          <option value="ton-ref">Ton of Refrigeration</option>
          <option value="kcal-hr">kcal/hr</option>
          <option value="ftlb-s">ft·lb/s</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Power Converter Overview</h2>
    <p class="seo-p">
      This power converter computes precise conversions between 13 metric, imperial, and thermal power units entirely within your browser. Built with modern vanilla JavaScript, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your calculations, whether you are working in automotive engineering, HVAC design, electrical engineering, or physics.
    </p>
    <p class="seo-p">
      The converter supports the most commonly used power units across SI, imperial, and thermal systems: watts, milliwatts, kilowatts, megawatts, and gigawatts for SI; mechanical, metric, and electrical horsepower for imperial; BTU per hour and BTU per minute for thermal; ton of refrigeration for HVAC; kilocalories per hour for thermal engineering; and foot-pounds per second for mechanical power. Results are dynamically formatted based on magnitude, switching between fixed notation, locale-formatted numbers, and scientific notation as appropriate.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Automotive and engine specifications', 'Car engines are rated in horsepower. A 150 hp (mechanical) engine produces 111,855 watts of power. European manufacturers specify power in kilowatts (kW) or metric horsepower (PS), so a 110 kW engine equals approximately 147.5 hp (mech) or 149.6 PS (metric). The quick-reference section helps visualise everyday power levels like a smartphone charger (5 W), a laptop charger (65 W), or a car engine (111,855 W) for intuitive scale comparison.'],
        ['HVAC and air conditioning sizing', 'Air conditioners and furnaces are rated in BTU/hr or tons of refrigeration. A 3-ton AC unit produces 36,000 BTU/hr of cooling, equivalent to 10,550 watts or about 14.1 hp. When comparing electric heaters (rated in watts) to gas furnaces (rated in BTU/hr), you need to convert between systems. A 1,500-watt space heater produces about 5,118 BTU/hr — roughly half the output of a small gas furnace.'],
        ['Electrical appliance energy auditing', 'Homeowners comparing appliance power consumption need to understand wattage ratings. A 100W incandescent bulb produces the same light as a 15W LED, but both are measured in watts. When calculating electricity costs, convert wattage to kilowatts and multiply by hours of use: a 1,500W hair dryer running for 10 minutes uses 0.25 kWh. This tool helps compare power across different unit systems for accurate energy cost estimation.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      The converter employs a hub-and-spoke conversion model using watts as the universal base unit. Every supported power unit is defined by a fixed conversion factor relative to one watt. To convert from unit A to unit B, the tool multiplies the input value by A's factor to obtain watts, then divides by B's factor to obtain the target value. This approach guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">w</code>, <code class="inline-code">hp-mech</code>, <code class="inline-code">btu-hr</code>) to its exact factor in watts. Metric units use powers of 10 (e.g. <code class="inline-code">1 kW = 1,000 W</code>, <code class="inline-code">1 MW = 1,000,000 W</code>), while imperial and thermal units use internationally defined values.
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion:</strong> The input value is multiplied by the source unit's factor to convert to watts. For example, converting 100 hp (mech) to watts: <code class="inline-code">100 × 745.7 = 74,570 W</code>. This intermediate result is an IEEE 754 double-precision floating-point number, which provides approximately 15 to 17 significant decimal digits of precision.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion:</strong> The watt value is divided by the target unit's factor. Converting 74,570 W to kW: <code class="inline-code">74570 / 1000 = 74.57 kW</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>.
    </p>
    <p class="seo-p-sm">
      <strong>4. Dynamic formatting:</strong> The display format adapts to the magnitude of the result. Very large values (1 trillion or greater) use scientific notation. Values between 1 billion and 1 trillion use locale-formatted numbers with 2 decimal places. Values between 1,000 and 1 billion use 2 to 4 decimal places. Values between 0.001 and 1,000 use 6 to 8 decimal places. Values below 0.001 use scientific notation. This ensures readability across the full range from milliwatts to gigawatts.
    </p>
    <p class="seo-p-none">
      <strong>Exact vs. approximate factors:</strong> Electrical horsepower is defined as exactly 746 W. The metric horsepower (PS) is defined as exactly 735.49875 W. The mechanical horsepower (hp) is defined as exactly 550 foot-pounds per second, which equals 745.69987... W (rounded to 745.7 W for display). The ton of refrigeration is defined as exactly 12,000 BTU/hr. BTU/hr uses the IT BTU definition of 1,055.06 J, making <code class="inline-code">1 BTU/hr = 0.293071 W</code> approximate but standard.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is the difference between mechanical and metric horsepower?",
          a: "Mechanical horsepower (hp) = 745.7 W, used in the US and UK. Metric horsepower (PS or CV) = 735.5 W, used in Europe. The difference is about 1.4%. A car rated at 100 hp (mech) would be 101.4 PS (metric). The electrical horsepower (746 W) is used specifically for electric motor ratings."
        },
        {
          q: "What is a ton of refrigeration?",
          a: "One ton of refrigeration equals 12,000 BTU/hr or about 3,517 watts. It represents the cooling power needed to freeze one short ton (2,000 lb) of water at 0°C in 24 hours. Air conditioners are commonly rated in tons — a 3-ton unit provides 36,000 BTU/hr of cooling, equivalent to about 10.5 kW."
        },
        {
          q: "How many watts is a horsepower?",
          a: "One mechanical horsepower equals 745.7 watts. One metric horsepower equals 735.5 watts. One electrical horsepower equals 746 watts exactly. The value depends on which definition of horsepower you use. For quick mental conversion, 1 hp is roughly 750 W."
        },
        {
          q: "What is the difference between power and energy?",
          a: "Power is the rate of energy transfer, measured in watts (W). Energy is the total amount of work done, measured in joules (J) or watt-hours (Wh). A 100W bulb running for 1 hour uses 100 Wh of energy. Power tells you how fast energy is being used, while energy tells you how much total energy was consumed."
        },
        {
          q: "What is a BTU per hour?",
          a: "A BTU/hr is a unit of power used in HVAC and heating. One BTU/hr equals about 0.293 watts. Furnaces and air conditioners are often rated in BTU/hr. 12,000 BTU/hr equals one ton of refrigeration. To convert BTU/hr to watts, multiply by 0.293071. To convert watts to BTU/hr, multiply by 3.41214."
        },
        {
          q: "How do I calculate electricity cost from wattage?",
          a: "Multiply the appliance wattage by hours of use, then divide by 1,000 to get kilowatt-hours (kWh). For example, a 1,500W space heater running for 8 hours uses 12 kWh. At $0.12 per kWh, that costs $1.44. This tool helps convert between power units to compare different appliances accurately."
        },
        {
          q: "What is the relationship between watts and BTU/hr?",
          a: "1 watt equals approximately 3.41214 BTU/hr. To convert watts to BTU/hr, multiply by 3.41214. To convert BTU/hr to watts, divide by 3.41214 or multiply by 0.293071. For quick mental estimates, 1,000 W is roughly 3,412 BTU/hr. This conversion is essential when comparing electric heaters (watts) to gas furnaces (BTU/hr)."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to watts ─────────────────────────────────
  const TO_W = {
    w:        1,
    mw:       0.001,
    kw:       1_000,
    mwatt:    1_000_000,
    gw:       1_000_000_000,
    'hp-mech': 745.7,
    'hp-metric': 735.49875,
    'hp-elec': 746,
    'btu-hr': 0.29307107,
    'btu-min': 17.5842642,
    'ton-ref': 3516.85284,
    'kcal-hr': 1.163,
    'ftlb-s': 1.35581795,
  };

  const UNITS = [
    { id: 'w',         label: 'W',     name: 'Watt' },
    { id: 'mw',        label: 'mW',    name: 'Milliwatt' },
    { id: 'kw',        label: 'kW',    name: 'Kilowatt' },
    { id: 'mwatt',     label: 'MW',    name: 'Megawatt' },
    { id: 'gw',        label: 'GW',    name: 'Gigawatt' },
    { id: 'hp-mech',   label: 'hp',    name: 'Horsepower (mech)' },
    { id: 'hp-metric', label: 'PS',    name: 'Horsepower (metric)' },
    { id: 'hp-elec',   label: 'hp(e)', name: 'Horsepower (elec)' },
    { id: 'btu-hr',    label: 'BTU/h', name: 'BTU per Hour' },
    { id: 'btu-min',   label: 'BTU/m', name: 'BTU per Minute' },
    { id: 'ton-ref',   label: 'TR',    name: 'Ton of Refrigeration' },
    { id: 'kcal-hr',   label: 'kcal/h',name: 'Kilocalorie per Hour' },
    { id: 'ftlb-s',    label: 'ft·lb/s', name: 'Foot-pound per Second' },
  ];

  // ── Quick-reference objects (stored in watts) ───────────────────
  const REFS = [
    { name: 'Smartphone Charger',     w: 5 },
    { name: 'LED Bulb',               w: 10 },
    { name: 'Laptop Charger',         w: 65 },
    { name: 'Desktop PC',             w: 300 },
    { name: 'Microwave Oven',         w: 1_000 },
    { name: 'Vacuum Cleaner',         w: 1_400 },
    { name: 'Hair Dryer',             w: 1_875 },
    { name: 'Electric Kettle',        w: 2_200 },
    { name: 'Space Heater',           w: 1_500 },
    { name: 'Window AC Unit',         w: 1_200 },
    { name: 'Car Engine (150 hp)',    w: 111_855 },
    { name: 'Locomotive (4,400 hp)',  w: 3_280_680 },
  ];

  const input  = document.getElementById('pwr-input') as HTMLInputElement;
  const select = document.getElementById('pwr-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e12) return value.toExponential(4);
    if (abs >= 1e9)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    return value.toExponential(4);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const wVal     = val * TO_W[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = wVal / TO_W[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = r.w / TO_W[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
