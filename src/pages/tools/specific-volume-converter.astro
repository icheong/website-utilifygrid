---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'specific-volume-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Specific Volume Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a specific volume and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="sv-input">Specific Volume</label>
        <input id="sv-input" type="number" value="0.001" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="sv-unit">Unit</label>
        <select id="sv-unit" class="select-themed" style="min-width:12rem;">
          <option value="m3kg" selected>m³/kg</option>
          <option value="cm3g">cm³/g</option>
          <option value="mLg">mL/g</option>
          <option value="Lkg">L/kg</option>
          <option value="Lg">L/g</option>
          <option value="ft3lb">ft³/lb</option>
          <option value="in3lb">in³/lb</option>
          <option value="galb">US gal/lb</option>
          <option value="igalb">Imp gal/lb</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Material Specific Volumes</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Specific Volume Converter Overview</h2>
    <p class="seo-p">
      This specific volume converter computes precise conversions between 9 specific volume units — cubic meters per kilogram, cubic centimeters per gram, milliliters per gram, liters per kilogram, liters per gram, cubic feet per pound, cubic inches per pound, US gallons per pound, and imperial gallons per pound — entirely within your browser. Built with modern vanilla JavaScript, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your calculations, whether you are working in thermodynamics, fluid mechanics, HVAC engineering, or materials science.
    </p>
    <p class="seo-p">
      Specific volume is the mathematical reciprocal of density (<code class="inline-code">v = 1/ρ</code>), meaning a substance with high density has low specific volume and vice versa. The converter handles the full range from gases (air at approximately 0.816 m³/kg) to dense metals (osmium at approximately 0.0000443 m³/kg), with dynamic formatting that adapts to each result's magnitude. The material reference section provides benchmarks for common substances including air, water, metals, and precious metals.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        [`Thermodynamics and steam table calculations`, `Specific volume is a fundamental property in thermodynamics, appearing directly in steam tables and the ideal gas law (<code class="inline-code">v = RT/P</code>). Power plant engineers use specific volume to calculate steam flow rates, turbine efficiency, and boiler performance. At standard atmospheric pressure, water steam has a specific volume of approximately 1.694 m³/kg, while liquid water at the same conditions has a specific volume of 0.001 m³/kg — a ratio of nearly 1,700 to 1.`],
        [`HVAC system design and refrigeration`, `HVAC engineers specify refrigerant properties using specific volume to size compressors, condensers, and evaporators. R-134a refrigerant has a specific volume of approximately 0.029 m³/kg at typical evaporator conditions, which determines the volume flow rate the compressor must handle. Converting between metric (m³/kg) and imperial (ft³/lb) units is essential when working with equipment from different manufacturers.`],
        [`Chemical process engineering and mixing`, `Chemical engineers use specific volume to calculate vessel capacities, mixing ratios, and flow rates in process plants. A reactor vessel designed to hold 10,000 kg of a fluid with specific volume 0.0015 m³/kg requires a capacity of 15 m³. Converting between cm³/g (lab measurements) and m³/kg (plant specifications) ensures accurate scale-up from laboratory to production.`]
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      All conversions use cubic meters per kilogram (m³/kg) as the universal base unit. Each supported specific volume unit is defined by a fixed conversion factor relative to one m³/kg. To convert from unit A to unit B, the tool multiplies the input value by A's factor to obtain m³/kg, then divides by B's factor to obtain the target value. This hub-and-spoke model guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">m3kg</code>, <code class="inline-code">cm3g</code>, <code class="inline-code">ft3lb</code>) to its conversion factor relative to m³/kg. Metric units use powers of 10: <code class="inline-code">1 cm³/g = 0.001 m³/kg</code> (since 1 cm³ = 10⁻⁶ m³ and 1 g = 10⁻³ kg). Imperial units use exact definitions: <code class="inline-code">1 ft³/lb = 0.062428 m³/kg</code>.
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion to m³/kg:</strong> The input value is multiplied by the source unit's factor. For example, converting 1 cm³/g to m³/kg: <code class="inline-code">1 × 0.001 = 0.001 m³/kg</code>. Converting 27.68 in³/lb to m³/kg: <code class="inline-code">27.68 × 0.036127 ≈ 1.0 m³/kg</code>.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion from m³/kg:</strong> The m³/kg value is divided by the target unit's factor. Converting 0.001 m³/kg to ft³/lb: <code class="inline-code">0.001 / 0.062428 ≈ 0.01602 ft³/lb</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>.
    </p>
    <p class="seo-p-sm">
      <strong>4. Dynamic formatting:</strong> The display format adapts to the magnitude of the result. Values above 1,000 use locale-formatted numbers with 4 decimal places. Values between 1 and 1,000 use 6 decimal places. Values between 0.001 and 1 use 8 decimal places. Values between 10⁻⁶ and 0.001 use 10 decimal places. Values below 10⁻⁶ use scientific notation. This ensures readability across the full range from gas-phase specific volumes to dense metal alloys.
    </p>
    <p class="seo-p-none">
      <strong>Exact conversion factors:</strong> All factors are derived from exact definitions: <code class="inline-code">1 lb = 0.45359237 kg</code> (exactly), <code class="inline-code">1 ft = 0.3048 m</code> (exactly), <code class="inline-code">1 in = 0.0254 m</code> (exactly), <code class="inline-code">1 US gallon = 3.785411784 L</code> (exactly), and <code class="inline-code">1 imp gallon = 4.54609 L</code> (exactly). The metric factors are exact rational values: <code class="inline-code">1 cm³/g = 10⁻³ m³/kg</code> exactly. These are all exact by definition, so the IEEE 754 approximations provide full double-precision accuracy.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is specific volume?",
          a: "Specific volume is the volume occupied by a unit mass of a substance, defined as the reciprocal of density (<code class='inline-code'>v = 1/ρ</code>). For example, water has a specific volume of 0.001 m³/kg, meaning 1 kilogram of water occupies exactly 0.001 cubic meters (1 liter). Specific volume is used when it is more convenient to think about volume per unit mass rather than mass per unit volume."
        },
        {
          q: "How is specific volume different from density?",
          a: "Density equals mass divided by volume (kg/m³), while specific volume equals volume divided by mass (m³/kg). They are mathematical reciprocals. A substance with high density (like gold at 19,300 kg/m³) has low specific volume (0.0000518 m³/kg). A substance with low density (like air at 1.225 kg/m³) has high specific volume (0.816 m³/kg)."
        },
        {
          q: "Where is specific volume used?",
          a: "Specific volume is commonly used in thermodynamics and fluid mechanics. It appears in steam tables, ideal gas calculations (<code class='inline-code'>v = RT/P</code>), and HVAC system design. Engineers use it to determine how much space a given mass of fluid occupies, which is essential for sizing pipes, ducts, compressors, and storage vessels."
        },
        {
          q: "What is the specific volume of air?",
          a: "At sea level and 15°C, air has a density of approximately 1.225 kg/m³, giving a specific volume of approximately 0.816 m³/kg. This means 1 kilogram of air occupies about 816 liters — air is nearly 800 times less dense than water. The specific volume of air changes significantly with temperature and pressure, which is why HVAC calculations must account for these variations."
        },
        {
          q: "Why are cm³/g, mL/g, and L/kg the same value?",
          a: "All three units equal 0.001 m³/kg because of the relationships between metric units: 1 cm³ = 1 mL = 0.001 L, and 1 kg = 1,000 g. Therefore 1 cm³/g = (0.001 L) / (0.001 kg) = 1 L/kg = 0.001 m³/kg. This equivalence simplifies conversions between laboratory and industrial specifications."
        },
        {
          q: "How does specific volume change with temperature?",
          a: "Specific volume generally increases with temperature because most materials expand when heated (thermal expansion). For gases, specific volume increases dramatically with temperature at constant pressure, following the ideal gas law. For liquids and solids, the change is much smaller — water's specific volume increases by about 0.02% between 4°C and 20°C."
        },
        {
          q: "How do I calculate specific volume from density?",
          a: "Divide 1 by the density value. For example, if a fluid has a density of 800 kg/m³, its specific volume is 1/800 = 0.00125 m³/kg. In imperial units, if the density is 50 lb/ft³, the specific volume is 1/50 = 0.02 ft³/lb. This tool performs this calculation automatically for all supported unit pairs."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to m³/kg ─────────────────────────────────
  const TO_M3KG = {
    m3kg:  1,
    cm3g:  0.001,
    mLg:   0.001,
    Lkg:   0.001,
    Lg:    1,
    ft3lb: 0.0624279606,
    in3lb: 0.0361272867,
    galb:  0.0083454045,
    igalb: 0.0100224129,
  };

  const UNITS = [
    { id: 'm3kg',  label: 'm³/kg',    name: 'Cubic Meter per kg' },
    { id: 'cm3g',  label: 'cm³/g',    name: 'Cubic cm per gram' },
    { id: 'mLg',   label: 'mL/g',     name: 'Milliliter per gram' },
    { id: 'Lkg',   label: 'L/kg',     name: 'Liter per kilogram' },
    { id: 'Lg',    label: 'L/g',      name: 'Liter per gram' },
    { id: 'ft3lb', label: 'ft³/lb',   name: 'Cubic foot per pound' },
    { id: 'in3lb', label: 'in³/lb',   name: 'Cubic inch per pound' },
    { id: 'galb',  label: 'gal/lb',   name: 'US Gallon per pound' },
    { id: 'igalb', label: 'igal/lb',  name: 'Imp Gallon per pound' },
  ];

  const REFS = [
    { name: 'Air (15°C)',      m3kg: 0.816 },
    { name: 'Styrofoam',        m3kg: 0.033 },
    { name: 'Oak Wood',         m3kg: 0.00133 },
    { name: 'Ice',              m3kg: 0.00109 },
    { name: 'Water (4°C)',      m3kg: 0.001 },
    { name: 'Seawater',         m3kg: 0.000976 },
    { name: 'Aluminum',         m3kg: 0.00037 },
    { name: 'Iron',             m3kg: 0.000127 },
    { name: 'Copper',           m3kg: 0.000112 },
    { name: 'Gold',             m3kg: 0.0000518 },
    { name: 'Lead',             m3kg: 0.0000882 },
    { name: 'Osmium',           m3kg: 0.0000443 },
  ];

  const input    = document.getElementById('sv-input') as HTMLInputElement;
  const select   = document.getElementById('sv-unit') as HTMLSelectElement;
  const grid     = document.getElementById('results')!;
  const refsDiv  = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 0.000001) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const m3kg     = val * TO_M3KG[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = m3kg / TO_M3KG[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refsDiv.innerHTML = '';
    REFS.forEach(r => {
      const value = r.m3kg / TO_M3KG[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refsDiv.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
