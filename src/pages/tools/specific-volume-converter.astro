---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'specific-volume-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Specific Volume Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a specific volume and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="sv-input">Specific Volume</label>
        <input id="sv-input" type="number" value="0.001" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="sv-unit">Unit</label>
        <select id="sv-unit" class="select-themed" style="min-width:12rem;">
          <option value="m3kg" selected>m³/kg</option>
          <option value="cm3g">cm³/g</option>
          <option value="mLg">mL/g</option>
          <option value="Lkg">L/kg</option>
          <option value="Lg">L/g</option>
          <option value="ft3lb">ft³/lb</option>
          <option value="in3lb">in³/lb</option>
          <option value="galb">US gal/lb</option>
          <option value="igalb">Imp gal/lb</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Material Specific Volumes</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Convert Between M³/Kg, Ft³/Lb, and Cm³/G</h2>
    <p class="seo-p">
      Your steam table lists specific volume at 0.001 m³/kg. Your plant specification uses ft³/lb. Type 0.001, select m³/kg, and see that it equals 0.01602 ft³/lb, 1.0 cm³/g, and 1.0 mL/g. The material reference confirms water at standard conditions is 0.001 m³/kg, so the numbers match.
    </p>
    <p class="seo-p">
      The converter handles 9 units: m³/kg, cm³/g, mL/g, L/kg, L/g, ft³/lb, in³/lb, US gal/lb, and imp gal/lb. A thermodynamics student working with steam at 1.694 m³/kg sees it equals 27.14 ft³/lb and 1,694 L/kg. An HVAC engineer sizing a compressor for R-134a at 0.029 m³/kg sees it equals 0.4645 ft³/lb. The material reference shows air at 0.816 m³/kg to osmium at 0.0000443 m³/kg.
    </p>

    <h3 class="font-display seo-h3-sm">Why specific volume matters more than density in thermodynamics</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Steam tables use specific volume, not density', 'Power plant engineers read steam tables that list specific volume (v) at each pressure and temperature. At 100°C and 1 atm, steam v = 1.694 m³/kg while liquid water v = 0.001 m³/kg. The ratio is 1,694:1. To convert steam flow from m³/s to kg/s, divide by specific volume: mass flow = volume flow / v. Using density instead of specific volume gives the wrong direction of conversion.'],
        ['HVAC compressors are sized by volume flow rate', 'A refrigerator compressor must move enough R-134a vapour to absorb the required heat. The evaporator output is 0.029 m³/kg. To move 0.05 kg/s of refrigerant, the compressor needs 0.05 x 0.029 = 0.00145 m³/s = 5.22 m³/hr. If you use density (34.5 kg/m³) instead of specific volume, you calculate 0.05 / 34.5 = 0.00145 m³/s, which happens to give the same answer because v = 1/rho. But the mental model is different.'],
        ['Ideal gas law uses specific volume directly', 'The ideal gas law in specific volume form is Pv = RT, where v is m³/kg. For air at 20°C and 1 atm: v = RT/P = (287 x 293) / 101325 = 0.831 m³/kg. This tells you 1 kg of air occupies 831 litres. If you instead use density (rho = P/RT = 1.204 kg/m³), you get the same information but in a less convenient form for gas flow calculations.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/density-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Density Converter</a>
        <a href="/tools/volume-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Volume Converter</a>
        <a href="/tools/weight-mass-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Weight & Mass Converter</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Specific Volume Converter Handles M³/Kg and Ft³/Lb</h2>
    <p class="seo-p">
      All conversions pass through cubic meters per kilogram (m³/kg). When you enter 1.694 m³/kg (steam at 100°C), the tool divides by each target unit's factor: by 0.062428 for ft³/lb, by 0.001 for cm³/g, by 1,000 for L/kg. The result: 1.694 m³/kg = 27.14 ft³/lb = 1,694 cm³/g = 1,694 L/kg.
    </p>

    <h3 class="font-display seo-h3-sm">Why cm³/g, mL/g, and L/kg give the same number</h3>
    <p class="seo-p-sm">
      1 cm³/g = 1 mL/g (since 1 cm³ = 1 mL) = 1 L/kg (since 1 L = 1,000 cm³ and 1 kg = 1,000 g, the factors cancel). All three equal 0.001 m³/kg. This equivalence means you can read lab measurements in cm³/g and industrial specs in L/kg without conversion. The converter shows all three as identical values.
    </p>

    <h3 class="font-display seo-h3-sm">The imperial factor of 16.0185 in reverse</h3>
    <p class="seo-p-sm">
      For density, 1 lb/ft³ = 16.0185 kg/m³. For specific volume (the reciprocal), 1 ft³/lb = 1/16.0185 = 0.062428 m³/kg. This factor comes from 1 lb = 0.45359237 kg and 1 ft = 0.3048 m: 1 ft³/lb = (0.3048)^3 / 0.45359237 = 0.0283168 / 0.45359237 = 0.062428. The converter stores this factor directly.
    </p>
    <p class="seo-p-none">
      The dynamic formatting handles the full range from gases (air at 0.816 m³/kg) to dense metals (osmium at 0.0000443 m³/kg). Values below 10^-6 use scientific notation because they are too small for fixed decimal display. Values above 1,000 use locale-formatted numbers with commas for readability. This ensures you can read any value from any substance without losing precision.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How do I convert 0.816 m³/kg to ft³/lb?",
          a: "Divide by 0.062428: 0.816 / 0.062428 = 13.07 ft³/lb. This is the specific volume of air at sea level. For a quick estimate, multiply m³/kg by 16.02 to get ft³/lb (since 1/0.062428 = 16.02). The converter shows all units simultaneously so you can verify the relationship."
        },
        {
          q: "What is the specific volume of steam vs liquid water?",
          a: "At 100°C and 1 atm: steam v = 1.694 m³/kg, liquid water v = 0.001 m³/kg. The ratio is 1,694:1. This means 1 kg of steam occupies 1,694 times more volume than 1 kg of liquid water. This enormous difference is why steam engines work: boiling water creates a massive volume increase that drives pistons."
        },
        {
          q: "Why do steam tables list specific volume instead of density?",
          a: "Thermodynamic calculations use specific volume because it appears directly in the ideal gas law (Pv = RT) and in enthalpy/entropy calculations. When calculating steam flow through a pipe, you divide volume flow by specific volume to get mass flow. Using density would require an extra division step (mass flow = volume flow x density). Steam tables are designed for direct use."
        },
        {
          q: "How does pressure affect the specific volume of a gas?",
          a: "For an ideal gas, specific volume is inversely proportional to pressure (v = RT/P). Doubling the pressure halves the specific volume. Real gases deviate from this at high pressures. At 1 atm and 20°C, air v = 0.831 m³/kg. At 10 atm, v = 0.0831 m³/kg. At 100 atm, v = 0.0081 m³/kg (deviation from ideal behavior starts to matter)."
        },
        {
          q: "What is the specific volume of common materials?",
          a: "Air: 0.816 m³/kg. Water: 0.001 m³/kg. Aluminum: 0.00037 m³/kg. Iron: 0.000127 m³/kg. Gold: 0.0000518 m³/kg. Osmium: 0.0000443 m³/kg. The material reference section in the converter shows these values. Notice that metals have very small specific volumes because they are dense."
        },
        {
          q: "How do I use specific volume to size a compressor?",
          a: "A compressor must handle a specific volume flow rate (m³/s). Multiply the required mass flow rate (kg/s) by the specific volume at the compressor inlet. For R-134a at 0.029 m³/kg and 0.05 kg/s mass flow: volume flow = 0.05 x 0.029 = 0.00145 m³/s = 5.22 m³/hr. The compressor displacement must exceed this value."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to m³/kg ─────────────────────────────────
  const TO_M3KG = {
    m3kg:  1,
    cm3g:  0.001,
    mLg:   0.001,
    Lkg:   0.001,
    Lg:    1,
    ft3lb: 0.0624279606,
    in3lb: 0.0361272867,
    galb:  0.0083454045,
    igalb: 0.0100224129,
  };

  const UNITS = [
    { id: 'm3kg',  label: 'm³/kg',    name: 'Cubic Meter per kg' },
    { id: 'cm3g',  label: 'cm³/g',    name: 'Cubic cm per gram' },
    { id: 'mLg',   label: 'mL/g',     name: 'Milliliter per gram' },
    { id: 'Lkg',   label: 'L/kg',     name: 'Liter per kilogram' },
    { id: 'Lg',    label: 'L/g',      name: 'Liter per gram' },
    { id: 'ft3lb', label: 'ft³/lb',   name: 'Cubic foot per pound' },
    { id: 'in3lb', label: 'in³/lb',   name: 'Cubic inch per pound' },
    { id: 'galb',  label: 'gal/lb',   name: 'US Gallon per pound' },
    { id: 'igalb', label: 'igal/lb',  name: 'Imp Gallon per pound' },
  ];

  const REFS = [
    { name: 'Air (15°C)',      m3kg: 0.816 },
    { name: 'Styrofoam',        m3kg: 0.033 },
    { name: 'Oak Wood',         m3kg: 0.00133 },
    { name: 'Ice',              m3kg: 0.00109 },
    { name: 'Water (4°C)',      m3kg: 0.001 },
    { name: 'Seawater',         m3kg: 0.000976 },
    { name: 'Aluminum',         m3kg: 0.00037 },
    { name: 'Iron',             m3kg: 0.000127 },
    { name: 'Copper',           m3kg: 0.000112 },
    { name: 'Gold',             m3kg: 0.0000518 },
    { name: 'Lead',             m3kg: 0.0000882 },
    { name: 'Osmium',           m3kg: 0.0000443 },
  ];

  const input    = document.getElementById('sv-input') as HTMLInputElement;
  const select   = document.getElementById('sv-unit') as HTMLSelectElement;
  const grid     = document.getElementById('results')!;
  const refsDiv  = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 0.000001) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const m3kg     = val * TO_M3KG[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = m3kg / TO_M3KG[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refsDiv.innerHTML = '';
    REFS.forEach(r => {
      const value = r.m3kg / TO_M3KG[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refsDiv.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
