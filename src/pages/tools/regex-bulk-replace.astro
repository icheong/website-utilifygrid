---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'regex-bulk-replace')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">

    <!-- ── Header ── -->
    <div style="display:flex; align-items:center; gap:0.875rem; margin-bottom:1.5rem;">
      <div style="width:2.5rem; height:2.5rem; border-radius:0.625rem; background:#000; border:1px solid #22C55E; display:flex; align-items:center; justify-content:center; flex-shrink:0; box-shadow:0 0 16px rgba(34,197,94,0.3);">
        <span style="font-family:'Fira Code',monospace; font-size:0.95rem; font-weight:700; color:#22C55E;">/.*/</span>
      </div>
      <div>
        <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin:0 0 0.15rem;">Regex Bulk Find &amp; Replace</h2>
        <p style="font-size:0.76rem; color:var(--text-muted); margin:0;">Stack multiple rules — each match colour-coded in the live editor</p>
      </div>
    </div>

    <!-- ── Main layout: rules left, editor right ── -->
    <div style="display:grid; grid-template-columns:300px 1fr; gap:0.875rem; margin-bottom:1rem;" class="rbr-grid">

      <!-- ── LEFT: Rules panel ── -->
      <div style="display:flex; flex-direction:column; gap:0; min-width:0;">

        <!-- Rules header -->
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.5rem;">
          <span style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted);">Rules</span>
          <button id="btn-add-rule"
            style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.6rem; background:#052e16; border:1px solid #22C55E; border-radius:0.375rem; font-size:0.72rem; font-weight:700; color:#22C55E; cursor:pointer; font-family:'Fira Code',monospace; transition:all 0.15s;"
            onmouseover="this.style.background='#14532d';" onmouseout="this.style.background='#052e16';">
            + Add rule
          </button>
        </div>

        <!-- Rules list -->
        <div id="rules-list" style="display:flex; flex-direction:column; gap:0.5rem; max-height:380px; overflow-y:auto; padding-right:0.125rem;">
        </div>

        <!-- Quick presets -->
        <div style="margin-top:0.875rem;">
          <div style="font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted); margin-bottom:0.4rem;">Quick presets</div>
          <div style="display:flex; flex-direction:column; gap:0.3rem;" id="presets-list">
          </div>
        </div>

      </div>

      <!-- ── RIGHT: Editor panel ── -->
      <div style="display:flex; flex-direction:column; min-width:0;">

        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.5rem; flex-wrap:wrap; gap:0.5rem;">
          <div style="display:flex; align-items:center; gap:0.75rem;">
            <span style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted);">Editor</span>
            <!-- Mode toggle -->
            <div style="display:flex; gap:0; background:#000; border:1px solid #1a2a1a; border-radius:0.375rem; overflow:hidden;">
              <button id="mode-source" class="editor-mode-btn active-editor-mode"
                style="padding:0.2rem 0.6rem; border:none; font-size:0.68rem; font-weight:700; font-family:'Fira Code',monospace; cursor:pointer; transition:all 0.15s; background:#052e16; color:#22C55E;">source</button>
              <button id="mode-result" class="editor-mode-btn"
                style="padding:0.2rem 0.6rem; border:none; font-size:0.68rem; font-weight:700; font-family:'Fira Code',monospace; cursor:pointer; transition:all 0.15s; background:transparent; color:#4b5563;">result</button>
            </div>
          </div>
          <div style="display:flex; gap:0.5rem; align-items:center;">
            <span id="match-count" style="font-size:0.68rem; font-family:'Fira Code',monospace; color:#22C55E; font-weight:700;"></span>
            <button id="btn-load-sample" style="font-size:0.68rem; color:#22C55E; background:none; border:none; cursor:pointer; font-weight:700; padding:0; font-family:'Fira Code',monospace; transition:opacity 0.15s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">sample</button>
            <button id="btn-clear-editor" style="font-size:0.68rem; color:#4b5563; background:none; border:none; cursor:pointer; font-weight:700; padding:0; font-family:'Fira Code',monospace; transition:opacity 0.15s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">clear</button>
          </div>
        </div>

        <!-- Source textarea (for editing) -->
        <div style="position:relative; flex:1;">
          <textarea id="source-editor"
            placeholder="Paste your text here. Add regex rules on the left — matches light up as you type."
            style="width:100%; height:360px; box-sizing:border-box; resize:vertical; background:#0a0a0a; border:1px solid #1a2a1a; border-radius:0.625rem; padding:0.875rem; font-family:'Fira Code',monospace; font-size:0.78rem; color:#d1fae5; line-height:1.7; outline:none; transition:border-color 0.15s; display:block; caret-color:#22C55E;"
            onfocus="this.style.borderColor='#22C55E'; this.style.boxShadow='0 0 0 2px rgba(34,197,94,0.12)';"
            onblur="this.style.borderColor='#1a2a1a'; this.style.boxShadow='none';"
          ></textarea>
          <!-- Live highlight overlay -->
          <div id="highlight-overlay"
            aria-hidden="true"
            style="position:absolute; inset:0; pointer-events:none; padding:0.875rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.7; white-space:pre-wrap; word-break:break-all; overflow:hidden; border-radius:0.625rem; color:transparent; display:none;">
          </div>
        </div>

        <!-- Result panel (read-only) -->
        <div id="result-panel" style="display:none; flex-direction:column; gap:0.4rem;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted);">Output</span>
            <button id="btn-copy-result" style="font-size:0.68rem; color:#22C55E; background:none; border:none; cursor:pointer; font-weight:700; padding:0; font-family:'Fira Code',monospace; transition:opacity 0.15s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">copy</button>
          </div>
          <textarea id="result-output" readonly
            style="width:100%; height:360px; box-sizing:border-box; resize:vertical; background:#0a0a0a; border:1px solid #1a2a1a; border-radius:0.625rem; padding:0.875rem; font-family:'Fira Code',monospace; font-size:0.78rem; color:#d1fae5; line-height:1.7; outline:none; cursor:default; display:block;">
          </textarea>
        </div>

      </div>
    </div>

    <!-- ── Stats footer ── -->
    <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
      <div id="stats-box" style="display:flex; gap:0.875rem; padding:0.5rem 0.875rem; background:#0a0a0a; border:1px solid #1a2a1a; border-radius:0.5rem; font-family:'Fira Code',monospace; font-size:0.7rem; flex-wrap:wrap;">
        <span>chars: <span id="s-chars" style="color:#22C55E;">0</span></span>
        <span>lines: <span id="s-lines" style="color:#22C55E;">0</span></span>
        <span>rules: <span id="s-rules" style="color:#22C55E;">0</span></span>
        <span>total matches: <span id="s-matches" style="color:#F59E0B;">0</span></span>
        <span>replacements: <span id="s-replacements" style="color:#22C55E;">0</span></span>
      </div>
    </div>

  </div>

  <!-- ══════════════════════════════════════════════
       HOW TO USE
  ══════════════════════════════════════════════ -->
  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use Regex Bulk Find &amp; Replace</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Paste your text into the editor, then add one or more regex rules using the <strong>+ Add rule</strong> button. Each rule has a <em>pattern</em> field (the regex to match) and a <em>replacement</em> field. Matches are highlighted live in the editor — each rule gets its own colour so you can see overlapping patterns simultaneously.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Toggle <strong>result</strong> mode to see the fully-replaced output text. Rules are applied in order from top to bottom — drag to reorder using the handle on the left of each rule card. Use the <strong>flags</strong> field to add regex modifiers: <code style="font-family:'Fira Code',monospace; font-size:0.85em;">g</code> (global), <code style="font-family:'Fira Code',monospace; font-size:0.85em;">i</code> (case-insensitive), <code style="font-family:'Fira Code',monospace; font-size:0.85em;">m</code> (multiline).
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      Quick presets load common patterns — stripping HTML tags, normalising whitespace, removing punctuation, and more. Each preset loads into a new rule card which you can further customise.
    </p>
  </div>

  <!-- ══════════════════════════════════════════════
       HOW IT WORKS
  ══════════════════════════════════════════════ -->
  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How the regex engine works</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;">
      {[
        ['JavaScript RegExp Engine', 'Rules use the browser\'s built-in RegExp engine — the same one that powers all JavaScript regex operations. It supports full PCRE-like syntax: lookaheads (?=...), lookbehinds (?<=...), named capture groups (?<name>...), non-greedy quantifiers, Unicode property escapes (\\p{L}), and all standard character classes.'],
        ['Colour-coded Live Highlights', 'Each rule is assigned a unique highlight colour (green, amber, cyan, violet, orange, pink, …). After every keystroke, all active rules are tested against the source text using matchAll() with the global flag. Each match span is tagged with its rule\'s colour and rendered as a transparent highlight layer over the editor using a positioned overlay div.'],
        ['Ordered Pipeline Execution', 'When computing the result output, rules are applied sequentially — the output of rule N becomes the input of rule N+1. This lets you chain transformations: first strip HTML tags, then normalise whitespace, then title-case the result. Rule order matters and is user-configurable.'],
        ['Capture Group Substitution', 'Replacements support back-references to capture groups using $1, $2, … or named groups $<name>. For example, a pattern of (\\w+)\\s+(\\w+) with replacement $2 $1 swaps the first two words. The special strings $& (whole match), $` (pre-match), and $\' (post-match) are also supported.'],
        ['Error Handling', 'Invalid regex patterns are caught in a try/catch on every keystroke. The affected rule card shows a red error indicator with the exception message — the rule is skipped in both highlighting and replacement until the pattern is valid again.'],
      ].map(([label, desc]) => (
        <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:0.625rem; padding:0.875rem 1rem;">
          <div style="font-size:0.82rem; font-weight:700; color:var(--text-primary); margin-bottom:0.3rem;">{label}</div>
          <p style="font-size:0.82rem; color:var(--text-secondary); line-height:1.6; margin:0;">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════════ -->
  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What regex flags are supported?', a: 'The flags field accepts any combination of: g (global — match all occurrences, not just the first), i (case-insensitive), m (multiline — ^ and $ match line boundaries), s (dotAll — . matches newlines), and u (Unicode mode, required for \\p{} Unicode property escapes). The d flag (match indices) is supported in modern browsers but has no visible effect in this tool.' },
        { q: 'Can I use lookaheads and lookbehinds?', a: 'Yes. Positive lookahead (?=...), negative lookahead (?!...), positive lookbehind (?<=...), and negative lookbehind (?<!...) are all supported in the V8 engine used by modern Chromium-based and Firefox browsers. Lookbehinds require the u flag in some older browsers.' },
        { q: 'What does $1, $2 mean in the replacement field?', a: '$1, $2, etc. refer to the text captured by the first, second capture group (parentheses) in your pattern. $& is the entire match. $` is the text before the match, $\' is the text after. Named groups use $<name> syntax. These follow the standard String.prototype.replace() substitution patterns.' },
        { q: 'Can rules conflict with each other?', a: 'Yes — and that is often intentional. Rules run in order, so the output of one rule feeds the next. If two rules would match the same text, the first rule wins on the source text; the second rule then sees the already-replaced output. Use the drag handles to reorder rules to control execution priority.' },
        { q: 'Is there a limit on how many rules I can add?', a: 'No hard limit. Practically, performance may degrade slightly above ~20 rules on very large texts, because each rule runs matchAll() on every keystroke. For most use cases (under 10 rules on texts under 100KB) the highlighting stays instantaneous.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<style>
  @media (max-width: 780px) {
    .rbr-grid { grid-template-columns: 1fr !important; }
  }
</style>

<script>
  // ── Colour palette for rules ──────────────────────────────
  const RULE_COLORS = [
    { bg: 'rgba(34,197,94,0.28)',   border: '#22C55E', label: '#22C55E',   name: 'green'  },
    { bg: 'rgba(245,158,11,0.28)',  border: '#F59E0B', label: '#F59E0B',   name: 'amber'  },
    { bg: 'rgba(6,182,212,0.28)',   border: '#06B6D4', label: '#06B6D4',   name: 'cyan'   },
    { bg: 'rgba(167,139,250,0.28)', border: '#A78BFA', label: '#A78BFA',   name: 'violet' },
    { bg: 'rgba(249,115,22,0.28)',  border: '#F97316', label: '#F97316',   name: 'orange' },
    { bg: 'rgba(244,63,94,0.28)',   border: '#F43F5E', label: '#F43F5E',   name: 'rose'   },
    { bg: 'rgba(234,179,8,0.28)',   border: '#EAB308', label: '#EAB308',   name: 'yellow' },
    { bg: 'rgba(14,165,233,0.28)',  border: '#0EA5E9', label: '#0EA5E9',   name: 'sky'    },
  ];

  // ── Presets ───────────────────────────────────────────────
  const PRESETS = [
    { name: 'Strip HTML tags',     pattern: '<[^>]+>',           replacement: '',    flags: 'g'  },
    { name: 'Collapse whitespace', pattern: '\\s{2,}',           replacement: ' ',   flags: 'g'  },
    { name: 'Remove punctuation',  pattern: '[^\\w\\s]',         replacement: '',    flags: 'g'  },
    { name: 'Trim line ends',      pattern: '[ \\t]+$',          replacement: '',    flags: 'gm' },
    { name: 'URL → [link]',        pattern: 'https?://\\S+',     replacement: '[link]', flags: 'g' },
    { name: 'Double quotes → single', pattern: '"([^"]*)"',      replacement: "'$1'", flags: 'g' },
  ];

  // ── State ─────────────────────────────────────────────────
  type Rule = { id: number; pattern: string; replacement: string; flags: string; enabled: boolean; colorIdx: number };
  let rules: Rule[] = [];
  let nextId = 1;
  let editorMode: 'source' | 'result' = 'source';

  // ── DOM refs ──────────────────────────────────────────────
  const rulesList       = document.getElementById('rules-list')!;
  const presetsList     = document.getElementById('presets-list')!;
  const sourceEditor    = document.getElementById('source-editor') as HTMLTextAreaElement;
  const highlightOvl    = document.getElementById('highlight-overlay')!;
  const resultPanel     = document.getElementById('result-panel')!;
  const resultOutput    = document.getElementById('result-output') as HTMLTextAreaElement;
  const matchCount      = document.getElementById('match-count')!;
  const sChars          = document.getElementById('s-chars')!;
  const sLines          = document.getElementById('s-lines')!;
  const sRules          = document.getElementById('s-rules')!;
  const sMatches        = document.getElementById('s-matches')!;
  const sReplacements   = document.getElementById('s-replacements')!;

  // ── Add / remove rules ────────────────────────────────────
  function addRule(pattern = '', replacement = '', flags = 'g') {
    const colorIdx = rules.length % RULE_COLORS.length;
    const rule: Rule = { id: nextId++, pattern, replacement, flags, enabled: true, colorIdx };
    rules.push(rule);
    renderRuleCard(rule);
    update();
  }

  function removeRule(id: number) {
    rules = rules.filter(r => r.id !== id);
    document.getElementById(`rule-card-${id}`)?.remove();
    update();
  }

  function renderRuleCard(rule: Rule) {
    const col = RULE_COLORS[rule.colorIdx];
    const card = document.createElement('div');
    card.id = `rule-card-${rule.id}`;
    card.style.cssText = `
      background:#0a0a0a; border:1px solid ${col.border}44;
      border-left:3px solid ${col.border};
      border-radius:0.5rem; padding:0.625rem 0.75rem;
      display:flex; flex-direction:column; gap:0.4rem;
      transition:opacity 0.15s;
    `;
    card.innerHTML = `
      <div style="display:flex; align-items:center; gap:0.4rem; margin-bottom:0.1rem;">
        <span style="width:8px; height:8px; border-radius:50%; background:${col.label}; flex-shrink:0;"></span>
        <span style="font-family:'Fira Code',monospace; font-size:0.65rem; font-weight:700; color:${col.label}; text-transform:uppercase; letter-spacing:0.06em; flex:1;">Rule ${rule.id}</span>
        <label style="display:flex; align-items:center; gap:0.3rem; cursor:pointer;">
          <input type="checkbox" ${rule.enabled ? 'checked' : ''} data-id="${rule.id}" class="rule-toggle"
            style="width:0.75rem; height:0.75rem; accent-color:${col.label}; cursor:pointer;" />
          <span style="font-size:0.62rem; color:#4b5563; font-family:'Fira Code',monospace;">on</span>
        </label>
        <button data-id="${rule.id}" class="rule-delete"
          style="background:none; border:none; color:#374151; cursor:pointer; font-size:0.75rem; padding:0; line-height:1; transition:color 0.15s;"
          onmouseover="this.style.color='#EF4444';" onmouseout="this.style.color='#374151';">✕</button>
      </div>
      <div style="display:flex; align-items:center; gap:0.3rem;">
        <span style="font-family:'Fira Code',monospace; font-size:0.72rem; color:#4b5563; flex-shrink:0;">/</span>
        <input type="text" placeholder="pattern" value="${escAttr(rule.pattern)}" data-id="${rule.id}" class="rule-pattern"
          style="flex:1; background:#111; border:1px solid #1f2f1f; border-radius:0.3rem; padding:0.3rem 0.5rem; font-family:'Fira Code',monospace; font-size:0.75rem; color:#d1fae5; outline:none; min-width:0; transition:border-color 0.15s;"
          onfocus="this.style.borderColor='${col.label}';" onblur="this.style.borderColor='#1f2f1f';" />
        <span style="font-family:'Fira Code',monospace; font-size:0.72rem; color:#4b5563; flex-shrink:0;">/</span>
        <input type="text" placeholder="flags" value="${rule.flags}" data-id="${rule.id}" class="rule-flags" maxlength="6"
          style="width:3.5rem; background:#111; border:1px solid #1f2f1f; border-radius:0.3rem; padding:0.3rem 0.4rem; font-family:'Fira Code',monospace; font-size:0.75rem; color:#9ca3af; outline:none; transition:border-color 0.15s;"
          onfocus="this.style.borderColor='${col.label}';" onblur="this.style.borderColor='#1f2f1f';" />
      </div>
      <div style="display:flex; align-items:center; gap:0.3rem;">
        <span style="font-family:'Fira Code',monospace; font-size:0.72rem; color:#4b5563; flex-shrink:0; min-width:0.75rem;">→</span>
        <input type="text" placeholder="replacement (use $1, $2 for groups)" value="${escAttr(rule.replacement)}" data-id="${rule.id}" class="rule-replacement"
          style="flex:1; background:#111; border:1px solid #1f2f1f; border-radius:0.3rem; padding:0.3rem 0.5rem; font-family:'Fira Code',monospace; font-size:0.75rem; color:#fde68a; outline:none; min-width:0; transition:border-color 0.15s;"
          onfocus="this.style.borderColor='${col.label}';" onblur="this.style.borderColor='#1f2f1f';" />
      </div>
      <div id="rule-error-${rule.id}" style="display:none; font-size:0.65rem; color:#EF4444; font-family:'Fira Code',monospace; margin-top:0.1rem;"></div>
    `;
    rulesList.appendChild(card);

    // Events
    card.querySelector<HTMLInputElement>('.rule-pattern')!.addEventListener('input', e => {
      const r = rules.find(r => r.id === rule.id);
      if (r) r.pattern = (e.target as HTMLInputElement).value;
      update();
    });
    card.querySelector<HTMLInputElement>('.rule-replacement')!.addEventListener('input', e => {
      const r = rules.find(r => r.id === rule.id);
      if (r) r.replacement = (e.target as HTMLInputElement).value;
      update();
    });
    card.querySelector<HTMLInputElement>('.rule-flags')!.addEventListener('input', e => {
      const r = rules.find(r => r.id === rule.id);
      if (r) r.flags = (e.target as HTMLInputElement).value;
      update();
    });
    card.querySelector<HTMLInputElement>('.rule-toggle')!.addEventListener('change', e => {
      const r = rules.find(r => r.id === rule.id);
      if (r) r.enabled = (e.target as HTMLInputElement).checked;
      update();
    });
    card.querySelector<HTMLButtonElement>('.rule-delete')!.addEventListener('click', () => removeRule(rule.id));
  }

  // ── Build presets list ────────────────────────────────────
  PRESETS.forEach(p => {
    const btn = document.createElement('button');
    btn.style.cssText = `
      text-align:left; padding:0.3rem 0.6rem; background:#0a0a0a;
      border:1px solid #1a2a1a; border-radius:0.35rem; cursor:pointer;
      font-family:'Fira Code',monospace; font-size:0.68rem; color:#6b7280;
      transition:all 0.15s; display:flex; align-items:center; gap:0.4rem;
    `;
    btn.innerHTML = `<span style="color:#22C55E; opacity:0.7;">+</span> ${p.name}`;
    btn.addEventListener('click', () => addRule(p.pattern, p.replacement, p.flags));
    btn.addEventListener('mouseover', () => { btn.style.borderColor = '#22C55E44'; btn.style.color = '#d1fae5'; });
    btn.addEventListener('mouseout',  () => { btn.style.borderColor = '#1a2a1a';   btn.style.color = '#6b7280'; });
    presetsList.appendChild(btn);
  });

  // ── Core update ───────────────────────────────────────────
  function escAttr(s: string) {
    return s.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }
  function escHtml(s: string) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function update() {
    const text = sourceEditor.value;
    sChars.textContent    = String(text.length);
    sLines.textContent    = String(text ? text.split('\n').length : 0);
    const activeRules     = rules.filter(r => r.enabled && r.pattern.trim());
    sRules.textContent    = String(activeRules.length);

    let totalMatches = 0;
    let totalReplacements = 0;

    // ── Highlight ──────────────────────────────────────────
    // Build a list of all match spans with their rule color
    type Span = { start: number; end: number; bg: string };
    const spans: Span[] = [];

    activeRules.forEach(rule => {
      const errEl = document.getElementById(`rule-error-${rule.id}`)!;
      try {
        const flags = rule.flags.includes('g') ? rule.flags : rule.flags + 'g';
        const rx = new RegExp(rule.pattern, flags);
        const col = RULE_COLORS[rule.colorIdx];
        let m: RegExpExecArray | null;
        let count = 0;
        while ((m = rx.exec(text)) !== null) {
          spans.push({ start: m.index, end: m.index + m[0].length, bg: col.bg });
          count++;
          if (m[0].length === 0) rx.lastIndex++;
        }
        totalMatches += count;
        errEl.style.display = 'none';
        // Card border: no error
        const card = document.getElementById(`rule-card-${rule.id}`)!;
        if (card) card.style.opacity = '1';
      } catch (err: any) {
        errEl.textContent = `⚠ ${err.message}`;
        errEl.style.display = 'block';
        const card = document.getElementById(`rule-card-${rule.id}`)!;
        if (card) card.style.opacity = '0.5';
      }
    });

    sMatches.textContent = String(totalMatches);
    matchCount.textContent = totalMatches > 0 ? `${totalMatches} match${totalMatches !== 1 ? 'es' : ''}` : '';

    // Build highlighted HTML
    if (spans.length > 0) {
      // Sort spans by start position
      spans.sort((a, b) => a.start - b.start);
      let html = '';
      let cursor = 0;
      for (const span of spans) {
        if (span.start < cursor) continue; // skip overlapping
        html += escHtml(text.slice(cursor, span.start));
        html += `<mark style="background:${span.bg}; color:inherit; border-radius:2px;">${escHtml(text.slice(span.start, span.end))}</mark>`;
        cursor = span.end;
      }
      html += escHtml(text.slice(cursor));
      highlightOvl.innerHTML = html;
      highlightOvl.style.display = 'block';
    } else {
      highlightOvl.style.display = 'none';
    }

    // ── Result computation ────────────────────────────────
    if (editorMode === 'result') {
      let result = text;
      activeRules.forEach(rule => {
        try {
          const flags = rule.flags.includes('g') ? rule.flags : rule.flags + 'g';
          const rx = new RegExp(rule.pattern, flags);
          const before = result;
          result = result.replace(rx, rule.replacement);
          // Count replacements crudely
          if (result !== before) totalReplacements++;
        } catch {}
      });
      resultOutput.value = result;
      sReplacements.textContent = String(totalReplacements);
    } else {
      sReplacements.textContent = '—';
    }
  }

  // ── Editor mode toggle ────────────────────────────────────
  function setEditorMode(m: typeof editorMode) {
    editorMode = m;
    document.querySelectorAll<HTMLButtonElement>('.editor-mode-btn').forEach(btn => {
      const isActive = btn.id === `mode-${m}`;
      btn.style.background = isActive ? '#052e16' : 'transparent';
      btn.style.color      = isActive ? '#22C55E'  : '#4b5563';
    });
    const editorWrap = sourceEditor.parentElement!;
    if (m === 'source') {
      editorWrap.style.display = 'block';
      resultPanel.style.display = 'none';
    } else {
      editorWrap.style.display = 'none';
      resultPanel.style.display = 'flex';
    }
    update();
  }

  document.getElementById('mode-source')!.addEventListener('click', () => setEditorMode('source'));
  document.getElementById('mode-result')!.addEventListener('click', () => setEditorMode('result'));

  // ── Wire up ───────────────────────────────────────────────
  document.getElementById('btn-add-rule')!.addEventListener('click', () => addRule());

  sourceEditor.addEventListener('input', update);

  document.getElementById('btn-load-sample')!.addEventListener('click', () => {
    sourceEditor.value = `Hello World! This is a <b>sample</b> text file.
It contains  double   spaces and <em>HTML tags</em>.
Visit https://example.com for more info.
"Quoted text" appears multiple times here.
Another line with  extra   whitespace.`;
    addRule('<[^>]+>', '', 'g');
    addRule('\\s{2,}', ' ', 'g');
    update();
  });

  document.getElementById('btn-clear-editor')!.addEventListener('click', () => {
    sourceEditor.value = '';
    highlightOvl.style.display = 'none';
    update();
  });

  document.getElementById('btn-copy-result')!.addEventListener('click', () => {
    if (!resultOutput.value) return;
    navigator.clipboard.writeText(resultOutput.value).then(() => {
      const btn = document.getElementById('btn-copy-result')!;
      btn.textContent = '✓ copied';
      setTimeout(() => { btn.textContent = 'copy'; }, 2000);
    });
  });

  // Sync overlay scroll with textarea
  sourceEditor.addEventListener('scroll', () => {
    highlightOvl.scrollTop  = sourceEditor.scrollTop;
    highlightOvl.scrollLeft = sourceEditor.scrollLeft;
  });

  // Init with one blank rule
  addRule();
</script>
