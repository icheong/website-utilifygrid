---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'crontab-expression-visualizer')!;
---

<ToolLayout tool={tool}>

  <!-- ═══ THE TOOL ═══ -->
  <div slot="tool">

    <!-- Live cron expression display + copy -->
    <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.5rem; flex-wrap:wrap;">
      <code id="cron-display"
        style="flex:1; min-width:0; font-family:'Fira Code',monospace; font-size:1.3rem; font-weight:700; color:var(--text-primary); background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.75rem 1.1rem; letter-spacing:0.06em; white-space:nowrap; overflow-x:auto;">
        * * * * *
      </code>
      <button id="copy-btn"
        style="flex-shrink:0; padding:0.65rem 1.25rem; background:#1D4ED8; color:#fff; border:none; border-radius:0.625rem; font-size:0.875rem; font-weight:600; cursor:pointer; transition:background 0.15s; white-space:nowrap;"
        onmouseover="this.style.background='#1E3A8A';" onmouseout="this.style.background='#1D4ED8';">
        Copy
      </button>
      <button id="reset-btn"
        style="flex-shrink:0; padding:0.65rem 1rem; background:var(--bg-surface-2); color:var(--text-secondary); border:1.5px solid var(--border); border-radius:0.625rem; font-size:0.875rem; font-weight:500; cursor:pointer; transition:all 0.15s; white-space:nowrap;"
        onmouseover="this.style.borderColor='#1D4ED8';this.style.color='#1D4ED8';"
        onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-secondary)';">
        Reset
      </button>
    </div>

    <!-- Human-readable description -->
    <div id="human-desc"
      style="background:linear-gradient(135deg,#EFF6FF,#F0FDF4); border:1.5px solid #BFDBFE; border-radius:0.875rem; padding:1rem 1.25rem; margin-bottom:1.75rem; font-size:0.9rem; color:#1E3A8A; font-weight:500; line-height:1.6; min-height:48px;">
      Runs every minute.
    </div>

    <!-- ── FIELD CONTROLS ── -->
    <div style="display:flex; flex-direction:column; gap:1.25rem;">

      <!-- Minutes -->
      <div class="field-block">
        <div class="field-header">
          <span class="field-name" style="color:#7C3AED;">Minutes</span>
          <span class="field-pos">0–59</span>
          <div class="preset-row" id="preset-minute"></div>
        </div>
        <div class="field-body">
          <div class="mode-row">
            <button class="fmode active" data-field="minute" data-mode="every">Every minute</button>
            <button class="fmode" data-field="minute" data-mode="specific">Specific</button>
            <button class="fmode" data-field="minute" data-mode="range">Range</button>
            <button class="fmode" data-field="minute" data-mode="every-n">Every N</button>
          </div>
          <!-- every: no controls -->
          <div class="mode-pane" id="minute-pane-every"></div>
          <!-- specific: single-value slider -->
          <div class="mode-pane" id="minute-pane-specific" style="display:none;">
            <div class="range-row">
              <label class="range-label">Minute</label>
              <input type="range" class="cron-range" id="minute-specific" min="0" max="59" value="0" />
              <span class="range-val" id="minute-specific-val">0</span>
            </div>
          </div>
          <!-- range: from / to sliders -->
          <div class="mode-pane" id="minute-pane-range" style="display:none;">
            <div class="range-row">
              <label class="range-label">From</label>
              <input type="range" class="cron-range" id="minute-from" min="0" max="58" value="0" />
              <span class="range-val" id="minute-from-val">0</span>
              <label class="range-label" style="margin-left:1rem;">To</label>
              <input type="range" class="cron-range" id="minute-to" min="1" max="59" value="30" />
              <span class="range-val" id="minute-to-val">30</span>
            </div>
          </div>
          <!-- every-n -->
          <div class="mode-pane" id="minute-pane-every-n" style="display:none;">
            <div class="range-row">
              <label class="range-label">Every</label>
              <input type="range" class="cron-range" id="minute-n" min="2" max="30" value="5" />
              <span class="range-val" id="minute-n-val">5</span>
              <label class="range-label" style="margin-left:0.5rem;">minutes</label>
            </div>
          </div>
        </div>
      </div>

      <!-- Hours -->
      <div class="field-block">
        <div class="field-header">
          <span class="field-name" style="color:#1D4ED8;">Hours</span>
          <span class="field-pos">0–23</span>
          <div class="preset-row" id="preset-hour"></div>
        </div>
        <div class="field-body">
          <div class="mode-row">
            <button class="fmode active" data-field="hour" data-mode="every">Every hour</button>
            <button class="fmode" data-field="hour" data-mode="specific">Specific</button>
            <button class="fmode" data-field="hour" data-mode="range">Range</button>
            <button class="fmode" data-field="hour" data-mode="every-n">Every N</button>
          </div>
          <div class="mode-pane" id="hour-pane-every"></div>
          <div class="mode-pane" id="hour-pane-specific" style="display:none;">
            <div class="range-row">
              <label class="range-label">Hour</label>
              <input type="range" class="cron-range" id="hour-specific" min="0" max="23" value="9" />
              <span class="range-val" id="hour-specific-val">9</span>
            </div>
          </div>
          <div class="mode-pane" id="hour-pane-range" style="display:none;">
            <div class="range-row">
              <label class="range-label">From</label>
              <input type="range" class="cron-range" id="hour-from" min="0" max="22" value="9" />
              <span class="range-val" id="hour-from-val">9</span>
              <label class="range-label" style="margin-left:1rem;">To</label>
              <input type="range" class="cron-range" id="hour-to" min="1" max="23" value="17" />
              <span class="range-val" id="hour-to-val">17</span>
            </div>
          </div>
          <div class="mode-pane" id="hour-pane-every-n" style="display:none;">
            <div class="range-row">
              <label class="range-label">Every</label>
              <input type="range" class="cron-range" id="hour-n" min="2" max="12" value="2" />
              <span class="range-val" id="hour-n-val">2</span>
              <label class="range-label" style="margin-left:0.5rem;">hours</label>
            </div>
          </div>
        </div>
      </div>

      <!-- Day of Month -->
      <div class="field-block">
        <div class="field-header">
          <span class="field-name" style="color:#0D9488;">Day of Month</span>
          <span class="field-pos">1–31</span>
        </div>
        <div class="field-body">
          <div class="mode-row">
            <button class="fmode active" data-field="dom" data-mode="every">Every day</button>
            <button class="fmode" data-field="dom" data-mode="specific">Specific</button>
            <button class="fmode" data-field="dom" data-mode="range">Range</button>
          </div>
          <div class="mode-pane" id="dom-pane-every"></div>
          <div class="mode-pane" id="dom-pane-specific" style="display:none;">
            <div class="range-row">
              <label class="range-label">Day</label>
              <input type="range" class="cron-range" id="dom-specific" min="1" max="31" value="1" />
              <span class="range-val" id="dom-specific-val">1</span>
            </div>
          </div>
          <div class="mode-pane" id="dom-pane-range" style="display:none;">
            <div class="range-row">
              <label class="range-label">From</label>
              <input type="range" class="cron-range" id="dom-from" min="1" max="30" value="1" />
              <span class="range-val" id="dom-from-val">1</span>
              <label class="range-label" style="margin-left:1rem;">To</label>
              <input type="range" class="cron-range" id="dom-to" min="2" max="31" value="15" />
              <span class="range-val" id="dom-to-val">15</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Month -->
      <div class="field-block">
        <div class="field-header">
          <span class="field-name" style="color:#EA580C;">Month</span>
          <span class="field-pos">1–12</span>
        </div>
        <div class="field-body">
          <div class="mode-row">
            <button class="fmode active" data-field="month" data-mode="every">Every month</button>
            <button class="fmode" data-field="month" data-mode="specific">Specific</button>
            <button class="fmode" data-field="month" data-mode="range">Range</button>
          </div>
          <div class="mode-pane" id="month-pane-every"></div>
          <div class="mode-pane" id="month-pane-specific" style="display:none;">
            <div class="range-row">
              <label class="range-label">Month</label>
              <input type="range" class="cron-range" id="month-specific" min="1" max="12" value="1" />
              <span class="range-val" id="month-specific-val">Jan</span>
            </div>
          </div>
          <div class="mode-pane" id="month-pane-range" style="display:none;">
            <div class="range-row">
              <label class="range-label">From</label>
              <select class="cron-select" id="month-from">
                <option value="1">Jan</option><option value="2">Feb</option>
                <option value="3">Mar</option><option value="4">Apr</option>
                <option value="5">May</option><option value="6">Jun</option>
                <option value="7">Jul</option><option value="8">Aug</option>
                <option value="9">Sep</option><option value="10">Oct</option>
                <option value="11">Nov</option>
              </select>
              <label class="range-label" style="margin-left:1rem;">To</label>
              <select class="cron-select" id="month-to">
                <option value="2">Feb</option><option value="3">Mar</option>
                <option value="4">Apr</option><option value="5">May</option>
                <option value="6">Jun</option><option value="7">Jul</option>
                <option value="8">Aug</option><option value="9">Sep</option>
                <option value="10">Oct</option><option value="11">Nov</option>
                <option value="12" selected>Dec</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- Day of Week -->
      <div class="field-block">
        <div class="field-header">
          <span class="field-name" style="color:#DC2626;">Day of Week</span>
          <span class="field-pos">0=Sun … 6=Sat</span>
        </div>
        <div class="field-body">
          <div class="mode-row">
            <button class="fmode active" data-field="dow" data-mode="every">Every day</button>
            <button class="fmode" data-field="dow" data-mode="specific">Specific</button>
            <button class="fmode" data-field="dow" data-mode="range">Range</button>
          </div>
          <div class="mode-pane" id="dow-pane-every"></div>
          <div class="mode-pane" id="dow-pane-specific" style="display:none;">
            <div class="range-row">
              <label class="range-label">Day</label>
              <input type="range" class="cron-range" id="dow-specific" min="0" max="6" value="1" />
              <span class="range-val" id="dow-specific-val">Mon</span>
            </div>
          </div>
          <div class="mode-pane" id="dow-pane-range" style="display:none;">
            <div class="range-row">
              <label class="range-label">From</label>
              <select class="cron-select" id="dow-from">
                <option value="0">Sun</option><option value="1">Mon</option>
                <option value="2">Tue</option><option value="3">Wed</option>
                <option value="4">Thu</option><option value="5">Fri</option>
              </select>
              <label class="range-label" style="margin-left:1rem;">To</label>
              <select class="cron-select" id="dow-to">
                <option value="1">Mon</option><option value="2">Tue</option>
                <option value="3">Wed</option><option value="4">Thu</option>
                <option value="5">Fri</option><option value="6" selected>Sat</option>
              </select>
            </div>
          </div>
        </div>
      </div>

    </div><!-- /fields -->

    <!-- ── QUICK TEMPLATES ── -->
    <div style="margin-top:1.75rem; padding-top:1.5rem; border-top:1px solid var(--border);">
      <div style="font-size:0.72rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.07em; margin-bottom:0.75rem;">Common schedules</div>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem;" id="templates-row"></div>
    </div>

    <!-- ── NEXT RUNS PREVIEW ── -->
    <div style="margin-top:1.5rem;">
      <div style="font-size:0.72rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.07em; margin-bottom:0.5rem;">Next 5 scheduled runs</div>
      <div id="next-runs"
        style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.82rem; color:var(--text-secondary); line-height:2;">
        —
      </div>
    </div>

  </div><!-- /tool -->


  <!-- ═══ HOW TO USE ═══ -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >Crontab Expression Visualizer — Build, Preview & Copy Cron Schedules</h2>
    <p class="seo-p" >The <strong style="color:var(--text-primary)">Crontab Expression Visualizer</strong> is a free, browser-based scheduler builder that lets you construct, preview, and copy cron expressions without memorising syntax. Use the five field sections — <strong style="color:var(--text-primary)">Minutes, Hours, Day of Month, Month,</strong> and <strong style="color:var(--text-primary)">Day of Week</strong> — to build your schedule. Each field offers four modes: <em>every</em> (wildcard), <em>specific</em> (single value slider), <em>range</em> (from–to), or <em>every N</em> (step). The live cron expression at the top updates instantly, and a plain-English banner translates your settings so you can verify the intent before copying. Click <strong style="color:var(--text-primary)">Copy</strong> to grab the expression, pick one of the <strong style="color:var(--text-primary)">Common schedules</strong> buttons (Every weekday at 9am, Daily midnight, etc.), or check the <strong style="color:var(--text-primary)">Next 5 scheduled runs</strong> panel to see the real upcoming trigger dates. Everything runs locally — no server, no data sent.</p>
  </div>

  <!-- ═══ HOW IT WORKS ═══ -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >Deep-Dive: Cron Expression Format & Scheduling Logic</h2>

    <h3 class="font-display" style="font-size:1rem; font-weight:600; margin-bottom:0.5rem">The Five-Field Standard</h3>
    <p class="seo-p" >A standard cron expression consists of five space-separated fields — Minute (0–59), Hour (0–23), Day of Month (1–31), Month (1–12), and Day of Week (0–6, Sun=0) — evaluated left-to-right by the cron daemon. The scheduler fires a job only when the current time satisfies all five fields simultaneously. Each field supports four operators: <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">*</code> (any value), <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">,</code> (list: 1,3,5), <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">-</code> (range: 9-17), and <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">/</code> (step: */5 or 0/15). When both day-of-month and day-of-week are non-wildcard, most implementations use OR logic — the job runs if either condition matches.</p>

    <h3 class="font-display" style="font-size:1rem; font-weight:600; margin-bottom:0.5rem">Step-by-Step Expression Builder</h3>
    <p class="seo-p" >This tool provides a visual mode selector for each field. Choosing "Every" emits <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">*</code>"Specific" outputs a single numeric token"Range" produces <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">from-to</code>; and "Every N" emits <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">*/N</code>. The five tokens are concatenated with spaces to form a valid expression. The human-readable description is built by mapping each field's mode to a natural-language phrase ("at 9:00am", "every 15 minutes", "on weekdays"). The copy button writes the expression to the system clipboard via the <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">navigator.clipboard</code> API.</p>

    <h3 class="font-display" style="font-size:1rem; font-weight:600; margin-bottom:0.5rem">Next-Runs Preview Algorithm</h3>
    <p class="seo-p-none" >The preview engine starts at the current time plus one minute and iterates forward minute-by-minute (up to 200,000 iterations), testing each candidate against the five tokens. Each token is parsed independently: <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">*</code> always matches; <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">*/N</code> checks <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">value % N === 0</code>; ranges check <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">value >= a &amp;&amp; value <= b</code>; lists split on comma and test inclusion. The day-of-month / day-of-week OR logic is applied in the match function. The first five matching timestamps are returned and formatted with <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">toLocaleString()</code> for locale-aware display. All computation runs in the browser with zero network requests.</p>

    <div style="overflow-x:auto; margin:1rem 0">
      <table style="width:100%; border-collapse:collapse; font-size:0.84rem">
        <thead>
          <tr style="background:var(--bg-surface-2)">
            <th style="padding:0.5rem 0.875rem; text-align:left; font-weight:700; color:var(--text-secondary); border:1px solid var(--border)">Field</th>
            <th style="padding:0.5rem 0.875rem; text-align:left; font-weight:700; color:var(--text-secondary); border:1px solid var(--border)">Position</th>
            <th style="padding:0.5rem 0.875rem; text-align:left; font-weight:700; color:var(--text-secondary); border:1px solid var(--border)">Range</th>
            <th style="padding:0.5rem 0.875rem; text-align:left; font-weight:700; color:var(--text-secondary); border:1px solid var(--border)">Special values</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['Minute',       '1st', '0–59', '* , - /'],
            ['Hour',         '2nd', '0–23', '* , - /'],
            ['Day of month', '3rd', '1–31', '* , - /'],
            ['Month',        '4th', '1–12', '* , - /'],
            ['Day of week',  '5th', '0–6 (Sun–Sat)', '* , - /'],
          ].map(([f, pos, range, sp]) => (
            <tr>
              <td style="padding:0.45rem 0.875rem; border:1px solid var(--border); color:var(--text-primary); font-weight:600">{f}</td>
              <td style="padding:0.45rem 0.875rem; border:1px solid var(--border); color:var(--text-muted); font-family:'Fira Code',monospace">{pos}</td>
              <td style="padding:0.45rem 0.875rem; border:1px solid var(--border); color:var(--text-secondary)">{range}</td>
              <td style="padding:0.45rem 0.875rem; border:1px solid var(--border); color:var(--text-secondary); font-family:'Fira Code',monospace">{sp}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div style="display:flex; flex-direction:column; gap:0.625rem">
      {[
        ['*',   'Any / every value in this field'],
        [',',   'List separator — e.g. 1,3,5 means 1st, 3rd, and 5th'],
        ['-',   'Range — e.g. 9-17 means hours 9 through 17 inclusive'],
        ['/',   'Step — e.g. */5 means every 5 units; 0/15 means 0, 15, 30, 45'],
      ].map(([sym, desc]) => (
        <div class="surface-2" style="display:flex; gap:0.75rem; align-items:baseline; background:var(--bg-surface); border:1px solid var(--border); border-radius:0.5rem; padding:0.5rem 0.875rem">
          <code style="font-family:'Fira Code',monospace; font-size:0.9rem; font-weight:700; color:#1D4ED8; min-width:24px">{sym}</code>
          <span style="font-size:0.82rem; color:var(--text-secondary)">{desc}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- ═══ FAQ ═══ -->
  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a cron job?",
          "acceptedAnswer": { "@type": "Answer", "text": "A cron job is a scheduled task on Unix-like systems, managed by the cron daemon. It runs a command or script automatically at a defined time interval — for example, every night at midnight, every Monday morning, or every five minutes. Cron is used for backups, report generation, data syncing, cache clearing, and many other recurring automation tasks." }
        },
        {
          "@type": "Question",
          "name": "What does * * * * * mean?",
          "acceptedAnswer": { "@type": "Answer", "text": "Five asterisks mean 'match every value in every field' — so the job runs every minute of every hour of every day. It is the most permissive schedule possible and is rarely used in production. It is the default starting point in this tool." }
        },
        {
          "@type": "Question",
          "name": "How do I run a job every 5 minutes?",
          "acceptedAnswer": { "@type": "Answer", "text": "Use */5 in the minute field: */5 * * * *. The / character is a step operator — */5 means 'starting at 0, every 5 units'. This produces runs at :00, :05, :10, :15, and so on throughout the day." }
        },
        {
          "@type": "Question",
          "name": "How do I run a job at 9am on weekdays only?",
          "acceptedAnswer": { "@type": "Answer", "text": "Use 0 9 * * 1-5. The 0 9 sets the time to exactly 9:00am. The * * leaves day-of-month and month unrestricted. The 1-5 restricts day-of-week to Monday (1) through Friday (5)." }
        },
        {
          "@type": "Question",
          "name": "What is the difference between day-of-month and day-of-week?",
          "acceptedAnswer": { "@type": "Answer", "text": "Day-of-month (3rd field) matches calendar dates — e.g. the 1st, 15th, or last day of each month. Day-of-week (5th field) matches named days — Monday through Sunday. When both are set to non-wildcard values, most cron implementations run the job if EITHER condition matches (OR logic), not only when both match. Use * in one field to avoid ambiguity." }
        },
        {
          "@type": "Question",
          "name": "Can cron run more frequently than once a minute?",
          "acceptedAnswer": { "@type": "Answer", "text": "Standard cron has a one-minute resolution — it cannot schedule sub-minute intervals. For sub-minute scheduling, you need a different tool: a loop inside a script, a systemd timer with a finer interval, or a task queue like Celery or Bull. Some cloud schedulers (AWS EventBridge, GitHub Actions) also support 1-minute minimum." }
        },
        {
          "@type": "Question",
          "name": "Does this tool support extended cron syntax like @reboot?",
          "acceptedAnswer": { "@type": "Answer", "text": "No — this visualizer generates standard five-field expressions only. Extended syntax (@reboot, @yearly, @monthly, @weekly, @daily, @hourly) is a convenience shorthand supported by some cron implementations (Vixie cron, systemd) but not universally. You can type those shorthands directly into crontab, but this tool outputs the expanded numeric form." }
        },
        {
          "@type": "Question",
          "name": "Why do some months have fewer than 31 days?",
          "acceptedAnswer": { "@type": "Answer", "text": "Cron does not validate day-of-month values against the actual month length. If you schedule a job for day 31, it will simply never run in months with fewer than 31 days (Feb, Apr, Jun, Sep, Nov). The tool's next-runs preview correctly skips non-matching dates, so you can see this behavior before deploying." }
        }
      ]
    }
    </script>

    <h2 class="font-display seo-h2-faq" >Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: 'What is a cron job?',
          a: 'A cron job is a scheduled task on Unix-like systems, managed by the cron daemon. It runs a command or script automatically at a defined time interval — for example, every night at midnight, every Monday morning, or every five minutes. Cron is used for backups, report generation, data syncing, cache clearing, and many other recurring automation tasks.',
        },
        {
          q: 'What does * * * * * mean?',
          a: 'Five asterisks mean "match every value in every field" — so the job runs every minute of every hour of every day. It is the most permissive schedule possible and is rarely used in production. It is the default starting point in this tool.',
        },
        {
          q: 'How do I run a job every 5 minutes?',
          a: 'Use */5 in the minute field: */5 * * * *. The / character is a step operator — */5 means "starting at 0, every 5 units". This produces runs at :00, :05, :10, :15, and so on throughout the day.',
        },
        {
          q: 'How do I run a job at 9am on weekdays only?',
          a: 'Use 0 9 * * 1-5. The 0 9 sets the time to exactly 9:00am. The * * leaves day-of-month and month unrestricted. The 1-5 restricts day-of-week to Monday (1) through Friday (5).',
        },
        {
          q: 'What is the difference between day-of-month and day-of-week?',
          a: 'Day-of-month (3rd field) matches calendar dates — e.g. the 1st, 15th, or last day of each month. Day-of-week (5th field) matches named days — Monday through Sunday. When both are set to non-wildcard values, most cron implementations run the job if EITHER condition matches (OR logic), not only when both match. Use * in one field to avoid ambiguity.',
        },
        {
          q: 'Can cron run more frequently than once a minute?',
          a: 'Standard cron has a one-minute resolution — it cannot schedule sub-minute intervals. For sub-minute scheduling, you need a different tool: a loop inside a script, a systemd timer with a finer interval, or a task queue like Celery or Bull. Some cloud schedulers (AWS EventBridge, GitHub Actions) also support 1-minute minimum.',
        },
        {
          q: 'Does this tool support extended cron syntax like @reboot?',
          a: 'No — this visualizer generates standard five-field expressions only. Extended syntax (@reboot, @yearly, @monthly, @weekly, @daily, @hourly) is a convenience shorthand supported by some cron implementations (Vixie cron, systemd) but not universally. You can type those shorthands directly into crontab, but this tool outputs the expanded numeric form.',
        },
        {
          q: 'Why do some months have fewer than 31 days?',
          a: 'Cron does not validate day-of-month values against the actual month length. If you schedule a job for day 31, it will simply never run in months with fewer than 31 days (Feb, Apr, Jun, Sep, Nov). The tool\'s next-runs preview correctly skips non-matching dates, so you can see this behavior before deploying.',
        },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<style>
