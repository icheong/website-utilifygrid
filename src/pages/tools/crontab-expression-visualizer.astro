    background: rgba(29,78,216,0.15);
    color: #93C5FD;
  }
</style>

<script>
(function () {

  // ── State ──────────────────────────────────────────────────────────
  const state = {
    minute: { mode: 'every', specific: 0,  from: 0, to: 30, n: 5 },
    hour:   { mode: 'every', specific: 9,  from: 9, to: 17, n: 2 },
    dom:    { mode: 'every', specific: 1,  from: 1, to: 15 },
    month:  { mode: 'every', specific: 1,  from: 1, to: 12 },
    dow:    { mode: 'every', specific: 1,  from: 1, to: 5  },
  };

  const MONTH_NAMES = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const DOW_NAMES   = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];


  // ── Wire mode buttons ─────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.fmode').forEach(btn => {
    btn.addEventListener('click', () => {
      const field = btn.dataset.field!;
      const mode  = btn.dataset.mode!;
      (state as any)[field].mode = mode;

      // Update active button
      document.querySelectorAll<HTMLButtonElement>(`.fmode[data-field="${field}"]`).forEach(b => {
        b.classList.toggle('active', b.dataset.mode === mode);
      });

      // Show/hide panes
      ['every','specific','range','every-n'].forEach(m => {
        const pane = document.getElementById(`${field}-pane-${m}`);
        if (pane) pane.style.display = m === mode ? 'block' : 'none';
      });

      updateAll();
    });
  });

  // ── Wire range sliders ────────────────────────────────────────────
  function wireSlider(id: string, valId: string, onUpdate: (v: number) => void) {
    const el  = document.getElementById(id) as HTMLInputElement;
    const val = document.getElementById(valId)!;
    if (!el) return;
    el.addEventListener('input', () => {
      val.textContent = el.value;
      onUpdate(parseInt(el.value));
    });
  }

  wireSlider('minute-from', 'minute-from-val', v => { state.minute.from = v; updateAll(); });
  wireSlider('minute-to',   'minute-to-val',   v => { state.minute.to   = v; updateAll(); });
  wireSlider('minute-n',    'minute-n-val',    v => { state.minute.n    = v; updateAll(); });
  wireSlider('hour-from',   'hour-from-val',   v => { state.hour.from   = v; updateAll(); });
  wireSlider('hour-to',     'hour-to-val',     v => { state.hour.to     = v; updateAll(); });
  wireSlider('hour-n',      'hour-n-val',      v => { state.hour.n      = v; updateAll(); });
  wireSlider('dom-from',    'dom-from-val',    v => { state.dom.from    = v; updateAll(); });
  wireSlider('dom-to',      'dom-to-val',      v => { state.dom.to      = v; updateAll(); });

  // Month selects
  document.getElementById('month-from')?.addEventListener('change', (e) => {
    state.month.from = parseInt((e.target as HTMLSelectElement).value);
    updateAll();
  });
  document.getElementById('month-to')?.addEventListener('change', (e) => {
    state.month.to = parseInt((e.target as HTMLSelectElement).value);
    updateAll();
  });
  document.getElementById('dow-from')?.addEventListener('change', (e) => {
    state.dow.from = parseInt((e.target as HTMLSelectElement).value);
    updateAll();
  });
  document.getElementById('dow-to')?.addEventListener('change', (e) => {
    state.dow.to = parseInt((e.target as HTMLSelectElement).value);
    updateAll();
  });

  // ── Wire specific sliders ─────────────────────────────────────────
  wireSlider('minute-specific', 'minute-specific-val', v => { state.minute.specific = v; updateAll(); });
  wireSlider('hour-specific',   'hour-specific-val',   v => { state.hour.specific   = v; updateAll(); });
  wireSlider('dom-specific',    'dom-specific-val',    v => { state.dom.specific    = v; updateAll(); });

  // Month specific slider — show name label
  (function() {
    const el  = document.getElementById('month-specific') as HTMLInputElement;
    const val = document.getElementById('month-specific-val')!;
    if (!el) return;
    el.addEventListener('input', () => {
      const v = parseInt(el.value);
      state.month.specific = v;
      val.textContent = MONTH_NAMES[v - 1];
      updateAll();
    });
  })();

  // DOW specific slider — show name label
  (function() {
    const el  = document.getElementById('dow-specific') as HTMLInputElement;
    const val = document.getElementById('dow-specific-val')!;
    if (!el) return;
    el.addEventListener('input', () => {
      const v = parseInt(el.value);
      state.dow.specific = v;
      val.textContent = DOW_NAMES[v];
      updateAll();
    });
  })();

  // ── Field → cron token ────────────────────────────────────────────
  function fieldToken(field: string): string {
    const s = (state as any)[field];

    if (s.mode === 'every') return '*';

    if (s.mode === 'specific') {
      return String(s.specific);
    }

    if (s.mode === 'range') {
      const from = s.from ?? 0;
      const to   = s.to   ?? 1;
      if (from >= to) return String(from);
      return `${from}-${to}`;
    }

    if (s.mode === 'every-n') {
      return `*/${s.n}`;
    }

    return '*';
  }

  // ── Human-readable description ────────────────────────────────────
  function humanField(field: string, unitSingular: string, unitPlural: string,
                       labels?: string[], offset = 0): string {
    const s = (state as any)[field];

    if (s.mode === 'every') return `every ${unitSingular}`;

    if (s.mode === 'specific') {
      const v = s.specific;
      return labels ? labels[v - offset] : String(v);
    }

    if (s.mode === 'range') {
      const fromLabel = labels ? labels[s.from - offset] : s.from;
      const toLabel   = labels ? labels[s.to   - offset] : s.to;
      return `${fromLabel} through ${toLabel}`;
    }

    if (s.mode === 'every-n') {
      return `every ${s.n} ${unitPlural}`;
    }

    return `every ${unitSingular}`;
  }

  function buildHumanDesc(min: string, hr: string, dom: string, mon: string, dow: string): string {
    const parts: string[] = [];

    // Time part
    const mState = state.minute;
    const hState = state.hour;

    if (hState.mode === 'every' && mState.mode === 'every') {
      parts.push('every minute');
    } else if (hState.mode === 'every' && mState.mode === 'every-n') {
      parts.push(`every ${mState.n} minutes`);
    } else if (hState.mode === 'specific' && mState.mode === 'specific') {
      const h = hState.specific;
      const m = String(mState.specific).padStart(2,'0');
      parts.push(`at ${h}:${m}`);
    } else if (mState.mode === 'specific' && hState.mode === 'every') {
      parts.push(`at minute ${mState.specific} of every hour`);
    } else {
      parts.push(`at ${humanField('minute','minute','minutes')} past ${humanField('hour','hour','hours')}`);
    }

    // Day part
    const domMode = state.dom.mode;
    const dowMode = state.dow.mode;

    if (domMode === 'every' && dowMode === 'every') {
      // nothing extra
    } else if (domMode !== 'every' && dowMode === 'every') {
      parts.push(`on day ${humanField('dom','day','days')} of the month`);
    } else if (domMode === 'every' && dowMode !== 'every') {
      parts.push(`on ${humanField('dow','day','days', DOW_NAMES, 0)}`);
    } else {
      parts.push(`on day ${humanField('dom','day','days')} of the month and on ${humanField('dow','day','days', DOW_NAMES, 0)}`);
    }

    // Month part
    if (state.month.mode !== 'every') {
      parts.push(`in ${humanField('month','month','months', MONTH_NAMES, 1)}`);
    }

    return parts.join(', ').replace(/^./, c => c.toUpperCase()) + '.';
  }

  // ── Next runs ─────────────────────────────────────────────────────
  function matchesField(token: string, value: number): boolean {
    if (token === '*') return true;
    if (token.startsWith('*/')) {
      const step = parseInt(token.slice(2));
      return value % step === 0;
    }
    if (token.includes('-')) {
      const [a, b] = token.split('-').map(Number);
      return value >= a && value <= b;
    }
    if (token.includes(',')) {
      return token.split(',').map(Number).includes(value);
    }
    return parseInt(token) === value;
  }

  function computeNextRuns(expr: string, count = 5): string[] {
    const [minT, hrT, domT, monT, dowT] = expr.split(' ');
    const results: string[] = [];
    const now = new Date();
    now.setSeconds(0, 0);
    const d = new Date(now.getTime() + 60_000); // start one minute from now

    let iterations = 0;
    while (results.length < count && iterations < 200_000) {
      iterations++;
      if (
        matchesField(monT, d.getMonth() + 1) &&
        (matchesField(domT, d.getDate()) || matchesField(dowT, d.getDay())) &&
        matchesField(hrT, d.getHours()) &&
        matchesField(minT, d.getMinutes())
      ) {
        results.push(d.toLocaleString(undefined, {
          weekday: 'short', month: 'short', day: 'numeric',
          hour: '2-digit', minute: '2-digit', hour12: false,
        }));
      }
      d.setMinutes(d.getMinutes() + 1);
    }
    return results;
  }

  // ── Main update ───────────────────────────────────────────────────
  function updateAll() {
    const min = fieldToken('minute');
    const hr  = fieldToken('hour');
    const dom = fieldToken('dom');
    const mon = fieldToken('month');
    const dow = fieldToken('dow');
    const expr = `${min} ${hr} ${dom} ${mon} ${dow}`;

    document.getElementById('cron-display')!.textContent = expr;
    document.getElementById('human-desc')!.textContent   = buildHumanDesc(min, hr, dom, mon, dow);

    const runs = computeNextRuns(expr);
    document.getElementById('next-runs')!.innerHTML = runs.length
      ? runs.map((r, i) => `<span style="display:block; padding:0.1rem 0; ${i % 2 === 0 ? '' : 'color:var(--text-muted);'}">${r}</span>`).join('')
      : '<span style="color:var(--text-muted);">Could not compute next runs for this expression.</span>';
  }

  // ── Common templates ──────────────────────────────────────────────
  const TEMPLATES = [
    { label: 'Every minute',      expr: '* * * * *'   },
    { label: 'Every 5 min',       expr: '*/5 * * * *'  },
    { label: 'Every 15 min',      expr: '*/15 * * * *' },
    { label: 'Every 30 min',      expr: '*/30 * * * *' },
    { label: 'Hourly',            expr: '0 * * * *'    },
    { label: 'Daily midnight',    expr: '0 0 * * *'    },
    { label: 'Daily 9am',         expr: '0 9 * * *'    },
    { label: 'Weekdays 9am',      expr: '0 9 * * 1-5'  },
    { label: 'Weekly Mon 9am',    expr: '0 9 * * 1'    },
    { label: 'Monthly 1st',       expr: '0 0 1 * *'    },
    { label: 'Yearly Jan 1st',    expr: '0 0 1 1 *'    },
  ];

  const tplRow = document.getElementById('templates-row')!;
  TEMPLATES.forEach(tpl => {
    const chip = document.createElement('button');
    chip.className = 'tpl-chip';
    chip.textContent = tpl.label;
    chip.title = tpl.expr;
    chip.addEventListener('click', () => applyTemplate(tpl.expr));
    tplRow.appendChild(chip);
  });

  function applyTemplate(expr: string) {
    const [min, hr, dom, mon, dow] = expr.split(' ');
    // Reset all to 'every' first
    ['minute','hour','dom','month','dow'].forEach(f => {
      (state as any)[f].mode = 'every';
      document.querySelectorAll<HTMLButtonElement>(`.fmode[data-field="${f}"]`).forEach(b => {
        b.classList.toggle('active', b.dataset.mode === 'every');
      });
      ['every','specific','range','every-n'].forEach(m => {
        const p = document.getElementById(`${f}-pane-${m}`);
        if (p) p.style.display = m === 'every' ? 'block' : 'none';
      });
    });

    // Apply each field
    applyTokenToField('minute', min);
    applyTokenToField('hour',   hr);
    applyTokenToField('dom',    dom);
    applyTokenToField('month',  mon);
    applyTokenToField('dow',    dow);

    updateAll();
  }

  function applyTokenToField(field: string, token: string) {
    const s = (state as any)[field];

    if (token === '*') {
      setFieldMode(field, 'every');
      return;
    }
    if (token.startsWith('*/')) {
      const n = parseInt(token.slice(2));
      s.n = n;
      const slEl = document.getElementById(`${field}-n`) as HTMLInputElement;
      const valEl = document.getElementById(`${field}-n-val`);
      if (slEl) { slEl.value = String(n); }
      if (valEl) { valEl.textContent = String(n); }
      setFieldMode(field, 'every-n');
      return;
    }
    if (token.includes('-')) {
      const [a, b] = token.split('-').map(Number);
      s.from = a; s.to = b;
      const fromEl  = document.getElementById(`${field}-from`) as HTMLInputElement|HTMLSelectElement;
      const toEl    = document.getElementById(`${field}-to`)   as HTMLInputElement|HTMLSelectElement;
      const fromVal = document.getElementById(`${field}-from-val`);
      const toVal   = document.getElementById(`${field}-to-val`);
      if (fromEl) fromEl.value = String(a);
      if (toEl)   toEl.value   = String(b);
      if (fromVal) fromVal.textContent = String(a);
      if (toVal)   toVal.textContent   = String(b);
      setFieldMode(field, 'range');
      return;
    }
    if (/^\d+$/.test(token)) {
      const v = parseInt(token);
      const s = (state as any)[field];
      s.specific = v;
      const slEl  = document.getElementById(`${field}-specific`) as HTMLInputElement;
      const valEl = document.getElementById(`${field}-specific-val`);
      if (slEl) slEl.value = String(v);
      if (valEl) {
        if (field === 'month') valEl.textContent = MONTH_NAMES[v - 1];
        else if (field === 'dow') valEl.textContent = DOW_NAMES[v];
        else valEl.textContent = String(v);
      }
      setFieldMode(field, 'specific');
      return;
    }
  }

  function setFieldMode(field: string, mode: string) {
    (state as any)[field].mode = mode;
    document.querySelectorAll<HTMLButtonElement>(`.fmode[data-field="${field}"]`).forEach(b => {
      b.classList.toggle('active', b.dataset.mode === mode);
    });
    ['every','specific','range','every-n'].forEach(m => {
      const p = document.getElementById(`${field}-pane-${m}`);
      if (p) p.style.display = m === mode ? 'block' : 'none';
    });
  }

  // ── Copy button ───────────────────────────────────────────────────
  document.getElementById('copy-btn')!.addEventListener('click', () => {
    const expr = document.getElementById('cron-display')!.textContent || '';
    const btn  = document.getElementById('copy-btn') as HTMLButtonElement;
    navigator.clipboard.writeText(expr).then(() => {
      btn.textContent = '✓ Copied!';
      btn.style.background = '#16A34A';
      setTimeout(() => {
        btn.textContent = 'Copy';
        btn.style.background = '#1D4ED8';
      }, 2000);
    });
  });

  // ── Reset button ──────────────────────────────────────────────────
  document.getElementById('reset-btn')!.addEventListener('click', () => {
    applyTemplate('* * * * *');
  });

  // ── Initial render ────────────────────────────────────────────────
  updateAll();

})();
</script>
