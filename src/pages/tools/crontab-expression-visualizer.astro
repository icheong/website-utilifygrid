    border: 1.5px solid var(--border);
    background: var(--bg-surface-2);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .tpl-chip:hover {
    border-color: #1D4ED8;
