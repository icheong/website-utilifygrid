    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-left: auto;
  }
  .field-body {
    padding: 0.875rem 1rem;
  }

  /* ── Mode buttons ── */
  .mode-row {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-bottom: 0.875rem;
  }
  .fmode {
    padding: 0.3rem 0.75rem;
