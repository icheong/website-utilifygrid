---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'angle-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Angle Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter an angle value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="angle-input">Angle</label>
        <input id="angle-input" type="number" value="90" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="angle-unit">Unit</label>
        <select id="angle-unit" class="select-themed" style="min-width:10rem;">
          <option value="deg" selected>Degree (°)</option>
          <option value="rad">Radian (rad)</option>
          <option value="grad">Gradian (grad)</option>
          <option value="arcmin">Arcminute (′)</option>
          <option value="arcsec">Arcsecond (″)</option>
          <option value="rev">Revolution (rev)</option>
          <option value="mil">NATO Mil (mil)</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Angle Converter</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Enter a <strong>numeric angle value</strong> and select its <strong>unit</strong> from the dropdown. All other angle units update instantly as you type — no buttons to click.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      The converter supports 7 standard angle units: <strong>degrees</strong>, <strong>radians</strong>, <strong>gradians</strong>, <strong>arcminutes</strong>, <strong>arcseconds</strong>, <strong>revolutions</strong>, and <strong>NATO mils</strong>.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      Click any <strong>Copy</strong> button to copy that unit's result to your clipboard. Common reference angles are shown below the results for quick comparison.
    </p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How angle conversions work</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.875rem;">
      All conversions use <strong>degrees</strong> as the base unit. Each unit has a fixed factor relative to one degree:
    </p>
    <pre style="font-family:'Fira Code',monospace;font-size:.85rem;padding:1rem;border-radius:.5rem;background:var(--bg-surface-2);color:var(--text-primary);overflow-x:auto;white-space:pre-wrap;">1 rad     = 180/π °  ≈ 57.29578°
1 grad    = 0.9°
1 arcmin  = 1/60 °   ≈ 0.0002778°
1 arcsec  = 1/3600 ° ≈ 0.00000007716°
1 rev     = 360°
1 mil     = 0.05625°  (NATO: 6400 mil = 360°)

Result = Input × (FromFactor / ToFactor)</pre>
    <p style="color:var(--text-secondary); font-size:0.85rem; line-height:1.75;">
      Radians are the natural unit for angular measurement: one full circle equals 2π radians = 360°. Gradians (also called grads or gons) divide a right angle into 100 parts (400 grad = 360°). The NATO mil divides a circle into 6,400 parts for military artillery aiming.
    </p>
  </div>

  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the difference between degrees and radians?",
          "acceptedAnswer": { "@type": "Answer", "text": "Degrees divide a circle into 360 equal parts. Radians use the arc length equal to the radius: one full circle = 2π radians ≈ 6.2832 rad. Radians are the standard unit in mathematics and physics because they simplify many formulas (e.g., sin(θ), derivatives of trig functions)." }
        },
        {
          "@type": "Question",
          "name": "What is a gradian?",
          "acceptedAnswer": { "@type": "Answer", "text": "A gradian (also called grad, gon, or grade) divides a right angle into 100 parts, so a full circle = 400 grad. It was designed for metrication. It is used in some surveying and civil engineering contexts, mainly in Europe." }
        },
        {
          "@type": "Question",
          "name": "What is a NATO mil?",
          "acceptedAnswer": { "@type": "Answer", "text": "A NATO mil divides a circle into 6,400 equal parts (1 mil = 0.05625°). It is used for military artillery and gunnery to express angular measurements for targeting. The mil allows rough mental calculations for range and deflection." }
        },
        {
          "@type": "Question",
          "name": "How many arcminutes are in a degree?",
          "acceptedAnswer": { "@type": "Answer", "text": "There are exactly 60 arcminutes (′) in one degree, and 60 arcseconds (″) in one arcminute. So 1° = 60′ = 3,600″. Arcminutes and arcseconds are commonly used in astronomy to express the angular size of objects." }
        },
        {
          "@type": "Question",
          "name": "Why is a full circle 360 degrees?",
          "acceptedAnswer": { "@type": "Answer", "text": "The 360-degree circle dates to ancient Babylonian astronomy. The Babylonians used a base-60 (sexagesimal) number system, and 360 is close to the number of days in a year. 360 is also highly divisible (1, 2, 3, 4, 5, 6, 8, 9, 10, 12, etc.), making it easy to work with fractions of a circle." }
        }
      ]
    }
    </script>

    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What is the difference between degrees and radians?', a: 'Degrees divide a circle into 360 equal parts. Radians use the arc length equal to the radius: one full circle = 2π radians ≈ 6.2832 rad. Radians are the standard unit in mathematics and physics because they simplify many formulas (e.g., sin(θ), derivatives of trig functions).' },
        { q: 'What is a gradian?', a: 'A gradian (also called grad, gon, or grade) divides a right angle into 100 parts, so a full circle = 400 grad. It was designed for metrication. It is used in some surveying and civil engineering contexts, mainly in Europe.' },
        { q: 'What is a NATO mil?', a: 'A NATO mil divides a circle into 6,400 equal parts (1 mil = 0.05625°). It is used for military artillery and gunnery to express angular measurements for targeting. The mil allows rough mental calculations for range and deflection.' },
        { q: 'How many arcminutes are in a degree?', a: 'There are exactly 60 arcminutes (′) in one degree, and 60 arcseconds (″) in one arcminute. So 1° = 60′ = 3,600″. Arcminutes and arcseconds are commonly used in astronomy to express the angular size of objects.' },
        { q: 'Why is a full circle 360 degrees?', a: 'The 360-degree circle dates to ancient Babylonian astronomy. The Babylonians used a base-60 (sexagesimal) number system, and 360 is close to the number of days in a year. 360 is also highly divisible (1, 2, 3, 4, 5, 6, 8, 9, 10, 12, etc.), making it easy to work with fractions of a circle.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to degrees ───────────────────────────────
  const TO_DEG = {
    deg:    1,
    rad:    180 / Math.PI,
    grad:   0.9,
    arcmin: 1 / 60,
    arcsec: 1 / 3600,
    rev:    360,
    mil:    0.05625,
  };

  const UNITS = [
    { id: 'deg',    label: '°',     name: 'Degree' },
    { id: 'rad',    label: 'rad',   name: 'Radian' },
    { id: 'grad',   label: 'grad',  name: 'Gradian' },
    { id: 'arcmin', label: '′',     name: 'Arcminute' },
    { id: 'arcsec', label: '″',     name: 'Arcsecond' },
    { id: 'rev',    label: 'rev',   name: 'Revolution' },
    { id: 'mil',    label: 'mil',   name: 'NATO Mil' },
  ];

  // ── Quick-reference objects (stored in degrees) ─────────────────
  const REFS = [
    { name: 'Clock Minute Hand (1 min)',  deg: 6 },
    { name: 'Clock Hour Hand (1 hr)',     deg: 30 },
    { name: 'Acute Angle',                deg: 45 },
    { name: 'Right Angle',                deg: 90 },
    { name: 'Obtuse Angle',               deg: 135 },
    { name: 'Straight Angle',             deg: 180 },
    { name: 'Full Circle',                deg: 360 },
    { name: 'Hexagonal Turn',             deg: 60 },
  ];

  const input  = document.getElementById('angle-input') as HTMLInputElement;
  const select = document.getElementById('angle-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e12) return value.toExponential(4);
    if (abs >= 1e9)  return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(6);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const degVal   = val * TO_DEG[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = degVal / TO_DEG[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = r.deg / TO_DEG[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
