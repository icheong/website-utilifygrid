---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'password-hash-evaluator')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.5rem;">
      Password Generator &amp; Security Evaluator
    </h2>

    <!-- ── Generated password output ── -->
    <div style="position:relative; margin-bottom:1.25rem;">
      <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.875rem; padding:1rem 3.5rem 1rem 1.25rem; min-height:3.25rem; display:flex; align-items:center;">
        <code id="pwd-output"
          style="font-family:'Fira Code',monospace; font-size:1rem; font-weight:500; color:var(--text-primary); letter-spacing:0.04em; word-break:break-all; flex:1; line-height:1.5;">
          Click Generate to create a password
        </code>
      </div>
      <!-- Copy button -->
      <button id="btn-copy"
        title="Copy to clipboard"
        style="position:absolute; right:0.75rem; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:var(--text-muted); padding:0.35rem; border-radius:0.375rem; transition:color 0.15s, background 0.15s; display:flex; align-items:center; gap:0.3rem; font-size:0.75rem; font-weight:600;"
        onmouseover="this.style.color='#1D4ED8';this.style.background='rgba(29,78,216,0.08)';"
        onmouseout="this.style.color='var(--text-muted)';this.style.background='none';"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
        </svg>
        <span id="copy-label">Copy</span>
      </button>
    </div>

    <!-- ── Strength meter ── -->
    <div style="margin-bottom:1.5rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
        <span style="font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.07em;">Password Strength</span>
        <span id="strength-label" style="font-size:0.78rem; font-weight:700; color:var(--text-muted); transition:color 0.3s;">—</span>
      </div>
      <!-- 5-segment bar -->
      <div style="display:flex; gap:3px;">
        <div id="bar-0" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
        <div id="bar-1" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
        <div id="bar-2" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
        <div id="bar-3" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
        <div id="bar-4" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
      </div>
    </div>

    <!-- ── Stat cards ── -->
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.625rem; margin-bottom:1.5rem;">
      <!-- Entropy -->
      <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.875rem 0.75rem; text-align:center;">
        <div id="out-entropy" style="font-family:'Sora',sans-serif; font-size:1.35rem; font-weight:700; color:var(--text-primary); transition:color 0.3s;">—</div>
        <div style="font-size:0.67rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.05em;">Entropy (bits)</div>
      </div>
      <!-- Charset -->
      <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.875rem 0.75rem; text-align:center;">
        <div id="out-charset" style="font-family:'Sora',sans-serif; font-size:1.35rem; font-weight:700; color:var(--text-primary); transition:color 0.3s;">—</div>
        <div style="font-size:0.67rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.05em;">Charset Size</div>
      </div>
      <!-- Crack time -->
      <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.875rem 0.75rem; text-align:center;">
        <div id="out-crack" style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); transition:color 0.3s; line-height:1.2; padding-top:0.15rem;">—</div>
        <div style="font-size:0.67rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.05em;">To Crack (1B/s)</div>
      </div>
    </div>

    <!-- ── Divider ── -->
    <div style="border-top:1px solid var(--border); margin-bottom:1.25rem;"></div>

    <!-- ── Generator controls ── -->
    <div style="display:flex; flex-direction:column; gap:1rem; margin-bottom:1.25rem;">

      <!-- Length slider -->
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
          <label for="ctrl-length" style="font-size:0.82rem; font-weight:600; color:var(--text-secondary);">Length</label>
          <span id="length-display" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#1D4ED8; min-width:2.5rem; text-align:right;">16</span>
        </div>
        <input id="ctrl-length" type="range" min="8" max="64" value="16"
          style="width:100%; accent-color:#1D4ED8; cursor:pointer;" />
      </div>

      <!-- Character set toggles -->
      <div>
        <div style="font-size:0.82rem; font-weight:600; color:var(--text-secondary); margin-bottom:0.625rem;">Include Characters</div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
          <label id="lbl-upper" class="char-toggle active-toggle" style="display:flex; align-items:center; gap:0.625rem; padding:0.6rem 0.875rem; border-radius:0.625rem; cursor:pointer; border:1.5px solid #1D4ED8; background:rgba(29,78,216,0.07); transition:all 0.15s; user-select:none;">
            <input id="chk-upper" type="checkbox" checked style="display:none;" />
            <span class="toggle-dot" style="width:16px; height:16px; border-radius:50%; background:#1D4ED8; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
              <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M2 5l2.5 2.5L8 3" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span style="font-size:0.8rem; font-weight:600; color:#1D4ED8; font-family:'Fira Code',monospace;">A–Z</span>
            <span style="font-size:0.72rem; color:var(--text-muted); margin-left:auto;">+26</span>
          </label>
          <label id="lbl-lower" class="char-toggle active-toggle" style="display:flex; align-items:center; gap:0.625rem; padding:0.6rem 0.875rem; border-radius:0.625rem; cursor:pointer; border:1.5px solid #1D4ED8; background:rgba(29,78,216,0.07); transition:all 0.15s; user-select:none;">
            <input id="chk-lower" type="checkbox" checked style="display:none;" />
            <span class="toggle-dot" style="width:16px; height:16px; border-radius:50%; background:#1D4ED8; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
              <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M2 5l2.5 2.5L8 3" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span style="font-size:0.8rem; font-weight:600; color:#1D4ED8; font-family:'Fira Code',monospace;">a–z</span>
            <span style="font-size:0.72rem; color:var(--text-muted); margin-left:auto;">+26</span>
          </label>
          <label id="lbl-digits" class="char-toggle active-toggle" style="display:flex; align-items:center; gap:0.625rem; padding:0.6rem 0.875rem; border-radius:0.625rem; cursor:pointer; border:1.5px solid #1D4ED8; background:rgba(29,78,216,0.07); transition:all 0.15s; user-select:none;">
            <input id="chk-digits" type="checkbox" checked style="display:none;" />
            <span class="toggle-dot" style="width:16px; height:16px; border-radius:50%; background:#1D4ED8; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
              <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M2 5l2.5 2.5L8 3" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span style="font-size:0.8rem; font-weight:600; color:#1D4ED8; font-family:'Fira Code',monospace;">0–9</span>
            <span style="font-size:0.72rem; color:var(--text-muted); margin-left:auto;">+10</span>
          </label>
          <label id="lbl-symbols" class="char-toggle active-toggle" style="display:flex; align-items:center; gap:0.625rem; padding:0.6rem 0.875rem; border-radius:0.625rem; cursor:pointer; border:1.5px solid #1D4ED8; background:rgba(29,78,216,0.07); transition:all 0.15s; user-select:none;">
            <input id="chk-symbols" type="checkbox" checked style="display:none;" />
            <span class="toggle-dot" style="width:16px; height:16px; border-radius:50%; background:#1D4ED8; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
              <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M2 5l2.5 2.5L8 3" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span style="font-size:0.8rem; font-weight:600; color:#1D4ED8; font-family:'Fira Code',monospace;">!@#…</span>
            <span style="font-size:0.72rem; color:var(--text-muted); margin-left:auto;">+32</span>
          </label>
        </div>
      </div>

      <!-- Avoid ambiguous toggle -->
      <label style="display:flex; align-items:center; gap:0.75rem; cursor:pointer; user-select:none; padding:0.625rem 0.875rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem;">
        <input id="chk-noambig" type="checkbox"
          style="width:1rem; height:1rem; accent-color:#1D4ED8; cursor:pointer;" />
        <div>
          <div style="font-size:0.82rem; font-weight:600; color:var(--text-secondary);">Avoid ambiguous characters</div>
          <div style="font-size:0.72rem; color:var(--text-muted); margin-top:0.1rem;">Excludes: 0 O o l 1 I i</div>
        </div>
      </label>
    </div>

    <!-- ── Generate button ── -->
    <button id="btn-generate"
      style="width:100%; padding:0.75rem 1.5rem; background:#1D4ED8; color:#fff; border:none; border-radius:0.625rem; font-family:'Sora',sans-serif; font-size:0.95rem; font-weight:700; cursor:pointer; transition:background 0.15s, transform 0.1s; letter-spacing:0.02em; display:flex; align-items:center; justify-content:center; gap:0.5rem;"
      onmouseover="this.style.background='#1E3A8A';"
      onmouseout="this.style.background='#1D4ED8';"
      onmousedown="this.style.transform='scale(0.98)';"
      onmouseup="this.style.transform='scale(1)';"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
      </svg>
      Generate Password
    </button>

    <!-- ── SHA-256 hash ── -->
    <div style="margin-top:1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem; padding:1rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
        <span style="font-size:0.75rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em;">SHA-256 Hash</span>
        <button id="copy-hash" style="font-size:0.75rem; color:#4F46E5; background:none; border:none; cursor:pointer; font-weight:600; padding:0; transition:color 0.15s;"
          onmouseover="this.style.color='#1D4ED8';" onmouseout="this.style.color='#4F46E5';">Copy</button>
      </div>
      <code id="out-hash" style="font-family:'Fira Code',monospace; font-size:0.68rem; color:var(--text-secondary); word-break:break-all; line-height:1.6; display:block;">Generate a password to see its hash</code>
    </div>

    <!-- ── Privacy notice ── -->
    <div style="margin-top:0.875rem; padding:0.625rem 0.875rem; background:rgba(245,158,11,0.08); border:1px solid rgba(245,158,11,0.3); border-radius:0.5rem; font-size:0.78rem; color:var(--text-secondary); display:flex; align-items:flex-start; gap:0.5rem;">
      <span style="flex-shrink:0; margin-top:0.05rem;">🔒</span>
      <span>Passwords are generated and hashed entirely in your browser using <code style="font-family:'Fira Code',monospace; font-size:0.75rem; color:var(--text-primary);">crypto.getRandomValues()</code> and the Web Crypto API. Nothing is sent anywhere.</span>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       HOW TO USE
  ══════════════════════════════════════════════ -->
  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Password Generator</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Adjust the length slider and toggle which character sets to include — uppercase, lowercase, digits, and symbols. Click <strong>Generate Password</strong> to create a cryptographically secure random password. The strength meter and all metrics update instantly.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      Use the <em>Avoid ambiguous characters</em> option to remove look-alike characters (0/O, 1/l/I) that are easy to misread when typing a password manually. Click Copy to copy the password to your clipboard. The SHA-256 hash is useful for verifying integrity or for developer testing.
    </p>
  </div>

  <!-- ══════════════════════════════════════════════
       HOW IT WORKS
  ══════════════════════════════════════════════ -->
  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How entropy and strength are calculated</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;">
      {[
        ['Cryptographic Generation', 'Passwords are generated using window.crypto.getRandomValues(), which produces cryptographically secure random bytes. Each character is selected from the full allowed character pool using an unbiased modulo rejection algorithm, so every character has exactly equal probability of being chosen.'],
        ['Charset Size', 'The tool sums the sizes of each active character set: lowercase (26), uppercase (26), digits (10), symbols (~32). Excluding ambiguous characters reduces these pools slightly. A larger charset means more possible combinations per character position.'],
        ['Entropy', 'Entropy (bits) = password length × log₂(charset size). Each added bit of entropy doubles the number of guesses required. A 16-character password using all four sets yields ~104 bits — enough to resist even distributed brute-force attacks with current hardware.'],
        ['Strength Rating', 'Very Weak: below 28 bits. Weak: 28–35. Fair: 36–59. Strong: 60–127. Very Strong: 128+. These thresholds reflect widely cited cracking resistance benchmarks. For important accounts, aim for 80+ bits.'],
        ['Crack Time Estimate', 'Displayed as the time to crack at 1 billion guesses per second (10⁹/s) — a reasonable modern estimate for an offline attack against a fast hash like SHA-256. The formula is: (charset^length) / (2 × guesses/s), divided to average half the search space.'],
        ['SHA-256 Hash', 'Computed client-side using SubtleCrypto.digest(). Useful for developer testing but should never be used for storing passwords in production — SHA-256 is too fast. Use bcrypt, Argon2id, or scrypt with salt for password storage.'],
      ].map(([label, desc]) => (
        <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:0.625rem; padding:0.875rem 1rem;">
          <div style="font-size:0.82rem; font-weight:700; color:var(--text-primary); margin-bottom:0.3rem;">{label}</div>
          <p style="font-size:0.82rem; color:var(--text-secondary); line-height:1.6; margin:0;">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════════ -->
  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: 'How many bits of entropy does a strong password need?',
          a: 'For general personal accounts, 60+ bits is considered strong. For high-value accounts (financial, admin, email), target 80+ bits. A 16-character randomly generated password using all four character sets yields approximately 104 bits — well beyond what any current hardware can brute-force in a human lifetime. Passphrases of 5 random common words yield around 65 bits.'
        },
        {
          q: 'Is this generator truly random?',
          a: 'Yes. The tool uses window.crypto.getRandomValues(), which draws from the operating system\'s cryptographically secure pseudo-random number generator (CSPRNG). This is the same source used by browsers for TLS key generation. It is fundamentally different from Math.random(), which is not cryptographically secure.'
        },
        {
          q: 'Should I use a password manager?',
          a: 'Absolutely. A password manager lets you use a unique, randomly generated password for every service without memorising them. This prevents credential stuffing — where a leaked password from one site is tested on others. Recommended options include Bitwarden (open source, free), 1Password, and KeePass (local, offline).'
        },
        {
          q: 'Is SHA-256 safe for storing passwords?',
          a: 'No. SHA-256 is a fast general-purpose hash designed for data integrity — attackers can compute billions of SHA-256 hashes per second on consumer GPUs. Passwords must be stored using slow, purpose-built algorithms: bcrypt, Argon2id, or scrypt, all of which include salting and configurable work factors to resist hardware acceleration.'
        },
        {
          q: 'Why avoid ambiguous characters?',
          a: 'Characters like 0 (zero), O (uppercase o), l (lowercase L), 1 (one), and I (uppercase i) look nearly identical in many fonts. When you need to type a password by hand — into a TV, phone lock screen, or another device — these ambiguous characters cause unnecessary errors. Excluding them costs very little entropy while dramatically reducing transcription errors.'
        },
        {
          q: 'What is the difference between password length and complexity?',
          a: 'Both matter, but length is the dominant factor. Every additional character multiplies the search space by the charset size. Going from 12 to 16 characters (with a 94-character full set) adds roughly 25 bits of entropy — equivalent to squaring the difficulty four times. Complexity (using symbols and mixed case) increases the charset size, which also helps, but length gives a bigger return per unit of effort to remember or configure.'
        },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<!-- ══════════════════════════════════════════════════════════
     CLIENT-SIDE LOGIC
══════════════════════════════════════════════════════════ -->
<script>
  // ── Character pools ───────────────────────────────────────
  const POOL_UPPER   = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const POOL_LOWER   = 'abcdefghijklmnopqrstuvwxyz';
  const POOL_DIGITS  = '0123456789';
  const POOL_SYMBOLS = '!@#$%^&*()-_=+[]{}|;:,.<>?';

  const AMBIGUOUS = new Set(['0','O','o','l','1','I','i']);

  // ── UI references ─────────────────────────────────────────
  const pwdOutput    = document.getElementById('pwd-output')!;
  const btnGenerate  = document.getElementById('btn-generate')!;
  const btnCopy      = document.getElementById('btn-copy')!;
  const copyLabel    = document.getElementById('copy-label')!;
  const lengthSlider = document.getElementById('ctrl-length') as HTMLInputElement;
  const lengthDisplay= document.getElementById('length-display')!;
  const chkUpper     = document.getElementById('chk-upper')   as HTMLInputElement;
  const chkLower     = document.getElementById('chk-lower')   as HTMLInputElement;
  const chkDigits    = document.getElementById('chk-digits')  as HTMLInputElement;
  const chkSymbols   = document.getElementById('chk-symbols') as HTMLInputElement;
  const chkNoAmbig   = document.getElementById('chk-noambig') as HTMLInputElement;
  const lblUpper     = document.getElementById('lbl-upper')!;
  const lblLower     = document.getElementById('lbl-lower')!;
  const lblDigits    = document.getElementById('lbl-digits')!;
  const lblSymbols   = document.getElementById('lbl-symbols')!;

  const outEntropy   = document.getElementById('out-entropy')!;
  const outCharset   = document.getElementById('out-charset')!;
  const outCrack     = document.getElementById('out-crack')!;
  const strengthLabel= document.getElementById('strength-label')!;
  const outHash      = document.getElementById('out-hash')!;
  const copyHashBtn  = document.getElementById('copy-hash')!;

  // ── Strength config ───────────────────────────────────────
  const STRENGTH_LABELS = ['Very Weak','Weak','Fair','Strong','Very Strong'];
  const STRENGTH_COLORS = ['#DC2626','#F59E0B','#EAB308','#16A34A','#059669'];
  const STRENGTH_THRESHOLDS = [0, 28, 36, 60, 128];

  function getStrengthIndex(entropy: number): number {
    for (let i = STRENGTH_THRESHOLDS.length - 1; i >= 0; i--) {
      if (entropy >= STRENGTH_THRESHOLDS[i]) return i;
    }
    return 0;
  }

  // ── Build charset ─────────────────────────────────────────
  function buildPool(): string {
    let pool = '';
    const noAmbig = chkNoAmbig.checked;
    const filter  = (s: string) => noAmbig ? s.split('').filter(c => !AMBIGUOUS.has(c)).join('') : s;
    if (chkUpper.checked)   pool += filter(POOL_UPPER);
    if (chkLower.checked)   pool += filter(POOL_LOWER);
    if (chkDigits.checked)  pool += filter(POOL_DIGITS);
    if (chkSymbols.checked) pool += POOL_SYMBOLS; // symbols have no ambiguous chars
    return pool;
  }

  // ── Cryptographic generation ──────────────────────────────
  function generatePassword(length: number, pool: string): string {
    if (!pool) return '';
    const arr = new Uint32Array(length * 2);
    crypto.getRandomValues(arr);
    let result = '';
    let idx = 0;
    while (result.length < length && idx < arr.length) {
      const val = arr[idx++];
      // Rejection sampling: skip values that would introduce modulo bias
      const limit = Math.floor(0xFFFFFFFF / pool.length) * pool.length;
      if (val > limit) continue;
      result += pool[val % pool.length];
    }
    // Fallback if we ran out of random values (very unlikely)
    if (result.length < length) {
      const extra = new Uint32Array(length);
      crypto.getRandomValues(extra);
      for (let i = 0; result.length < length; i++) {
        result += pool[extra[i] % pool.length];
      }
    }
    return result;
  }

  // ── Format crack time ─────────────────────────────────────
  function formatCrackTime(combinations: number): string {
    const guessesPerSec = 1e9;
    const seconds = combinations / (2 * guessesPerSec);
    if (seconds < 1)             return '< 1 sec';
    if (seconds < 60)            return `${Math.round(seconds)} sec`;
    if (seconds < 3600)          return `${Math.round(seconds/60)} min`;
    if (seconds < 86400)         return `${Math.round(seconds/3600)} hrs`;
    if (seconds < 86400*365)     return `${Math.round(seconds/86400)} days`;
    if (seconds < 86400*365*1e3) return `${Math.round(seconds/(86400*365))} yrs`;
    if (seconds < 86400*365*1e6) return `${(seconds/(86400*365*1e3)).toFixed(0)}K yrs`;
    if (seconds < 86400*365*1e9) return `${(seconds/(86400*365*1e6)).toFixed(0)}M yrs`;
    return '∞ (heat death)';
  }

  // ── Update metrics ────────────────────────────────────────
  async function updateMetrics(password: string) {
    const pool     = buildPool();
    const charset  = pool.length;
    const length   = password.length;
    const entropy  = charset > 0 && length > 0 ? Math.round(length * Math.log2(charset)) : 0;
    const strength = getStrengthIndex(entropy);
    const color    = STRENGTH_COLORS[strength];

    outEntropy.textContent = entropy > 0 ? `${entropy}` : '—';
    outCharset.textContent = charset > 0 ? `${charset}` : '—';
    outEntropy.style.color = color;
    outCharset.style.color = color;

    if (charset > 0 && length > 0) {
      const combinations = Math.pow(charset, length);
      outCrack.textContent = formatCrackTime(combinations);
      outCrack.style.color = color;
    } else {
      outCrack.textContent = '—';
    }

    strengthLabel.textContent = entropy > 0 ? STRENGTH_LABELS[strength] : '—';
    strengthLabel.style.color = color;

    for (let i = 0; i < 5; i++) {
      const bar = document.getElementById(`bar-${i}`) as HTMLElement;
      bar.style.background = i <= strength && entropy > 0 ? color : 'var(--bg-surface-3)';
    }

    // SHA-256
    if (password) {
      try {
        const data = new TextEncoder().encode(password);
        const hash = await crypto.subtle.digest('SHA-256', data);
        const hex  = Array.from(new Uint8Array(hash)).map(b => b.toString(16).padStart(2,'0')).join('');
        outHash.textContent = hex;
      } catch {
        outHash.textContent = 'SHA-256 unavailable';
      }
    } else {
      outHash.textContent = 'Generate a password to see its hash';
    }
  }

  // ── Render password with character type colouring ─────────
  function renderPassword(pwd: string) {
    if (!pwd) {
      pwdOutput.innerHTML = '<span style="color:var(--text-muted); font-size:0.875rem; font-family:\'Inter\',sans-serif; font-weight:400; letter-spacing:0;">Click Generate to create a password</span>';
      return;
    }
    const html = pwd.split('').map(c => {
      if (/[A-Z]/.test(c)) return `<span style="color:#1D4ED8;">${c}</span>`;
      if (/[a-z]/.test(c)) return `<span style="color:var(--text-primary);">${c}</span>`;
      if (/[0-9]/.test(c)) return `<span style="color:#059669;">${c}</span>`;
      return `<span style="color:#DC2626;">${c}</span>`;
    }).join('');
    pwdOutput.innerHTML = html;
  }

  // ── Generate ──────────────────────────────────────────────
  let currentPassword = '';

  function generate() {
    const pool   = buildPool();
    const length = parseInt(lengthSlider.value);
    if (!pool) {
      renderPassword('');
      updateMetrics('');
      return;
    }
    currentPassword = generatePassword(length, pool);
    renderPassword(currentPassword);
    updateMetrics(currentPassword);
  }

  // ── Toggle label styling helper ───────────────────────────
  function syncToggleStyle(chk: HTMLInputElement, lbl: HTMLElement) {
    const active = chk.checked;
    lbl.style.borderColor = active ? '#1D4ED8' : 'var(--border)';
    lbl.style.background  = active ? 'rgba(29,78,216,0.07)' : 'var(--bg-surface-2)';
    const dot = lbl.querySelector('.toggle-dot') as HTMLElement;
    const svg = dot?.querySelector('svg') as SVGElement;
    if (dot) dot.style.background = active ? '#1D4ED8' : 'var(--bg-surface-3)';
    const span = lbl.querySelectorAll('span')[1] as HTMLElement;
    if (span) span.style.color = active ? '#1D4ED8' : 'var(--text-secondary)';
  }

  // ── Event wiring ──────────────────────────────────────────
  btnGenerate.addEventListener('click', generate);

  lengthSlider.addEventListener('input', () => {
    lengthDisplay.textContent = lengthSlider.value;
    if (currentPassword) generate();
  });

  // Prevent all checkboxes from being unchecked simultaneously
  [
    { chk: chkUpper,   lbl: lblUpper   },
    { chk: chkLower,   lbl: lblLower   },
    { chk: chkDigits,  lbl: lblDigits  },
    { chk: chkSymbols, lbl: lblSymbols },
  ].forEach(({ chk, lbl }) => {
    lbl.addEventListener('click', (e) => {
      e.preventDefault();
      // Count how many are currently active
      const active = [chkUpper, chkLower, chkDigits, chkSymbols].filter(c => c.checked).length;
      if (chk.checked && active <= 1) return; // don't uncheck last one
      chk.checked = !chk.checked;
      syncToggleStyle(chk, lbl);
      if (currentPassword) generate();
    });
  });

  chkNoAmbig.addEventListener('change', () => {
    if (currentPassword) generate();
  });

  // Copy password
  btnCopy.addEventListener('click', () => {
    if (!currentPassword) return;
    navigator.clipboard.writeText(currentPassword).then(() => {
      copyLabel.textContent = '✓ Copied!';
      btnCopy.style.color = '#059669';
      setTimeout(() => {
        copyLabel.textContent = 'Copy';
        btnCopy.style.color = '';
      }, 2000);
    });
  });

  // Copy hash
  copyHashBtn.addEventListener('click', () => {
    const hash = outHash.textContent || '';
    if (!hash || hash.includes('Generate')) return;
    navigator.clipboard.writeText(hash).then(() => {
      copyHashBtn.textContent = '✓ Copied!';
      setTimeout(() => { copyHashBtn.textContent = 'Copy'; }, 2000);
    });
  });

  // Generate on load
  generate();
</script>
