    // Fill remaining slots with systematic two-part composites
    const adj = ['amber','bold','calm','dark','eager','fast','glad','high','icy','just','keen','long','mild','neat','old','pale','quick','rich','safe','tall','urban','vast','warm','young','zesty'];
