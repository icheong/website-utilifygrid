---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'password-hash-evaluator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:#0F172A; margin-bottom:1.25rem;">Password Security Evaluator</h2>

    <div style="position:relative; margin-bottom:1.25rem;">
      <input id="pwd-input" type="password" placeholder="Enter a password to evaluate…"
        style="width:100%; padding:0.75rem 3rem 0.75rem 1rem; border:1.5px solid #E2E8F0; border-radius:0.75rem; font-size:1rem; font-family:'Fira Code',monospace; color:#0F172A; box-sizing:border-box; outline:none; letter-spacing:0.1em;"
        onfocus="this.style.borderColor='#DC2626'" onblur="this.style.borderColor='#E2E8F0'"/>
      <button id="toggle-vis" style="position:absolute; right:0.875rem; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:#94A3B8; font-size:1.1rem; padding:0;">👁</button>
    </div>

    <!-- Strength meter -->
    <div style="margin-bottom:1.25rem;">
      <div style="display:flex; justify-content:space-between; margin-bottom:0.375rem;">
        <span style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em;">Strength</span>
        <span id="strength-label" style="font-size:0.78rem; font-weight:700; color:#94A3B8;">—</span>
      </div>
      <div style="display:flex; gap:0.25rem;">
        {[0,1,2,3,4].map(i => (
          <div id={`bar-${i}`} style="flex:1; height:6px; background:#E2E8F0; border-radius:999px; transition:background 0.3s;"></div>
        ))}
      </div>
    </div>

    <!-- Stat cards -->
    <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:0.75rem; margin-bottom:1.25rem;">
      <div style="background:#FEF2F2; border:1.5px solid #FECACA; border-radius:0.75rem; padding:1rem; text-align:center;">
        <div id="out-entropy" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#DC2626;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#F87171; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.05em;">Entropy (bits)</div>
      </div>
      <div style="background:#F0FDF4; border:1.5px solid #BBF7D0; border-radius:0.75rem; padding:1rem; text-align:center;">
        <div id="out-charset" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#16A34A;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#4ADE80; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.05em;">Charset Size</div>
      </div>
    </div>

    <!-- SHA-256 hash -->
    <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:0.75rem; padding:1rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
        <span style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em;">SHA-256 Hash</span>
        <button id="copy-hash" style="font-size:0.75rem; color:#4F46E5; background:none; border:none; cursor:pointer; font-weight:600;">Copy</button>
      </div>
      <code id="out-hash" style="font-family:'Fira Code',monospace; font-size:0.72rem; color:#0F172A; word-break:break-all; line-height:1.6; display:block;">Enter password above</code>
    </div>

    <div style="margin-top:0.875rem; padding:0.625rem 0.875rem; background:#FFFBEB; border:1px solid #FDE68A; border-radius:0.5rem; font-size:0.78rem; color:#92400E;">
      🔒 Your password never leaves your browser. All hashing is done locally using the Web Crypto API.
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:#0F172A; margin-bottom:0.75rem;">How to use the Password Evaluator</h2>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">Type or paste a password into the field. The strength meter, entropy score, and SHA-256 hash update in real time. All processing happens locally — your password is never sent anywhere. Use the eye icon to toggle visibility.</p>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75;">The SHA-256 hash is useful for verifying password integrity or testing hash outputs in development. Never store passwords as plain SHA-256 hashes in production — use bcrypt, Argon2, or scrypt with salt.</p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:#0F172A; margin-bottom:0.75rem;">How entropy and strength are calculated</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;">
      {[
        ['Charset Size', 'The tool detects which character sets are present: lowercase (26), uppercase (26), digits (10), and symbols (~32). The total available characters is the sum of these pools.'],
        ['Entropy', 'Entropy (bits) = password length × log₂(charset size). Higher entropy means more guessing attempts are needed to crack the password by brute force.'],
        ['Strength Rating', 'Below 28 bits: Very Weak. 28–35: Weak. 36–59: Fair. 60–127: Strong. 128+: Very Strong. These thresholds are based on commonly cited cracking resistance benchmarks.'],
        ['SHA-256 Hash', 'Generated using the browser\'s built-in SubtleCrypto API (window.crypto.subtle.digest). This is a cryptographically secure implementation with no external dependencies.'],
      ].map(([label, desc]) => (
        <div style="background:#fff; border:1px solid #E2E8F0; border-radius:0.625rem; padding:0.875rem 1rem;">
          <div style="font-size:0.82rem; font-weight:700; color:#0F172A; margin-bottom:0.3rem;">{label}</div>
          <p style="font-size:0.82rem; color:#64748B; line-height:1.6; margin:0;">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:#0F172A; margin-bottom:1.25rem;">Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'How many bits of entropy does a password need?', a: 'For personal accounts, 60+ bits is considered strong. For high-value targets (financial, admin accounts), aim for 80+ bits. A 16-character random password using mixed case, digits, and symbols typically exceeds 100 bits. Passphrases of 4–5 common words achieve ~50–65 bits.' },
        { q: 'Is SHA-256 safe for storing passwords?', a: 'No. SHA-256 is a fast hash, meaning attackers can compute billions of hashes per second with modern hardware. Passwords must be hashed with slow, salted algorithms specifically designed for password storage: bcrypt, Argon2id, or scrypt. Never use MD5, SHA-1, or plain SHA-256 for passwords.' },
        { q: 'What makes a password strong?', a: 'Length is the biggest factor — each additional character multiplies the search space exponentially. Using all four character sets (upper, lower, digits, symbols) significantly increases the charset size. Avoiding dictionary words and common substitutions (p@ssw0rd) prevents dictionary attacks.' },
        { q: 'Should I use a password manager?', a: 'Yes. A password manager allows you to use a unique, randomly generated password for every service without needing to remember them. This prevents credential stuffing attacks where leaked passwords from one site are tried on others. Recommended: Bitwarden (open source), 1Password, or KeePass.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:#fff; border:1.5px solid #E2E8F0; border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:#0F172A; margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:#475569; line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  const input  = document.getElementById('pwd-input') as HTMLInputElement;
  const toggle = document.getElementById('toggle-vis')!;

  toggle.addEventListener('click', () => {
    input.type = input.type === 'password' ? 'text' : 'password';
  });

  function getCharsetSize(pwd: string): number {
    let size = 0;
    if (/[a-z]/.test(pwd)) size += 26;
    if (/[A-Z]/.test(pwd)) size += 26;
    if (/[0-9]/.test(pwd)) size += 10;
    if (/[^a-zA-Z0-9]/.test(pwd)) size += 32;
    return size || 1;
  }

  const STRENGTH_LABELS = ['Very Weak','Weak','Fair','Strong','Very Strong'];
  const STRENGTH_COLORS = ['#DC2626','#F59E0B','#EAB308','#16A34A','#059669'];
  const STRENGTH_THRESHOLDS = [0, 28, 36, 60, 128];

  function getStrength(entropy: number): number {
    for (let i = STRENGTH_THRESHOLDS.length - 1; i >= 0; i--) {
      if (entropy >= STRENGTH_THRESHOLDS[i]) return i;
    }
    return 0;
  }

  async function update() {
    const pwd = input.value;
    if (!pwd) {
      document.getElementById('out-entropy')!.textContent = '—';
      document.getElementById('out-charset')!.textContent = '—';
      document.getElementById('out-hash')!.textContent    = 'Enter password above';
      document.getElementById('strength-label')!.textContent = '—';
      for (let i = 0; i < 5; i++) (document.getElementById('bar-' + i) as HTMLElement).style.background = '#E2E8F0';
      return;
    }

    const charset  = getCharsetSize(pwd);
    const entropy  = Math.round(pwd.length * Math.log2(charset));
    const strength = getStrength(entropy);

    document.getElementById('out-entropy')!.textContent = entropy + ' bits';
    document.getElementById('out-charset')!.textContent = charset + ' chars';
    document.getElementById('strength-label')!.style.color = STRENGTH_COLORS[strength];
    document.getElementById('strength-label')!.textContent  = STRENGTH_LABELS[strength];

    for (let i = 0; i < 5; i++) {
      (document.getElementById('bar-' + i) as HTMLElement).style.background =
        i <= strength ? STRENGTH_COLORS[strength] : '#E2E8F0';
    }

    // SHA-256
    try {
      const enc    = new TextEncoder();
      const data   = enc.encode(pwd);
      const hash   = await window.crypto.subtle.digest('SHA-256', data);
      const hex    = Array.from(new Uint8Array(hash)).map(b => b.toString(16).padStart(2,'0')).join('');
      document.getElementById('out-hash')!.textContent = hex;
    } catch {
      document.getElementById('out-hash')!.textContent = 'SHA-256 not available';
    }
  }

  document.getElementById('copy-hash')?.addEventListener('click', () => {
    const hash = document.getElementById('out-hash')!.textContent || '';
    navigator.clipboard.writeText(hash);
    const btn = document.getElementById('copy-hash')!;
    btn.textContent = '✓ Copied!';
    setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
  });

  input.addEventListener('input', update);
</script>
