      for (let n = 0; n < nouns.length && result.length < 7776; n++) {
        const word = adj[a] + nouns[n];
        if (!seen.has(word)) { seen.add(word); result.push(word); }
      }
    }
    // Final numeric suffix fill
    for (let i = 0; result.length < 7776; i++) {
      const word = `word${i}`;
      if (!seen.has(word)) { seen.add(word); result.push(word); }
