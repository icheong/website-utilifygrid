  const PP_SYMBOLS = '!@#$%^&*';

  function cryptoRandInt(max: number): number {
    const arr = new Uint32Array(1);
    const limit = Math.floor(0xFFFFFFFF / max) * max;
    do { crypto.getRandomValues(arr); } while (arr[0] > limit);
    return arr[0] % max;
  }

  function generatePassphrase(): { words: string[]; plain: string; separator: string } {
    const wordCount  = parseInt((document.getElementById('pp-ctrl-words') as HTMLInputElement).value);
    const capitalize = (document.getElementById('pp-chk-capitalize') as HTMLInputElement).checked;
    const addNumber  = (document.getElementById('pp-chk-number')     as HTMLInputElement).checked;
    const addSymbol  = (document.getElementById('pp-chk-symbol')     as HTMLInputElement).checked;

    // Separator
    const activeSep  = document.querySelector('.active-sep') as HTMLElement | null;
    const separator  = activeSep?.dataset.sep === 'none' ? '' : (activeSep?.dataset.sep ?? '-');

    // Pick words
    const words: string[] = [];
    for (let i = 0; i < wordCount; i++) {
      let w = EFF_WORDS[cryptoRandInt(EFF_WORDS.length)];
      if (capitalize) w = w[0].toUpperCase() + w.slice(1);
      words.push(w);
    }

    // Optional extras
    if (addNumber) {
      const n = cryptoRandInt(90) + 10; // 10–99
      words.push(String(n));
    }
    if (addSymbol) {
      words.push(PP_SYMBOLS[cryptoRandInt(PP_SYMBOLS.length)]);
    }

    const plain = words.join(separator);
    return { words, plain, separator };
  }

  function passphraseEntropy(): number {
    const wordCount = parseInt((document.getElementById('pp-ctrl-words') as HTMLInputElement).value);
    const addNumber = (document.getElementById('pp-chk-number') as HTMLInputElement).checked;
    const addSymbol = (document.getElementById('pp-chk-symbol') as HTMLInputElement).checked;
    // Each word: log2(7776), number: log2(90), symbol: log2(8)
    let bits = wordCount * Math.log2(7776);
    if (addNumber) bits += Math.log2(90);
    if (addSymbol) bits += Math.log2(PP_SYMBOLS.length);
    return Math.round(bits);
  }

  // Pastel colours for word highlighting
  const WORD_PALETTES = ['#1D4ED8','#059669','#DC2626','#D97706','#7C3AED','#0891B2'];

  function renderPassphrase(result: { words: string[]; plain: string; separator: string }) {
    const box = document.getElementById('pp-output-box')!;
    const placeholder = document.getElementById('pp-output-placeholder');
    if (placeholder) placeholder.style.display = 'none';

    // Clear previous word spans (keep placeholder)
    box.querySelectorAll('.pp-word').forEach(el => el.remove());

    const sep = result.separator;
    result.words.forEach((word, idx) => {
      const span = document.createElement('span');
      span.className = 'pp-word';
      span.textContent = word;
      const colorIdx = idx % WORD_PALETTES.length;
      span.style.cssText = `font-family:'Fira Code',monospace; font-size:0.95rem; font-weight:600; color:${WORD_PALETTES[colorIdx]}; letter-spacing:0.02em;`;
      box.appendChild(span);
      if (sep && idx < result.words.length - 1) {
        const sepSpan = document.createElement('span');
        sepSpan.textContent = sep;
        sepSpan.style.cssText = 'font-family:\'Fira Code\',monospace; font-size:0.95rem; color:var(--text-muted); font-weight:400;';
        box.appendChild(sepSpan);
      }
    });
  }

  async function updatePpMetrics(plain: string) {
    const entropy = passphraseEntropy();
    const { color } = updateStrengthBars('pp-', entropy);
    const wordCount = parseInt((document.getElementById('pp-ctrl-words') as HTMLInputElement).value);

    const ppEntropy = document.getElementById('pp-out-entropy')!;
    const ppWords   = document.getElementById('pp-out-words')!;
    const ppCrack   = document.getElementById('pp-out-crack')!;
    const ppHash    = document.getElementById('pp-out-hash')!;

    ppEntropy.textContent = `${entropy}`;
    ppEntropy.style.color = color;
    ppWords.textContent   = `${wordCount}`;
    ppWords.style.color   = color;
    ppCrack.textContent   = formatCrackTime(Math.pow(2, entropy));
    ppCrack.style.color   = color;
    ppHash.textContent    = plain ? await sha256hex(plain) : 'Generate a passphrase to see its hash';
  }

  let currentPassphrase = '';

  function generatePP() {
    const result = generatePassphrase();
    currentPassphrase = result.plain;
    renderPassphrase(result);
    updatePpMetrics(result.plain);
  }

  document.getElementById('pp-btn-generate')!.addEventListener('click', generatePP);

  // Re-generate on control changes
  ['pp-ctrl-words','pp-chk-capitalize','pp-chk-number','pp-chk-symbol'].forEach(id => {
    const el = document.getElementById(id)!;
    el.addEventListener('change', () => { if (currentPassphrase) generatePP(); });
    el.addEventListener('input',  () => {
      if (id === 'pp-ctrl-words') {
        document.getElementById('pp-length-display')!.textContent = (el as HTMLInputElement).value;
      }
      // Update entropy preview without regenerating words
      if (currentPassphrase) updatePpMetrics(currentPassphrase);
    });
  });

  // Separator buttons
  document.querySelectorAll('.sep-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.sep-btn').forEach(b => {
        (b as HTMLElement).style.borderColor = 'var(--border)';
        (b as HTMLElement).style.background  = 'var(--bg-surface-2)';
        (b as HTMLElement).style.color       = 'var(--text-secondary)';
        b.classList.remove('active-sep');
      });
      (btn as HTMLElement).style.borderColor = '#4F46E5';
      (btn as HTMLElement).style.background  = 'rgba(79,70,229,0.08)';
      (btn as HTMLElement).style.color       = '#4F46E5';
      btn.classList.add('active-sep');
      if (currentPassphrase) generatePP();
    });
  });

  // Copy passphrase
  document.getElementById('pp-btn-copy')!.addEventListener('click', () => {
    if (!currentPassphrase) return;
    navigator.clipboard.writeText(currentPassphrase).then(() => {
      const lbl = document.getElementById('pp-copy-label')!;
      lbl.textContent = '✓ Copied!';
      (document.getElementById('pp-btn-copy') as HTMLElement).style.color = '#059669';
      setTimeout(() => { lbl.textContent = 'Copy'; (document.getElementById('pp-btn-copy') as HTMLElement).style.color = ''; }, 2000);
    });
  });

  // Copy passphrase hash
  document.getElementById('pp-copy-hash')!.addEventListener('click', () => {
    const hash = document.getElementById('pp-out-hash')!.textContent || '';
    if (!hash || hash.includes('Generate')) return;
    navigator.clipboard.writeText(hash).then(() => {
      const btn = document.getElementById('pp-copy-hash')!;
      btn.textContent = '✓ Copied!';
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  });

  // ── Initialise ─────────────────────────────────────────────
  setTab('password');
  generatePwd();
</script>
