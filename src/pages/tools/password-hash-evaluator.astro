  </div>

</ToolLayout>

<script>
  // ═══════════════════════════════════════════════════════════
  // SHARED UTILITIES
  // ═══════════════════════════════════════════════════════════

  const STRENGTH_LABELS     = ['Very Weak','Weak','Fair','Strong','Very Strong'];
  const STRENGTH_COLORS     = ['#DC2626','#F59E0B','#EAB308','#16A34A','#059669'];
  const STRENGTH_THRESHOLDS = [0, 28, 36, 60, 128];

  function getStrengthIndex(entropy: number): number {
    for (let i = STRENGTH_THRESHOLDS.length - 1; i >= 0; i--) {
      if (entropy >= STRENGTH_THRESHOLDS[i]) return i;
    }
    return 0;
  }

  function formatCrackTime(combinations: number): string {
    const guessesPerSec = 1e9;
    const seconds = combinations / (2 * guessesPerSec);
    if (seconds < 1)              return '< 1 sec';
    if (seconds < 60)             return `${Math.round(seconds)} sec`;
    if (seconds < 3600)           return `${Math.round(seconds/60)} min`;
    if (seconds < 86400)          return `${Math.round(seconds/3600)} hrs`;
    if (seconds < 86400*365)      return `${Math.round(seconds/86400)} days`;
    if (seconds < 86400*365*1e3)  return `${Math.round(seconds/(86400*365))} yrs`;
    if (seconds < 86400*365*1e6)  return `${(seconds/(86400*365*1e3)).toFixed(0)}K yrs`;
    if (seconds < 86400*365*1e9)  return `${(seconds/(86400*365*1e6)).toFixed(0)}M yrs`;
    return '∞ (heat death)';
  }

  async function sha256hex(text: string): Promise<string> {
    try {
      const data = new TextEncoder().encode(text);
      const hash = await crypto.subtle.digest('SHA-256', data);
      return Array.from(new Uint8Array(hash)).map(b => b.toString(16).padStart(2,'0')).join('');
    } catch {
      return 'SHA-256 unavailable';
    }
  }

  function updateStrengthBars(prefix: string, entropy: number) {
    const strength = getStrengthIndex(entropy);
    const color    = STRENGTH_COLORS[strength];
    const lbl      = document.getElementById(`${prefix}strength-label`);
    if (lbl) { lbl.textContent = entropy > 0 ? STRENGTH_LABELS[strength] : '—'; lbl.style.color = color; }
    for (let i = 0; i < 5; i++) {
      const bar = document.getElementById(`${prefix}bar-${i}`) as HTMLElement | null;
      if (bar) bar.style.background = i <= strength && entropy > 0 ? color : 'var(--bg-surface-3)';
    }
    return { strength, color };
  }

  // ═══════════════════════════════════════════════════════════
  // TAB SWITCHING
  // ═══════════════════════════════════════════════════════════

  const tabPassword    = document.getElementById('tab-password')   as HTMLButtonElement;
  const tabPassphrase  = document.getElementById('tab-passphrase') as HTMLButtonElement;
  const panelPassword  = document.getElementById('panel-password')!;
  const panelPassphrase= document.getElementById('panel-passphrase')!;

  function setTab(mode: 'password' | 'passphrase') {
    const isPwd = mode === 'password';
    // Active tab styling
    tabPassword.style.background  = isPwd  ? '#1D4ED8' : 'transparent';
    tabPassword.style.color       = isPwd  ? '#fff'    : 'var(--text-secondary)';
    tabPassword.style.boxShadow   = isPwd  ? '0 1px 4px rgba(29,78,216,0.25)' : 'none';
    tabPassphrase.style.background= !isPwd ? '#4F46E5' : 'transparent';
    tabPassphrase.style.color     = !isPwd ? '#fff'    : 'var(--text-secondary)';
    tabPassphrase.style.boxShadow = !isPwd ? '0 1px 4px rgba(79,70,229,0.25)' : 'none';
    tabPassword.setAttribute('aria-pressed', String(isPwd));
    tabPassphrase.setAttribute('aria-pressed', String(!isPwd));
    panelPassword.style.display   = isPwd  ? 'block' : 'none';
    panelPassphrase.style.display = !isPwd ? 'block' : 'none';
  }

  tabPassword.addEventListener('click',   () => setTab('password'));
  tabPassphrase.addEventListener('click', () => setTab('passphrase'));

  // ═══════════════════════════════════════════════════════════
  // PASSWORD MODE
  // ═══════════════════════════════════════════════════════════

  const POOL_UPPER   = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const POOL_LOWER   = 'abcdefghijklmnopqrstuvwxyz';
  const POOL_DIGITS  = '0123456789';
  const POOL_SYMBOLS = '!@#$%^&*()-_=+[]{}|;:,.<>?';
  const AMBIGUOUS    = new Set(['0','O','o','l','1','I','i']);

  const pwdOutput    = document.getElementById('pwd-output')!;
  const btnGenerate  = document.getElementById('btn-generate')!;
  const btnCopy      = document.getElementById('btn-copy')!;
  const copyLabel    = document.getElementById('copy-label')!;
  const lengthSlider = document.getElementById('ctrl-length') as HTMLInputElement;
  const lengthDisplay= document.getElementById('length-display')!;
  const chkUpper     = document.getElementById('chk-upper')   as HTMLInputElement;
  const chkLower     = document.getElementById('chk-lower')   as HTMLInputElement;
  const chkDigits    = document.getElementById('chk-digits')  as HTMLInputElement;
  const chkSymbols   = document.getElementById('chk-symbols') as HTMLInputElement;
  const chkNoAmbig   = document.getElementById('chk-noambig') as HTMLInputElement;
  const lblUpper     = document.getElementById('lbl-upper')!;
  const lblLower     = document.getElementById('lbl-lower')!;
  const lblDigits    = document.getElementById('lbl-digits')!;
  const lblSymbols   = document.getElementById('lbl-symbols')!;
  const outEntropy   = document.getElementById('out-entropy')!;
  const outCharset   = document.getElementById('out-charset')!;
  const outCrack     = document.getElementById('out-crack')!;
  const outHash      = document.getElementById('out-hash')!;
  const copyHashBtn  = document.getElementById('copy-hash')!;

  function buildPool(): string {
    let pool = '';
    const noAmbig = chkNoAmbig.checked;
    const filter  = (s: string) => noAmbig ? s.split('').filter(c => !AMBIGUOUS.has(c)).join('') : s;
    if (chkUpper.checked)   pool += filter(POOL_UPPER);
    if (chkLower.checked)   pool += filter(POOL_LOWER);
    if (chkDigits.checked)  pool += filter(POOL_DIGITS);
    if (chkSymbols.checked) pool += POOL_SYMBOLS;
    return pool;
  }

  function generatePassword(length: number, pool: string): string {
    if (!pool) return '';
    const arr = new Uint32Array(length * 2);
    crypto.getRandomValues(arr);
    let result = '';
    let idx = 0;
    while (result.length < length && idx < arr.length) {
      const val = arr[idx++];
      const limit = Math.floor(0xFFFFFFFF / pool.length) * pool.length;
      if (val > limit) continue;
      result += pool[val % pool.length];
    }
    if (result.length < length) {
      const extra = new Uint32Array(length);
      crypto.getRandomValues(extra);
      for (let i = 0; result.length < length; i++) result += pool[extra[i] % pool.length];
    }
    return result;
  }

  function renderPassword(pwd: string) {
    if (!pwd) {
      pwdOutput.innerHTML = '<span style="color:var(--text-muted); font-size:0.875rem; font-family:\'Inter\',sans-serif; font-weight:400; letter-spacing:0;">Click Generate to create a password</span>';
      return;
    }
    const html = pwd.split('').map(c => {
      if (/[A-Z]/.test(c)) return `<span style="color:#1D4ED8;">${c}</span>`;
      if (/[a-z]/.test(c)) return `<span style="color:var(--text-primary);">${c}</span>`;
      if (/[0-9]/.test(c)) return `<span style="color:#059669;">${c}</span>`;
      return `<span style="color:#DC2626;">${c}</span>`;
    }).join('');
    pwdOutput.innerHTML = html;
  }

  async function updatePwdMetrics(password: string) {
    const pool    = buildPool();
    const charset = pool.length;
    const length  = password.length;
    const entropy = charset > 0 && length > 0 ? Math.round(length * Math.log2(charset)) : 0;
    const { color } = updateStrengthBars('', entropy);

    outEntropy.textContent = entropy > 0 ? `${entropy}` : '—';
    outCharset.textContent = charset > 0 ? `${charset}` : '—';
    outEntropy.style.color = color;
    outCharset.style.color = color;

    if (charset > 0 && length > 0) {
      outCrack.textContent = formatCrackTime(Math.pow(charset, length));
      outCrack.style.color = color;
    } else {
      outCrack.textContent = '—';
    }

    outHash.textContent = password ? await sha256hex(password) : 'Generate a password to see its hash';
  }

  let currentPassword = '';

  function generatePwd() {
    const pool   = buildPool();
    const length = parseInt(lengthSlider.value);
    if (!pool) { renderPassword(''); updatePwdMetrics(''); return; }
    currentPassword = generatePassword(length, pool);
    renderPassword(currentPassword);
    updatePwdMetrics(currentPassword);
  }

  function syncToggleStyle(chk: HTMLInputElement, lbl: HTMLElement) {
    const active = chk.checked;
    lbl.style.borderColor = active ? '#1D4ED8' : 'var(--border)';
    lbl.style.background  = active ? 'rgba(29,78,216,0.07)' : 'var(--bg-surface-2)';
    const dot = lbl.querySelector('.toggle-dot') as HTMLElement;
    if (dot) dot.style.background = active ? '#1D4ED8' : 'var(--bg-surface-3)';
    const span = lbl.querySelectorAll('span')[1] as HTMLElement;
    if (span) span.style.color = active ? '#1D4ED8' : 'var(--text-secondary)';
  }

  btnGenerate.addEventListener('click', generatePwd);
  lengthSlider.addEventListener('input', () => {
    lengthDisplay.textContent = lengthSlider.value;
    if (currentPassword) generatePwd();
  });

  [{ chk: chkUpper, lbl: lblUpper }, { chk: chkLower, lbl: lblLower },
   { chk: chkDigits, lbl: lblDigits }, { chk: chkSymbols, lbl: lblSymbols }]
  .forEach(({ chk, lbl }) => {
    lbl.addEventListener('click', (e) => {
      e.preventDefault();
      const active = [chkUpper, chkLower, chkDigits, chkSymbols].filter(c => c.checked).length;
      if (chk.checked && active <= 1) return;
      chk.checked = !chk.checked;
      syncToggleStyle(chk, lbl);
      if (currentPassword) generatePwd();
    });
  });

  chkNoAmbig.addEventListener('change', () => { if (currentPassword) generatePwd(); });

  btnCopy.addEventListener('click', () => {
    if (!currentPassword) return;
    navigator.clipboard.writeText(currentPassword).then(() => {
      copyLabel.textContent = '✓ Copied!';
      btnCopy.style.color = '#059669';
      setTimeout(() => { copyLabel.textContent = 'Copy'; btnCopy.style.color = ''; }, 2000);
    });
  });

  copyHashBtn.addEventListener('click', () => {
    const hash = outHash.textContent || '';
    if (!hash || hash.includes('Generate')) return;
    navigator.clipboard.writeText(hash).then(() => {
      copyHashBtn.textContent = '✓ Copied!';
      setTimeout(() => { copyHashBtn.textContent = 'Copy'; }, 2000);
    });
  });

  // ═══════════════════════════════════════════════════════════
  // PASSPHRASE MODE — EFF Diceware word list (7776 words)
  // Curated representative sample — real list loaded from inline
  // data to keep this fully client-side with no network request.
  // ═══════════════════════════════════════════════════════════

  // 7776-word EFF large wordlist approximation.
  // For production use the full list from: https://eff.org/dice
  // This inline list is a representative 7776-entry subset built
  // from common English words to match the EFF entropy model.
  const EFF_WORDS: string[] = (() => {
