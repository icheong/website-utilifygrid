---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'password-hash-evaluator')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">
      Password &amp; Passphrase Security Evaluator
    </h2>

    <!-- ── Mode tabs ── -->
    <div style="display:flex; gap:0; margin-bottom:1.5rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.25rem;">
      <button id="tab-password"
        style="flex:1; padding:0.55rem 0.75rem; border-radius:0.5rem; border:none; cursor:pointer; font-family:'Sora',sans-serif; font-size:0.82rem; font-weight:700; letter-spacing:0.02em; transition:all 0.2s; background:#1D4ED8; color:#fff; box-shadow:0 1px 4px rgba(29,78,216,0.25);"
        aria-pressed="true"
      >
        🔑 Random Password
      </button>
      <button id="tab-passphrase"
        style="flex:1; padding:0.55rem 0.75rem; border-radius:0.5rem; border:none; cursor:pointer; font-family:'Sora',sans-serif; font-size:0.82rem; font-weight:700; letter-spacing:0.02em; transition:all 0.2s; background:transparent; color:var(--text-secondary);"
        aria-pressed="false"
      >
        📖 Passphrase
      </button>
    </div>

    <!-- ══════════════════════════════
         PASSWORD PANEL
    ══════════════════════════════ -->
    <div id="panel-password">

      <!-- ── Generated output ── -->
      <div style="position:relative; margin-bottom:1.25rem;">
        <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.875rem; padding:1rem 3.5rem 1rem 1.25rem; min-height:3.25rem; display:flex; align-items:center;">
          <code id="pwd-output"
            style="font-family:'Fira Code',monospace; font-size:1rem; font-weight:500; color:var(--text-primary); letter-spacing:0.04em; word-break:break-all; flex:1; line-height:1.5;">
            Click Generate to create a password
          </code>
        </div>
        <button id="btn-copy"
          title="Copy to clipboard"
          style="position:absolute; right:0.75rem; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:var(--text-muted); padding:0.35rem; border-radius:0.375rem; transition:color 0.15s, background 0.15s; display:flex; align-items:center; gap:0.3rem; font-size:0.75rem; font-weight:600;"
          onmouseover="this.style.color='#1D4ED8';this.style.background='rgba(29,78,216,0.08)';"
          onmouseout="this.style.color='var(--text-muted)';this.style.background='none';"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
          </svg>
          <span id="copy-label">Copy</span>
        </button>
      </div>

      <!-- ── Strength meter ── -->
      <div style="margin-bottom:1.5rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
          <span style="font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.07em;">Password Strength</span>
          <span id="strength-label" style="font-size:0.78rem; font-weight:700; color:var(--text-muted); transition:color 0.3s;">—</span>
        </div>
        <div style="display:flex; gap:3px;">
          <div id="bar-0" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
          <div id="bar-1" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
          <div id="bar-2" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
          <div id="bar-3" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
          <div id="bar-4" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
        </div>
      </div>

      <!-- ── Stat cards ── -->
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.625rem; margin-bottom:1.5rem;">
        <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.875rem 0.75rem; text-align:center;">
          <div id="out-entropy" style="font-family:'Sora',sans-serif; font-size:1.35rem; font-weight:700; color:var(--text-primary); transition:color 0.3s;">—</div>
          <div style="font-size:0.67rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.05em;">Entropy (bits)</div>
        </div>
        <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.875rem 0.75rem; text-align:center;">
          <div id="out-charset" style="font-family:'Sora',sans-serif; font-size:1.35rem; font-weight:700; color:var(--text-primary); transition:color 0.3s;">—</div>
          <div style="font-size:0.67rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.05em;">Charset Size</div>
        </div>
        <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.875rem 0.75rem; text-align:center;">
          <div id="out-crack" style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); transition:color 0.3s; line-height:1.2; padding-top:0.15rem;">—</div>
          <div style="font-size:0.67rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.05em;">To Crack (1B/s)</div>
        </div>
      </div>

      <div style="border-top:1px solid var(--border); margin-bottom:1.25rem;"></div>

      <!-- ── Controls ── -->
      <div style="display:flex; flex-direction:column; gap:1rem; margin-bottom:1.25rem;">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
            <label for="ctrl-length" style="font-size:0.82rem; font-weight:600; color:var(--text-secondary);">Length</label>
            <span id="length-display" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#1D4ED8; min-width:2.5rem; text-align:right;">16</span>
          </div>
          <input id="ctrl-length" type="range" min="8" max="64" value="16"
            style="width:100%; accent-color:#1D4ED8; cursor:pointer;" />
        </div>

        <div>
          <div style="font-size:0.82rem; font-weight:600; color:var(--text-secondary); margin-bottom:0.625rem;">Include Characters</div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
            <label id="lbl-upper" class="char-toggle active-toggle" style="display:flex; align-items:center; gap:0.625rem; padding:0.6rem 0.875rem; border-radius:0.625rem; cursor:pointer; border:1.5px solid #1D4ED8; background:rgba(29,78,216,0.07); transition:all 0.15s; user-select:none;">
              <input id="chk-upper" type="checkbox" checked style="display:none;" />
              <span class="toggle-dot" style="width:16px; height:16px; border-radius:50%; background:#1D4ED8; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M2 5l2.5 2.5L8 3" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span style="font-size:0.8rem; font-weight:600; color:#1D4ED8; font-family:'Fira Code',monospace;">A–Z</span>
              <span style="font-size:0.72rem; color:var(--text-muted); margin-left:auto;">+26</span>
            </label>
            <label id="lbl-lower" class="char-toggle active-toggle" style="display:flex; align-items:center; gap:0.625rem; padding:0.6rem 0.875rem; border-radius:0.625rem; cursor:pointer; border:1.5px solid #1D4ED8; background:rgba(29,78,216,0.07); transition:all 0.15s; user-select:none;">
              <input id="chk-lower" type="checkbox" checked style="display:none;" />
              <span class="toggle-dot" style="width:16px; height:16px; border-radius:50%; background:#1D4ED8; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M2 5l2.5 2.5L8 3" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span style="font-size:0.8rem; font-weight:600; color:#1D4ED8; font-family:'Fira Code',monospace;">a–z</span>
              <span style="font-size:0.72rem; color:var(--text-muted); margin-left:auto;">+26</span>
            </label>
            <label id="lbl-digits" class="char-toggle active-toggle" style="display:flex; align-items:center; gap:0.625rem; padding:0.6rem 0.875rem; border-radius:0.625rem; cursor:pointer; border:1.5px solid #1D4ED8; background:rgba(29,78,216,0.07); transition:all 0.15s; user-select:none;">
              <input id="chk-digits" type="checkbox" checked style="display:none;" />
              <span class="toggle-dot" style="width:16px; height:16px; border-radius:50%; background:#1D4ED8; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M2 5l2.5 2.5L8 3" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span style="font-size:0.8rem; font-weight:600; color:#1D4ED8; font-family:'Fira Code',monospace;">0–9</span>
              <span style="font-size:0.72rem; color:var(--text-muted); margin-left:auto;">+10</span>
            </label>
            <label id="lbl-symbols" class="char-toggle active-toggle" style="display:flex; align-items:center; gap:0.625rem; padding:0.6rem 0.875rem; border-radius:0.625rem; cursor:pointer; border:1.5px solid #1D4ED8; background:rgba(29,78,216,0.07); transition:all 0.15s; user-select:none;">
              <input id="chk-symbols" type="checkbox" checked style="display:none;" />
              <span class="toggle-dot" style="width:16px; height:16px; border-radius:50%; background:#1D4ED8; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M2 5l2.5 2.5L8 3" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span style="font-size:0.8rem; font-weight:600; color:#1D4ED8; font-family:'Fira Code',monospace;">!@#…</span>
              <span style="font-size:0.72rem; color:var(--text-muted); margin-left:auto;">+32</span>
            </label>
          </div>
        </div>

        <label style="display:flex; align-items:center; gap:0.75rem; cursor:pointer; user-select:none; padding:0.625rem 0.875rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem;">
          <input id="chk-noambig" type="checkbox"
            style="width:1rem; height:1rem; accent-color:#1D4ED8; cursor:pointer;" />
          <div>
            <div style="font-size:0.82rem; font-weight:600; color:var(--text-secondary);">Avoid ambiguous characters</div>
            <div style="font-size:0.72rem; color:var(--text-muted); margin-top:0.1rem;">Excludes: 0 O o l 1 I i</div>
          </div>
        </label>
      </div>

      <button id="btn-generate"
        style="width:100%; padding:0.75rem 1.5rem; background:#1D4ED8; color:#fff; border:none; border-radius:0.625rem; font-family:'Sora',sans-serif; font-size:0.95rem; font-weight:700; cursor:pointer; transition:background 0.15s, transform 0.1s; letter-spacing:0.02em; display:flex; align-items:center; justify-content:center; gap:0.5rem;"
        onmouseover="this.style.background='#1E3A8A';"
        onmouseout="this.style.background='#1D4ED8';"
        onmousedown="this.style.transform='scale(0.98)';"
        onmouseup="this.style.transform='scale(1)';"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
        </svg>
        Generate Password
      </button>

      <!-- ── SHA-256 hash ── -->
      <div style="margin-top:1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem; padding:1rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
          <span style="font-size:0.75rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em;">SHA-256 Hash</span>
          <button id="copy-hash" style="font-size:0.75rem; color:#4F46E5; background:none; border:none; cursor:pointer; font-weight:600; padding:0; transition:color 0.15s;"
            onmouseover="this.style.color='#1D4ED8';" onmouseout="this.style.color='#4F46E5';">Copy</button>
        </div>
        <code id="out-hash" style="font-family:'Fira Code',monospace; font-size:0.68rem; color:var(--text-secondary); word-break:break-all; line-height:1.6; display:block;">Generate a password to see its hash</code>
      </div>

      <!-- ── Privacy notice ── -->
      <div style="margin-top:0.875rem; padding:0.625rem 0.875rem; background:rgba(245,158,11,0.08); border:1px solid rgba(245,158,11,0.3); border-radius:0.5rem; font-size:0.78rem; color:var(--text-secondary); display:flex; align-items:flex-start; gap:0.5rem;">
        <span style="flex-shrink:0; margin-top:0.05rem;">🔒</span>
        <span>Passwords are generated and hashed entirely in your browser using <code style="font-family:'Fira Code',monospace; font-size:0.75rem; color:var(--text-primary);">crypto.getRandomValues()</code> and the Web Crypto API. Nothing is sent anywhere.</span>
      </div>
    </div>

    <!-- ══════════════════════════════
         PASSPHRASE PANEL
    ══════════════════════════════ -->
    <div id="panel-passphrase" style="display:none;">

      <!-- ── Passphrase output ── -->
      <div style="position:relative; margin-bottom:1.25rem;">
        <div id="pp-output-box" style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 3.5rem 1.1rem 1.25rem; min-height:3.75rem; display:flex; align-items:center; flex-wrap:wrap; gap:0.3rem;">
          <span id="pp-output-placeholder" style="font-family:'Fira Code',monospace; font-size:0.92rem; font-weight:500; color:var(--text-muted);">Click Generate to create a passphrase</span>
        </div>
        <button id="pp-btn-copy"
          title="Copy to clipboard"
          style="position:absolute; right:0.75rem; top:0.9rem; background:none; border:none; cursor:pointer; color:var(--text-muted); padding:0.35rem; border-radius:0.375rem; transition:color 0.15s, background 0.15s; display:flex; align-items:center; gap:0.3rem; font-size:0.75rem; font-weight:600;"
          onmouseover="this.style.color='#1D4ED8';this.style.background='rgba(29,78,216,0.08)';"
          onmouseout="this.style.color='var(--text-muted)';this.style.background='none';"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
          </svg>
          <span id="pp-copy-label">Copy</span>
        </button>
      </div>

      <!-- ── Strength meter ── -->
      <div style="margin-bottom:1.5rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
          <span style="font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.07em;">Passphrase Strength</span>
          <span id="pp-strength-label" style="font-size:0.78rem; font-weight:700; color:var(--text-muted); transition:color 0.3s;">—</span>
        </div>
        <div style="display:flex; gap:3px;">
          <div id="pp-bar-0" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
          <div id="pp-bar-1" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
          <div id="pp-bar-2" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
          <div id="pp-bar-3" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
          <div id="pp-bar-4" style="flex:1; height:7px; border-radius:999px; background:var(--bg-surface-3); transition:background 0.35s;"></div>
        </div>
      </div>

      <!-- ── Passphrase stat cards ── -->
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.625rem; margin-bottom:1.5rem;">
        <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.875rem 0.75rem; text-align:center;">
          <div id="pp-out-entropy" style="font-family:'Sora',sans-serif; font-size:1.35rem; font-weight:700; color:var(--text-primary); transition:color 0.3s;">—</div>
          <div style="font-size:0.67rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.05em;">Entropy (bits)</div>
        </div>
        <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.875rem 0.75rem; text-align:center;">
          <div id="pp-out-words" style="font-family:'Sora',sans-serif; font-size:1.35rem; font-weight:700; color:var(--text-primary); transition:color 0.3s;">—</div>
          <div style="font-size:0.67rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.05em;">Word Count</div>
        </div>
        <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.875rem 0.75rem; text-align:center;">
          <div id="pp-out-crack" style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); transition:color 0.3s; line-height:1.2; padding-top:0.15rem;">—</div>
          <div style="font-size:0.67rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.05em;">To Crack (1B/s)</div>
        </div>
      </div>

      <div style="border-top:1px solid var(--border); margin-bottom:1.25rem;"></div>

      <!-- ── Passphrase controls ── -->
      <div style="display:flex; flex-direction:column; gap:1rem; margin-bottom:1.25rem;">

        <!-- Word count slider -->
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
            <label for="pp-ctrl-words" style="font-size:0.82rem; font-weight:600; color:var(--text-secondary);">Number of Words</label>
            <span id="pp-length-display" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#1D4ED8; min-width:2.5rem; text-align:right;">5</span>
          </div>
          <input id="pp-ctrl-words" type="range" min="3" max="10" value="5"
            style="width:100%; accent-color:#1D4ED8; cursor:pointer;" />
          <div style="display:flex; justify-content:space-between; margin-top:0.25rem;">
            <span style="font-size:0.68rem; color:var(--text-muted);">3 words (~38 bits)</span>
            <span style="font-size:0.68rem; color:var(--text-muted);">10 words (~128 bits)</span>
          </div>
        </div>

        <!-- Separator picker -->
        <div>
          <div style="font-size:0.82rem; font-weight:600; color:var(--text-secondary); margin-bottom:0.625rem;">Word Separator</div>
          <div style="display:grid; grid-template-columns:repeat(5,1fr); gap:0.4rem;" id="sep-group">
            <button class="sep-btn active-sep" data-sep="-"  style="padding:0.45rem; border-radius:0.5rem; border:1.5px solid #1D4ED8; background:rgba(29,78,216,0.07); color:#1D4ED8; font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; cursor:pointer; transition:all 0.15s;">-</button>
            <button class="sep-btn" data-sep="."  style="padding:0.45rem; border-radius:0.5rem; border:1.5px solid var(--border); background:var(--bg-surface-2); color:var(--text-secondary); font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; cursor:pointer; transition:all 0.15s;">.</button>
            <button class="sep-btn" data-sep="_"  style="padding:0.45rem; border-radius:0.5rem; border:1.5px solid var(--border); background:var(--bg-surface-2); color:var(--text-secondary); font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; cursor:pointer; transition:all 0.15s;">_</button>
            <button class="sep-btn" data-sep=" "  style="padding:0.45rem; border-radius:0.5rem; border:1.5px solid var(--border); background:var(--bg-surface-2); color:var(--text-secondary); font-family:'Fira Code',monospace; font-size:0.8rem; font-weight:700; cursor:pointer; transition:all 0.15s;">␣</button>
            <button class="sep-btn" data-sep="none" style="padding:0.45rem; border-radius:0.5rem; border:1.5px solid var(--border); background:var(--bg-surface-2); color:var(--text-secondary); font-family:'Fira Code',monospace; font-size:0.75rem; font-weight:700; cursor:pointer; transition:all 0.15s;">none</button>
          </div>
        </div>

        <!-- Options row -->
        <div style="display:flex; flex-direction:column; gap:0.5rem;">
          <label style="display:flex; align-items:center; gap:0.75rem; cursor:pointer; user-select:none; padding:0.6rem 0.875rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem;">
