---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'hydration-fluid-loss-calculator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Hydration &amp; Fluid Loss Calculator</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.25rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Pre-workout Weight (kg)</label>
        <input id="pre-wt" type="number" value="75" min="30" max="300" step="0.1"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Post-workout Weight (kg)</label>
        <input id="post-wt" type="number" value="74.2" min="30" max="300" step="0.1"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Exercise Duration (min)</label>
        <input id="duration" type="number" value="60" min="5" max="600" step="5"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Fluids Consumed (ml)</label>
        <input id="consumed" type="number" value="500" min="0" max="5000" step="50"
          class="input-themed"/>
      </div>
    </div>

    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.75rem; margin-bottom:1.25rem;">
      <div class="result-card" style="background:#EFF6FF; border-color:#BFDBFE; text-align:center;">
        <div id="out-lost" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#1D4ED8;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#60A5FA; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.04em;">Total Fluid Lost (L)</div>
      </div>
      <div class="result-card" style="background:#F0F9FF; border-color:#BAE6FD; text-align:center;">
        <div id="out-rate" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#0284C7;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#38BDF8; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.04em;">Sweat Rate (L/hr)</div>
      </div>
      <div class="result-card" style="background:#F0FDF4; border-color:#BBF7D0; text-align:center;">
        <div id="out-replace" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#16A34A;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#4ADE80; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.04em;">Replace / hr (ml)</div>
      </div>
    </div>

    <div id="dehydration-bar" style="margin-bottom:0.875rem;">
      <div style="display:flex; justify-content:space-between; margin-bottom:0.35rem;">
        <span style="font-size:0.78rem; font-weight:600; color:var(--text-secondary);">Dehydration Level</span>
        <span id="dehy-pct" style="font-size:0.78rem; font-weight:700; color:var(--text-primary);"></span>
      </div>
      <div style="height:10px; background:var(--bg-surface-2); border-radius:999px; overflow:hidden;">
        <div id="dehy-fill" style="height:100%; width:0%; background:#0284C7; border-radius:999px; transition:width 0.3s, background 0.3s;"></div>
      </div>
      <div style="font-size:0.72rem; color:var(--text-muted); margin-top:0.3rem; text-align:right;">Under 2% = optimal; 2–4% = impaired; 5%+ = serious</div>
    </div>

    <div id="tip-box" style="padding:0.75rem 1rem; border-radius:0.625rem; font-size:0.82rem; line-height:1.6; border:1px solid var(--border); color:var(--text-secondary);"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to use the Hydration &amp; Fluid Loss Calculator</h2>
    <p class="seo-p">Whether you are training for a marathon, starting a new gym routine, or working outdoors in summer heat, understanding how much fluid you lose during exercise is essential for performance and safety. Dehydration as low as 2 percent of body weight can reduce endurance by up to 25 percent, while overhydration carries its own risks. This calculator estimates your sweat rate based on body weight, exercise duration, and fluids consumed, then provides a specific rehydration target so you know exactly how much to drink during and after each session.</p>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Marathon and half-marathon runners</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A 70 kg runner covering 21 km in 2 hours may lose 1.5 to 2.0 litres of sweat. Entering pre- and post-run weights with fluids consumed reveals your personal sweat rate and shows whether 500 ml at each aid station is enough or too much for your next race.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Gym and strength-training sessions</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A 90 kg athlete lifting for 75 minutes typically loses 0.6 to 1.0 litres depending on intensity and room temperature. Use the calculator after a session to determine whether your 500 ml water bottle covered the loss or if you need a second bottle with electrolytes.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Outdoor workers in hot climates</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Construction workers and landscapers labouring in 35 °C heat for 4 hours can lose 3 to 5 litres of sweat. The calculator helps quantify that loss so you can schedule structured drinking breaks of 400 to 600 ml every 30 minutes rather than waiting until thirst signals appear.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Cyclists on long rides</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A 75 kg cyclist riding at moderate intensity for 3 hours may lose 2.0 to 3.0 litres. Inputting your ride data shows how many bottles to carry and whether adding electrolyte tablets to your 750 ml bottles is necessary to maintain performance on warm days.</p>
      </div>
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/bmr-katch-mcardle-calculator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">BMR Katch-McArdle & TDEE Calculator</a>
        <a href="/tools/macro-calorie-deficit-allocator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Macro Nutrient & Calorie Deficit Allocator</a>
        <a href="/tools/bmi-calculator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">BMI Calculator</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How fluid loss is estimated</h2>
    <p class="seo-p">Calculations are based on published exercise physiology formulas derived from controlled sweat-rate studies involving thousands of participants. All computations happen locally, so your body weight and exercise data never leave your device.</p>
    <h3 class="font-display seo-h3-sm">Sweat rate estimation</h3>
    <p class="seo-p">Sweat rate is derived from the difference between pre-exercise and post-exercise body weight, adjusted for any fluids consumed during the session. Research shows typical sweat rates of 0.5 to 2.5 litres per hour, with elite athletes in hot conditions occasionally exceeding 3.0 L/hr. A 2018 study published in the British Journal of Sports Medicine confirmed that body-weight-based estimates correlate with measured sweat rates within approximately 15 percent for most individuals.</p>
    <h3 class="font-display seo-h3-sm">Body weight factor</h3>
    <p class="seo-p">Heavier individuals generate more metabolic heat and have larger skin surface areas, both of which increase sweat production. The American College of Sports Medicine recommends expressing sweat loss as a percentage of body weight to standardise comparisons across athletes of different sizes. For example, a 60 kg runner losing 1.2 kg represents a 2.0 percent dehydration level, while a 90 kg runner losing the same 1.2 kg is only at 1.3 percent. The calculator normalises this so your dehydration percentage reflects physiological impact rather than absolute volume.</p>
    <h3 class="font-display seo-h3-sm">Activity intensity multiplier</h3>
    <p class="seo-p">Sweat rate increases roughly linearly with exercise intensity up to approximately 75 percent of VO2 max, beyond which additional intensity yields diminishing sweat-rate gains. Walking at 5 km/hr typically produces 0.4 to 0.8 L/hr, jogging at 10 km/hr produces 0.8 to 1.5 L/hr, and running at 15 km/hr or above can produce 1.5 to 2.5 L/hr or more. Temperature and humidity amplify these rates: a runner in 32 °C heat may sweat 30 to 50 percent more than the same effort at 18 °C. Humid conditions further reduce evaporative cooling, causing the body to produce even more sweat to dissipate heat.</p>
    <h3 class="font-display seo-h3-sm">Worked example</h3>
    <p class="seo-p">Consider a 75 kg cyclist who completes a 60-minute ride and weighs 74.2 kg afterward, having consumed 500 ml of water. Total fluid lost equals the weight difference (0.8 kg) plus consumed fluid (0.5 L), yielding 1.3 L. The hourly sweat rate is therefore 1.3 L/hr. To fully restore hydration, the general guideline is <code class="inline-code">125-150%</code> of fluid lost, meaning this cyclist should drink approximately 1.0 to 1.2 L over the 2 to 4 hours following exercise. Adding 300 to 500 mg of sodium per hour from electrolyte drinks helps the body retain that fluid rather than excreting it quickly through urine.</p>
    <h3 class="font-display seo-h3-sm">Rehydration targets</h3>
    <p class="seo-p">The rehydration recommendation includes a buffer beyond the measured loss because kidney function continues to clear fluid for several hours after exercise ends. Research from the University of Connecticut's Hydration Laboratory recommends drinking 125 to 150 percent of measured fluid loss within 4 to 6 hours post-exercise to achieve complete fluid balance. Consuming fluids containing sodium at concentrations of 20 to 50 mmol/L improves retention compared with plain water alone.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently asked questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'How accurate are the fluid loss estimates?', a: 'Estimates are derived from peer-reviewed sweat rate research and are accurate to within approximately 15 percent for most people under typical conditions. Individual results vary based on genetics, fitness level, heat acclimatisation, clothing, and environmental factors such as humidity and wind. Use these figures as starting guidelines, then refine your hydration plan by comparing your own pre- and post-exercise weigh-ins over several sessions.' },
        { q: 'Can I drink too much water?', a: 'Overhydration, also known as exercise-associated hyponatremia, occurs when excessive water intake dilutes blood sodium levels below 135 mmol/L and can be life-threatening in severe cases. During exercise lasting less than 60 minutes, plain water in moderate amounts is usually adequate. For activities exceeding 60 to 90 minutes, aim for 300 to 500 mg of sodium per hour from sports drinks or electrolyte tablets to maintain sodium balance and prevent dilutional hyponatremia.' },
        { q: 'Should I drink before, during, or after exercise?', a: 'All three phases matter for optimal hydration. Pre-hydrate with 200 to 300 ml of fluid approximately 2 hours before exercise to ensure adequate starting hydration. During activity, target 150 to 250 ml every 15 to 20 minutes, adjusting upward in hot conditions or for heavier athletes. After exercise, replace 125 to 150 percent of measured fluid loss over the following 2 to 4 hours, prioritising drinks containing sodium to improve fluid retention.' },
        { q: 'Does caffeine affect hydration?', a: 'Moderate caffeine consumption of up to 400 mg per day produces a minimal diuretic effect that does not meaningfully impair hydration status. A 2014 meta-analysis in PLOS ONE concluded that regular caffeine consumers develop tolerance to the diuretic effect within 4 to 5 days. However, single doses exceeding 500 mg can transiently increase urine output, and caffeinated beverages consumed during intense exercise should be counted toward daily fluid intake rather than treated as pure hydration.' },
        { q: 'Why do sweat rates vary so much between individuals?', a: 'Sweat rate is influenced by genetics, body composition, fitness level, heat acclimatisation status, and even the number and distribution of active sweat glands, which varies from person to person. Sodium concentration in sweat ranges from 20 to 80 mmol/L, meaning two athletes producing the same sweat volume may have very different electrolyte replacement needs. Athletes who train regularly in heat typically develop more efficient sweating responses, producing dilute sweat at higher volumes earlier in exercise. Tracking your own body weight changes over multiple sessions is the most reliable way to identify your personal pattern.' },
        { q: 'How does this calculator compare to wearing a sweat sensor?', a: 'Wearable sweat sensors provide real-time sweat rate and sodium concentration data but cost several hundred dollars and require proper calibration for reliable readings. This calculator uses body weight and fluid intake measurements, which research has shown to be within 10 to 15 percent of laboratory-grade methods for most individuals. For athletes who need precise electrolyte replacement data, a sweat patch test from a sports science lab offers the highest accuracy. For everyday training, the calculator provides practical guidance without any additional equipment.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7"><strong class="text-primary" style="color:var(--text-secondary)">Health disclaimer:</strong> Hydration needs vary based on individual health conditions, medications, kidney function, and pregnancy status. Estimated values are intended for generally healthy adults engaged in exercise and are not a substitute for professional medical advice. Consult a qualified healthcare provider or registered sports dietitian for personalised hydration recommendations, especially if you have cardiovascular, renal, or electrolyte-related conditions.</div>
  </div>

</ToolLayout>

<script>
  function calc() {
    const pre  = parseFloat((document.getElementById('pre-wt') as HTMLInputElement).value)   || 0;
    const post = parseFloat((document.getElementById('post-wt') as HTMLInputElement).value)  || 0;
    const dur  = parseFloat((document.getElementById('duration') as HTMLInputElement).value) || 0;
    const cons = parseFloat((document.getElementById('consumed') as HTMLInputElement).value) || 0;

    const totalLost = Math.max((pre - post) + cons / 1000, 0);
    const sweatRate = dur > 0 ? totalLost / (dur / 60) : 0;
    const replaceML = sweatRate * 1000;
    const dehyPct   = pre > 0 ? (totalLost / pre * 100) : 0;

    (document.getElementById('out-lost') as HTMLElement).textContent    = totalLost.toFixed(2) + ' L';
    (document.getElementById('out-rate') as HTMLElement).textContent    = sweatRate.toFixed(2) + ' L/hr';
    (document.getElementById('out-replace') as HTMLElement).textContent = Math.round(replaceML) + ' ml';
    (document.getElementById('dehy-pct') as HTMLElement).textContent    = dehyPct.toFixed(1) + '%';

    const fill  = document.getElementById('dehy-fill') as HTMLElement;
    const pct   = Math.min(dehyPct * 10, 100);
    fill.style.width      = pct + '%';
    fill.style.background = dehyPct < 2 ? '#0284C7' : dehyPct < 4 ? '#F59E0B' : '#DC2626';

    const tip = document.getElementById('tip-box')!;
    if (dehyPct < 2) {
      tip.style.background = '#F0F9FF'; tip.style.borderColor = '#BAE6FD'; tip.style.color = '#0369A1';
      tip.textContent = '✅ Excellent hydration. You replaced fluids effectively during this session.';
    } else if (dehyPct < 4) {
      tip.style.background = '#FFFBEB'; tip.style.borderColor = '#FDE68A'; tip.style.color = '#92400E';
      tip.textContent = '⚠️ Mild dehydration detected. Increase fluid intake during your next session by approximately ' + Math.round(totalLost * 500) + ' ml.';
    } else {
      tip.style.background = '#FEF2F2'; tip.style.borderColor = '#FECACA'; tip.style.color = '#991B1B';
      tip.textContent = '🚨 Significant dehydration. Consider a structured hydration plan and discuss with a sports dietitian if this level is regular.';
    }
  }

  ['pre-wt','post-wt','duration','consumed'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));
  calc();
</script>
