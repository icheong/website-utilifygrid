---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'heat-transfer-coefficient-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Heat Transfer Coefficient Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="W_m2K">Watt per Square Meter-Kelvin (W/(m²·K))</option>
          <option value="BTU_hft2F">BTU per Hour-Square Foot-°F (BTU/(h·ft²·°F))</option>
          <option value="cal_scm2C">Calorie per Second-Square Centimeter-°C (cal/(s·cm²·°C))</option>
          <option value="W_cm2K">Watt per Square Centimeter-Kelvin (W/(cm²·K))</option>
          <option value="kJ_hm2K">Kilojoule per Hour-Square Meter-Kelvin (kJ/(h·m²·K))</option>
          <option value="kcal_hm2C">Kilocalorie per Hour-Square Meter-°C (kcal/(h·m²·°C))</option>
          <option value="Wh_m2K">Watt-Hour per Square Meter-Kelvin (Wh/(m²·K))</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Heat Transfer Coefficient Converter</h2>
    <p class="seo-p">Enter a numeric heat transfer coefficient value and instantly see equivalent values in all supported units. Pick your source unit from the dropdown and every other unit updates in real time.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Enter Coefficient Value</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Type any non-negative number into the value field. You can enter integers, decimals, or very large or small values — the converter handles them all.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Select Target Unit</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Choose the unit your input value is expressed in from the dropdown. Supported units include W/(m²·K), BTU/(h·ft²·°F), kcal/(h·m²·°C), and several others.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">View All Conversions</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">All equivalent values across every supported unit appear instantly below the input fields. Results update on each keystroke — no buttons to click.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Copy Result</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Click the Copy button next to any result to copy that value to your clipboard. Paste it directly into documents, spreadsheets, or engineering calculations.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Heat Transfer Coefficient Converter Works</h2>
    <p class="seo-p">This tool converts between different units used to express the convective <code class="inline-code">heat transfer coefficient (h)</code>, which relates heat flux to temperature difference between a surface and a fluid.</p>
    <h3 class="font-display seo-h3-sm">Heat Transfer Coefficient Units</h3>
    <p class="seo-p">The heat transfer coefficient is expressed in units of energy per unit time, per unit area, per unit temperature difference. The most common SI unit is <code class="inline-code">W/(m²·K)</code>. In imperial systems, <code class="inline-code">BTU/(h·ft²·°F)</code> is widely used. Other units include <code class="inline-code">kcal/(h·m²·°C)</code>, <code class="inline-code">cal/(s·cm²·°C)</code>, and <code class="inline-code">kJ/(h·m²·K)</code>. Each unit pairs a different energy scale with a different area and temperature scale.</p>
    <h3 class="font-display seo-h3-sm">Conversion Mathematics</h3>
    <p class="seo-p">All conversions use <code class="inline-code">W/(m²·K)</code> as the base unit. Each unit has a fixed conversion factor — for example, 1 <code class="inline-code">BTU/(h·ft²·°F)</code> equals 5.67447 <code class="inline-code">W/(m²·K)</code>. To convert between any two units, the tool multiplies by the source factor and divides by the target factor. All calculations run instantly in your browser with no data sent to a server.</p>
    <h3 class="font-display seo-h3-sm">Convection vs Radiation Coefficients</h3>
    <p class="seo-p">The heat transfer coefficient described here applies specifically to <code class="inline-code">convection</code> — heat transfer between a surface and a moving fluid. <code class="inline-code">Radiation</code> heat transfer uses a different formulation based on emissivity and the Stefan-Boltzmann law, though an effective radiation coefficient can sometimes be defined for linearized calculations. Typical convective values range from about 5 <code class="inline-code">W/(m²·K)</code> for natural convection in air up to 10,000+ <code class="inline-code">W/(m²·K)</code> for boiling liquids.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between convection and radiation heat transfer coefficients?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A convection heat transfer coefficient relates heat flux to the temperature difference between a surface and a moving fluid, following Newton's law of cooling. A radiation coefficient is a linearized approximation derived from the Stefan-Boltzmann law and depends on emissivity and temperature. Convection coefficients are typically much higher than radiation coefficients at moderate temperatures.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What are typical heat transfer coefficient values for air vs water cooling?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Natural convection in air typically ranges from 5 to 25 W/(m²·K), while forced convection in air reaches 25 to 250 W/(m²·K). Water is far more effective: natural convection in water is about 100 to 600 W/(m²·K), and forced convection in water ranges from 100 to 2000 W/(m²·K). Boiling water can exceed 10,000 W/(m²·K).</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does surface area affect heat transfer?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Total heat transfer rate equals the heat transfer coefficient multiplied by surface area and temperature difference (Q = h × A × ΔT). A larger surface area increases the total heat transferred for a given coefficient and temperature difference. Fins and extended surfaces are commonly used to increase effective area in heat exchangers and electronics cooling.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why use different units for the heat transfer coefficient?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Different industries and regions favor different unit systems. W/(m²·K) is the SI standard used in most scientific and engineering contexts. BTU/(h·ft²·°F) is common in HVAC and American engineering practice. kcal/(h·m²·°C) appears in older European and Asian references. Converting between them ensures consistent calculations across documents and standards.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What factors influence the value of the heat transfer coefficient?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The coefficient depends on fluid properties such as thermal conductivity, viscosity, density, and specific heat. Flow conditions — velocity, turbulence, and whether the flow is laminar or turbulent — have a major effect. Surface geometry, roughness, and orientation also influence the coefficient. Phase changes like boiling or condensation dramatically increase heat transfer rates.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How accurate are these unit conversions?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The conversions use exact, internationally recognized conversion factors between unit systems. For example, 1 BTU/(h·ft²·°F) is exactly 5.67447 W/(m²·K). The tool performs arithmetic only — no approximations or assumptions are involved. Results are as accurate as the precision of JavaScript floating-point arithmetic allows.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'W_m2K',     label: 'Watt per Square Meter-Kelvin (W/(m²·K))',              abbr: 'W/(m²·K)',         factor: 1 },
    { id: 'BTU_hft2F',  label: 'BTU per Hour-Square Foot-°F (BTU/(h·ft²·°F))',        abbr: 'BTU/(h·ft²·°F)',   factor: 5.67447 },
    { id: 'cal_scm2C',  label: 'Calorie per Second-Square Centimeter-°C (cal/(s·cm²·°C))', abbr: 'cal/(s·cm²·°C)', factor: 41840 },
    { id: 'W_cm2K',     label: 'Watt per Square Centimeter-Kelvin (W/(cm²·K))',        abbr: 'W/(cm²·K)',        factor: 10000 },
    { id: 'kJ_hm2K',    label: 'Kilojoule per Hour-Square Meter-Kelvin (kJ/(h·m²·K))', abbr: 'kJ/(h·m²·K)',      factor: 0.277778 },
    { id: 'kcal_hm2C',  label: 'Kilocalorie per Hour-Square Meter-°C (kcal/(h·m²·°C))', abbr: 'kcal/(h·m²·°C)',  factor: 1.16278 },
    { id: 'Wh_m2K',     label: 'Watt-Hour per Square Meter-Kelvin (Wh/(m²·K))',        abbr: 'Wh/(m²·K)',        factor: 3600 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
