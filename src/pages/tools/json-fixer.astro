---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'json-fixer')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">JSON Fixer &amp; Automatic Repair Tool</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Paste malformed, corrupted, or non-strict JSON and automatically repair common syntax issues.</p>

    <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
      <button id="btn-fix" class="btn-primary" type="button">Fix &amp; Format</button>
      <button id="btn-copy" class="btn-secondary" type="button">Copy Fixed</button>
      <button id="btn-clear" class="btn-secondary" type="button">Clear</button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem;">
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Broken JSON</label>
          <div style="display:flex; gap:0.5rem;">
            <button id="btn-sample-1" class="btn-secondary" type="button" style="font-size:0.68rem; padding:0.2rem 0.5rem;">Sample 1</button>
            <button id="btn-sample-2" class="btn-secondary" type="button" style="font-size:0.68rem; padding:0.2rem 0.5rem;">Sample 2</button>
          </div>
        </div>
        <textarea id="json-input" class="input-themed"
          placeholder="Paste broken JSON here…"
          rows="10"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65;"
        ></textarea>
      </div>
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Fixed Output</label>
        </div>
        <textarea id="json-output" class="input-themed" readonly rows="10"
          placeholder="Fixed JSON appears here…"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65; background:var(--bg-surface-2);"
        ></textarea>
      </div>
    </div>

    <div id="fix-log" style="display:none; margin-top:0.875rem;">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
        <span style="font-size:0.65rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted);">Repairs applied</span>
        <span id="fix-count" style="font-size:0.62rem; font-weight:700; font-family:'Fira Code',monospace; padding:0.1rem 0.45rem; border-radius:999px; background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.35); color:#059669;"></span>
      </div>
      <div id="fix-list" style="display:flex; flex-direction:column; gap:0.3rem;"></div>
    </div>

    <div id="error-box" style="display:none; margin-top:0.625rem; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); border-radius:0.5rem; padding:0.75rem 1rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:#DC2626;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the JSON Fixer and Automatic Repair Tool</h2>
    <p class="seo-p">A developer copies a JavaScript object literal from source code to paste into a configuration file. The object has trailing commas after the last array element and single-quoted property names, which are valid JavaScript but invalid JSON. Paste the broken JSON into the input panel and click Fix and Format. The tool detects trailing commas, swaps single quotes for double quotes, wraps unquoted keys, and balances missing brackets. The repair log shows exactly what was changed: three fixes applied. Copy the fixed output and paste it into the configuration file.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Recovering truncated API responses</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">An engineer debugging a production issue has a partial API response that was cut off mid-transmission by a network timeout. Paste the truncated JSON, click Fix and Format, and the bracket balancer appends the missing closing braces and brackets. While the tool cannot recover the truncated data, it produces parseable JSON that reveals most of the structure and available fields for debugging.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Migrating legacy configuration files</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A systems administrator converts relaxed JSON configuration files that use unquoted keys, single quotes, or trailing commas into strict RFC 8259 JSON. Paste the legacy config, click Fix and Format, and the repair pipeline normalises quotes, strips trailing commas, and wraps bare identifier keys in double quotes. The repair log documents every transformation for auditability.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Fixing console.log output</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A developer copies output from console.log in Node.js, which uses single quotes for string values and may include trailing commas in object literals. Paste the console output, click Fix and Format, and the tool converts it to valid JSON. This is faster than manually editing every string quote and removing commas by hand.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Repairing hand-edited JSON</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A non-technical team member edits a JSON file manually in a text editor and accidentally introduces a trailing comma or forgets a closing bracket. Paste the broken JSON, click Fix and Format, and the repair pipeline fixes the syntax automatically. The repair log provides transparency into what was changed so the team member can understand what went wrong.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the JSON Repair Pipeline Works</h2>
    <p class="seo-p">
      You paste JSON that has syntax errors — trailing commas, single quotes, unquoted keys, or missing brackets. The tool runs a four-stage repair pipeline, each stage targeting one category of error. Every stage is context-aware, meaning it tracks whether it is inside a string literal to avoid corrupting actual data values.
    </p>
    <h3 class="seo-h3-sm">Quote Normalisation and Trailing Comma Removal</h3>
    <p class="seo-p">
      The first stage scans for single quotes that appear outside of double-quoted strings and replaces them with double quotes. It respects backslash escapes so contractions inside string values like <code class="inline-code">don't</code> are left alone. The second stage looks for commas immediately before closing braces or brackets and removes them. This handles the most common syntax error: trailing commas after the last element in an array or object, which JavaScript and Python allow but JSON does not.
    </p>
    <h3 class="seo-h3-sm">Unquoted Key Wrapping and Bracket Balancing</h3>
    <p class="seo-p">
      The third stage detects bare identifier tokens that follow opening braces or commas — property names like <code class="inline-code">name</code> or <code class="inline-code">age</code> that are missing their quotes — and wraps them in double quotes. The fourth stage uses a stack-based algorithm to count unmatched opening braces and brackets, then appends the missing closing delimiters in reverse order. This fixes truncated documents where the final closing bracket was accidentally deleted.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What types of JSON errors can it fix?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The tool handles four common categories: single quotes instead of double quotes, trailing commas after the last element, unquoted property names, and missing closing brackets or braces. If the JSON is fundamentally malformed — for example, entirely non-JSON text or missing most of its content — the pipeline will report the remaining error after attempting all repair stages.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Will the repair change any of my actual data values?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">No. The repairs only target syntax errors. String values, numbers, booleans, and nested structures are never modified. The quote normaliser specifically avoids touching single quotes that appear inside double-quoted strings, so contractions like "don't" or "it's" are preserved exactly as they appear in the original.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why do trailing commas keep appearing in my JSON?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Many programming languages — including JavaScript, Python, and TypeScript — allow trailing commas in object and array literals. When developers manually edit JSON files or copy data from these languages, trailing commas often sneak in. JSON per RFC 8259 strictly forbids them, which is why most APIs and parsers reject files with trailing commas.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What if the tool wraps the wrong tokens in quotes?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The key wrapper uses a conservative heuristic: it only targets tokens that look like valid JavaScript identifiers (alphanumeric characters, underscores, dollar signs, no spaces) and are not already wrapped in quotes. Numeric-only keys or keys with special characters may require manual correction. Always review the repair log to confirm each transformation matches your intent.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can it fix truncated JSON from a network timeout?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Partially. The bracket balancer appends the missing closing braces and brackets so the document becomes parseable. However, the tool cannot recover the truncated data itself — if a response was cut off mid-transmission, the last few fields are lost. The repaired output gives you most of the structure and available data for debugging purposes.</p>
        </div>
      </div>

    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLES = [
    `{'name': 'Alice', 'age': 30, 'tags': ['dev', 'design',], 'address': {'city': 'Sydney',}}`,
    `{"name": "Bob", "scores": [98, 85, 72], "meta": {"created": "2024-01-15", "active": true,}}`
  ];

  function fixJson(raw: string): { fixed: string; fixes: string[] } {
    const fixes: string[] = [];
    let s = raw;

    // Helper: strip string literals to avoid matching inside them
    function stripStrings(str: string): string {
      return str.replace(/"(?:[^"\\]|\\.)*"/g, '""');
    }

    // Fix 1: Swap single quotes for double quotes (context-aware)
    const hasSingleQuotes = /'([^']*?)'/.test(stripStrings(s));
    if (hasSingleQuotes) {
      // Only replace single quotes that are NOT inside double-quoted strings
      let result = '';
      let inDouble = false;
      for (let i = 0; i < s.length; i++) {
        if (s[i] === '\\' && inDouble) { result += s[i] + (s[i + 1] || ''); i++; continue; }
        if (s[i] === '"') inDouble = !inDouble;
        if (!inDouble && s[i] === "'") result += '"';
        else result += s[i];
      }
      s = result;
      fixes.push('Swapped single quotes for double quotes');
    }

    // Fix 2: Remove trailing commas (context-aware)
    const strippedForCommas = stripStrings(s);
    const hasTrailingCommas = /,\s*[\]}]/.test(strippedForCommas);
    if (hasTrailingCommas) {
      let result = '';
      let inStr = false;
      for (let i = 0; i < s.length; i++) {
        if (s[i] === '\\' && inStr) { result += s[i] + (s[i + 1] || ''); i++; continue; }
        if (s[i] === '"') inStr = !inStr;
        if (!inStr && s[i] === ',' && s[i + 1] && /[\s]*[\]}]/.test(s.slice(i + 1))) {
          let j = i + 1;
          while (j < s.length && s[j] === ' ') j++;
          if (j < s.length && (s[j] === '}' || s[j] === ']')) {
            result += s[j];
            i = j;
            continue;
          }
        }
        result += s[i];
      }
      s = result;
      fixes.push('Removed trailing commas');
    }

    // Fix 3: Wrap unquoted keys (context-aware)
    const strippedForKeys = stripStrings(s);
    const hasUnquotedKeys = /{\s*[a-zA-Z_$][a-zA-Z0-9_$]*\s*:/.test(strippedForKeys) ||
      /[\n,{]\s*[a-zA-Z_$][a-zA-Z0-9_$]*\s*:/.test(strippedForKeys);
    if (hasUnquotedKeys) {
      let result = '';
      let inStr = false;
      for (let i = 0; i < s.length; i++) {
        if (s[i] === '\\' && inStr) { result += s[i] + (s[i + 1] || ''); i++; continue; }
        if (s[i] === '"') inStr = !inStr;
        if (!inStr) {
          const before = i > 0 ? s[i - 1] : '';
          if ((before === '{' || before === ',' || before === '\n' || before === ' ') &&
              s[i].match(/[a-zA-Z_$]/)) {
            let keyEnd = i;
            while (keyEnd < s.length && s[keyEnd].match(/[a-zA-Z0-9_$]/)) keyEnd++;
            if (keyEnd < s.length && s.slice(keyEnd).match(/^\s*:/)) {
              result += '"' + s.slice(i, keyEnd) + '"';
              i = keyEnd - 1;
              continue;
            }
          }
        }
        result += s[i];
      }
      s = result;
      fixes.push('Wrapped unquoted keys in double quotes');
    }

    // Fix 4: Balance brackets (stack-based, respecting strings)
    const stack: string[] = [];
    let inString = false;
    for (let i = 0; i < s.length; i++) {
      if (s[i] === '\\' && inString) { i++; continue; }
      if (s[i] === '"') inString = !inString;
      if (!inString) {
        if (s[i] === '{' || s[i] === '[') stack.push(s[i]);
        else if (s[i] === '}' || s[i] === ']') {
          const expected = s[i] === '}' ? '{' : '[';
          if (stack.length > 0 && stack[stack.length - 1] === expected) stack.pop();
        }
      }
    }
    let missing = '';
    while (stack.length > 0) {
      const open = stack.pop();
      missing += open === '{' ? '}' : ']';
    }
    if (missing) {
      s += missing;
      const braceCount = (missing.match(/}/g) || []).length;
      const bracketCount = (missing.match(/]/g) || []).length;
      if (braceCount) fixes.push(`Added ${braceCount} missing closing brace(s)`);
      if (bracketCount) fixes.push(`Added ${bracketCount} missing closing bracket(s)`);
    }

    return { fixed: s, fixes };
  }

  function runFix() {
    const raw = (document.getElementById('json-input') as HTMLTextAreaElement).value;
    const out = (document.getElementById('json-output') as HTMLTextAreaElement);
    const errBox = document.getElementById('error-box')!;
    const fixLog = document.getElementById('fix-log')!;
    const fixList = document.getElementById('fix-list')!;
    const fixCount = document.getElementById('fix-count')!;
    errBox.style.display = 'none';
    fixLog.style.display = 'none';
    if (!raw.trim()) { out.value = ''; return; }

    // Try parsing as-is first
    try {
      const parsed = JSON.parse(raw);
      out.value = JSON.stringify(parsed, null, 2);
      fixLog.style.display = 'none';
      return;
    } catch {}

    const { fixed, fixes } = fixJson(raw);

    try {
      const parsed = JSON.parse(fixed);
      out.value = JSON.stringify(parsed, null, 2);

      if (fixes.length > 0) {
        fixLog.style.display = 'block';
        fixCount.textContent = `${fixes.length} fix${fixes.length !== 1 ? 'es' : ''}`;
        fixList.innerHTML = '';
        fixes.forEach(f => {
          const row = document.createElement('div');
          row.style.cssText = 'display:flex; align-items:center; gap:0.5rem; padding:0.35rem 0.75rem; background:rgba(16,185,129,0.06); border:1px solid rgba(16,185,129,0.2); border-radius:0.5rem; font-size:0.78rem;';
          row.innerHTML = `<span style="color:#059669; font-weight:700;">✓</span><span style="color:var(--text-secondary);">${f}</span>`;
          fixList.appendChild(row);
        });
      }
    } catch (e: any) {
      errBox.textContent = 'Could not auto-repair: ' + e.message;
      errBox.style.display = 'block';
    }
  }

  document.getElementById('btn-fix')!.addEventListener('click', runFix);
  document.getElementById('btn-sample-1')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = SAMPLES[0];
    runFix();
  });
  document.getElementById('btn-sample-2')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = SAMPLES[1];
    runFix();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = '';
    (document.getElementById('json-output') as HTMLTextAreaElement).value = '';
    document.getElementById('error-box')!.style.display = 'none';
    document.getElementById('fix-log')!.style.display = 'none';
  });
  document.getElementById('btn-copy')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy')!;
    navigator.clipboard.writeText((document.getElementById('json-output') as HTMLTextAreaElement).value).then(() => {
      btn.textContent = '✓ Copied!';
      btn.classList.add('btn-success');
      setTimeout(() => { btn.textContent = 'Copy Fixed'; btn.classList.remove('btn-success'); }, 2000);
    }).catch(() => {});
  });
</script>
