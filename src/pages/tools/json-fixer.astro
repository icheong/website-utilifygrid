---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'json-fixer')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">JSON Fixer &amp; Automatic Repair Tool</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Paste malformed, corrupted, or non-strict JSON and automatically repair common syntax issues.</p>

    <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
      <button id="btn-fix" class="btn-primary" type="button">Fix &amp; Format</button>
      <button id="btn-copy" class="btn-secondary" type="button">Copy Fixed</button>
      <button id="btn-clear" class="btn-secondary" type="button">Clear</button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem;">
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Broken JSON</label>
          <div style="display:flex; gap:0.5rem;">
            <button id="btn-sample-1" class="btn-secondary" type="button" style="font-size:0.68rem; padding:0.2rem 0.5rem;">Sample 1</button>
            <button id="btn-sample-2" class="btn-secondary" type="button" style="font-size:0.68rem; padding:0.2rem 0.5rem;">Sample 2</button>
          </div>
        </div>
        <textarea id="json-input" class="input-themed"
          placeholder="Paste broken JSON here…"
          rows="10"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65;"
        ></textarea>
      </div>
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Fixed Output</label>
        </div>
        <textarea id="json-output" class="input-themed" readonly rows="10"
          placeholder="Fixed JSON appears here…"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65; background:var(--bg-surface-2);"
        ></textarea>
      </div>
    </div>

    <div id="fix-log" style="display:none; margin-top:0.875rem;">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
        <span style="font-size:0.65rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted);">Repairs applied</span>
        <span id="fix-count" style="font-size:0.62rem; font-weight:700; font-family:'Fira Code',monospace; padding:0.1rem 0.45rem; border-radius:999px; background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.35); color:#059669;"></span>
      </div>
      <div id="fix-list" style="display:flex; flex-direction:column; gap:0.3rem;"></div>
    </div>

    <div id="error-box" style="display:none; margin-top:0.625rem; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); border-radius:0.5rem; padding:0.75rem 1rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:#DC2626;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">JSON Fixer and Automatic Repair Tool Overview</h2>
    <p class="seo-p">
      This JSON fixer automatically detects and repairs common syntax errors in malformed JSON documents — including trailing commas, single-quoted strings, unquoted property names, and missing closing brackets. Paste broken JSON into the input panel and click Fix &amp; Format to see the repaired, prettified output alongside a detailed repair log that itemises every change made. All processing is 100% client-side with no server uploads, keeping your data completely private.
    </p>
    <p class="seo-p">
      The tool runs a multi-stage repair pipeline that normalises quotes, strips trailing commas, wraps bare identifier keys in double quotes, and balances unmatched brackets. After each repair stage, the result is passed to <code class="inline-code">JSON.parse()</code> for validation. If the JSON is already valid, it is simply prettified without any modifications. The repair log provides full transparency into what was changed and why, so you can verify the corrections before using the output.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Copy-paste from JavaScript source code', 'A developer copying an object literal from JavaScript code often ends up with trailing commas and single-quoted keys, which are valid in JS but invalid in JSON. Instead of manually editing every line, paste the JS object literal into the fixer and get valid JSON in one click.'],
        ['Recovering truncated API responses', 'An engineer debugging a partial API response that got cut off mid-response can use the bracket balancer to infer and append missing closing braces. While not guaranteed to recover the original intent, it often produces parseable JSON that reveals most of the data.'],
        ['Migrating legacy configuration files', 'A systems administrator converting YAML-like or relaxed JSON configs (with unquoted keys, single quotes, or trailing commas) to strict RFC 8259 JSON can batch-fix files through the tool. The repair log documents every transformation for auditability.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Multi-Stage Repair Pipeline</h2>
    <p class="seo-p">
      The repair engine processes input through a sequence of independent stages, each targeting a specific class of JSON syntax error. Each stage operates character-by-character with awareness of string literal boundaries to avoid corrupting values.
    </p>
    <h3 class="seo-h3-sm">Stage 1: Quote Normalisation</h3>
    <p class="seo-p">
      Single quotes (<code class="inline-code">'</code>) that appear outside of double-quoted strings are replaced with double quotes (<code class="inline-code">"</code>). The scanner tracks whether it is inside a double-quoted string by counting quote characters and respecting backslash escapes. This ensures that single quotes inside string values — such as contractions like <code class="inline-code">don't</code> — are preserved while structural single quotes are corrected.
    </p>
    <h3 class="seo-h3-sm">Stage 2: Trailing Comma Removal</h3>
    <p class="seo-p">
      Commas that appear immediately before a closing brace <code class="inline-code">{'}'}</code> or bracket <code class="inline-code">]</code> (with optional whitespace between) are removed. The scanner skips over whitespace after a comma and checks whether the next non-whitespace character is a closing delimiter. This handles the most common JSON syntax error introduced by languages that permit trailing commas.
    </p>
    <h3 class="seo-h3-sm">Stage 3: Unquoted Key Wrapping</h3>
    <p class="seo-p">
      Property names that consist only of alphanumeric characters, underscores, and dollar signs — and are not already wrapped in quotes — are detected by scanning for identifier-like tokens following opening braces or commas. Each detected bare identifier is wrapped in double quotes. The scanner uses a regex pattern to identify valid JavaScript identifier tokens, which is conservative enough to avoid false positives on values.
    </p>
    <h3 class="seo-h3-sm">Stage 4: Bracket Balancing</h3>
    <p class="seo-p-none">
      A stack-based algorithm traverses the string and tracks opening braces <code class="inline-code">{'{'}</code> and brackets <code class="inline-code">[</code>, pushing each onto a stack. When a closing delimiter is encountered, it is matched against the top of the stack. After the full scan, any unmatched open delimiters on the stack are appended as closing delimiters in reverse order. This heuristic fixes cases where a document was truncated or a closing bracket was omitted during manual editing.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can it fix completely broken JSON?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The tool handles the most common issues: trailing commas, single quotes, unquoted keys, and missing brackets. If the JSON is fundamentally malformed — for example, if it is entirely non-JSON text or missing most of its content — the repair pipeline will report the remaining error after attempting all stages. The repair log shows exactly what was changed and what still failed.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does fixing change the data?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">No. The repairs only fix syntax — no values, types, or structural relationships are altered. The repaired JSON is semantically identical to what the original author intended. The repair log provides transparency into each transformation so you can verify that no unintended changes were made.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What if the fix is wrong?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Always review the repair log. The tool makes conservative assumptions — for example, it only wraps keys that clearly look like bare identifiers (alphanumeric, no spaces, not already quoted). Edge cases such as numeric-only keys or keys with special characters may require manual intervention. If the repair produces unexpected output, check the log and manually correct the original input.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why does my JSON have trailing commas?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Many languages and environments (JavaScript object literals, Python dicts, YAML, and some configuration formats) allow trailing commas for cleaner diffs and easier reordering. When JSON is generated or manually edited in these contexts, trailing commas often sneak in. JSON per RFC 8259 strictly forbids them, which is why a dedicated fixer is needed.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does the tool handle mixed quote usage within string values?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The quote normaliser is context-aware and tracks double-quote boundaries precisely. If a string value contains a single quote (e.g. <code class="inline-code">don't</code>), it is left untouched because the normaliser only swaps single quotes that appear outside of double-quoted strings. However, nested or mismatched quote styles inside values may still produce invalid output and should be reviewed manually.</p>
        </div>
      </div>

    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLES = [
    `{'name': 'Alice', 'age': 30, 'tags': ['dev', 'design',], 'address': {'city': 'Sydney',}}`,
    `{"name": "Bob", "scores": [98, 85, 72], "meta": {"created": "2024-01-15", "active": true,}}`
  ];

  function fixJson(raw: string): { fixed: string; fixes: string[] } {
    const fixes: string[] = [];
    let s = raw;

    // Helper: strip string literals to avoid matching inside them
    function stripStrings(str: string): string {
      return str.replace(/"(?:[^"\\]|\\.)*"/g, '""');
    }

    // Fix 1: Swap single quotes for double quotes (context-aware)
    const hasSingleQuotes = /'([^']*?)'/.test(stripStrings(s));
    if (hasSingleQuotes) {
      // Only replace single quotes that are NOT inside double-quoted strings
      let result = '';
      let inDouble = false;
      for (let i = 0; i < s.length; i++) {
        if (s[i] === '\\' && inDouble) { result += s[i] + (s[i + 1] || ''); i++; continue; }
        if (s[i] === '"') inDouble = !inDouble;
        if (!inDouble && s[i] === "'") result += '"';
        else result += s[i];
      }
      s = result;
      fixes.push('Swapped single quotes for double quotes');
    }

    // Fix 2: Remove trailing commas (context-aware)
    const strippedForCommas = stripStrings(s);
    const hasTrailingCommas = /,\s*[\]}]/.test(strippedForCommas);
    if (hasTrailingCommas) {
      let result = '';
      let inStr = false;
      for (let i = 0; i < s.length; i++) {
        if (s[i] === '\\' && inStr) { result += s[i] + (s[i + 1] || ''); i++; continue; }
        if (s[i] === '"') inStr = !inStr;
        if (!inStr && s[i] === ',' && s[i + 1] && /[\s]*[\]}]/.test(s.slice(i + 1))) {
          let j = i + 1;
          while (j < s.length && s[j] === ' ') j++;
          if (j < s.length && (s[j] === '}' || s[j] === ']')) {
            result += s[j];
            i = j;
            continue;
          }
        }
        result += s[i];
      }
      s = result;
      fixes.push('Removed trailing commas');
    }

    // Fix 3: Wrap unquoted keys (context-aware)
    const strippedForKeys = stripStrings(s);
    const hasUnquotedKeys = /{\s*[a-zA-Z_$][a-zA-Z0-9_$]*\s*:/.test(strippedForKeys) ||
      /[\n,{]\s*[a-zA-Z_$][a-zA-Z0-9_$]*\s*:/.test(strippedForKeys);
    if (hasUnquotedKeys) {
      let result = '';
      let inStr = false;
      for (let i = 0; i < s.length; i++) {
        if (s[i] === '\\' && inStr) { result += s[i] + (s[i + 1] || ''); i++; continue; }
        if (s[i] === '"') inStr = !inStr;
        if (!inStr) {
          const before = i > 0 ? s[i - 1] : '';
          if ((before === '{' || before === ',' || before === '\n' || before === ' ') &&
              s[i].match(/[a-zA-Z_$]/)) {
            let keyEnd = i;
            while (keyEnd < s.length && s[keyEnd].match(/[a-zA-Z0-9_$]/)) keyEnd++;
            if (keyEnd < s.length && s.slice(keyEnd).match(/^\s*:/)) {
              result += '"' + s.slice(i, keyEnd) + '"';
              i = keyEnd - 1;
              continue;
            }
          }
        }
        result += s[i];
      }
      s = result;
      fixes.push('Wrapped unquoted keys in double quotes');
    }

    // Fix 4: Balance brackets (stack-based, respecting strings)
    const stack: string[] = [];
    let inString = false;
    for (let i = 0; i < s.length; i++) {
      if (s[i] === '\\' && inString) { i++; continue; }
      if (s[i] === '"') inString = !inString;
      if (!inString) {
        if (s[i] === '{' || s[i] === '[') stack.push(s[i]);
        else if (s[i] === '}' || s[i] === ']') {
          const expected = s[i] === '}' ? '{' : '[';
          if (stack.length > 0 && stack[stack.length - 1] === expected) stack.pop();
        }
      }
    }
    let missing = '';
    while (stack.length > 0) {
      const open = stack.pop();
      missing += open === '{' ? '}' : ']';
    }
    if (missing) {
      s += missing;
      const braceCount = (missing.match(/}/g) || []).length;
      const bracketCount = (missing.match(/]/g) || []).length;
      if (braceCount) fixes.push(`Added ${braceCount} missing closing brace(s)`);
      if (bracketCount) fixes.push(`Added ${bracketCount} missing closing bracket(s)`);
    }

    return { fixed: s, fixes };
  }

  function runFix() {
    const raw = (document.getElementById('json-input') as HTMLTextAreaElement).value;
    const out = (document.getElementById('json-output') as HTMLTextAreaElement);
    const errBox = document.getElementById('error-box')!;
    const fixLog = document.getElementById('fix-log')!;
    const fixList = document.getElementById('fix-list')!;
    const fixCount = document.getElementById('fix-count')!;
    errBox.style.display = 'none';
    fixLog.style.display = 'none';
    if (!raw.trim()) { out.value = ''; return; }

    // Try parsing as-is first
    try {
      const parsed = JSON.parse(raw);
      out.value = JSON.stringify(parsed, null, 2);
      fixLog.style.display = 'none';
      return;
    } catch {}

    const { fixed, fixes } = fixJson(raw);

    try {
      const parsed = JSON.parse(fixed);
      out.value = JSON.stringify(parsed, null, 2);

      if (fixes.length > 0) {
        fixLog.style.display = 'block';
        fixCount.textContent = `${fixes.length} fix${fixes.length !== 1 ? 'es' : ''}`;
        fixList.innerHTML = '';
        fixes.forEach(f => {
          const row = document.createElement('div');
          row.style.cssText = 'display:flex; align-items:center; gap:0.5rem; padding:0.35rem 0.75rem; background:rgba(16,185,129,0.06); border:1px solid rgba(16,185,129,0.2); border-radius:0.5rem; font-size:0.78rem;';
          row.innerHTML = `<span style="color:#059669; font-weight:700;">✓</span><span style="color:var(--text-secondary);">${f}</span>`;
          fixList.appendChild(row);
        });
      }
    } catch (e: any) {
      errBox.textContent = 'Could not auto-repair: ' + e.message;
      errBox.style.display = 'block';
    }
  }

  document.getElementById('btn-fix')!.addEventListener('click', runFix);
  document.getElementById('btn-sample-1')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = SAMPLES[0];
    runFix();
  });
  document.getElementById('btn-sample-2')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = SAMPLES[1];
    runFix();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = '';
    (document.getElementById('json-output') as HTMLTextAreaElement).value = '';
    document.getElementById('error-box')!.style.display = 'none';
    document.getElementById('fix-log')!.style.display = 'none';
  });
  document.getElementById('btn-copy')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy')!;
    navigator.clipboard.writeText((document.getElementById('json-output') as HTMLTextAreaElement).value).then(() => {
      btn.textContent = '✓ Copied!';
      btn.classList.add('btn-success');
      setTimeout(() => { btn.textContent = 'Copy Fixed'; btn.classList.remove('btn-success'); }, 2000);
    }).catch(() => {});
  });
</script>
