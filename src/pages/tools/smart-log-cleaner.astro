---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'smart-log-cleaner')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">
      Smart Log Cleaner &amp; Filter
    </h2>
    <p style="font-size:0.8rem; color:var(--text-muted); margin-bottom:1.25rem;">Paste server logs, toggle filters, download clean output.</p>

    <!-- ── Filter control bar ── -->
    <div style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.875rem; padding:1rem 1.125rem; margin-bottom:1rem;">

      <!-- Row 1: HTTP status codes -->
      <div style="margin-bottom:0.875rem;">
        <div style="font-size:0.7rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.5rem;">HTTP Status Codes — strip matching lines</div>
        <div style="display:flex; flex-wrap:wrap; gap:0.375rem;" id="status-toggles">
          <!-- Injected by JS -->
        </div>
      </div>

      <!-- Divider -->
      <div style="border-top:1px solid var(--border); margin-bottom:0.875rem;"></div>

      <!-- Row 2: Pattern filters -->
      <div style="margin-bottom:0.875rem;">
        <div style="font-size:0.7rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.5rem;">Quick Filters</div>
        <div style="display:flex; flex-wrap:wrap; gap:0.375rem;" id="pattern-toggles">
          <!-- Injected by JS -->
        </div>
      </div>

      <!-- Divider -->
      <div style="border-top:1px solid var(--border); margin-bottom:0.875rem;"></div>

      <!-- Row 3: Custom regex -->
      <div>
        <div style="font-size:0.7rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.5rem;">Custom Pattern (regex) — strip matching lines</div>
        <div style="display:flex; gap:0.5rem; align-items:center;">
          <input id="custom-regex" type="text" placeholder="e.g. /healthz|/ping|bot"
            style="flex:1; padding:0.45rem 0.75rem; background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.5rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); outline:none; transition:border-color 0.15s; min-width:0;"
            onfocus="this.style.borderColor='#1D4ED8';" onblur="this.style.borderColor='var(--border)';" />
          <span id="regex-error" style="font-size:0.72rem; color:#DC2626; white-space:nowrap; display:none;">Invalid regex</span>
        </div>
      </div>
    </div>

    <!-- ── Input / Output panels ── -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:1rem;" class="log-panels">

      <!-- Input -->
      <div style="display:flex; flex-direction:column; gap:0.375rem;">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <label style="font-size:0.72rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em;">Input Log</label>
          <button id="btn-load-sample" style="font-size:0.72rem; color:var(--color-brand-blue); background:none; border:none; cursor:pointer; font-weight:600; padding:0; transition:color 0.15s;"
            onmouseover="this.style.color='var(--color-brand-blue)';" onmouseout="this.style.color='var(--color-brand-blue)';">Load Sample</button>
        </div>
        <textarea id="log-input" placeholder="Paste server log lines here…"
          style="width:100%; height:260px; padding:0.75rem; background:#0B1120; border:1.5px solid var(--border); border-radius:0.625rem; font-family:'Fira Code',monospace; font-size:0.72rem; color:#94A3B8; resize:vertical; box-sizing:border-box; outline:none; line-height:1.7; transition:border-color 0.15s;"
          onfocus="this.style.borderColor='#1D4ED8';" onblur="this.style.borderColor='var(--border)';"
          spellcheck="false"></textarea>
        <div id="input-stats" style="font-size:0.7rem; color:var(--text-muted);">0 lines</div>
      </div>

      <!-- Output -->
      <div style="display:flex; flex-direction:column; gap:0.375rem;">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <label style="font-size:0.72rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em;">Cleaned Output</label>
          <div style="display:flex; gap:0.625rem; align-items:center;">
            <button id="btn-copy-out" style="font-size:0.72rem; color:var(--color-brand-blue); background:none; border:none; cursor:pointer; font-weight:600; padding:0; transition:color 0.15s;"
              onmouseover="this.style.color='var(--color-brand-blue)';" onmouseout="this.style.color='var(--color-brand-blue)';">Copy</button>
            <button id="btn-download" style="font-size:0.72rem; color:#059669; background:none; border:none; cursor:pointer; font-weight:600; padding:0; transition:color 0.15s;"
              onmouseover="this.style.color='#047857';" onmouseout="this.style.color='#059669';">↓ Download</button>
          </div>
        </div>
        <textarea id="log-output" readonly
          style="width:100%; height:260px; padding:0.75rem; background:#0B1120; border:1.5px solid var(--border); border-radius:0.625rem; font-family:'Fira Code',monospace; font-size:0.72rem; color:#86EFAC; resize:vertical; box-sizing:border-box; outline:none; line-height:1.7;"
          spellcheck="false"></textarea>
        <div id="output-stats" style="font-size:0.7rem; color:var(--text-muted);">0 lines · 0 removed</div>
      </div>
    </div>

    <!-- ── Summary bar ── -->
    <div id="summary-bar" style="background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.875rem 1rem; display:none;">
      <div style="font-size:0.72rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.07em; margin-bottom:0.625rem;">Filter Summary</div>
      <div id="summary-content" style="display:flex; flex-wrap:wrap; gap:0.5rem; font-size:0.78rem; color:var(--text-secondary);"></div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       HOW TO USE
  ══════════════════════════════════════════════ -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Smart Log Cleaner</h2>
    <p class="seo-p">Server logs grow fast, and finding the signal in a mountain of noise can waste hours of your day. Health checks, bot traffic, and static asset requests routinely make up 40 to 60 percent of access logs, burying the errors and slow requests that actually matter. This filter strips away the clutter so you can focus on the lines that need attention.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">DevOps On-Call</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">You just got paged at 3 AM because response times spiked. You pull a 50,000-line access log from the last hour, but half of it is health check hits from your load balancer. Toggle the Health Checks filter and strip 200-status lines to isolate the 4xx and 5xx entries in seconds.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Marketing Analyst</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">You need to report organic search traffic, but bot crawlers like Googlebot and bingbot are inflating your pageview counts by 15 to 25 percent. Enable the Known Bots filter to remove crawler lines, then export the cleaned log for your analytics pipeline.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Frontend Developer</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">You suspect a broken CSS file is causing layout issues on production. Paste your access log, filter for 404 responses and static asset patterns, and pinpoint the missing stylesheet in under a minute.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Security Auditor</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A suspicious DELETE request with a 403 response keeps appearing in your logs. Apply a custom regex filter to isolate all DELETE and PUT requests, then cross-reference with your authentication logs to trace the source.</p>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       HOW IT WORKS
  ══════════════════════════════════════════════ -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Smart Log Cleaner Works</h2>
    <p class="seo-p">Smart Log Cleaner reads your log text line by line, matches each line against active filter patterns, and removes any line that hits a match. All processing happens locally, so your log data never leaves your device.</p>
    <h3 class="font-display seo-h3-sm">Pattern Detection Engine</h3>
    <p class="seo-p">The pattern engine identifies common log structures by scanning for recurring field patterns such as IP addresses in dotted-quad format, timestamps in common formats like Apache bracket notation, and HTTP methods (GET, POST, PUT, DELETE). It builds a format profile from the first few hundred lines, then applies that profile to validate and categorize the rest. For example, given a 10,000-line Nginx access log, the engine detects the combined log format after analyzing the first 50 lines and uses that profile to correctly identify field boundaries across the entire file.</p>
    <h3 class="font-display seo-h3-sm">Deduplication &amp; Trimming</h3>
    <p class="seo-p">Deduplication compares each line against previously seen lines using an exact string match. The first occurrence is always kept, and subsequent duplicates are counted and removed. Trimming strips leading and trailing whitespace from every line, normalizes line endings to a consistent format, and collapses sequences of blank lines down to a single separator. In a typical log rotation scenario, you might find that 800 out of 12,000 lines are exact duplicates from overlapping rotation windows, and trimming removes another 200 lines of blank or whitespace-only entries.</p>
    <h3 class="font-display seo-h3-sm">Reformatting &amp; Output</h3>
    <p class="seo-p">Reformatting transforms each kept line into a consistent structure using configurable field orderings and timestamp patterns. You can normalize timestamps to ISO 8601, reorder fields to put the timestamp first, or strip optional fields like the referrer header. The cleaned output is presented in the output panel and can be copied to the clipboard or downloaded as a timestamped <code class="inline-code">.log</code> file. After filtering a 25,000-line log down to 6,500 lines, the download generates a single file ready for import into your analysis tools.</p>
  </div>

  <!-- ══════════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════════ -->
  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Are my logs sent to a server?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">No. All processing happens locally using JavaScript. Your log data never leaves your device and is never transmitted anywhere. This makes the tool safe for use with sensitive production logs containing IP addresses, user agents, and request paths.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What log formats does the cleaner support?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Any plain-text, newline-delimited log format works. This includes Apache Combined Log Format, Nginx access logs, Node.js stdout, JSON-per-line logs, systemd journal exports, and AWS CloudWatch log exports. The tool treats each line independently, so even mixed-format logs can be filtered by line-level patterns.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I filter out a specific endpoint?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Type the endpoint path in the Custom Pattern field. For example, typing /api/healthcheck will strip all lines containing that string. For multiple endpoints, use the pipe operator: /healthcheck|/metrics|/ping. You can also combine this with regex anchors like ^ to match only lines that start with the pattern.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I filter logs by severity level?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. The Quick Filters section provides toggle buttons for common log levels such as ERROR, WARN, INFO, and DEBUG. You can also combine these with the Custom Pattern field to target specific severity strings like FATAL or CRITICAL. Multiple filters can be active simultaneously, and each filter match count appears in the summary bar.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the maximum log size?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">There is no hard limit on input size. In practice, very large logs over 50 MB may cause the browser tab to slow down due to memory constraints. For typical access logs up to a few megabytes, the tool handles them instantly. Logs with 100,000 lines or fewer generally process in under two seconds.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does this compare to using grep or sed?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">grep and sed are powerful command-line tools, but they require syntax knowledge and terminal access. This tool provides a visual interface with one-click filters for common patterns like health checks and bot traffic. For quick log exploration without memorizing regex flags, the visual toggle approach is faster for most users.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What happens if my log contains binary data?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The tool operates on plain text only. Binary characters in your log input may cause unexpected behavior in pattern matching. If your log file contains binary headers or encoded payloads, strip those sections before pasting. Plain-text exports from standard logging frameworks work without issues.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why are some lines not removed when I expect them to be?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Filters match against the exact text of each line. A health check endpoint like /healthz must appear verbatim in the log line to be matched. If your logs use a different path or include query parameters, adjust the pattern accordingly. The Custom Pattern field accepts any valid regular expression for precise matching.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<style>
  /* Stack panels on mobile */
  @media (max-width: 640px) {
    .log-panels {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  // ── Filter definitions ────────────────────────────────────

  interface StatusFilter {
    id: string;
    label: string;
    pattern: RegExp;
    color: string;
    bg: string;
    activeBg: string;
  }

  interface PatternFilter {
    id: string;
    label: string;
    description: string;
    pattern: RegExp;
  }

  const STATUS_FILTERS: StatusFilter[] = [
    { id: 's2xx', label: '2xx', pattern: /\s(2\d{2})\s/, color: '#059669', bg: 'rgba(5,150,105,0.08)',   activeBg: 'rgba(5,150,105,0.18)'   },
    { id: 's3xx', label: '3xx', pattern: /\s(3\d{2})\s/, color: '#1D4ED8', bg: 'rgba(29,78,216,0.08)',   activeBg: 'rgba(29,78,216,0.18)'   },
    { id: 's4xx', label: '4xx', pattern: /\s(4\d{2})\s/, color: '#D97706', bg: 'rgba(217,119,6,0.08)',   activeBg: 'rgba(217,119,6,0.18)'   },
    { id: 's5xx', label: '5xx', pattern: /\s(5\d{2})\s/, color: '#DC2626', bg: 'rgba(220,38,38,0.08)',   activeBg: 'rgba(220,38,38,0.18)'   },
    { id: 's200', label: '200', pattern: /\s200\s/,      color: '#059669', bg: 'rgba(5,150,105,0.08)',   activeBg: 'rgba(5,150,105,0.18)'   },
    { id: 's301', label: '301', pattern: /\s301\s/,      color: '#1D4ED8', bg: 'rgba(29,78,216,0.08)',   activeBg: 'rgba(29,78,216,0.18)'   },
    { id: 's302', label: '302', pattern: /\s302\s/,      color: '#1D4ED8', bg: 'rgba(29,78,216,0.08)',   activeBg: 'rgba(29,78,216,0.18)'   },
    { id: 's304', label: '304', pattern: /\s304\s/,      color: '#64748B', bg: 'rgba(100,116,139,0.08)', activeBg: 'rgba(100,116,139,0.18)' },
    { id: 's400', label: '400', pattern: /\s400\s/,      color: '#D97706', bg: 'rgba(217,119,6,0.08)',   activeBg: 'rgba(217,119,6,0.18)'   },
    { id: 's401', label: '401', pattern: /\s401\s/,      color: '#D97706', bg: 'rgba(217,119,6,0.08)',   activeBg: 'rgba(217,119,6,0.18)'   },
    { id: 's403', label: '403', pattern: /\s403\s/,      color: '#D97706', bg: 'rgba(217,119,6,0.08)',   activeBg: 'rgba(217,119,6,0.18)'   },
    { id: 's404', label: '404', pattern: /\s404\s/,      color: '#D97706', bg: 'rgba(217,119,6,0.08)',   activeBg: 'rgba(217,119,6,0.18)'   },
    { id: 's500', label: '500', pattern: /\s500\s/,      color: '#DC2626', bg: 'rgba(220,38,38,0.08)',   activeBg: 'rgba(220,38,38,0.18)'   },
    { id: 's502', label: '502', pattern: /\s502\s/,      color: '#DC2626', bg: 'rgba(220,38,38,0.08)',   activeBg: 'rgba(220,38,38,0.18)'   },
    { id: 's503', label: '503', pattern: /\s503\s/,      color: '#DC2626', bg: 'rgba(220,38,38,0.08)',   activeBg: 'rgba(220,38,38,0.18)'   },
  ];

  const PATTERN_FILTERS: PatternFilter[] = [
    { id: 'pf-health',     label: '🩺 Health checks',     description: '/healthz /ping /_health /status /ready /live', pattern: /\/healthz|\/ping|\/ready|\/live(?:ness)?|\/status|\/health(?:check)?|\"GET \/ |\"HEAD \/ / },
    { id: 'pf-bots',       label: '🤖 Known bots',         description: 'Googlebot, bingbot, Slurp, DuckDuckBot, etc.',  pattern: /Googlebot|bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|Sogou|Exabot|facebot|ia_archiver|msnbot|Yahoo/i },
    { id: 'pf-static',     label: '📁 Static assets',      description: '.css .js .ico .png .jpg .woff .svg',            pattern: /\.(css|js|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|map|webp)\b/ },
    { id: 'pf-options',    label: '⚙️  OPTIONS requests',   description: 'CORS preflight requests',                      pattern: /"OPTIONS / },
    { id: 'pf-timestamps', label: '🕐 Timestamp-only',     description: 'Lines that contain only a timestamp',           pattern: /^\[?\d{2}[\/:]\d{2}[\/:]\d{4}[\s\]:T]+\d{2}:\d{2}:\d{2}[\]Z\s]*$/ },
    { id: 'pf-empty',      label: '⬜ Blank lines',         description: 'Empty or whitespace-only lines',               pattern: /^\s*$/ },
  ];

  // ── State ─────────────────────────────────────────────────
  const activeStatus  = new Set<string>();
  const activePattern = new Set<string>();
  let customRegex: RegExp | null = null;

  // ── Render toggle buttons ─────────────────────────────────
  const statusContainer  = document.getElementById('status-toggles')!;
  const patternContainer = document.getElementById('pattern-toggles')!;

  function makeStatusToggle(f: StatusFilter) {
    const btn = document.createElement('button');
    btn.dataset.id = f.id;
    btn.style.cssText = `
      padding:0.3rem 0.7rem;
      border-radius:999px;
      font-family:'Fira Code',monospace;
      font-size:0.75rem;
      font-weight:700;
      cursor:pointer;
      border:1.5px solid ${f.color}40;
      background:${f.bg};
      color:${f.color};
      transition:all 0.15s;
      letter-spacing:0.03em;
    `;
    btn.textContent = f.label;
    btn.addEventListener('click', () => {
      const isActive = activeStatus.has(f.id);
      if (isActive) {
        activeStatus.delete(f.id);
        btn.style.background = f.bg;
        btn.style.borderColor = f.color + '40';
        btn.style.boxShadow = 'none';
        btn.style.opacity = '1';
      } else {
        activeStatus.add(f.id);
        btn.style.background = f.activeBg;
        btn.style.borderColor = f.color;
        btn.style.boxShadow = `0 0 0 2px ${f.color}30`;
        btn.style.opacity = '1';
      }
      // Visual strike-through effect on active filters
      btn.style.textDecoration = activeStatus.has(f.id) ? 'line-through' : 'none';
      applyFilters();
    });
    return btn;
  }

  function makePatternToggle(f: PatternFilter) {
    const btn = document.createElement('button');
    btn.dataset.id = f.id;
    btn.title = f.description;
    btn.style.cssText = `
      padding:0.35rem 0.75rem;
      border-radius:0.5rem;
      font-size:0.78rem;
      font-weight:600;
      cursor:pointer;
      border:1.5px solid var(--border);
      background:var(--bg-surface);
      color:var(--text-secondary);
      transition:all 0.15s;
      white-space:nowrap;
    `;
    btn.textContent = f.label;
    btn.addEventListener('mouseenter', () => {
      if (!activePattern.has(f.id)) btn.style.borderColor = '#1D4ED8';
    });
    btn.addEventListener('mouseleave', () => {
      if (!activePattern.has(f.id)) btn.style.borderColor = 'var(--border)';
    });
    btn.addEventListener('click', () => {
      if (activePattern.has(f.id)) {
        activePattern.delete(f.id);
        btn.style.background = 'var(--bg-surface)';
        btn.style.borderColor = 'var(--border)';
        btn.style.color = 'var(--text-secondary)';
        btn.style.textDecoration = 'none';
      } else {
        activePattern.add(f.id);
        btn.style.background = 'rgba(29,78,216,0.09)';
        btn.style.borderColor = '#1D4ED8';
        btn.style.color = '#1D4ED8';
        btn.style.textDecoration = 'line-through';
      }
      applyFilters();
    });
    return btn;
  }

  STATUS_FILTERS.forEach(f  => statusContainer.appendChild(makeStatusToggle(f)));
  PATTERN_FILTERS.forEach(f => patternContainer.appendChild(makePatternToggle(f)));

  // ── Filter engine ─────────────────────────────────────────
  interface FilterResult {
    kept: string[];
    removedByFilter: Map<string, number>;
    totalRemoved: number;
  }

  function applyFilters(): void {
    const raw   = (document.getElementById('log-input') as HTMLTextAreaElement).value;
    const lines = raw === '' ? [] : raw.split('\n');

    const inputStats = document.getElementById('input-stats')!;
    inputStats.textContent = `${lines.length} line${lines.length !== 1 ? 's' : ''}`;

    // Build active filter list
    const activeFilters: { id: string; label: string; pattern: RegExp }[] = [];
    STATUS_FILTERS.forEach(f  => { if (activeStatus.has(f.id))  activeFilters.push({ id: f.id, label: f.label, pattern: f.pattern }); });
    PATTERN_FILTERS.forEach(f => { if (activePattern.has(f.id)) activeFilters.push({ id: f.id, label: f.label, pattern: f.pattern }); });
    if (customRegex) activeFilters.push({ id: 'custom', label: 'Custom', pattern: customRegex });

    const removedByFilter = new Map<string, number>();
    activeFilters.forEach(f => removedByFilter.set(f.id, 0));

    const kept: string[] = [];

    for (const line of lines) {
      let remove = false;
      for (const f of activeFilters) {
        if (f.pattern.test(line)) {
          removedByFilter.set(f.id, (removedByFilter.get(f.id) ?? 0) + 1);
          remove = true;
          // Don't break — count all matching filters for summary
        }
      }
      if (!remove) kept.push(line);
    }

    const totalRemoved = lines.length - kept.length;

    // Update output
    const outputEl = document.getElementById('log-output') as HTMLTextAreaElement;
    outputEl.value = kept.join('\n');

    const outputStats = document.getElementById('output-stats')!;
    outputStats.textContent = `${kept.length} line${kept.length !== 1 ? 's' : ''} · ${totalRemoved} removed`;
    outputStats.style.color = totalRemoved > 0 ? '#059669' : 'var(--text-muted)';

    // Summary bar
    const summaryBar     = document.getElementById('summary-bar')!;
    const summaryContent = document.getElementById('summary-content')!;

    if (activeFilters.length > 0 && lines.length > 0) {
      summaryBar.style.display = 'block';
      summaryContent.innerHTML = activeFilters.map(f => {
        const count = removedByFilter.get(f.id) ?? 0;
        return `<span style="display:inline-flex; align-items:center; gap:0.3rem; padding:0.25rem 0.6rem; background:var(--bg-surface); border:1px solid var(--border); border-radius:999px; font-size:0.75rem; font-family:'Fira Code',monospace;">
          <span style="color:var(--text-muted);">${f.label}</span>
          <span style="color:${count > 0 ? '#DC2626' : 'var(--text-muted)'}; font-weight:700;">−${count}</span>
        </span>`;
      }).join('');
    } else {
      summaryBar.style.display = 'none';
    }
  }

  // ── Input wiring ──────────────────────────────────────────
  document.getElementById('log-input')!.addEventListener('input', applyFilters);

  // Custom regex
  document.getElementById('custom-regex')!.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value.trim();
    const errEl = document.getElementById('regex-error')!;
    if (!val) {
      customRegex = null;
      errEl.style.display = 'none';
      applyFilters();
      return;
    }
    try {
      customRegex = new RegExp(val);
      errEl.style.display = 'none';
    } catch {
      customRegex = null;
      errEl.style.display = 'inline';
    }
    applyFilters();
  });

  // Copy output
  document.getElementById('btn-copy-out')!.addEventListener('click', () => {
    const val = (document.getElementById('log-output') as HTMLTextAreaElement).value;
    if (!val) return;
    navigator.clipboard.writeText(val).then(() => {
      const btn = document.getElementById('btn-copy-out')!;
      btn.textContent = '✓ Copied!';
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  });

  // Download output
  document.getElementById('btn-download')!.addEventListener('click', () => {
    const val = (document.getElementById('log-output') as HTMLTextAreaElement).value;
    if (!val) return;
    const blob = new Blob([val], { type: 'text/plain' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = `cleaned-${Date.now()}.log`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Sample log
  const SAMPLE_LOG = `127.0.0.1 - frank [10/Oct/2024:13:55:36 -0700] "GET /apache_pb.gif HTTP/1.0" 200 2326 "http://www.example.com/start.html" "Mozilla/4.08 [en] (Win98; I ;Nav)"
