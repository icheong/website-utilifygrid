---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'unix-timestamp-converter')!;
---
<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Unix Timestamp Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Convert Unix timestamps to human-readable formats — or get the current timestamp now.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.25rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="ts-input">Unix Timestamp</label>
        <input id="ts-input" type="text" placeholder="e.g. 1735689600 or 1735689600000"
          class="input-themed"
          style="width:100%;padding:0.6rem 0.875rem;border-radius:0.5rem;font-size:1rem;font-family:'Fira Code',monospace;font-weight:600;box-sizing:border-box;" />
      </div>
      <button id="btn-now" class="btn-secondary" type="button" style="white-space:nowrap;">Use now</button>
    </div>

    <div id="results" style="display:none;flex-direction:column;gap:0.375rem;">
      <div class="info-row">
        <span class="info-label">UTC</span>
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <span class="info-value" id="out-utc"></span>
          <button class="btn-secondary copy-val" data-target="out-utc" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      </div>
      <div class="info-row">
        <span class="info-label">ISO 8601</span>
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <span class="info-value" id="out-iso"></span>
          <button class="btn-secondary copy-val" data-target="out-iso" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      </div>
      <div class="info-row">
        <span class="info-label">Local time</span>
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <span class="info-value" id="out-local"></span>
          <button class="btn-secondary copy-val" data-target="out-local" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      </div>
      <div class="info-row">
        <span class="info-label">Relative</span>
        <span class="info-value" id="out-relative"></span>
      </div>
      <div class="info-row">
        <span class="info-label">Day of week</span>
        <span class="info-value" id="out-dow"></span>
      </div>
      <div class="info-row">
        <span class="info-label">Milliseconds</span>
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <span class="info-value" id="out-ms"></span>
          <button class="btn-secondary copy-val" data-target="out-ms" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      </div>
    </div>

    <p id="ts-error" style="display:none;color:#EF4444;font-size:0.82rem;margin-top:0.75rem;"></p>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.2rem;font-weight:700;color:var(--text-primary);margin-bottom:0.75rem;">How to use the Unix Timestamp Converter</h2>
    <p style="color:var(--text-secondary);font-size:0.9rem;line-height:1.75;margin-bottom:0.75rem;">Type or paste a Unix timestamp (in seconds or milliseconds) into the field. The tool auto-detects the unit based on the magnitude of the value. Results update instantly. Click <strong>Use now</strong> to convert the current moment.</p>
    <p style="color:var(--text-secondary);font-size:0.9rem;line-height:1.75;">Copy buttons are provided for each format for quick pasting into code, docs, or databases.</p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.2rem;font-weight:700;color:var(--text-primary);margin-bottom:0.875rem;">Format reference</h2>
    <div style="display:flex;flex-direction:column;gap:0.5rem;">
      <div class="info-row"><span class="info-label">Seconds</span><span class="info-value">Values &lt; 10¹² treated as seconds</span></div>
      <div class="info-row"><span class="info-label">Milliseconds</span><span class="info-value">Values ≥ 10¹² treated as milliseconds</span></div>
      <div class="info-row"><span class="info-label">Unix epoch</span><span class="info-value">Seconds since 1970-01-01T00:00:00Z</span></div>
      <div class="info-row"><span class="info-label">ISO 8601</span><span class="info-value">YYYY-MM-DDTHH:mm:ss.sssZ</span></div>
    </div>
  </div>

  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.2rem;font-weight:700;color:var(--text-primary);margin-bottom:1.25rem;">Frequently asked questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {q:'How do I know if my timestamp is in seconds or milliseconds?',a:'Timestamps in seconds are typically 10 digits (e.g. 1735689600). Millisecond timestamps are 13 digits (e.g. 1735689600000). This tool detects the unit automatically based on the magnitude.'},
        {q:'What is the Unix epoch?',a:'The Unix epoch is the starting point for Unix timestamps: midnight UTC on 1 January 1970 (1970-01-01T00:00:00Z). All Unix timestamps count seconds (or milliseconds) from this reference point.'},
        {q:'Why does my timestamp show a different local time?',a:'Local time is displayed in your browser\'s configured timezone. If you are in UTC+10 (Sydney), a UTC timestamp of 12:00 will show as 22:00 local. The UTC and ISO fields are always timezone-independent.'},
        {q:'What is the maximum date this can convert?',a:'JavaScript\'s Date object supports values up to approximately 8640000000000000 ms, which corresponds to September 13, 275760 CE. Values outside this range are not supported.'},
      ].map(item=>(
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" style="background:var(--bg-surface);border:1.5px solid var(--border);border-radius:0.875rem;padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem;font-weight:600;color:var(--text-primary);margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem;color:var(--text-secondary);line-height:1.7;margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  const DAYS = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];

  function relativeTime(ms: number): string {
    const diff = ms - Date.now();
    const abs  = Math.abs(diff);
    const future = diff > 0;
    if (abs < 60000)    return 'just now';
    if (abs < 3600000)  return `${Math.round(abs/60000)} min ${future?'from now':'ago'}`;
    if (abs < 86400000) return `${Math.round(abs/3600000)} hr ${future?'from now':'ago'}`;
    return `${Math.round(abs/86400000)} days ${future?'from now':'ago'}`;
  }

  function decode(raw: string) {
    const err = document.getElementById('ts-error')!;
    const res = document.getElementById('results')!;
    err.style.display = 'none';
    if (!raw.trim()) { res.style.display = 'none'; return; }

    const n = parseFloat(raw.trim());
    if (isNaN(n)) { err.textContent = 'Enter a numeric Unix timestamp.'; err.style.display='block'; res.style.display='none'; return; }

    const ms = n >= 1e12 ? n : n * 1000;
    const d  = new Date(ms);
    if (isNaN(d.getTime())) { err.textContent = 'Timestamp out of range.'; err.style.display='block'; res.style.display='none'; return; }

    (document.getElementById('out-utc')!)      .textContent = d.toUTCString();
    (document.getElementById('out-iso')!)      .textContent = d.toISOString();
    (document.getElementById('out-local')!)    .textContent = d.toLocaleString();
    (document.getElementById('out-relative')!) .textContent = relativeTime(ms);
    (document.getElementById('out-dow')!)      .textContent = DAYS[d.getUTCDay()];
    (document.getElementById('out-ms')!)       .textContent = String(ms);

    res.style.display = 'flex';
  }

  document.getElementById('ts-input')!.addEventListener('input', e => decode((e.target as HTMLInputElement).value));
  document.getElementById('btn-now')!.addEventListener('click', () => {
    const now = String(Math.floor(Date.now()/1000));
    (document.getElementById('ts-input') as HTMLInputElement).value = now;
    decode(now);
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-val').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = document.getElementById(btn.dataset.target!)?.textContent || '';
      navigator.clipboard.writeText(text).then(() => {
        btn.textContent='✓'; btn.classList.add('btn-success');
        setTimeout(()=>{ btn.textContent='Copy'; btn.classList.remove('btn-success'); }, 2000);
      });
    });
  });
</script>
