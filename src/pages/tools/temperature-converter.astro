---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'temperature-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Temperature Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a temperature in any scale — see the conversion in the others instantly. All calculations run in your browser.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="temp-input">Temperature</label>
        <input id="temp-input" type="number" value="100" step="any" placeholder="Enter value"
          class="input-themed" />
      </div>
      <div>
        <label class="tool-label" for="temp-unit">Scale</label>
        <select id="temp-unit" class="select-themed" style="min-width:10rem;">
          <option value="c" selected>Celsius (°C)</option>
          <option value="f">Fahrenheit (°F)</option>
          <option value="k">Kelvin (K)</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Common Reference Points</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Convert Between Celsius, Fahrenheit, and Kelvin</h2>
    <p class="seo-p">
      The recipe says to preheat the oven to 375°F, but your oven only has Celsius markings. Setting it to 375°C would incinerate the cake. Enter 375, select Fahrenheit, and the converter instantly shows 190.56°C and 463.71 K. The copy button lets you paste the Celsius value straight into your oven timer app. For quick reference, the common temperatures strip at the bottom shows water boiling at 100°C / 212°F, so you can sanity-check that 190°C is in the right ballpark for baking.
    </p>
    <p class="seo-p">
      The converter handles all six pairwise conversions — Celsius to Fahrenheit, Celsius to Kelvin, Fahrenheit to Celsius, Fahrenheit to Kelvin, Kelvin to Celsius, and Kelvin to Fahrenheit — using the correct linear formula for each. A chemistry student working with the ideal gas law needs temperature in Kelvin. A traveller in Tokyo sees a 35°C weather forecast and wants to know if that is "wear shorts" or "stay indoors" in Fahrenheit terms. Each conversion appears instantly, no button press required.
    </p>

    <h3 class="font-display seo-h3-sm">Cooking conversions where the wrong scale ruins the dish</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Baking at the wrong oven temperature', 'A French pastry recipe calls for baking choux pastry at 200°C. If you accidentally set a Fahrenheit oven to 200°F, the pastry will not rise at all — choux needs the rapid steam expansion that only happens above 180°C (356°F). The correct Fahrenheit equivalent is 392°F. This tool gives you that conversion instantly, preventing the kind of kitchen disaster that wastes ingredients and time.'],
        ['Converting weather forecasts for travel', 'A British tourist arriving in New York sees a forecast of 85°F and wonders whether to pack a jacket. Converting to Celsius gives 29.4°C — warm shorts weather. Conversely, a New Yorker visiting London sees "18°C" and needs to know that means 64.4°F — a light sweater, not a coat. The converter helps you translate weather intuition across scales without memorising the formula.'],
        ['Lab work requiring Kelvin', 'A physics experiment measures gas temperature at 22°C. For the ideal gas law calculation (PV = nRT), the temperature must be in Kelvin: 22°C + 273.15 = 295.15 K. Using 22 instead of 295.15 in the equation would give a pressure reading roughly 13 times too low. The converter shows the Kelvin value alongside Fahrenheit, so students can verify their manual conversion before plugging it into the equation.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Temperature Converter Handles Three Different Scales</h2>
    <p class="seo-p">
      Unlike length or weight, temperature scales have different zero points and different gap sizes between degrees. The converter handles each of the six possible pairwise conversions with its own formula. Celsius to Fahrenheit multiplies by 1.8 and adds 32. Celsius to Kelvin adds 273.15. Fahrenheit to Celsius subtracts 32 then multiplies by 5/9. The tool applies the correct formula based on which two scales you are converting between, and displays the result to two decimal places.
    </p>

    <h3 class="font-display seo-h3-sm">Why the Celsius-to-Fahrenheit formula is 9/5 plus 32</h3>
    <p class="seo-p-sm">
      The 9/5 multiplier (1.8) exists because Fahrenheit and Celsius use different gap sizes. Water freezes at 0°C and boils at 100°C — a 100-degree span. In Fahrenheit, water freezes at 32°F and boils at 212°F — a 180-degree span. The ratio of those spans is 180/100 = 9/5. The +32 offset exists because Fahrenheit's zero point is 32 degrees below Celsius's zero point. Combining both corrections gives the formula: °F = (°C × 9/5) + 32. The reverse formula reverses the operations: °C = (°F − 32) × 5/9.
    </p>
    <p class="seo-p-sm">
      Kelvin is simpler because it shares Celsius's gap size — 1 kelvin equals exactly 1 degree Celsius. The only difference is the zero point: 0 K = −273.15°C, so converting between them requires only the 273.15 offset. This makes Kelvin-to-Fahrenheit conversions a two-step process: first convert Kelvin to Celsius (subtract 273.15), then apply the Celsius-to-Fahrenheit formula.
    </p>

    <h3 class="font-display seo-h3-sm">The point where both scales read the same number</h3>
    <p class="seo-p-sm">
      Celsius and Fahrenheit intersect at −40 degrees. Setting the two formulas equal and solving: °C × 9/5 + 32 = °C gives °C = −40. This means −40°C = −40°F exactly. It is the only temperature where both scales produce the same number. This is not a useful reference point for everyday life (it is colder than any inhabited place on Earth), but it is a handy verification check: if you convert −40 and get a different number back, your formula is wrong.
    </p>
    <p class="seo-p-none">
      The Kelvin scale has no degree symbol because it is an absolute scale defined by fixing the Boltzmann constant at exactly 1.380649 × 10⁻²³ J/K. The International Bureau of Weights and Measures (BIPM) dropped the degree symbol in 1967 to distinguish kelvins from degrees Celsius. You write "295.15 K", not "295.15°K".
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How do I convert 200°F to Celsius for my oven?",
          a: "200°F equals 93.33°C. The formula is (200 − 32) × 5/9 = 93.33°C. For quick mental estimates, subtract 30 from the Fahrenheit value and divide by 2 — 200 minus 30 is 170, divided by 2 is 85°C. That is close but about 8°C low, so for baking where precision matters (especially for bread and pastries), use the exact formula or this converter."
        },
        {
          q: "What is absolute zero in practical terms?",
          a: "Absolute zero is 0 K, −273.15°C, or −459.67°F. At this temperature, all molecular motion theoretically stops. It has never been achieved in practice — the coldest recorded lab temperature is about 0.000000001 K, achieved by cooling rubidium atoms with lasers. For context, outer space is about 2.7 K (−270.45°C), which is warmer than absolute zero because of the cosmic microwave background radiation."
        },
        {
          q: "Why does my phone weather app show different temperatures than the thermometer?",
          a: "The difference is usually rounding, not a conversion error. A weather app might display 72°F while your thermometer reads 72.2°F, because the app rounds to the nearest whole number. The conversion formula itself is exact: 72°F = 22.22°C. If the discrepancy is larger (more than 2°F), check whether one device is measuring Celsius and displaying a converted value — some thermometers display °F but measure °C internally, introducing a small rounding offset."
        },
        {
          q: "Is 37°C really normal body temperature?",
          a: "37°C (98.6°F) was established as the average normal body temperature by Carl Wunderlich in 1868, based on 25,000 measurements. More recent studies show the average is actually about 36.6°C (97.9°F), and normal range spans from roughly 36.1°C to 37.2°C. Body temperature also varies by time of day (lower in the morning, higher in the evening), so 37°C is a useful reference point but not a strict threshold for fever."
        },
        {
          q: "How do I quickly estimate Celsius to Fahrenheit in my head?",
          a: "Double the Celsius value and add 30. For example, 20°C doubled is 40, plus 30 gives 70°F (actual: 68°F — close). 30°C doubled is 60, plus 30 gives 90°F (actual: 86°F — a bit off). The estimate works best between 10°C and 30°C. Outside that range, the error grows because the 9/5 ratio means each Celsius degree is larger than each Fahrenheit degree."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion functions ─────────────────────────────────────────
  const CONV = {
    c: { f: v => v * 9/5 + 32,       k: v => v + 273.15 },
    f: { c: v => (v - 32) * 5/9,     k: v => (v - 32) * 5/9 + 273.15 },
    k: { c: v => v - 273.15,         f: v => (v - 273.15) * 9/5 + 32 },
  };

  const SCALES = [
    { id: 'c', label: 'Celsius',    abbr: '°C',  decimals: 2 },
    { id: 'f', label: 'Fahrenheit', abbr: '°F',  decimals: 2 },
    { id: 'k', label: 'Kelvin',     abbr: 'K',   decimals: 2 },
  ];

  const input  = document.getElementById('temp-input') as HTMLInputElement;
  const select = document.getElementById('temp-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  // ── Quick-reference temperatures (stored in °C) ────────────────
  const REFS = [
    { name: 'Absolute Zero',      c: -273.15 },
    { name: 'Liquid Nitrogen',    c: -195.79 },
    { name: 'Water Freezes',      c: 0 },
    { name: 'Fridge Temperature', c: 4 },
    { name: 'Room Temperature',   c: 20 },
    { name: 'Body Temperature',   c: 37 },
    { name: 'Oven Baking',        c: 180 },
    { name: 'Water Boils',        c: 100 },
  ];

  function formatResult(value: number): string {
    if (Number.isNaN(value)) return '—';
    return value.toFixed(2);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;

    grid.innerHTML = '';

    SCALES.forEach(scale => {
      if (scale.id === fromUnit) return;
      const converted = CONV[fromUnit][scale.id](val);
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${scale.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitAbbr = SCALES.find(s => s.id === fromUnit)!.abbr;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const toTarget = { c: r.c, f: r.c * 9/5 + 32, k: r.c + 273.15 };
      const value = toTarget[fromUnit];
      const display = formatResult(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitAbbr}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
