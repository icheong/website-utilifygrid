---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'amazon-fba-profit-estimator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Amazon FBA Profit Estimator</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Sale Price ($)</label>
        <input id="price" type="number" value="29.99" min="0.01" step="0.01"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Cost of Goods ($)</label>
        <input id="cogs" type="number" value="8" min="0" step="0.01"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Product Weight (kg)</label>
        <input id="weight" type="number" value="0.5" min="0.01" step="0.01"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Product Category</label>
        <select id="category" class="select-themed">
          <option value="8">Home &amp; Kitchen (8%)</option>
          <option value="8">Sports &amp; Outdoors (8%)</option>
          <option value="15" selected>Electronics (15%)</option>
          <option value="15">Toys &amp; Games (15%)</option>
          <option value="15">Health &amp; Beauty (15%)</option>
          <option value="17">Clothing &amp; Accessories (17%)</option>
          <option value="6">Grocery &amp; Gourmet (6%)</option>
        </select>
      </div>
    </div>

    <!-- Fee breakdown -->
    <div class="result-card" style="margin-bottom:1rem;">
      <div style="font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.75rem;">Fee Breakdown</div>
      <div style="display:flex; flex-direction:column; gap:0.5rem; font-size:0.875rem;">
        {[
          ['Sale Price','out-price-lbl','var(--text-primary)'],
          ['Cost of Goods','out-cogs-lbl','#DC2626'],
          ['Referral Fee','out-ref-fee','#DC2626'],
          ['FBA Fulfillment Fee','out-fba-fee','#DC2626'],
        ].map(([label, id, col]) => (
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">{label}</span>
            <span id={id} style={`font-weight:600; color:${col};`}>—</span>
          </div>
        ))}
        <div style="border-top:1px solid var(--border); padding-top:0.5rem; display:flex; justify-content:space-between; font-weight:700; font-size:0.95rem;">
          <span style="color:var(--text-primary);">Net Profit</span>
          <span id="out-profit" style="color:#16A34A;">—</span>
        </div>
      </div>
    </div>

    <!-- KPI cards -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
      <div class="result-card" style="background:#FFF7ED; border-color:#FED7AA; text-align:center;">
        <div id="out-roi" style="font-family:'Sora',sans-serif; font-size:1.75rem; font-weight:700; color:#F97316;">—%</div>
        <div style="font-size:0.72rem; font-weight:600; color:#FB923C; margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.04em;">ROI</div>
      </div>
      <div class="result-card" style="background:#F0FDF4; border-color:#BBF7D0; text-align:center;">
        <div id="out-margin" style="font-family:'Sora',sans-serif; font-size:1.75rem; font-weight:700; color:#16A34A;">—%</div>
        <div style="font-size:0.72rem; font-weight:600; color:#4ADE80; margin-top:0.2rem; text-transform:uppercase; letter-spacing:0.04em;">Net Margin</div>
      </div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Amazon FBA Profit Estimator</h2>
    <p class="seo-p">Estimate your per-unit profit, ROI, and net margin on any Amazon product before you commit to sourcing. Follow the four steps below to get an accurate fee breakdown.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Enter Product Details</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Input your expected selling price, shipping weight in kilograms, and product category. The category determines Amazon's referral fee percentage applied to each sale.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Set Cost Parameters</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Enter your landed cost of goods per unit, including manufacturing, freight, and packaging. This figure is critical for calculating your true net profit and return on investment.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Select Fulfillment Plan</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Choose between FBA (Fulfillment by Amazon) and FBM (Fulfillment by Merchant) based on your logistics setup. The tool calculates the appropriate fulfillment fees for your selected method and marketplace.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Review Profitability</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Examine the full fee breakdown, including referral fees, fulfillment fees, and your net profit. Check the ROI and margin indicators to determine whether the product meets your profitability thresholds.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Amazon FBA Profit Estimator Works</h2>
    <p class="seo-p">The estimator breaks down every cost Amazon deducts from your sale price so you can see exactly where your profit goes.</p>
    <h3 class="font-display seo-h3-sm">Amazon Fee Calculation Engine</h3>
    <p class="seo-p">Amazon charges a <code class="inline-code">referral fee</code> as a percentage of the sale price, which varies by product category from 6% (grocery) to 17% (clothing). On top of that, the <code class="inline-code">FBA fulfillment fee</code> is a per-unit charge based on weight tiers — for example, items under 250g cost roughly $3.22 while items between 500g and 1kg cost about $5.40. The tool applies both fees to give you the total Amazon take per unit.</p>
    <h3 class="font-display seo-h3-sm">FBA vs FBM Cost Comparison</h3>
    <p class="seo-p">When you select FBA, the tool includes Amazon's per-unit fulfillment fee and estimates monthly <code class="inline-code">storage fees</code> based on product dimensions. Under FBM, those fulfillment fees are replaced with your own shipping costs, and you handle packing and customer service. This comparison helps you decide whether paying Amazon to handle logistics makes financial sense for your product.</p>
    <h3 class="font-display seo-h3-sm">Break-Even and ROI Analysis</h3>
    <p class="seo-p">The tool calculates <code class="inline-code">net margin</code> (profit divided by sale price) and <code class="inline-code">ROI</code> (profit divided by cost of goods). These metrics tell you whether a product is worth pursuing. A healthy Amazon FBA product typically targets a net margin above 20% and an ROI above 50%, which leaves room for advertising spend, returns, and unexpected cost increases.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between FBA and FBM fees?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">FBA (Fulfillment by Amazon) charges a per-unit fulfillment fee based on product weight, plus monthly storage fees for inventory held in Amazon's warehouses. FBM (Fulfillment by Merchant) eliminates those Amazon fulfillment charges, but you must cover your own warehousing, packing, shipping, and customer service costs. FBA fees are predictable and scale with volume, while FBM costs depend entirely on your logistics setup.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How accurate are the Amazon fee estimates?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The estimator uses Amazon's published referral fee rates and standard FBA weight-based fulfillment tiers, so the figures are a reliable baseline for planning. However, actual fees can vary due to dimensional weight pricing, category-specific minimums, and seasonal surcharges. Always cross-check your estimates in Amazon Seller Central's Revenue Calculator before finalizing sourcing decisions.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What other costs should I factor in?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Beyond referral and FBA fulfillment fees, budget for Amazon PPC advertising (typically 5 to 20 percent of revenue for new listings), monthly storage fees ($0.75 to $2.40 per cubic foot depending on season), product photography, listing optimization, return processing, and the $39.99 per month Professional selling plan fee. These hidden costs can quickly erode margins if not accounted for upfront.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is a healthy ROI for Amazon FBA?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Most experienced FBA sellers target a minimum 30 percent ROI on cost of goods before advertising spend. After factoring in PPC, returns, and storage, a sustainable product typically delivers 20 to 50 percent ROI. Anything below 20 percent is difficult to scale profitably once all operational costs are included, especially in competitive categories with rising ad bids.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does Amazon charge VAT or GST on fees?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes, Amazon charges GST on fees for Australian sellers and VAT on EU marketplace fees. These taxes are applied on top of the referral and fulfillment fees shown in this tool and are separate from product-level sales tax. If you are not registered for GST or VAT, these charges reduce your net margin and should be factored into your pricing strategy.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">When do FBA fees increase?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Amazon typically updates FBA fees once a year, with increases most commonly announced in January or February. Peak season storage surcharges also apply from October through December. Review the current fee schedule in Seller Central before committing to large sourcing orders, as even small per-unit increases can significantly impact profitability at scale.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
  function getFbaFee(weightKg: number): number {
    if (weightKg <= 0.25) return 3.22;
    if (weightKg <= 0.50) return 4.75;
    if (weightKg <= 1.00) return 5.40;
    if (weightKg <= 2.00) return 6.10;
    return 6.50 + Math.ceil((weightKg - 2) * 10) * 0.38;
  }

  function fmt(n: number, dec = 2) { return '$' + n.toFixed(dec); }

  function calc() {
    const price    = parseFloat((document.getElementById('price') as HTMLInputElement).value)    || 0;
    const cogs     = parseFloat((document.getElementById('cogs') as HTMLInputElement).value)     || 0;
    const weight   = parseFloat((document.getElementById('weight') as HTMLInputElement).value)   || 0;
    const refPct   = parseFloat((document.getElementById('category') as HTMLSelectElement).value) || 15;

    const refFee   = price * refPct / 100;
    const fbaFee   = getFbaFee(weight);
    const profit   = price - cogs - refFee - fbaFee;
    const roi      = cogs > 0 ? profit / cogs * 100 : 0;
    const margin   = price > 0 ? profit / price * 100 : 0;

    (document.getElementById('out-price-lbl') as HTMLElement).textContent = fmt(price);
    (document.getElementById('out-cogs-lbl') as HTMLElement).textContent  = '−' + fmt(cogs);
    (document.getElementById('out-ref-fee') as HTMLElement).textContent   = '−' + fmt(refFee);
    (document.getElementById('out-fba-fee') as HTMLElement).textContent   = '−' + fmt(fbaFee);
    const profitEl = document.getElementById('out-profit') as HTMLElement;
    profitEl.textContent = fmt(profit);
    profitEl.style.color = profit >= 0 ? '#16A34A' : '#DC2626';

    (document.getElementById('out-roi') as HTMLElement).textContent    = roi.toFixed(1) + '%';
    (document.getElementById('out-roi') as HTMLElement).style.color    = roi >= 30 ? '#16A34A' : roi >= 0 ? '#F97316' : '#DC2626';
    (document.getElementById('out-margin') as HTMLElement).textContent = margin.toFixed(1) + '%';
    (document.getElementById('out-margin') as HTMLElement).style.color = margin >= 20 ? '#16A34A' : margin >= 0 ? '#F97316' : '#DC2626';
  }

  ['price','cogs','weight','category'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));
  calc();
</script>
