---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'code-diff-checker')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Code Diff Checker</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
      <div>
        <label style="font-size:0.75rem; font-weight:600; color:#DC2626; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.35rem;">Original (A)</label>
        <textarea id="diff-a" placeholder="Paste original text or code here…"
          style="width:100%; height:180px; padding:0.75rem; border:1.5px solid #FECACA; border-radius:0.625rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); resize:vertical; box-sizing:border-box; outline:none; line-height:1.5; background:var(--bg-surface);"></textarea>
      </div>
      <div>
        <label style="font-size:0.75rem; font-weight:600; color:#16A34A; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.35rem;">Modified (B)</label>
        <textarea id="diff-b" placeholder="Paste modified text or code here…"
          style="width:100%; height:180px; padding:0.75rem; border:1.5px solid #BBF7D0; border-radius:0.625rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); resize:vertical; box-sizing:border-box; outline:none; line-height:1.5; background:var(--bg-surface);"></textarea>
      </div>
    </div>

    <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
      <button id="run-diff" class="btn-primary">Compare</button>
      <div id="diff-stats" style="display:flex; align-items:center; gap:0.75rem; font-size:0.82rem;"></div>
    </div>

    <div id="diff-output" style="background:var(--bg-surface); border:1px solid var(--border); border-radius:0.875rem; padding:1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.75; max-height:400px; overflow-y:auto; white-space:pre-wrap; word-break:break-all; display:none;"></div>
    <div id="diff-placeholder" style="text-align:center; padding:2rem; color:var(--text-muted); font-size:0.875rem; background:var(--bg-surface-2); border:1px dashed var(--border); border-radius:0.875rem;">Paste text in both panels and click Compare.</div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Code Diff Checker</h2>
    <p class="seo-p">Compare two versions of text or code side-by-side and instantly see every addition, deletion, and modification highlighted.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Paste Original Code</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Enter the original version of your text or code into the left panel labeled A.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Paste Modified Code</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Enter the changed version of your text or code into the right panel labeled B.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Choose Diff Mode</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Select from unified, split, or inline diff views to match your review workflow.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Analyze Results</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">View additions, deletions, and modifications highlighted in green, red, and grey for quick analysis.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Code Diff Checker Works</h2>
    <p class="seo-p">Under the hood, the Code Diff Checker uses a longest common subsequence algorithm to detect every difference between your two inputs.</p>
    <h3 class="font-display seo-h3-sm">Diff Algorithm Engine</h3>
    <p class="seo-p">Both inputs are split into individual lines. The tool computes a longest common subsequence (LCS) matrix to identify which lines are shared and which have changed, producing an optimal edit script.</p>
    <h3 class="font-display seo-h3-sm">Highlight and Categorization</h3>
    <p class="seo-p">Lines present only in the original are marked as <code class="inline-code">removed</code> in red. Lines present only in the modified version are marked as <code class="inline-code">added</code> in green. This makes it easy to scan for exactly what changed.</p>
    <h3 class="font-display seo-h3-sm">Context-Aware Comparison</h3>
    <p class="seo-p">Unchanged lines between modifications are preserved as <code class="inline-code">context</code> lines in grey, giving you surrounding code or text to orient yourself within the diff output.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I diff binary files?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">This tool works on text content only. Binary files like images, PDFs, and executables cannot be meaningfully compared as text. For binary comparison, use dedicated tools such as Beyond Compare or run git diff --binary in version-controlled repositories.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Is whitespace significant in the comparison?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. This tool performs exact line-by-line comparison, so a line that differs only in trailing whitespace or indentation will be flagged as changed. This is intentional for code where indentation matters. Strip trailing whitespace in your editor before comparing if you want to ignore it.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I use this for a code review?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Copy the old version of a function or file into panel A and the new version into panel B. The diff output shows exactly what changed, helping reviewers focus on additions and removals rather than scanning the entire file.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is a unified diff format?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The unified diff format, used by git diff, shows removed lines prefixed with a minus sign and added lines with a plus sign, along with a few surrounding context lines. This tool provides a similar view with colour-coded highlighting for readability.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I compare files from different programming languages?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. The tool compares plain text line-by-line regardless of language. You can paste JavaScript, Python, HTML, SQL, or any other text-based code and the diff engine will highlight every difference accurately.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Is there a file size limit for code comparison?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">There is no hard file size limit, but very large inputs may slow down the browser. For best performance, compare files under a few thousand lines at a time. Larger comparisons will still work but may take noticeably longer to render.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
  function lcs(a: string[], b: string[]): boolean[][] {
    const m = a.length, n = b.length;
    const dp: number[][] = Array.from({length: m+1}, () => new Array(n+1).fill(0));
    for (let i = 1; i <= m; i++) for (let j = 1; j <= n; j++)
      dp[i][j] = a[i-1] === b[j-1] ? dp[i-1][j-1] + 1 : Math.max(dp[i-1][j], dp[i][j-1]);
    const inLcs = new Array(m).fill(false);
    let i = m, j = n;
    while (i > 0 && j > 0) {
      if (a[i-1] === b[j-1]) { inLcs[i-1] = true; i--; j--; }
      else if (dp[i-1][j] > dp[i][j-1]) i--;
      else j--;
    }
    return [inLcs as any];
  }

  function diff(a: string[], b: string[]): {type: 'add'|'remove'|'same'; line: string}[] {
    const m = a.length, n = b.length;
    const dp: number[][] = Array.from({length: m+1}, () => new Array(n+1).fill(0));
    for (let i = 1; i <= m; i++) for (let j = 1; j <= n; j++)
      dp[i][j] = a[i-1] === b[j-1] ? dp[i-1][j-1] + 1 : Math.max(dp[i-1][j], dp[i][j-1]);

    const result: {type: 'add'|'remove'|'same'; line: string}[] = [];
    let i = m, j = n;
    while (i > 0 || j > 0) {
      if (i > 0 && j > 0 && a[i-1] === b[j-1]) { result.unshift({type:'same',line:a[i-1]}); i--; j--; }
      else if (j > 0 && (i === 0 || dp[i][j-1] >= dp[i-1][j])) { result.unshift({type:'add',line:b[j-1]}); j--; }
      else { result.unshift({type:'remove',line:a[i-1]}); i--; }
    }
    return result;
  }

  function esc(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  document.getElementById('run-diff')?.addEventListener('click', () => {
    const aLines = ((document.getElementById('diff-a') as HTMLTextAreaElement).value).split('\n');
    const bLines = ((document.getElementById('diff-b') as HTMLTextAreaElement).value).split('\n');
    const result = diff(aLines, bLines);

    let added = 0, removed = 0;
    const html = result.map(r => {
      if (r.type === 'add')    { added++;   return `<span style="background:#14532D;color:#86EFAC;display:block;">+ ${esc(r.line)}</span>`; }
      if (r.type === 'remove') { removed++; return `<span style="background:#7F1D1D;color:#FCA5A5;display:block;">- ${esc(r.line)}</span>`; }
      return `<span style="color:var(--text-muted);display:block;">  ${esc(r.line)}</span>`;
    }).join('');

    const out = document.getElementById('diff-output')!;
    out.innerHTML = html;
    out.style.display = 'block';
    (document.getElementById('diff-placeholder') as HTMLElement).style.display = 'none';

    const stats = document.getElementById('diff-stats')!;
    stats.innerHTML = `
      <span style="color:#16A34A;font-weight:600;">+${added} added</span>
      <span style="color:#DC2626;font-weight:600;">-${removed} removed</span>
    `;
  });
</script>
