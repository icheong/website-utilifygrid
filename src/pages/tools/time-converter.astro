---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'time-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Time Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a time value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="time-input">Time</label>
        <input id="time-input" type="number" value="1" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="time-unit">Unit</label>
        <select id="time-unit" class="select-themed" style="min-width:10rem;">
          <option value="ns">Nanosecond (ns)</option>
          <option value="us">Microsecond (μs)</option>
          <option value="ms">Millisecond (ms)</option>
          <option value="s" selected>Second (s)</option>
          <option value="min">Minute (min)</option>
          <option value="hr">Hour (hr)</option>
          <option value="day">Day</option>
          <option value="week">Week</option>
          <option value="month">Month (avg)</option>
          <option value="year">Year (avg)</option>
          <option value="decade">Decade</option>
          <option value="century">Century</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Time Converter</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Enter a <strong>numeric time value</strong> and select its <strong>unit</strong> from the dropdown. All other time units update instantly as you type — no buttons to click.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      The converter supports 12 standard time units from nanoseconds to centuries: <strong>ns</strong>, <strong>μs</strong>, <strong>ms</strong>, <strong>s</strong>, <strong>min</strong>, <strong>hr</strong>, <strong>day</strong>, <strong>week</strong>, <strong>month</strong>, <strong>year</strong>, <strong>decade</strong>, and <strong>century</strong>.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      Click any <strong>Copy</strong> button to copy that unit's result to your clipboard. Common time durations are shown below the results for quick comparison.
    </p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How time conversions work</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.875rem;">
      All conversions use <strong>seconds</strong> as the base unit. Each unit has a fixed factor relative to one second:
    </p>
    <pre style="font-family:'Fira Code',monospace;font-size:.85rem;padding:1rem;border-radius:.5rem;background:var(--bg-surface-2);color:var(--text-primary);overflow-x:auto;white-space:pre-wrap;">1 ns      = 10⁻⁹ s
1 μs      = 10⁻⁶ s
1 ms      = 0.001 s
1 min     = 60 s
1 hr      = 3,600 s
1 day     = 86,400 s
1 week    = 604,800 s
1 month   = 2,629,746 s     (avg 30.44 days)
1 year    = 31,557,600 s    (avg 365.25 days)
1 decade  = 315,576,000 s
1 century = 3,155,760,000 s

Result = Input × (FromFactor / ToFactor)</pre>
    <p style="color:var(--text-secondary); font-size:0.85rem; line-height:1.75;">
      Months and years use astronomical averages: a year is 365.25 days (accounting for leap years), and a month is a year ÷ 12. This means 1 year = 12 months exactly in this model. For calendar-precise calculations, the actual number of days varies by month and year.
    </p>
  </div>

  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How many seconds are in a day?",
          "acceptedAnswer": { "@type": "Answer", "text": "There are exactly 86,400 seconds in a day (24 hours × 60 minutes × 60 seconds = 86,400). This is used as a base unit in many scientific and computing applications." }
        },
        {
          "@type": "Question",
          "name": "How many days are in a year?",
          "acceptedAnswer": { "@type": "Answer", "text": "A calendar year has 365 days (or 366 in a leap year). The astronomical average is 365.25 days, which is why this converter uses 365.25 days per year. Four years have 1,461 days, giving an average of 365.25." }
        },
        {
          "@type": "Question",
          "name": "What is a nanosecond?",
          "acceptedAnswer": { "@type": "Answer", "text": "A nanosecond (ns) is one billionth of a second (10⁻⁹ s). Light travels about 30 cm (1 foot) in one nanosecond. Computer processors perform operations in nanoseconds, and it takes about 100 ns for a CPU cycle." }
        },
        {
          "@type": "Question",
          "name": "Why are months considered 30.44 days?",
          "acceptedAnswer": { "@type": "Answer", "text": "This converter uses the average month length: 365.25 days ÷ 12 = 30.4375 days ≈ 30.44 days. Actual months range from 28 to 31 days. This average is useful for rough time conversions but not for calendar-precise calculations." }
        },
        {
          "@type": "Question",
          "name": "How many hours are in a week?",
          "acceptedAnswer": { "@type": "Answer", "text": "There are exactly 168 hours in a week (7 days × 24 hours = 168). A typical 40-hour work week represents about 23.8% of the total hours in a week." }
        }
      ]
    }
    </script>

    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'How many seconds are in a day?', a: 'There are exactly 86,400 seconds in a day (24 hours × 60 minutes × 60 seconds = 86,400). This is used as a base unit in many scientific and computing applications.' },
        { q: 'How many days are in a year?', a: 'A calendar year has 365 days (or 366 in a leap year). The astronomical average is 365.25 days, which is why this converter uses 365.25 days per year. Four years have 1,461 days, giving an average of 365.25.' },
        { q: 'What is a nanosecond?', a: 'A nanosecond (ns) is one billionth of a second (10⁻⁹ s). Light travels about 30 cm (1 foot) in one nanosecond. Computer processors perform operations in nanoseconds, and it takes about 100 ns for a CPU cycle.' },
        { q: 'Why are months considered 30.44 days?', a: 'This converter uses the average month length: 365.25 days ÷ 12 = 30.4375 days ≈ 30.44 days. Actual months range from 28 to 31 days. This average is useful for rough time conversions but not for calendar-precise calculations.' },
        { q: 'How many hours are in a week?', a: 'There are exactly 168 hours in a week (7 days × 24 hours = 168). A typical 40-hour work week represents about 23.8% of the total hours in a week.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to seconds ───────────────────────────────
  const TO_S = {
    ns:      1e-9,
    us:      1e-6,
    ms:      0.001,
    s:       1,
    min:     60,
    hr:      3600,
    day:     86400,
    week:    604800,
    month:   2_629_746,
    year:    31_557_600,
    decade:  315_576_000,
    century: 3_155_760_000,
  };

  const UNITS = [
    { id: 'ns',      label: 'ns',    name: 'Nanosecond' },
    { id: 'us',      label: 'μs',    name: 'Microsecond' },
    { id: 'ms',      label: 'ms',    name: 'Millisecond' },
    { id: 's',       label: 's',     name: 'Second' },
    { id: 'min',     label: 'min',   name: 'Minute' },
    { id: 'hr',      label: 'hr',    name: 'Hour' },
    { id: 'day',     label: 'day',   name: 'Day' },
    { id: 'week',    label: 'week',  name: 'Week' },
    { id: 'month',   label: 'mo',    name: 'Month (avg)' },
    { id: 'year',    label: 'yr',    name: 'Year (avg)' },
    { id: 'decade',  label: 'dec',   name: 'Decade' },
    { id: 'century', label: 'c',     name: 'Century' },
  ];

  // ── Quick-reference objects (stored in seconds) ─────────────────
  const REFS = [
    { name: 'Blink of an Eye',      s: 0.3 },
    { name: 'Heartbeat',             s: 0.8 },
    { name: 'Deep Breath',           s: 4 },
    { name: 'Microwave Cycle',       s: 30 },
    { name: 'Song Track',            s: 240 },
    { name: 'Movie',                 s: 7200 },
    { name: 'Flight (NYC→London)',   s: 28_800 },
    { name: 'Earth Orbit',           s: 31_557_600 },
  ];

  const input  = document.getElementById('time-input') as HTMLInputElement;
  const select = document.getElementById('time-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e15) return value.toExponential(4);
    if (abs >= 1e12) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1e9)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    return value.toExponential(4);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const sVal     = val * TO_S[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = sVal / TO_S[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = r.s / TO_S[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
