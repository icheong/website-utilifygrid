---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'force-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Force Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a force value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="force-input">Force</label>
        <input id="force-input" type="number" value="100" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="force-unit">Unit</label>
        <select id="force-unit" class="select-themed" style="min-width:10rem;">
          <option value="n" selected>Newton (N)</option>
          <option value="kn">Kilonewton (kN)</option>
          <option value="mn">Meganewton (MN)</option>
          <option value="dyn">Dyne (dyn)</option>
          <option value="lbf">Pound-force (lbf)</option>
          <option value="ozf">Ounce-force (ozf)</option>
          <option value="kgf">Kilogram-force (kgf)</option>
          <option value="gf">Gram-force (gf)</option>
          <option value="pdl">Poundal (pdl)</option>
          <option value="kip">Kip</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Convert Between Newtons, Kips, Kilogram-Force, and Pound-Force</h2>
    <p class="seo-p">
      A structural engineer in Chicago receives a load specification from a German firm: 45 kN per column. The American construction drawings use kips. Converting 45 kN gives 10.116 kips. If the engineer mistakenly treats 45 kN as 45 kips, the foundation would be designed for 4.5 times the actual load — wasting concrete and steel. Enter 45, select kN, and every other force unit appears instantly.
    </p>
    <p class="seo-p">
      The converter handles 10 units from dynes to meganewtons. A biomechanist comparing grip strength data published in newtons (500 N) with an older American study using pound-force (112 lbf) can confirm they describe the same force. An automotive technician servicing an airbag system torqued to 10 N·m needs to verify the bolt spec against a US manual listing 8.85 lbf·ft. The quick-reference row shows everyday forces: an apple at 1 N, a boxing punch at 5,000 N, a car tyre tension at 2,200 N.
    </p>

    <h3 class="font-display seo-h3-sm">Engineering where confusing newtons with kilograms wastes money</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Structural load calculations across metric and imperial', 'A civil engineer in Singapore designs a beam rated at 200 kN. The US contractor needs the load in kips: 200 kN = 44.96 kips. If the contractor misreads 200 as 200 kips, they would design for 889.6 kN — overbuilding by a factor of 4.45. The converter prevents this by showing both values side by side, so the engineer can sanity-check: "200 kN is about 45 kips, not 200 kips."'],
        ['Airbag torque specifications', 'A mechanic services an airbag module torqued to 10 N·m. The US service manual specifies 8.85 lbf·ft. Converting 10 N·m to lbf·ft gives 7.376 lbf·ft — close to but not exactly 8.85. The difference matters: overtorquing can crack the mounting bracket, while undertorquing can let the module vibrate loose. The converter shows the precise equivalent so the mechanic can set the torque wrench correctly.'],
        ['Biomechanics research comparing international studies', 'A researcher reviews a Japanese study reporting bite force of 700 N and an American study reporting 157 lbf. Converting 700 N to lbf gives 157.4 lbf — the values match, confirming consistent methodology. If the studies used different units and the researcher did not convert, they might incorrectly conclude the Japanese subjects had stronger bites because 700 > 157.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Force Converter Handles Newtons, Kips, and Kilogram-Force</h2>
    <p class="seo-p">
      Every unit in the converter is stored as a multiple of one newton. When you enter 10 kips, the tool multiplies by 4448.2216 to get 44,482.216 N, then divides by each target unit's factor. The conversion to kilonewtons gives 44.482 kN. The conversion to pound-force gives 10,000 lbf (exactly, since 1 kip = 1000 lbf by definition). Because all conversions pass through newtons in one step, the results are consistent regardless of which pair of units you convert between.
    </p>

    <h3 class="font-display seo-h3-sm">Why kilogram-force is exact but pound-force is not</h3>
    <p class="seo-p-sm">
      Kilogram-force is defined as exactly 9.80665 N — the force of gravity on 1 kg at standard gravity (9.80665 m/s²). The pound-force is derived from the international pound (0.45359237 kg) multiplied by standard gravity, giving 4.4482216152605 N. That long decimal exists because the pound's kilogram equivalent (0.45359237) was chosen to make the pound match a historical physical prototype, not to produce a round newton value. For practical work, 4.448 N is used.
    </p>
    <p class="seo-p-sm">
      The kip (1,000 lbf = 4448.22 N) is used exclusively in US structural engineering. The name comes from "kilo-pound." A kip is convenient because building loads are typically in the hundreds or thousands of pounds — expressing them as kips produces manageable numbers. A 60,000 lbf column load becomes 60 kips, which is easier to read on a blueprint than 60,000 lbf or 266.89 kN.
    </p>

    <h3 class="font-display seo-h3-sm">The CGS system's dyne and why it still exists</h3>
    <p class="seo-p-sm">
      The dyne is the CGS unit of force: 1 dyn = 10⁻⁵ N. It is used in surface tension measurements (dynes per centimetre), micro-electromechanical systems (MEMS), and some older physics textbooks. Surface tension of water at 20°C is about 72.8 dyn/cm. Converting to SI: 0.0728 N/m. The dyne persists because CGS units produce convenient numbers for small-scale phenomena — 72.8 is easier to work with than 0.0728.
    </p>
    <p class="seo-p-none">
      The poundal is the FPS (foot-pound-second) equivalent of the dyne: the force needed to accelerate 1 pound-mass at 1 ft/s². One poundal equals 0.138255 N. Poundal is rarely used today, but it appears in some older engineering texts and in aerospace dynamics where the pound-mass is the base mass unit. The relationship between poundal and pound-force is 1 lbf = 32.174 pdl — the factor of 32.174 is Earth's gravitational acceleration in ft/s².
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How many newtons is 50 kips?",
          a: "50 kips equals 222,411 N (222.4 kN). One kip is exactly 1,000 lbf, and 1 lbf = 4.44822 N, so 50 kips = 50,000 lbf × 4.44822 = 222,411 N. For a quick mental estimate, multiply kips by 4.45 to get kilonewtons. A structural engineer designing a column rated at 50 kips needs to ensure the foundation can handle 222.4 kN of vertical load."
        },
        {
          q: "What is the difference between newton and kilogram-force?",
          a: "A newton measures force independent of gravity. A kilogram-force measures the force of gravity on 1 kg at standard gravity (9.80665 m/s²). On Earth, 1 kgf = 9.80665 N. On the Moon (gravity 1.62 m/s²), 1 kg of mass exerts only 1.62 N — but it is still 1 kgf if you define kgf as local gravitational force. The newton is the SI standard; kgf is a legacy unit still used in some engineering contexts."
        },
        {
          q: "What is the average human grip strength in newtons?",
          a: "Average male grip strength is about 400-500 N (90-112 lbf). Average female grip strength is about 250-350 N (56-79 lbf). Professional athletes like rock climbers can exceed 1,000 N. These figures are measured with a hand dynamometer, which displays in newtons or pounds-force depending on the model."
        },
        {
          q: "How do I convert newtons to pounds-force in my head?",
          a: "Divide newtons by 4.45 for a ballpark figure. 100 N ≈ 22.5 lbf. 500 N ≈ 112 lbf. For a more precise quick estimate, divide by 4.448. The reverse: multiply lbf by 4.45 to get newtons. 100 lbf ≈ 445 N. This mental math is useful when reviewing structural drawings that use mixed units."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to newtons ───────────────────────────────
  const TO_N = {
    n:   1,
    kn:  1_000,
    mn:  1_000_000,
    dyn: 0.00001,
    lbf: 4.4482216152605,
    ozf: 0.27801385095378125,
    kgf: 9.80665,
    gf:  0.00980665,
    pdl: 0.138254954376,
    kip: 4448.2216152605,
  };

  const UNITS = [
    { id: 'n',   label: 'N',    name: 'Newton' },
    { id: 'kn',  label: 'kN',   name: 'Kilonewton' },
    { id: 'mn',  label: 'MN',   name: 'Meganewton' },
    { id: 'dyn', label: 'dyn',  name: 'Dyne' },
    { id: 'lbf', label: 'lbf',  name: 'Pound-force' },
    { id: 'ozf', label: 'ozf',  name: 'Ounce-force' },
    { id: 'kgf', label: 'kgf',  name: 'Kilogram-force' },
    { id: 'gf',  label: 'gf',   name: 'Gram-force' },
    { id: 'pdl', label: 'pdl',  name: 'Poundal' },
    { id: 'kip', label: 'kip',  name: 'Kip' },
  ];

  // ── Quick-reference objects (stored in newtons) ─────────────────
  const REFS = [
    { name: 'Apple (weight)',            n: 1.0 },
    { name: 'Human Bite (incisors)',     n: 162 },
    { name: 'Human Bite (molars)',       n: 720 },
    { name: 'Boxing Punch (pro)',        n: 5_000 },
    { name: 'Car Tire Tension',          n: 2_200 },
    { name: 'Average Person (70 kg)',    n: 686.5 },
    { name: 'Lion Bite Force',           n: 4_450 },
    { name: 'Rocket (SpaceX Merlin)',    n: 845_000 },
  ];

  const input  = document.getElementById('force-input') as HTMLInputElement;
  const select = document.getElementById('force-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e12) return value.toExponential(4);
    if (abs >= 1e9)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    return value.toExponential(4);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const nVal     = val * TO_N[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = nVal / TO_N[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = r.n / TO_N[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
