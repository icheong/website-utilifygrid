---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'force-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Force Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a force value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="force-input">Force</label>
        <input id="force-input" type="number" value="100" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="force-unit">Unit</label>
        <select id="force-unit" class="select-themed" style="min-width:10rem;">
          <option value="n" selected>Newton (N)</option>
          <option value="kn">Kilonewton (kN)</option>
          <option value="mn">Meganewton (MN)</option>
          <option value="dyn">Dyne (dyn)</option>
          <option value="lbf">Pound-force (lbf)</option>
          <option value="ozf">Ounce-force (ozf)</option>
          <option value="kgf">Kilogram-force (kgf)</option>
          <option value="gf">Gram-force (gf)</option>
          <option value="pdl">Poundal (pdl)</option>
          <option value="kip">Kip</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Force Converter Overview</h2>
    <p class="seo-p">
      This force converter computes precise conversions between 10 SI, CGS, and imperial force units entirely within your browser. Built with modern vanilla JavaScript, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your calculations, whether you are working in structural engineering, biomechanics, physics, or automotive applications.
    </p>
    <p class="seo-p">
      The converter supports the most commonly used force units across SI, CGS, and imperial systems: newtons, kilonewtons, and meganewtons for SI; dyne for CGS; pound-force, ounce-force, kilogram-force, gram-force, poundal, and kip for imperial/US customary. Results are dynamically formatted based on magnitude, switching between fixed notation, locale-formatted numbers, and scientific notation as appropriate.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Structural and civil engineering', 'Structural engineers calculate loads in kips or kilonewtons when designing buildings, bridges, and other structures. A typical residential floor load is about 1.5 kips (6,674 N), while a bridge pier might support 500 kips (2,224 kN). The converter helps translate between US drawings (kips, lbf) and international specifications (kN, N). The quick-reference section helps visualise everyday forces like an apple (1 N), a boxing punch (5,000 N), or a car tire tension (2,200 N) for intuitive scale comparison.'],
        ['Biomechanics and human factors', 'Biomechanists measure human bite forces, grip strengths, and joint reaction forces in newtons. A strong human bite produces about 720 N (162 lbf), while a professional boxer generates up to 5,000 N in a punch. Athletes, ergonomists, and medical researchers convert between newtons and pound-force when comparing data across international studies. The tool handles the full range from gram-force (0.0098 N) to meganewtons (1,000,000 N) with IEEE 754 double-precision accuracy.'],
        ['Automotive and aerospace applications', 'Car tire tension is about 2,200 N (495 lbf), while a rocket engine like the SpaceX Merlin produces 845,000 N (190,000 lbf) of thrust. Mechanics work in newtons when servicing airbag systems, while aerospace engineers use kilonewtons or pound-force for engine specifications. The tool converts between SI force units used in international aerospace standards and imperial units used in US military and commercial aviation.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      The converter employs a hub-and-spoke conversion model using newtons as the universal base unit. Every supported force unit is defined by a fixed conversion factor relative to one newton. To convert from unit A to unit B, the tool multiplies the input value by A's factor to obtain newtons, then divides by B's factor to obtain the target value. This approach guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">n</code>, <code class="inline-code">lbf</code>, <code class="inline-code">kgf</code>) to its exact factor in newtons. SI units use powers of 10 (e.g. <code class="inline-code">1 kN = 1,000 N</code>, <code class="inline-code">1 MN = 1,000,000 N</code>), while imperial and CGS units use internationally defined values.
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion:</strong> The input value is multiplied by the source unit's factor to convert to newtons. For example, converting 100 lbf to newtons: <code class="inline-code">100 × 4.44822 = 444.822 N</code>. This intermediate result is an IEEE 754 double-precision floating-point number, which provides approximately 15 to 17 significant decimal digits of precision.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion:</strong> The newton value is divided by the target unit's factor. Converting 444.822 N to kN: <code class="inline-code">444.822 / 1000 = 0.4448 kN</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>.
    </p>
    <p class="seo-p-sm">
      <strong>4. Dynamic formatting:</strong> The display format adapts to the magnitude of the result. Very large values (1 trillion or greater) use scientific notation. Values between 1 billion and 1 trillion use locale-formatted numbers with 2 decimal places. Values between 1,000 and 1 billion use 2 to 4 decimal places. Values between 0.001 and 1,000 use 6 to 8 decimal places. Values below 0.001 use scientific notation. This ensures readability across the full range from dynes to meganewtons.
    </p>
    <p class="seo-p-none">
      <strong>Exact vs. approximate factors:</strong> The kilogram-force is defined as exactly 9.80665 N (standard gravity × 1 kg), making it exact. The pound-force is defined via the international pound (exactly 0.45359237 kg) and standard gravity, so <code class="inline-code">1 lbf = 4.4482216152605 N</code> (rounded for display). The dyne is defined exactly as 10⁻⁵ N. The poundal is defined as the force needed to accelerate 1 pound-mass at 1 ft/s², making <code class="inline-code">1 pdl = 0.138254954 N</code> approximate but derived from exact definitions.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is the difference between a newton and a kilogram-force?",
          a: "A newton (N) is the SI unit of force: the force needed to accelerate 1 kg at 1 m/s². A kilogram-force (kgf) is the force of gravity on 1 kg at standard gravity: 1 kgf = 9.80665 N. They measure the same thing but use different reference frames. The newton is independent of gravity, while kgf depends on the local gravitational field."
        },
        {
          q: "What is a dyne?",
          a: "A dyne (dyn) is the CGS unit of force: the force needed to accelerate 1 gram at 1 cm/s². It equals 0.00001 newtons. Dynes are used in physics and engineering where very small forces are measured, such as surface tension, capillary action, and micro-electromechanical systems (MEMS)."
        },
        {
          q: "What is a kip?",
          a: "A kip is a unit of force equal to 1,000 pound-force (lbf), or approximately 4,448 newtons. It is commonly used in structural engineering in the United States to express building loads and structural member capacities. A typical residential floor load is about 1.5 kips, while a bridge pier might support 500 kips."
        },
        {
          q: "What is pound-force?",
          a: "Pound-force (lbf) is the force exerted by gravity on one pound-mass at standard gravity (9.80665 m/s²). It equals about 4.448 newtons. It is the most commonly used force unit in US engineering. Pound-force should not be confused with pound-mass, which measures mass, not force."
        },
        {
          q: "What is the average human bite force?",
          a: "The average human bite force is about 162 newtons (36 lbf) for incisors and 720 newtons (162 lbf) for molars. Some studies record up to 700 N for a strong bite. For comparison, a lion's bite force is about 4,450 N, and a great white shark's bite force is estimated at 18,000 N."
        },
        {
          q: "How do I convert newtons to kilograms?",
          a: "To convert newtons to kilograms of mass, divide by 9.80665 (standard gravity). For example, 100 N corresponds to approximately 10.197 kg. This conversion tells you how much mass would produce that force under Earth's gravity. On the Moon (gravity = 1.62 m/s²), 100 N would correspond to 61.7 kg."
        },
        {
          q: "What is the difference between pound-force and poundal?",
          a: "Pound-force (lbf) is the force of gravity on one pound-mass at standard gravity: 1 lbf = 4.448 N. A poundal (pdl) is the force needed to accelerate one pound-mass at 1 ft/s²: 1 pdl = 0.1383 N. Pound-force is about 32.2 times larger than poundal because it includes the effect of Earth's gravitational acceleration (32.2 ft/s²)."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to newtons ───────────────────────────────
  const TO_N = {
    n:   1,
    kn:  1_000,
    mn:  1_000_000,
    dyn: 0.00001,
    lbf: 4.4482216152605,
    ozf: 0.27801385095378125,
    kgf: 9.80665,
    gf:  0.00980665,
    pdl: 0.138254954376,
    kip: 4448.2216152605,
  };

  const UNITS = [
    { id: 'n',   label: 'N',    name: 'Newton' },
    { id: 'kn',  label: 'kN',   name: 'Kilonewton' },
    { id: 'mn',  label: 'MN',   name: 'Meganewton' },
    { id: 'dyn', label: 'dyn',  name: 'Dyne' },
    { id: 'lbf', label: 'lbf',  name: 'Pound-force' },
    { id: 'ozf', label: 'ozf',  name: 'Ounce-force' },
    { id: 'kgf', label: 'kgf',  name: 'Kilogram-force' },
    { id: 'gf',  label: 'gf',   name: 'Gram-force' },
    { id: 'pdl', label: 'pdl',  name: 'Poundal' },
    { id: 'kip', label: 'kip',  name: 'Kip' },
  ];

  // ── Quick-reference objects (stored in newtons) ─────────────────
  const REFS = [
    { name: 'Apple (weight)',            n: 1.0 },
    { name: 'Human Bite (incisors)',     n: 162 },
    { name: 'Human Bite (molars)',       n: 720 },
    { name: 'Boxing Punch (pro)',        n: 5_000 },
    { name: 'Car Tire Tension',          n: 2_200 },
    { name: 'Average Person (70 kg)',    n: 686.5 },
    { name: 'Lion Bite Force',           n: 4_450 },
    { name: 'Rocket (SpaceX Merlin)',    n: 845_000 },
  ];

  const input  = document.getElementById('force-input') as HTMLInputElement;
  const select = document.getElementById('force-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e12) return value.toExponential(4);
    if (abs >= 1e9)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    return value.toExponential(4);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const nVal     = val * TO_N[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = nVal / TO_N[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = r.n / TO_N[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
