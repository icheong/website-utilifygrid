---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'json-path-query-evaluator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">JSON Path Query Evaluator</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Run JSONPath queries against JSON data and see filtered results update live.</p>

    <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
      <button id="btn-eval" class="btn-primary" type="button">Run Query</button>
      <button id="btn-sample" class="btn-secondary" type="button">Load Sample</button>
      <button id="btn-clear" class="btn-secondary" type="button">Clear</button>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:0.875rem;">
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">JSON Data</label>
        </div>
        <textarea id="json-data" class="input-themed"
          placeholder='{"store":{"book":[{"title":"Dune","price":8.99},{"title":"Neuromancer","price":7.50}]}}'
          rows="10"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65;"
        ></textarea>
      </div>
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">Query Result</label>
          <button id="btn-copy" class="btn-secondary" type="button" style="font-size:0.7rem; padding:0.2rem 0.55rem;">Copy</button>
        </div>
        <textarea id="json-output" class="input-themed" readonly rows="10"
          placeholder="Query result appears here…"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65; background:var(--bg-surface-2);"
        ></textarea>
      </div>
    </div>

    <div style="margin-bottom:1rem;">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.4rem;">
        <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">JSONPath Query</label>
        <span style="font-size:0.65rem; color:var(--text-muted);">e.g. $.store.book[*].title</span>
      </div>
      <div style="display:flex; gap:0.5rem;">
        <input id="query-input" type="text" class="input-themed"
          placeholder="$.store.book[*].title"
          style="flex:1; font-family:'Fira Code',monospace; font-size:0.82rem; padding:0.625rem 0.875rem;"
        />
      </div>
    </div>

    <div id="error-box" style="display:none; margin-bottom:0.625rem; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); border-radius:0.5rem; padding:0.75rem 1rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:#DC2626;"></div>

    <!-- Cheat Sheet -->
    <details style="border:1.5px solid var(--border); border-radius:0.625rem; overflow:hidden;">
      <summary style="padding:0.75rem 1rem; font-size:0.82rem; font-weight:600; color:var(--text-secondary); cursor:pointer; background:var(--bg-surface-2); user-select:none;">Cheat Sheet — Common Queries</summary>
      <div style="padding:0.75rem 1rem; display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
        {[
          { q: '$.store.book[*].title', d: 'All book titles' },
          { q: '$.store.book[0]', d: 'First book object' },
          { q: '$.store.book[?(@.price < 8)]', d: 'Books under $8' },
          { q: '$.store.book[?(@.price < 8)]', d: 'Books under $8' },
          { q: '$.store.book[?(@.inStock == true)]', d: 'In-stock books' },
          { q: '$.store.*', d: 'All store children' },
        ].map(item => (
          <div style="display:flex; flex-direction:column; gap:0.15rem; padding:0.4rem 0.6rem; background:var(--bg-surface); border:1px solid var(--border); border-radius:0.375rem;">
            <code style="font-family:'Fira Code',monospace; font-size:0.72rem; color:#1D4ED8; word-break:break-all;">{item.q}</code>
            <span style="font-size:0.7rem; color:var(--text-muted);">{item.d}</span>
          </div>
        ))}
      </div>
    </details>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the JSON Path Query Evaluator</h2>
    <p class="seo-p">A QA engineer tests a REST API that returns a nested JSON response with user profiles, order histories, and shipping addresses. The engineer needs to verify that every user object has an email field and that all orders above $100 have a tracking number. Paste the API response into the JSON Data panel, enter the query $.users[*].email to check all email fields, and the result updates live. Then enter $.orders[?(@.total > 100)].trackingNumber to verify tracking numbers on high-value orders. The entire workflow runs in your browser with no server calls.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">API integration testing</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A developer testing a payment gateway API receives a response with nested transaction objects. Paste the JSON and use $.transactions[*].status to verify all transactions have a status field. Then use $.transactions[?(@.status == "failed")] to isolate failed transactions for debugging. The cheat sheet below the input field shows common query patterns for quick reference.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Log analysis and debugging</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A developer investigating a production incident pastes a large JSON log entry and uses the recursive descent operator $..error to locate all error fields regardless of nesting depth. This is significantly faster than manually expanding nested objects in a tree viewer. The result shows every error value in a flat array, making it easy to spot patterns across the log.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Data pipeline validation</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A data engineer processes JSON through an ETL pipeline and needs to validate the output structure before loading into the data warehouse. Paste the transformed JSON and query $.records.length to verify the expected record count. Use $[?(@.timestamp > "2024-01-01")] to confirm all records have timestamps after the cutoff date. This provides immediate structural verification without writing a full test suite.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Configuration file inspection</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A DevOps engineer needs to verify that a Kubernetes deployment manifest has the correct environment variables set. Paste the YAML-converted JSON and use $.spec.template.spec.containers[*].env[*].name to list all environment variable names. Use $.spec.template.spec.containers[?(@.name == "app")].resources.limits.memory to check memory limits on the main container. The live preview updates as you type each query.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the JSON Path Query Evaluator Works</h2>
    <p class="seo-p">The query engine uses a tokeniser and recursive-descent architecture to evaluate JSONPath expressions against parsed JSON data. All processing happens in your browser with no server calls.</p>
    <h3 class="font-display seo-h3-sm">Tokeniser Architecture</h3>
    <p class="seo-p">The tokeniser splits the raw JSONPath expression into segments by identifying path separators (dots), bracket groups, filter expressions, and the recursive descent operator. Each token is classified by type: dot-access key, bracket-access key, array index, wildcard, filter expression, or recursive descent. The tokeniser handles nested bracket expressions and quoted string keys within brackets.</p>
    <h3 class="font-display seo-h3-sm">Recursive-Descent Evaluation</h3>
    <p class="seo-p">After tokenisation, the evaluator walks the parsed JavaScript object tree by applying each token in sequence. For dot and bracket tokens, it performs direct property access on the current result set. For wildcards, it expands arrays to all elements and objects to all values. Filter expressions are evaluated by applying the comparison operator (==, !=, less than, greater than, less-equal, greater-equal) between each element field and the provided value, supporting string, numeric, boolean, and null comparisons.</p>
    <h3 class="font-display seo-h3-sm">Recursive Descent Operator</h3>
    <p class="seo-p">The recursive descent operator performs a depth-first traversal of the entire object subtree. At each node, the evaluator checks whether the node matches the subsequent token. For example, $..author finds all properties named author at any depth. This is implemented using a stack-based traversal that visits every nested object and array element, collecting matches in a flat array. The result is deduplicated and formatted as a JSON array.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is JSONPath?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">JSONPath is a query language for JSON documents, conceptually similar to XPath for XML. It allows you to select and extract specific parts of a JSON document using path expressions. The syntax uses <code class="inline-code">$</code> to refer to the root object, dot or bracket notation for property access, wildcards for all children, and filter expressions for conditional selection.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does it support JMESPath?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The implementation supports standard JSONPath syntax (RFC 9535 style). JMESPath uses a different syntax — for example, <code class="inline-code">store.book[*].title</code> in JMESPath vs <code class="inline-code">$.store.book[*].title</code> in JSONPath. The two are not interchangeable. We recommend checking your project's query language before choosing an evaluator.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I use filter expressions?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. Filter expressions use the syntax <code class="inline-code">[?(@.price &lt; 10)]</code> where <code class="inline-code">@</code> refers to the current element being evaluated. Supported operators are <code class="inline-code">==</code>, <code class="inline-code">!=</code>, <code class="inline-code">&lt;</code>, <code class="inline-code">&gt;</code>, <code class="inline-code">&lt;=</code>, and <code class="inline-code">&gt;=</code>. Values can be strings (quoted), numbers, or booleans. Nested field access like <code class="inline-code">@.address.city</code> is also supported within filters.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Is there a query length or complexity limit?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">There is no hard-coded limit. Standard queries with 5-10 path segments plus filter expressions evaluate in milliseconds. Extremely long queries with deeply nested recursive descent on very large data sets may be slower due to the recursive traversal pattern. For large payloads, consider narrowing the scope with a more specific path.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What happens if the JSON data or query is invalid?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">If the JSON data is invalid, the evaluator displays a parse error from the native <code class="inline-code">JSON.parse()</code> method. If the query is syntactically invalid, the evaluator may return no matches or throw an error depending on the specific malformation. The tool defaults to showing an empty result rather than crashing, allowing you to adjust the query incrementally.</p>
        </div>
      </div>

    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLE_DATA = JSON.stringify({
    store: {
      book: [
        { title: "Dune", author: "Frank Herbert", price: 8.99, inStock: true },
        { title: "Neuromancer", author: "William Gibson", price: 7.50, inStock: true },
        { title: "Foundation", author: "Isaac Asimov", price: 9.25, inStock: false },
      ],
      bicycle: { color: "red", price: 19.95 }
    }
  }, null, 2);

  function tokenizePath(path: string): string[] {
    const tokens: string[] = [];
    const raw = path.startsWith('$') ? path.slice(1) : path;
    let pos = 0;

    while (pos < raw.length) {
      if (raw[pos] === '.' && pos + 1 < raw.length && raw[pos + 1] === '.') {
        tokens.push('..');
        pos += 2;
        continue;
      }
      if (raw[pos] === '.') {
        pos++;
        continue;
      }
      if (raw[pos] === '[') {
        let depth = 0;
        let start = pos;
        while (pos < raw.length) {
          if (raw[pos] === '[') depth++;
          if (raw[pos] === ']') { depth--; if (depth === 0) { pos++; break; } }
          pos++;
        }
        tokens.push(raw.slice(start, pos));
        continue;
      }
      let start = pos;
      while (pos < raw.length && raw[pos] !== '.' && raw[pos] !== '[') pos++;
      tokens.push(raw.slice(start, pos));
    }
    return tokens;
  }

  function getNestedField(obj: any, fieldPath: string): any {
    const parts = fieldPath.split('.');
    let current = obj;
    for (const p of parts) {
      if (current === undefined || current === null) return undefined;
      current = current[p];
    }
    return current;
  }

  function evaluateJsonPath(obj: any, path: string): any {
    const tokens = tokenizePath(path);
    let result = obj;

    for (let ti = 0; ti < tokens.length; ti++) {
      const token = tokens[ti];
      if (result === undefined || result === null) return undefined;

      if (token === '..') {
        const nextToken = tokens[ti + 1];
        if (!nextToken) {
          const collect = (o: any): any[] => {
            const results: any[] = [];
            if (typeof o === 'object' && o !== null) {
              for (const v of Object.values(o)) {
                results.push(v);
                results.push(...collect(v));
              }
            }
            return results;
          };
          return collect(result);
        }
        ti++;
        const collectMatching = (o: any): any[] => {
          const results: any[] = [];
          if (typeof o === 'object' && o !== null) {
            for (const v of Object.values(o)) {
              if (matchesToken(v, nextToken)) results.push(v);
              results.push(...collectMatching(v));
            }
          }
          return results;
        };
        const all = collectMatching(result);
        if (ti + 1 < tokens.length) {
          const remaining = tokens.slice(ti + 1);
          const mapped = all.map((item: any) => {
            let r = item;
            for (const rt of remaining) {
              if (r === undefined || r === null) return undefined;
              const arrM = rt.match(/^\[(\d+)\]$/);
              if (arrM) { r = r[parseInt(arrM[1])]; continue; }
              const bracketM = rt.match(/^\[(['"])(.*?)\1\]$/);
              if (bracketM) { r = r[bracketM[2]]; continue; }
              r = r[rt];
            }
            return r;
          });
          return mapped;
        }
        return all.length > 0 ? all : undefined;
      }

      if (token === '*' || token === '[*]') {
        result = Array.isArray(result) ? result : Object.values(result);
        // If there are more tokens after wildcard, apply remaining path to each element
        if (ti + 1 < tokens.length) {
          const remaining = tokens.slice(ti + 1);
          const mapped = result.map((item: any) => {
            let r = item;
            for (const rt of remaining) {
              if (r === undefined || r === null) return undefined;
              const arrM = rt.match(/^\[(\d+)\]$/);
              if (arrM) { r = r[parseInt(arrM[1])]; continue; }
              const bracketM = rt.match(/^\[(['"])(.*?)\1\]$/);
              if (bracketM) { r = r[bracketM[2]]; continue; }
              r = r[rt];
            }
            return r;
          });
          return mapped;
        }
        continue;
      }

      const arrayMatch = token.match(/^\[(\d+)\]$/);
      if (arrayMatch) {
        result = result[parseInt(arrayMatch[1])];
        continue;
      }

      const bracketKeyMatch = token.match(/^\[(['"])(.*?)\1\]$/);
      if (bracketKeyMatch) {
        result = result[bracketKeyMatch[2]];
        continue;
      }

      const filterMatch = token.match(/^\[\?\(@\.([\w.]+)\s*([<>=!]+)\s*(['"]?)(.*?)\3\)\]$/);
      if (filterMatch) {
        const [, fieldPath, op, , val] = filterMatch;
        if (!Array.isArray(result)) return undefined;
        return result.filter((item: any) => {
          const itemVal = getNestedField(item, fieldPath);
          let compareVal: any;
          if (val === 'true') compareVal = true;
          else if (val === 'false') compareVal = false;
          else if (val === 'null') compareVal = null;
          else compareVal = isNaN(Number(val)) ? val : Number(val);
          switch (op) {
            case '==': return itemVal == compareVal;
            case '!=': return itemVal != compareVal;
            case '<':  return itemVal < compareVal;
            case '>':  return itemVal > compareVal;
            case '<=': return itemVal <= compareVal;
            case '>=': return itemVal >= compareVal;
            default: return false;
          }
        });
      }

      result = result[token];
    }
    return result;
  }

  function matchesToken(obj: any, token: string): boolean {
    if (token === '*' || token === '[*]') return true;
    if (token.match(/^\[(\d+)\]$/)) return false;
    if (token.match(/^\[(['"])(.*?)\1\]$/)) return false;
    if (token.match(/^\[\?\(/)) return false;
    return typeof obj === 'object' && obj !== null && token in obj;
  }

  function runQuery() {
    const dataStr = (document.getElementById('json-data') as HTMLTextAreaElement).value;
    const query = (document.getElementById('query-input') as HTMLInputElement).value.trim();
    const out = (document.getElementById('json-output') as HTMLTextAreaElement);
    const errBox = document.getElementById('error-box')!;
    errBox.style.display = 'none';

    if (!dataStr.trim() || !query) { out.value = ''; return; }

    try {
      const data = JSON.parse(dataStr);
      const result = evaluateJsonPath(data, query);
      if (result === undefined) {
        out.value = 'No match found.';
      } else {
        out.value = JSON.stringify(result, null, 2);
      }
    } catch (e: any) {
      errBox.textContent = e.message;
      errBox.style.display = 'block';
    }
  }

  document.getElementById('btn-eval')!.addEventListener('click', runQuery);
  document.getElementById('btn-sample')!.addEventListener('click', () => {
    (document.getElementById('json-data') as HTMLTextAreaElement).value = SAMPLE_DATA;
    (document.getElementById('query-input') as HTMLInputElement).value = '$.store.book[*].title';
    runQuery();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('json-data') as HTMLTextAreaElement).value = '';
    (document.getElementById('query-input') as HTMLInputElement).value = '';
    (document.getElementById('json-output') as HTMLTextAreaElement).value = '';
    document.getElementById('error-box')!.style.display = 'none';
  });
  document.getElementById('btn-copy')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy')!;
    navigator.clipboard.writeText((document.getElementById('json-output') as HTMLTextAreaElement).value).then(() => {
      btn.textContent = '✓ Copied!';
      btn.classList.add('btn-success');
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
    }).catch(() => {});
  });

  document.getElementById('json-data')!.addEventListener('input', runQuery);
  document.getElementById('query-input')!.addEventListener('input', runQuery);
</script>
