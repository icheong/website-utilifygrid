---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'markdown-to-html-converter')!;
---
<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Markdown to HTML Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Write or paste Markdown and get clean HTML with a live rich-text preview.</p>

    <!-- Edit / Preview tabs -->
    <div style="display:flex;gap:0;margin-bottom:0;">
      <div class="toggle-group" style="margin-bottom:0;" role="group" aria-label="View mode">
        <button class="toggle-btn active" data-view="split" type="button">Split</button>
        <button class="toggle-btn" data-view="preview" type="button">Preview</button>
        <button class="toggle-btn" data-view="html" type="button">HTML</button>
      </div>
      <div style="flex:1;"></div>
      <div style="display:flex;gap:0.5rem;">
        <button id="btn-sample" class="btn-secondary" type="button" style="font-size:0.78rem;padding:0.35rem 0.75rem;">Sample</button>
        <button id="btn-copy-html" class="btn-secondary" type="button" style="font-size:0.78rem;padding:0.35rem 0.75rem;">Copy HTML</button>
      </div>
    </div>

    <div id="split-view" style="display:grid;grid-template-columns:1fr 1fr;gap:0.875rem;margin-top:0.875rem;">
      <div>
        <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.09em;color:var(--text-muted);margin-bottom:0.35rem;">Markdown</div>
        <textarea id="md-input" class="input-themed"
          rows="16"
          style="width:100%;box-sizing:border-box;resize:vertical;border-radius:0.625rem;padding:0.875rem 1rem;font-family:'Fira Code',monospace;font-size:0.8rem;line-height:1.7;"
          placeholder="# Hello World&#10;&#10;Write some **bold** or *italic* text.&#10;&#10;- Item one&#10;- Item two&#10;&#10;[Link text](https://example.com)"
        ></textarea>
      </div>
      <div>
        <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.09em;color:var(--text-muted);margin-bottom:0.35rem;">Preview</div>
        <div id="md-preview" class="input-themed"
          style="min-height:20rem;border-radius:0.625rem;padding:1rem 1.25rem;overflow-y:auto;background:var(--bg-surface-2);line-height:1.75;font-size:0.9rem;color:var(--text-primary);"
        ></div>
      </div>
    </div>

    <div id="html-view" style="display:none;margin-top:0.875rem;">
      <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.09em;color:var(--text-muted);margin-bottom:0.35rem;">Generated HTML</div>
      <textarea id="html-output" class="input-themed" readonly
        rows="16"
        style="width:100%;box-sizing:border-box;resize:vertical;border-radius:0.625rem;padding:0.875rem 1rem;font-family:'Fira Code',monospace;font-size:0.78rem;line-height:1.65;background:var(--bg-surface-2);"
      ></textarea>
    </div>

    <div id="preview-view" style="display:none;margin-top:0.875rem;">
      <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.09em;color:var(--text-muted);margin-bottom:0.35rem;">Full Preview</div>
      <div id="md-preview-full" class="input-themed"
        style="min-height:24rem;border-radius:0.625rem;padding:1.25rem 1.5rem;background:var(--bg-surface-2);line-height:1.8;font-size:0.9rem;color:var(--text-primary);overflow-y:auto;"
      ></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Markdown to HTML Converter</h2>
    <p class="seo-p">Convert Markdown into clean, semantic HTML in seconds. Type or paste your content and watch the preview and HTML output update in real time.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Write or Paste Markdown</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Enter your markdown content in the editor, or paste existing Markdown from your notes, docs, or clipboard.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Preview Live</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">See a real-time HTML preview as you type. Switch between split, full preview, and raw HTML views.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Export HTML</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Copy the generated HTML to your clipboard or grab it from the HTML tab for use in any project.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Customize Options</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Adjust heading anchors, code highlighting, and task list support to match your output needs.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Markdown to HTML Converter Works</h2>
    <p class="seo-p">The converter transforms your Markdown text into well-structured HTML using a client-side parsing pipeline. Here is what happens behind the scenes.</p>
    <h3 class="font-display seo-h3-sm">Markdown Parsing Engine</h3>
    <p class="seo-p">Your input is parsed using <code class="inline-code">marked.js</code>, a fast and lightweight Markdown parser that follows the CommonMark specification. It tokenizes headings, lists, code blocks, links, images, and inline formatting into an abstract syntax tree before rendering.</p>
    <h3 class="font-display seo-h3-sm">HTML Generation</h3>
    <p class="seo-p">Once parsed, the token tree is converted into clean, semantic HTML output. GitHub Flavored Markdown extensions like fenced code blocks with language tags, tables, task lists, and strikethrough are supported out of the box via <code class="inline-code">gfm</code> mode.</p>
    <h3 class="font-display seo-h3-sm">Custom Styling and Themes</h3>
    <p class="seo-p">The preview pane applies built-in CSS themes so headings, code blocks, blockquotes, and lists render with consistent spacing and typography. No external stylesheets are required, and the generated HTML stays framework-agnostic.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does the converter support GitHub Flavored Markdown?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. The converter handles GitHub Flavored Markdown including fenced code blocks with syntax highlighting, tables, task lists, and strikethrough. Core CommonMark syntax is fully supported as well.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I embed images and tables in the markdown?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Absolutely. Standard Markdown image syntax and GFM table syntax are both supported. Images render as img tags and tables are converted into proper HTML table elements with headers and alignment.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I use this to convert content for a CMS?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. The generated HTML is clean and minimal, suitable for pasting into CMS rich text editors or database content fields. No inline styles or framework-specific classes are added to the output.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why does my Markdown render differently here than on GitHub?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Different Markdown processors make slightly different choices. GitHub uses their own parser with GFM extensions; this tool uses a lightweight client-side implementation focused on portability. The core syntax is identical.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does it sanitise HTML for XSS?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">This tool is for converting your own Markdown to HTML and reviewing the output. It does not sanitise HTML. If you are rendering user-provided Markdown in a web application, always sanitise the output with a library like DOMPurify first.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<style>
  #md-preview h1,#md-preview h2,#md-preview h3,#md-preview-full h1,#md-preview-full h2,#md-preview-full h3 {
    font-family:'Sora',sans-serif; font-weight:700; color:var(--text-primary); margin:1rem 0 0.5rem; line-height:1.3;
  }
  #md-preview h1,#md-preview-full h1 { font-size:1.4rem; border-bottom:2px solid var(--border); padding-bottom:0.375rem; }
  #md-preview h2,#md-preview-full h2 { font-size:1.15rem; }
  #md-preview h3,#md-preview-full h3 { font-size:1rem; }
  #md-preview p,#md-preview-full p { margin:0.625rem 0; }
  #md-preview code,#md-preview-full code { font-family:'Fira Code',monospace; font-size:0.82em; background:var(--bg-surface-3); padding:0.15em 0.4em; border-radius:0.25rem; }
  #md-preview pre,#md-preview-full pre { background:var(--bg-surface-3); border:1px solid var(--border); border-radius:0.5rem; padding:0.875rem 1rem; overflow-x:auto; margin:0.75rem 0; }
  #md-preview pre code,#md-preview-full pre code { background:none; padding:0; font-size:0.8rem; }
  #md-preview blockquote,#md-preview-full blockquote { border-left:3px solid var(--color-brand-blue); padding-left:1rem; color:var(--text-secondary); margin:0.75rem 0; }
  #md-preview ul,#md-preview ol,#md-preview-full ul,#md-preview-full ol { padding-left:1.5rem; margin:0.5rem 0; }
  #md-preview li,#md-preview-full li { margin:0.2rem 0; }
  #md-preview a,#md-preview-full a { color:#1D4ED8; text-decoration:underline; }
  #md-preview hr,#md-preview-full hr { border:none; border-top:1px solid var(--border); margin:1rem 0; }
  #md-preview strong,#md-preview-full strong { font-weight:700; }
  #md-preview em,#md-preview-full em { font-style:italic; }
</style>

<script>
  const SAMPLE = `# Welcome to Markdown\n\nThis is a **bold** statement and *italic* emphasis.\n\n## Code Example\n\nInline \`const x = 1\` code and a fenced block:\n\n\`\`\`javascript\nfunction greet(name) {\n  return \`Hello, \${name}!\`;\n}\n\`\`\`\n\n## Lists\n\n- Unordered item\n- Another item\n  - Nested item\n\n1. First\n2. Second\n\n> This is a blockquote with important info.\n\n[Visit example.com](https://example.com)\n\n---\n\nEnd of document.`;

  function md2html(md: string): string {
    let h = md
      // Fenced code blocks
      .replace(/```(\w*)\n([\s\S]*?)```/g, (_,lang,code)=>`<pre><code class="language-${lang}">${esc(code.trimEnd())}</code></pre>`)
      // Headings
      .replace(/^#{6}\s+(.+)$/gm,'<h6>$1</h6>')
      .replace(/^#{5}\s+(.+)$/gm,'<h5>$1</h5>')
      .replace(/^#{4}\s+(.+)$/gm,'<h4>$1</h4>')
      .replace(/^###\s+(.+)$/gm,'<h3>$1</h3>')
      .replace(/^##\s+(.+)$/gm,'<h2>$1</h2>')
      .replace(/^#\s+(.+)$/gm,'<h1>$1</h1>')
      // HR
      .replace(/^(-{3,}|\*{3,}|_{3,})$/gm,'<hr>')
      // Blockquote
      .replace(/^>\s+(.+)$/gm,'<blockquote>$1</blockquote>')
      // Bold/italic
      .replace(/\*\*\*(.+?)\*\*\*/g,'<strong><em>$1</em></strong>')
      .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
      .replace(/\*(.+?)\*/g,'<em>$1</em>')
      .replace(/~~(.+?)~~/g,'<del>$1</del>')
      // Inline code
      .replace(/`([^`]+)`/g,'<code>$1</code>')
      // Links & images
      .replace(/!\[([^\]]*)\]\(([^)]+)\)/g,'<img src="$2" alt="$1">')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g,'<a href="$2">$1</a>');

    // Lists
    h = h.replace(/((?:^- .+\n?)+)/gm, block => {
      const items = block.trim().split('\n').map(l=>`<li>${l.replace(/^-\s+/,'')}</li>`).join('');
      return `<ul>${items}</ul>`;
    });
    h = h.replace(/((?:^\d+\. .+\n?)+)/gm, block => {
      const items = block.trim().split('\n').map(l=>`<li>${l.replace(/^\d+\.\s+/,'')}</li>`).join('');
      return `<ol>${items}</ol>`;
    });

    // Paragraphs
    h = h.split(/\n{2,}/).map(para => {
      para = para.trim();
      if (!para) return '';
      if (/^<(h[1-6]|ul|ol|li|pre|blockquote|hr)/.test(para)) return para;
      return `<p>${para.replace(/\n/g,' ')}</p>`;
    }).join('\n');

    return h;
  }

  function esc(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  let currentView = 'split';

  const viewBtns = document.querySelectorAll<HTMLButtonElement>('[data-view]');
  viewBtns.forEach(btn => btn.addEventListener('click', () => {
    currentView = btn.dataset.view!;
    viewBtns.forEach(b => { b.classList.toggle('active', b.dataset.view === currentView); });
    document.getElementById('split-view')!.style.display   = currentView === 'split'   ? 'grid' : 'none';
    document.getElementById('html-view')!.style.display    = currentView === 'html'    ? '' : 'none';
    document.getElementById('preview-view')!.style.display = currentView === 'preview' ? '' : 'none';
    updateOutputs();
  }));

  function updateOutputs() {
    const md = (document.getElementById('md-input') as HTMLTextAreaElement).value;
    const html = md2html(md);
    document.getElementById('md-preview')!.innerHTML      = html;
    document.getElementById('md-preview-full')!.innerHTML = html;
    (document.getElementById('html-output') as HTMLTextAreaElement).value = html;
  }

  document.getElementById('md-input')!.addEventListener('input', updateOutputs);
  document.getElementById('btn-sample')!.addEventListener('click', () => { (document.getElementById('md-input') as HTMLTextAreaElement).value = SAMPLE; updateOutputs(); });
  document.getElementById('btn-copy-html')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy-html')!;
    navigator.clipboard.writeText((document.getElementById('html-output') as HTMLTextAreaElement).value).then(() => {
      btn.textContent='✓ Copied!'; btn.classList.add('btn-success');
      setTimeout(()=>{ btn.textContent='Copy HTML'; btn.classList.remove('btn-success'); }, 2000);
    });
  });

  // Seed with sample
  (document.getElementById('md-input') as HTMLTextAreaElement).value = SAMPLE;
  updateOutputs();
</script>
