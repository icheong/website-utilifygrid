---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'json-schema-validator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:#0F172A; margin-bottom:1.25rem;">JSON Schema Validator &amp; Formatter</h2>

    <div style="display:flex; gap:0.5rem; margin-bottom:0.875rem;">
      <button id="btn-validate" style="padding:0.5rem 1rem; background:#1D4ED8; color:#fff; border:none; border-radius:0.5rem; font-size:0.82rem; font-weight:600; cursor:pointer;">Validate &amp; Format</button>
      <button id="btn-minify" style="padding:0.5rem 1rem; background:#F8FAFC; color:#475569; border:1.5px solid #E2E8F0; border-radius:0.5rem; font-size:0.82rem; font-weight:600; cursor:pointer;">Minify</button>
      <button id="btn-clear" style="padding:0.5rem 1rem; background:#F8FAFC; color:#475569; border:1.5px solid #E2E8F0; border-radius:0.5rem; font-size:0.82rem; font-weight:600; cursor:pointer;">Clear</button>
      <div id="status-badge" style="margin-left:auto; display:flex; align-items:center; padding:0.35rem 0.75rem; border-radius:0.5rem; font-size:0.8rem; font-weight:700; background:#F1F5F9; color:#94A3B8;">Awaiting input</div>
    </div>

    <textarea id="json-input" spellcheck="false"
      style="width:100%; height:240px; padding:0.875rem; border:1.5px solid #BFDBFE; border-radius:0.625rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:#0F172A; resize:vertical; box-sizing:border-box; outline:none; line-height:1.6; tab-size:2;"
      onfocus="this.style.borderColor='#1D4ED8'" onblur="this.style.borderColor='#BFDBFE'"></textarea>

    <div id="error-box" style="display:none; margin-top:0.625rem; background:#FEF2F2; border:1px solid #FECACA; border-radius:0.5rem; padding:0.75rem 1rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:#DC2626; line-height:1.6;"></div>

    <div id="stats-row" style="display:none; margin-top:0.625rem; display:flex; gap:0.75rem; flex-wrap:wrap;">
      {[['out-keys','Keys'],['out-depth','Depth'],['out-size','Size']].map(([id, label]) => (
        <div style="background:#EFF6FF; border:1px solid #BFDBFE; border-radius:0.5rem; padding:0.375rem 0.75rem; font-size:0.78rem; display:flex; gap:0.375rem; align-items:center;">
          <span id={id} style="font-weight:700; color:#1D4ED8; font-family:'Sora',sans-serif;">—</span>
          <span style="color:#64748B;">{label}</span>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the JSON Schema Validator</h2>
    <p class="seo-p">Validate JSON data against a JSON Schema definition in seconds. Provide a schema, paste your data, and the tool reports every violation with its exact location.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Define Your Schema</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Write or paste your JSON Schema definition that describes the expected structure, types, and constraints of your data.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Provide Sample Data</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Enter the JSON data you want to validate. This can be an API response, a config object, or any JSON payload you need to check.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Run Validation</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Click the validate button to check your data against the schema. The tool instantly reports whether the data is valid or contains errors.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Review Errors</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">See detailed error messages with JSON paths so you know exactly which field failed and why, making fixes quick and straightforward.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the JSON Schema Validator Works</h2>
    <p class="seo-p">The validator parses both the schema and your data, then walks through every property to verify compliance against the defined rules.</p>
    <h3 class="font-display seo-h3-sm">Schema Draft Detection</h3>
    <p class="seo-p">The tool auto-detects the JSON Schema draft version from the <code class="inline-code">$schema</code> keyword. It supports Draft-04, Draft-07, and Draft 2020-12, adjusting validation behavior for keyword differences between each revision.</p>
    <h3 class="font-display seo-h3-sm">Type and Constraint Checking</h3>
    <p class="seo-p">Every property is validated against its declared <code class="inline-code">type</code>, <code class="inline-code">required</code> fields are verified, and constraint keywords like <code class="inline-code">pattern</code>, <code class="inline-code">minimum</code>, <code class="inline-code">maxLength</code>, and <code class="inline-code">enum</code> are evaluated to ensure the data matches the schema exactly.</p>
    <h3 class="font-display seo-h3-sm">Error Path Reporting</h3>
    <p class="seo-p">When a violation is found, the tool returns a full JSON path such as <code class="inline-code">user.addresses[0].zip</code> so you can locate the offending field instantly, even in deeply nested structures.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What JSON Schema drafts are supported?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The validator supports JSON Schema Draft-04, Draft-07, and Draft 2020-12. It automatically detects the draft version from the <code class="inline-code">$schema</code> keyword in your schema document and applies the correct validation rules for that revision.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I validate nested or deeply nested objects?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. The validator traverses the entire data tree recursively, validating every nested object and array element against the corresponding schema definition. Errors include full JSON paths so you can pinpoint issues at any depth.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why does JSON not allow trailing commas?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">JSON follows the RFC 8259 specification which strictly prohibits trailing commas after the last property or array element. While formats like JSON5 and JSONC allow them, standard JSON parsers will reject trailing commas as a syntax error.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between JSON and JSONP?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">JSON is a lightweight data format. JSONP was a workaround for browser same-origin restrictions that wrapped JSON in a callback function. It is now obsolete since modern APIs use CORS instead, and JSONP carries security risks that make it unsuitable for new projects.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I fix Unexpected token errors?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">These errors are usually caused by unquoted property names, single quotes instead of double quotes, trailing commas, JavaScript comments, or missing commas. Check the line and column number shown in the error message to locate the issue quickly.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is JSON Schema validation?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">JSON Schema is a standard for defining the structure, types, and constraints of JSON data. This tool lets you define a schema and validate any JSON payload against it, checking types, required fields, patterns, ranges, and more in real time.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
  const input = document.getElementById('json-input') as HTMLTextAreaElement;

  function countKeys(obj: any): number {
    if (typeof obj !== 'object' || obj === null) return 0;
    let count = 0;
    for (const k in obj) { count++; count += countKeys(obj[k]); }
    return count;
  }

  function maxDepth(obj: any, d = 0): number {
    if (typeof obj !== 'object' || obj === null) return d;
    let max = d;
    for (const k in obj) max = Math.max(max, maxDepth(obj[k], d + 1));
    return max;
  }

  function offsetToLineCol(text: string, offset: number): { line: number; col: number } {
    const before = text.slice(0, offset);
    const lines  = before.split('\n');
    return { line: lines.length, col: lines[lines.length - 1].length + 1 };
  }

  function setStatus(ok: boolean | null) {
    const badge = document.getElementById('status-badge')!;
    if (ok === true)  { badge.style.background = '#F0FDF4'; badge.style.color = '#16A34A'; badge.textContent = '✓ Valid JSON'; }
    else if (ok === false) { badge.style.background = '#FEF2F2'; badge.style.color = '#DC2626'; badge.textContent = '✗ Invalid'; }
    else { badge.style.background = '#F1F5F9'; badge.style.color = '#94A3B8'; badge.textContent = 'Awaiting input'; }
  }

  function validate(format = true) {
    const text = input.value.trim();
    const errBox = document.getElementById('error-box') as HTMLElement;
    const statsRow = document.getElementById('stats-row') as HTMLElement;

    if (!text) { setStatus(null); errBox.style.display = 'none'; statsRow.style.display = 'none'; return; }

    try {
      const parsed = JSON.parse(text);
      errBox.style.display = 'none';
      setStatus(true);
      if (format) input.value = JSON.stringify(parsed, null, 2);

      const keys  = countKeys(parsed);
      const depth = maxDepth(parsed);
      const size  = new TextEncoder().encode(text).byteLength;
      (document.getElementById('out-keys') as HTMLElement).textContent  = String(keys);
      (document.getElementById('out-depth') as HTMLElement).textContent = String(depth);
      (document.getElementById('out-size') as HTMLElement).textContent  = size < 1024 ? size + ' B' : (size / 1024).toFixed(1) + ' KB';
      statsRow.style.display = 'flex';
    } catch (e: any) {
      setStatus(false);
      statsRow.style.display = 'none';
      const match = e.message.match(/position (\d+)/);
      if (match) {
        const { line, col } = offsetToLineCol(text, parseInt(match[1]));
        errBox.innerHTML = `<strong>Parse error at line ${line}, col ${col}:</strong><br>${e.message}`;
      } else {
        errBox.textContent = e.message;
      }
      errBox.style.display = 'block';
    }
  }

  document.getElementById('btn-validate')?.addEventListener('click', () => validate(true));
  document.getElementById('btn-minify')?.addEventListener('click', () => {
    const text = input.value.trim();
    try { input.value = JSON.stringify(JSON.parse(text)); setStatus(true); } catch { validate(false); }
  });
  document.getElementById('btn-clear')?.addEventListener('click', () => {
    input.value = ''; setStatus(null);
    (document.getElementById('error-box') as HTMLElement).style.display = 'none';
    (document.getElementById('stats-row') as HTMLElement).style.display = 'none';
  });

  input.value = JSON.stringify({
    name: "Example Response", version: 2, enabled: true,
    tags: ["json","validator","tool"],
    nested: { level: 1, deeper: { level: 2, value: null } }
  }, null, 2);
</script>
