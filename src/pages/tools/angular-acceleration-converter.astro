---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'angular-acceleration-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Angular Acceleration Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter an angular acceleration and select its unit — all others update instantly with visual gauges.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.25rem;">
      <div>
        <label class="tool-label" for="angacc-input">Angular Acceleration</label>
        <input id="angacc-input" type="number" value="31.4159" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="angacc-unit">Unit</label>
        <select id="angacc-unit" class="select-themed" style="min-width:10rem;">
          <option value="rads2" selected>rad/s²</option>
          <option value="degs2">°/s²</option>
          <option value="rpms">RPM/s</option>
          <option value="revs2">rev/s²</option>
          <option value="hzs">Hz/s</option>
        </select>
      </div>
    </div>

    <!-- Visual gauges -->
    <div style="display:grid;grid-template-columns:auto 1fr;gap:1.5rem;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;">
      <!-- Tachometer gauge -->
      <svg viewBox="0 0 200 130" width="200" height="130" style="flex-shrink:0;">
        <defs>
          <linearGradient id="gaugeGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#22c55e" />
            <stop offset="60%" stop-color="#eab308" />
            <stop offset="100%" stop-color="#ef4444" />
          </linearGradient>
        </defs>
        <!-- Background arc -->
        <path d="M 20 115 A 80 80 0 0 1 180 115" fill="none" stroke="var(--border)" stroke-width="12" stroke-linecap="round" />
        <!-- Colored arc -->
        <path id="gauge-fill" d="M 20 115 A 80 80 0 0 1 180 115" fill="none" stroke="url(#gaugeGrad)" stroke-width="12" stroke-linecap="round" stroke-dasharray="251.2" stroke-dashoffset="251.2" />
        <!-- Needle -->
        <line id="gauge-needle" x1="100" y1="115" x2="100" y2="40" stroke="var(--text-primary)" stroke-width="2.5" stroke-linecap="round" />
        <circle cx="100" cy="115" r="5" fill="var(--text-primary)" />
        <!-- Value label -->
        <text id="gauge-val" x="100" y="108" text-anchor="middle" font-family="Fira Code, monospace" font-size="14" font-weight="700" fill="var(--text-primary)">0</text>
      </svg>
      <div style="min-width:0;">
        <p id="angacc-display" style="font-size:1.6rem;font-weight:700;font-family:'Fira Code',monospace;color:var(--text-primary);margin-bottom:0.25rem;">31.42 rad/s²</p>
        <p class="seo-p-sm" style="margin-bottom:0;">= <span id="angacc-rads2">31.4159</span> rad/s²</p>
        <p class="seo-p-sm">= <span id="angacc-degs">1800</span> °/s²</p>
      </div>
    </div>

    <!-- Bar chart -->
    <div style="margin-bottom:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Magnitude Comparison (rad/s²)</p>
      <svg id="angacc-chart" viewBox="0 0 600 250" width="100%" height="250" style="display:block;border-radius:0.5rem;background:var(--bg-surface);border:1.5px solid var(--border);"></svg>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Angular Acceleration Converter Overview</h2>
    <p class="seo-p">
      This angular acceleration converter computes precise conversions between 5 angular acceleration units — radians per second squared, degrees per second squared, revolutions per second per second, revolutions per second squared, and hertz per second — entirely within your browser. Built with modern vanilla JavaScript and SVG visualisation, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your calculations, whether you are working in mechanical engineering, robotics, physics education, or industrial automation.
    </p>
    <p class="seo-p">
      The converter features both a tachometer-style gauge showing magnitude relative to reference accelerations and a comparative SVG bar chart for context against real-world rotational accelerations. The tool handles the full range from extremely slow astronomical rotations (micro-radians per second squared) to extremely fast hard drive spin-up rates (tens of thousands of rad/s²), with dynamic formatting that adapts to each result's magnitude. The quick-reference section provides benchmarks from turntable start-up to jet turbine acceleration.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        [`Motor control and industrial automation`, `Variable frequency drives (VFDs) and servo controllers specify angular acceleration in RPM/s or rad/s² when programming ramp-up and ramp-down profiles. A conveyor motor programmed to reach 1,800 RPM in 3 seconds has an angular acceleration of 600 RPM/s ≈ 62.8 rad/s². Converting between these units is essential when translating between motor datasheet specifications (typically in RPM/s) and control system parameters (typically in rad/s²).`],
        [`Robotics and joint trajectory planning`, `Robotic arm joints are specified by their maximum angular acceleration, which determines how quickly they can change direction. A high-speed pick-and-place robot might have a joint acceleration of 500 rad/s², while a heavy-payload industrial robot might be limited to 50 rad/s². Trajectory planning algorithms compute joint paths using rad/s², but motor controllers may accept RPM/s — this converter bridges the gap.`],
        [`Physics experiments and rotational dynamics labs`, `University physics labs measure angular acceleration using rotary motion sensors and compute it from angular velocity changes. A disk accelerating from rest to 600 RPM in 2 seconds has an angular acceleration of 300 RPM/s ≈ 31.4 rad/s². Students need to convert between sensor output units (often in °/s² or rev/s²) and the rad/s² required for torque and moment-of-inertia calculations using τ = Iα.`]
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      All conversions use radians per second squared (rad/s²) as the universal base unit. Each supported angular acceleration unit is defined by a fixed conversion factor relative to one rad/s². To convert from unit A to unit B, the tool multiplies the input value by A's factor to obtain rad/s², then divides by B's factor to obtain the target value. This hub-and-spoke model guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">rads2</code>, <code class="inline-code">rpms</code>, <code class="inline-code">hzs</code>) to its conversion factor relative to rad/s². Degree-based units use <code class="inline-code">π/180</code> per degree. Revolution-based units use <code class="inline-code">2π</code> per revolution. The radian is the natural angular unit, so its factor is exactly 1.
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion to rad/s²:</strong> The input value is multiplied by the source unit's factor. For example, converting 2000 RPM/s to rad/s²: <code class="inline-code">2000 × (2π/60) = 2000 × 0.10472 ≈ 209.44 rad/s²</code>. Converting 1800°/s²: <code class="inline-code">1800 × (π/180) = 1800 × 0.01745 ≈ 31.42 rad/s²</code>.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion from rad/s²:</strong> The rad/s² value is divided by the target unit's factor. Converting 209.44 rad/s² to Hz/s: <code class="inline-code">209.44 / (2π) ≈ 33.33 Hz/s</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>.
    </p>
    <p class="seo-p-sm">
      <strong>4. SVG gauge and chart rendering:</strong> The tachometer gauge uses a semicircular arc with <code class="inline-code">stroke-dasharray</code> and <code class="inline-code">stroke-dashoffset</code> to indicate magnitude. The needle rotates from -90° (left) to +90° (right) based on the value relative to the maximum reference. The bar chart dynamically scales to accommodate the user's value alongside reference accelerations using linear scaling.
    </p>
    <p class="seo-p-none">
      <strong>Exact conversion factors:</strong> All factors are derived from exact mathematical definitions: <code class="inline-code">1 revolution = 2π radians = 360°</code>. The radian factor is exactly 1. The degree factor is exactly <code class="inline-code">π/180</code>. The RPM/s factor is exactly <code class="inline-code">2π/60 = π/30</code>. The Hz/s factor is exactly <code class="inline-code">2π</code>. These are irrational values (involving π), so the JavaScript factors are IEEE 754 double-precision approximations providing approximately 15 to 17 significant decimal digits of precision.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is angular acceleration?",
          a: "Angular acceleration is the rate at which angular velocity changes over time — it measures how quickly a rotating object speeds up or slows down. Its SI unit is radians per second squared (rad/s²). If a flywheel increases its rotation speed by 2π rad/s every second, its angular acceleration is exactly 1 rad/s². Angular acceleration is a vector quantity; its direction indicates whether the rotation is speeding up or slowing down."
        },
        {
          q: "How is angular acceleration different from linear acceleration?",
          a: "Linear acceleration describes changes in straight-line speed (m/s²), while angular acceleration describes changes in rotational speed (rad/s²). They are related by the equation a = α × r, where a is the tangential linear acceleration at the rim, α is the angular acceleration, and r is the radius. A point on the rim of a disk with α = 10 rad/s² at radius 0.5 m has a tangential acceleration of 5 m/s²."
        },
        {
          q: "What is a good example of angular acceleration?",
          a: "A car engine accelerating from idle (1,000 RPM) to redline (7,000 RPM) in 3 seconds has an angular acceleration of approximately 2,000 RPM/s ≈ 209 rad/s². A centrifuge spinning up from rest to 50,000 RPM in 30 seconds has approximately 1,667 RPM/s ≈ 175 rad/s². A hard drive platter reaching 7,200 RPM in 0.5 seconds achieves approximately 14,400 RPM/s ≈ 1,508 rad/s²."
        },
        {
          q: "What is the relationship between Hz/s and rad/s²?",
          a: "1 Hz/s equals 1 revolution per second per second, which is exactly 2π radians per second per second. Therefore Hz/s and rev/s² are numerically identical, and both equal 2π rad/s². This is because one full revolution is defined as exactly 2π radians. The conversion factor between Hz/s and rad/s² is simply 2π."
        },
        {
          q: "What is torque and how does it relate to angular acceleration?",
          a: "Torque is the rotational equivalent of force, and it relates to angular acceleration through Newton's second law for rotation: τ = I × α, where τ is torque (N·m), I is moment of inertia (kg·m²), and α is angular acceleration (rad/s²). A larger torque or smaller moment of inertia produces greater angular acceleration. This equation is fundamental in mechanical engineering for sizing motors and flywheels."
        },
        {
          q: "How do I calculate angular acceleration from measured data?",
          a: "Angular acceleration equals the change in angular velocity divided by the time interval: α = Δω / Δt. If a motor's speed increases from 1,000 RPM to 3,000 RPM in 2 seconds, first convert to rad/s: Δω = (3,000 - 1,000) × (2π/60) ≈ 209.4 rad/s, then α = 209.4 / 2 = 104.7 rad/s². This tool can convert the result to any other angular acceleration unit."
        },
        {
          q: "What units do motor manufacturers use for angular acceleration?",
          a: "Motor manufacturers typically specify angular acceleration in RPM/s or rev/s² because these are intuitive for rotational machinery. However, control system engineers prefer rad/s² because it integrates directly with SI unit calculations for torque, power, and energy. This converter bridges both conventions, allowing engineers to translate between datasheet specifications and control system parameters."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to rad/s² ────────────────────────────────
  const TO_RADS2 = {
    rads2: 1,
    degs2: Math.PI / 180,
    rpms:  (2 * Math.PI) / 60,
    revs2: 2 * Math.PI,
    hzs:   2 * Math.PI,
  };

  const UNITS = [
    { id: 'rads2', label: 'rad/s²',  name: 'Radian per Second²' },
    { id: 'degs2', label: '°/s²',    name: 'Degree per Second²' },
    { id: 'rpms',  label: 'RPM/s',   name: 'RPM per Second' },
    { id: 'revs2', label: 'rev/s²',  name: 'Revolution per Second²' },
    { id: 'hzs',   label: 'Hz/s',    name: 'Hertz per Second' },
  ];

  const REFS = [
    { name: 'Earth Rotation Speedup',  rads2: 0.000073 },
    { name: 'Turntable (start)',        rads2: 0.5 },
    { name: 'Blender (start)',          rads2: 150 },
    { name: 'Car Engine (idle→redline)',rads2: 209 },
    { name: 'Centrifuge (spin-up)',     rads2: 175 },
    { name: 'Jet Turbine (start)',      rads2: 2500 },
    { name: 'Drill (start)',            rads2: 15000 },
    { name: 'Hard Drive (start)',       rads2: 45000 },
  ];

  const BAR_DATA = [
    { name: 'Turntable',      rads2: 0.5 },
    { name: 'Blender',        rads2: 150 },
    { name: 'Car Engine',     rads2: 209 },
    { name: 'Centrifuge',     rads2: 175 },
    { name: 'Jet Turbine',    rads2: 2500 },
    { name: 'Hard Drive',     rads2: 45000 },
  ];

  const input    = document.getElementById('angacc-input') as HTMLInputElement;
  const select   = document.getElementById('angacc-unit') as HTMLSelectElement;
  const grid     = document.getElementById('results')!;
  const refsDiv  = document.getElementById('refs')!;
  const chart    = document.getElementById('angacc-chart')!;
  const gaugeFill = document.getElementById('gauge-fill')!;
  const gaugeNeedle = document.getElementById('gauge-needle')!;
  const gaugeVal = document.getElementById('gauge-val')!;
  const angaccDisp = document.getElementById('angacc-display')!;
  const angaccRads = document.getElementById('angacc-rads2')!;
  const angaccDegs = document.getElementById('angacc-degs')!;

  const ARC_TOTAL = 251.2; // approximate arc length of semicircle r=80

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e12) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    return value.toExponential(4);
  }

  function drawGauge(rads2: number) {
    const maxRef = Math.max(...REFS.map(r => r.rads2), rads2) * 1.2;
    const fraction = Math.min(rads2 / maxRef, 1);
    const offset = ARC_TOTAL * (1 - fraction);
    gaugeFill.setAttribute('stroke-dashoffset', String(offset));

    // Needle rotation: -90 (left) to +90 (right)
    const angle = -90 + fraction * 180;
    const rad = angle * Math.PI / 180;
    const nx = 100 + 70 * Math.sin(rad);
    const ny = 115 - 70 * Math.cos(rad);
    gaugeNeedle.setAttribute('x2', String(nx));
    gaugeNeedle.setAttribute('y2', String(ny));

    gaugeVal.textContent = fmt(rads2);
  }

  function drawChart(userRads2: number) {
    chart.innerHTML = '';
    const pad = { top: 10, bottom: 10, left: 130, right: 60 };
    const svgW = 600;
    const svgH = 250;
    const w = svgW - pad.left - pad.right;
    const rows = BAR_DATA.length + 1;
    const rowH = (svgH - pad.top - pad.bottom) / rows;
    const barH = rowH * 0.55;

    const maxVal = Math.max(userRads2, ...BAR_DATA.map(b => b.rads2)) * 1.2;

    function yPos(i: number) {
      return pad.top + i * rowH + (rowH - barH) / 2;
    }

    // User bar
    const uW = Math.max((userRads2 / maxVal) * w, 2);
    const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    rect.setAttribute('x', String(pad.left));
    rect.setAttribute('y', String(yPos(0)));
    rect.setAttribute('width', String(uW));
    rect.setAttribute('height', String(barH));
    rect.setAttribute('rx', '3');
    rect.setAttribute('fill', 'var(--color-brand-blue)');
    chart.appendChild(rect);

    const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    label.setAttribute('x', String(pad.left - 8));
    label.setAttribute('y', String(yPos(0) + barH / 2 + 4));
    label.setAttribute('text-anchor', 'end');
    label.setAttribute('fill', 'var(--color-brand-blue)');
    label.setAttribute('font-size', '11');
    label.setAttribute('font-weight', '600');
    label.setAttribute('font-family', 'Sora, sans-serif');
    label.textContent = 'Your Value';
    chart.appendChild(label);

    const valText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    valText.setAttribute('x', String(pad.left + uW + 6));
    valText.setAttribute('y', String(yPos(0) + barH / 2 + 4));
    valText.setAttribute('fill', 'var(--text-secondary)');
    valText.setAttribute('font-size', '10');
    valText.setAttribute('font-family', 'Fira Code, monospace');
    valText.textContent = fmt(userRads2) + ' rad/s²';
    chart.appendChild(valText);

    // Reference bars
    BAR_DATA.forEach((b, i) => {
      const idx = i + 1;
      const bw = Math.max((b.rads2 / maxVal) * w, 2);

      const r = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      r.setAttribute('x', String(pad.left));
      r.setAttribute('y', String(yPos(idx)));
      r.setAttribute('width', String(bw));
      r.setAttribute('height', String(barH));
      r.setAttribute('rx', '3');
      r.setAttribute('fill', 'var(--border)');
      chart.appendChild(r);

      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('x', String(pad.left - 8));
      t.setAttribute('y', String(yPos(idx) + barH / 2 + 4));
      t.setAttribute('text-anchor', 'end');
      t.setAttribute('fill', 'var(--text-secondary)');
      t.setAttribute('font-size', '10');
      t.setAttribute('font-family', 'Sora, sans-serif');
      t.textContent = b.name;
      chart.appendChild(t);

      const v = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      v.setAttribute('x', String(pad.left + bw + 6));
      v.setAttribute('y', String(yPos(idx) + barH / 2 + 4));
      v.setAttribute('fill', 'var(--text-muted)');
      v.setAttribute('font-size', '9');
      v.setAttribute('font-family', 'Fira Code, monospace');
      v.textContent = fmt(b.rads2) + ' rad/s²';
      chart.appendChild(v);
    });
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const rads2    = val * TO_RADS2[fromUnit];

    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    angaccDisp.textContent = `${fmt(val)} ${unitLabel}`;
    angaccRads.textContent = fmt(rads2);
    angaccDegs.textContent = fmt(rads2 * 180 / Math.PI);

    drawGauge(rads2);
    drawChart(rads2);

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = rads2 / TO_RADS2[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // Quick references
    refsDiv.innerHTML = '';
    REFS.forEach(r => {
      const value = r.rads2 / TO_RADS2[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refsDiv.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
