---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'pressure-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Pressure Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a pressure value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="pres-input">Pressure</label>
        <input id="pres-input" type="number" value="101325" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="pres-unit">Unit</label>
        <select id="pres-unit" class="select-themed" style="min-width:10rem;">
          <option value="pa" selected>Pascal (Pa)</option>
          <option value="kpa">Kilopascal (kPa)</option>
          <option value="mpa">Megapascal (MPa)</option>
          <option value="bar">Bar</option>
          <option value="mbar">Millibar (mbar)</option>
          <option value="atm">Atmosphere (atm)</option>
          <option value="psi">PSI (lbf/in²)</option>
          <option value="mmhg">mmHg / Torr</option>
          <option value="inhg">Inches of Mercury</option>
          <option value="cmh2o">cm Water Column</option>
          <option value="inh2o">Inches of Water Column</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Convert Between PSI, Bar, mmHg, and Other Pressure Units</h2>
    <p class="seo-p">
      Your European car manual specifies 2.2 bar for the front tyres, but the pressure gauge at the petrol station reads PSI. Pumping to 2.2 PSI would leave the tyres dangerously flat. Enter 2.2, select bar, and the converter instantly shows 31.91 PSI, 1650 mmHg, and every other equivalent. The copy button lets you paste the PSI value straight into your mental checklist before inflating.
    </p>
    <p class="seo-p">
      The converter handles 11 units from pascals to inches of water column. A nurse checking a ventilator set to 5.0 kPa needs to verify it matches the 37.5 mmHg ordered by the physician. A weather enthusiast comparing a storm reading of 985 hPa with a US forecast of 29.09 inHg can confirm they describe the same low-pressure system. The quick-reference row shows everyday pressures: a car tyre at 220 kPa, a pressure cooker at 200 kPa, a SCUBA tank at 20,684 kPa.
    </p>

    <h3 class="font-display seo-h3-sm">Automotive tyre pressure where the wrong unit means danger</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Inflating tyres to the wrong specification', 'A driver in the US sees their German car manual specifying 2.4 bar for rear tyres. If they pump to 2.4 PSI instead, the tyres are at about 17% of their intended pressure — a blowout risk at highway speed. The correct value is 34.8 PSI. This converter eliminates that dangerous confusion by showing all equivalent values at once, so you can match the number to the unit your gauge displays.'],
        ['Blood pressure monitoring across devices', 'A patient uses a home monitor that displays kPa, but their doctor\'s records show mmHg. A reading of 16.0/10.7 kPa converts to 120/80 mmHg — the standard normal range. If the patient misreads the kPa value as mmHg and reports 16/10 to their doctor, the doctor would diagnose dangerously low blood pressure. The converter bridges the gap between medical device standards across countries.'],
        ['Weather pressure for storm tracking', 'A sailor in the Caribbean monitors barometric pressure and sees 1005 hPa dropping rapidly. The hurricane advisory from the US National Hurricane Centre reports central pressure in millibars (identical to hPa) but older charts use inches of mercury. Converting 950 hPa (a Category 3 hurricane) gives 28.05 inHg. Knowing both numbers means the sailor can read weather charts from any source without confusion.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/energy-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Energy Converter</a>
        <a href="/tools/force-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Force Converter</a>
        <a href="/tools/temperature-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Temperature Converter</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Pressure Converter Handles PSI, Bar, mmHg, and Kilopascals</h2>
    <p class="seo-p">
      Every unit in the converter is stored as a multiple of one pascal. When you enter 32 PSI, the tool multiplies 32 by 6894.757 to get 220,632.2 Pa, then divides by each target unit's factor. Because the conversion passes through pascals in a single step, there is no chain of intermediate conversions. The result for 32 PSI to bar is exactly 2.206322 bar — not an approximation derived from rounding 1 PSI = 0.06894757 bar first.
    </p>

    <h3 class="font-display seo-h3-sm">Why standard atmosphere is defined as exactly 101,325 Pa</h3>
    <p class="seo-p-sm">
      The standard atmosphere (atm) was defined by the International Union of Pure and Applied Chemistry (IUPAC) as exactly 101,325 pascals. This value represents the average atmospheric pressure at sea level at 15°C. The bar, by contrast, is defined as exactly 100,000 Pa — a round number chosen for convenience. The difference between 1 atm and 1 bar is 1,325 Pa, or about 1.3%. This matters in aviation, where altimeter settings are calibrated in hectopascals (equivalent to millibars), and in weather forecasting, where a 1 hPa change in pressure can indicate a significant weather shift.
    </p>
    <p class="seo-p-sm">
      PSI (pound-force per square inch) is derived from the pound-force (4.4482216152605 N) divided by the square inch (6.4516 × 10⁻⁴ m²). The result is 6894.757293168... Pa. This factor has more decimal places than the others because it combines two exact definitions (the pound-force and the inch) through division, producing an irrational number that must be truncated for display. mmHg uses standard gravity (9.80665 m/s²) and the density of mercury at 0°C (13,595.1 kg/m³), giving 133.322387415 Pa.
    </p>

    <h3 class="font-display seo-h3-sm">Gauge pressure versus absolute pressure</h3>
    <p class="seo-p-sm">
      Most pressure gauges read gauge pressure — relative to the surrounding atmosphere. A tyre gauge reading 32 PSI means 32 PSI above atmospheric pressure, which is 46.7 PSI absolute (32 + 14.696). Weather reports use absolute pressure. A barometric reading of 1013 hPa is absolute. If you subtract atmospheric pressure (1013 hPa), you get 0 hPa gauge — which is just ambient air. This converter works with absolute pressure units. To convert gauge to absolute, add 14.696 PSI (or 101.325 kPa) first.
    </p>
    <p class="seo-p-none">
      Water column units (cmH₂O, inH₂O) are used for low-pressure measurements like ventilation systems and medical ventilators. 1 cmH₂O = 98.0665 Pa. A typical medical ventilator operates at 5-20 cmH₂O, which is 490-1961 Pa — far below atmospheric pressure. These units exist because mercury is too dense to measure such small pressures accurately; water provides a more readable column height.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How many PSI is 2.4 bar?",
          a: "2.4 bar equals 34.81 PSI. The conversion factor is 1 bar = 14.50377 PSI. For a quick mental estimate, multiply bar by 14.5 — so 2.4 × 14.5 = 34.8 PSI. This is the standard front tyre pressure for most European sedans. If your gauge reads PSI, set it to about 35."
        },
        {
          q: "What is the difference between PSI and kPa?",
          a: "1 PSI equals 6.89476 kPa. PSI is pounds per square inch (imperial), while kPa is kilopascals (metric). A car tyre at 32 PSI is at 220.6 kPa. For quick estimates, multiply PSI by 6.9 to get kPa. The kPa figure is what European car manuals and weather reports use."
        },
        {
          q: "Why do doctors still use mmHg for blood pressure?",
          a: "Blood pressure was historically measured by the height of a mercury column in a sphygmomanometer. A reading of 120/80 mmHg means the blood pressure supports a column of mercury 120 mm high during systole. Although mercury devices are being phased out for environmental reasons, the mmHg unit persists because every doctor and nurse trained worldwide understands it. Electronic monitors convert their sensor readings to mmHg for display."
        },
        {
          q: "How do I convert inches of mercury to hPa?",
          a: "Multiply inHg by 33.8639 to get hPa. A standard sea-level reading of 29.92 inHg equals 1013.25 hPa. For quick estimates, multiply inHg by about 33.9. US weather reports use inHg, while international reports use hPa (identical to mbar). The conversion matters when comparing hurricane forecasts from the US National Hurricane Centre (inHg) with international models (hPa)."
        },
        {
          q: "What happens to tyre pressure in cold weather?",
          a: "Tyre pressure drops about 1 PSI for every 10°F (5.5°C) decrease in ambient temperature. A tyre inflated to 32 PSI in summer at 80°F would read about 28 PSI on a 40°F winter morning — below the recommended minimum. This is why tyre pressure warning lights often activate during autumn temperature drops. Check and adjust pressure when tyres are cold."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to Pa ────────────────────────────────────
  const TO_PA = {
    pa:   1,
    kpa:  1_000,
    mpa:  1_000_000,
    bar:  100_000,
    mbar: 100,
    atm:  101_325,
    psi:  6894.757,
    mmhg: 133.3224,
    inhg: 3386.389,
    cmh2o: 98.0665,
    inh2o: 249.0889,
  };

  const UNITS = [
    { id: 'pa',    label: 'Pa',      name: 'Pascal',              decimals: 2 },
    { id: 'kpa',   label: 'kPa',     name: 'Kilopascal',          decimals: 4 },
    { id: 'mpa',   label: 'MPa',     name: 'Megapascal',          decimals: 6 },
    { id: 'bar',   label: 'bar',     name: 'Bar',                 decimals: 6 },
    { id: 'mbar',  label: 'mbar',    name: 'Millibar',            decimals: 4 },
    { id: 'atm',   label: 'atm',     name: 'Atmosphere',          decimals: 6 },
    { id: 'psi',   label: 'PSI',     name: 'Pounds per Sq Inch',  decimals: 4 },
    { id: 'mmhg',  label: 'mmHg',    name: 'Millimeters of Mercury', decimals: 2 },
    { id: 'inhg',  label: 'inHg',    name: 'Inches of Mercury',   decimals: 4 },
    { id: 'cmh2o', label: 'cmH₂O',   name: 'Centimeters of Water', decimals: 4 },
    { id: 'inh2o', label: 'inH₂O',   name: 'Inches of Water',     decimals: 4 },
  ];

  // ── Quick-reference objects (stored in Pa) ──────────────────────
  const REFS = [
    { name: 'Human Breath (inhale)',  pa: 100_100 },
    { name: 'Vacuum Cleaner',         pa: 97_000 },
    { name: 'Sea-Level Atmosphere',   pa: 101_325 },
    { name: 'Car Tire (32 PSI)',      pa: 220_632 },
    { name: 'Pressure Cooker',        pa: 200_000 },
    { name: 'SCUBA Tank (3000 PSI)',  pa: 20_684_270 },
    { name: 'Hydraulic Press',        pa: 30_000_000 },
    { name: 'Diamond Formation',      pa: 5_000_000_000 },
  ];

  const input  = document.getElementById('pres-input') as HTMLInputElement;
  const select = document.getElementById('pres-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9)  return value.toExponential(4);
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const paVal    = val * TO_PA[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = paVal / TO_PA[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = r.pa / TO_PA[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
