---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'pressure-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Pressure Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a pressure value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="pres-input">Pressure</label>
        <input id="pres-input" type="number" value="101325" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="pres-unit">Unit</label>
        <select id="pres-unit" class="select-themed" style="min-width:10rem;">
          <option value="pa" selected>Pascal (Pa)</option>
          <option value="kpa">Kilopascal (kPa)</option>
          <option value="mpa">Megapascal (MPa)</option>
          <option value="bar">Bar</option>
          <option value="mbar">Millibar (mbar)</option>
          <option value="atm">Atmosphere (atm)</option>
          <option value="psi">PSI (lbf/in²)</option>
          <option value="mmhg">mmHg / Torr</option>
          <option value="inhg">Inches of Mercury</option>
          <option value="cmh2o">cm Water Column</option>
          <option value="inh2o">Inches of Water Column</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Pressure Converter Overview</h2>
    <p class="seo-p">
      This pressure converter computes precise conversions between 11 metric and imperial pressure units entirely within your browser. Built with modern vanilla JavaScript, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your measurements, whether you are working in engineering, medicine, meteorology, or automotive maintenance.
    </p>
    <p class="seo-p">
      The converter supports the most commonly used pressure units across metric and imperial systems: pascals, kilopascals, megapascals, bar, and millibar for SI/metric; atmospheres, PSI, millimeters of mercury, inches of mercury, centimeters of water column, and inches of water column for imperial/medical. Results are dynamically formatted based on magnitude, switching between fixed notation, locale-formatted numbers, and scientific notation as appropriate.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Automotive tire pressure monitoring', 'Car tires are typically inflated to 30–35 PSI, which converts to approximately 207–241 kPa or 2.0–2.4 bar. European vehicles specify tire pressure in bar, while US vehicles use PSI. A mechanic reading 32 PSI on a gauge needs to know this equals 2.21 bar or 220.6 kPa for calibration. The quick-reference section helps visualise everyday pressures like a car tire (220 kPa), a pressure cooker (200 kPa), or a SCUBA tank (20,684 kPa) for intuitive scale comparison.'],
        ['Medical and clinical diagnostics', 'Blood pressure is universally measured in millimeters of mercury (mmHg). A normal reading of 120/80 mmHg converts to approximately 16.0/10.7 kPa or 15,999/10,666 Pa. Medical devices manufactured in different countries may display pressure in different units — a Japanese ventilator showing kPa must be cross-referenced with mmHg for US-trained nurses. The tool handles the full range from clinical low pressures to high-pressure medical equipment with IEEE 754 double-precision accuracy.'],
        ['Meteorology and weather forecasting', 'Atmospheric pressure is reported in hectopascals (hPa), millibars (mbar), or inches of mercury (inHg) depending on the country. Standard sea-level pressure is 1013.25 hPa (1013.25 mbar), equivalent to 29.92 inHg or 14.696 PSI. Weather maps show pressure systems in millibars, while US news reports use inches of mercury. Converting between these units is essential for interpreting international weather data and understanding storm intensity.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      The converter employs a hub-and-spoke conversion model using pascals as the universal base unit. Every supported pressure unit is defined by a fixed conversion factor relative to one pascal. To convert from unit A to unit B, the tool multiplies the input value by A's factor to obtain pascals, then divides by B's factor to obtain the target value. This approach guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">pa</code>, <code class="inline-code">psi</code>, <code class="inline-code">atm</code>) to its exact factor in pascals. Metric units use powers of 10 (e.g. <code class="inline-code">1 kPa = 1,000 Pa</code>, <code class="inline-code">1 MPa = 1,000,000 Pa</code>), while imperial/medical units use internationally defined values.
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion:</strong> The input value is multiplied by the source unit's factor to convert to pascals. For example, converting 14.696 PSI to pascals: <code class="inline-code">14.696 × 6894.757 = 101,325 Pa</code>. This intermediate result is an IEEE 754 double-precision floating-point number, which provides approximately 15 to 17 significant decimal digits of precision.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion:</strong> The pascal value is divided by the target unit's factor. Converting 101,325 Pa to bar: <code class="inline-code">101325 / 100000 = 1.01325 bar</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>.
    </p>
    <p class="seo-p-sm">
      <strong>4. Dynamic formatting:</strong> The display format adapts to the magnitude of the result. Large values (1 billion or greater) use scientific notation. Values between 1,000 and 1 billion use locale-formatted numbers with 2 to 4 decimal places. Values between 0.001 and 1,000 use 6 to 8 decimal places. Values below 0.001 use scientific notation. This ensures readability across the full range from water column measurements to hydraulic press pressures.
    </p>
    <p class="seo-p-none">
      <strong>Exact vs. approximate factors:</strong> The standard atmosphere is defined as exactly 101,325 Pa, making <code class="inline-code">1 atm = 101,325 Pa</code> exact. The bar is defined as exactly 100,000 Pa. PSI is derived from the pound-force (exactly 4.4482216152605 N) and the inch (exactly 25.4 mm), so <code class="inline-code">1 PSI = 6894.757293168... Pa</code> (rounded to 6 decimal places). mmHg is defined using standard gravity and mercury density, making <code class="inline-code">1 mmHg = 133.322387415 Pa</code> (rounded). Water column units are derived from the density of water at 4°C and standard gravity.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is the difference between PSI and bar?",
          a: "1 bar equals approximately 14.504 PSI. The bar is a metric unit widely used in Europe for tire pressure and weather. PSI (pounds per square inch) is the imperial unit commonly used in the US for tire pressure, plumbing, and industrial applications. For quick mental conversion, 1 bar is roughly 14.5 PSI, so multiply bar by about 14.5 to get PSI."
        },
        {
          q: "What is standard atmospheric pressure?",
          a: "Standard atmospheric pressure at sea level is 101,325 Pa (1013.25 hPa), which equals 1 atm, 14.696 PSI, 760 mmHg, or 29.92 inHg. This is the reference pressure used as a baseline for weather reports and altitude calculations. At higher altitudes, atmospheric pressure decreases — at 5,000 meters, it is roughly half of sea-level pressure."
        },
        {
          q: "What is a Pascal?",
          a: "A Pascal (Pa) is the SI unit of pressure, defined as one newton of force applied per square meter (1 Pa = 1 N/m²). It is a very small unit, so kilopascals (kPa) and megapascals (MPa) are commonly used in engineering and science. For reference, a human breath creates about 100,100 Pa of pressure, while a SCUBA tank operates at over 20 million Pa."
        },
        {
          q: "Why is mmHg used in medicine?",
          a: "mmHg (millimeters of mercury) is used in medicine because blood pressure was traditionally measured with a mercury column. 1 mmHg equals approximately 133.322 Pa. Blood pressure readings like 120/80 mmHg are universally understood by medical professionals. Although electronic monitors are replacing mercury devices, the mmHg unit remains the standard for reporting blood pressure worldwide."
        },
        {
          q: "What is the typical pressure of a car tire?",
          a: "Most car tires are inflated to 30–35 PSI (207–241 kPa or 2.0–2.4 bar). Under-inflation reduces fuel efficiency and handling, while over-inflation can cause blowouts. Always check your vehicle's recommended tire pressure on the door jamb sticker. Tire pressure increases about 1 PSI for every 10°F (5.5°C) rise in temperature, so seasonal changes affect readings."
        },
        {
          q: "What is the difference between gauge pressure and absolute pressure?",
          a: "Gauge pressure is measured relative to atmospheric pressure (0 PSI gauge = 14.696 PSI absolute). Absolute pressure includes atmospheric pressure as its baseline. A tire gauge reading 32 PSI gauge is actually 46.7 PSI absolute. Weather reports use absolute pressure, while tire gauges and most industrial pressure measurements use gauge pressure. This tool converts between absolute pressure units."
        },
        {
          q: "How do I convert bar to PSI in my head?",
          a: "Multiply bar by approximately 14.5 to get PSI. For example, 2 bar × 14.5 = 29 PSI. To convert PSI to bar, divide by 14.5. A quick mental shortcut: 1 bar is close to 1 atmosphere (14.7 PSI), so you can also think of bar as roughly atmospheres × 1.013. For precise calculations, use 1 bar = 14.50377 PSI."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to Pa ────────────────────────────────────
  const TO_PA = {
    pa:   1,
    kpa:  1_000,
    mpa:  1_000_000,
    bar:  100_000,
    mbar: 100,
    atm:  101_325,
    psi:  6894.757,
    mmhg: 133.3224,
    inhg: 3386.389,
    cmh2o: 98.0665,
    inh2o: 249.0889,
  };

  const UNITS = [
    { id: 'pa',    label: 'Pa',      name: 'Pascal',              decimals: 2 },
    { id: 'kpa',   label: 'kPa',     name: 'Kilopascal',          decimals: 4 },
    { id: 'mpa',   label: 'MPa',     name: 'Megapascal',          decimals: 6 },
    { id: 'bar',   label: 'bar',     name: 'Bar',                 decimals: 6 },
    { id: 'mbar',  label: 'mbar',    name: 'Millibar',            decimals: 4 },
    { id: 'atm',   label: 'atm',     name: 'Atmosphere',          decimals: 6 },
    { id: 'psi',   label: 'PSI',     name: 'Pounds per Sq Inch',  decimals: 4 },
    { id: 'mmhg',  label: 'mmHg',    name: 'Millimeters of Mercury', decimals: 2 },
    { id: 'inhg',  label: 'inHg',    name: 'Inches of Mercury',   decimals: 4 },
    { id: 'cmh2o', label: 'cmH₂O',   name: 'Centimeters of Water', decimals: 4 },
    { id: 'inh2o', label: 'inH₂O',   name: 'Inches of Water',     decimals: 4 },
  ];

  // ── Quick-reference objects (stored in Pa) ──────────────────────
  const REFS = [
    { name: 'Human Breath (inhale)',  pa: 100_100 },
    { name: 'Vacuum Cleaner',         pa: 97_000 },
    { name: 'Sea-Level Atmosphere',   pa: 101_325 },
    { name: 'Car Tire (32 PSI)',      pa: 220_632 },
    { name: 'Pressure Cooker',        pa: 200_000 },
    { name: 'SCUBA Tank (3000 PSI)',  pa: 20_684_270 },
    { name: 'Hydraulic Press',        pa: 30_000_000 },
    { name: 'Diamond Formation',      pa: 5_000_000_000 },
  ];

  const input  = document.getElementById('pres-input') as HTMLInputElement;
  const select = document.getElementById('pres-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9)  return value.toExponential(4);
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const paVal    = val * TO_PA[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = paVal / TO_PA[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = r.pa / TO_PA[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
