---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'acceleration-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Acceleration Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter an acceleration and select its unit — all others update instantly with a comparative bar chart.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.25rem;">
      <div>
        <label class="tool-label" for="acc-input">Acceleration</label>
        <input id="acc-input" type="number" value="9.80665" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="acc-unit">Unit</label>
        <select id="acc-unit" class="select-themed" style="min-width:10rem;">
          <option value="ms2" selected>m/s²</option>
          <option value="g">g (gravity)</option>
          <option value="ft2">ft/s²</option>
          <option value="in2">in/s²</option>
          <option value="cm2">cm/s² (Gal)</option>
          <option value="km2">km/s²</option>
          <option value="kmhs">km/h/s</option>
          <option value="mphs">mph/s</option>
        </select>
      </div>
    </div>

    <!-- Bar chart -->
    <div style="margin-bottom:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Magnitude Comparison (m/s²)</p>
      <svg id="acc-chart" viewBox="0 0 600 290" width="100%" height="290" style="display:block;border-radius:0.5rem;background:var(--bg-surface);border:1.5px solid var(--border);"></svg>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Acceleration Converter Overview</h2>
    <p class="seo-p">
      This acceleration converter computes precise conversions between 8 acceleration units — meters per second squared, standard gravity, feet per second squared, inches per second squared, Gal (centimeters per second squared), kilometers per second squared, kilometers per hour per second, and miles per hour per second — entirely within your browser. Built with modern vanilla JavaScript and SVG charting, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your calculations, whether you are working in automotive engineering, aerospace, seismology, or physics education.
    </p>
    <p class="seo-p">
      The converter features a comparative SVG bar chart that displays your entered value alongside common real-world accelerations — from elevator motion to Formula 1 cars — providing immediate visual context. The tool handles the full range from microgravity experiments (millionths of g) to extreme rocket launches (several g), with dynamic formatting that adapts to each result's magnitude. Standard gravity (1 g = 9.80665 m/s²) serves as the universal reference point for intuitive comparison.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        [`Automotive performance engineering and vehicle testing`, `Automotive engineers measure vehicle acceleration in multiple units depending on context: 0–60 mph times convert to m/s² for physics calculations, g-forces for driver experience analysis, and mph/s for regulatory compliance. A car achieving 0–60 mph in 4 seconds accelerates at 6.7 m/s² (0.68 g). Converting between these units is essential when comparing manufacturer specifications, which may use different units depending on the market (European specs often use m/s² while US specs use mph/s).`],
        [`Aerospace and astronautics`, `Rocket launches and spacecraft maneuvers are specified in g-forces for crew safety analysis and m/s² for trajectory calculations. A typical crewed launch subjects astronauts to 3–4 g during ascent, while abort scenarios can briefly reach 8–12 g. Converting between g and m/s² is critical for structural load analysis: a 1,000 kg payload experiencing 5 g requires a mounting structure rated for 49,033 N (1,000 × 9.80665 × 5).`],
        [`Seismology and earthquake engineering`, `Seismologists measure ground acceleration in Gal (cm/s²) because earthquake motions produce small accelerations that are conveniently expressed in this unit. A magnitude 7 earthquake can produce peak ground accelerations of 1,000–3,000 Gal (10–30 m/s², approximately 1–3 g). Converting Gal to g-force helps engineers design structures that can withstand seismic loads: a building must resist horizontal forces proportional to the peak ground acceleration multiplied by its mass.`]
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      All conversions use meters per second squared (m/s²) as the universal base unit. Each supported acceleration unit is defined by a fixed conversion factor relative to one m/s². To convert from unit A to unit B, the tool multiplies the input value by A's factor to obtain m/s², then divides by B's factor to obtain the target value. This hub-and-spoke model guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">ms2</code>, <code class="inline-code">g</code>, <code class="inline-code">ft2</code>) to its conversion factor relative to m/s². Standard gravity is defined as exactly <code class="inline-code">9.80665 m/s²</code>. Imperial units use exact definitions: <code class="inline-code">1 ft = 0.3048 m</code> exactly, so <code class="inline-code">1 ft/s² = 0.3048 m/s²</code>. The Gal is exactly <code class="inline-code">0.01 m/s²</code>.
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion to m/s²:</strong> The input value is multiplied by the source unit's factor. For example, converting 2 g to m/s²: <code class="inline-code">2 × 9.80665 = 19.6133 m/s²</code>. Converting 60 mph/s to m/s²: <code class="inline-code">60 × 0.44704 = 26.8224 m/s²</code>. The intermediate result is an IEEE 754 double-precision floating-point number.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion from m/s²:</strong> The m/s² value is divided by the target unit's factor. Converting 19.6133 m/s² to ft/s²: <code class="inline-code">19.6133 / 0.3048 ≈ 64.35 ft/s²</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>.
    </p>
    <p class="seo-p-sm">
      <strong>4. SVG bar chart rendering:</strong> The chart dynamically scales to accommodate the user's value alongside reference accelerations. The maximum bar width is set to 1.2× the largest value (user or reference) to prevent overflow. Each bar's pixel width is calculated as <code class="inline-code">(value / maxValue) × availableWidth</code>. Labels and values are positioned using SVG text elements with consistent font sizing.
    </p>
    <p class="seo-p-none">
      <strong>Exact conversion factors:</strong> All factors are derived from exact international definitions: <code class="inline-code">1 g = 9.80665 m/s²</code> (standard gravity, defined by the 3rd CGPM in 1901), <code class="inline-code">1 ft = 0.3048 m</code> (international foot, defined in 1959), <code class="inline-code">1 in = 0.0254 m</code> (exactly 1/12 of a foot), <code class="inline-code">1 Gal = 0.01 m/s²</code> (exactly). The <code class="inline-code">km/h/s</code> factor is <code class="inline-code">1/3.6</code> (exactly), derived from <code class="inline-code">1 km/h = 1/3.6 m/s</code>. These are all exact rational values, so the IEEE 754 approximations provide full double-precision accuracy.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is 1 g of acceleration?",
          a: "1 g equals exactly 9.80665 m/s², which is the standard acceleration due to Earth's gravitational pull at sea level. When you drop an object, it accelerates at approximately 1 g (ignoring air resistance). Astronauts on the International Space Station experience microgravity not because Earth's gravity is weaker at that altitude, but because they are in continuous free fall around the planet."
        },
        {
          q: "What is the acceleration of a sports car?",
          a: "A typical sports car accelerates from 0 to 60 mph in about 3 to 4 seconds, which translates to approximately 6.7 to 8.9 m/s² (0.68 to 0.91 g). A Tesla Model S Plaid achieves approximately 1.2 g. Formula 1 cars can exceed 2 g during hard acceleration and over 5 g under braking. These values are measured at the vehicle's centre of mass."
        },
        {
          q: "How much g-force can a human survive?",
          a: "Humans can tolerate approximately 5 g sustained for short periods without specialised equipment. Fighter pilots train to withstand 9 g with the help of g-suits that compress the legs to prevent blood from pooling. In car crashes, forces can reach 50 to 100 g for milliseconds, which is survivable with proper restraint systems. NASA centrifuge tests subject volunteers to up to 10 g for research purposes."
        },
        {
          q: "What is a Gal?",
          a: "A Gal (galileo) equals exactly 1 cm/s² or 0.01 m/s². It is named after Galileo Galilei and is the standard unit used in seismology to measure ground acceleration during earthquakes. Strong earthquakes can produce peak ground accelerations of 1,000 to 3,000 Gal (10 to 30 m/s²). The related unit milliGal (mGal) is used in gravimetry for measuring subtle variations in Earth's gravitational field."
        },
        {
          q: "What is the acceleration due to gravity on other planets?",
          a: "Mars: 3.72 m/s² (0.38 g), Moon: 1.62 m/s² (0.17 g), Jupiter: 24.79 m/s² (2.53 g), Venus: 8.87 m/s² (0.90 g). An object weighs approximately 38% of its Earth weight on Mars and approximately 17% on the Moon. On Jupiter, the same object would weigh over 2.5 times its Earth weight, which is why gas giants are often referenced as extreme acceleration environments."
        },
        {
          q: "What is the difference between acceleration and deceleration?",
          a: "Acceleration and deceleration are the same physical quantity — a change in velocity over time — distinguished only by direction relative to the current motion. Acceleration increases speed (positive), while deceleration decreases it (negative). In physics, both are measured in the same units (m/s², g, etc.) and are handled identically in calculations. The converter handles both positive and negative values."
        },
        {
          q: "How do I convert between g-force and m/s²?",
          a: "To convert g-force to m/s², multiply by 9.80665 (standard gravity). To convert m/s² to g-force, divide by 9.80665. For example, 3 g equals 29.42 m/s² (3 × 9.80665), and 50 m/s² equals approximately 5.1 g (50 / 9.80665). This conversion is essential in aerospace engineering, where structural loads are specified in g but trajectory calculations require m/s²."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to m/s² ──────────────────────────────────
  const TO_MS2 = {
    ms2:  1,
    g:    9.80665,
    ft2:  0.3048,
    in2:  0.0254,
    cm2:  0.01,
    km2:  1000,
    kmhs: 1 / 3.6,
    mphs: 0.44704,
  };

  const UNITS = [
    { id: 'ms2',  label: 'm/s²',   name: 'Meter per Second²' },
    { id: 'g',    label: 'g',       name: 'Standard Gravity' },
    { id: 'ft2',  label: 'ft/s²',   name: 'Foot per Second²' },
    { id: 'in2',  label: 'in/s²',   name: 'Inch per Second²' },
    { id: 'cm2',  label: 'cm/s²',   name: 'Gal' },
    { id: 'km2',  label: 'km/s²',   name: 'Kilometer per Second²' },
    { id: 'kmhs', label: 'km/h/s',  name: 'km/h per Second' },
    { id: 'mphs', label: 'mph/s',   name: 'mph per Second' },
  ];

  // ── Quick-reference objects (stored in m/s²) ────────────────────
  const REFS = [
    { name: 'Moon Gravity',           ms2: 1.62 },
    { name: 'Mars Gravity',           ms2: 3.72 },
    { name: 'Earth Gravity',          ms2: 9.80665 },
    { name: 'Jupiter Gravity',        ms2: 24.79 },
    { name: 'Elevator (typical)',     ms2: 1.5 },
    { name: 'Car 0–60 mph (4 sec)',   ms2: 6.7 },
    { name: 'Sports Car (3 sec)',     ms2: 8.9 },
    { name: 'Formula 1 Car',          ms2: 19.6 },
  ];

  const BAR_DATA = [
    { name: 'Elevator',        ms2: 1.5 },
    { name: 'Car (4s)',        ms2: 6.7 },
    { name: 'Sports Car',      ms2: 8.9 },
    { name: 'Earth g',         ms2: 9.80665 },
    { name: 'F1 Car',          ms2: 19.6 },
    { name: 'Fighter Jet',     ms2: 29.4 },
  ];

  const input    = document.getElementById('acc-input') as HTMLInputElement;
  const select   = document.getElementById('acc-unit') as HTMLSelectElement;
  const grid     = document.getElementById('results')!;
  const refsDiv  = document.getElementById('refs')!;
  const chart    = document.getElementById('acc-chart')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    return value.toExponential(4);
  }

  function drawChart(userMs2: number) {
    chart.innerHTML = '';
    const pad = { top: 10, bottom: 10, left: 130, right: 60 };
    const svgW = 600;
    const svgH = 290;
    const w = svgW - pad.left - pad.right;
    const rows = BAR_DATA.length + 1; // user + references
    const rowH = (svgH - pad.top - pad.bottom) / rows;
    const barH = rowH * 0.55;

    const maxVal = Math.max(userMs2, ...BAR_DATA.map(b => b.ms2)) * 1.2;

    function yPos(i: number) {
      return pad.top + i * rowH + (rowH - barH) / 2;
    }

    // User bar (index 0)
    const uW = Math.max((userMs2 / maxVal) * w, 2);
    const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    rect.setAttribute('x', String(pad.left));
    rect.setAttribute('y', String(yPos(0)));
    rect.setAttribute('width', String(uW));
    rect.setAttribute('height', String(barH));
    rect.setAttribute('rx', '3');
    rect.setAttribute('fill', 'var(--color-brand-blue)');
    chart.appendChild(rect);

    const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    label.setAttribute('x', String(pad.left - 8));
    label.setAttribute('y', String(yPos(0) + barH / 2 + 4));
    label.setAttribute('text-anchor', 'end');
    label.setAttribute('fill', 'var(--color-brand-blue)');
    label.setAttribute('font-size', '11');
    label.setAttribute('font-weight', '600');
    label.setAttribute('font-family', 'Sora, sans-serif');
    label.textContent = 'Your Value';
    chart.appendChild(label);

    const valText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    valText.setAttribute('x', String(pad.left + uW + 6));
    valText.setAttribute('y', String(yPos(0) + barH / 2 + 4));
    valText.setAttribute('fill', 'var(--text-secondary)');
    valText.setAttribute('font-size', '10');
    valText.setAttribute('font-family', 'Fira Code, monospace');
    valText.textContent = fmt(userMs2) + ' m/s²';
    chart.appendChild(valText);

    // Reference bars
    BAR_DATA.forEach((b, i) => {
      const idx = i + 1;
      const bw = Math.max((b.ms2 / maxVal) * w, 2);

      const r = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      r.setAttribute('x', String(pad.left));
      r.setAttribute('y', String(yPos(idx)));
      r.setAttribute('width', String(bw));
      r.setAttribute('height', String(barH));
      r.setAttribute('rx', '3');
      r.setAttribute('fill', 'var(--border)');
      chart.appendChild(r);

      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('x', String(pad.left - 8));
      t.setAttribute('y', String(yPos(idx) + barH / 2 + 4));
      t.setAttribute('text-anchor', 'end');
      t.setAttribute('fill', 'var(--text-secondary)');
      t.setAttribute('font-size', '10');
      t.setAttribute('font-family', 'Sora, sans-serif');
      t.textContent = b.name;
      chart.appendChild(t);

      const v = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      v.setAttribute('x', String(pad.left + bw + 6));
      v.setAttribute('y', String(yPos(idx) + barH / 2 + 4));
      v.setAttribute('fill', 'var(--text-muted)');
      v.setAttribute('font-size', '9');
      v.setAttribute('font-family', 'Fira Code, monospace');
      v.textContent = fmt(b.ms2) + ' m/s²';
      chart.appendChild(v);
    });
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const ms2      = val * TO_MS2[fromUnit];

    drawChart(ms2);

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = ms2 / TO_MS2[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refsDiv.innerHTML = '';
    REFS.forEach(r => {
      const value = r.ms2 / TO_MS2[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refsDiv.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
