---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'json-yaml-toml-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">JSON to YAML / TOML Converter</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Bidirectional converter between JSON, YAML, and TOML. Type in either panel and see the other update instantly.</p>

    <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
      <button id="btn-convert-right" class="btn-primary" type="button">JSON → YAML</button>
      <button id="btn-convert-left" class="btn-primary" type="button" style="background:#059669;">YAML → JSON</button>
      <button id="btn-sample" class="btn-secondary" type="button">Sample</button>
      <button id="btn-clear" class="btn-secondary" type="button">Clear</button>
    </div>

    <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
      <div class="toggle-group" role="group" aria-label="Output format">
        <button class="toggle-btn active" data-fmt="yaml" type="button">YAML</button>
        <button class="toggle-btn" data-fmt="toml" type="button">TOML</button>
      </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem;">
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);">JSON</label>
          <button id="btn-copy-json" class="btn-secondary" type="button" style="font-size:0.7rem; padding:0.2rem 0.55rem;">Copy</button>
        </div>
        <textarea id="json-input" class="input-themed" rows="12"
          placeholder='{"name": "Alice", "age": 30}'
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65;"
        ></textarea>
      </div>
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted);"><span id="output-label">YAML</span></label>
          <button id="btn-copy-output" class="btn-secondary" type="button" style="font-size:0.7rem; padding:0.2rem 0.55rem;">Copy</button>
        </div>
        <textarea id="output-area" class="input-themed" readonly rows="12"
          placeholder="Converted output appears here…"
          style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65; background:var(--bg-surface-2);"
        ></textarea>
      </div>
    </div>

    <div id="error-box" style="display:none; margin-top:0.625rem; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); border-radius:0.5rem; padding:0.75rem 1rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:#DC2626;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">JSON to YAML / TOML Converter Overview</h2>
    <p class="seo-p">
      This bidirectional converter translates JSON documents into YAML or TOML format — and back again — using a custom JavaScript serialisation engine that runs entirely in your browser. Paste valid JSON into the left panel, select your target format (YAML or TOML), and the converted output appears instantly. You can also paste YAML or TOML into the right panel and convert back to JSON for round-trip verification. Every operation is 100% client-side, meaning your data never leaves your device.
    </p>
    <p class="seo-p">
      The converter handles all standard JSON types including nested objects, arrays, strings, numbers, booleans, and null values. TOML output uses <code class="inline-code">[table]</code> sections for nested objects and <code class="inline-code">[[array-of-tables]]</code> for object arrays. YAML output uses block-style formatting with consistent indentation and proper quoting for keys and values that contain special characters. Both formats preserve the full structural fidelity of the original JSON.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['DevOps configuration migration', 'A platform engineer migrating infrastructure-as-code from JSON (Terraform variables) to YAML (Ansible playbooks or Kubernetes manifests) can convert configurations instantly. The round-trip capability validates that no data is lost during the format transition, which is critical for production deployments.'],
        ['TOML-based project configuration', 'A developer setting up a Python project that uses pyproject.toml for dependencies and tooling (as required by PEP 621) can convert existing JSON configuration to TOML format. The converter handles nested tool sections correctly, producing valid TOML that tools like Poetry or PDM can consume directly.'],
        ['Data exchange between heterogeneous systems', 'An integration engineer bridging two systems that use different serialisation formats can use this converter as a translation layer. JSON input from one API can be converted to YAML for a CI/CD pipeline, or TOML configuration from a Rust application can be converted to JSON for analysis in a JavaScript monitoring dashboard.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Serialisation Engine and Format-Specific Mechanics</h2>
    <p class="seo-p">
      The conversion pipeline starts by parsing the input with <code class="inline-code">JSON.parse()</code> to build an in-memory JavaScript object tree. This parsed tree is then passed to a format-specific serialiser that recursively walks the structure and emits the target format with correct indentation, quoting, and structural markers.
    </p>
    <h3 class="seo-h3-sm">YAML Serialisation</h3>
    <p class="seo-p">
      The YAML serialiser produces block-style YAML with 2-space indentation. Objects are rendered as mappings with <code class="inline-code">key: value</code> syntax. Arrays become block sequences with leading hyphens. String values are quoted only when they contain characters that could be misinterpreted as YAML syntax (colons, hashes, leading whitespace, or numeric patterns). Nested objects and arrays are indented recursively. The serialiser does not support YAML anchors, aliases, or multi-line literal blocks, targeting the common subset used in most configuration files.
    </p>
    <h3 class="seo-h3-sm">TOML Serialisation</h3>
    <p class="seo-p">
      The TOML serialiser groups object keys into three categories: scalar values, nested tables, and arrays of tables. Scalars (strings, numbers, booleans) are emitted as top-level key-value pairs. Nested objects become <code class="inline-code">[table]</code> sections with dotted keys for deeper nesting. Arrays of homogeneous objects become <code class="inline-code">[[array-of-tables]]</code> sections per the TOML v1.0 specification. String values are quoted with double quotes and escape sequences for special characters. Inline arrays of primitive values use the <code class="inline-code">[1, 2, 3]</code> syntax.
    </p>
    <h3 class="seo-h3-sm">YAML/TOML to JSON (Reverse Conversion)</h3>
    <p class="seo-p-none">
      For reverse conversion, the input is parsed using a lightweight format-specific parser. The YAML parser handles nested mappings, block sequences, and quoted/ unquoted scalars using regex-based tokenisation with indentation tracking. The TOML parser processes <code class="inline-code">[table]</code> and <code class="inline-code">[[array-of-tables]]</code> headers to build nested objects, then converts the result to JSON via <code class="inline-code">JSON.stringify()</code>.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does YAML or TOML support everything JSON does?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Mostly. YAML supports all JSON types plus dates, anchors, and multi-line literal strings. TOML supports dates natively and has stricter type inference. Both formats support nested objects and arrays, but edge cases may differ. For example, TOML does not have a null type — null values in JSON are omitted during TOML conversion.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can it handle circular references?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">No. Circular references are not representable in JSON, YAML, or TOML as standard serialisation formats. If your input contains a circular reference, the initial <code class="inline-code">JSON.parse()</code> step will accept it, but <code class="inline-code">JSON.stringify()</code> will throw a <code class="inline-code">TypeError</code>. Ensure your data is acyclic before attempting conversion.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What about YAML anchors and aliases?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">YAML anchors (<code class="inline-code">&name</code>) and aliases (<code class="inline-code">*name</code>) are not supported in this converter. The parser treats them as literal strings during reverse conversion. For full anchor support, including resolution and dereferencing, use a dedicated YAML library such as <code class="inline-code">js-yaml</code> in JavaScript or <code class="inline-code">PyYAML</code> in Python.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Is the TOML output valid?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes, for standard structures. The converter generates valid TOML v1.0 for flat objects, nested tables, and arrays. Complex TOML features such as inline tables within arrays, dotted keys on table headers, or multi-line basic strings are not fully supported. If your use case requires these features, verify the output against a TOML validator.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I verify the round-trip accuracy?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Paste the output back into the converter in reverse mode. For example, after converting JSON to YAML, paste the YAML output into the right panel and click YAML to JSON. If the round-tripped JSON matches the original, the conversion is accurate. Minor formatting differences (such as whitespace) do not affect semantic equality.</p>
        </div>
      </div>

    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLE = JSON.stringify({
    name: "Alice", age: 30, active: true,
    address: { city: "Sydney", postcode: "2000", country: "AU" },
    tags: ["developer", "designer"],
    meta: { created: "2024-01-15", version: 3 }
  }, null, 2);

  let outputFmt = 'yaml';

  const fmtBtns = document.querySelectorAll<HTMLButtonElement>('[data-fmt]');
  fmtBtns.forEach(btn => btn.addEventListener('click', () => {
    outputFmt = btn.dataset.fmt!;
    fmtBtns.forEach(b => b.classList.toggle('active', b.dataset.fmt === outputFmt));
    (document.getElementById('output-label') as HTMLElement).textContent = outputFmt.toUpperCase();
    (document.getElementById('btn-convert-right') as HTMLElement).textContent = `JSON → ${outputFmt.toUpperCase()}`;
    convert();
  }));

  function yamlKeyNeedsQuoting(k: string): boolean {
    return /[:\s#{}\[\],&*?|>!%`]/.test(k) || /^\d/.test(k) || k === '' || k === 'true' || k === 'false' || k === 'null';
  }

  function yamlEscapeString(s: string): string {
    return s
      .replace(/\\/g, '\\\\')
      .replace(/"/g, '\\"')
      .replace(/\n/g, '\\n')
      .replace(/\r/g, '\\r')
      .replace(/\t/g, '\\t');
  }

  function yamlQuoteKey(k: string): string {
    if (yamlKeyNeedsQuoting(k)) return `"${yamlEscapeString(k)}"`;
    return k;
  }

  function jsonToYaml(obj: any, indent = 0): string {
    if (obj === null) return 'null';
    if (typeof obj === 'boolean') return String(obj);
    if (typeof obj === 'number') return String(obj);
    if (typeof obj === 'string') {
      if (obj.includes('\n') || obj.includes(':') || obj.includes('#') || obj.startsWith(' ') || obj === '' || /^\d/.test(obj) || obj === 'true' || obj === 'false' || obj === 'null') {
        return `"${yamlEscapeString(obj)}"`;
      }
      return obj;
    }
    if (Array.isArray(obj)) {
      if (obj.length === 0) return '[]';
      return obj.map(item => {
        const val = jsonToYaml(item, indent + 1);
        if (typeof item === 'object' && item !== null && !Array.isArray(item)) {
          return '\n' + '  '.repeat(indent + 1) + '- ' + val.trimStart();
        }
        return '\n' + '  '.repeat(indent + 1) + '- ' + val;
      }).join('');
    }
    if (typeof obj === 'object') {
      const keys = Object.keys(obj);
      if (keys.length === 0) return '{}';
      return keys.map(k => {
        const val = jsonToYaml(obj[k], indent + 1);
        const qk = yamlQuoteKey(k);
        if (typeof obj[k] === 'object' && obj[k] !== null && !Array.isArray(obj[k]) && Object.keys(obj[k]).length > 0) {
          return '\n' + '  '.repeat(indent) + qk + ':' + val;
        }
        return '\n' + '  '.repeat(indent) + qk + ': ' + val;
      }).join('');
    }
    return String(obj);
  }

  function tomlKeyNeedsQuoting(k: string): boolean {
    return /[\s.]/.test(k) || k === '' || /[^a-zA-Z0-9_-]/.test(k);
  }

  function tomlEscapeString(s: string): string {
    return s
      .replace(/\\/g, '\\\\')
      .replace(/"/g, '\\"')
      .replace(/\n/g, '\\n')
      .replace(/\r/g, '\\r')
      .replace(/\t/g, '\\t');
  }

  function tomlQuoteKey(k: string): string {
    if (tomlKeyNeedsQuoting(k)) return `"${tomlEscapeString(k)}"`;
    return k;
  }

  function jsonToToml(obj: any, prefix = ''): string {
    const lines: string[] = [];
    const scalars: Record<string, any> = {};
    const tables: Record<string, any> = {};
    const arraysOfTables: Record<string, any[]> = {};
    const primitiveArrays: Record<string, any[]> = {};

    for (const [k, v] of Object.entries(obj)) {
      if (v === null) continue;
      if (typeof v !== 'object') scalars[k] = v;
      else if (Array.isArray(v)) {
        if (v.length === 0) primitiveArrays[k] = v;
        else if (typeof v[0] === 'object' && v[0] !== null && !Array.isArray(v[0])) arraysOfTables[k] = v;
        else primitiveArrays[k] = v;
      }
      else tables[k] = v;
    }

    for (const [k, v] of Object.entries(scalars)) {
      const val = typeof v === 'string' ? `"${tomlEscapeString(v)}"` : typeof v === 'boolean' ? String(v) : String(v);
      lines.push(`${tomlQuoteKey(k)} = ${val}`);
    }
    for (const [k, v] of Object.entries(primitiveArrays)) {
      const items = v.map((item: any) => {
        if (item === null) return '""';
        if (typeof item === 'string') return `"${tomlEscapeString(item)}"`;
        return String(item);
      }).join(', ');
      lines.push(`${tomlQuoteKey(k)} = [${items}]`);
    }
    for (const [k, v] of Object.entries(arraysOfTables)) {
      for (const item of v) {
        const section = prefix ? `${prefix}.${k}` : k;
        lines.push(`\n[[${section}]]`);
        lines.push(jsonToToml(item, section));
      }
    }
    for (const [k, v] of Object.entries(tables)) {
      const section = prefix ? `${prefix}.${k}` : k;
      lines.push(`\n[${section}]`);
      lines.push(jsonToToml(v, section));
    }
    return lines.join('\n');
  }

  function convert() {
    const raw = (document.getElementById('json-input') as HTMLTextAreaElement).value;
    const out = (document.getElementById('output-area') as HTMLTextAreaElement);
    const errBox = document.getElementById('error-box')!;
    errBox.style.display = 'none';
    if (!raw.trim()) { out.value = ''; return; }

    try {
      const parsed = JSON.parse(raw);
      out.value = outputFmt === 'yaml' ? jsonToYaml(parsed).trim() : jsonToToml(parsed);
    } catch (e: any) {
      errBox.textContent = 'JSON error: ' + e.message;
      errBox.style.display = 'block';
    }
  }

  document.getElementById('btn-convert-right')!.addEventListener('click', convert);
  document.getElementById('btn-sample')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = SAMPLE;
    convert();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = '';
    (document.getElementById('output-area') as HTMLTextAreaElement).value = '';
    document.getElementById('error-box')!.style.display = 'none';
  });
  ['btn-copy-json', 'btn-copy-output'].forEach(id => {
    document.getElementById(id)!.addEventListener('click', () => {
      const src = id === 'btn-copy-json' ? 'json-input' : 'output-area';
      const btn = document.getElementById(id)!;
      navigator.clipboard.writeText((document.getElementById(src) as HTMLTextAreaElement).value).then(() => {
        btn.textContent = '✓ Copied!'; btn.classList.add('btn-success');
        setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
      }).catch(() => {});
    });
  });

  document.getElementById('json-input')!.addEventListener('input', convert);
</script>
