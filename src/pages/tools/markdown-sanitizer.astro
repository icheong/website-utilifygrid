---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'markdown-sanitizer')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">

    <!-- ── Header bar ── -->
    <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1.25rem; flex-wrap:wrap;">
      <div style="display:flex; align-items:center; gap:0.75rem;">
        <div style="width:2.25rem; height:2.25rem; border-radius:0.625rem; background:linear-gradient(135deg,#064E3B,#059669); display:flex; align-items:center; justify-content:center; flex-shrink:0; box-shadow:0 3px 10px rgba(5,150,105,0.35);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
          </svg>
        </div>
        <div>
          <h2 style="font-family:'Sora',sans-serif; font-size:1.05rem; font-weight:700; color:var(--text-primary); margin:0 0 0.1rem;">Markdown Sanitizer &amp; Formatter</h2>
          <p style="font-size:0.76rem; color:var(--text-muted); margin:0;">Fix bullets, indentation, links &amp; whitespace in one click</p>
        </div>
      </div>

      <!-- Fix options toggles -->
      <div style="display:flex; flex-wrap:wrap; gap:0.4rem;" id="fix-toggles">
        <label class="fix-toggle active" data-key="bullets" style="display:flex; align-items:center; gap:0.35rem; padding:0.3rem 0.65rem; border-radius:999px; border:1.5px solid #059669; background:rgba(5,150,105,0.1); cursor:pointer; user-select:none; transition:all 0.15s;">
          <input type="checkbox" checked style="display:none;" />
          <span style="font-size:0.68rem; font-weight:700; color:#059669; letter-spacing:0.03em;">BULLETS</span>
        </label>
        <label class="fix-toggle active" data-key="indent" style="display:flex; align-items:center; gap:0.35rem; padding:0.3rem 0.65rem; border-radius:999px; border:1.5px solid #059669; background:rgba(5,150,105,0.1); cursor:pointer; user-select:none; transition:all 0.15s;">
          <input type="checkbox" checked style="display:none;" />
          <span style="font-size:0.68rem; font-weight:700; color:#059669; letter-spacing:0.03em;">INDENT</span>
        </label>
        <label class="fix-toggle active" data-key="links" style="display:flex; align-items:center; gap:0.35rem; padding:0.3rem 0.65rem; border-radius:999px; border:1.5px solid #059669; background:rgba(5,150,105,0.1); cursor:pointer; user-select:none; transition:all 0.15s;">
          <input type="checkbox" checked style="display:none;" />
          <span style="font-size:0.68rem; font-weight:700; color:#059669; letter-spacing:0.03em;">LINKS</span>
        </label>
        <label class="fix-toggle active" data-key="whitespace" style="display:flex; align-items:center; gap:0.35rem; padding:0.3rem 0.65rem; border-radius:999px; border:1.5px solid #059669; background:rgba(5,150,105,0.1); cursor:pointer; user-select:none; transition:all 0.15s;">
          <input type="checkbox" checked style="display:none;" />
          <span style="font-size:0.68rem; font-weight:700; color:#059669; letter-spacing:0.03em;">WHITESPACE</span>
        </label>
        <label class="fix-toggle active" data-key="headings" style="display:flex; align-items:center; gap:0.35rem; padding:0.3rem 0.65rem; border-radius:999px; border:1.5px solid #059669; background:rgba(5,150,105,0.1); cursor:pointer; user-select:none; transition:all 0.15s;">
          <input type="checkbox" checked style="display:none;" />
          <span style="font-size:0.68rem; font-weight:700; color:#059669; letter-spacing:0.03em;">HEADINGS</span>
        </label>
      </div>
    </div>

    <!-- ── Bullet style picker ── -->
    <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.1rem; flex-wrap:wrap;">
      <span style="font-size:0.76rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; flex-shrink:0;">Bullet style:</span>
      <div style="display:flex; gap:0.35rem;" id="bullet-style-group">
        <button class="bullet-opt selected-bullet" data-char="-" style="padding:0.28rem 0.7rem; border-radius:0.4rem; border:1.5px solid #059669; background:rgba(5,150,105,0.12); font-family:'Fira Code',monospace; font-size:0.82rem; font-weight:700; color:#059669; cursor:pointer; transition:all 0.15s;">-</button>
        <button class="bullet-opt" data-char="*" style="padding:0.28rem 0.7rem; border-radius:0.4rem; border:1.5px solid var(--border); background:var(--bg-surface-2); font-family:'Fira Code',monospace; font-size:0.82rem; font-weight:700; color:var(--text-secondary); cursor:pointer; transition:all 0.15s;">*</button>
        <button class="bullet-opt" data-char="+" style="padding:0.28rem 0.7rem; border-radius:0.4rem; border:1.5px solid var(--border); background:var(--bg-surface-2); font-family:'Fira Code',monospace; font-size:0.82rem; font-weight:700; color:var(--text-secondary); cursor:pointer; transition:all 0.15s;">+</button>
      </div>
      <span style="font-size:0.76rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; flex-shrink:0; margin-left:0.5rem;">Indent:</span>
      <div style="display:flex; gap:0.35rem;" id="indent-size-group">
        <button class="indent-opt selected-indent" data-size="2" style="padding:0.28rem 0.7rem; border-radius:0.4rem; border:1.5px solid #059669; background:rgba(5,150,105,0.12); font-family:'Fira Code',monospace; font-size:0.82rem; font-weight:700; color:#059669; cursor:pointer; transition:all 0.15s;">2sp</button>
        <button class="indent-opt" data-size="4" style="padding:0.28rem 0.7rem; border-radius:0.4rem; border:1.5px solid var(--border); background:var(--bg-surface-2); font-family:'Fira Code',monospace; font-size:0.82rem; font-weight:700; color:var(--text-secondary); cursor:pointer; transition:all 0.15s;">4sp</button>
        <button class="indent-opt" data-size="tab" style="padding:0.28rem 0.7rem; border-radius:0.4rem; border:1.5px solid var(--border); background:var(--bg-surface-2); font-family:'Fira Code',monospace; font-size:0.82rem; font-weight:700; color:var(--text-secondary); cursor:pointer; transition:all 0.15s;">tab</button>
      </div>
    </div>

    <!-- ── Split pane: Input | Output ── -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.875rem;" class="md-panes">

      <!-- Input -->
      <div style="display:flex; flex-direction:column;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <span style="font-size:0.7rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em;">Input</span>
          <div style="display:flex; gap:0.4rem; align-items:center;">
            <span id="in-line-count" style="font-size:0.68rem; color:var(--text-muted); font-family:'Fira Code',monospace;">0 lines</span>
            <button id="btn-paste-sample" style="font-size:0.68rem; color:#059669; background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;"
              onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">Load sample</button>
            <button id="btn-clear" style="font-size:0.68rem; color:var(--text-muted); background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;"
              onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">Clear</button>
          </div>
        </div>
        <div style="position:relative; flex:1;">
          <!-- Line numbers -->
          <div id="line-numbers" style="position:absolute; left:0; top:0; bottom:0; width:2.25rem; background:var(--bg-surface-3); border-radius:0.625rem 0 0 0.625rem; padding:0.75rem 0; overflow:hidden; display:flex; flex-direction:column; align-items:flex-end; padding-right:0.4rem; gap:0; z-index:1; border:1.5px solid var(--border); border-right:none;">
          </div>
          <textarea
            id="md-input"
            placeholder="Paste your messy markdown here…"
            style="width:100%; height:260px; box-sizing:border-box; resize:vertical; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem; padding:0.75rem 0.75rem 0.75rem 2.75rem; font-family:'Fira Code',monospace; font-size:0.78rem; color:var(--text-primary); line-height:1.65; outline:none; transition:border-color 0.15s; overflow-y:auto;"
            onfocus="this.style.borderColor='#059669'; this.style.boxShadow='0 0 0 3px rgba(5,150,105,0.12)';"
            onblur="this.style.borderColor='var(--border)'; this.style.boxShadow='none';"
          ></textarea>
        </div>
      </div>

      <!-- Output -->
      <div style="display:flex; flex-direction:column;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
          <span style="font-size:0.7rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em;">Output</span>
          <div style="display:flex; gap:0.4rem; align-items:center;">
            <span id="fix-count-badge" style="display:none; font-size:0.68rem; font-weight:700; color:#fff; background:#059669; padding:0.1rem 0.5rem; border-radius:999px; font-family:'Fira Code',monospace;"></span>
            <button id="btn-copy-output" style="font-size:0.68rem; color:var(--text-muted); background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;"
              onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">Copy</button>
            <button id="btn-use-output" style="font-size:0.68rem; color:#059669; background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;"
              onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">← Use as input</button>
          </div>
        </div>
        <textarea
          id="md-output"
          readonly
          placeholder="Cleaned markdown will appear here…"
          style="width:100%; height:260px; box-sizing:border-box; resize:vertical; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem; padding:0.75rem; font-family:'Fira Code',monospace; font-size:0.78rem; color:var(--text-primary); line-height:1.65; outline:none; cursor:default;"
        ></textarea>
      </div>
    </div>

    <!-- ── Sanitize button ── -->
    <button id="btn-sanitize"
      style="width:100%; padding:0.78rem 1.5rem; background:linear-gradient(135deg,#064E3B,#059669); color:#fff; border:none; border-radius:0.625rem; font-family:'Sora',sans-serif; font-size:0.92rem; font-weight:700; cursor:pointer; transition:opacity 0.15s, transform 0.1s; letter-spacing:0.02em; box-shadow:0 4px 14px rgba(5,150,105,0.35); display:flex; align-items:center; justify-content:center; gap:0.6rem; margin-bottom:1rem;"
      onmouseover="this.style.opacity='0.9';"
      onmouseout="this.style.opacity='1';"
      onmousedown="this.style.transform='scale(0.985)';"
      onmouseup="this.style.transform='scale(1)';"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      Sanitize &amp; Format
    </button>

    <!-- ── Change log panel ── -->
    <div id="change-log" style="display:none; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; overflow:hidden;">
      <div style="display:flex; align-items:center; justify-content:space-between; padding:0.625rem 0.875rem; border-bottom:1px solid var(--border);">
        <span style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-secondary);">
          Changes applied
        </span>
        <span id="change-log-count" style="font-size:0.7rem; font-family:'Fira Code',monospace; color:var(--text-muted);"></span>
      </div>
      <div id="change-log-items" style="padding:0.625rem 0.75rem; display:flex; flex-direction:column; gap:0.3rem; max-height:180px; overflow-y:auto;">
      </div>
      <div id="no-changes-msg" style="display:none; padding:0.875rem; text-align:center; font-size:0.82rem; color:var(--text-muted);">
        ✨ Already clean — no changes needed!
      </div>
    </div>

  </div>

  <!-- ══════════════════════════════════════════════
       HOW TO USE
  ══════════════════════════════════════════════ -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to use the Markdown Sanitizer</h2>
    <p class="seo-p">
      Paste your AI-generated markdown into the input field -- the one with line numbers on the left. Click Sanitize and Format. The tool runs a pipeline of five fixers: heading normalization, bullet standardization, indentation repair, link URL encoding, and whitespace cleanup. A change log appears below showing every modification with line numbers so you can verify what changed.
    </p>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">AI output cleanup</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">ChatGPT and Claude often produce markdown with mixed heading styles (## Heading vs ##Heading), inconsistent bullet characters (- mixed with * and +), and irregular blank lines. Sanitize to produce publication-ready content in one click. A typical 50-line AI output gets 8-15 fixes applied.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Documentation standardization</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">When consolidating documentation from multiple contributors, each person uses different formatting habits. One person uses 4-space indentation, another uses tabs, a third uses 2 spaces. The sanitizer normalizes all indentation to your chosen style (2 spaces, 4 spaces, or tabs) while preserving nested list structure.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">CMS and Git preparation</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Before committing markdown to a Git repository or importing into a CMS like Hugo, Jekyll, or GitBook, run it through the sanitizer. It fixes broken link syntax (URLs with spaces), wraps bare URLs in angle brackets, and ensures code blocks have proper closing fences -- issues that cause rendering failures in static site generators.</p>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       HOW IT WORKS
  ══════════════════════════════════════════════ -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Sanitization pipeline</h2>
    <p class="seo-p">
      The tool first extracts and protects all code blocks (both fenced and inline) by replacing them with placeholder tokens. This prevents the fixers from modifying content inside code. After all fixers run, the original code blocks are restored unchanged. Each fixer operates on a line-by-line basis and logs every change it makes.
    </p>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;">
      <div>
        <h3 class="font-display seo-h3-sm">Heading normalization</h3>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0; color:var(--text-secondary);">Fixes three common heading issues: adds a space after hashes when missing (##Heading becomes ## Heading), ensures blank lines before and after headings for proper rendering, and prevents skipped heading levels. The tool logs each fix with the exact line number so you can verify the change.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Bullet and indentation repair</h3>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0; color:var(--text-secondary);">Standardizes all bullet characters to your chosen style (-, *, or +). Detects nested list items by their leading whitespace, calculates their nesting depth, and re-indents them using your selected indent unit (2 spaces, 4 spaces, or tab). A line with 6 leading spaces and a * bullet at depth 3 gets converted to 6 spaces with your chosen bullet character.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Link URL encoding</h3>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0; color:var(--text-secondary);">Scans for markdown links containing spaces in the URL portion ([text](url with spaces)) and replaces spaces with %20. Also detects bare URLs not wrapped in markdown link syntax or angle brackets and wraps them in angle brackets to prevent rendering issues.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Whitespace cleanup</h3>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0; color:var(--text-secondary);">Strips trailing whitespace from every line except intentional double-space line breaks (Markdown convention for hard line breaks). Collapses runs of more than two blank lines down to two. The tool preserves intentional formatting while removing the invisible characters that cause diffs to look messy in version control.</p>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════════ -->
  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently asked questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: 'Will sanitization change my content meaning?',
          a: 'No. The tool modifies only formatting elements: whitespace, heading markers, bullet characters, and link URL encoding. Text content, link destinations, and data are preserved exactly. Code blocks are extracted before processing and restored unchanged afterward, so code samples are never altered.'
        },
        {
          q: 'Does it handle all markdown flavors?',
          a: 'It handles CommonMark, GitHub-Flavored Markdown, and most extensions used in documentation. The bullet fixer works with -, *, and + characters. Nested lists up to 6 levels deep are supported. Edge cases like deeply nested fenced code blocks or complex HTML blocks may require manual review.'
        },
        {
          q: 'Can I customize the sanitization rules?',
          a: 'Yes. Each of the five fixers (bullets, indent, links, whitespace, headings) can be toggled on or off using the toggle buttons above the input. You can also choose between dash, asterisk, or plus bullets, and between 2-space, 4-space, or tab indentation. The tool remembers your selections during the session.'
        },
        {
          q: 'How does this differ from a markdown linter like markdownlint?',
          a: 'A linter reports issues in a log; this tool fixes them automatically. Markdownlint checks 50+ style rules (line length, no bare URLs, consistent heading style). This sanitizer focuses on the five most common formatting problems and applies fixes without requiring configuration files. Use it for quick cleanup, then run your linter for style compliance.'
        },
        {
          q: 'What is the change log panel?',
          a: 'After sanitization, a change log appears showing every modification with its line number and category (BULLET, INDENT, LINK, SPACE, HEADING). A typical 100-line markdown file gets 15-25 fixes. You can review each change to verify the tool did what you expected, and use the "Use as input" button to iterate if needed.'
        },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <p itemprop="text" class="seo-faq-a">{item.a}</p>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<style>
  /* Responsive: stack panes on mobile */
  @media (max-width: 680px) {
    .md-panes {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<!-- ══════════════════════════════════════════════════════════
     CLIENT-SIDE LOGIC
══════════════════════════════════════════════════════════ -->
<script>
  // ── Sample messy markdown ─────────────────────────────────
  const SAMPLE = `#Introduction

This is a sample document with various issues.

*  First item with asterisk bullet
+ Second item with plus bullet
-  Third item (double space after dash)
  *   Nested item — wrong indent
      +  Deep nested — inconsistent

##Getting Started

Follow these steps:
1. Install the package
2.  Run the setup script (extra space)
3. Configure your settings

Some broken links:
- Visit https://example.com for more info
- Check the [docs](https://docs.example.com/page with spaces/guide)
- See also [reference link][ref] without definition

###Code and formatting

Here is \`inline code\` that should be untouched.

\`\`\`
function hello() {
  // This block should NOT be modified
  - fake bullet inside code
}
\`\`\`



Three blank lines above (should become two).

Trailing spaces on this line.   
And on this one.  `;

  // ── DOM refs ──────────────────────────────────────────────
  const mdInput       = document.getElementById('md-input')       as HTMLTextAreaElement;
  const mdOutput      = document.getElementById('md-output')      as HTMLTextAreaElement;
  const btnSanitize   = document.getElementById('btn-sanitize')!;
  const btnCopyOutput = document.getElementById('btn-copy-output')!;
  const btnUseOutput  = document.getElementById('btn-use-output')!;
  const btnPasteSample= document.getElementById('btn-paste-sample')!;
  const btnClear      = document.getElementById('btn-clear')!;
  const inLineCount   = document.getElementById('in-line-count')!;
  const fixCountBadge = document.getElementById('fix-count-badge')!;
  const changeLog     = document.getElementById('change-log')!;
  const changeLogItems= document.getElementById('change-log-items')!;
  const changeLogCount= document.getElementById('change-log-count')!;
  const noChangesMsg  = document.getElementById('no-changes-msg')!;
  const lineNumbersEl = document.getElementById('line-numbers')!;

  // ── State ─────────────────────────────────────────────────
  let bulletChar  = '-';
  let indentUnit  = '  '; // 2 spaces default

  // ── Fix toggle state ──────────────────────────────────────
  const fixEnabled: Record<string, boolean> = {
    bullets: true, indent: true, links: true, whitespace: true, headings: true
  };

  document.querySelectorAll<HTMLLabelElement>('.fix-toggle').forEach(lbl => {
    lbl.addEventListener('click', (e) => {
      e.preventDefault();
      const key = lbl.dataset.key!;
      const chk = lbl.querySelector('input') as HTMLInputElement;
      fixEnabled[key] = !fixEnabled[key];
      chk.checked = fixEnabled[key];
      const span = lbl.querySelector('span')!;
      if (fixEnabled[key]) {
        lbl.style.borderColor = '#059669';
        lbl.style.background  = 'rgba(5,150,105,0.1)';
        span.style.color      = '#059669';
        lbl.classList.add('active');
      } else {
        lbl.style.borderColor = 'var(--border)';
        lbl.style.background  = 'var(--bg-surface-2)';
        span.style.color      = 'var(--text-muted)';
        lbl.classList.remove('active');
      }
    });
  });

  // ── Bullet style picker ───────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.bullet-opt').forEach(btn => {
    btn.addEventListener('click', () => {
      bulletChar = btn.dataset.char!;
      document.querySelectorAll<HTMLButtonElement>('.bullet-opt').forEach(b => {
        const active = b === btn;
        b.style.borderColor = active ? '#059669' : 'var(--border)';
        b.style.background  = active ? 'rgba(5,150,105,0.12)' : 'var(--bg-surface-2)';
        b.style.color       = active ? '#059669' : 'var(--text-secondary)';
      });
    });
  });

  // ── Indent size picker ────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.indent-opt').forEach(btn => {
    btn.addEventListener('click', () => {
      const size = btn.dataset.size!;
      indentUnit = size === 'tab' ? '\t' : ' '.repeat(parseInt(size));
      document.querySelectorAll<HTMLButtonElement>('.indent-opt').forEach(b => {
        const active = b === btn;
        b.style.borderColor = active ? '#059669' : 'var(--border)';
        b.style.background  = active ? 'rgba(5,150,105,0.12)' : 'var(--bg-surface-2)';
        b.style.color       = active ? '#059669' : 'var(--text-secondary)';
      });
    });
  });

  // ── Line numbers ──────────────────────────────────────────
  function updateLineNumbers() {
    const lines = mdInput.value.split('\n');
    inLineCount.textContent = `${lines.length} line${lines.length !== 1 ? 's' : ''}`;
    lineNumbersEl.innerHTML = lines.map((_, i) =>
      `<span style="font-family:'Fira Code',monospace; font-size:0.65rem; color:var(--text-muted); line-height:1.65; display:block; height:1.65em;">${i + 1}</span>`
    ).join('');
    // Sync scroll
    lineNumbersEl.scrollTop = mdInput.scrollTop;
  }

  mdInput.addEventListener('input', updateLineNumbers);
  mdInput.addEventListener('scroll', () => {
    lineNumbersEl.scrollTop = mdInput.scrollTop;
  });

  // ── Change log entry type ─────────────────────────────────
  type ChangeEntry = { type: 'bullets' | 'indent' | 'links' | 'whitespace' | 'headings'; line: number; desc: string };
  const TYPE_COLORS: Record<string, string> = {
    bullets:    '#059669',
    indent:     '#1D4ED8',
    links:      '#7C3AED',
    whitespace: '#D97706',
    headings:   '#EA580C',
  };
  const TYPE_LABELS: Record<string, string> = {
    bullets:    'BULLET',
    indent:     'INDENT',
    links:      'LINK',
    whitespace: 'SPACE',
    headings:   'HEADING',
  };

  // ── Extract & protect code blocks ─────────────────────────
  function protectCodeBlocks(text: string): { text: string; blocks: string[] } {
    const blocks: string[] = [];
    const protected_ = text.replace(/(`{3,}|~{3,})[^\n]*\n[\s\S]*?\1/g, (match) => {
      const idx = blocks.length;
      blocks.push(match);
      return `\x00CODE_BLOCK_${idx}\x00`;
    });
    // Also protect inline code
    const final = protected_.replace(/`[^`\n]+`/g, (match) => {
      const idx = blocks.length;
      blocks.push(match);
      return `\x00INLINE_${idx}\x00`;
    });
    return { text: final, blocks };
  }

  function restoreCodeBlocks(text: string, blocks: string[]): string {
    return text
      .replace(/\x00CODE_BLOCK_(\d+)\x00/g, (_, i) => blocks[parseInt(i)])
      .replace(/\x00INLINE_(\d+)\x00/g,      (_, i) => blocks[parseInt(i)]);
  }

  // ── Individual fixers ─────────────────────────────────────

  /** Detect indent level from leading whitespace (returns nesting depth 0,1,2…) */
  function detectIndentDepth(spaces: string): number {
    if (!spaces) return 0;
    const len = spaces.replace(/\t/g, '  ').length;
    return Math.round(len / 2);
  }

  function fixBullets(lines: string[], changes: ChangeEntry[]): string[] {
    return lines.map((line, i) => {
      const m = line.match(/^(\s*)([-*+])(\s+)(.*)$/);
      if (!m) return line;
      const [, indent, marker, , content] = m;
      if (marker === bulletChar) return line;
      changes.push({ type: 'bullets', line: i + 1, desc: `Line ${i+1}: "${marker}" → "${bulletChar}"` });
      return `${indent}${bulletChar} ${content}`;
    });
  }

  function fixIndent(lines: string[], changes: ChangeEntry[]): string[] {
    return lines.map((line, i) => {
      const m = line.match(/^(\s+)([-*+]|\d+\.)(\s.*)$/);
      if (!m) return line;
      const [, rawIndent, marker, rest] = m;
      const depth = detectIndentDepth(rawIndent);
      const newIndent = indentUnit.repeat(depth);
      if (newIndent === rawIndent) return line;
      changes.push({ type: 'indent', line: i + 1, desc: `Line ${i+1}: normalised indent to depth ${depth}` });
      return `${newIndent}${marker}${rest}`;
    });
  }

  function fixLinks(lines: string[], changes: ChangeEntry[]): string[] {
    return lines.map((line, i) => {
      let fixed = line;

      // Fix [text](url with spaces) — replace spaces inside URL portion with %20
      fixed = fixed.replace(/\[([^\]]+)\]\(([^)]*\s[^)]*)\)/g, (match, text, url) => {
        const fixedUrl = url.replace(/\s+/g, '%20');
        changes.push({ type: 'links', line: i + 1, desc: `Line ${i+1}: encoded spaces in link URL` });
        return `[${text}](${fixedUrl})`;
      });

      // Fix bare URLs (not already in angle brackets or inside a markdown link)
      fixed = fixed.replace(/(?<![(<\["])https?:\/\/[^\s)\]>"]+/g, (url, offset, str) => {
        // Skip if already inside a markdown link context
        const before = str.slice(Math.max(0, offset - 2), offset);
        if (before.endsWith('](') || before.endsWith('<')) return url;
        changes.push({ type: 'links', line: i + 1, desc: `Line ${i+1}: wrapped bare URL in angle brackets` });
        return `<${url}>`;
      });

      return fixed;
    });
  }

  function fixWhitespace(lines: string[], changes: ChangeEntry[]): string[] {
    const result: string[] = [];
    let blankRun = 0;

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];

      // Strip trailing whitespace (but preserve intentional double-space line break → \n)
      const trailingSpaces = line.match(/( {2,})$/);
      const strippedTrail  = line.replace(/\s+$/, '');
      const hasIntentionalBreak = trailingSpaces && trailingSpaces[1].length === 2;

      if (!hasIntentionalBreak && strippedTrail !== line) {
        changes.push({ type: 'whitespace', line: i + 1, desc: `Line ${i+1}: removed trailing whitespace` });
      }
      const processedLine = hasIntentionalBreak ? line.replace(/\s+$/, '  ') : strippedTrail;

      // Collapse excessive blank lines
      if (processedLine === '') {
        blankRun++;
        if (blankRun <= 2) result.push(processedLine);
        else changes.push({ type: 'whitespace', line: i + 1, desc: `Line ${i+1}: collapsed extra blank line` });
      } else {
        blankRun = 0;
        result.push(processedLine);
      }
    }
    return result;
  }

  function fixHeadings(lines: string[], changes: ChangeEntry[]): string[] {
    const result: string[] = [];
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];

      // Fix ##Heading → ## Heading (missing space after hashes)
      const missingSpace = line.match(/^(#{1,6})([^#\s].+)$/);
      if (missingSpace) {
        changes.push({ type: 'headings', line: i + 1, desc: `Line ${i+1}: added space after heading marker` });
        result.push(`${missingSpace[1]} ${missingSpace[2]}`);
        continue;
      }

      const isHeading = /^#{1,6}\s/.test(line);

      // Ensure blank line before heading (unless first non-blank line)
      if (isHeading && result.length > 0) {
        const prev = result[result.length - 1];
        if (prev !== '') {
          changes.push({ type: 'headings', line: i + 1, desc: `Line ${i+1}: added blank line before heading` });
          result.push('');
        }
      }

      result.push(line);

      // Ensure blank line after heading
      if (isHeading) {
        const next = lines[i + 1];
        if (next !== undefined && next !== '') {
          changes.push({ type: 'headings', line: i + 1, desc: `Line ${i+1}: added blank line after heading` });
          result.push('');
        }
      }
    }
    return result;
  }

  // ── Main sanitize pipeline ────────────────────────────────
  function sanitize(raw: string): { output: string; changes: ChangeEntry[] } {
    const changes: ChangeEntry[] = [];

    // Protect code blocks from transformation
    const { text: protected_, blocks } = protectCodeBlocks(raw);
    let lines = protected_.split('\n');

    if (fixEnabled.headings)    lines = fixHeadings(lines, changes);
    if (fixEnabled.bullets)     lines = fixBullets(lines, changes);
    if (fixEnabled.indent)      lines = fixIndent(lines, changes);
    if (fixEnabled.links)       lines = fixLinks(lines, changes);
    if (fixEnabled.whitespace)  lines = fixWhitespace(lines, changes);

    // Restore code blocks
    const output = restoreCodeBlocks(lines.join('\n'), blocks);

    // Remove trailing newline
    return { output: output.replace(/\n+$/, ''), changes };
  }

  // ── Render change log ─────────────────────────────────────
  function renderChangeLog(changes: ChangeEntry[]) {
    changeLog.style.display = 'block';
    changeLogItems.innerHTML = '';

    if (changes.length === 0) {
      noChangesMsg.style.display = 'block';
      changeLogItems.style.display = 'none';
      changeLogCount.textContent = '0 fixes';
      fixCountBadge.style.display = 'none';
      return;
    }

    noChangesMsg.style.display = 'none';
    changeLogItems.style.display = 'flex';
    changeLogCount.textContent = `${changes.length} fix${changes.length !== 1 ? 'es' : ''}`;
    fixCountBadge.textContent  = `${changes.length} fix${changes.length !== 1 ? 'es' : ''}`;
    fixCountBadge.style.display = 'inline';

    changes.forEach((ch, idx) => {
      const color = TYPE_COLORS[ch.type];
      const label = TYPE_LABELS[ch.type];
      const div = document.createElement('div');
      div.style.cssText = `
        display:flex; align-items:baseline; gap:0.5rem;
        font-size:0.73rem; line-height:1.5;
        opacity:0; transform:translateX(-6px);
        transition:opacity 0.18s ease, transform 0.18s ease;
        transition-delay:${Math.min(idx * 25, 400)}ms;
      `;
      div.innerHTML = `
        <span style="font-family:'Fira Code',monospace; font-size:0.65rem; font-weight:700; color:${color}; background:${color}1a; padding:0.05rem 0.4rem; border-radius:0.25rem; flex-shrink:0; letter-spacing:0.04em;">${label}</span>
        <span style="color:var(--text-secondary);">${escapeHtml(ch.desc)}</span>
      `;
      changeLogItems.appendChild(div);
      requestAnimationFrame(() => requestAnimationFrame(() => {
        div.style.opacity = '1';
        div.style.transform = 'translateX(0)';
      }));
    });
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── Event wiring ──────────────────────────────────────────
  btnSanitize.addEventListener('click', () => {
    const raw = mdInput.value;
    if (!raw.trim()) return;
    const { output, changes } = sanitize(raw);
    mdOutput.value = output;
    renderChangeLog(changes);
  });

  btnCopyOutput.addEventListener('click', () => {
    const text = mdOutput.value;
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      btnCopyOutput.textContent = '✓ Copied!';
      setTimeout(() => { btnCopyOutput.textContent = 'Copy'; }, 2000);
    });
  });

  btnUseOutput.addEventListener('click', () => {
    if (!mdOutput.value) return;
    mdInput.value = mdOutput.value;
    mdOutput.value = '';
    changeLog.style.display = 'none';
    fixCountBadge.style.display = 'none';
    updateLineNumbers();
    mdInput.focus();
  });

  btnPasteSample.addEventListener('click', () => {
    mdInput.value = SAMPLE;
    updateLineNumbers();
    mdOutput.value = '';
    changeLog.style.display = 'none';
    fixCountBadge.style.display = 'none';
  });

  btnClear.addEventListener('click', () => {
    mdInput.value = '';
    mdOutput.value = '';
    changeLog.style.display = 'none';
    fixCountBadge.style.display = 'none';
    updateLineNumbers();
  });

  // Initial line numbers
  updateLineNumbers();
</script>
