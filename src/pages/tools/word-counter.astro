---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'word-counter')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.875rem; flex-wrap:wrap; gap:0.5rem;">
      <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin:0;">
        Word Counter
      </h2>
      <div style="display:flex; gap:0.5rem;">
        <button id="btn-copy" class="btn-secondary" type="button" style="font-size:0.8rem; padding:0.35rem 0.75rem;">
          Copy text
        </button>
        <button id="btn-clear" class="btn-secondary" type="button" style="font-size:0.8rem; padding:0.35rem 0.75rem;">
          Clear
        </button>
      </div>
    </div>

    <!-- Textarea -->
    <textarea
      id="wc-input"
      placeholder="Paste or type your text here…"
      class="input-themed"
      style="width:100%; min-height:180px; padding:0.875rem 1rem; border-radius:0.625rem; font-size:0.9rem; line-height:1.7; resize:vertical; box-sizing:border-box; font-family:'Inter',sans-serif;"
    ></textarea>

    <!-- Stats grid — .result-card based -->
    <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:0.625rem; margin-top:1rem;">

      <div class="result-card accent-blue" style="text-align:center; padding:0.875rem;">
        <div class="result-value" id="stat-words" style="font-size:1.75rem;">0</div>
        <div class="result-label">Words</div>
      </div>

      <div class="result-card" style="text-align:center; padding:0.875rem;">
        <div class="result-value" id="stat-chars" style="font-size:1.75rem; color:var(--text-primary);">0</div>
        <div class="result-label">Characters</div>
      </div>

      <div class="result-card" style="text-align:center; padding:0.875rem;">
        <div class="result-value" id="stat-nospace" style="font-size:1.75rem; color:var(--text-primary);">0</div>
        <div class="result-label">Chars (no spaces)</div>
      </div>

      <div class="result-card" style="text-align:center; padding:0.875rem;">
        <div class="result-value" id="stat-sentences" style="font-size:1.75rem; color:var(--text-primary);">0</div>
        <div class="result-label">Sentences</div>
      </div>

      <div class="result-card" style="text-align:center; padding:0.875rem;">
        <div class="result-value" id="stat-paragraphs" style="font-size:1.75rem; color:var(--text-primary);">0</div>
        <div class="result-label">Paragraphs</div>
      </div>

      <div class="result-card" style="text-align:center; padding:0.875rem;">
        <div class="result-value" id="stat-reading" style="font-size:1.75rem; color:var(--text-primary);">0 min</div>
        <div class="result-label">Reading time</div>
      </div>
    </div>

    <!-- Platform limits bar -->
    <div style="margin-top:1rem;">
      <div style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--text-muted); margin-bottom:0.5rem;">Platform limits</div>
      <div style="display:flex; flex-direction:column; gap:0.375rem;">
        {[
          { label: 'Twitter / X',   max: 280,   id: 'lim-twitter' },
          { label: 'LinkedIn post', max: 3000,  id: 'lim-linkedin' },
          { label: 'SMS',           max: 160,   id: 'lim-sms' },
          { label: 'Meta title',    max: 60,    id: 'lim-meta' },
        ].map(p => (
          <div style="display:flex; align-items:center; gap:0.625rem;">
            <span style="font-size:0.72rem; font-weight:600; color:var(--text-secondary); min-width:6.5rem;">{p.label}</span>
            <div style="flex:1; height:6px; background:var(--bg-surface-3); border-radius:999px; overflow:hidden;">
              <div id={p.id + '-bar'} style="height:100%; width:0%; border-radius:999px; transition:width 0.25s, background 0.25s;"></div>
            </div>
            <span id={p.id + '-lbl'} style="font-size:0.72rem; font-family:'Fira Code',monospace; color:var(--text-muted); min-width:4.5rem; text-align:right;">0 / {p.max}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- HOW TO USE ───────────────────────────────── -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >Paste your text — get six counts instantly</h2>
    <p class="seo-p" >
      Your blog post needs to stay under 1,500 words but you're not sure how close you are. Your tweet is longer than 280 characters and you need to trim it. Your client brief says "300 words max" and you've written four paragraphs without counting. Paste your text into the box and all six numbers update as you type — words, characters, characters without spaces, sentences, paragraphs, and reading time. No submit button, no page reload, just instant feedback.
    </p>
    <p class="seo-p" >
      Below the stats grid, four colour-coded progress bars show how your text length compares against common platform limits: Twitter/X (280 characters), LinkedIn (3,000), SMS (160), and meta title (60). Green means you're within budget, amber means you're approaching the limit (85%+), red means you've gone over. Use the <strong>Copy text</strong> button to grab the content, or <strong>Clear</strong> to start fresh.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Who uses this word counter</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Blog writers checking SEO length', 'Google tends to favour content between 1,000 and 2,500 words for competitive keywords, but writing too much wastes time and too little risks thin content. Paste your draft and the word count tells you instantly whether you\'re in the target range. The reading time estimate — based on 200 words per minute — helps you gauge whether a reader will finish your piece in a single sitting.'],
        ['Social media managers hitting character limits', 'A tweet over 280 characters gets truncated. An SMS over 160 characters splits into two segments, doubling your cost. A LinkedIn post over 3,000 characters gets cut off in the feed. The progress bars show exactly how much room you have left before you need to start trimming.'],
        ['Students meeting assignment word counts', 'Essay instructions say "500–750 words" and you\'re at 920. The no-spaces character count helps when a submission form counts characters instead of words. The sentence and paragraph counts give you structural insight — if your essay has too few paragraphs for its length, it probably needs better organisation.'],
        ['UX writers checking microcopy length', 'Button labels, error messages, and tooltip text all have tight space constraints. The no-spaces character count reflects how most design tools display remaining length, making it easy to check whether your copy fits before you hand it to a developer.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/slug-generator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Slug Generator</a>
        <a href="/tools/whitespace-trimmer" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Whitespace & Line Break Trimmer</a>
      </div>
    </div>
</div>

  <!-- HOW IT WORKS ────────────────────────────── -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >How the word counter works — six metrics from one text box</h2>

    <h3 class="font-display seo-h3-sm" >What happens when you type</h3>
    <p class="seo-p" >
      Every time you type, paste, or delete text, the counter runs six separate calculations on your input. No data leaves your device — the entire process happens locally in your browser. The results update in real time with no lag, even on older phones or laptops. All text stays in memory only and is permanently gone when you close the tab or click Clear.
    </p>

    <h3 class="font-display seo-h3-sm" >Word count</h3>
    <p class="seo-p" >
      Your text is split wherever whitespace appears — spaces, tabs, newlines, or combinations of them. Empty entries are discarded, so multiple spaces between words don't inflate the count. A hyphenated word like "well-known" counts as one word, because the split only happens on whitespace, not hyphens. A 1,200-word blog post might show 1,198 if it has two blank lines at the end — but the count excludes those blank lines because they contain no actual words.
    </p>

    <h3 class="font-display seo-h3-sm" >Character counts (total and no-spaces)</h3>
    <p class="seo-p" >
      The total character count includes every character you type — letters, numbers, punctuation, spaces, tabs, and line breaks. The no-spaces count strips all whitespace before measuring. These two numbers matter for different platforms: Twitter/X counts all characters including spaces in its 280-character limit, while some design tools and SMS systems count only visible characters. Having both numbers side by side removes the guesswork.
    </p>

    <h3 class="font-display seo-h3-sm" >Sentence and paragraph counts</h3>
    <p class="seo-p" >
      Sentences are counted by splitting on periods, exclamation marks, and question marks. Consecutive punctuation (like "?!") counts as a single separator, so "Really?!" is one sentence, not two. Paragraphs are detected by looking for two or more consecutive blank lines — a single line break within a paragraph doesn't create a new one. An abbreviation like "Dr." can cause the counter to split prematurely, which is a known limitation of regex-based detection without full natural language processing.
    </p>

    <h3 class="font-display seo-h3-sm" >Reading time and platform limits</h3>
    <p class="seo-p" >
      Reading time is your word count divided by 200 — a conservative baseline for silent reading of general English text. A 600-word article shows 3 minutes, a 1,500-word post shows 8 minutes. The platform limits section compares your total character count (no spaces) against four common thresholds: Twitter/X (280), LinkedIn (3,000), SMS (160), and meta title (60). Each bar fills proportionally and changes colour at 85% capacity (amber) and when exceeded (red). A 55-character meta title shows the bar at 92% in amber — you're close to the limit and may want to trim.
    </p>
  </div>

  <!-- FAQ ─────────────────────────────────────── -->
  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "Does this word counter count hyphenated words as one or two?",
          a: "Hyphenated words like \"well-known\" or \"state-of-the-art\" count as one word, because the counter splits on whitespace only — hyphens are treated as part of the word. This matches how Microsoft Word and Google Docs count words. If you need each component counted separately, replace hyphens with spaces before pasting your text."
        },
        {
          q: "How is reading time calculated?",
          a: "The estimate uses 200 words per minute — a conservative average for silent reading of general English text. A 1,200-word article shows 6 minutes, a 500-word blog post shows 3 minutes. Academic or technical content is typically read slower (100–150 wpm), while skimming can reach 300+ wpm. The result always rounds up so you never underestimate the time commitment."
        },
        {
          q: "Does the character count include spaces?",
          a: "Yes — the main \"Characters\" count includes every character: letters, numbers, punctuation, spaces, tabs, and line breaks. The \"Chars (no spaces)\" count strips all whitespace before measuring. Twitter/X and most SMS systems count all characters including spaces, while some design tools count only visible characters. Having both numbers eliminates the guesswork."
        },
        {
          q: "How do I check my text against SEO title length limits?",
          a: "Use the \"Meta title\" progress bar. Google typically displays the first 50–60 characters of a page title in search results and truncates beyond that. The bar turns amber at 51 characters (85% of 60) and red when you exceed 60. For the best click-through rate, keep your title under 60 characters with the primary keyword near the start."
        },
        {
          q: "Why does the sentence count sometimes seem wrong?",
          a: "The counter splits on periods, exclamation marks, and question marks. Abbreviations like \"Dr.\" or \"U.S.A.\" can cause over-splitting, reporting more sentences than a human would count. Multiple punctuation like \"Wow!!!\" counts as one sentence because consecutive separators are treated as one delimiter. For precise sentence-level analysis, manual review is still necessary."
        },
        {
          q: "Is my text stored or sent anywhere?",
          a: "No. All counting happens locally in your browser. Your text never leaves your device — there are no server requests, no analytics tracking your input, and no cookies or local storage used to persist it. When you close the tab or click Clear, the text is permanently gone. This makes the tool suitable for confidential documents, legal contracts, or sensitive material."
        },
        {
          q: "What happens if I paste a massive document?",
          a: "The counter handles inputs up to roughly 500,000 characters without noticeable delay. For reference, a typical novel is about 500,000–600,000 characters. If you paste something extremely large — multiple full-length books — you might notice a brief pause as the calculations run, but the results will still be accurate. Very large pastes beyond a million characters may cause the browser to slow down."
        },
        {
          q: "Why are there two different character counts?",
          a: "Different platforms count characters differently. Twitter/X counts every character including spaces in its 280 limit. SMS systems sometimes count only visible characters. Most design tools and HTML attribute counters count characters without spaces. Showing both numbers means you can check against any platform's rules without having to manually strip spaces yourself."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  const input = document.getElementById('wc-input') as HTMLTextAreaElement;

  const LIMITS = [
    { id: 'lim-twitter',  max: 280 },
    { id: 'lim-linkedin', max: 3000 },
    { id: 'lim-sms',      max: 160 },
    { id: 'lim-meta',     max: 60 },
  ];

  function update() {
    const text  = input.value;
    const words = text.trim() === '' ? 0 : text.trim().split(/\s+/).filter(Boolean).length;
    const chars      = text.length;
    const nospace    = text.replace(/\s/g, '').length;
    const sentences  = text === '' ? 0 : text.split(/[.!?]+/).filter(s => s.trim().length > 0).length;
    const paragraphs = text === '' ? 0 : text.split(/\n{2,}/).filter(p => p.trim().length > 0).length;
    const readMins   = Math.ceil(words / 200);

    (document.getElementById('stat-words')!)     .textContent = words.toLocaleString();
    (document.getElementById('stat-chars')!)     .textContent = chars.toLocaleString();
    (document.getElementById('stat-nospace')!)   .textContent = nospace.toLocaleString();
    (document.getElementById('stat-sentences')!) .textContent = sentences.toLocaleString();
    (document.getElementById('stat-paragraphs')!).textContent = paragraphs.toLocaleString();
    (document.getElementById('stat-reading')!)   .textContent = readMins + ' min';

    // Platform limit bars
    LIMITS.forEach(({ id, max }) => {
      const bar  = document.getElementById(id + '-bar')!;
      const lbl  = document.getElementById(id + '-lbl')!;
      const pct  = Math.min((chars / max) * 100, 100);
      const over = chars > max;
      bar.style.width = pct + '%';
      // Use CSS-var-compatible colours for the bar fill (these are SVG/canvas-equivalent data)
      bar.style.background = over ? '#EF4444' : pct >= 85 ? '#F59E0B' : '#10B981';
      lbl.textContent = `${chars.toLocaleString()} / ${max}`;
      lbl.style.color = over ? '#EF4444' : 'var(--text-muted)';
    });
  }

  input.addEventListener('input', update);
  update();

  // Copy text
  document.getElementById('btn-copy')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy')!;
    navigator.clipboard.writeText(input.value).then(() => {
      btn.textContent = '✓ Copied!';
      btn.classList.add('btn-success');
      setTimeout(() => {
        btn.textContent = 'Copy text';
        btn.classList.remove('btn-success');
      }, 2000);
    });
  });

  // Clear
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    input.value = '';
    update();
  });
</script>
