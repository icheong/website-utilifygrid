---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'word-counter')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.875rem; flex-wrap:wrap; gap:0.5rem;">
      <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin:0;">
        Word Counter
      </h2>
      <div style="display:flex; gap:0.5rem;">
        <button id="btn-copy" class="btn-secondary" type="button" style="font-size:0.8rem; padding:0.35rem 0.75rem;">
          Copy text
        </button>
        <button id="btn-clear" class="btn-secondary" type="button" style="font-size:0.8rem; padding:0.35rem 0.75rem;">
          Clear
        </button>
      </div>
    </div>

    <!-- Textarea -->
    <textarea
      id="wc-input"
      placeholder="Paste or type your text here…"
      class="input-themed"
      style="width:100%; min-height:180px; padding:0.875rem 1rem; border-radius:0.625rem; font-size:0.9rem; line-height:1.7; resize:vertical; box-sizing:border-box; font-family:'Inter',sans-serif;"
    ></textarea>

    <!-- Stats grid — .result-card based -->
    <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:0.625rem; margin-top:1rem;">

      <div class="result-card accent-blue" style="text-align:center; padding:0.875rem;">
        <div class="result-value" id="stat-words" style="font-size:1.75rem;">0</div>
        <div class="result-label">Words</div>
      </div>

      <div class="result-card" style="text-align:center; padding:0.875rem;">
        <div class="result-value" id="stat-chars" style="font-size:1.75rem; color:var(--text-primary);">0</div>
        <div class="result-label">Characters</div>
      </div>

      <div class="result-card" style="text-align:center; padding:0.875rem;">
        <div class="result-value" id="stat-nospace" style="font-size:1.75rem; color:var(--text-primary);">0</div>
        <div class="result-label">Chars (no spaces)</div>
      </div>

      <div class="result-card" style="text-align:center; padding:0.875rem;">
        <div class="result-value" id="stat-sentences" style="font-size:1.75rem; color:var(--text-primary);">0</div>
        <div class="result-label">Sentences</div>
      </div>

      <div class="result-card" style="text-align:center; padding:0.875rem;">
        <div class="result-value" id="stat-paragraphs" style="font-size:1.75rem; color:var(--text-primary);">0</div>
        <div class="result-label">Paragraphs</div>
      </div>

      <div class="result-card" style="text-align:center; padding:0.875rem;">
        <div class="result-value" id="stat-reading" style="font-size:1.75rem; color:var(--text-primary);">0 min</div>
        <div class="result-label">Reading time</div>
      </div>
    </div>

    <!-- Platform limits bar -->
    <div style="margin-top:1rem;">
      <div style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--text-muted); margin-bottom:0.5rem;">Platform limits</div>
      <div style="display:flex; flex-direction:column; gap:0.375rem;">
        {[
          { label: 'Twitter / X',   max: 280,   id: 'lim-twitter' },
          { label: 'LinkedIn post', max: 3000,  id: 'lim-linkedin' },
          { label: 'SMS',           max: 160,   id: 'lim-sms' },
          { label: 'Meta title',    max: 60,    id: 'lim-meta' },
        ].map(p => (
          <div style="display:flex; align-items:center; gap:0.625rem;">
            <span style="font-size:0.72rem; font-weight:600; color:var(--text-secondary); min-width:6.5rem;">{p.label}</span>
            <div style="flex:1; height:6px; background:var(--bg-surface-3); border-radius:999px; overflow:hidden;">
              <div id={p.id + '-bar'} style="height:100%; width:0%; border-radius:999px; transition:width 0.25s, background 0.25s;"></div>
            </div>
            <span id={p.id + '-lbl'} style="font-size:0.72rem; font-family:'Fira Code',monospace; color:var(--text-muted); min-width:4.5rem; text-align:right;">0 / {p.max}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- HOW TO USE ───────────────────────────────── -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >Word Counter Overview &amp; Modern Technical Context</h2>
    <p class="seo-p" >
      This word counter computes six distinct text metrics — word count, character count, characters without spaces, sentence count, paragraph count, and estimated reading time — entirely within your browser using vanilla JavaScript. No text data is transmitted to any server, no cookies are set, and no tracking scripts execute during the counting process. The 100% client-side architecture means sensitive drafts, legal documents, academic papers, and confidential copy remain completely private, with zero server latency and zero data retention. The tool is built on standard DOM APIs (<code>String.prototype.split</code>, <code>RegExp</code>) and requires no external dependencies, making it fast enough to recalculate on every keystroke without perceptible delay.
    </p>
    <p class="seo-p" >
      Paste or type any text into the input area. All six statistics update instantly as you type — there is no submit button and no page reload. The platform limits section below the stats grid displays real-time progress bars against common character limits used by Twitter/X (280), LinkedIn (3,000), SMS (160), and HTML meta titles (60). Each bar is colour-coded: green when within budget, amber when approaching the limit (≥85%), and red when exceeded.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['SEO and content marketing', 'Digital marketers and SEO professionals must write page titles, meta descriptions, and social media posts within strict character limits. Google typically displays the first 50–60 characters of a title tag in search results, and truncation beyond that reduces click-through rates. This tool provides instant feedback against those thresholds, allowing writers to craft concise, search-optimised copy without guessing whether their text will be truncated.'],
        ['Academic and professional writing', 'Students, researchers, and professionals frequently work within word count constraints — essays, journal abstracts, grant proposals, and RFP responses all impose limits. The reading time estimate (based on a 200 wpm baseline) helps authors gauge whether their document is appropriately scoped for the intended audience. The sentence and paragraph counts provide structural insight that is useful for editing and readability analysis.'],
        ['Social media management and UX copywriting', 'Social media managers juggling multiple platforms need to ensure each post fits within the target platform\'s limits. SMS marketers must stay within the 160-character GSM limit to avoid splitting messages into multiple segments. UX writers crafting microcopy, error messages, and button labels benefit from the no-spaces character count, which reflects how most UI character counters display remaining length.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- HOW IT WORKS ────────────────────────────── -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >Deep-Dive: Technical Mechanics &amp; Mathematical Logic</h2>

    <h3 class="font-display seo-h3-sm" >Core Counting Algorithms</h3>
    <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1rem">
      <div class="info-row">
        <span class="info-label">Words</span>
        <span class="info-value">Split on whitespace, filter empty tokens</span>
      </div>
      <div class="info-row">
        <span class="info-label">Characters</span>
        <span class="info-value"><code>String.length</code> — all chars including spaces</span>
      </div>
      <div class="info-row">
        <span class="info-label">Chars (no spaces)</span>
        <span class="info-value"><code>text.replace(/\s/g, '').length</code></span>
      </div>
      <div class="info-row">
        <span class="info-label">Sentences</span>
        <span class="info-value">Split on <code>. ! ?</code> terminators, filter empties</span>
      </div>
      <div class="info-row">
        <span class="info-label">Paragraphs</span>
        <span class="info-value">Split on 2+ consecutive newlines, filter empties</span>
      </div>
      <div class="info-row">
        <span class="info-label">Reading time</span>
        <span class="info-value"><code>Math.ceil(words / 200)</code> minutes</span>
      </div>
    </div>

    <h3 class="font-display seo-h3-sm" >How the Computation Works Step-by-Step</h3>
    <p class="seo-p" >
      <strong>Word counting:</strong> The algorithm first trims leading and trailing whitespace from the input, then splits the string on one or more whitespace characters using the regular expression <code>\s+</code>. This handles spaces, tabs, newlines, and multiple consecutive whitespace characters uniformly. Each resulting token is passed through <code>filter(Boolean)</code> to discard empty strings that can arise from edge cases such as multiple consecutive spaces. The length of the filtered array is the word count. This approach correctly handles mixed whitespace, leading/trailing spaces, and single-word inputs.
    </p>
    <p class="seo-p" >
      <strong>Character counting:</strong> The total character count uses JavaScript's native <code>String.prototype.length</code>, which returns the number of UTF-16 code units. For standard English text this is equivalent to the number of visible characters plus whitespace. The "no spaces" variant strips all whitespace characters (spaces, tabs, newlines) using a global regex replacement before measuring length, providing the count that most platform character limits reference.
    </p>
    <p class="seo-p" >
      <strong>Sentence counting:</strong> Sentences are identified by splitting on terminal punctuation — periods, exclamation marks, and question marks — using the regex <code>[.!?]+</code>. The <code>+</code> quantifier handles sequences like <code>...</code> or <code>!?</code> as a single delimiter. Empty tokens are filtered out, which correctly handles inputs with no sentence terminators (producing a count of 1 for a single sentence, or 0 for empty input). Note that abbreviations containing periods (e.g. "Dr.", "U.S.A.") may cause over-splitting; this is a known limitation of regex-based sentence detection without NLP parsing.
    </p>
    <p class="seo-p" >
      <strong>Paragraph counting:</strong> Paragraphs are detected by splitting on two or more consecutive newline characters. The regex uses a quantifier to match two or more newlines as a single delimiter. This means a single blank line separates paragraphs, which aligns with standard Markdown and plain-text conventions. A single line break without a blank line between them does not create a new paragraph. Empty entries are filtered out, so leading or trailing blank lines do not inflate the count.
    </p>
    <p class="seo-p" >
      <strong>Reading time:</strong> The estimate divides total word count by 200 words per minute — a widely accepted average for silent reading of general-purpose English text. The result is rounded up using <code>Math.ceil()</code> so that any partial minute is reported as a full minute. For reference, average silent reading speeds range from 150 wpm (careful technical reading) to 300+ wpm (skimming). The 200 wpm baseline is deliberately conservative to avoid underestimating reading time for dense content.
    </p>
    <p class="seo-p-none" >
      <strong>Edge cases handled:</strong> The tool correctly handles empty input (all counters display 0), input consisting solely of whitespace (0 words, 0 paragraphs), very long single-line text (1 paragraph), text with only punctuation, and text containing a mix of line endings (<code>\n</code>, <code>\r\n</code>). All computations execute synchronously on the main thread, which is safe for inputs up to approximately 500,000 characters without blocking the UI.
    </p>
  </div>

  <!-- FAQ ─────────────────────────────────────── -->
  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "Does this word counter count hyphenated words as one or two?",
          a: "Hyphenated words (e.g. well-known, state-of-the-art) are counted as a single word because the splitting regex splits on whitespace, not hyphens. A hyphen is treated as part of the word token. If you need to count each component separately, replace hyphens with spaces before pasting your text. This behaviour is consistent with most professional word processors including Microsoft Word and Google Docs."
        },
        {
          q: "How is reading time calculated?",
          a: "Reading time is estimated at 200 words per minute, which is a conservative average for general English text comprehension based on meta-analyses of adult reading speed research. Academic or technical content is typically read at 100–150 wpm, while quick skimming can reach 300 wpm or more. The result is always rounded up to the nearest whole minute using Math.ceil(), so even a brief paragraph will show at least 1 minute of reading time. This ensures the estimate never underestimates the time commitment."
        },
        {
          q: "Does the character count include spaces?",
          a: "Yes — the main 'Characters' count includes all characters including spaces, tabs, and newline characters. A separate 'Chars (no spaces)' count is provided, which strips all whitespace before measuring. Most social media platforms (Twitter/X, LinkedIn, Facebook) and SMS character limits reference the no-spaces count, so use that metric when checking against platform constraints. The meta title bar also uses the no-spaces count, matching how Google measures title length."
        },
        {
          q: "How do I check my text against SEO title length limits?",
          a: "Use the 'Meta title' progress bar in the platform limits section. Google typically displays the first 50–60 characters of a page title in search results, and truncates beyond that with an ellipsis. The bar turns amber at 85% of the 60-character limit (51 characters) and red when you exceed 60 characters. For optimal click-through rates, aim to keep your title under 60 characters while including the primary keyword near the beginning."
        },
        {
          q: "Why does the sentence count sometimes seem wrong?",
          a: "The sentence counter uses a regex-based approach, splitting on periods, exclamation marks, and question marks. This means abbreviations containing periods (e.g. 'Dr.', 'U.S.A.', 'e.g.') can cause the counter to over-split, reporting more sentences than a human reader would identify. Similarly, sentences ending with multiple punctuation marks (e.g. 'Wow!!!') are still counted as a single sentence because the regex treats consecutive terminators as one delimiter. For precise sentence-level analysis, manual review remains necessary — this is a known limitation of all non-NLP sentence counters."
        },
        {
          q: "Is my text stored or sent anywhere?",
          a: "No. All counting happens entirely in your browser using client-side JavaScript. Your text never leaves your device — there are no server requests, no analytics tracking the content of your input, and no cookies or local storage used to persist your text. When you close the tab or click Clear, the text is permanently gone. This makes the tool suitable for counting words in confidential documents, legal contracts, medical records, or any sensitive material."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  const input = document.getElementById('wc-input') as HTMLTextAreaElement;

  const LIMITS = [
    { id: 'lim-twitter',  max: 280 },
    { id: 'lim-linkedin', max: 3000 },
    { id: 'lim-sms',      max: 160 },
    { id: 'lim-meta',     max: 60 },
  ];

  function update() {
    const text  = input.value;
    const words = text.trim() === '' ? 0 : text.trim().split(/\s+/).filter(Boolean).length;
    const chars      = text.length;
    const nospace    = text.replace(/\s/g, '').length;
    const sentences  = text === '' ? 0 : text.split(/[.!?]+/).filter(s => s.trim().length > 0).length;
    const paragraphs = text === '' ? 0 : text.split(/\n{2,}/).filter(p => p.trim().length > 0).length;
    const readMins   = Math.ceil(words / 200);

    (document.getElementById('stat-words')!)     .textContent = words.toLocaleString();
    (document.getElementById('stat-chars')!)     .textContent = chars.toLocaleString();
    (document.getElementById('stat-nospace')!)   .textContent = nospace.toLocaleString();
    (document.getElementById('stat-sentences')!) .textContent = sentences.toLocaleString();
    (document.getElementById('stat-paragraphs')!).textContent = paragraphs.toLocaleString();
    (document.getElementById('stat-reading')!)   .textContent = readMins + ' min';

    // Platform limit bars
    LIMITS.forEach(({ id, max }) => {
      const bar  = document.getElementById(id + '-bar')!;
      const lbl  = document.getElementById(id + '-lbl')!;
      const pct  = Math.min((chars / max) * 100, 100);
      const over = chars > max;
      bar.style.width = pct + '%';
      // Use CSS-var-compatible colours for the bar fill (these are SVG/canvas-equivalent data)
      bar.style.background = over ? '#EF4444' : pct >= 85 ? '#F59E0B' : '#10B981';
      lbl.textContent = `${chars.toLocaleString()} / ${max}`;
      lbl.style.color = over ? '#EF4444' : 'var(--text-muted)';
    });
  }

  input.addEventListener('input', update);
  update();

  // Copy text
  document.getElementById('btn-copy')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy')!;
    navigator.clipboard.writeText(input.value).then(() => {
      btn.textContent = '✓ Copied!';
      btn.classList.add('btn-success');
      setTimeout(() => {
        btn.textContent = 'Copy text';
        btn.classList.remove('btn-success');
      }, 2000);
    });
  });

  // Clear
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    input.value = '';
    update();
  });
</script>
