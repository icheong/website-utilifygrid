---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'freelance-invoice-tax-calculator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display" style="font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Freelance Net Pay Calculator</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.25rem;">
      <div>
        <label class="text-secondary" style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Hourly Rate ($)</label>
        <input id="rate" type="number" value="120" min="0" step="5"
          class="input-themed"/>
      </div>
      <div>
        <label class="text-secondary" style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Hours Worked</label>
        <input id="hours" type="number" value="40" min="0" step="0.5"
          class="input-themed"/>
      </div>
      <div>
        <label class="text-secondary" style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Billable Expenses ($)</label>
        <input id="expenses" type="number" value="0" min="0" step="10"
          class="input-themed"/>
      </div>
      <div>
        <label class="text-secondary" style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Tax Withholding (%)</label>
        <input id="tax" type="number" value="28" min="0" max="100" step="1"
          class="input-themed"/>
      </div>
    </div>

    <!-- Receipt -->
    <div id="receipt" class="result-card accent-success" style="font-size:0.875rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; padding-bottom:0.75rem; border-bottom:1px dashed var(--border);">
        <span class="font-display" style="font-weight:700; color:var(--color-brand-blue); font-size:1rem;">INVOICE SUMMARY</span>
        <span id="receipt-date" class="text-muted" style="font-size:0.78rem;"></span>
      </div>
      {[
        ['Hours', '', 'receipt-hours'],
        ['Hourly Rate', '', 'receipt-rate'],
        ['Labour Total', '', 'receipt-labour'],
        ['Expenses', '', 'receipt-expenses'],
        ['GROSS TOTAL', 'font-weight:700; color:var(--text-primary);', 'receipt-gross'],
        ['Tax Withheld', 'color:var(--error-text);', 'receipt-tax'],
        ['NET TAKE-HOME', 'font-weight:700; font-size:1rem; color:var(--color-brand-blue);', 'receipt-net'],
      ].map(([label, style, id]) => (
        <div style={`display:flex; justify-content:space-between; padding:0.375rem 0; border-bottom:1px solid var(--border); ${style}`}>
          <span class="text-secondary">{label}</span>
          <span id={id} style="font-weight:600; color:var(--text-primary);"></span>
        </div>
      ))}
    </div>

    <button id="copy-btn" class="btn-primary" style="margin-top:0.875rem; width:100%;" type="button">
      Copy Receipt to Clipboard
    </button>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to use the Freelance Net Pay Calculator</h2>
    <p class="seo-p">A freelance project just wrapped and the client asks for a final invoice. You know the hourly rate and hours worked, but after subtracting expenses and estimating the tax withholding, the net take-home is not obvious. Enter your hourly rate, total hours worked, any billable expenses the client agreed to reimburse, and your estimated tax withholding percentage. The receipt-style summary updates live — no submit button, no waiting.</p>
    <p class="seo-p">For example, a designer billing $120 per hour for 40 hours of work with $500 in stock asset expenses and a 28% tax withholding shows a gross total of $5,300. After subtracting $1,344 in tax on the $4,800 labour portion, the net take-home lands at $3,956. The receipt text can be copied straight into an invoice email or bookkeeping system.</p>
    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Client negotiation and rate justification', 'When a client pushes back on your rate, use the calculator to show the net impact. A 10% rate reduction on a 40-hour project does not just cut $X from your pay — it reduces your net take-home by a proportionally larger amount after tax, making the real cost of discounting clearer.'],
        ['Quarterly tax set-aside planning', 'Freelancers who do not withhold taxes monthly can use this tool to determine how much to set aside from each invoice. Multiply your quarterly income by the withholding rate to calculate the estimated tax payment due, avoiding year-end surprises and potential penalties.'],
        ['Expense categorisation and reporting', 'The separation of labour and expenses in the receipt mirrors how accountants categorise freelance income. Use the copied receipt text as a quick reference when reconciling invoices in your bookkeeping software, ensuring expenses stay in the correct ledger.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/cpm-ad-spend-calculator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">CPM & Digital Ad Spend ROI Calculator</a>
        <a href="/tools/ev-novated-lease-calculator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">EV Novated Lease Calculator</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How each figure is calculated</h2>
    <h3 class="font-display" style="font-size:1rem; font-weight:600; margin:1.25rem 0 0.5rem">Labour total and gross invoice</h3>
    <p class="seo-p">The labour total is your hourly rate multiplied by hours worked — the core billable amount for your time. Billable expenses (software licences, stock assets, travel, subcontractors) are added on top to produce the gross total. Expenses are treated as pass-through reimbursements and are excluded from tax calculations, reflecting standard invoicing practice where reimbursements are not considered earned income. A developer billing $150 per hour for 32 hours with $1,200 in travel expenses produces a labour total of $4,800 and a gross invoice of $6,000.</p>
    <h3 class="font-display" style="font-size:1rem; font-weight:600; margin:1.25rem 0 0.5rem">Tax withholding and net take-home</h3>
    <p class="seo-p">Tax is applied to the labour total only: <strong class="text-primary">Tax = Labour x (Rate / 100)</strong>. The net take-home is gross total minus tax withheld. This simplified model assumes a flat withholding rate, which freelancers typically estimate at 25-30% to cover combined income tax and self-employment tax (Social Security and Medicare in the US). Using the example above, a 28% withholding on $4,800 yields $1,344 in tax, leaving a net take-home of $4,656 from the $6,000 gross invoice. For precise figures, consult a tax professional or use quarterly estimated tax worksheets provided by your revenue authority.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What tax rate should I use as a freelancer?', a: 'As a self-employed contractor, you are typically responsible for both income tax and self-employment tax (Social Security + Medicare in the US). A common rule of thumb is to set aside 25–30% for federal taxes. Your actual rate depends on your total income, deductions, and country. Consult a tax professional for personalised advice and to determine your quarterly estimated payment obligations.' },
        { q: 'Should I charge tax on expense reimbursements?', a: 'Generally no — expense reimbursements are pass-through costs and not considered income. This calculator reflects that by applying tax only to the labour total. However, some jurisdictions and contract types treat expenses differently. If your client requires a single invoice that includes expenses, itemise the labour and expense portions separately to maintain clean accounting records.' },
        { q: 'How do I set my hourly rate as a freelancer?', a: 'A common starting point: take your desired annual salary, divide by 2,000 (roughly billable hours in a year after holidays and non-billable time) to get your baseline hourly rate. Then add 30–50% for overhead (taxes, benefits, equipment, software). A $80k equivalent salary suggests charging approximately $80–120 per hour depending on your market and overheads. Factor in that you will not bill 100% of your working hours.' },
        { q: 'What should I include in billable expenses?', a: 'Only pass-through expenses the client agreed to reimburse: software licences for the project, stock images, travel, printing, subcontractors. Do not include your ongoing overhead (your laptop, home office, internet) — those costs should already be factored into your hourly rate. Keep receipts for all billable expenses and reference them on your invoice for client approval and audit purposes.' },
        { q: 'How do I handle multi-currency invoices?', a: 'This calculator operates in a single currency. For multi-currency projects, convert the non-local currency to your home currency using the exchange rate on the invoice date, then enter the converted amounts. If you invoice in USD but incur expenses in another currency, use the rate from the date of purchase to keep the figures consistent for tax reporting.' },
        { q: 'Should I invoice per hour or per project?', a: 'Hourly billing (which this calculator models) provides transparency and protects you when scope expands. Fixed-price billing requires accurate upfront estimates to avoid undercharging. Many freelancers use a hybrid: a fixed project fee based on estimated hours, with a clause for additional hours at the agreed hourly rate. Regardless of method, tracking your actual hours using this tool helps you refine future estimates and improve profitability over time.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="text-primary seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  function fmt(n: number) { return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

  function calc() {
    const rate     = parseFloat((document.getElementById('rate') as HTMLInputElement).value)     || 0;
    const hours    = parseFloat((document.getElementById('hours') as HTMLInputElement).value)    || 0;
    const expenses = parseFloat((document.getElementById('expenses') as HTMLInputElement).value) || 0;
    const tax      = parseFloat((document.getElementById('tax') as HTMLInputElement).value)      || 0;

    const labour   = rate * hours;
    const gross    = labour + expenses;
    const taxAmt   = labour * (tax / 100);
    const net      = gross - taxAmt;

    const d = new Date();
    (document.getElementById('receipt-date') as HTMLElement).textContent = d.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' });
    (document.getElementById('receipt-hours') as HTMLElement).textContent    = hours + ' hrs';
    (document.getElementById('receipt-rate') as HTMLElement).textContent     = fmt(rate) + '/hr';
    (document.getElementById('receipt-labour') as HTMLElement).textContent   = fmt(labour);
    (document.getElementById('receipt-expenses') as HTMLElement).textContent = fmt(expenses);
    (document.getElementById('receipt-gross') as HTMLElement).textContent    = fmt(gross);
    (document.getElementById('receipt-tax') as HTMLElement).textContent      = '−' + fmt(taxAmt);
    (document.getElementById('receipt-net') as HTMLElement).textContent      = fmt(net);
  }

  (window as any).initCopyBtn('#copy-btn', () => {
    const rate     = (document.getElementById('rate') as HTMLInputElement).value;
    const hours    = (document.getElementById('hours') as HTMLInputElement).value;
    const expenses = (document.getElementById('expenses') as HTMLInputElement).value;
    const tax      = (document.getElementById('tax') as HTMLInputElement).value;
    const labour   = parseFloat(rate) * parseFloat(hours);
    const gross    = labour + parseFloat(expenses);
    const taxAmt   = labour * (parseFloat(tax) / 100);
    const net      = gross - taxAmt;
    return `INVOICE SUMMARY\n---\nHours: ${hours}\nRate: $${rate}/hr\nLabour: ${fmt(labour)}\nExpenses: ${fmt(parseFloat(expenses))}\nGross Total: ${fmt(gross)}\nTax (${tax}%): -${fmt(taxAmt)}\nNet Take-Home: ${fmt(net)}`;
  });

  ['rate','hours','expenses','tax'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));
  calc();
</script>
