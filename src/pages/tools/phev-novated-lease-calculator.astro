---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'phev-novated-lease-calculator')!;

const FYS = [
  { value: '2022-23', label: 'FY 2022-23', threshold: 84916 },
  { value: '2023-24', label: 'FY 2023-24', threshold: 89332 },
  { value: '2024-25', label: 'FY 2024-25', threshold: 91387 },
  { value: '2025-26', label: 'FY 2025-26', threshold: 91387 },
  { value: '2026-27', label: 'FY 2026-27', threshold: 91661 },
];
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:#0F172A; margin-bottom:0.25rem;">PHEV Novated Lease Calculator</h2>
    <p style="font-size:0.82rem; color:#475569; margin-bottom:1.25rem;">Model the true cost of salary packaging a plug-in hybrid (PHEV) under current Australian policy — including the standard FBT cost (PHEVs lost the FBT exemption from 1 Apr 2025), LCT threshold check, dual-fuel running cost estimator, lease hidden costs, and opportunity-cost comparison against using your own cash.</p>

    <!-- SECTION 1: POLICY & COMPLIANCE -->
    <div style="background:linear-gradient(135deg,#EFF6FF,#DBEAFE); border:1.5px solid #BFDBFE; border-radius:0.75rem; padding:1rem 1.1rem; margin-bottom:1rem;">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;">
        <span style="font-size:0.95rem;">🛡️</span>
        <h3 style="font-family:'Sora',sans-serif; font-size:0.78rem; font-weight:700; color:#1E40AF; text-transform:uppercase; letter-spacing:0.07em; margin:0;">Policy &amp; Compliance</h3>
        <span style="font-size:0.66rem; color:#1E40AF; background:#DBEAFE; padding:0.15rem 0.55rem; border-radius:999px; margin-left:auto; font-weight:700; letter-spacing:0.04em;">PHEV ≠ BEV</span>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#1E40AF; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Financial Year</label>
          <select id="fy" class="select-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem;">
            {FYS.map(fy => (
              <option value={fy.value} selected={fy.value === '2024-25'}>📅 {fy.label}</option>
            ))}
          </select>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#1E40AF; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">LCT Threshold (Fuel-Efficient)</label>
          <div style="display:flex; align-items:center; gap:0.5rem; height:2.25rem; padding:0 0.75rem; background:#fff; border:1.5px solid #E2E8F0; border-radius:0.5rem; box-sizing:border-box;">
            <span style="font-family:'Fira Code',monospace; font-size:0.9rem; font-weight:700; color:#0F172A;">$<span id="lct-threshold">91,387</span></span>
          </div>
        </div>
      </div>

      <div id="lct-status" style="display:flex; align-items:center; justify-content:space-between; padding:0.625rem 0.875rem; background:#fff; border:1px solid #E2E8F0; border-radius:0.5rem; font-size:0.78rem; flex-wrap:wrap; gap:0.5rem;">
        <span style="color:#475569;">LCT &amp; FBT status:</span>
        <span id="lct-badge" style="font-family:'Fira Code',monospace; font-weight:700; font-size:0.85rem;">—</span>
      </div>
    </div>

    <!-- SECTION 2: VEHICLE & INCOME -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Annual Gross Salary ($)</label>
        <input id="salary" type="number" value="120000" min="30000" step="1000" class="input-themed" style="width:100%; padding:0.625rem 0.875rem; border-radius:0.625rem; font-size:0.95rem; box-sizing:border-box;"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Vehicle Price ($)</label>
        <input id="vehicle-price" type="number" value="65000" min="10000" step="500" class="input-themed" style="width:100%; padding:0.625rem 0.875rem; border-radius:0.625rem; font-size:0.95rem; box-sizing:border-box;"/>
        <div style="font-size:0.68rem; color:#64748B; margin-top:0.25rem;">Drive-away price (before LCT)</div>
      </div>
    </div>

    <!-- SECTION 3: SMART PHEV RUNNING COST ESTIMATOR -->
    <div style="background:linear-gradient(135deg,#F0FDF4,#DCFCE7); border:1.5px solid #BBF7D0; border-radius:0.75rem; padding:1rem 1.1rem; margin-bottom:1rem;">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;">
        <span style="font-size:0.95rem;">⚡⛽</span>
        <h3 style="font-family:'Sora',sans-serif; font-size:0.78rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.07em; margin:0;">Smart PHEV Running Cost Estimator</h3>
        <span style="font-size:0.66rem; color:#065F46; background:#D1FAE5; padding:0.15rem 0.55rem; border-radius:999px; margin-left:auto; font-weight:700; letter-spacing:0.04em;">DUAL-FUEL</span>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Annual km Driven</label>
          <input id="km" type="number" value="15000" min="0" step="500" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Electric Range (km/full charge)</label>
          <div style="display:flex; align-items:center; gap:0.5rem; height:2.25rem; padding:0 0.5rem 0 0.75rem; background:#fff; border:1.5px solid #E2E8F0; border-radius:0.5rem; box-sizing:border-box;">
            <input id="ev-range" type="range" min="30" max="120" value="60" step="5" style="flex:1; accent-color:#10B981;"/>
            <span id="ev-range-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#065F46; min-width:2.5rem; text-align:right;">60</span>
          </div>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Full Charges per Week</label>
          <div style="display:flex; align-items:center; gap:0.5rem; height:2.25rem; padding:0 0.5rem 0 0.75rem; background:#fff; border:1.5px solid #E2E8F0; border-radius:0.5rem; box-sizing:border-box;">
            <input id="charge-freq" type="range" min="0" max="14" value="5" step="1" style="flex:1; accent-color:#10B981;"/>
            <span id="charge-freq-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#065F46; min-width:2.5rem; text-align:right;">5</span>
          </div>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Electric Efficiency (kWh/100km)</label>
          <div style="display:flex; align-items:center; gap:0.5rem; height:2.25rem; padding:0 0.5rem 0 0.75rem; background:#fff; border:1.5px solid #E2E8F0; border-radius:0.5rem; box-sizing:border-box;">
            <input id="ev-eff" type="range" min="14" max="25" value="17" step="0.5" style="flex:1; accent-color:#10B981;"/>
            <span id="ev-eff-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#065F46; min-width:2.5rem; text-align:right;">17.0</span>
          </div>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Petrol Efficiency (L/100km)</label>
          <div style="display:flex; align-items:center; gap:0.5rem; height:2.25rem; padding:0 0.5rem 0 0.75rem; background:#fff; border:1.5px solid #E2E8F0; border-radius:0.5rem; box-sizing:border-box;">
            <input id="petrol-eff" type="range" min="1.5" max="8" value="5" step="0.1" style="flex:1; accent-color:#F59E0B;"/>
            <span id="petrol-eff-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#92400E; min-width:2.5rem; text-align:right;">5.0</span>
          </div>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Petrol Price ($/L)</label>
          <input id="petrol-price" type="number" value="1.80" min="0" step="0.01" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Home Charging ($/kWh)</label>
          <input id="home-rate" type="number" value="0.30" min="0" step="0.01" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Public Charging ($/kWh)</label>
          <input id="public-rate" type="number" value="0.55" min="0" step="0.01" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
      </div>

      <div style="margin-bottom:0.75rem;">
        <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em;">Home vs Public Charging Ratio</label>
          <span id="home-ratio-val" style="font-family:'Fira Code',monospace; font-size:0.78rem; font-weight:700; color:#065F46;">80% home / 20% public</span>
        </div>
        <input id="home-ratio" type="range" min="0" max="100" value="80" step="5" style="width:100%; accent-color:#10B981;"/>
      </div>

      <div style="margin-bottom:0.75rem;">
        <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Other Fixed Costs — insurance, rego, tyres, servicing ($/yr)</label>
        <input id="other-costs" type="number" value="2000" min="0" step="100" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
      </div>

      <div style="background:#fff; border:1.5px solid #10B981; border-radius:0.5rem; padding:0.75rem 0.875rem; display:flex; align-items:center; justify-content:space-between; gap:0.75rem; flex-wrap:wrap;">
        <div style="min-width:0; flex:1;">
          <div style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em;">Estimated Annual Running Cost</div>
          <div id="energy-detail" style="font-size:0.72rem; color:#64748B; margin-top:0.2rem; font-family:'Fira Code',monospace; line-height:1.5;">—</div>
        </div>
        <div style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:800; color:#059669; white-space:nowrap;">$<span id="running-total">0</span></div>
      </div>
    </div>

    <!-- SECTION 4: LEASE TERMS & HIDDEN COSTS -->
    <div style="background:linear-gradient(135deg,#F8FAFC,#F1F5F9); border:1.5px solid #E2E8F0; border-radius:0.75rem; padding:1rem 1.1rem; margin-bottom:1rem;">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;">
        <span style="font-size:0.95rem;">📋</span>
        <h3 style="font-family:'Sora',sans-serif; font-size:0.78rem; font-weight:700; color:#334155; text-transform:uppercase; letter-spacing:0.07em; margin:0;">Lease Terms &amp; Hidden Costs</h3>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Lease Term</label>
          <select id="lease-term" class="select-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem;">
            <option value="1">1 year</option>
            <option value="2">2 years</option>
            <option value="3" selected>3 years</option>
            <option value="4">4 years</option>
            <option value="5">5 years</option>
          </select>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Finance Rate (% p.a.)</label>
          <div style="display:flex; align-items:center; gap:0.5rem; height:2.25rem; padding:0 0.5rem 0 0.75rem; background:#fff; border:1.5px solid #E2E8F0; border-radius:0.5rem; box-sizing:border-box;">
            <input id="finance-rate" type="range" min="3" max="14" value="6" step="0.5" style="flex:1; accent-color:#1D4ED8;"/>
            <span id="finance-rate-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#0F172A; min-width:2.5rem;">6%</span>
          </div>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Residual Value (%)</label>
          <div style="display:flex; align-items:center; gap:0.5rem; height:2.25rem; padding:0 0.5rem 0 0.75rem; background:#fff; border:1.5px solid #E2E8F0; border-radius:0.5rem; box-sizing:border-box;">
            <input id="residual" type="range" min="10" max="60" value="30" step="1" style="flex:1; accent-color:#1D4ED8;"/>
            <span id="residual-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#0F172A; min-width:2.75rem;">30%</span>
          </div>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Monthly Provider Admin Fee ($)</label>
          <input id="admin-fee" type="number" value="8" min="0" step="1" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
      </div>
      <div>
        <label style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Upfront Setup Fee ($) — once-off, pre-tax deductible</label>
        <input id="setup-fee" type="number" value="350" min="0" step="50" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        <div style="font-size:0.7rem; color:#64748B; margin-top:0.25rem;">Typical novated lease setup fees range from $0–$500 (provider-dependent)</div>
      </div>
    </div>

    <!-- SECTION 5: ALTERNATIVE CASH / OFFSET COMPARISON -->
    <div style="background:linear-gradient(135deg,#FEF3C7,#FDE68A); border:1.5px solid #FCD34D; border-radius:0.75rem; padding:1rem 1.1rem; margin-bottom:1rem;">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem; flex-wrap:wrap;">
        <span style="font-size:0.95rem;">💰</span>
        <h3 style="font-family:'Sora',sans-serif; font-size:0.78rem; font-weight:700; color:#92400E; text-transform:uppercase; letter-spacing:0.07em; margin:0;">Alternative: Use Your Own Cash / Housing Equity</h3>
        <label style="display:flex; align-items:center; gap:0.4rem; margin-left:auto; cursor:pointer; font-size:0.78rem; color:#78350F; font-weight:600;">
          <input id="enable-cash" type="checkbox" style="accent-color:#D97706; width:1rem; height:1rem;"/>
          Enable comparison
        </label>
      </div>

      <div id="cash-inputs" style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; opacity:0.4; pointer-events:none; transition:opacity 0.2s ease;">
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#92400E; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Cash Reserves / Equity Available ($)</label>
          <input id="cash-available" type="number" value="80000" min="0" step="1000" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#92400E; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Offset / Mortgage Interest Rate (% p.a.)</label>
          <input id="offset-rate" type="number" value="5.5" min="0" step="0.1" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
        <div style="grid-column:span 2;">
          <div style="font-size:0.72rem; color:#78350F; background:rgba(255,255,255,0.7); border:1px dashed #D97706; border-radius:0.4rem; padding:0.5rem 0.75rem; line-height:1.55;">
            💡 The opportunity cost is the offset interest your cash would have <strong>saved</strong> on your mortgage (or <strong>earned</strong> in a high-yield saver) over the term, if it had stayed in the account instead of being spent on the car.
          </div>
        </div>
      </div>
    </div>

    <!-- RESULTS -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
      <div class="result-card accent-blue">
        <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.08em; color:#475569; margin-bottom:0.5rem;">📦 Novated Lease</div>
        <div style="display:flex; flex-direction:column; gap:0.375rem; font-size:0.8rem;">
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#64748B;">Pre-tax deduction/yr</span>
            <span id="out-pretax" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#64748B;">Tax saved/yr</span>
            <span id="out-tax-saved" style="font-family:'Fira Code',monospace; font-weight:700; color:#16A34A;">—</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#64748B;">FBT payable/yr</span>
            <span id="out-fbt" style="font-family:'Fira Code',monospace; font-weight:700; color:#DC2626;">—</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding-top:0.375rem; border-top:1px dashed #E2E8F0;">
            <span style="color:#475569; font-weight:600;">Net tax benefit/yr</span>
            <span id="out-net-benefit" style="font-family:'Fira Code',monospace; font-weight:700; color:#16A34A;">—</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding-top:0.375rem; border-top:1px dashed #E2E8F0;">
            <span style="color:#475569; font-weight:600;">Net cost over term</span>
            <span id="out-lease-net" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
          </div>
        </div>
      </div>

      <div class="result-card" style="border-left:3px solid #64748B;">
        <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.08em; color:#475569; margin-bottom:0.5rem;">💳 Out-of-Pocket Purchase</div>
        <div style="display:flex; flex-direction:column; gap:0.375rem; font-size:0.8rem;">
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#64748B;">Purchase (incl. LCT)</span>
            <span id="out-purchase" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#64748B;">Running costs over term</span>
            <span id="out-running-total" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#64748B;">Total net cost</span>
            <span id="out-oop-net" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
          </div>
        </div>
      </div>
    </div>

    <div id="cash-card" class="result-card" style="border-left:3px solid #D97706; margin-bottom:0.75rem; display:none;">
      <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.08em; color:#475569; margin-bottom:0.5rem;">🏦 Buy with Cash / Housing Equity (incl. opportunity cost)</div>
      <div style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0.5rem 1rem; font-size:0.8rem;">
        <div style="display:flex; justify-content:space-between; gap:0.5rem;">
          <span style="color:#64748B;">Purchase (incl. LCT)</span>
          <span id="out-cash-purchase" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
        </div>
        <div style="display:flex; justify-content:space-between; gap:0.5rem;">
          <span style="color:#64748B;">Lost offset interest</span>
          <span id="out-cash-opp" style="font-family:'Fira Code',monospace; font-weight:700; color:#DC2626;">—</span>
        </div>
        <div style="display:flex; justify-content:space-between; gap:0.5rem;">
          <span style="color:#64748B;">Running costs over term</span>
          <span id="out-cash-running" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
        </div>
        <div style="display:flex; justify-content:space-between; gap:0.5rem;">
          <span style="color:#64748B;">Total true cost</span>
          <span id="out-cash-net" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
        </div>
      </div>
    </div>

    <div id="savings-bar" style="border-radius:0.875rem; padding:1.25rem; text-align:center; background:linear-gradient(135deg,#1E3A8A,#1D4ED8); color:#fff;">
      <div id="savings-label" style="font-size:0.75rem; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; opacity:0.85; margin-bottom:0.35rem;">Estimated Saving with Novated Lease</div>
      <div id="out-saving" style="font-family:'Sora',sans-serif; font-size:2rem; font-weight:800; letter-spacing:-0.02em;">—</div>
      <div style="font-size:0.8rem; opacity:0.75; margin-top:0.25rem;">over the lease term · indicative only</div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:#0F172A; margin-bottom:0.75rem;">PHEV Novated Lease Calculator — Overview &amp; Modern Technical Context</h2>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Plug-in hybrid electric vehicles (PHEVs) occupy a unique position in Australia's salary packaging landscape. Unlike battery electric vehicles (BEVs), PHEVs <strong>lost their FBT exemption from 1 April 2025</strong> — meaning new PHEV novated leases now incur standard Fringe Benefits Tax at ~37.7% of the taxable value (after the Type 1 gross-up). This calculator models the complete financial picture for PHEV novated leasing under current Australian policy, including the dual-fuel running cost estimator (electric + petrol), LCT threshold validation, lease hidden costs, and an opportunity-cost comparison against using your own cash or housing equity. All computations run entirely in your browser — no financial data is transmitted to any server.
    </p>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      The <strong>Smart PHEV Running Cost Estimator</strong> is purpose-built for dual-fuel vehicles: it splits your annual km into electric vs petrol based on the vehicle's electric range per full charge and your weekly charging frequency, then calculates separate energy costs for each fuel type using your home/public electricity rates and petrol price. This produces a far more accurate running cost estimate than a single-fuel model, and is critical for PHEVs where the electric-to-petrol ratio directly affects total cost of ownership.
    </p>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75;">
      The calculator applies current Australian tax rates and ATO-published LCT thresholds across financial years FY 2022-23 through FY 2026-27. PHEVs must meet the ≤3.5L/100km combined fuel consumption test to qualify for the higher fuel-efficient LCT threshold; otherwise the $80,567 other-vehicles threshold applies. Toggle the <strong>Alternative Cash / Housing Equity</strong> comparison to model the true economic cost of buying outright, including the opportunity cost of offset interest your cash would otherwise have saved on your mortgage.
    </p>

    <h3 style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:#0F172A; margin:1.5rem 0 0.75rem;">Real-World Applications &amp; Use Cases</h3>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75; margin-bottom:0.5rem;">
      <strong>PHEV vs BEV acquisition decision:</strong> An employee choosing between a PHEV and a BEV novated lease needs to understand the FBT cost difference. A BEV under the LCT threshold qualifies for 0% FBT; a PHEV (post-1 April 2025) always pays ~37.7% FBT on the taxable value. This calculator quantifies that gap precisely, enabling a side-by-side comparison of total lease costs — including running cost differences from the PHEV's dual-fuel system — to determine whether the PHEV's lower upfront price offsets its higher FBT burden.
    </p>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75; margin-bottom:0.5rem;">
      <strong>PHEV running cost modelling:</strong> PHEVs have two fuel sources with different cost profiles. A PHEV with 60km electric range charged 5 times per week covers ~15,600km/year on electricity alone — leaving the remainder for petrol. The dual-fuel estimator accurately splits these costs using your actual charging habits, electricity rates, and petrol price, producing a realistic annual running cost that a simple "km × cost/km" estimate would miss.
    </p>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75;">
      <strong>Pre-April 2025 grandfathered lease review:</strong> PHEV novated leases entered into before 1 April 2025 remain grandfathered under the old FBT exemption rules for the life of that lease. Employees with existing PHEV leases can use this calculator to model the true cost of their current arrangement and compare it against renewing with a BEV (which would qualify for the new FBT exemption) at lease expiry.
    </p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:#0F172A; margin-bottom:0.75rem;">Deep-Dive: PHEV Novated Lease Calculation Mechanics</h2>

    <h3 style="font-size:0.95rem; font-weight:600; color:#0F172A; margin:1rem 0 0.5rem;">Core Formulas</h3>
    <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; color:#0F172A; line-height:1.9; margin-bottom:0.875rem;">
      LCT = max(0, (Price − LCT threshold) × 33%)<br/>
      Effective price = Price + LCT<br/>
      <br/>
      Electric km/yr = min(annual km, charges/wk × range × 52)<br/>
      Petrol km/yr = annual km − Electric km<br/>
      Electric kWh/yr = (Electric km × Electric eff) ÷ 100<br/>
      Electric $/yr = Electric kWh × weighted rate (home% × home + public% × public)<br/>
      Petrol L/yr = (Petrol km × Petrol eff) ÷ 100<br/>
      Petrol $/yr = Petrol L × Petrol price<br/>
      Running cost/yr = Electric + Petrol + Other fixed costs<br/>
      <br/>
      Annual lease = (Effective price − Residual) ÷ Term + Interest<br/>
      Annual pre-tax = Lease + (Admin × 12) + Running<br/>
      Tax saved/yr = Annual pre-tax × Marginal rate<br/>
      FBT cost/yr = Annual pre-tax × 37.7% (PHEVs always pay full FBT)<br/>
      Net tax benefit/yr = Tax saved − FBT cost<br/>
      Net novated cost = (Pre-tax × Term) × (1 − Marginal) + (FBT × Term) + Setup × (1 − Marginal) + Residual<br/>
      <br/>
      Out-of-pocket = Effective price + (Running × Term)<br/>
      Cash/Offset total = Effective price + (Running × Term) + (Cash used × Offset rate × Term)
    </div>

    <h3 style="font-size:0.95rem; font-weight:600; color:#0F172A; margin:1rem 0 0.5rem;">PHEV-Specific FBT &amp; LCT Mechanics</h3>
    <p style="color:#475569; font-size:0.85rem; line-height:1.7; margin-bottom:0.5rem;">
      <strong>FBT treatment for PHEVs:</strong> From 1 April 2025, PHEVs are ineligible for the EV FBT exemption. The calculator applies a constant FBT rate of 37.7% (statutory rate 20% × Type 1 gross-up factor 1.8868) to the annual pre-tax deduction, regardless of the vehicle price or LCT threshold position. This is the key difference from the BEV calculator — PHEVs always incur FBT.
    </p>
    <p style="color:#475569; font-size:0.85rem; line-height:1.7; margin-bottom:0.5rem;">
      <strong>LCT threshold eligibility:</strong> PHEVs must meet the ≤3.5L/100km combined fuel consumption test (as rated under the Road Vehicle Standards Act 2018) to qualify for the higher fuel-efficient threshold ($91,387 in FY 2024-25; $91,661 in FY 2026-27). PHEVs that exceed 3.5L/100km fall to the lower $80,567 other-vehicles threshold. LCT is added to the effective vehicle cost before calculating the lease, regardless of FBT treatment.
    </p>
    <p style="color:#475569; font-size:0.85rem; line-height:1.7; margin-bottom:0.5rem;">
      <strong>Marginal tax rates</strong> used: ≤$18,200 → 0%, $18,201–$45,000 → 19%, $45,001–$120,000 → 32.5%, $120,001–$180,000 → 37%, &gt;$180,000 → 45% (excluding Medicare levy). This is a simplified estimate — actual savings depend on your employer's novated lease arrangements, Reportable Fringe Benefits Amount (RFBA) impact, and GST treatment.
    </p>

    <h3 style="font-size:0.95rem; font-weight:600; color:#0F172A; margin:1rem 0 0.5rem;">Edge Cases &amp; Important Notes</h3>
    <p style="color:#475569; font-size:0.85rem; line-height:1.7; margin-bottom:0.5rem;">
      <strong>Opportunity cost</strong> in the cash/offset scenario is the offset interest (or high-yield savings interest) you forgo by spending the cash. It compounds simply over the term: <code>cash_used × offset_rate × term_years</code>. The "Total true cost" therefore reflects the real economic cost of buying with cash, not just the sticker price.
    </p>
    <p style="color:#475569; font-size:0.85rem; line-height:1.7; margin-bottom:0.5rem;">
      <strong>Residual value</strong> (guaranteed future value) is set as a percentage of the effective (LCT-inclusive) price. ATO minimum residuals range from ~65.63% for a 1-year lease to ~28.13% for a 5-year lease. The residual is paid at end-of-term to own the vehicle, re-financed, or traded in.
    </p>
    <p style="color:#475569; font-size:0.85rem; line-height:1.7;">
      <strong>GST recovery:</strong> One significant benefit of novated leasing is that your employer can claim back the GST on the vehicle purchase and running costs, effectively reducing the cost by 1/11th. This calculator uses pre-GST running cost inputs; if your provider quotes inclusive figures, divide by 1.1 before entering them here for a more accurate result.
    </p>
  </div>

  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:#0F172A; margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'Do PHEVs still qualify for the FBT exemption in Australia?', a: 'No — from 1 April 2025, plug-in hybrid electric vehicles (PHEVs) are no longer eligible for the FBT exemption on novated leases. Only zero-emission vehicles (battery electric vehicles and hydrogen fuel cell vehicles) qualify. PHEVs entered into a novated lease before 1 April 2025 remain grandfathered under the old exemption rules for the life of that lease, but no new FBT-exempt PHEV leases can be entered into. This calculator models the current policy: PHEVs always pay standard FBT.' },
        { q: 'What is the LCT threshold and how does it affect my PHEV novated lease?', a: 'Luxury Car Tax (LCT) is 33% on the amount above the fuel-efficient threshold. PHEVs with a combined fuel consumption of ≤3.5L/100km (as rated under the Road Vehicle Standards Act 2018) qualify for the higher fuel-efficient threshold ($91,387 in 2024-25; $91,661 in 2026-27). PHEVs that exceed 3.5L/100km fall to the lower $80,567 other-vehicles threshold. LCT is added to your vehicle cost before calculating the lease, regardless of FBT treatment.' },
        { q: 'How does the LCT threshold interact with FBT for PHEVs?', a: 'For PHEVs, the LCT threshold and the FBT exemption are now decoupled. Previously (before 1 April 2025) a sub-LCT PHEV would qualify for the FBT exemption; now PHEVs pay standard FBT no matter where they sit relative to the LCT threshold. LCT is still added to the effective vehicle cost, but breaching the threshold no longer changes your FBT treatment (since PHEVs are ineligible for any FBT exemption either way).' },
        { q: 'How is the smart PHEV running cost estimator calculated?', a: 'Electric km = min(annual km, charges-per-week × electric range × 52). Petrol km = annual km − electric km. Electric kWh = electric km × electric efficiency ÷ 100. Petrol litres = petrol km × petrol efficiency ÷ 100. The electric kWh is split by your home vs public charging ratio, then multiplied by the relevant per-kWh rate. Petrol cost is litres × petrol price. Both fuel costs are added to your other fixed costs. Typical PHEVs have 40–90 km of electric range, 15–20 kWh/100km electric efficiency, and 4–7 L/100km petrol efficiency when running on the ICE.' },
        { q: 'How much do hidden lease fees (admin + setup) cost over a term?', a: 'A typical $8/month admin fee adds $96/year, or $288 over a 3-year term. A $350 setup fee is usually charged once but is pre-tax deductible, so its net cost is reduced by your marginal tax rate. These line items are easy to miss in provider quotes but materially reduce your saving — and are especially important for PHEVs where the FBT cost already narrows the margin.' },
        { q: 'Should I use my own cash or housing equity instead of leasing a PHEV?', a: 'It depends on the opportunity cost. If your cash sits in an offset account saving 5.5% mortgage interest, spending it on a $65,000 car costs you ~$10,725 in lost interest over a 3-year term. A novated PHEV lease is far less advantageous than a novated BEV lease (because the FBT cost now applies), but it can still beat a cash purchase if your marginal tax rate exceeds the offset rate by enough. Use the "Alternative Cash" comparison to see the true net cost in your specific scenario.' },
        { q: 'Does the FBT exemption affect my reportable fringe benefits?', a: 'Yes — even though PHEVs no longer get the FBT exemption, the pre-tax amount is still recorded as a Reportable Fringe Benefit Amount (RFBA) on your payment summary (the FBT itself is reported separately on the FBT return). This can affect income-tested thresholds for Medicare levy surcharge, HECS/HELP repayments, childcare subsidy, and certain Centrelink payments. Factor this into your personal assessment.' },
        { q: 'What is a residual value?', a: 'The residual value (also called guaranteed future value) is the agreed value of the vehicle at the end of the lease term, set as a percentage of the effective (LCT-inclusive) price. ATO minimum residuals range from ~65.63% for a 1-year lease to ~28.13% for a 5-year lease. You can pay the residual to own the vehicle, re-finance it, or trade in.' },
        { q: 'Can I include GST savings in the calculation?', a: 'Yes — one significant benefit of novated leasing is that your employer can claim back the GST on the vehicle purchase and running costs, effectively reducing the cost by 1/11th. This calculator uses pre-GST running cost inputs; if your provider quotes inclusive figures, divide by 1.1 before entering them here for a more accurate result.' },
        { q: 'Should I choose a PHEV or BEV for my novated lease?', a: 'Post-1 April 2025, BEVs are significantly more tax-effective because they qualify for the FBT exemption (0% FBT) while PHEVs do not. For a $65,000 vehicle on a 3-year lease, the FBT cost difference can be $4,000–$8,000+ depending on your salary. However, PHEVs may still suit drivers who need petrol backup for long trips and have limited charging access. Run both calculators with your specific inputs to compare total costs.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:#fff; border:1.5px solid #E2E8F0; border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:#0F172A; margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:#475569; line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>

    <div style="margin-top:1.25rem; padding-top:1rem; border-top:1px solid #E2E8F0; font-size:0.78rem; color:#64748B; line-height:1.8;">
      <strong style="color:#475569;">Disclaimer:</strong> This calculator is provided for educational and informational purposes only. It does not constitute financial, taxation, or legal advice. The calculations are estimates based on simplified assumptions — actual savings depend on your employer's novated lease arrangements, your complete financial situation, RFBA impact, GST treatment, and current ATO rulings. Tax thresholds, LCT rates, and FBT rules may change. Always consult a qualified financial adviser or registered tax agent before making financial decisions. ATO data sourced from <a href="https://www.ato.gov.au/rates/luxury-car-tax-rate-and-thresholds/" target="_blank" rel="noopener" style="color:#1D4ED8; text-decoration:underline;">ato.gov.au</a>.
    </div>
  </div>

</ToolLayout>

<script>
  const LCT_FY: Record<string, number> = {
    '2022-23': 84916,
    '2023-24': 89332,
    '2024-25': 91387,
    '2025-26': 91387,
    '2026-27': 91661,
  };
  const LCT_RATE = 0.33;
  const FBT_STATUTORY = 0.20;
  const FBT_GROSSUP   = 1.8868;
  const PHEV_FBT_RATE = FBT_STATUTORY * FBT_GROSSUP;

  function fmt(n: number) {
    return Math.round(n).toLocaleString('en-AU');
  }
  function money(n: number) {
    return '$' + Math.round(n).toLocaleString('en-AU');
  }

  function getMarginalRate(salary: number): number {
    if (salary <= 18200) return 0;
    if (salary <= 45000) return 0.19;
    if (salary <= 120000) return 0.325;
    if (salary <= 180000) return 0.37;
    return 0.45;
  }

  function calc() {
    const salary      = parseFloat((document.getElementById('salary') as HTMLInputElement).value) || 0;
    const price       = parseFloat((document.getElementById('vehicle-price') as HTMLInputElement).value) || 0;
    const fy          = (document.getElementById('fy') as HTMLSelectElement).value;
    const threshold   = LCT_FY[fy] ?? 91387;

    const lctAmount      = Math.max(0, (price - threshold) * LCT_RATE);
    const effectivePrice = price + lctAmount;

    (document.getElementById('lct-threshold') as HTMLElement).textContent = threshold.toLocaleString('en-AU');
    const lctBadge = document.getElementById('lct-badge')!;
    if (lctAmount > 0) {
      lctBadge.innerHTML = `<span style="color:#D97706;">+${money(lctAmount)} LCT</span> <span style="color:#64748B; font-weight:500;">(${(price > 0 ? ((lctAmount / price) * 100).toFixed(1) : '0.0')}% of price)</span> <span style="color:#DC2626;">· ✗ PHEV pays FBT</span>`;
    } else {
      lctBadge.innerHTML = `<span style="color:#16A34A;">$0 LCT ✓ Under threshold</span> <span style="color:#DC2626;">· ✗ PHEVs ineligible for FBT exemption (from 1 Apr 2025) — standard FBT applies</span>`;
    }

    const km           = parseFloat((document.getElementById('km') as HTMLInputElement).value) || 0;
    const evRange      = parseInt((document.getElementById('ev-range') as HTMLInputElement).value) || 0;
    const chargeFreq   = parseInt((document.getElementById('charge-freq') as HTMLInputElement).value) || 0;
    const evEff        = parseFloat((document.getElementById('ev-eff') as HTMLInputElement).value) || 0;
    const petrolEff    = parseFloat((document.getElementById('petrol-eff') as HTMLInputElement).value) || 0;
    const petrolPrice  = parseFloat((document.getElementById('petrol-price') as HTMLInputElement).value) || 0;
    const homeRate     = parseFloat((document.getElementById('home-rate') as HTMLInputElement).value) || 0;
    const publicRate   = parseFloat((document.getElementById('public-rate') as HTMLInputElement).value) || 0;
    const homeRatio    = parseInt((document.getElementById('home-ratio') as HTMLInputElement).value) / 100;
    const otherCosts   = parseFloat((document.getElementById('other-costs') as HTMLInputElement).value) || 0;

    const electricKm   = Math.min(km, chargeFreq * evRange * 52);
    const petrolKm     = Math.max(0, km - electricKm);
    const totalKwh     = (electricKm * evEff) / 100;
    const homeKwh      = totalKwh * homeRatio;
    const publicKwh    = totalKwh * (1 - homeRatio);
    const electricCost = homeKwh * homeRate + publicKwh * publicRate;
    const petrolLitres = (petrolKm * petrolEff) / 100;
    const petrolCost   = petrolLitres * petrolPrice;
    const running      = electricCost + petrolCost + otherCosts;

    (document.getElementById('ev-range-val') as HTMLElement).textContent     = String(evRange);
    (document.getElementById('charge-freq-val') as HTMLElement).textContent  = String(chargeFreq);
    (document.getElementById('ev-eff-val') as HTMLElement).textContent       = evEff.toFixed(1);
    (document.getElementById('petrol-eff-val') as HTMLElement).textContent   = petrolEff.toFixed(1);
    (document.getElementById('home-ratio-val') as HTMLElement).textContent   =
      `${Math.round(homeRatio * 100)}% home / ${Math.round((1 - homeRatio) * 100)}% public`;
    (document.getElementById('energy-detail') as HTMLElement).textContent =
      `${fmt(electricKm)} km elec ($${electricCost.toFixed(0)}) · ${fmt(petrolKm)} km petrol ($${petrolCost.toFixed(0)}) + $${otherCosts.toFixed(0)} fixed`;
    (document.getElementById('running-total') as HTMLElement).textContent = fmt(running);

    const term        = parseInt((document.getElementById('lease-term') as HTMLSelectElement).value) || 3;
    const residualPct = parseInt((document.getElementById('residual') as HTMLInputElement).value) / 100;
    const rate        = parseFloat((document.getElementById('finance-rate') as HTMLInputElement).value) / 100;
    const adminFee    = parseFloat((document.getElementById('admin-fee') as HTMLInputElement).value) || 0;
    const setupFee    = parseFloat((document.getElementById('setup-fee') as HTMLInputElement).value) || 0;

    (document.getElementById('residual-val') as HTMLElement).textContent = (residualPct * 100) + '%';
    (document.getElementById('finance-rate-val') as HTMLElement).textContent = (rate * 100) + '%';

    const cashEnabled   = (document.getElementById('enable-cash') as HTMLInputElement).checked;
    const cashAvailable = parseFloat((document.getElementById('cash-available') as HTMLInputElement).value) || 0;
    const offsetRate    = (parseFloat((document.getElementById('offset-rate') as HTMLInputElement).value) || 0) / 100;

    const cashInputs = document.getElementById('cash-inputs')! as HTMLElement;
    const cashCard   = document.getElementById('cash-card')! as HTMLElement;
    if (cashEnabled) {
      cashInputs.style.opacity = '1';
      cashInputs.style.pointerEvents = 'auto';
      cashCard.style.display = 'block';
    } else {
      cashInputs.style.opacity = '0.4';
      cashInputs.style.pointerEvents = 'none';
      cashCard.style.display = 'none';
    }

    const annualAdmin    = adminFee * 12;
    const residualAmt    = effectivePrice * residualPct;
    const loanAmt        = effectivePrice - residualAmt;
    const annualInt      = loanAmt * rate;
    const annualLease    = loanAmt / term + annualInt;
    const annualPreTax   = annualLease + annualAdmin + running;
    const marginalRate   = getMarginalRate(salary);
    const taxSavedAnnual = annualPreTax * marginalRate;
    const fbtAnnual      = annualPreTax * PHEV_FBT_RATE;
    const netBenefitYr   = taxSavedAnnual - fbtAnnual;

    const totalPreTax    = annualPreTax * term + setupFee;
    const totalTaxSaved  = totalPreTax * marginalRate;
    const totalFbt       = totalPreTax * PHEV_FBT_RATE;
    const leaseNetTotal  = totalPreTax - totalTaxSaved + totalFbt + residualAmt;

    const oopRunning     = running * term;
    const oopTotal       = effectivePrice + oopRunning;

    const cashUsed       = Math.min(effectivePrice, cashAvailable);
    const cashOppInt     = cashUsed * offsetRate * term;
    const cashRunning    = running * term;
    const cashNet        = effectivePrice + cashRunning + cashOppInt;

    (document.getElementById('out-pretax') as HTMLElement).textContent       = money(annualPreTax);
    (document.getElementById('out-tax-saved') as HTMLElement).textContent    = money(taxSavedAnnual);
    (document.getElementById('out-fbt') as HTMLElement).textContent          = '−' + money(fbtAnnual);
    (document.getElementById('out-net-benefit') as HTMLElement).textContent  = (netBenefitYr >= 0 ? '+' : '') + money(netBenefitYr);
    (document.getElementById('out-lease-net') as HTMLElement).textContent    = money(leaseNetTotal);
    (document.getElementById('out-purchase') as HTMLElement).textContent     = money(effectivePrice);
    (document.getElementById('out-running-total') as HTMLElement).textContent = money(oopRunning);
    (document.getElementById('out-oop-net') as HTMLElement).textContent      = money(oopTotal);

    if (cashEnabled) {
      (document.getElementById('out-cash-purchase') as HTMLElement).textContent = money(effectivePrice);
      (document.getElementById('out-cash-opp') as HTMLElement).textContent      = '+' + money(cashOppInt);
      (document.getElementById('out-cash-running') as HTMLElement).textContent  = money(cashRunning);
      (document.getElementById('out-cash-net') as HTMLElement).textContent      = money(cashNet);
    }

    let bestAlt = oopTotal;
    let altLabel = 'vs Out-of-Pocket';
    if (cashEnabled && cashNet < bestAlt) {
      bestAlt = cashNet;
      altLabel = 'vs Cash + Offset';
    }
    const saving = bestAlt - leaseNetTotal;

    (document.getElementById('out-saving') as HTMLElement).textContent = (saving >= 0 ? '+' : '') + money(saving);
    const bar = document.getElementById('savings-bar')! as HTMLElement;
    bar.style.background = saving >= 0
      ? 'linear-gradient(135deg,#1E3A8A,#1D4ED8)'
      : 'linear-gradient(135deg,#7F1D1D,#DC2626)';
    (document.getElementById('savings-label') as HTMLElement).textContent =
      cashEnabled ? `Estimated Saving (Novated ${altLabel})` : 'Estimated Saving with Novated Lease';
  }

  ['fy','salary','vehicle-price','km','ev-range','charge-freq','ev-eff','petrol-eff','petrol-price','home-rate','public-rate','home-ratio','other-costs',
   'lease-term','residual','finance-rate','admin-fee','setup-fee','cash-available','offset-rate'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calc);
  });
  (document.getElementById('enable-cash') as HTMLInputElement).addEventListener('change', calc);

  calc();
</script>
