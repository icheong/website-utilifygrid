---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'area-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Area Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter an area value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="area-input">Area</label>
        <input id="area-input" type="number" value="1000" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="area-unit">Unit</label>
        <select id="area-unit" class="select-themed" style="min-width:10rem;">
          <option value="m2" selected>square meter (m²)</option>
          <option value="cm2">square centimeter (cm²)</option>
          <option value="mm2">square millimeter (mm²)</option>
          <option value="km2">square kilometer (km²)</option>
          <option value="ha">hectare (ha)</option>
          <option value="in2">square inch (in²)</option>
          <option value="ft2">square foot (ft²)</option>
          <option value="yd2">square yard (yd²)</option>
          <option value="ac">acre (ac)</option>
          <option value="mi2">square mile (mi²)</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Area Converter Overview</h2>
    <p class="seo-p">
      This area converter computes precise conversions between 10 metric and imperial area units entirely within your browser. Built with modern vanilla JavaScript, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your measurements, whether you are working in real estate, construction, agriculture, or land surveying.
    </p>
    <p class="seo-p">
      The converter supports the most commonly used area units across metric and imperial systems: square millimeters, square centimeters, square meters, square kilometers, and hectares for metric; square inches, square feet, square yards, acres, and square miles for imperial/US customary. Results are dynamically formatted based on magnitude, switching between fixed notation, locale-formatted numbers, and scientific notation as appropriate.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Real estate and property measurement', 'When buying or selling property, area measurements are essential for comparing value. A 200 m² house floor plan must be converted to 2,152.78 ft² for US buyers, or 0.0494 acres for land comparison. Real estate agents frequently convert between square meters and square feet when listing properties internationally. The quick-reference section helps visualise everyday areas like a parking space (12 m²), a typical bedroom (14 m²), or a city block (10,000 m²) for intuitive scale comparison.'],
        ['Construction and building planning', 'Builders and architects calculate floor areas, roof areas, and material coverage in different units depending on local standards. A concrete pour requiring 50 m² of coverage must be quoted in square feet (538.20 ft²) for US contractors. Flooring suppliers often specify coverage per unit — for example, a box of tiles covering 1.5 m² — requiring precise area conversion to determine how many boxes are needed for a 45 ft² room.'],
        ['Agriculture and land management', 'Farmers and land managers measure fields in hectares (metric) or acres (imperial). A 5-hectare vineyard equals approximately 12.355 acres. When comparing land parcels internationally, converting between hectares and acres is essential. A city council rezoning 2 hectares of agricultural land for residential development needs to communicate the area in acres (4.94 ac) for community consultation in imperial-using regions.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      The converter employs a hub-and-spoke conversion model using square meters as the universal base unit. Every supported area unit is defined by a fixed conversion factor relative to one square meter. To convert from unit A to unit B, the tool multiplies the input value by A's factor to obtain square meters, then divides by B's factor to obtain the target value. This approach guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">m2</code>, <code class="inline-code">ac</code>, <code class="inline-code">ha</code>) to its exact factor in square meters. Metric units use powers of 10 (e.g. <code class="inline-code">1 km² = 1,000,000 m²</code>, <code class="inline-code">1 ha = 10,000 m²</code>), while imperial/US customary units use internationally defined values.
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion:</strong> The input value is multiplied by the source unit's factor to convert to square meters. For example, converting 2 acres to square meters: <code class="inline-code">2 × 4046.8564 = 8093.7128 m²</code>. This intermediate result is an IEEE 754 double-precision floating-point number, which provides approximately 15 to 17 significant decimal digits of precision.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion:</strong> The square meter value is divided by the target unit's factor. Converting 8093.7128 m² to hectares: <code class="inline-code">8093.7128 / 10000 = 0.8094 ha</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>.
    </p>
    <p class="seo-p-sm">
      <strong>4. Dynamic formatting:</strong> The display format adapts to the magnitude of the result. Large values (1 billion or greater) use scientific notation. Values between 1,000 and 1 billion use locale-formatted numbers with 2 to 4 decimal places. Values between 0.001 and 1,000 use 6 to 8 decimal places. Values below 0.001 use scientific notation. This ensures readability across the full range from square millimeters to square miles.
    </p>
    <p class="seo-p-none">
      <strong>Exact vs. approximate factors:</strong> The metric factors are exact by definition: <code class="inline-code">1 km² = 1,000,000 m²</code>, <code class="inline-code">1 ha = 10,000 m²</code>. The hectare is defined as exactly 10,000 m², making it exact. Imperial/US customary units are derived from the international inch (2.54 cm exactly), so <code class="inline-code">1 acre = 43,560 ft² = 4046.8564224 m²</code> is also exact. Smaller units like square inches are derived by exact factors of 2 within the imperial system, though their square meter equivalents are rounded to 8 decimal places for display.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How many square feet are in a square meter?",
          a: "One square meter equals approximately 10.7639 square feet. This is the most common conversion when comparing metric and imperial room measurements. For example, a 100 m² apartment equals approximately 1,076.39 ft². When reading property listings from countries using the metric system, multiply the square meter value by 10.7639 to get the equivalent in square feet."
        },
        {
          q: "How many acres are in a hectare?",
          a: "One hectare equals approximately 2.47105 acres. Conversely, one acre equals about 0.4047 hectares. This conversion is widely used in agriculture and land measurement. A standard rugby field is approximately 1 hectare, while a US football field (including end zones) is about 1.32 acres. When comparing land parcels internationally, always verify which unit is being used."
        },
        {
          q: "What is a hectare?",
          a: "A hectare is a metric unit of area equal to 10,000 square meters (100m × 100m). It is commonly used for measuring agricultural land, forest areas, and city parks. A hectare is about the size of a standard rugby field or approximately 2.47 acres. The term 'hectare' combines the metric prefix 'hecto' (100) with 'are' (100 m²), literally meaning 100 ares."
        },
        {
          q: "How do you convert square meters to square feet?",
          a: "To convert square meters to square feet, multiply the area by 10.7639. For example, 100 m² equals 1,076.39 ft². To convert from square feet to square meters, divide by 10.7639. For quick mental estimates, multiply square meters by about 10.76 — a 50 m² room is roughly 538 ft². For precise calculations, use the full 10.7639 factor."
        },
        {
          q: "What unit is best for measuring a house?",
          a: "In most countries, house floor area is measured in square meters (m²). In the US and UK, square feet (ft²) is more common for residential property. For land plots, acres or hectares are typically used. A typical family home ranges from 150 to 300 m² (1,615 to 3,229 ft²). When comparing property sizes across different countries, always check which unit is being used."
        },
        {
          q: "How many square meters are in an acre?",
          a: "One acre equals exactly 4,046.8564224 square meters. This is a precise conversion factor derived from the definition of an acre as 43,560 square feet (with 1 foot = 0.3048 meters exactly). For quick estimates, one acre is roughly 4,047 m². An acre is about 76% of a hectare, or about 16 tennis courts."
        },
        {
          q: "What is the difference between an acre and a hectare?",
          a: "Both acres and hectares are used to measure land area, but they belong to different measurement systems. A hectare is a metric unit equal to exactly 10,000 m², while an acre is an imperial unit equal to exactly 4,046.856 m². One hectare is about 2.47 acres, making it roughly 2.5 times larger. Hectares are used in most countries worldwide, while acres remain common in the US, UK, and some Commonwealth nations."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to m² ────────────────────────────────────
  const TO_M2 = {
    mm2: 1e-6,
    cm2: 1e-4,
    m2:  1,
    km2: 1e6,
    ha:  10_000,
    in2: 0.00064516,
    ft2: 0.09290304,
    yd2: 0.83612736,
    ac:  4046.8564224,
    mi2: 2_589_988.110336,
  };

  const UNITS = [
    { id: 'mm2', label: 'mm²',  name: 'Square Millimeter', decimals: 4 },
    { id: 'cm2', label: 'cm²',  name: 'Square Centimeter', decimals: 4 },
    { id: 'm2',  label: 'm²',   name: 'Square Meter',      decimals: 4 },
    { id: 'km2', label: 'km²',  name: 'Square Kilometer',  decimals: 6 },
    { id: 'ha',  label: 'ha',   name: 'Hectare',           decimals: 4 },
    { id: 'in2', label: 'in²',  name: 'Square Inch',       decimals: 4 },
    { id: 'ft2', label: 'ft²',  name: 'Square Foot',       decimals: 4 },
    { id: 'yd2', label: 'yd²',  name: 'Square Yard',       decimals: 4 },
    { id: 'ac',  label: 'ac',   name: 'Acre',              decimals: 4 },
    { id: 'mi2', label: 'mi²',  name: 'Square Mile',       decimals: 6 },
  ];

  const input  = document.getElementById('area-input') as HTMLInputElement;
  const select = document.getElementById('area-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  // ── Quick-reference objects (stored in m²) ──────────────────────
  const REFS = [
    { name: 'Parking Space',  m2: 12 },
    { name: 'Typical Bedroom',m2: 14 },
    { name: 'Tennis Court',   m2: 260.87 },
    { name: 'Basketball Court',m2: 420 },
    { name: 'Soccer Pitch',   m2: 7_140 },
    { name: 'Football Field', m2: 5_351 },
    { name: 'Typical House Lot', m2: 800 },
    { name: 'City Block',     m2: 10_000 },
  ];

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
  }

  function update() {
    const val     = parseFloat(input.value);
    const fromUnit = select.value;
    const m2Val    = val * TO_M2[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = m2Val / TO_M2[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = r.m2 / TO_M2[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
