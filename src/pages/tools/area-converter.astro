---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'area-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Area Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter an area value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="area-input">Area</label>
        <input id="area-input" type="number" value="1000" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="area-unit">Unit</label>
        <select id="area-unit" class="select-themed" style="min-width:10rem;">
          <option value="m2" selected>square meter (m²)</option>
          <option value="cm2">square centimeter (cm²)</option>
          <option value="mm2">square millimeter (mm²)</option>
          <option value="km2">square kilometer (km²)</option>
          <option value="ha">hectare (ha)</option>
          <option value="in2">square inch (in²)</option>
          <option value="ft2">square foot (ft²)</option>
          <option value="yd2">square yard (yd²)</option>
          <option value="ac">acre (ac)</option>
          <option value="mi2">square mile (mi²)</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Convert Between Square Meters, Acres, Hectares, and Square Feet</h2>
    <p class="seo-p">
      Your estate agent in Sydney lists a block of land at 800 m². You are used to thinking in square feet from years in the US. Is this a quarter-acre suburban block or a cramped city lot? Enter 800, select m², and the converter shows 8611.13 ft², 0.08 hectares, 0.1977 acres, and every other equivalent in one click. The quick-reference strip at the bottom translates the area into familiar objects — a parking space at 12 m², a tennis court at 260 m² — so you can visualise the space before visiting the open house.
    </p>
    <p class="seo-p">
      The converter covers 10 units from square millimeters to square miles. A tiler quoting a bathroom renovation needs to convert a 3.5 m² floor area to square feet (37.67 ft²) for a client who only understands imperial. A farmer comparing two paddocks — one listed as 15 acres, the other as 6 hectares — can instantly see that the 6-hectare plot is larger at 14.83 acres. The copy button on each result means you can paste the number straight into a contract, spreadsheet, or planning application.
    </p>

    <h3 class="font-display seo-h3-sm">Real estate where square meters and square feet collide</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Comparing property listings across countries', 'A relocating family compares a 95 m² apartment in Berlin with a 1,200 ft² condo in Chicago. Converting the Berlin listing: 95 m² = 1022.57 ft². The Chicago condo is larger by about 178 ft² — roughly the size of a small bedroom. Without converting, the family might assume 95 m² is bigger because the number 95 is smaller than 1200, but that comparison is meaningless across different units.'],
        ['Flooring and tiling estimates', 'A contractor installing hardwood flooring in a 22 m² living room needs to order material by square feet. Converting gives 236.81 ft². Hardwood is sold in boxes of 20 ft², so the contractor needs 12 boxes (rounding up to account for cutting waste). A 5% error in the conversion — say, using 10.76 instead of 10.7639 — would underestimate by 0.87 ft², which at $8/ft² means about $7 wasted. Small errors compound when quoting large commercial projects.'],
        ['Land measurement for planning applications', 'A homeowner in the UK applies for planning permission to build an extension on 25 m² of garden. The local council requires the area in both m² and square feet for the public notice. Converting: 25 m² = 269.10 ft². The planning application must list both figures accurately — an incorrect conversion could delay approval or trigger an objection during the public consultation period.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/length-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Length Converter</a>
        <a href="/tools/volume-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Volume Converter</a>
        <a href="/tools/fuel-consumption-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Fuel Consumption Converter</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Area Converter Calculates Square Meters, Acres, and Hectares</h2>
    <p class="seo-p">
      Every unit in the converter is stored as a multiple of one square meter. When you enter 5 acres, the tool multiplies 5 by 4046.8564224 to get 20,234.282112 m², then divides by each target unit's factor. Because the conversion passes through square meters in a single step, there is no chain of intermediate conversions. The result for 1 acre to hectares is exactly 0.40468564224 ha — not a rounded approximation derived from converting through a third unit.
    </p>

    <h3 class="font-display seo-h3-sm">Why the acre factor has so many decimal places</h3>
    <p class="seo-p-sm">
      The acre is defined as exactly 43,560 square feet, and since the foot is defined as exactly 0.3048 meters (1959 International Yard and Pound Agreement), squaring that gives the acre's square meter value: 0.3048² × 43,560 = 4046.8564224 m². That 10-digit number is exact, not rounded. The hectare, by contrast, is a round 10,000 m² by definition — it was created in 1795 as part of the metric system, defined as a square with 100-meter sides.
    </p>
    <p class="seo-p-sm">
      The relationship between hectares and acres is fixed: 1 hectare = 2.47105381467165 acres (exact). A common mental shortcut is "1 hectare ≈ 2.5 acres," which is about 1.2% off. For a 100-hectare farm, that error amounts to 1.2 acres — roughly the size of a football pitch. For land valuations where an acre might be worth $10,000, that 1.2-acre error represents $12,000 in miscalculated land value.
    </p>

    <h3 class="font-display seo-h3-sm">The square-mile-to-acre relationship and why it matters</h3>
    <p class="seo-p-sm">
      One square mile equals exactly 640 acres. This comes from the US Public Land Survey System: a township is 6 miles × 6 miles = 36 square miles, and each square mile (a "section") is divided into 36 quarter-sections of 160 acres each. The number 640 is exact. When city planners in the US discuss zoning "one square mile" of land, they are talking about exactly 640 acres — about the size of a large ranch or a small town.
    </p>
    <p class="seo-p-none">
      The converter formats results dynamically: values below 0.001 and above 1 billion use scientific notation; values between 1,000 and 1 billion use locale-formatted numbers with 2-4 decimal places; values between 0.001 and 1,000 use 6-8 decimal places. This keeps the output readable whether you are converting square millimeters for a microchip layout or square miles for a land survey.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How many square feet are in 200 square meters?",
          a: "200 square meters equals exactly 2,152.78 ft². Multiply by 10.7639 to convert: 200 × 10.7639 = 2,152.78. For a quick mental estimate, multiply by 10.76 — 200 × 10.76 = 2,152 ft², which is close enough for property comparisons. The exact figure matters more in construction, where ordering flooring material based on an underestimate means a mid-project supply run."
        },
        {
          q: "How many acres is a football field?",
          a: "A US football field (including both end zones) is about 1.32 acres, or roughly 5,351 m². Without end zones, the playing surface is about 1.1 acres (4,047 m² — almost exactly 1 hectare). A football pitch (soccer field) varies by competition but is typically 0.7-0.8 acres. These references help visualise what an acre looks like: imagine a bit less than a football playing field."
        },
        {
          q: "Which unit should I use for my garden — square meters or square feet?",
          a: "It depends on where you live and what your suppliers use. In the UK, Australia, and most of Europe, garden plans use square meters. In the US, square feet is standard. If you are buying soil or turf by the bag, check what area the bag covers — most UK garden suppliers list m² coverage, while US suppliers list ft². A 10 m² garden bed is about 107.6 ft². Use whichever unit your supplier quotes to avoid conversion errors when ordering."
        },
        {
          q: "How do I convert land size from hectares to acres for a property sale?",
          a: "Multiply the hectare value by 2.47105. A 3-hectare property equals 7.413 acres. For quick estimates, multiply by 2.5 — that gives 7.5 acres, which is about 1.2% high. For a $50,000-per-acre property, that 0.087-acre overestimate translates to roughly $4,350 in valuation difference. For formal property transactions, always use the exact 2.47105 factor or this converter."
        },
        {
          q: "What is the difference between a hectare and an are?",
          a: "An are (a) is 100 square meters — a square with 10-meter sides. A hectare (ha) is 100 ares, or 10,000 m². The are is rarely used today, but the hectare remains the standard metric unit for land measurement. The prefix 'hecto' means 100, so 1 hectare = 100 ares. Think of an are as roughly the size of a small studio apartment (100 m²), and a hectare as 100 of those apartments laid out in a grid."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to m² ────────────────────────────────────
  const TO_M2 = {
    mm2: 1e-6,
    cm2: 1e-4,
    m2:  1,
    km2: 1e6,
    ha:  10_000,
    in2: 0.00064516,
    ft2: 0.09290304,
    yd2: 0.83612736,
    ac:  4046.8564224,
    mi2: 2_589_988.110336,
  };

  const UNITS = [
    { id: 'mm2', label: 'mm²',  name: 'Square Millimeter', decimals: 4 },
    { id: 'cm2', label: 'cm²',  name: 'Square Centimeter', decimals: 4 },
    { id: 'm2',  label: 'm²',   name: 'Square Meter',      decimals: 4 },
    { id: 'km2', label: 'km²',  name: 'Square Kilometer',  decimals: 6 },
    { id: 'ha',  label: 'ha',   name: 'Hectare',           decimals: 4 },
    { id: 'in2', label: 'in²',  name: 'Square Inch',       decimals: 4 },
    { id: 'ft2', label: 'ft²',  name: 'Square Foot',       decimals: 4 },
    { id: 'yd2', label: 'yd²',  name: 'Square Yard',       decimals: 4 },
    { id: 'ac',  label: 'ac',   name: 'Acre',              decimals: 4 },
    { id: 'mi2', label: 'mi²',  name: 'Square Mile',       decimals: 6 },
  ];

  const input  = document.getElementById('area-input') as HTMLInputElement;
  const select = document.getElementById('area-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  // ── Quick-reference objects (stored in m²) ──────────────────────
  const REFS = [
    { name: 'Parking Space',  m2: 12 },
    { name: 'Typical Bedroom',m2: 14 },
    { name: 'Tennis Court',   m2: 260.87 },
    { name: 'Basketball Court',m2: 420 },
    { name: 'Soccer Pitch',   m2: 7_140 },
    { name: 'Football Field', m2: 5_351 },
    { name: 'Typical House Lot', m2: 800 },
    { name: 'City Block',     m2: 10_000 },
  ];

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
  }

  function update() {
    const val     = parseFloat(input.value);
    const fromUnit = select.value;
    const m2Val    = val * TO_M2[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = m2Val / TO_M2[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = r.m2 / TO_M2[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
