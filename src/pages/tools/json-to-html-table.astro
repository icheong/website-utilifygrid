---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'json-to-html-table')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">JSON to HTML Table</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Convert a JSON array of objects into a sortable, filterable HTML table. Export to Excel.</p>

    <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:1rem;">
      <button id="btn-render" class="btn-primary" type="button">Render Table</button>
      <button id="btn-copy" class="btn-secondary" type="button">Copy Table</button>
      <button id="btn-export" class="btn-secondary" type="button">Export to Excel</button>
      <button id="btn-sample" class="btn-secondary" type="button">Sample</button>
      <button id="btn-clear" class="btn-secondary" type="button">Clear</button>
    </div>

    <textarea id="json-input" class="input-themed" rows="8"
      placeholder='[{"name":"Alice","age":30,"city":"Sydney"},{"name":"Bob","age":25,"city":"Melbourne"}]'
      style="width:100%; box-sizing:border-box; resize:vertical; border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; line-height:1.65; margin-bottom:0.875rem;"
    ></textarea>

    <div id="filter-row" style="display:none; flex-direction:column; gap:0.5rem; margin-bottom:0.75rem;">
      <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
        <input id="filter-input" type="text" class="input-themed" placeholder="Filter rows…"
          style="max-width:20rem; font-size:0.82rem; padding:0.5rem 0.75rem;" />
        <span style="font-size:0.72rem; color:var(--text-muted);">or use a JSONPath query ↓</span>
      </div>
      <div style="display:flex; align-items:center; gap:0.5rem;">
        <input id="jsonpath-input" type="text" class="input-themed" placeholder='JSONPath: $[*]?(@.age>25) or $.data[*]'
          style="flex:1; min-width:200px; font-family:'Fira Code',monospace; font-size:0.82rem; padding:0.5rem 0.75rem;" />
        <button id="btn-jsonpath-clear" class="btn-secondary" type="button" style="padding:0.5rem 0.875rem; font-size:0.82rem;">Reset</button>
      </div>
      <div id="jsonpath-status" style="font-size:0.75rem; color:var(--text-muted); display:none;"></div>
    </div>

    <div id="table-wrap" style="display:none; overflow-x:auto; border:1.5px solid var(--border); border-radius:0.625rem;">
      <table id="data-table" style="width:100%; border-collapse:collapse; font-size:0.82rem;">
        <thead id="table-head"></thead>
        <tbody id="table-body"></tbody>
      </table>
    </div>

    <div id="error-box" style="display:none; margin-top:0.625rem; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); border-radius:0.5rem; padding:0.75rem 1rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:#DC2626;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the JSON to HTML Table Converter</h2>
    <p class="seo-p">A product manager receives a JSON export of 200 customer records from the engineering team and needs to review the data without writing code or importing into a database. Paste the JSON array into the input area and click Render Table. The tool flattens nested objects using dot-notation column headers, renders every record as a table row, and enables sorting by clicking any column header. Filter the results by typing in the filter box to find specific customers, then click Copy Table to paste the visible rows into Excel for further analysis.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">API response inspection</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A developer debugging a REST API endpoint pastes the JSON array response into the tool and clicks Render Table. Sorting by columns like date or price reveals patterns or outliers immediately. The JSONPath query field lets you filter with expressions like $[*]?(@.status == "active") to isolate specific record subsets without writing SQL queries or opening a spreadsheet application.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Data cleaning for analysis</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">An analyst working with JSON exports from a database views the data in a table, applies a text filter to isolate records matching specific criteria, and copies the filtered subset as tab-separated values into Excel. The tool handles arrays of varying schemas gracefully, rendering empty cells for missing fields and computing the column set as the union of all keys across all objects.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Non-technical team data access</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A business analyst who receives JSON data from engineering renders it as a table without needing coding skills or database access. The sortable columns and text filter make it easy to find specific records, compare values across rows, and gain insights independently. Click Export to Excel to download a TSV file that opens directly in any spreadsheet application.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Database migration verification</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A data engineer migrating data between databases pastes a sample of exported JSON records into the tool to visually verify the migration output. Sorting by primary key columns and filtering for specific records confirms that the data was exported correctly. The table view makes it easy to spot missing fields, incorrect values, or schema mismatches before loading into the target database.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the JSON to HTML Table Converter Works</h2>
    <p class="seo-p">
      You paste a JSON array of objects and the tool renders each object as a table row. The first step is flattening: nested objects become flat columns using dot notation, so a property like address.city becomes its own column. This means deeply nested data fits neatly into a single table cell. Arrays are serialised as JSON strings in their cells.
    </p>
    <h3 class="seo-h3-sm">Column Discovery and Sorting</h3>
    <p class="seo-p">
      The column set is the union of all keys across every object in the array. This means objects with different schemas still produce a complete table: if one object has a "phone" field that another lacks, the missing cells are left empty. Clicking any column header sorts the table by that column, using numeric comparison for numbers and locale-aware string comparison for text. Empty values are pushed to the bottom regardless of sort direction.
    </p>
    <h3 class="seo-h3-sm">JSONPath Filtering</h3>
    <p class="seo-p-none">
      Before rendering, you can filter the data using a JSONPath expression. The evaluator supports dot access, bracket notation, array wildcards, recursive descent, and filter expressions with comparison operators. For example, <code class="inline-code">$[*]?(@.age&gt;25)</code> returns only objects where the age field exceeds 25. The table updates dynamically as you type the expression, showing only the matching subset of rows.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What JSON structure does the tool expect?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
           <p itemprop="text" class="seo-faq-a">The input must be a JSON array of objects. Each object becomes a row and its keys become column headers. Nested objects are flattened using dot notation, so address.city becomes a column. Arrays of primitive values like [1, 2, 3] are not supported as top-level input — wrap them in an object first.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I paste the table into Excel?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Click Copy Table to copy all visible rows to your clipboard as tab-separated values. Then open Excel, select the top-left cell, and paste. Excel automatically splits the values into columns using the tab character as a delimiter. This works with Google Sheets, LibreOffice Calc, and Numbers as well.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What JSONPath expressions can I use to filter rows?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The tool supports dot access like <code class="inline-code">$.users</code>, array wildcards like <code class="inline-code">$[*]</code>, recursive descent like <code class="inline-code">$..name</code>, and filter expressions like <code class="inline-code">$[*]?(@.age&gt;25)</code>. Filter operators include greater than, less than, equals, and not-equals, with both string and numeric comparison. The table updates as you type the expression.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What does the Export to Excel button actually download?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The export generates a tab-separated values file with a .tsv extension. This is a plain text format that Excel, Google Sheets, and LibreOffice Calc open natively with correct column alignment. For true binary .xlsx format with cell formatting and formulas, you would need a dedicated spreadsheet library like SheetJS.</p>
        </div>
      </div>

      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
        class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What happens when different objects have different keys?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The column set is computed as the union of all keys across every object. If object A has a "phone" field that object B lacks, the table still shows a "phone" column — B just gets an empty cell in that column. This makes the tool tolerant of sparse or evolving data schemas, which is common when inspecting real-world API responses.</p>
        </div>
      </div>

    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLE = JSON.stringify([
    { name: "Alice", age: 30, city: "Sydney", role: "Developer" },
    { name: "Bob", age: 25, city: "Melbourne", role: "Designer" },
    { name: "Carol", age: 35, city: "Brisbane", role: "Manager" },
    { name: "Dave", age: 28, city: "Perth", role: "Developer" },
  ], null, 2);

  let allData: any[] = [];
  let rawData: any[] = [];
  let columns: string[] = [];
  let sortCol = -1;
  let sortAsc = true;

  // ── JSONPath evaluator (subset) ──────────────────────────────────────
  // Supports: $, $.key, $[0], $[*], $..key (recursive), $[?(@.key op val)]
  function jsonPathEval(obj: any, path: string): any[] {
    if (!path || path === '$') return [obj];

    const tokens = tokenizeJsonPath(path);
    let current: any[] = [obj];

    for (const token of tokens) {
      const next: any[] = [];
      for (const item of current) {
        if (token.type === 'dot' || token.type === 'bracket') {
          if (token.value === '*') {
            if (Array.isArray(item)) next.push(...item);
            else if (typeof item === 'object' && item !== null) next.push(...Object.values(item));
          } else {
            const val = item?.[token.value];
            if (val !== undefined) next.push(val);
          }
        } else if (token.type === 'recursive') {
          collectRecursive(item, token.value, next);
        } else if (token.type === 'filter') {
          if (Array.isArray(item)) {
            item.forEach((el, idx) => {
              if (evalFilter(el, token.expr, idx)) next.push(el);
            });
          }
        } else if (token.type === 'index') {
          if (Array.isArray(item)) {
            const idx = token.value === '*' ? item : [item[parseInt(token.value)]];
            if (token.value === '*') next.push(...item);
            else if (item[parseInt(token.value)] !== undefined) next.push(item[parseInt(token.value)]);
          }
        }
      }
      current = next;
    }
    return current;
  }

  function tokenizeJsonPath(path: string): any[] {
    const tokens: any[] = [];
    let i = path.startsWith('$') ? 1 : 0;
    while (i < path.length) {
      if (path[i] === '.') {
        if (path[i + 1] === '.') { tokens.push({ type: 'recursive', value: '' }); i += 2; continue; }
        i++;
        let key = '';
        while (i < path.length && path[i] !== '.' && path[i] !== '[') { key += path[i]; i++; }
        tokens.push({ type: 'dot', value: key });
      } else if (path[i] === '[') {
        i++;
        let inner = '';
        let depth = 1;
        while (i < path.length && depth > 0) {
          if (path[i] === '[') depth++;
          if (path[i] === ']') depth--;
          if (depth > 0) inner += path[i];
          i++;
        }
        if (inner.startsWith('?(')) {
          tokens.push({ type: 'filter', expr: inner.slice(2, -1) });
        } else if (/^\d+$/.test(inner) || inner === '*') {
          tokens.push({ type: 'index', value: inner });
        } else {
          tokens.push({ type: 'bracket', value: inner.replace(/^["']|["']$/g, '') });
        }
      } else {
        let key = '';
        while (i < path.length && path[i] !== '.' && path[i] !== '[') { key += path[i]; i++; }
        tokens.push({ type: 'dot', value: key });
      }
    }
    return tokens;
  }

  function collectRecursive(obj: any, key: string, result: any[]): void {
    if (obj === null || typeof obj !== 'object') return;
    if (key === '*') { result.push(...Object.values(obj)); }
    else if (obj[key] !== undefined) result.push(obj[key]);
    for (const v of Object.values(obj)) { if (typeof v === 'object' && v !== null) collectRecursive(v, key, result); }
  }

  function evalFilter(item: any, expr: string, _idx: number): boolean {
    // Supports: @.key>val, @.key<val, @.key==val, @.key!=val, @.key>=val, @.key<=val
    const m = expr.match(/@\.(\w+)\s*(>=|<=|!=|==|>|<)\s*(.+)/);
    if (!m) return false;
    const field = m[1], op = m[2];
    let rawVal: any = item?.[field];
    let cmpVal: any = m[3].trim().replace(/^["']|["']$/g, '');
    if (rawVal === undefined) return false;
    if (typeof rawVal === 'number') { cmpVal = Number(cmpVal); }
    switch (op) {
      case '>':  return rawVal > cmpVal;
      case '<':  return rawVal < cmpVal;
      case '>=': return rawVal >= cmpVal;
      case '<=': return rawVal <= cmpVal;
      case '==': return rawVal == cmpVal;
      case '!=': return rawVal != cmpVal;
    }
    return false;
  }

  // ── Flatten / render ─────────────────────────────────────────────────
  function flattenObj(obj: any, prefix = ''): Record<string, any> {
    const result: Record<string, any> = {};
    for (const [k, v] of Object.entries(obj)) {
      const key = prefix ? `${prefix}.${k}` : k;
      if (v !== null && typeof v === 'object' && !Array.isArray(v)) {
        Object.assign(result, flattenObj(v, key));
      } else if (Array.isArray(v)) {
        result[key] = JSON.stringify(v);
      } else {
        result[key] = v;
      }
    }
    return result;
  }

  function buildTable(data: any[]) {
    allData = data.map(obj => flattenObj(obj));
    columns = [...new Set(allData.flatMap(obj => Object.keys(obj)))];

    const thead = document.getElementById('table-head')!;
    thead.innerHTML = '<tr>' + columns.map((c, i) =>
      `<th data-col="${i}" style="padding:0.6rem 0.75rem; text-align:left; font-weight:600; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-muted); background:var(--bg-surface-2); border-bottom:1.5px solid var(--border); cursor:pointer; user-select:none; white-space:nowrap; transition:color 0.15s;" onmouseover="this.style.color='var(--text-primary)'" onmouseout="this.style.color='var(--text-muted)'">${escHtml(c)}</th>`
    ).join('') + '</tr>';

    renderRows(allData);

    // Sort headers
    thead.querySelectorAll('th').forEach(th => {
      th.addEventListener('click', () => {
        const col = parseInt(th.dataset.col!);
        if (sortCol === col) sortAsc = !sortAsc; else { sortCol = col; sortAsc = true; }
        allData.sort((a, b) => {
          const va = a[columns[col]] ?? '';
          const vb = b[columns[col]] ?? '';
          const na = Number(va), nb = Number(vb);
          if (va === '' && vb !== '') return 1;
          if (vb === '' && va !== '') return -1;
          if (!isNaN(na) && !isNaN(nb) && va !== '' && vb !== '') return sortAsc ? na - nb : nb - na;
          return sortAsc ? String(va).localeCompare(String(vb)) : String(vb).localeCompare(String(va));
        });
        renderRows(allData);
      });
    });
  }

  function renderTable() {
    const raw = (document.getElementById('json-input') as HTMLTextAreaElement).value;
    const errBox = document.getElementById('error-box')!;
    const tableWrap = document.getElementById('table-wrap')!;
    const filterRow = document.getElementById('filter-row')!;
    errBox.style.display = 'none';
    tableWrap.style.display = 'none';
    filterRow.style.display = 'none';
    if (!raw.trim()) return;

    try {
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed) || parsed.length === 0) {
        errBox.textContent = 'Input must be a non-empty JSON array of objects.';
        errBox.style.display = 'block';
        return;
      }
      if (parsed.length > 0 && typeof parsed[0] !== 'object') {
        errBox.textContent = 'Array elements must be objects for table display.';
        errBox.style.display = 'block';
        return;
      }

      rawData = parsed;
      buildTable(rawData);
      tableWrap.style.display = 'block';
      filterRow.style.display = 'flex';
    } catch (e: any) {
      errBox.textContent = e.message;
      errBox.style.display = 'block';
    }
  }

  function renderRows(data: any[]) {
    const tbody = document.getElementById('table-body')!;
    const statusEl = document.getElementById('jsonpath-status')!;
    statusEl.style.display = data.length !== allData.length || data.length !== rawData.length ? 'block' : 'none';
    if (data.length !== rawData.length) statusEl.textContent = `Showing ${data.length} of ${rawData.length} rows`;
    tbody.innerHTML = data.map((row, i) =>
      '<tr style="border-bottom:1px solid var(--border); transition:background 0.1s;" onmouseover="this.style.background=\'var(--bg-surface-2)\'" onmouseout="this.style.background=\'transparent\'">' +
      columns.map(c =>
        `<td style="padding:0.5rem 0.75rem; color:var(--text-primary); font-size:0.82rem; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${row[c] !== undefined && row[c] !== null ? escHtml(String(row[c])) : ''}</td>`
      ).join('') + '</tr>'
    ).join('');
  }

  function escHtml(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

  // ── Copy table to clipboard ──────────────────────────────────────────
  async function copyTable() {
    const btn = document.getElementById('btn-copy')!;
    if (!allData.length) return;
    const header = columns.join('\t');
    const rows = allData.map(row => columns.map(c => String(row[c] ?? '').replace(/[\t\n\r]/g, ' ')).join('\t'));
    const tsv = [header, ...rows].join('\n');
    try {
      await navigator.clipboard.writeText(tsv);
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = 'Copy Table'; }, 2000);
    } catch {
      // Fallback for older browsers
      const ta = document.createElement('textarea');
      ta.value = tsv;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = 'Copy Table'; }, 2000);
    }
  }

  // ── Wire up event listeners ──────────────────────────────────────────
  document.getElementById('btn-render')!.addEventListener('click', renderTable);
  document.getElementById('btn-copy')!.addEventListener('click', copyTable);
  document.getElementById('btn-sample')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = SAMPLE;
    renderTable();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = '';
    document.getElementById('table-wrap')!.style.display = 'none';
    document.getElementById('filter-row')!.style.display = 'none';
    document.getElementById('error-box')!.style.display = 'none';
    document.getElementById('jsonpath-status')!.style.display = 'none';
    (document.getElementById('jsonpath-input') as HTMLInputElement).value = '';
    rawData = [];
    allData = [];
  });
  document.getElementById('filter-input')!.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase();
    // Clear JSONPath when text filter is used
    if (q) (document.getElementById('jsonpath-input') as HTMLInputElement).value = '';
    const source = rawData.length ? rawData : allData;
    const filtered = q ? source.filter(row => {
      const flat = flattenObj(row);
      return Object.values(flat).some(v => String(v ?? '').toLowerCase().includes(q));
    }) : source;
    buildTable(filtered);
  });
  document.getElementById('jsonpath-input')!.addEventListener('input', (e) => {
    const path = (e.target as HTMLInputElement).value.trim();
    const errBox = document.getElementById('error-box')!;
    errBox.style.display = 'none';
    if (!path || !rawData.length) { buildTable(rawData); return; }
    try {
      const results = jsonPathEval(rawData, path);
      if (results.length === 0) {
        errBox.textContent = 'JSONPath returned no results. Check your query syntax.';
        errBox.style.display = 'block';
        return;
      }
      if (typeof results[0] === 'object' && results[0] !== null) {
        buildTable(results);
      } else {
        buildTable(results.map((v, i) => ({ index: i, value: v })));
      }
    } catch {
      errBox.style.display = 'none';
    }
  });
  document.getElementById('btn-jsonpath-clear')!.addEventListener('click', () => {
    (document.getElementById('jsonpath-input') as HTMLInputElement).value = '';
    (document.getElementById('filter-input') as HTMLInputElement).value = '';
    document.getElementById('jsonpath-status')!.style.display = 'none';
    document.getElementById('error-box')!.style.display = 'none';
    buildTable(rawData);
  });
  document.getElementById('btn-export')!.addEventListener('click', () => {
    if (!allData.length) return;
    const header = columns.join('\t');
    const rows = allData.map(row => columns.map(c => {
      const val = String(row[c] ?? '');
      return val.replace(/[\t\n\r]/g, ' ');
    }).join('\t'));
    const tsv = [header, ...rows].join('\n');
    const blob = new Blob([tsv], { type: 'text/tab-separated-values' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'data.tsv';
    document.body.appendChild(a);
    a.click();
    setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 100);
  });
</script>
