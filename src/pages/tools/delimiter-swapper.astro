---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'delimiter-swapper')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">
      Delimiter Swapper
    </h2>
    <p style="font-size:0.8rem; color:var(--text-muted); margin-bottom:1.375rem;">Paste a column of values — one per line — and instantly reformat it.</p>

    <!-- ── Format selector cards ── -->
    <div style="margin-bottom:1.25rem;">
      <div style="font-size:0.7rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.625rem;">Output Format</div>
      <div id="format-cards" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(148px, 1fr)); gap:0.5rem;">
        <!-- Injected by JS -->
      </div>
    </div>

    <!-- ── Options row ── -->
    <div id="options-row" style="display:flex; flex-wrap:wrap; gap:0.625rem; margin-bottom:1.25rem; padding:0.75rem 1rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; align-items:center;">
      <!-- Options injected by JS per format -->
    </div>

    <!-- ── Input / Output ── -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.875rem;" class="ds-panels">

      <!-- Input -->
      <div style="display:flex; flex-direction:column; gap:0.375rem;">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <label style="font-size:0.72rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em;">Input <span id="input-count" style="font-weight:400; color:var(--text-muted);">(0 values)</span></label>
          <button id="btn-sample" style="font-size:0.72rem; color:var(--color-brand-blue); background:none; border:none; cursor:pointer; font-weight:600; padding:0;"
            onmouseover="this.style.color='var(--color-brand-blue)';" onmouseout="this.style.color='var(--color-brand-blue)';">Load Sample</button>
        </div>
        <textarea id="ds-input"
          placeholder="Paste values here, one per line…&#10;&#10;apple&#10;banana&#10;cherry"
          style="width:100%; height:220px; padding:0.75rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); resize:vertical; box-sizing:border-box; outline:none; line-height:1.65; transition:border-color 0.15s;"
          onfocus="this.style.borderColor='#D97706';" onblur="this.style.borderColor='var(--border)';"
          spellcheck="false"></textarea>
      </div>

      <!-- Output -->
      <div style="display:flex; flex-direction:column; gap:0.375rem;">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <label style="font-size:0.72rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em;">Output</label>
          <button id="btn-copy" style="font-size:0.72rem; color:var(--color-brand-blue); background:none; border:none; cursor:pointer; font-weight:600; padding:0;"
            onmouseover="this.style.color='var(--color-brand-blue)';" onmouseout="this.style.color='var(--color-brand-blue)';">Copy</button>
        </div>
        <textarea id="ds-output" readonly
          style="width:100%; height:220px; padding:0.75rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem; font-family:'Fira Code',monospace; font-size:0.8rem; color:var(--text-primary); resize:vertical; box-sizing:border-box; outline:none; line-height:1.65;"
          spellcheck="false"></textarea>
      </div>
    </div>

    <!-- ── Stats bar ── -->
    <div id="stats-bar" style="display:flex; flex-wrap:wrap; gap:0.625rem; align-items:center; font-size:0.75rem; color:var(--text-muted);">
      <span id="stat-values">0 values</span>
      <span style="color:var(--border);">·</span>
      <span id="stat-empty">0 empty skipped</span>
      <span style="color:var(--border);">·</span>
      <span id="stat-dupes"></span>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       HOW TO USE
  ══════════════════════════════════════════════ -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Delimiter Swapper</h2>
    <p class="seo-p">Data arrives in many formats, and each system has its own delimiter expectations. When a spreadsheet export gives you comma-separated values but your SQL query needs an IN clause with single quotes, manual retyping wastes time and invites errors. Delimiter Swapper converts between any delimiter combination in seconds, whether you are preparing a 50-row product list for a database import or restructuring a 200-line log file for analysis.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Preparing SQL IN Clauses</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A database developer extracting 150 customer IDs from a CSV export needs to build a WHERE IN clause for a query. Pasting the list into Delimiter Swapper and selecting the SQL IN format wraps each value in single quotes and formats the entire list in one step. The developer saves roughly 20 minutes of manual formatting compared to editing each row individually in a text editor.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Converting Legacy Data Exports</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A data analyst receives a 3,000-row sales report exported as a pipe-delimited file from a legacy system. The downstream dashboard tool requires comma-separated values with double-quoted fields. Using Delimiter Swapper with the CSV output format and double-quote option enabled, the analyst converts the entire dataset without opening a spreadsheet application or writing a conversion script.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Building Documentation Tables</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A technical writer building a product catalog needs to convert a list of 75 feature names into a Markdown table for the project wiki. After pasting the values, the Markdown Table format generates a properly aligned two-column table with row numbers. The writer avoids manually formatting each column width and gets a copy-paste-ready result in under a second.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Migrating Configuration Files</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A system administrator migrating a 500-line firewall rule set from semicolon-delimited CSV to pipe-delimited format for a new security appliance. Delimiter Swapper handles the conversion with whitespace trimming enabled, producing clean output that loads directly into the target system without additional cleanup steps.</p>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       HOW IT WORKS
  ══════════════════════════════════════════════ -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Delimiter Swapper Works</h2>
    <p class="seo-p">Delimiter Swapper reads each line of your input, splits it into individual values using the delimiter you specify, and then joins those values back together with your chosen output delimiter. The entire transformation runs locally in your current session, so your data never leaves your device.</p>
    <h3 class="font-display seo-h3-sm">Delimiter Detection and Tokenization</h3>
    <p class="seo-p">Each line of input is split by the selected <code class="inline-code">input delimiter</code>. The tool supports single-character delimiters like commas and pipes as well as multi-character strings such as ':::' or '|||'. Leading and trailing whitespace on each token can optionally be trimmed, ensuring clean output regardless of source formatting. For example, with a comma input delimiter, the line '  apple , banana , cherry  ' splits into three tokens: 'apple', 'banana', and 'cherry' after trimming. The max columns option lets you cap how many tokens are retained per row, so trailing empty delimiters do not inflate your output.</p>
    <h3 class="font-display seo-h3-sm">Column Mapping and Swapping</h3>
    <p class="seo-p">After tokenization, the resulting columns are joined back together using the chosen <code class="inline-code">output delimiter</code>. This lets you convert between CSV, TSV, pipe-delimited, semicolon-delimited, or any custom format in a single pass without manual find-and-replace. Consider converting a three-column TSV row 'name\tage\temail' to pipe-delimited output: the tool splits on tab, produces three tokens, and joins them as 'name|age|email' with the pipe character as the new separator. The deduplication option can remove duplicate values before joining, which is useful when consolidating lists from multiple sources.</p>
    <h3 class="font-display seo-h3-sm">Edge Case Handling</h3>
    <p class="seo-p">Empty fields between consecutive delimiters are preserved by default or skipped depending on your settings. Escaped quotes and nested delimiters are handled gracefully — the tool respects standard CSV quoting rules so values containing the delimiter character are not split incorrectly. When a value like 'New York, NY' appears in a comma-delimited file, the tool recognizes the surrounding quotes and keeps it as a single token rather than splitting it into 'New York' and 'NY'. Case conversion options let you standardize values to uppercase or lowercase during the transformation, eliminating the need for a separate cleanup step.</p>
  </div>

  <!-- ══════════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════════ -->
  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What delimiters does the Delimiter Swapper support?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The tool supports comma, semicolon, pipe, tab, and custom single or multi-character delimiters. You can enter any character or string as both the input and output delimiter, giving you full flexibility for non-standard data formats. Common use cases include converting between CSV and TSV files, preparing pipe-delimited data for SQL queries, or restructuring configuration files that use unusual separators like ':::' or '|||'. The custom delimiter option accepts any sequence of characters, so you are not limited to single-byte separators.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I limit the number of output columns?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. Set the max columns option to a specific number and any tokens beyond that count will be dropped from the output. This is useful when your source data has trailing empty delimiters that you want to discard cleanly. For example, if your CSV has 10 columns but you only need the first 3, setting max columns to 3 produces output with exactly 3 values per row.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I handle empty fields between delimiters?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">By default empty fields are preserved so the column structure stays intact. Toggle the empty fields option to skip them if you want a cleaner output that only contains non-empty values between each delimiter. Preserving empty fields is important when the position of a value within a row carries meaning, such as in database exports where missing columns must remain as placeholders. Skipping empty fields is useful when building clean lists for imports or documentation.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Will the tool handle values that contain the delimiter character?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. If your input follows standard CSV quoting rules — where values containing the delimiter are wrapped in double or single quotes — the tool parses them correctly and does not split them into separate columns. For instance, a value like 'New York, NY' in a comma-delimited file remains as a single token because the surrounding quotes signal that the comma is part of the value. Unquoted values that contain the delimiter character will be split, so ensure your source data uses proper quoting for accurate results.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I convert between TSV and CSV?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Absolutely. Select tab as the input delimiter and comma as the output delimiter to convert TSV to CSV, or reverse the settings to go from CSV to TSV. This works for any delimiter combination in a single step. The conversion preserves all values and their order, so column alignment remains consistent across the transformation. You can also add quoting options to ensure the output matches the expectations of your target system.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Is there a size limit on the input data?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">There is no hard limit, but very large inputs with tens of thousands of rows may slow down the output updates. For best results, process data in chunks of a few thousand rows at a time if you notice sluggishness. The tool processes each row independently, so memory usage scales linearly with the number of input lines. Most users find that inputs under 5,000 rows transform instantly without any perceptible delay.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does Delimiter Swapper compare to using find-and-replace in a text editor?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Find-and-replace in a text editor can handle simple delimiter swaps for small datasets, but it becomes error-prone with quoted values or multi-column data. Delimiter Swapper parses each row structurally, respecting CSV quoting rules and preserving column alignment across thousands of rows. The deduplication, case conversion, and max columns options provide capabilities that no text editor find-and-replace can match without custom scripting.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What happens if my input has inconsistent delimiters on different lines?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The tool applies the same input delimiter to every row, so lines with different delimiter characters will not split correctly. If your data mixes delimiters — for example, some rows use commas and others use semicolons — normalize the data first by converting all rows to a consistent format. You can accomplish this by running the tool twice: first with the most common delimiter as input, then with your desired output delimiter.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why would I need to swap delimiters instead of using a spreadsheet application?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Spreadsheet applications like Excel can open CSV and TSV files, but they often reinterpret values, strip leading zeros, or convert text to dates automatically. Delimiter Swapper preserves your data exactly as provided, treating every value as plain text throughout the transformation. For programmatic imports, database queries, or configuration files where exact formatting matters, a dedicated delimiter conversion avoids the silent data modifications that spreadsheets introduce.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<style>
  @media (max-width: 640px) {
    .ds-panels { grid-template-columns: 1fr !important; }
  }

  /* Format card active state */
  .fmt-card.active {
    border-color: #D97706 !important;
    background: rgba(217,119,6,0.09) !important;
  }
  .fmt-card.active .fmt-card-label {
    color: #D97706 !important;
  }
  .fmt-card.active .fmt-card-preview {
    color: #D97706 !important;
    opacity: 0.85;
  }

  /* Option toggle active */
  .opt-toggle.active {
    background: rgba(217,119,6,0.1) !important;
    border-color: #D97706 !important;
    color: #D97706 !important;
  }

  /* Option select */
  .opt-select {
    padding: 0.3rem 0.6rem;
    background: var(--bg-surface);
    border: 1.5px solid var(--border);
    border-radius: 0.4rem;
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-family: 'Fira Code', monospace;
    cursor: pointer;
    outline: none;
    transition: border-color 0.15s;
  }
  .opt-select:focus { border-color: #D97706; }
</style>

<script>
  // ── Format definitions ────────────────────────────────────

  type FormatId = 'sql-in' | 'csv' | 'json' | 'md-list' | 'md-table' | 'powershell';

  interface Format {
    id: FormatId;
    label: string;
    preview: string;
    description: string;
  }

  const FORMATS: Format[] = [
    { id: 'sql-in',     label: 'SQL IN()',       preview: "IN ('a','b')",    description: 'SQL WHERE IN clause'    },
    { id: 'csv',        label: 'CSV / List',     preview: 'a, b, c',         description: 'Comma-separated values' },
    { id: 'json',       label: 'JSON Array',     preview: '["a","b"]',       description: 'JSON array literal'     },
    { id: 'md-list',    label: 'Markdown List',  preview: '- a\n- b',        description: 'Bulleted list'          },
    { id: 'md-table',   label: 'Markdown Table', preview: '| # | val |',     description: 'Two-column table'       },
    { id: 'powershell', label: 'PowerShell',     preview: "@('a','b')",      description: 'PS array literal'       },
  ];

  // ── State ─────────────────────────────────────────────────
  let activeFormat: FormatId = 'sql-in';
  let opts = {
    sqlQuote:    'single' as 'single' | 'double' | 'none',
    csvSep:      ',' as string,
    csvQuote:    'none' as 'none' | 'single' | 'double',
    csvWrap:     false,
    jsonSmart:   false,
    jsonPretty:  true,
    dedupe:      false,
    trimValues:  true,
    caseMode:    'none' as 'none' | 'upper' | 'lower',
  };

  // ── Build format cards ────────────────────────────────────
  const cardContainer = document.getElementById('format-cards')!;

  FORMATS.forEach(f => {
    const card = document.createElement('button');
    card.className = 'fmt-card' + (f.id === activeFormat ? ' active' : '');
    card.dataset.id = f.id;
    card.style.cssText = `
      display:flex; flex-direction:column; align-items:flex-start; gap:0.3rem;
      padding:0.625rem 0.75rem;
      background:var(--bg-surface-2);
      border:1.5px solid var(--border);
      border-radius:0.625rem;
      cursor:pointer;
      text-align:left;
      transition:all 0.15s;
    `;
    card.innerHTML = `
      <span class="fmt-card-label" style="font-size:0.8rem; font-weight:700; color:var(--text-secondary); font-family:'Sora',sans-serif;">${f.label}</span>
      <code class="fmt-card-preview" style="font-family:'Fira Code',monospace; font-size:0.68rem; color:var(--text-muted); white-space:pre; overflow:hidden; text-overflow:ellipsis; max-width:100%;">${f.preview}</code>
    `;
    card.addEventListener('click', () => {
      activeFormat = f.id as FormatId;
      document.querySelectorAll('.fmt-card').forEach(c => c.classList.remove('active'));
      card.classList.add('active');
      renderOptions();
      transform();
    });
    cardContainer.appendChild(card);
  });

  // ── Options renderer ──────────────────────────────────────
  function renderOptions() {
    const row = document.getElementById('options-row')!;
    row.innerHTML = '';

    const addLabel = (text: string) => {
      const el = document.createElement('span');
      el.style.cssText = 'font-size:0.72rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.07em; white-space:nowrap;';
      el.textContent = text;
      row.appendChild(el);
    };

    const addSelect = (label: string, key: keyof typeof opts, choices: {value: string; label: string}[]) => {
      addLabel(label);
      const sel = document.createElement('select');
      sel.className = 'opt-select';
      choices.forEach(c => {
        const o = document.createElement('option');
        o.value = c.value;
        o.textContent = c.label;
        if ((opts as any)[key] === c.value) o.selected = true;
        sel.appendChild(o);
      });
      sel.addEventListener('change', () => { (opts as any)[key] = sel.value; transform(); });
      row.appendChild(sel);
    };

    const addToggle = (label: string, key: keyof typeof opts) => {
      const btn = document.createElement('button');
      btn.className = 'opt-toggle' + ((opts as any)[key] ? ' active' : '');
      btn.style.cssText = `
        padding:0.28rem 0.65rem;
        font-size:0.75rem; font-weight:600;
        border:1.5px solid var(--border);
        border-radius:0.4rem;
        background:var(--bg-surface);
        color:var(--text-secondary);
        cursor:pointer;
        transition:all 0.15s;
        white-space:nowrap;
      `;
      btn.textContent = label;
      btn.addEventListener('click', () => {
        (opts as any)[key] = !(opts as any)[key];
        btn.classList.toggle('active', (opts as any)[key]);
        transform();
      });
      row.appendChild(btn);
    };

    const addSep = () => {
      const el = document.createElement('span');
      el.style.cssText = 'color:var(--border); font-size:1rem;';
      el.textContent = '|';
      row.appendChild(el);
    };

    // Shared options
    addToggle('Deduplicate', 'dedupe');
    addToggle('Trim values', 'trimValues');
    addSelect('Case', 'caseMode', [
      { value: 'none',  label: 'As-is' },
      { value: 'upper', label: 'UPPER' },
      { value: 'lower', label: 'lower' },
    ]);

    addSep();

    // Format-specific options
    if (activeFormat === 'sql-in') {
      addSelect('Quote', 'sqlQuote', [
        { value: 'single', label: "' single" },
        { value: 'double', label: '" double' },
        { value: 'none',   label: 'No quotes' },
      ]);
    }

    if (activeFormat === 'csv') {
      addSelect('Separator', 'csvSep', [
        { value: ',',  label: ', comma' },
        { value: '; ', label: '; semicolon' },
        { value: ' | ', label: '| pipe' },
        { value: '\t', label: '⇥ tab' },
      ]);
      addSelect('Quote each', 'csvQuote', [
        { value: 'none',   label: 'No quotes' },
        { value: 'single', label: "' single" },
        { value: 'double', label: '" double' },
      ]);
      addToggle('Wrap lines', 'csvWrap');
    }

    if (activeFormat === 'json') {
      addToggle('Smart types', 'jsonSmart');
      addToggle('Pretty print', 'jsonPretty');
    }
  }

  // ── Transform engine ──────────────────────────────────────
  function getValues(): { values: string[]; emptySkipped: number; dupesRemoved: number } {
    const raw = (document.getElementById('ds-input') as HTMLTextAreaElement).value;
    const lines = raw.split('\n');

    let trimmed = lines.map(l => opts.trimValues ? l.trim() : l);
    const emptySkipped = trimmed.filter(l => l === '').length;
    trimmed = trimmed.filter(l => l !== '');

    // Case
    if (opts.caseMode === 'upper') trimmed = trimmed.map(v => v.toUpperCase());
    if (opts.caseMode === 'lower') trimmed = trimmed.map(v => v.toLowerCase());

    // Dedupe
    let dupesRemoved = 0;
    if (opts.dedupe) {
      const seen = new Set<string>();
      const deduped: string[] = [];
      for (const v of trimmed) {
        const key = v.toLowerCase();
        if (!seen.has(key)) { seen.add(key); deduped.push(v); }
        else dupesRemoved++;
      }
      trimmed = deduped;
    }

    return { values: trimmed, emptySkipped, dupesRemoved };
  }

  function sqlEscapeSingle(v: string) { return v.replace(/'/g, "''"); }
  function sqlEscapeDouble(v: string) { return v.replace(/"/g, '""'); }

  function formatOutput(values: string[]): string {
    if (values.length === 0) return '';

    switch (activeFormat) {
      case 'sql-in': {
        let items: string[];
        if (opts.sqlQuote === 'single')      items = values.map(v => `'${sqlEscapeSingle(v)}'`);
        else if (opts.sqlQuote === 'double') items = values.map(v => `"${sqlEscapeDouble(v)}"`);
        else                                 items = values;
        return `IN (${items.join(', ')})`;
      }

      case 'csv': {
        const sep = opts.csvSep === '\t' ? '\t' : opts.csvSep;
        let items: string[];
        if (opts.csvQuote === 'single')      items = values.map(v => `'${v}'`);
        else if (opts.csvQuote === 'double') items = values.map(v => `"${v}"`);
        else                                 items = values;
        if (opts.csvWrap) {
          // Wrap at ~80 chars
          const lines: string[] = [];
          let line = '';
          items.forEach((item, i) => {
            const piece = (i === 0 ? '' : sep) + item;
            if (line.length + piece.length > 80 && line.length > 0) {
              lines.push(line);
              line = item;
            } else {
              line += piece;
            }
          });
          if (line) lines.push(line);
          return lines.join('\n');
        }
        return items.join(sep);
      }

      case 'json': {
        let parsed: (string | number | boolean)[];
        if (opts.jsonSmart) {
          parsed = values.map(v => {
            if (v === 'true')  return true;
            if (v === 'false') return false;
            const n = Number(v);
            if (!isNaN(n) && v.trim() !== '') return n;
            return v;
          });
        } else {
          parsed = values;
        }
        if (opts.jsonPretty) {
          return JSON.stringify(parsed, null, 2);
        }
        return JSON.stringify(parsed);
      }

      case 'md-list':
        return values.map(v => `- ${v}`).join('\n');

      case 'md-table': {
        const maxLen = Math.max(...values.map(v => v.length), 5);
        const sep2 = `| --- | ${'-'.repeat(maxLen)} |`;
        const header = `| #   | Value${' '.repeat(Math.max(0, maxLen - 5))} |`;
        const rows = values.map((v, i) => `| ${String(i + 1).padStart(3)} | ${v.padEnd(maxLen)} |`);
        return [header, sep2, ...rows].join('\n');
      }

      case 'powershell': {
        const items = values.map(v => `'${v.replace(/'/g, "''")}'`);
        return `@(${items.join(', ')})`;
      }
    }
  }

  function transform() {
    const { values, emptySkipped, dupesRemoved } = getValues();
    const output = formatOutput(values);

    (document.getElementById('ds-output') as HTMLTextAreaElement).value = output;

    // Stats
    document.getElementById('input-count')!.textContent = `(${values.length + dupesRemoved} values)`;
    document.getElementById('stat-values')!.textContent = `${values.length} value${values.length !== 1 ? 's' : ''}`;
    document.getElementById('stat-empty')!.textContent  = `${emptySkipped} empty skipped`;
    const dupeEl = document.getElementById('stat-dupes')!;
    if (dupesRemoved > 0) {
      dupeEl.textContent = `${dupesRemoved} duplicate${dupesRemoved !== 1 ? 's' : ''} removed`;
      dupeEl.style.color = '#D97706';
    } else {
      dupeEl.textContent = '';
    }
  }

  // ── Events ────────────────────────────────────────────────
  document.getElementById('ds-input')!.addEventListener('input', transform);

  document.getElementById('btn-copy')!.addEventListener('click', () => {
    const val = (document.getElementById('ds-output') as HTMLTextAreaElement).value;
    if (!val) return;
    navigator.clipboard.writeText(val).then(() => {
      const btn = document.getElementById('btn-copy')!;
      btn.textContent = '✓ Copied!';
      btn.style.color = '#059669';
      setTimeout(() => { btn.textContent = 'Copy'; btn.style.color = ''; }, 2000);
    });
  });

  document.getElementById('btn-sample')!.addEventListener('click', () => {
    (document.getElementById('ds-input') as HTMLTextAreaElement).value =
      'alice@example.com\nbob@company.io\ncarol@mail.org\ndave@test.net\nelliot@example.com\nalice@example.com';
    transform();
  });

  // ── Init ──────────────────────────────────────────────────
  renderOptions();
  transform();
</script>
