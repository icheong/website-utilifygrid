---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'pdf-reverse-pages')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Reverse Pages</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Instantly flip the page order of a PDF. Preview before and after, then download.</p>

    <div id="drop-zone" style="border:2px dashed var(--border);border-radius:0.875rem;padding:2.5rem 1rem;text-align:center;cursor:pointer;transition:border-color 0.2s,background 0.2s;background:var(--bg-surface);">
      <p style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:0.4rem;">Drop a PDF file here</p>
      <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:0.75rem;">or click to browse</p>
      <input id="file-input" type="file" accept=".pdf" style="display:none;" />
      <button id="browse-btn" class="btn-secondary" type="button" style="font-size:0.82rem;">Browse File</button>
    </div>

    <div id="workspace" style="display:none;margin-top:1.25rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
        <p class="seo-p-sm" style="font-weight:600;">
          <span id="doc-name"></span> — <span id="doc-pages" style="font-weight:400;"></span>
        </p>
        <button id="reset-btn" class="btn-secondary" type="button" style="font-size:0.7rem;padding:0.25rem 0.6rem;">New File</button>
      </div>

      <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:start;margin-bottom:1.25rem;">
        <div>
          <p class="tool-label" style="margin-bottom:0.5rem;text-align:center;">Original Order</p>
          <div id="before-pages" style="display:flex;flex-wrap:wrap;gap:0.4rem;justify-content:center;"></div>
        </div>
        <div style="display:flex;align-items:center;justify-content:center;padding-top:2rem;">
          <svg width="40" height="24" viewBox="0 0 40 24" fill="none">
            <path d="M4 12h28m0 0l-8-8m8 8l-8 8" stroke="var(--color-brand-blue)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <p style="font-size:0.75rem;font-weight:600;color:#10B981;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;text-align:center;">Reversed Order</p>
          <div id="after-pages" style="display:flex;flex-wrap:wrap;gap:0.4rem;justify-content:center;"></div>
        </div>
      </div>

      <div style="text-align:center;">
        <button id="reverse-btn" class="btn-primary" type="button" style="font-size:0.95rem;padding:0.7rem 2rem;">Reverse &amp; Download</button>
        <p id="status" style="font-size:0.78rem;color:var(--text-muted);margin-top:0.5rem;display:none;"></p>
      </div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Reverse Pages Overview</h2>
    <p class="seo-p">
      This PDF reverse pages tool flips the page order of an entire PDF document — entirely within your browser. Built with <strong>pdf-lib</strong> (for page reordering) and <strong>PDF.js</strong> (for thumbnail rendering), both running via WebAssembly and Canvas, the tool provides complete privacy and zero server latency. Whether you are reversing a back-to-front scanned document, creating a mirrored version for double-sided printing, or reordering pages for a specific workflow, the reversal is performed client-side with full lossless quality preservation.
    </p>
    <p class="seo-p">
      The tool displays a side-by-side before/after comparison: the original page order appears on the left, and the reversed order appears on the right with green-bordered thumbnails. This visual preview lets you confirm the exact reversal before downloading. The reversed PDF is created by copying pages from the source document in reverse index order — a pure metadata operation with zero quality loss.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        [`Back-to-front scan correction`, `When scanning a stack of double-sided documents with an auto-feed scanner, the pages often come out in reverse order — the last page appears first. A 20-page contract scanned back-to-front produces pages in reverse sequence. This tool reverses the entire document in one click, restoring the correct reading order. The before/after comparison lets you verify the reversal before downloading.`],
        [`Double-sided printing preparation`, `For duplex printing, the page order depends on whether your printer flips on the long edge or short edge. Some workflows require reversing the page order before printing to achieve correct double-sided output. This tool creates a reversed version that can be printed directly, saving manual reordering time for multi-page documents.`],
        [`Presentation and slideshow reversal`, `Presenters sometimes need to reverse slide order for specific delivery formats — for example, when a slide deck needs to be read from back to front in a handout format, or when preparing a reversed version for a specific audience. The visual comparison lets you confirm the exact page sequence before committing to the reversal.`]
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Technical Architecture and Reversal Process</h2>
    <p class="seo-p">
      The tool uses a two-library architecture: <strong>PDF.js</strong> (Mozilla’s PDF renderer) handles page thumbnail rendering by drawing each page onto an HTML Canvas element, while <strong>pdf-lib</strong> (a lightweight PDF manipulation library) performs the actual reversal by copying pages from the source document in reverse index order. Both libraries execute entirely in the browser via WebAssembly — no server round-trips occur at any stage.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Reversal Process</h3>
    <p class="seo-p-sm">
      <strong>1. File ingestion:</strong> When the user drops or selects a PDF file, the file is read as an <code class="inline-code">ArrayBuffer</code> using the File API. The file data is held in browser memory — no network requests are made. The file is validated as a PDF by checking the file type and attempting to parse it with PDF.js.
    </p>
    <p class="seo-p-sm">
      <strong>2. Thumbnail generation:</strong> PDF.js renders every page at 15-20% scale (depending on total page count) onto temporary Canvas elements. The original order thumbnails are displayed on the left with standard borders, and the reversed order thumbnails are displayed on the right with green borders. This provides a visual comparison of the reversal.
    </p>
    <p class="seo-p-sm">
      <strong>3. Reversal execution:</strong> When the user clicks “Reverse &amp; Download”, pdf-lib creates a new empty <code class="inline-code">PDFDocument</code>. It generates a reversed index array (e.g., for 5 pages: [4, 3, 2, 1, 0]) and copies pages from the source document using this reversed index. The pages are added to the new document in the reversed order.
    </p>
    <p class="seo-p-none">
      <strong>Feature preservation:</strong> The reversal copies page content objects byte-for-byte from the source, preserving visual fidelity. Text, images, vectors, bookmarks, and annotations are preserved. Embedded fonts are kept without re-encoding. The reversal is a pure reordering operation — it changes the page sequence without modifying any page content.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "Is my file uploaded to a server?",
          a: "No. All processing happens entirely in your browser using WebAssembly (pdf-lib) and Canvas (PDF.js). Your file never leaves your device — there is no server upload at any point. This provides complete privacy for confidential documents."
        },
        {
          q: "Does reversing reduce PDF quality?",
          a: "No. Pages are copied losslessly in reverse order — text, vectors, images, and bookmarks are preserved byte-for-byte. There is no re-encoding, recompression, or rasterisation. The reversed PDF has exactly the same visual quality as the original."
        },
        {
          q: "Can I reverse only some pages?",
          a: "This tool reverses all pages in the document. To reverse a subset, first extract the pages you want with the Split PDF tool, then reverse the extracted file using this tool."
        },
        {
          q: "What does the before/after comparison show?",
          a: "The left panel shows thumbnails in the original page order (1, 2, 3, ...) with standard borders. The right panel shows the same thumbnails in reversed order (N, N-1, ..., 2, 1) with green borders. This visual preview lets you confirm the exact reversal before downloading."
        },
        {
          q: "Does reversal affect bookmarks?",
          a: "Bookmarks from the source PDF are preserved but their page references may become invalid after reversal. The bookmark hierarchy is copied to the new document, but the linked page numbers may point to incorrect positions. You may need to manually adjust bookmarks in a dedicated PDF editor after reversal."
        },
        {
          q: "Can I reverse a password-protected PDF?",
          a: "This tool can reverse PDFs encrypted without a user password (they open freely but restrict editing). PDFs requiring a password to open cannot be processed because pdf-lib cannot decrypt them without the password."
        },
        {
          q: "Is there a page count limit?",
          a: "There is no artificial limit. You can reverse PDFs with any number of pages. For very large documents (hundreds of pages), the thumbnail rendering may take a few seconds because PDF.js must draw each page onto a Canvas element. The reversal operation itself is nearly instant regardless of page count."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
<script is:inline src="https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.min.js"></script>

<script>
(function () {
  const { PDFDocument } = (window as any).PDFLib;
  const pdfjsLib = (window as any).pdfjsLib;
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.worker.min.js';

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const browseBtn = document.getElementById('browse-btn')!;
  const workspace = document.getElementById('workspace')!;
  const docName = document.getElementById('doc-name')!;
  const docPages = document.getElementById('doc-pages')!;
  const resetBtn = document.getElementById('reset-btn')!;
  const beforePages = document.getElementById('before-pages')!;
  const afterPages = document.getElementById('after-pages')!;
  const reverseBtn = document.getElementById('reverse-btn')!;
  const statusEl = document.getElementById('status')!;

  let pdfBytes: ArrayBuffer | null = null;
  let pdfDoc: any = null;
  let totalPages = 0;

  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.style.borderColor = 'var(--color-brand-blue)'; });
  dropZone.addEventListener('dragleave', () => { dropZone.style.borderColor = ''; });
  dropZone.addEventListener('drop', e => { e.preventDefault(); dropZone.style.borderColor = ''; if (e.dataTransfer!.files.length) loadFile(e.dataTransfer!.files[0]); });
  browseBtn.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('click', e => { if (e.target === dropZone || e.target === browseBtn) fileInput.click(); });
  fileInput.addEventListener('change', () => { if (fileInput.files.length) loadFile(fileInput.files[0]); fileInput.value = ''; });
  resetBtn.addEventListener('click', () => { pdfBytes = null; pdfDoc = null; workspace.style.display = 'none'; dropZone.style.display = ''; });

  async function loadFile(file: File) {
    if (file.type !== 'application/pdf') return;
    pdfBytes = await file.arrayBuffer();
    pdfDoc = await pdfjsLib.getDocument({ data: pdfBytes.slice(0) }).promise;
    totalPages = pdfDoc.numPages;
    docName.textContent = file.name.replace(/\.pdf$/i, '');
    docPages.textContent = totalPages + ' page' + (totalPages > 1 ? 's' : '');
    dropZone.style.display = 'none';
    workspace.style.display = '';
    await renderComparison();
  }

  async function renderComparison() {
    beforePages.innerHTML = '';
    afterPages.innerHTML = '';
    const scale = totalPages > 10 ? 0.15 : 0.2;

    for (let i = 1; i <= totalPages; i++) {
      const page = await pdfDoc.getPage(i);
      const viewport = page.getViewport({ scale });
      const canvas = document.createElement('canvas');
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      canvas.style.cssText = `width:${totalPages > 10 ? 55 : 70}px;height:auto;border:1px solid var(--border);border-radius:4px;background:#fff;`;
      await page.render({ canvasContext: canvas.getContext('2d')!, viewport }).promise;
      const wrap = document.createElement('div');
      wrap.style.cssText = 'text-align:center;flex-shrink:0;';
      const num = document.createElement('div');
      num.style.cssText = 'font-size:0.55rem;color:var(--text-muted);margin-top:0.15rem;';
      num.textContent = 'P.' + i;
      wrap.appendChild(canvas);
      wrap.appendChild(num);
      beforePages.appendChild(wrap);
    }

    const indices = Array.from({ length: totalPages }, (_, i) => i + 1).reverse();
    for (const origNum of indices) {
      const page = await pdfDoc.getPage(origNum);
      const viewport = page.getViewport({ scale });
      const canvas = document.createElement('canvas');
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      canvas.style.cssText = `width:${totalPages > 10 ? 55 : 70}px;height:auto;border:1px solid #10B981;border-radius:4px;background:#fff;`;
      await page.render({ canvasContext: canvas.getContext('2d')!, viewport }).promise;
      const wrap = document.createElement('div');
      wrap.style.cssText = 'text-align:center;flex-shrink:0;';
      const num = document.createElement('div');
      num.style.cssText = 'font-size:0.55rem;color:#10B981;font-weight:600;margin-top:0.15rem;';
      num.textContent = 'P.' + origNum;
      wrap.appendChild(canvas);
      wrap.appendChild(num);
      afterPages.appendChild(wrap);
    }
  }

  reverseBtn.addEventListener('click', async () => {
    reverseBtn.setAttribute('disabled', '');
    reverseBtn.textContent = 'Reversing\u2026';
    try {
      const srcDoc = await PDFDocument.load(pdfBytes!);
      const newDoc = await PDFDocument.create();
      const indices = Array.from({ length: totalPages }, (_, i) => i).reverse();
      const copied = await newDoc.copyPages(srcDoc, indices);
      copied.forEach(p => newDoc.addPage(p));
      const bytes = await newDoc.save();
      const blob = new Blob([bytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = 'reversed.pdf'; a.click();
      URL.revokeObjectURL(url);
      statusEl.style.display = ''; statusEl.style.color = '#10B981'; statusEl.textContent = 'Downloaded reversed.pdf (' + totalPages + ' pages in reverse order).';
    } catch (e: any) { statusEl.style.display = ''; statusEl.style.color = '#EF4444'; statusEl.textContent = 'Error: ' + e.message; }
    finally { reverseBtn.removeAttribute('disabled'); reverseBtn.textContent = 'Reverse & Download'; }
  });
})();
</script>
