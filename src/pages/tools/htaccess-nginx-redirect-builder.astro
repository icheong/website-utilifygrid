---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'htaccess-nginx-redirect-builder')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Redirect Rule Builder</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Source URL / Path</label>
        <input id="source" type="text" value="/old-page" placeholder="/old-page or /blog/(.*)$"
          class="input-themed"
          style="font-family:'Fira Code',monospace;"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Destination URL</label>
        <input id="dest" type="text" value="/new-page" placeholder="/new-page or https://example.com/$1"
          class="input-themed"
          style="font-family:'Fira Code',monospace;"/>
      </div>
    </div>

    <div style="display:flex; gap:1rem; margin-bottom:1.25rem;">
      <div style="flex:1;">
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Redirect Type</label>
        <select id="type" class="select-themed">
          <option value="301">301 Permanent</option>
          <option value="302">302 Temporary</option>
          <option value="307">307 Temporary (preserve method)</option>
          <option value="308">308 Permanent (preserve method)</option>
        </select>
      </div>
      <div style="flex:1;">
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Server</label>
        <div style="display:flex; gap:0.5rem;">
          <button id="btn-htaccess" onclick="setServer('htaccess')" class="toggle-btn active" style="flex:1;">.htaccess</button>
          <button id="btn-nginx"    onclick="setServer('nginx')"    class="toggle-btn" style="flex:1;">Nginx</button>
        </div>
      </div>
    </div>

    <div class="result-card" style="overflow:hidden; padding:0;">
      <div style="background:var(--bg-surface-2); padding:0.625rem 1rem; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border);">
        <span id="output-label" style="font-family:'Fira Code',monospace; font-size:0.78rem; font-weight:600; color:var(--text-primary);">.htaccess</span>
        <button id="copy-btn" style="font-size:0.75rem; color:var(--text-muted); background:none; border:none; cursor:pointer; font-weight:600; padding:0;">Copy</button>
      </div>
      <pre id="output" style="margin:0; padding:1rem; font-family:'Fira Code',monospace; font-size:0.82rem; color:var(--text-primary); background:var(--bg-surface); white-space:pre-wrap; word-break:break-all; line-height:1.7;"></pre>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to use the Redirect Rule Builder</h2>
    <p class="seo-p">Enter the source path and destination URL. Select 301 for permanent or 302 for temporary redirect. Toggle between .htaccess (Apache) and Nginx config output. For wildcard redirects, use regex capture groups in the source and reference captures with $1 in the destination.</p>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:0.75rem;">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Site migration redirects</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">When restructuring URLs or migrating to a new domain, generate bulk 301 redirects to preserve SEO link equity and ensure visitors reach the correct pages.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Apache to Nginx conversion</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Switching web servers? Generate both .htaccess and Nginx config for the same redirect rules to compare syntax and ensure parity during migration.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Campaign URL management</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Create temporary 302 redirects for marketing campaigns, A/B tests, or maintenance pages that automatically expire when the campaign ends.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">301 vs 302 redirects explained</h2>
    <h3 class="font-display seo-h3-sm">301 Permanent</h3>
    <p class="seo-p">Tells browsers and search engines the page has moved permanently. Search engines transfer link equity to the new URL and update their index. Use for site migrations, URL restructures, and domain changes.</p>
    <h3 class="font-display seo-h3-sm">302 Temporary</h3>
    <p class="seo-p">Tells browsers the page has temporarily moved. Search engines keep the original URL indexed and do not transfer link equity. Use for A/B tests, maintenance pages, and temporary campaigns.</p>
    <h3 class="font-display seo-h3-sm">Query strings</h3>
    <p class="seo-p">To preserve query strings in .htaccess, add the QSA (query string append) flag. The generated code includes this where appropriate.</p>
    <h3 class="font-display seo-h3-sm">Server configuration</h3>
    <p class="seo-p">Apache .htaccess rules go in the site's root file inside an IfModule mod_rewrite.c block. Nginx rules go inside the server block in your site configuration, usually in /etc/nginx/sites-available/.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently asked questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Where do I put the .htaccess redirect rules?</h3>
        <p itemprop="text" class="seo-faq-a">Place them in your site's root .htaccess file inside an IfModule mod_rewrite.c block. Rules are processed in order, so more specific rules should come before catch-all rules.</p>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Will a 301 redirect hurt my SEO?</h3>
        <p itemprop="text" class="seo-faq-a">A properly implemented 301 preserves approximately 99% of link equity. Search engines update their index within days to weeks. Avoid redirect chains; always redirect directly to the final destination.</p>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I redirect an entire domain?</h3>
        <p itemprop="text" class="seo-faq-a" set:html="For Apache: use RewriteCond %{HTTP_HOST} matching the old domain and RewriteRule to the new domain. For Nginx: add a server block with server_name set to the old domain and a return 301 directive." />
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I test my redirects?</h3>
        <p itemprop="text" class="seo-faq-a">Use curl -I to check the HTTP response headers, or browser developer tools Network tab. Verify the correct status code (301/302) and Location header point to the intended destination.</p>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
  let server = 'htaccess';
  function setServer(s: string) {
    server = s;
    const ht = document.getElementById('btn-htaccess')!;
    const ng = document.getElementById('btn-nginx')!;
    ht.className = s === 'htaccess' ? 'toggle-btn active' : 'toggle-btn';
    ng.className = s === 'nginx'    ? 'toggle-btn active' : 'toggle-btn';
    (document.getElementById('output-label') as HTMLElement).textContent = s === 'htaccess' ? '.htaccess' : 'nginx.conf';
    generate();
  }
  (window as any).setServer = setServer;

  function generate() {
    const src  = (document.getElementById('source') as HTMLInputElement).value.trim();
    const dest = (document.getElementById('dest') as HTMLInputElement).value.trim();
    const type = (document.getElementById('type') as HTMLSelectElement).value;
    if (!src || !dest) { (document.getElementById('output') as HTMLElement).textContent = '# Fill in source and destination above'; return; }

    let out = '';
    if (server === 'htaccess') {
      const isRegex  = /[.*+?^${}()|[\]\\]/.test(src);
      const flag301  = type === '301' ? 'R=301,L' : type === '302' ? 'R=302,L' : type === '307' ? 'R=307,L' : 'R=308,L';
      out = `RewriteEngine On\nRewriteRule ^${src.replace(/^\//,'')}$ ${dest} [${flag301},QSA]`;
    } else {
      const isExact = !/[.*+?^${}()|[\]\\]/.test(src);
      if (isExact) {
        out = `location = ${src} {\n    return ${type} ${dest};\n}`;
      } else {
        out = `location ~ ^${src}$ {\n    return ${type} ${dest};\n}`;
      }
    }
    (document.getElementById('output') as HTMLElement).textContent = out;
  }

  document.getElementById('source')?.addEventListener('input', generate);
  document.getElementById('dest')?.addEventListener('input', generate);
  document.getElementById('type')?.addEventListener('change', generate);
  document.getElementById('copy-btn')?.addEventListener('click', () => {
    const out = (document.getElementById('output') as HTMLElement).textContent || '';
    navigator.clipboard.writeText(out).then(() => {
      const btn = document.getElementById('copy-btn')!;
      btn.textContent = '✓ Copied!';
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  });
  generate();
</script>
