---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'regex-toolkit')!;
---

<ToolLayout tool={tool}>

  <!-- ═══ INTERACTIVE TOOL ═══ -->
  <div slot="tool">

    <!-- Tab bar -->
    <div style="display:flex; gap:0; margin-bottom:1.25rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.75rem; padding:0.3rem; width:fit-content;">
      <button class="rtab active" data-tab="visualize">Visualize</button>
      <button class="rtab" data-tab="extract">Extract</button>
      <button class="rtab" data-tab="replace">Find &amp; Replace</button>
    </div>

    <!-- ═══ SHARED ZONE (Visualize & Extract) ═══ -->
    <div id="zone-shared">
      <!-- Pattern input -->
      <div style="display:flex;flex-direction:column;gap:.4rem;margin-bottom:.75rem;">
        <label for="rt-pattern" style="font-size:.8rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;">Regular Expression</label>
        <div style="display:flex;align-items:center;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:.6rem;overflow:hidden;">
          <span style="padding:.6rem .75rem;font-family:'Fira Code',monospace;font-size:1rem;color:var(--text-muted);border-right:1px solid var(--border);user-select:none;">/</span>
          <input id="rt-pattern" type="text" class="input-themed" value="^(\\w+)\\s+(foo|bar)\\s*$"
            style="flex:1;border:none;border-radius:0;background:transparent;font-family:'Fira Code',monospace;font-size:.95rem;padding:.6rem .5rem;"
            placeholder="e.g. \\b\\d{4}\\b" autocomplete="off" spellcheck="false" aria-label="Regular expression pattern">
          <span style="padding:.6rem .75rem;font-family:'Fira Code',monospace;font-size:1rem;color:var(--text-muted);border-left:1px solid var(--border);user-select:none;">/</span>
          <div style="display:flex;gap:2px;padding:.4rem .6rem;border-left:1px solid var(--border);">
            <button id="rt-flag-g" class="flag-btn active" title="Global" aria-pressed="true">g</button>
            <button id="rt-flag-i" class="flag-btn" title="Case insensitive" aria-pressed="false">i</button>
            <button id="rt-flag-m" class="flag-btn" title="Multiline" aria-pressed="false">m</button>
            <button id="rt-flag-s" class="flag-btn" title="Dot-all" aria-pressed="false">s</button>
          </div>
        </div>
      </div>

      <!-- Error banner -->
      <div id="rt-error" style="display:none;padding:.6rem 1rem;border-radius:.5rem;background:color-mix(in srgb,#ef4444 12%,transparent);border:1px solid color-mix(in srgb,#ef4444 30%,transparent);color:#f87171;font-family:'Fira Code',monospace;font-size:.85rem;margin-bottom:.75rem;"></div>

      <!-- Test string -->
      <div style="display:flex;flex-direction:column;gap:.4rem;margin-bottom:.5rem;">
        <label for="rt-test" style="font-size:.8rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;">Test String</label>
        <textarea id="rt-test" class="input-themed ctrl-select"
          style="font-family:'Fira Code',monospace;font-size:.9rem;resize:vertical;min-height:80px;padding:.65rem .85rem;line-height:1.6;"
          placeholder="Paste a string to test against the regex..."
          spellcheck="false">hello foo
world bar
test baz</textarea>
      </div>

      <!-- Match summary -->
      <div id="rt-summary" style="font-size:.85rem;color:var(--text-muted);min-height:1.4em;margin-bottom:.75rem;"></div>

      <!-- Highlighted output -->
      <div>
        <div style="font-size:.8rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.5rem;">Match Highlights</div>
        <div id="rt-highlight"
          style="font-family:'Fira Code',monospace;font-size:.9rem;line-height:1.8;padding:.85rem 1rem;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:.6rem;min-height:60px;white-space:pre-wrap;word-break:break-all;color:var(--text-primary);">
          Enter a pattern to see matches highlighted here.
        </div>
      </div>
    </div>

    <!-- ═══ VISUALIZE OUTPUT ═══ -->
    <div id="zone-visualize" style="margin-top:1rem;">
      <!-- Token Breakdown -->
      <div style="margin-bottom:1rem;">
        <div style="font-size:.8rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.75rem;">Token Breakdown</div>
        <div id="rt-token-flow" style="display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;min-height:48px;">
          <span style="color:var(--text-muted);font-size:.875rem;">Parse a regex above to see the token breakdown.</span>
        </div>
      </div>

      <!-- Capture Groups -->
      <div id="rt-groups-section" style="display:none;">
        <div style="font-size:.8rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.6rem;">Capture Groups</div>
        <div style="overflow-x:auto;">
          <table id="rt-groups-table" style="width:100%;border-collapse:collapse;font-size:.85rem;">
            <thead>
              <tr style="background:var(--bg-surface-2);">
                <th style="padding:.5rem .85rem;text-align:left;font-weight:600;color:var(--text-secondary);border:1px solid var(--border);">Group</th>
                <th style="padding:.5rem .85rem;text-align:left;font-weight:600;color:var(--text-secondary);border:1px solid var(--border);">Pattern</th>
                <th style="padding:.5rem .85rem;text-align:left;font-weight:600;color:var(--text-secondary);border:1px solid var(--border);">Match #1</th>
                <th style="padding:.5rem .85rem;text-align:left;font-weight:600;color:var(--text-secondary);border:1px solid var(--border);">Match #2</th>
                <th style="padding:.5rem .85rem;text-align:left;font-weight:600;color:var(--text-secondary);border:1px solid var(--border);">Match #3</th>
              </tr>
            </thead>
            <tbody id="rt-groups-body"></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ═══ EXTRACT OUTPUT ═══ -->
    <div id="zone-extract" style="display:none;margin-top:1rem;">
      <div style="display:flex;gap:0.75rem;margin-bottom:.875rem;">
        <div style="padding:.75rem 1.25rem;background:var(--bg-surface-2);border:1.5px solid var(--border);border-radius:0.625rem;">
          <span id="rt-ext-count" style="font-family:'Sora',sans-serif;font-size:1.25rem;font-weight:700;color:var(--text-primary);">0</span>
          <span style="font-size:.75rem;font-weight:600;color:var(--text-secondary);margin-left:.35rem;text-transform:uppercase;letter-spacing:.04em;">Matches</span>
        </div>
      </div>
      <div>
        <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.4rem;">
          <div style="font-size:.8rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;">Extracted Matches</div>
          <button id="rt-btn-copy-matches" style="font-size:.68rem;color:var(--text-primary);background:none;border:none;cursor:pointer;font-weight:700;padding:0;font-family:'Fira Code',monospace;transition:opacity .15s;" onmouseover="this.style.opacity='.7'" onmouseout="this.style.opacity='1'">copy</button>
        </div>
        <div id="rt-matches-list" style="display:flex;flex-wrap:wrap;gap:.375rem;"></div>
      </div>
    </div>

    <!-- ═══ REPLACE ZONE ═══ -->
    <div id="zone-replace" style="display:none;">
      <div style="display:grid;grid-template-columns:300px 1fr;gap:.875rem;margin-bottom:1rem;" class="rt-rbr-grid">

        <!-- LEFT: Rules panel -->
        <div style="display:flex;flex-direction:column;gap:0;min-width:0;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;">
            <span style="font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--text-muted);">Rules</span>
            <button id="rt-btn-add-rule"
              style="display:flex;align-items:center;gap:.3rem;padding:.25rem .6rem;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:.375rem;font-size:.72rem;font-weight:700;color:var(--text-primary);cursor:pointer;font-family:'Fira Code',monospace;transition:all .15s;">
              + Add rule
            </button>
          </div>
          <div id="rt-rules-list" style="display:flex;flex-direction:column;gap:.5rem;max-height:380px;overflow-y:auto;padding-right:.125rem;"></div>
          <div style="margin-top:.875rem;">
            <div style="font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:var(--text-muted);margin-bottom:.4rem;">Quick presets</div>
            <div style="display:flex;flex-direction:column;gap:.3rem;" id="rt-presets-list"></div>
          </div>
        </div>

        <!-- RIGHT: Editor panel -->
        <div style="display:flex;flex-direction:column;min-width:0;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;flex-wrap:wrap;gap:.5rem;">
            <div style="display:flex;align-items:center;gap:.75rem;">
              <span style="font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--text-muted);">Editor</span>
              <div style="display:flex;gap:0;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:.375rem;overflow:hidden;">
                <button id="rt-mode-source" class="rt-editor-mode active">source</button>
                <button id="rt-mode-result" class="rt-editor-mode">result</button>
              </div>
            </div>
            <div style="display:flex;gap:.5rem;align-items:center;">
              <span id="rt-rbr-match-count" style="font-size:.68rem;font-family:'Fira Code',monospace;color:var(--text-primary);font-weight:700;"></span>
              <button id="rt-btn-load-sample" style="font-size:.68rem;color:var(--text-primary);background:none;border:none;cursor:pointer;font-weight:700;padding:0;font-family:'Fira Code',monospace;">sample</button>
              <button id="rt-btn-clear-editor" style="font-size:.68rem;color:var(--text-muted);background:none;border:none;cursor:pointer;font-weight:700;padding:0;font-family:'Fira Code',monospace;">clear</button>
            </div>
          </div>
          <div style="position:relative;flex:1;">
            <textarea id="rt-source-editor"
              placeholder="Paste your text here. Add regex rules on the left — matches light up as you type."
              style="width:100%;height:360px;box-sizing:border-box;resize:vertical;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:.625rem;padding:.875rem;font-family:'Fira Code',monospace;font-size:.78rem;color:var(--text-primary);line-height:1.7;outline:none;transition:border-color .15s;display:block;"></textarea>
            <div id="rt-highlight-overlay" aria-hidden="true"
              style="position:absolute;inset:0;pointer-events:none;padding:.875rem;font-family:'Fira Code',monospace;font-size:.78rem;line-height:1.7;white-space:pre-wrap;word-break:break-all;overflow:hidden;border-radius:.625rem;color:transparent;display:none;"></div>
          </div>
          <div id="rt-result-panel" style="display:none;flex-direction:column;gap:.4rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:var(--text-muted);">Output</span>
              <button id="rt-btn-copy-result" style="font-size:.68rem;color:var(--text-primary);background:none;border:none;cursor:pointer;font-weight:700;padding:0;font-family:'Fira Code',monospace;">copy</button>
            </div>
            <textarea id="rt-result-output" readonly
              style="width:100%;height:360px;box-sizing:border-box;resize:vertical;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:.625rem;padding:.875rem;font-family:'Fira Code',monospace;font-size:.78rem;color:var(--text-primary);line-height:1.7;outline:none;cursor:default;display:block;"></textarea>
          </div>
        </div>
      </div>

      <!-- Stats footer -->
      <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
        <div id="rt-stats-box" style="display:flex;gap:.875rem;padding:.5rem .875rem;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:.5rem;font-family:'Fira Code',monospace;font-size:.7rem;flex-wrap:wrap;">
          <span>chars: <span id="rt-s-chars" style="color:var(--text-primary);">0</span></span>
          <span>lines: <span id="rt-s-lines" style="color:var(--text-primary);">0</span></span>
          <span>rules: <span id="rt-s-rules" style="color:var(--text-primary);">0</span></span>
          <span>matches: <span id="rt-s-matches" style="color:var(--text-primary);">0</span></span>
          <span>replacements: <span id="rt-s-replacements" style="color:var(--text-primary);">0</span></span>
        </div>
      </div>
    </div>

  </div>

  <!-- ═══ HOW TO USE ═══ -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >RegEx Toolkit — Visualize, Extract &amp; Find-and-Replace in One Tool</h2>
    <p class="text-secondary seo-p" >The <strong style="color:var(--text-primary)">RegEx Toolkit</strong> is a browser-based developer tool that combines three essential regex workflows into a single interface. Type any JavaScript-compatible regular expression into the shared pattern field, toggle flags (<code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">g</code> global, <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">i</code> case-insensitive, <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">m</code> multiline, <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">s</code> dot-all), and switch between three tabs: <strong style="color:var(--text-primary)">Visualize</strong> shows a token-by-token breakdown of your regex structure plus a capture groups table; <strong style="color:var(--text-primary)">Extract</strong> highlights matches and renders them as a chip list for quick scanning; <strong style="color:var(--text-primary)">Find &amp; Replace</strong> lets you stack multiple regex rules into an ordered pipeline with colour-coded highlights, back-reference substitution, and a source/result toggle. All processing runs entirely in your browser — zero server requests, complete privacy.</p>
  </div>

  <!-- ═══ HOW IT WORKS ═══ -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >Deep-Dive: How the RegEx Toolkit Engine Works</h2>

    <h3 class="font-display" style="font-size:1rem; font-weight:600; margin-bottom:0.5rem">Hand-Written Finite-State Tokenizer (Visualize Mode)</h3>
    <p class="text-secondary seo-p" >The Visualize tab uses a hand-written finite-state machine (no external regex library) that walks the input pattern character-by-character, tracking bracket depth, escape sequences, and lookahead context to classify every component into one of eleven token types: anchor, literal, class, quantifier, group, namedgroup, ncgroup, alternation, lookahead, escape, and dot. The tokenizer correctly handles nested groups by maintaining a depth counter, identifies quantifiers (<code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">*</code>, <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">+</code>, <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">?</code>, <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">&#123;n,m&#125;</code>) including lazy modifiers, and distinguishes capturing groups, non-capturing groups, named groups, and lookaheads/lookbehinds.</p>

    <h3 class="font-display" style="font-size:1rem; font-weight:600; margin-bottom:0.5rem">Real-Time Match Highlighting &amp; Extraction</h3>
    <p class="text-secondary seo-p" >All three modes use the browser's native <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">RegExp</code> engine (ECMAScript standard). The text is scanned via <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">matchAll()</code> when the global flag is active, or <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">exec()</code> otherwise; result indices are spliced into <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">&lt;mark&gt;</code> elements for instant visual feedback. Capture group extraction iterates each MatchResult, pulling numbered sub-groups (and named groups via <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">m.groups</code>) for the first three matches. Extract mode renders each match as a styled chip for quick scanning.</p>

    <h3 class="font-display" style="font-size:1rem; font-weight:600; margin-bottom:0.5rem">Multi-Rule Pipeline (Find &amp; Replace Mode)</h3>
    <p class="text-secondary seo-p" >The Replace tab supports stacking multiple regex rules, each with its own pattern, replacement, and flags. Rules execute in order — the output of rule N becomes the input of rule N+1. Each rule is assigned a unique highlight colour for the overlay. Replacements support back-references: <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">$1</code>, <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">$2</code> for numbered groups, <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">$&lt;name&gt;</code> for named groups, and special tokens <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">$&amp;</code> (whole match), <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">$`</code> (pre-match), <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">$'</code> (post-match). Quick presets load common transformations (strip HTML, collapse whitespace, etc.) as ready-to-use rules.</p>

    <h3 class="font-display" style="font-size:1rem; font-weight:600; margin-bottom:0.5rem">Token Rendering &amp; Scroll-Synced Overlay</h3>
    <p class="text-secondary seo-p-none" >Each token from the Visualize tokenizer carries <code style="background:var(--bg-surface-2); padding:0.1rem 0.4rem; border-radius:0.25rem; font-size:0.85rem">&#123; text, type, description &#125;</code>. The renderer maps the type to a CSS class that applies a distinct colour scheme, appends a small uppercase label, and joins chips with arrow connectors. In Replace mode, a positioned overlay div sits on top of the textarea, syncing scroll position to display colour-coded highlights without modifying the editable text. All processing happens client-side with zero network requests.</p>
  </div>

  <!-- ═══ FAQ ═══ -->
  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What regex flavour does this tool use?",
          "acceptedAnswer": { "@type": "Answer", "text": "JavaScript's built-in ECMAScript regex engine — the same one in Chrome, Firefox, and Safari. Supports lookaheads, lookbehinds, named capture groups, and Unicode property escapes. PCRE-specific syntax like (?P<name>) or possessive quantifiers is not supported." }
        },
        {
          "@type": "Question",
          "name": "What is the difference between the three tabs?",
          "acceptedAnswer": { "@type": "Answer", "text": "Visualize parses your regex into a colour-coded token breakdown and shows a capture groups table. Extract highlights matches in the text and lists them as chips. Find & Replace lets you stack multiple regex rules with ordered pipeline execution, colour-coded highlights, and back-reference substitution." }
        },
        {
          "@type": "Question",
          "name": "What does the s (dot-all) flag do?",
          "acceptedAnswer": { "@type": "Answer", "text": "By default, the dot metacharacter matches any character except newline. With the s flag enabled, dot matches every character including newlines, which is essential for matching patterns that span multiple lines." }
        },
        {
          "@type": "Question",
          "name": "What is a capture group?",
          "acceptedAnswer": { "@type": "Answer", "text": "A capture group is a section of a regex wrapped in parentheses. It groups the enclosed pattern so quantifiers apply to it as a unit, and captures the matched text so you can extract it programmatically. The Capture Groups table in Visualize mode shows what each group matched across the first three matches." }
        },
        {
          "@type": "Question",
          "name": "How do I use back-references in Find & Replace?",
          "acceptedAnswer": { "@type": "Answer", "text": "In the replacement field, use $1, $2, etc. to refer to text captured by numbered parentheses in your pattern. Use $<name> for named groups. Special tokens: $&amp; is the whole match, $` is text before the match, $' is text after. These follow the standard String.prototype.replace() substitution patterns." }
        },
        {
          "@type": "Question",
          "name": "Can rules conflict with each other in Find & Replace?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, and that is often intentional. Rules run in order, so the output of one feeds the next. If two rules match the same text, the first rule wins on the source text; the second sees the already-replaced output. Use the rule order to control execution priority." }
        },
        {
          "@type": "Question",
          "name": "Why does my regex show 'Invalid regular expression'?",
          "acceptedAnswer": { "@type": "Answer", "text": "Common causes: unmatched parentheses or brackets, an unescaped special character used as a literal, an invalid escape sequence, or a variable-length lookbehind in older engines. The error banner displays the exact engine error message to help you debug." }
        },
        {
          "@type": "Question",
          "name": "How do greedy and lazy quantifiers differ?",
          "acceptedAnswer": { "@type": "Answer", "text": "A greedy quantifier (*, +, &#123;2,5&#125;) matches as much text as possible before backtracking. A lazy quantifier (*?, +?, &#123;2,5&#125;?) matches as little as possible. The Visualize tab labels each quantifier as (greedy) or (lazy) in the token breakdown so you can see the matching strategy at a glance." }
        }
      ]
    }
    </script>

    <h2 class="font-display seo-h2-faq" >Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: 'What regex flavour does this tool use?',
          a: "JavaScript's ECMAScript regex engine — the same one in Chrome, Firefox, and Safari. Supports lookaheads, lookbehinds, named capture groups, and Unicode property escapes. PCRE-specific syntax like (?P<name>) or possessive quantifiers is not supported.",
        },
        {
          q: 'What is the difference between the three tabs?',
          a: 'Visualize parses your regex into a colour-coded token breakdown and shows a capture groups table. Extract highlights matches in the text and lists them as chips. Find & Replace lets you stack multiple regex rules with ordered pipeline execution, colour-coded highlights, and back-reference substitution.',
        },
        {
          q: "What does the s (dot-all) flag do?",
          a: "By default, the dot metacharacter matches any character except newline. With the s flag enabled, dot matches every character including newlines — essential for patterns that span multiple lines.",
        },
        {
          q: 'What is a capture group?',
          a: 'A capture group is a section of a regex wrapped in parentheses. It groups the enclosed pattern so quantifiers apply to it as a unit, and captures the matched text so you can extract it programmatically. The Capture Groups table in Visualize mode shows what each group matched across the first three matches.',
        },
        {
          q: 'How do I use back-references in Find & Replace?',
          a: 'In the replacement field, use $1, $2, etc. to refer to text captured by numbered parentheses. Use $<name> for named groups. Special tokens: $& is the whole match, $` is text before, $\' is text after. These follow the standard String.prototype.replace() patterns.',
        },
        {
          q: 'Can rules conflict with each other in Find & Replace?',
          a: 'Yes, and that is often intentional. Rules run in order, so the output of one feeds the next. If two rules match the same text, the first rule wins on the source text; the second sees the already-replaced output. Use the rule order to control execution priority.',
        },
        {
          q: 'Why does my regex show "Invalid regular expression"?',
          a: 'Common causes: unmatched parentheses or brackets, an unescaped special character used as a literal, an invalid escape sequence, or a variable-length lookbehind in older engines. The error banner displays the exact engine error message to help you debug.',
        },
        {
          q: 'How do greedy and lazy quantifiers differ?',
          a: 'A greedy quantifier (*, +, &#123;2,5&#125;) matches as much text as possible before backtracking. A lazy quantifier (*?, +?, &#123;2,5&#125;?) matches as little as possible. The Visualize tab labels each quantifier as (greedy) or (lazy) in the token breakdown.',
        },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

