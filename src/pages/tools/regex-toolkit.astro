</style>

<script>
(function () {
  // ══════════════════════════════════════════════════════════
  // SHARED STATE
  // ══════════════════════════════════════════════════════════
  let activeTab: 'visualize' | 'extract' | 'replace' = 'visualize';
  const flagState = { g: true, i: false, m: false, s: false };

  // DOM refs — shared
  const inpPattern = document.getElementById('rt-pattern') as HTMLInputElement;
  const inpTest    = document.getElementById('rt-test') as HTMLTextAreaElement;
  const errorEl    = document.getElementById('rt-error')!;
  const summaryEl  = document.getElementById('rt-summary')!;
  const hlOutput   = document.getElementById('rt-highlight')!;
  const flagBtns   = document.querySelectorAll('.flag-btn');

  // Tab zones
  const zoneShared   = document.getElementById('zone-shared')!;
  const zoneVisualize = document.getElementById('zone-visualize')!;
  const zoneExtract   = document.getElementById('zone-extract')!;
  const zoneReplace   = document.getElementById('zone-replace')!;

  // Visualize refs
  const tokenFlow  = document.getElementById('rt-token-flow')!;
  const groupsSec  = document.getElementById('rt-groups-section')!;
  const groupsBody = document.getElementById('rt-groups-body')!;

  // Extract refs
  const extCount    = document.getElementById('rt-ext-count')!;
  const matchesList = document.getElementById('rt-matches-list')!;

  // Copy matches button
  document.getElementById('rt-btn-copy-matches')!.addEventListener('click', () => {
    const chips = matchesList.querySelectorAll('code');
    if (!chips.length) return;
    const text = Array.from(chips).map(c => c.textContent).join('\n');
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('rt-btn-copy-matches')!;
      btn.textContent = '✓ copied';
      setTimeout(() => { btn.textContent = 'copy'; }, 2000);
    });
  });

  // ══════════════════════════════════════════════════════════
  // TAB SWITCHING
  // ══════════════════════════════════════════════════════════
  document.querySelectorAll('.rtab').forEach(btn => {
    btn.addEventListener('click', () => {
      activeTab = (btn as HTMLElement).dataset.tab as any;
      document.querySelectorAll('.rtab').forEach(b => b.classList.toggle('active', b === btn));
      zoneShared.style.display   = activeTab === 'replace' ? 'none' : 'block';
      zoneVisualize.style.display = activeTab === 'visualize' ? 'block' : 'none';
      zoneExtract.style.display   = activeTab === 'extract' ? 'block' : 'none';
      zoneReplace.style.display   = activeTab === 'replace' ? 'block' : 'none';
      update();
    });
  });

  // ══════════════════════════════════════════════════════════
  // SHARED: FLAGS
  // ══════════════════════════════════════════════════════════
  flagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const f = (btn as HTMLElement).id.replace('rt-flag-', '');
      (flagState as any)[f] = !(flagState as any)[f];
      btn.classList.toggle('active', (flagState as any)[f]);
      btn.setAttribute('aria-pressed', String((flagState as any)[f]));
      update();
    });
  });

  function buildFlags(): string {
    return Object.entries(flagState).filter(([,v]) => v).map(([k]) => k).join('');
  }

  function buildRegex(pattern: string): RegExp | null {
    const flags = buildFlags();
    try {
      const re = new RegExp(pattern, flags);
      errorEl.style.display = 'none';
      return re;
    } catch (e: any) {
      errorEl.textContent = '⚠ ' + e.message;
      errorEl.style.display = 'block';
      return null;
    }
  }

  function escHtml(s: string): string {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function escAttr(s: string): string {
    return s.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  // ══════════════════════════════════════════════════════════
  // SHARED: HIGHLIGHT MATCHES
  // ══════════════════════════════════════════════════════════
  function getMatches(re: RegExp | null, text: string): RegExpMatchArray[] {
    if (!re) return [];
    const flags = re.flags.includes('g') ? re.flags : re.flags + 'g';
    let globalRe: RegExp;
    try { globalRe = new RegExp(re.source, flags); } catch { return []; }
    return [...text.matchAll(globalRe)];
  }

  function highlightMatches(re: RegExp | null, text: string): number {
    if (!re) {
      hlOutput.textContent = text || 'Enter a pattern to see matches highlighted here.';
      summaryEl.textContent = '';
      return 0;
    }
    const matches = getMatches(re, text);
    if (!matches.length) {
      hlOutput.textContent = text || '';
      summaryEl.textContent = text ? '0 matches' : '';
      summaryEl.style.color = 'var(--text-muted)';
      return 0;
    }
    summaryEl.textContent = `${matches.length} match${matches.length !== 1 ? 'es' : ''} found`;
    summaryEl.style.color = '#10b981';
    let html = '', cursor = 0;
    for (const m of matches) {
      const start = m.index!;
      const end = start + m[0].length;
      html += escHtml(text.slice(cursor, start));
      html += `<mark class="rt-match">${escHtml(m[0])}</mark>`;
      cursor = end;
      if (m[0].length === 0) cursor++;
    }
    html += escHtml(text.slice(cursor));
    hlOutput.innerHTML = html || ' ';
    return matches.length;
  }

  // ══════════════════════════════════════════════════════════
  // VISUALIZE: TOKENIZER
  // ══════════════════════════════════════════════════════════
  function tokenise(pattern: string): Array<{text:string; type:string; description:string}> {
    const tokens: any[] = [];
    let i = 0;
    function peek(offset = 0) { return pattern[i + offset]; }
    function consume() { return pattern[i++]; }

    function readQuantifier(): string | null {
      const c = peek();
      if (!c) return null;
      if (c === '?' || c === '*' || c === '+') {
        i++;
        const lazy = peek() === '?' ? (i++, '?') : '';
        return c + lazy;
      }
      if (c === '{') {
        let j = i + 1, num = '';
        while (j < pattern.length && pattern[j] !== '}' && pattern[j] !== ',') num += pattern[j++];
        if (pattern[j] === ',') {
          j++; let num2 = '';
          while (j < pattern.length && pattern[j] !== '}') num2 += pattern[j++];
          if (pattern[j] === '}') { const lazy = pattern[j+1] === '?' ? (j++,'?') : ''; i = j+1; return `{${num},${num2}}`+lazy; }
        } else if (pattern[j] === '}') {
          const lazy = pattern[j+1] === '?' ? (j++,'?') : ''; i = j+1; return `{${num}}`+lazy;
        }
      }
      return null;
    }

    while (i < pattern.length) {
      const ch = consume();
      if (ch === '^' || ch === '$') { tokens.push({text:ch,type:'anchor',description:ch==='^'?'Start anchor':'End anchor'}); continue; }
      if (ch === '.') { const q=readQuantifier(); tokens.push({text:'.'+(q||''),type:'dot',description:'Any character'+(q?' '+describeQuantifier(q):'')}); continue; }
      if (ch === '|') { tokens.push({text:'|',type:'alternation',description:'Or'}); continue; }
      if (ch === '\\') { const next=consume()||''; const escaped='\\'+next; const q=readQuantifier(); tokens.push({text:escaped+(q||''),type:'escape',description:escapeDesc(next)+(q?' '+describeQuantifier(q):'')}); continue; }
      if (ch === '[') { let cls='['; while(i<pattern.length&&peek()!==']'){if(peek()==='\\'){cls+=consume();}cls+=consume();} cls+=consume()||''; const q=readQuantifier(); tokens.push({text:cls+(q||''),type:'class',description:'Character class'+(q?' '+describeQuantifier(q):'')}); continue; }
      if (ch === '(') {
        let type='group',label='Capture group',prefix='';
        if(peek()==='?'){const p2=peek(1);if(p2===':'){i+=2;type='ncgroup';label='Non-capturing group';prefix='(?:';}else if(p2==='='){i+=2;type='lookahead';label='Positive lookahead';prefix='(?=';}else if(p2==='!'){i+=2;type='lookahead';label='Negative lookahead';prefix='(?!';}else if(p2==='<'){const p3=peek(2);if(p3==='='||p3==='!'){i+=3;type='lookahead';label=p3==='='?'Positive lookbehind':'Negative lookbehind';prefix=`(?<${p3}`;}else{i+=2;let name='';while(i<pattern.length&&peek()!=='>')name+=consume();consume();type='namedgroup';label=`Named group: ${name}`;prefix=`(?<${name}>`;}}else if(p2==="'"){i+=2;let name='';while(i<pattern.length&&peek()!=='\'')name+=consume();consume();type='namedgroup';label=`Named group: ${name}`;prefix=`(?'${name}'`;}}
        let body='',depth=1; while(i<pattern.length&&depth>0){const c2=consume();if(c2==='\\'){body+=c2+(consume()||'');continue;}if(c2==='(')depth++;if(c2===')'){depth--;if(depth===0)break;}body+=c2;}
        const q=readQuantifier(); tokens.push({text:ch+prefix+body+')'+(q||''),type,description:label+(q?' '+describeQuantifier(q):'')}); continue;
      }
      if (ch === ')') { tokens.push({text:ch,type:'literal',description:'Literal )'}); continue; }
      const q=readQuantifier(); tokens.push({text:ch+(q||''),type:'literal',description:`Literal "${ch}"`+(q?' '+describeQuantifier(q):'')});
    }
    return tokens;
  }

  function escapeDesc(c: string): string {
    const map: Record<string,string> = {d:'Digit [0-9]',D:'Non-digit',w:'Word char [a-zA-Z0-9_]',W:'Non-word char',s:'Whitespace',S:'Non-whitespace',b:'Word boundary',B:'Non-word boundary',n:'Newline',r:'Carriage return',t:'Tab','0':'Null char'};
    return map[c] ? `\\${c} — ${map[c]}` : `Escaped "${c}"`;
  }
  function describeQuantifier(q: string): string {
    const lazy = q.endsWith('?'); const base = lazy ? q.slice(0,-1) : q; const suffix = lazy ? ' (lazy)' : ' (greedy)';
    if (base === '*') return '× zero or more' + suffix;
    if (base === '+') return '× one or more' + suffix;
    if (base === '?') return '× zero or one' + suffix;
    const m = base.match(/^\{(\d+)\}$/); if (m) return `× exactly ${m[1]}` + suffix;
    const m2 = base.match(/^\{(\d*),(\d*)\}$/); if (m2) { if(m2[1]===''&&m2[2]==='')return '× any times'+suffix; if(m2[2]==='')return `× ${m2[1]} or more`+suffix; return `× ${m2[1]}–${m2[2]}`+suffix; }
    return '';
  }
  function labelForType(type: string): string {
    return ({anchor:'Anchor',literal:'Literal',class:'Char class',quantifier:'Quantifier',group:'Group',namedgroup:'Named group',ncgroup:'Non-cap',alternation:'Or',lookahead:'Lookahead',escape:'Escape',dot:'Any char'} as any)[type] || type;
  }

  function renderTokens(tokens: any[]) {
    tokenFlow.innerHTML = '';
    if (!tokens.length) { tokenFlow.innerHTML = '<span style="color:var(--text-muted);font-size:.875rem;">Empty pattern.</span>'; return; }
    tokens.forEach((tok: any, idx: number) => {
      const chip = document.createElement('div');
      chip.className = `token-chip chip-${tok.type}`;
      chip.title = tok.description;
      const code = document.createElement('span');
      code.textContent = tok.text.length > 18 ? tok.text.slice(0,16)+'…' : tok.text;
      chip.appendChild(code);
      const lbl = document.createElement('span');
      lbl.className = 'chip-label';
      lbl.textContent = labelForType(tok.type);
      chip.appendChild(lbl);
      tokenFlow.appendChild(chip);
      if (idx < tokens.length - 1) { const arrow = document.createElement('span'); arrow.className='token-arrow'; arrow.textContent='→'; tokenFlow.appendChild(arrow); }
    });
  }

  // ══════════════════════════════════════════════════════════
  // VISUALIZE: CAPTURE GROUPS TABLE
  // ══════════════════════════════════════════════════════════
  function renderGroups(re: RegExp | null, text: string) {
    if (!re) { groupsSec.style.display = 'none'; return; }
    const matches = getMatches(re, text);
    if (!matches.length) { groupsSec.style.display = 'none'; return; }
    const groupCount = (re.source.match(/(?<!\\)\(/g) || []).length;
    const ncCount = (re.source.match(/\(\?[:=!<]/g) || []).length;
    const capCount = groupCount - ncCount;
    if (capCount === 0) { groupsSec.style.display = 'none'; return; }
    groupsSec.style.display = 'block';
    groupsBody.innerHTML = '';
    const namedGroupRe = /\(\?<([^>]+)>/g;
    const names: string[] = [];
    let nm;
    while ((nm = namedGroupRe.exec(re.source)) !== null) names.push(nm[1]);
    for (let g = 1; g <= capCount; g++) {
      const tr = document.createElement('tr');
      const name = names[g-1] || null;
      const vals = matches.slice(0,3).map(m => { const v = name ? (m as any).groups?.[name] : m[g]; return v != null ? v : '—'; });
      while (vals.length < 3) vals.push('—');
      tr.innerHTML = `<td>${name?`<strong>${name}</strong>`:`Group ${g}`}</td><td style="color:var(--text-muted);">${escHtml(extractGroupPattern(re.source,g))}</td>${vals.map(v=>`<td>${escHtml(v)}</td>`).join('')}`;
      groupsBody.appendChild(tr);
    }
  }

  function extractGroupPattern(source: string, n: number): string {
    let count=0, i=0;
    while(i<source.length){
      if(source[i]==='\\'){i+=2;continue;}
      if(source[i]==='['){while(i<source.length&&source[i]!==']')i++;i++;continue;}
      if(source[i]==='('){const nonCap=source[i+1]==='?'&&(source[i+2]===':'||source[i+2]==='='||source[i+2]==='!');if(!nonCap){count++;if(count===n){let body='',d=1;i++;while(i<source.length&&d>0){if(source[i]==='\\'){body+=source[i]+source[i+1];i+=2;continue;}if(source[i]==='(')d++;if(source[i]===')'){d--;if(d===0)break;}body+=source[i++];}return body.length>20?body.slice(0,18)+'…':body;}}}
      i++;
    }
    return '…';
  }

  // ══════════════════════════════════════════════════════════
  // EXTRACT: MATCH CHIPS
  // ══════════════════════════════════════════════════════════
  function renderExtract(re: RegExp | null, text: string) {
    const matches = getMatches(re, text);
    extCount.textContent = String(matches.length);
    matchesList.innerHTML = matches.map(m =>
      `<code style="background:var(--bg-surface-2);border:1px solid var(--border);border-radius:.375rem;padding:.2rem .5rem;font-size:.78rem;color:var(--text-primary);">${escHtml(m[0])}</code>`
    ).join('');
  }

  // ══════════════════════════════════════════════════════════
  // REPLACE: RULES ENGINE
  // ══════════════════════════════════════════════════════════
  const RULE_COLORS = [
    {bg:'rgba(34,197,94,0.28)',border:'#22C55E',label:'#22C55E'},
    {bg:'rgba(245,158,11,0.28)',border:'#F59E0B',label:'#F59E0B'},
    {bg:'rgba(6,182,212,0.28)',border:'#06B6D4',label:'#06B6D4'},
    {bg:'rgba(167,139,250,0.28)',border:'#A78BFA',label:'#A78BFA'},
    {bg:'rgba(249,115,22,0.28)',border:'#F97316',label:'#F97316'},
    {bg:'rgba(244,63,94,0.28)',border:'#F43F5E',label:'#F43F5E'},
    {bg:'rgba(234,179,8,0.28)',border:'#EAB308',label:'#EAB308'},
    {bg:'rgba(14,165,233,0.28)',border:'#0EA5E9',label:'#0EA5E9'},
  ];
  const PRESETS = [
    {name:'Strip HTML tags',pattern:'<[^>]+>',replacement:'',flags:'g'},
    {name:'Collapse whitespace',pattern:'\\s{2,}',replacement:' ',flags:'g'},
    {name:'Remove punctuation',pattern:'[^\\w\\s]',replacement:'',flags:'g'},
    {name:'Trim line ends',pattern:'[ \\t]+$',replacement:'',flags:'gm'},
    {name:'URL → [link]',pattern:'https?://\\S+',replacement:'[link]',flags:'g'},
    {name:'Double → single quotes',pattern:'"([^"]*)"',replacement:"'$1'",flags:'g'},
  ];

  type Rule = {id:number; pattern:string; replacement:string; flags:string; enabled:boolean; colorIdx:number};
  let rules: Rule[] = [];
  let nextId = 1;
  let editorMode: 'source'|'result' = 'source';

  const rulesList      = document.getElementById('rt-rules-list')!;
  const presetsList    = document.getElementById('rt-presets-list')!;
  const sourceEditor   = document.getElementById('rt-source-editor') as HTMLTextAreaElement;
  const highlightOvl   = document.getElementById('rt-highlight-overlay')!;
  const resultPanel    = document.getElementById('rt-result-panel')!;
  const resultOutput   = document.getElementById('rt-result-output') as HTMLTextAreaElement;
  const rbrMatchCount  = document.getElementById('rt-rbr-match-count')!;
  const sChars         = document.getElementById('rt-s-chars')!;
  const sLines         = document.getElementById('rt-s-lines')!;
  const sRules         = document.getElementById('rt-s-rules')!;
  const sMatches       = document.getElementById('rt-s-matches')!;
  const sReplacements  = document.getElementById('rt-s-replacements')!;

  function addRule(pattern = '', replacement = '', flags = 'g') {
    const colorIdx = rules.length % RULE_COLORS.length;
    const rule: Rule = { id: nextId++, pattern, replacement, flags, enabled: true, colorIdx };
    rules.push(rule);
    renderRuleCard(rule);
    updateReplace();
  }

  function removeRule(id: number) {
    rules = rules.filter(r => r.id !== id);
    document.getElementById(`rt-rule-card-${id}`)?.remove();
    updateReplace();
  }

  function renderRuleCard(rule: Rule) {
    const col = RULE_COLORS[rule.colorIdx];
    const card = document.createElement('div');
    card.id = `rt-rule-card-${rule.id}`;
    card.style.cssText = `background:var(--bg-surface);border:1.5px solid ${col.border}44;border-left:3px solid ${col.border};border-radius:.5rem;padding:.625rem .75rem;display:flex;flex-direction:column;gap:.4rem;`;
    card.innerHTML = `
      <div style="display:flex;align-items:center;gap:.4rem;margin-bottom:.1rem;">
        <span style="width:8px;height:8px;border-radius:50%;background:${col.label};flex-shrink:0;"></span>
        <span style="font-family:'Fira Code',monospace;font-size:.65rem;font-weight:700;color:${col.label};text-transform:uppercase;letter-spacing:.06em;flex:1;">Rule ${rule.id}</span>
        <label style="display:flex;align-items:center;gap:.3rem;cursor:pointer;">
          <input type="checkbox" ${rule.enabled?'checked':''} data-id="${rule.id}" class="rt-rule-toggle" style="width:.75rem;height:.75rem;accent-color:${col.label};cursor:pointer;"/>
          <span style="font-size:.62rem;color:var(--text-muted);font-family:'Fira Code',monospace;">on</span>
        </label>
        <button data-id="${rule.id}" class="rt-rule-delete" style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:.75rem;padding:0;line-height:1;">✕</button>
      </div>
      <div style="display:flex;align-items:center;gap:.3rem;">
        <span style="font-family:'Fira Code',monospace;font-size:.72rem;color:var(--text-muted);flex-shrink:0;">/</span>
        <input type="text" placeholder="pattern" value="${escAttr(rule.pattern)}" data-id="${rule.id}" class="rt-rule-pattern" style="flex:1;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:.3rem;padding:.3rem .5rem;font-family:'Fira Code',monospace;font-size:.75rem;color:var(--text-primary);outline:none;min-width:0;"/>
        <span style="font-family:'Fira Code',monospace;font-size:.72rem;color:var(--text-muted);flex-shrink:0;">/</span>
        <input type="text" placeholder="flags" value="${rule.flags}" data-id="${rule.id}" class="rt-rule-flags" maxlength="6" style="width:3.5rem;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:.3rem;padding:.3rem .4rem;font-family:'Fira Code',monospace;font-size:.75rem;color:var(--text-muted);outline:none;"/>
      </div>
      <div style="display:flex;align-items:center;gap:.3rem;">
        <span style="font-family:'Fira Code',monospace;font-size:.72rem;color:var(--text-muted);flex-shrink:0;min-width:.75rem;">→</span>
        <input type="text" placeholder="replacement ($1, $2, $&lt;name&gt;)" value="${escAttr(rule.replacement)}" data-id="${rule.id}" class="rt-rule-replacement" style="flex:1;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:.3rem;padding:.3rem .5rem;font-family:'Fira Code',monospace;font-size:.75rem;color:var(--text-primary);outline:none;min-width:0;"/>
      </div>
      <div id="rt-rule-error-${rule.id}" style="display:none;font-size:.65rem;color:#EF4444;font-family:'Fira Code',monospace;margin-top:.1rem;"></div>
    `;
    rulesList.appendChild(card);
    card.querySelector('.rt-rule-pattern')!.addEventListener('input', e => { const r=rules.find(r=>r.id===rule.id); if(r)r.pattern=(e.target as HTMLInputElement).value; updateReplace(); });
    card.querySelector('.rt-rule-replacement')!.addEventListener('input', e => { const r=rules.find(r=>r.id===rule.id); if(r)r.replacement=(e.target as HTMLInputElement).value; updateReplace(); });
    card.querySelector('.rt-rule-flags')!.addEventListener('input', e => { const r=rules.find(r=>r.id===rule.id); if(r)r.flags=(e.target as HTMLInputElement).value; updateReplace(); });
    card.querySelector('.rt-rule-toggle')!.addEventListener('change', e => { const r=rules.find(r=>r.id===rule.id); if(r)r.enabled=(e.target as HTMLInputElement).checked; updateReplace(); });
    card.querySelector('.rt-rule-delete')!.addEventListener('click', () => removeRule(rule.id));
  }

  // Presets
  PRESETS.forEach(p => {
    const btn = document.createElement('button');
    btn.style.cssText = 'text-align:left;padding:.3rem .6rem;background:var(--bg-surface-2);border:1px solid var(--border);border-radius:.35rem;cursor:pointer;font-family:"Fira Code",monospace;font-size:.68rem;color:var(--text-secondary);transition:all .15s;display:flex;align-items:center;gap:.4rem;';
    btn.innerHTML = `<span style="color:var(--text-primary);opacity:.7;">+</span> ${p.name}`;
    btn.addEventListener('click', () => addRule(p.pattern, p.replacement, p.flags));
    presetsList.appendChild(btn);
  });

  function updateReplace() {
    const text = sourceEditor.value;
    sChars.textContent = String(text.length);
    sLines.textContent = String(text ? text.split('\n').length : 0);
    const activeRules = rules.filter(r => r.enabled && r.pattern.trim());
    sRules.textContent = String(activeRules.length);

    let totalMatches = 0;
    type Span = {start:number; end:number; bg:string};
    const spans: Span[] = [];

    activeRules.forEach(rule => {
      const errEl = document.getElementById(`rt-rule-error-${rule.id}`)!;
      try {
        const flags = rule.flags.includes('g') ? rule.flags : rule.flags + 'g';
        const rx = new RegExp(rule.pattern, flags);
        const col = RULE_COLORS[rule.colorIdx];
        let m: RegExpExecArray | null;
        let count = 0;
        while ((m = rx.exec(text)) !== null) {
          spans.push({start:m.index, end:m.index+m[0].length, bg:col.bg});
          count++;
          if (m[0].length === 0) rx.lastIndex++;
        }
        totalMatches += count;
        errEl.style.display = 'none';
        const card = document.getElementById(`rt-rule-card-${rule.id}`)!;
        if (card) card.style.opacity = '1';
      } catch (err: any) {
        errEl.textContent = `⚠ ${err.message}`;
        errEl.style.display = 'block';
        const card = document.getElementById(`rt-rule-card-${rule.id}`)!;
        if (card) card.style.opacity = '0.5';
      }
    });

    sMatches.textContent = String(totalMatches);
    rbrMatchCount.textContent = totalMatches > 0 ? `${totalMatches} match${totalMatches!==1?'es':''}` : '';

    if (spans.length > 0) {
      spans.sort((a,b) => a.start - b.start);
      let html = '', cursor = 0;
      for (const span of spans) {
        if (span.start < cursor) continue;
        html += escHtml(text.slice(cursor, span.start));
        html += `<mark style="background:${span.bg};color:inherit;border-radius:2px;">${escHtml(text.slice(span.start, span.end))}</mark>`;
        cursor = span.end;
      }
      html += escHtml(text.slice(cursor));
      highlightOvl.innerHTML = html;
      highlightOvl.style.display = 'block';
    } else {
      highlightOvl.style.display = 'none';
    }

    if (editorMode === 'result') {
      let result = text;
      let totalReplacements = 0;
      activeRules.forEach(rule => {
        try {
          const flags = rule.flags.includes('g') ? rule.flags : rule.flags + 'g';
          const rx = new RegExp(rule.pattern, flags);
          const before = result;
          result = result.replace(rx, rule.replacement);
          if (result !== before) totalReplacements++;
        } catch {}
      });
      resultOutput.value = result;
      sReplacements.textContent = String(totalReplacements);
    } else {
      sReplacements.textContent = '—';
    }
  }

  // Editor mode toggle
  function setEditorMode(m: typeof editorMode) {
    editorMode = m;
    document.querySelectorAll('.rt-editor-mode').forEach(btn => {
      const isActive = (btn as HTMLElement).id === `rt-mode-${m}`;
      btn.classList.toggle('active', isActive);
    });
    const editorWrap = sourceEditor.parentElement!;
    if (m === 'source') { editorWrap.style.display = 'block'; resultPanel.style.display = 'none'; }
    else { editorWrap.style.display = 'none'; resultPanel.style.display = 'flex'; }
    updateReplace();
  }

  document.getElementById('rt-mode-source')!.addEventListener('click', () => setEditorMode('source'));
  document.getElementById('rt-mode-result')!.addEventListener('click', () => setEditorMode('result'));
  document.getElementById('rt-btn-add-rule')!.addEventListener('click', () => addRule());

  document.getElementById('rt-btn-load-sample')!.addEventListener('click', () => {
    sourceEditor.value = `Hello World! This is a <b>sample</b> text file.\nIt contains  double   spaces and <em>HTML tags</em>.\nVisit https://example.com for more info.\n"Quoted text" appears multiple times here.\nAnother line with  extra   whitespace.`;
    addRule('<[^>]+>', '', 'g');
    addRule('\\s{2,}', ' ', 'g');
    updateReplace();
  });

  document.getElementById('rt-btn-clear-editor')!.addEventListener('click', () => {
    sourceEditor.value = '';
    highlightOvl.style.display = 'none';
    updateReplace();
  });

  document.getElementById('rt-btn-copy-result')!.addEventListener('click', () => {
    if (!resultOutput.value) return;
    navigator.clipboard.writeText(resultOutput.value).then(() => {
      const btn = document.getElementById('rt-btn-copy-result')!;
      btn.textContent = '✓ copied';
      setTimeout(() => { btn.textContent = 'copy'; }, 2000);
    });
  });

  sourceEditor.addEventListener('scroll', () => {
    highlightOvl.scrollTop = sourceEditor.scrollTop;
    highlightOvl.scrollLeft = sourceEditor.scrollLeft;
  });

  // ══════════════════════════════════════════════════════════
  // MAIN UPDATE
  // ══════════════════════════════════════════════════════════
  function update() {
    if (activeTab === 'replace') { updateReplace(); return; }

    const pattern = inpPattern.value;
    const testStr = inpTest.value;

    if (!pattern) {
      errorEl.style.display = 'none';
      hlOutput.textContent = testStr || 'Enter a pattern to see matches highlighted here.';
      summaryEl.textContent = '';
      if (activeTab === 'visualize') {
        tokenFlow.innerHTML = '<span style="color:var(--text-muted);font-size:.875rem;">Enter a regex above.</span>';
        groupsSec.style.display = 'none';
      }
      if (activeTab === 'extract') { extCount.textContent = '0'; matchesList.innerHTML = ''; }
      return;
    }

    const re = buildRegex(pattern);
    if (!re) {
      hlOutput.textContent = testStr;
      summaryEl.textContent = '';
      if (activeTab === 'visualize') { tokenFlow.innerHTML = '<span style="color:#f87171;font-size:.875rem;">Fix the regex error above.</span>'; groupsSec.style.display = 'none'; }
      if (activeTab === 'extract') { extCount.textContent = '0'; matchesList.innerHTML = ''; }
      return;
    }

    highlightMatches(re, testStr);

    if (activeTab === 'visualize') {
      try { renderTokens(tokenise(pattern)); } catch { tokenFlow.innerHTML = '<span style="color:var(--text-muted);font-size:.875rem;">Could not parse tokens.</span>'; }
      renderGroups(re, testStr);
    }

    if (activeTab === 'extract') {
      renderExtract(re, testStr);
    }
  }

  // Wire shared inputs
  inpPattern.addEventListener('input', update);
  inpTest.addEventListener('input', update);
  sourceEditor.addEventListener('input', updateReplace);

  // Init
  addRule();
  update();
})();
</script>
