---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'context-window-analyzer')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Context Window Analyzer</h2>

    <textarea id="ctx-input" placeholder="Paste a long prompt or document to analyze token distribution across paragraphs…"
      style="width:100%; height:180px; padding:0.875rem; border:1.5px solid #BAE6FD; border-radius:0.625rem; font-size:0.875rem; color:var(--text-primary); resize:vertical; box-sizing:border-box; outline:none; line-height:1.65; margin-bottom:0.875rem; font-family:inherit; background:var(--bg-surface);"
      onfocus="this.style.borderColor='#0EA5E9'" onblur="this.style.borderColor='#BAE6FD'"></textarea>

    <!-- Stats bar -->
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:0.5rem; margin-bottom:1rem;">
      {[['stat-tokens','Total Tokens','#0284C7','#F0F9FF','#BAE6FD'],['stat-chars','Characters','#7C3AED','#F5F3FF','#DDD6FE'],['stat-paras','Paragraphs','#059669','#F0FDF4','#BBF7D0'],['stat-cost','Est. Cost','#D97706','#FFFBEB','#FDE68A']].map(([id,label,fg,bg,border]) => (
        <div style={`background:${bg};border:1.5px solid ${border};border-radius:0.625rem;padding:0.625rem;text-align:center;`}>
          <div id={id} style={`font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:${fg};`}>0</div>
          <div style={`font-size:0.68rem;font-weight:600;color:${fg};margin-top:0.15rem;text-transform:uppercase;letter-spacing:0.04em;opacity:0.7;`}>{label}</div>
        </div>
      ))}
    </div>

    <!-- Cost config -->
    <div style="display:flex; gap:0.75rem; align-items:center; margin-bottom:1rem; flex-wrap:wrap;">
      <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary);">Context limit (tokens):</label>
      <input id="ctx-limit" type="number" value="128000" min="1000" step="1000" class="input-themed" style="width:100px;"/>
      <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary);">$/1K tokens:</label>
      <input id="ctx-rate" type="number" value="0.003" min="0" step="0.001" class="input-themed" style="width:80px;"/>
    </div>

    <!-- Context usage bar -->
    <div style="margin-bottom:1rem;">
      <div style="display:flex; justify-content:space-between; font-size:0.78rem; font-weight:600; color:var(--text-muted); margin-bottom:0.375rem;">
        <span>Context usage</span><span id="ctx-pct">0%</span>
      </div>
      <div style="height:10px; background:var(--bg-surface-2); border-radius:9999px; overflow:hidden;">
        <div id="ctx-bar" style="height:100%; width:0%; background:linear-gradient(90deg,#0EA5E9,#7C3AED); border-radius:9999px; transition:width 0.3s;"></div>
      </div>
    </div>

    <!-- Heatmap -->
    <div style="font-size:0.78rem; font-weight:700; color:#0284C7; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.5rem;">Paragraph Token Heatmap</div>
    <div id="heatmap" style="display:flex; flex-direction:column; gap:0.25rem;"></div>

    <!-- Legend -->
    <div style="display:flex; gap:0.375rem; margin-top:0.75rem; font-size:0.68rem; color:var(--text-muted); align-items:center;">
      <span>Low</span>
      {['#EFF6FF','#BAE6FD','#7DD3FC','#38BDF8','#0EA5E9','#0284C7','#0369A1'].map(c => (
        <span style={`width:18px;height:12px;background:${c};border-radius:2px;display:inline-block;`}></span>
      ))}
      <span>High</span>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Context Window Analyzer</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">Paste a long prompt, document, or multi-section context into the text area. The tool estimates total tokens (chars/4), shows how much of your chosen model's context window is used, and displays a paragraph-level heatmap so you can see where tokens are concentrated.</p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">Adjust the context limit and $/1K tokens inputs to match your model. Use this to identify and trim the heaviest sections before sending to the API.</p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How context window analysis works</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">The text is split into paragraphs (double newline boundaries). Each paragraph's token count is estimated as characters ÷ 4. The maximum paragraph count is used to normalise heat intensity (darkest blue = most tokens in that section). Cost is calculated as total tokens ÷ 1,000 × rate.</p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">The context bar turns orange when usage exceeds 80% and red at 100% to signal that content may be truncated.</p>
  </div>

  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What happens when my prompt exceeds the context window?', a: 'Most models truncate input that exceeds the context window, typically from the middle of the conversation history (keeping the system prompt and most recent messages). Some providers return an error. The result is that earlier context is lost, which can cause the model to lose track of earlier instructions or facts.' },
        { q: 'What are typical context window sizes for popular models?', a: 'Context windows vary widely: GPT-4o supports 128K tokens; Claude 3.5 Sonnet supports 200K tokens; Gemini 1.5 Pro supports up to 1M tokens (experimental). Older models like GPT-3.5 Turbo were limited to 4K–16K tokens. Larger windows cost more per request. Use the context limit field to match your specific model.' },
        { q: 'Why does the token estimate differ from the model\'s count?', a: 'The chars/4 approximation works well for English prose but can be off by 10–30% for code, structured data, non-Latin scripts, or text with many special characters. Tokenisation is model-specific — OpenAI uses BPE (Byte Pair Encoding), Anthropic uses a similar approach. Use tiktoken or provider SDK token-counting functions for exact counts.' },
        { q: 'What is the Lost in the Middle problem?', a: 'Research shows LLMs perform worse at retrieving information from the middle of long contexts vs. the beginning or end. When designing long prompts, put the most important instructions and facts at the start (system/first user turn) or at the very end (just before the generation). Middle sections have the highest "forgetting" rate.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="result-card">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  const HEAT_COLORS = ['#EFF6FF','#BAE6FD','#7DD3FC','#38BDF8','#0EA5E9','#0284C7','#0369A1'];

  function heatColor(ratio: number): string {
    const idx = Math.min(Math.floor(ratio * HEAT_COLORS.length), HEAT_COLORS.length - 1);
    return HEAT_COLORS[idx];
  }

  function update() {
    const text   = (document.getElementById('ctx-input') as HTMLTextAreaElement).value;
    const limit  = parseInt((document.getElementById('ctx-limit') as HTMLInputElement).value) || 128000;
    const rate   = parseFloat((document.getElementById('ctx-rate') as HTMLInputElement).value) || 0;
    const chars  = text.length;
    const tokens = Math.round(chars / 4);
    const paras  = text.trim() ? text.split(/\n\s*\n/).filter(p => p.trim()) : [];
    const cost   = (tokens / 1000) * rate;
    const pct    = Math.min((tokens / limit) * 100, 100);

    (document.getElementById('stat-tokens') as HTMLElement).textContent = tokens.toLocaleString();
    (document.getElementById('stat-chars') as HTMLElement).textContent  = chars.toLocaleString();
    (document.getElementById('stat-paras') as HTMLElement).textContent  = paras.length.toLocaleString();
    (document.getElementById('stat-cost') as HTMLElement).textContent   = '$' + cost.toFixed(4);
    (document.getElementById('ctx-pct') as HTMLElement).textContent     = pct.toFixed(1) + '%';

    const bar = document.getElementById('ctx-bar') as HTMLElement;
    bar.style.width = pct + '%';
    if (pct >= 100) bar.style.background = '#DC2626';
    else if (pct >= 80) bar.style.background = '#EA580C';
    else bar.style.background = 'linear-gradient(90deg,#0EA5E9,#7C3AED)';

    const paraTokens = paras.map(p => Math.round(p.length / 4));
    const maxT = Math.max(...paraTokens, 1);

    const hm = document.getElementById('heatmap')!;
    hm.innerHTML = '';
    paras.forEach((p, i) => {
      const t     = paraTokens[i];
      const ratio = t / maxT;
      const color = heatColor(ratio);
      const row   = document.createElement('div');
      row.style.cssText = `display:flex;align-items:center;gap:0.5rem;`;
      row.innerHTML = `
        <div style="flex:1;background:${color};border-radius:0.375rem;padding:0.5rem 0.75rem;font-size:0.75rem;color:var(--text-primary);line-height:1.5;overflow:hidden;max-height:3.2em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
          ${p.slice(0,120).replace(/</g,'&lt;').replace(/>/g,'&gt;')}${p.length > 120 ? '…' : ''}
        </div>
        <span style="flex-shrink:0;font-size:0.72rem;font-weight:700;color:#0284C7;min-width:52px;text-align:right;">${t} tok</span>
      `;
      hm.appendChild(row);
    });
  }

  document.getElementById('ctx-input')?.addEventListener('input', update);
  document.getElementById('ctx-limit')?.addEventListener('input', update);
  document.getElementById('ctx-rate')?.addEventListener('input', update);

  (document.getElementById('ctx-input') as HTMLTextAreaElement).value =
    'You are a helpful research assistant specialised in climate science.\n\nContext:\nThe IPCC Sixth Assessment Report (AR6) published in 2021-2022 consolidates findings from thousands of peer-reviewed studies on climate change, impacts, adaptation, and mitigation.\n\nTask:\nSummarise the key findings of AR6 regarding projected temperature increases under different emissions scenarios (SSP1-1.9, SSP2-4.5, SSP5-8.5) and their associated confidence levels.\n\nFormat:\nRespond in structured bullet points. Use plain English. Avoid jargon where possible.';
  update();
</script>
