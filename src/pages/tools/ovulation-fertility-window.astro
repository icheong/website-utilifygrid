---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'ovulation-fertility-window')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Ovulation &amp; Fertility Window Calculator</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.25rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">First Day of Last Period</label>
        <input id="period-date" type="date"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Average Cycle Length (days)</label>
        <input id="cycle-len" type="number" value="28" min="21" max="45"
          class="input-themed"/>
      </div>
    </div>

    <div id="results" style="display:none; flex-direction:column; gap:0.75rem; margin-bottom:1.25rem;">
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.75rem;">
        <div class="result-card" style="background:#FDF2F8; border-color:#F9A8D4; text-align:center;">
          <div id="out-ovulation" style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:#DB2777;"></div>
          <div style="font-size:0.68rem; font-weight:600; color:#F472B6; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.04em;">Ovulation Day</div>
        </div>
        <div class="result-card" style="background:#FFF0F6; border-color:#FBCFE8; text-align:center;">
          <div id="out-window-start" style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:#9D174D;"></div>
          <div style="font-size:0.68rem; font-weight:600; color:#F9A8D4; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.04em;">Window Opens</div>
        </div>
        <div class="result-card" style="background:#FCE7F3; border-color:#F9A8D4; text-align:center;">
          <div id="out-window-end" style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:#9D174D;"></div>
          <div style="font-size:0.68rem; font-weight:600; color:#F9A8D4; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.04em;">Window Closes</div>
        </div>
      </div>

      <div id="out-next-period" class="result-card" style="text-align:center;"></div>

      <!-- Calendar grid -->
      <div class="result-card" style="padding:1rem;">
        <div style="font-size:0.75rem; font-weight:600; color:#DB2777; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.75rem;">Cycle Calendar</div>
        <div id="calendar-grid" style="display:grid; grid-template-columns:repeat(7,1fr); gap:3px;"></div>
        <div style="display:flex; flex-wrap:wrap; gap:0.75rem; margin-top:0.75rem;">
          {[['#DB2777','#FDF2F8','Ovulation Day'],['#F472B6','#FFF0F6','Fertility Window'],['#94A3B8','#F8FAFC','Rest of Cycle']].map(([bg, light, label]) => (
            <div style="display:flex; align-items:center; gap:0.375rem;">
              <div style={`width:10px; height:10px; background:${light}; border:1.5px solid ${bg}; border-radius:3px;`}></div>
              <span style="font-size:0.72rem; color:var(--text-muted);">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div id="placeholder" style="text-align:center; padding:2rem; color:var(--text-muted); font-size:0.875rem;">Select a period start date to see your fertility window.</div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to use the Ovulation &amp; Fertility Window Calculator</h2>
    <p class="seo-p">Enter the first day of your most recent menstrual period and your average cycle length. The calendar will highlight your predicted fertility window and ovulation day based on the standard calendar method.</p>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Conception planning</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Identify the optimal days within your cycle to maximise the chances of conception by understanding exactly when ovulation is predicted.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Cycle awareness</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Visualise your full menstrual cycle to understand the timing of each phase and how cycle length variations affect ovulation timing.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Clinic consultation prep</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Bring a printed cycle prediction to your fertility consultation to give your healthcare provider a clear picture of your cycle pattern and timing.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How predictions are made</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:0.5rem;">
      <div>
        <h3 class="font-display seo-h3-sm">Ovulation day estimation</h3>
        <p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.65; margin:0;">Estimated as <code class="inline-code">cycle length - 14</code> days from period start. For a <code class="inline-code">28</code>-day cycle, ovulation is around day 14. For a <code class="inline-code">32</code>-day cycle, it is around day 18.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Fertility window</h3>
        <p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.65; margin:0;">Sperm can survive up to 5 days in the fallopian tubes. The fertile window covers the 5 days before ovulation through to 1 day after ovulation, a 6-day window total.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Cycle variation</h3>
        <p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.65; margin:0;">The luteal phase (ovulation to next period) is relatively constant at approximately 14 days. It is the follicular phase that varies, which is why irregular cycles make prediction harder.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Limitations</h3>
        <p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.65; margin:0;">This is a statistical estimation tool only. Cycle irregularity, stress, illness, and hormonal conditions can shift ovulation significantly. This tool should not be used as contraception.</p>
      </div>
    </div>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently asked questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'How accurate is the calendar method?', a: 'The calendar method is approximately 76-88% effective when used perfectly, but only about 75% with typical use. For conception, it correctly identifies the fertile window in roughly 80% of cycles with regular periods.' },
        { q: 'What is the most fertile day?', a: 'Conception probability is highest on ovulation day and the day before. Likelihood follows a curve: roughly 10% on day 5 before ovulation, rising to 33% the day before, and 25% on ovulation day.' },
        { q: 'How do I know if I am ovulating?', a: 'Signs include a rise in basal body temperature (0.2-0.5\u00B0C), egg-white cervical mucus, a positive LH surge on an ovulation test strip, and sometimes mild one-sided pelvic cramping.' },
        { q: 'Can I get pregnant outside the fertile window?', a: 'It is possible but unlikely. Sperm can survive up to 5 days, and ovulation timing can shift. If your cycles are irregular, the predicted window may be less accurate, and additional tracking methods are recommended.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7"><strong class="text-primary" style="color:var(--text-secondary)">Disclaimer:</strong> This tool provides statistical estimates only and should not be used as contraception or as a substitute for professional medical advice. Consult a healthcare provider for personalised fertility guidance.</div>
  </div>

</ToolLayout>

<script>
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const DAYS   = ['Su','Mo','Tu','We','Th','Fr','Sa'];

  function fmtDate(d: Date): string {
    return `${d.getDate()} ${MONTHS[d.getMonth()]}`;
  }

  function addDays(d: Date, n: number): Date {
    const r = new Date(d); r.setDate(r.getDate() + n); return r;
  }

  function calc() {
    const pd = (document.getElementById('period-date') as HTMLInputElement).value;
    const cl = parseInt((document.getElementById('cycle-len') as HTMLInputElement).value) || 28;
    if (!pd) return;

    const start     = new Date(pd + 'T00:00:00');
    const ovDay     = cl - 14;
    const ovDate    = addDays(start, ovDay);
    const winStart  = addDays(ovDate, -5);
    const winEnd    = addDays(ovDate, 1);
    const nextPeriod = addDays(start, cl);

    (document.getElementById('out-ovulation') as HTMLElement).textContent    = fmtDate(ovDate);
    (document.getElementById('out-window-start') as HTMLElement).textContent = fmtDate(winStart);
    (document.getElementById('out-window-end') as HTMLElement).textContent   = fmtDate(winEnd);
    (document.getElementById('out-next-period') as HTMLElement).textContent  = `Next period expected: ${fmtDate(nextPeriod)}`;

    // Build calendar
    const grid = document.getElementById('calendar-grid')!;
    grid.innerHTML = '';
    DAYS.forEach(d => {
      const h = document.createElement('div');
      h.textContent = d;
      h.style.cssText = 'font-size:0.65rem;font-weight:700;color:var(--text-muted);text-align:center;padding:2px;';
      grid.appendChild(h);
    });

    const startDow = start.getDay();
    for (let i = 0; i < startDow; i++) {
      const blank = document.createElement('div'); grid.appendChild(blank);
    }

    for (let d = 0; d < cl; d++) {
      const date = addDays(start, d);
      const el   = document.createElement('div');
      el.textContent = String(date.getDate());
      const isOv  = d === ovDay;
      const isFW  = d >= ovDay - 5 && d <= ovDay + 1 && !isOv;
      el.style.cssText = [
        'font-size:0.72rem;text-align:center;padding:4px 2px;border-radius:4px;border:1.5px solid;',
        isOv  ? 'background:#FDF2F8;border-color:#DB2777;color:#DB2777;font-weight:700;' :
        isFW  ? 'background:#FFF0F6;border-color:#F9A8D4;color:#9D174D;font-weight:600;' :
                'background:var(--bg-surface);border-color:var(--border);color:var(--text-muted);',
      ].join('');
      grid.appendChild(el);
    }

    (document.getElementById('results') as HTMLElement).style.display = 'flex';
    (document.getElementById('placeholder') as HTMLElement).style.display = 'none';
  }

  ['period-date','cycle-len'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));

  // default today
  const today = new Date();
  const iso   = today.toISOString().split('T')[0];
  (document.getElementById('period-date') as HTMLInputElement).value = iso;
  calc();
</script>
