---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'ovulation-fertility-window')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Ovulation &amp; Fertility Window Calculator</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.25rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">First Day of Last Period</label>
        <input id="period-date" type="date"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Average Cycle Length (days)</label>
        <input id="cycle-len" type="number" value="28" min="21" max="45"
          class="input-themed"/>
      </div>
    </div>

    <div id="results" style="display:none; flex-direction:column; gap:0.75rem; margin-bottom:1.25rem;">
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.75rem;">
        <div class="result-card" style="background:#FDF2F8; border-color:#F9A8D4; text-align:center;">
          <div id="out-ovulation" style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:#DB2777;"></div>
          <div style="font-size:0.68rem; font-weight:600; color:#F472B6; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.04em;">Ovulation Day</div>
        </div>
        <div class="result-card" style="background:#FFF0F6; border-color:#FBCFE8; text-align:center;">
          <div id="out-window-start" style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:#9D174D;"></div>
          <div style="font-size:0.68rem; font-weight:600; color:#F9A8D4; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.04em;">Window Opens</div>
        </div>
        <div class="result-card" style="background:#FCE7F3; border-color:#F9A8D4; text-align:center;">
          <div id="out-window-end" style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:#9D174D;"></div>
          <div style="font-size:0.68rem; font-weight:600; color:#F9A8D4; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.04em;">Window Closes</div>
        </div>
      </div>

      <div id="out-next-period" class="result-card" style="text-align:center;"></div>

      <!-- Calendar grid -->
      <div class="result-card" style="padding:1rem;">
        <div style="font-size:0.75rem; font-weight:600; color:#DB2777; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.75rem;">Cycle Calendar</div>
        <div id="calendar-grid" style="display:grid; grid-template-columns:repeat(7,1fr); gap:3px;"></div>
        <div style="display:flex; flex-wrap:wrap; gap:0.75rem; margin-top:0.75rem;">
          {[['#DB2777','#FDF2F8','Ovulation Day'],['#F472B6','#FFF0F6','Fertility Window'],['#94A3B8','#F8FAFC','Rest of Cycle']].map(([bg, light, label]) => (
            <div style="display:flex; align-items:center; gap:0.375rem;">
              <div style={`width:10px; height:10px; background:${light}; border:1.5px solid ${bg}; border-radius:3px;`}></div>
              <span style="font-size:0.72rem; color:var(--text-muted);">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div id="placeholder" style="text-align:center; padding:2rem; color:var(--text-muted); font-size:0.875rem;">Select a period start date to see your fertility window.</div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to use the Ovulation &amp; Fertility Window Calculator</h2>
    <p class="seo-p">Knowing when you are most fertile can feel overwhelming, especially when cycles vary from month to month and due dates or conception timelines feel uncertain. This calculator uses the standard calendar method to map out your predicted fertile window and ovulation day from just two inputs: the first day of your last period and your typical cycle length. Enter your dates and cycle information into the fields provided, and the results will show your ovulation day, fertility window, and a visual calendar of your entire cycle at a glance.</p>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Trying to conceive</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A couple with a regular 30-day cycle who started tracking in January could identify that ovulation falls on day 16 and the fertile window spans from day 11 through day 17, giving them a clear six-day window to time intercourse for the best chance of conception.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Irregular cycle planning</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Someone whose cycle ranges from 26 to 34 days may find ovulation shifts from day 12 to day 20 depending on the month. Entering a 30-day average gives a reasonable midpoint estimate, but tracking over several months reveals the true pattern and helps refine predictions over time.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Preparing for a fertility consultation</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Many fertility specialists ask patients to chart cycle data before an initial appointment. Generating a calendar view with highlighted fertile days and ovulation timing gives your provider a clear snapshot of your cycle pattern across two to three months of data.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Tracking after stopping hormonal birth control</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">After discontinuing oral contraceptives, cycles can take three to six months to stabilise. Using this calculator each month during that transition period helps identify when regular ovulation resumes and whether the fertile window is settling into a predictable pattern.</p>
      </div>
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/bmi-calculator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">BMI Calculator</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How predictions are made</h2>
    <p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.65; margin:0 0 0.75rem 0;">The calculator applies the standard Ogino-Knaus calendar method, which estimates ovulation based on the assumption that the luteal phase remains constant across cycles. All calculations happen locally in your browser, so no personal health data is transmitted or stored on any external server.</p>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:0.5rem;">
      <div>
        <h3 class="font-display seo-h3-sm">Ovulation day estimation</h3>
        <p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.65; margin:0;">The formula <code class="inline-code">cycle length - 14</code> subtracts the fixed luteal phase length from the total cycle length to pinpoint ovulation. For a <code class="inline-code">28</code>-day cycle, ovulation lands on day 14. For a <code class="inline-code">32</code>-day cycle, it shifts to day 18. For a shorter <code class="inline-code">24</code>-day cycle, ovulation would fall on day 10. The 14-day luteal phase constant is supported by reproductive endocrinology research and aligns with the American College of Obstetricians and Gynecologists guidelines.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Fertility window</h3>
        <p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.65; margin:0;">Sperm can survive in the fallopian tubes for up to five days, while the egg remains viable for approximately 12 to 24 hours after release. The fertile window therefore spans the five days before ovulation through one day after, creating a six-day period of potential conception. For a 30-day cycle with ovulation on day 16, the window opens on day 11 and closes on day 17. Research published in the British Medical Journal confirms that peak fertility occurs in the two days preceding ovulation.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Cycle variation</h3>
        <p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.65; margin:0;">The luteal phase from ovulation to the next period remains relatively constant at 12 to 16 days, with 14 being the median. Variation between cycles comes primarily from the follicular phase, which is the time from period start to ovulation. A person with a 28-day cycle one month and a 34-day cycle the next most likely experienced a longer follicular phase, not a change in luteal length. This is why the calendar method works best with six to twelve months of consistent cycle data.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Limitations and accuracy</h3>
        <p style="font-size:0.85rem; color:var(--text-secondary); line-height:1.65; margin:0;">The calendar method achieves approximately 76 to 88 percent effectiveness with perfect use but drops to roughly 75 percent with typical use, according to Planned Parenthood data. Factors such as stress, illness, travel, polycystic ovary syndrome, and perimenopause can shift ovulation by several days unpredictably. For individuals with highly irregular cycles, combining this tool with basal body temperature tracking or ovulation predictor kits provides significantly more reliable results than calendar estimation alone.</p>
      </div>
    </div>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently asked questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'How accurate is the calendar method?', a: 'The calendar method is approximately 76 to 88 percent effective when used perfectly, but only about 75 percent with typical use according to Planned Parenthood data. For conception purposes, it correctly identifies the fertile window in roughly 80 percent of cycles when periods are regular. Accuracy drops significantly for individuals with irregular cycles, high stress levels, or hormonal conditions such as PCOS. Combining calendar tracking with basal body temperature or cervical mucus observation improves reliability.' },
        { q: 'What is the most fertile day?', a: 'Conception probability peaks on ovulation day and the single day before it, when the egg is freshly released and sperm are already positioned in the fallopian tubes. Likelihood follows a bell curve: roughly 10 percent on day 5 before ovulation, climbing to approximately 33 percent the day before, and settling around 25 percent on ovulation day itself. These figures come from studies published in the New England Journal of Medicine tracking daily conception rates among couples actively trying.' },
        { q: 'How do I know if I am ovulating?', a: 'Common signs include a sustained rise in basal body temperature of 0.2 to 0.5 degrees Celsius above your pre-ovulation baseline, egg-white cervical mucus that stretches without breaking, and a positive LH surge detected on an ovulation predictor kit. Some individuals also experience mittelschmerz, a brief one-sided pelvic twinge on the side of the ovary releasing the egg. Tracking two or three of these indicators simultaneously provides the most reliable confirmation that ovulation has occurred.' },
        { q: 'Can I get pregnant outside the fertile window?', a: 'It is possible but unlikely for most individuals with regular cycles. Sperm can survive up to five days in the fallopian tubes, and ovulation timing can shift unexpectedly due to stress, illness, or hormonal fluctuations. If your cycles are irregular, the predicted window may be less accurate, and relying on calendar estimates alone as contraception carries a meaningful risk of unintended pregnancy. Additional tracking methods such as OPKs or progesterone testing can reduce this uncertainty.' },
        { q: 'How does this compare to using ovulation predictor kits?', a: 'Ovulation predictor kits detect the LH surge that occurs 24 to 36 hours before ovulation, providing a more precise real-time signal than calendar estimation. The calendar method offers a broader planning window but with lower day-to-day accuracy. Many reproductive health experts recommend using both together: the calendar method to anticipate roughly when to start testing with OPKs, and the kit to confirm the actual ovulation day. OPKs are especially valuable for individuals with irregular cycles where calendar predictions are less reliable.' },
        { q: 'Why does the calculator subtract 14 days?', a: 'The subtraction of 14 reflects the relatively fixed length of the luteal phase, the period between ovulation and the start of the next menstrual period. Research in reproductive endocrinology has established that the luteal phase ranges from 12 to 16 days in most individuals, with 14 being the most common value. Because the follicular phase before ovulation varies considerably from person to person and month to month, subtracting the constant luteal length from the total cycle duration is the most straightforward way to estimate when ovulation occurred.' },
        { q: 'What if my cycle length varies by several days each month?', a: 'Significant month-to-month variation reduces the accuracy of any calendar-based prediction. For example, if your cycle ranges from 26 to 34 days, ovulation could fall anywhere from day 12 to day 20 depending on the month. Entering your average cycle length provides a midpoint estimate, but tracking at least six months of data will reveal whether your pattern is consistently irregular. In that case, supplementing with basal body temperature charting or progesterone testing will give you far more dependable results.' },
        { q: 'Is this tool suitable for postpartum or breastfeeding individuals?', a: 'Not reliably. Postpartum and breastfeeding hormones frequently suppress or delay ovulation in unpredictable ways, making calendar-based estimates unreliable for the first six to twelve months after giving birth. Lactational amenorrhea, the absence of periods during exclusive breastfeeding, does not guarantee that ovulation has not occurred, as ovulation can precede the first postpartum period. Individuals in this category should consult a healthcare provider about appropriate contraception and fertility tracking methods.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7"><strong class="text-primary" style="color:var(--text-secondary)">Medical Disclaimer:</strong> This tool provides statistical estimates only and should not be used as contraception or as a substitute for professional medical advice. Consult a healthcare provider for personalised fertility guidance.</div>
  </div>

</ToolLayout>

<script>
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const DAYS   = ['Su','Mo','Tu','We','Th','Fr','Sa'];

  function fmtDate(d: Date): string {
    return `${d.getDate()} ${MONTHS[d.getMonth()]}`;
  }

  function addDays(d: Date, n: number): Date {
    const r = new Date(d); r.setDate(r.getDate() + n); return r;
  }

  function calc() {
    const pd = (document.getElementById('period-date') as HTMLInputElement).value;
    const cl = parseInt((document.getElementById('cycle-len') as HTMLInputElement).value) || 28;
    if (!pd) return;

    const start     = new Date(pd + 'T00:00:00');
    const ovDay     = cl - 14;
    const ovDate    = addDays(start, ovDay);
    const winStart  = addDays(ovDate, -5);
    const winEnd    = addDays(ovDate, 1);
    const nextPeriod = addDays(start, cl);

    (document.getElementById('out-ovulation') as HTMLElement).textContent    = fmtDate(ovDate);
    (document.getElementById('out-window-start') as HTMLElement).textContent = fmtDate(winStart);
    (document.getElementById('out-window-end') as HTMLElement).textContent   = fmtDate(winEnd);
    (document.getElementById('out-next-period') as HTMLElement).textContent  = `Next period expected: ${fmtDate(nextPeriod)}`;

    // Build calendar
    const grid = document.getElementById('calendar-grid')!;
    grid.innerHTML = '';
    DAYS.forEach(d => {
      const h = document.createElement('div');
      h.textContent = d;
      h.style.cssText = 'font-size:0.65rem;font-weight:700;color:var(--text-muted);text-align:center;padding:2px;';
      grid.appendChild(h);
    });

    const startDow = start.getDay();
    for (let i = 0; i < startDow; i++) {
      const blank = document.createElement('div'); grid.appendChild(blank);
    }

    for (let d = 0; d < cl; d++) {
      const date = addDays(start, d);
      const el   = document.createElement('div');
      el.textContent = String(date.getDate());
      const isOv  = d === ovDay;
      const isFW  = d >= ovDay - 5 && d <= ovDay + 1 && !isOv;
      el.style.cssText = [
        'font-size:0.72rem;text-align:center;padding:4px 2px;border-radius:4px;border:1.5px solid;',
        isOv  ? 'background:#FDF2F8;border-color:#DB2777;color:#DB2777;font-weight:700;' :
        isFW  ? 'background:#FFF0F6;border-color:#F9A8D4;color:#9D174D;font-weight:600;' :
                'background:var(--bg-surface);border-color:var(--border);color:var(--text-muted);',
      ].join('');
      grid.appendChild(el);
    }

    (document.getElementById('results') as HTMLElement).style.display = 'flex';
    (document.getElementById('placeholder') as HTMLElement).style.display = 'none';
  }

  ['period-date','cycle-len'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));

  // default today
  const today = new Date();
  const iso   = today.toISOString().split('T')[0];
  (document.getElementById('period-date') as HTMLInputElement).value = iso;
  calc();
</script>
