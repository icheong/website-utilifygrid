---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'ovulation-fertility-window')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:#0F172A; margin-bottom:1.25rem;">Ovulation &amp; Fertility Window Calculator</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.25rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">First Day of Last Period</label>
        <input id="period-date" type="date"
          style="width:100%; padding:0.625rem 0.875rem; border:1.5px solid #E2E8F0; border-radius:0.625rem; font-size:0.875rem; color:#0F172A; box-sizing:border-box; outline:none;"
          onfocus="this.style.borderColor='#DB2777'" onblur="this.style.borderColor='#E2E8F0'"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Average Cycle Length (days)</label>
        <input id="cycle-len" type="number" value="28" min="21" max="45"
          style="width:100%; padding:0.625rem 0.875rem; border:1.5px solid #E2E8F0; border-radius:0.625rem; font-size:0.95rem; color:#0F172A; box-sizing:border-box; outline:none;"
          onfocus="this.style.borderColor='#DB2777'" onblur="this.style.borderColor='#E2E8F0'"/>
      </div>
    </div>

    <div id="results" style="display:none; flex-direction:column; gap:0.75rem; margin-bottom:1.25rem;">
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.75rem;">
        <div style="background:#FDF2F8; border:1.5px solid #F9A8D4; border-radius:0.75rem; padding:0.875rem; text-align:center;">
          <div id="out-ovulation" style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:#DB2777;"></div>
          <div style="font-size:0.68rem; font-weight:600; color:#F472B6; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.04em;">Ovulation Day</div>
        </div>
        <div style="background:#FFF0F6; border:1.5px solid #FBCFE8; border-radius:0.75rem; padding:0.875rem; text-align:center;">
          <div id="out-window-start" style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:#9D174D;"></div>
          <div style="font-size:0.68rem; font-weight:600; color:#F9A8D4; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.04em;">Window Opens</div>
        </div>
        <div style="background:#FCE7F3; border:1.5px solid #F9A8D4; border-radius:0.75rem; padding:0.875rem; text-align:center;">
          <div id="out-window-end" style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:#9D174D;"></div>
          <div style="font-size:0.68rem; font-weight:600; color:#F9A8D4; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.04em;">Window Closes</div>
        </div>
      </div>

      <div id="out-next-period" style="background:#F1F5F9; border:1px solid #E2E8F0; border-radius:0.625rem; padding:0.75rem 1rem; font-size:0.85rem; color:#475569; text-align:center;"></div>

      <!-- Calendar grid -->
      <div style="background:#fff; border:1.5px solid #FBCFE8; border-radius:0.875rem; padding:1rem;">
        <div style="font-size:0.75rem; font-weight:600; color:#DB2777; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.75rem;">Cycle Calendar</div>
        <div id="calendar-grid" style="display:grid; grid-template-columns:repeat(7,1fr); gap:3px;"></div>
        <div style="display:flex; flex-wrap:wrap; gap:0.75rem; margin-top:0.75rem;">
          {[['#DB2777','#FDF2F8','Ovulation Day'],['#F472B6','#FFF0F6','Fertility Window'],['#94A3B8','#F8FAFC','Rest of Cycle']].map(([bg, light, label]) => (
            <div style="display:flex; align-items:center; gap:0.375rem;">
              <div style={`width:10px; height:10px; background:${light}; border:1.5px solid ${bg}; border-radius:3px;`}></div>
              <span style="font-size:0.72rem; color:#64748B;">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div id="placeholder" style="text-align:center; padding:2rem; color:#94A3B8; font-size:0.875rem;">Select a period start date to see your fertility window.</div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:#0F172A; margin-bottom:0.75rem;">How to use this tool</h2>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">Enter the first day of your most recent menstrual period and your average cycle length. If you are unsure of your cycle length, 28 days is the average. The calendar will highlight your predicted fertility window and ovulation day.</p>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75;">This tool provides estimates based on the standard calendar method. For more precise fertility tracking, combine it with basal body temperature charting and cervical mucus observation.</p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:#0F172A; margin-bottom:0.75rem;">How predictions are made</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;">
      {[
        ['Ovulation Day', 'Estimated as cycle length minus 14 days from period start. For a 28-day cycle, ovulation is around day 14. For a 32-day cycle, it is around day 18.'],
        ['Fertility Window', 'Sperm can survive up to 5 days in the fallopian tubes. The fertile window covers the 5 days before ovulation through to 1 day after ovulation — a 6-day window total.'],
        ['Cycle Variation', 'The luteal phase (ovulation to next period) is relatively constant at ~14 days. It is the follicular phase that varies, which is why irregular cycles make prediction harder.'],
        ['Limitations', 'This is a statistical estimation tool only. Cycle irregularity, stress, illness, and hormonal conditions (like PCOS) can shift ovulation significantly. This tool should not be used as contraception.'],
      ].map(([label, desc]) => (
        <div style="background:#fff; border:1px solid #E2E8F0; border-radius:0.625rem; padding:0.875rem 1rem;">
          <div style="font-size:0.82rem; font-weight:700; color:#0F172A; margin-bottom:0.3rem;">{label}</div>
          <p style="font-size:0.82rem; color:#64748B; line-height:1.6; margin:0;">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:#0F172A; margin-bottom:1.25rem;">Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'How accurate is the calendar method?', a: 'The calendar method is approximately 76–88% effective when used perfectly for avoiding pregnancy, but only about 75% with typical use. For conception purposes, it correctly identifies the fertile window in roughly 80% of cycles with regular periods. Cycle tracking apps that use additional signals (BBT, LH tests) are more accurate.' },
        { q: 'What is the most fertile day?', a: 'Conception probability is highest on ovulation day and the day before. The likelihood of conceiving follows a curve: roughly 10% on day 5 before ovulation, rising to 33% the day before, and 25% on ovulation day itself, then dropping to near zero afterwards.' },
        { q: 'How do I know if I am ovulating?', a: 'Signs of ovulation include: a rise in basal body temperature (0.2–0.5°C), egg-white cervical mucus (clear and stretchy), a positive LH surge on an ovulation test strip (available at pharmacies), and sometimes mild one-sided pelvic cramping (mittelschmerz).' },
        { q: 'Does this work for irregular cycles?', a: 'Calendar-based predictions are less reliable for cycles shorter than 21 days or longer than 35 days, or if your cycle length varies by more than 7–10 days month to month. In these cases, ovulation test strips, fertility monitors, or consultation with a doctor are more appropriate.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:#fff; border:1.5px solid #E2E8F0; border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:#0F172A; margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:#475569; line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const DAYS   = ['Su','Mo','Tu','We','Th','Fr','Sa'];

  function fmtDate(d: Date): string {
    return `${d.getDate()} ${MONTHS[d.getMonth()]}`;
  }

  function addDays(d: Date, n: number): Date {
    const r = new Date(d); r.setDate(r.getDate() + n); return r;
  }

  function calc() {
    const pd = (document.getElementById('period-date') as HTMLInputElement).value;
    const cl = parseInt((document.getElementById('cycle-len') as HTMLInputElement).value) || 28;
    if (!pd) return;

    const start     = new Date(pd + 'T00:00:00');
    const ovDay     = cl - 14;
    const ovDate    = addDays(start, ovDay);
    const winStart  = addDays(ovDate, -5);
    const winEnd    = addDays(ovDate, 1);
    const nextPeriod = addDays(start, cl);

    (document.getElementById('out-ovulation') as HTMLElement).textContent    = fmtDate(ovDate);
    (document.getElementById('out-window-start') as HTMLElement).textContent = fmtDate(winStart);
    (document.getElementById('out-window-end') as HTMLElement).textContent   = fmtDate(winEnd);
    (document.getElementById('out-next-period') as HTMLElement).textContent  = `Next period expected: ${fmtDate(nextPeriod)}`;

    // Build calendar
    const grid = document.getElementById('calendar-grid')!;
    grid.innerHTML = '';
    DAYS.forEach(d => {
      const h = document.createElement('div');
      h.textContent = d;
      h.style.cssText = 'font-size:0.65rem;font-weight:700;color:#94A3B8;text-align:center;padding:2px;';
      grid.appendChild(h);
    });

    const startDow = start.getDay();
    for (let i = 0; i < startDow; i++) {
      const blank = document.createElement('div'); grid.appendChild(blank);
    }

    for (let d = 0; d < cl; d++) {
      const date = addDays(start, d);
      const el   = document.createElement('div');
      el.textContent = String(date.getDate());
      const isOv  = d === ovDay;
      const isFW  = d >= ovDay - 5 && d <= ovDay + 1 && !isOv;
      el.style.cssText = [
        'font-size:0.72rem;text-align:center;padding:4px 2px;border-radius:4px;border:1.5px solid;',
        isOv  ? 'background:#FDF2F8;border-color:#DB2777;color:#DB2777;font-weight:700;' :
        isFW  ? 'background:#FFF0F6;border-color:#F9A8D4;color:#9D174D;font-weight:600;' :
                'background:#F8FAFC;border-color:#E2E8F0;color:#64748B;',
      ].join('');
      grid.appendChild(el);
    }

    (document.getElementById('results') as HTMLElement).style.display = 'flex';
    (document.getElementById('placeholder') as HTMLElement).style.display = 'none';
  }

  ['period-date','cycle-len'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));

  // default today
  const today = new Date();
  const iso   = today.toISOString().split('T')[0];
  (document.getElementById('period-date') as HTMLInputElement).value = iso;
  calc();
</script>
