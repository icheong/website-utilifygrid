---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'freelance-project-scope-estimator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Freelance Project Scope Estimator</h2>

    <div style="margin-bottom:1rem;">
      <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Your Hourly Rate ($)</label>
      <input id="hourly-rate" type="number" value="100" min="1" step="5"
        class="input-themed"
        style="width:200px;"/>
    </div>

    <div id="scope-list" style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1.25rem;"></div>

    <button id="add-item" class="btn-secondary" style="width:100%; padding:0.625rem; border-style:dashed;">+ Add Scope Item</button>

    <div style="background:linear-gradient(135deg,#4F46E5,#6366F1); border-radius:0.875rem; padding:1.25rem; color:#fff; margin-top:1.25rem; text-align:center;">
      <div style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; opacity:0.85; margin-bottom:0.25rem;">Total Estimate Range</div>
      <div style="font-family:'Sora',sans-serif; font-size:2.25rem; font-weight:700; letter-spacing:-0.02em;">
        $<span id="out-low">0</span> – $<span id="out-high">0</span>
      </div>
      <div style="font-size:0.82rem; opacity:0.75; margin-top:0.35rem;"><span id="out-hours">0</span> hrs estimated</div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Freelance Project Scope Estimator</h2>
    <p class="seo-p">Follow these steps to build an accurate project budget and deliver a professional, client-ready estimate.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Define Project Scope</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Select project type (web, app, design, etc.) and toggle the relevant deliverables on or off. Each pre-loaded item represents a common phase of a freelance project.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Set Hours and Rate</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Enter your hourly or daily rate, then adjust the minimum and maximum hours for each scope item. The estimator uses these values to calculate a realistic cost range.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Add Expenses</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Include hosting, licenses, travel, third-party services, and any other project-specific costs. Custom scope items let you account for expenses unique to your engagement.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Review Estimate</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">See your total budget range, per-phase breakdown, and margin assumptions at a glance. Use the low-to-high range when quoting clients so expectations stay realistic.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Freelance Project Scope Estimator Works</h2>
    <p class="seo-p">The estimator applies a transparent cost model so you can understand every number in your quote.</p>
    <h3 class="font-display seo-h3-sm">Scope-Based Cost Model</h3>
    <p class="seo-p">Each project type comes with a set of <code class="inline-code">scope items</code> representing typical deliverables such as discovery, design, development, and testing. You assign a <code class="inline-code">minimum hours</code> and <code class="inline-code">maximum hours</code> estimate to every active item. The low total is the sum of all enabled minimums multiplied by your rate; the high total is the sum of all maximums. This produces a realistic budget range rather than a single fragile number.</p>
    <h3 class="font-display seo-h3-sm">Expense and Overhead Calculation</h3>
    <p class="seo-p">Beyond hourly labor, the tool lets you add custom items for fixed costs such as <code class="inline-code">hosting</code>, <code class="inline-code">software licenses</code>, <code class="inline-code">travel</code>, and <code class="inline-code">third-party services</code>. Each custom item contributes directly to the total, ensuring your estimate captures the full cost of delivery, not just your personal time.</p>
    <h3 class="font-display seo-h3-sm">Margin and Contingency Analysis</h3>
    <p class="seo-p">The difference between the low and high estimates creates a natural <code class="inline-code">contingency buffer</code>. This spread covers scope refinements, client revisions, and unexpected issues without requiring a separate markup. When presenting to clients, the range lets you anchor the conversation around a fair midpoint while preserving room for profit.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Should I quote fixed price or hourly?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Fixed-price projects give clients budget certainty and let you earn more when you work efficiently. Hourly billing suits ongoing or poorly defined work where scope changes frequently. Many freelancers combine the two, charging a fixed price for discovery and design, hourly for development, and a monthly retainer for maintenance.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I handle scope creep?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Prevent scope creep by including a detailed scope document with your quote that lists what is excluded and how many revision rounds are covered. Use a formal change order process for any additions requested mid-project. The earlier you set these boundaries, the less friction you will face during execution.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What contingency should I add to estimates?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A common approach is to build a 20 to 30 percent buffer into your estimate to cover client communication overhead, unexpected technical issues, and revision rounds. Less experienced freelancers may want to start at 40 to 50 percent until they have calibrated their estimation accuracy against real project outcomes.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How should I present this estimate to a client?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Present a range such as $4,500 to $6,000 rather than a single figure, paired with a clear breakdown by deliverable. Explain that the range depends on final scope decisions and revision rounds. This sets honest expectations and makes the lower end feel like a win for the client.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I estimate hours for a project I have not done before?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Break the project into smaller, familiar tasks and estimate each one individually. Research similar projects on freelance platforms or speak with peers who have built comparable products. Start with your best guess, then add a higher contingency buffer until you have real data from your own completed projects.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Should I include contingency in my freelance quote?</h3>
        <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. Every freelance project carries uncertainty, and contingency protects both you and the client from surprise costs. Build it into your rate or hour range rather than listing it as a separate line item so the quote remains clean. When scope stays within bounds, the contingency becomes additional profit; when it does not, it absorbs the overage without requiring renegotiation.</p>
        </div>
      </div>
    </div>
    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7; padding:1rem 1.25rem; border-radius:0.5rem">
      <strong style="display:block; margin-bottom:0.35rem">Disclaimer</strong>
      This tool provides budget estimates for project planning only. Actual project costs depend on scope changes, contractor rates, local market conditions, and unforeseen issues. Always obtain professional quotes.
    </div>
  </div>

</ToolLayout>

<script>
  interface ScopeItem { id: number; label: string; min: number; max: number; enabled: boolean; }

  let nextId = 0;
  let items: ScopeItem[] = [
    { id: nextId++, label: 'Discovery & requirements',      min: 4,  max: 8,  enabled: true },
    { id: nextId++, label: 'UI / UX design (wireframes)',   min: 8,  max: 16, enabled: true },
    { id: nextId++, label: 'Frontend development',          min: 16, max: 40, enabled: true },
    { id: nextId++, label: 'Backend / API development',     min: 12, max: 30, enabled: false },
    { id: nextId++, label: 'Database design & migrations',  min: 4,  max: 10, enabled: false },
    { id: nextId++, label: 'QA & testing',                  min: 6,  max: 12, enabled: true },
    { id: nextId++, label: 'DevOps / deployment setup',     min: 4,  max: 10, enabled: false },
    { id: nextId++, label: 'Third-party integrations',      min: 6,  max: 16, enabled: false },
    { id: nextId++, label: 'Client revisions (2 rounds)',   min: 4,  max: 8,  enabled: true },
    { id: nextId++, label: 'Project management & comms',    min: 4,  max: 8,  enabled: true },
  ];

  function getRate(): number {
    return parseFloat((document.getElementById('hourly-rate') as HTMLInputElement)?.value) || 100;
  }

  function updateTotals() {
    const rate   = getRate();
    const active = items.filter(i => i.enabled);
    const minHrs = active.reduce((s, i) => s + i.min, 0);
    const maxHrs = active.reduce((s, i) => s + i.max, 0);
    (document.getElementById('out-low') as HTMLElement).textContent   = (minHrs * rate).toLocaleString();
    (document.getElementById('out-high') as HTMLElement).textContent  = (maxHrs * rate).toLocaleString();
    (document.getElementById('out-hours') as HTMLElement).textContent = minHrs === maxHrs ? String(minHrs) : `${minHrs}–${maxHrs}`;
  }

  function renderList() {
    const list = document.getElementById('scope-list')!;
    list.innerHTML = '';
    items.forEach(item => {
      const row = document.createElement('div');
      row.className = 'result-card';
      row.style.cssText = 'display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.75rem;';
      row.innerHTML = `
        <input type="checkbox" ${item.enabled ? 'checked' : ''} data-id="${item.id}" style="accent-color:var(--color-brand-blue);width:16px;height:16px;cursor:pointer;flex-shrink:0;"/>
        <input type="text" value="${item.label}" data-id="${item.id}" data-field="label"
          style="flex:1;border:none;outline:none;font-size:0.85rem;color:var(--text-primary);background:transparent;min-width:0;"/>
        <input type="number" value="${item.min}" min="0" data-id="${item.id}" data-field="min"
          style="width:52px;padding:0.2rem 0.4rem;border:1px solid var(--border);border-radius:0.35rem;font-size:0.78rem;text-align:center;color:var(--text-secondary);outline:none;background:var(--bg-surface);"/>
        <span style="font-size:0.72rem;color:var(--text-muted);">–</span>
        <input type="number" value="${item.max}" min="0" data-id="${item.id}" data-field="max"
          style="width:52px;padding:0.2rem 0.4rem;border:1px solid var(--border);border-radius:0.35rem;font-size:0.78rem;text-align:center;color:var(--text-secondary);outline:none;background:var(--bg-surface);"/>
        <span style="font-size:0.72rem;color:var(--text-muted);">hrs</span>
        <button data-id="${item.id}" data-action="remove" style="background:none;border:none;cursor:pointer;color:var(--text-muted);font-size:1.1rem;padding:0;line-height:1;flex-shrink:0;">×</button>
      `;
      list.appendChild(row);
    });

    list.querySelectorAll('input[type="checkbox"]').forEach(el => {
      el.addEventListener('change', (e) => {
        const id = parseInt((e.target as HTMLInputElement).dataset.id!);
        const i  = items.find(x => x.id === id)!;
        i.enabled = (e.target as HTMLInputElement).checked;
        updateTotals();
      });
    });

    list.querySelectorAll('input[type="text"], input[type="number"]').forEach(el => {
      el.addEventListener('input', (e) => {
        const inp   = e.target as HTMLInputElement;
        const id    = parseInt(inp.dataset.id!);
        const field = inp.dataset.field!;
        const item  = items.find(x => x.id === id)!;
        if (field === 'label') item.label = inp.value;
        else (item as any)[field] = parseInt(inp.value) || 0;
        updateTotals();
      });
    });

    list.querySelectorAll('[data-action="remove"]').forEach(el => {
      el.addEventListener('click', (e) => {
        const id = parseInt((e.currentTarget as HTMLElement).dataset.id!);
        items = items.filter(x => x.id !== id);
        renderList(); updateTotals();
      });
    });
  }

  document.getElementById('add-item')?.addEventListener('click', () => {
    items.push({ id: nextId++, label: 'New scope item', min: 4, max: 8, enabled: true });
    renderList(); updateTotals();
  });

  document.getElementById('hourly-rate')?.addEventListener('input', updateTotals);

  renderList();
  updateTotals();
</script>
