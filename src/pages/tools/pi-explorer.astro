---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'pi-explorer')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
      <span style="font-size:1.5rem; line-height:1;">&#x03c0;</span>
      <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin:0;">Pi Explorer</h2>
    </div>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">The infinite geometric constant visualised as a 3D bicycle wheel. Watch the circumference unroll to reveal exactly 3 full lengths plus the 0.14159&#x2026; remainder.</p>

    <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:1rem; align-items:center;">
      <button id="btn-unroll" class="btn-primary" type="button">Unroll Circumference</button>
      <button id="btn-reset" class="btn-secondary" type="button">Reset</button>
      <div style="margin-left:auto; display:flex; gap:0.5rem; align-items:center;">
        <label class="tool-label" style="margin:0;">Speed</label>
        <input id="speed-slider" type="range" min="0.2" max="3" step="0.1" value="1" style="width:80px; accent-color:#1D4ED8;" />
      </div>
    </div>

    <div id="pi-canvas-wrap" style="width:100%; aspect-ratio:16/9; border-radius:0.75rem; overflow:hidden; border:1.5px solid var(--border); background:#0a1628; position:relative;">
      <canvas id="pi-canvas"></canvas>
      <div id="pi-overlay" style="position:absolute; bottom:0.75rem; left:0.75rem; font-family:'Fira Code',monospace; font-size:0.75rem; color:#94A3B8; pointer-events:none;">
        <span id="pi-status">Drag to orbit &#x00b7; Scroll to zoom</span>
      </div>
    </div>

    <div style="margin-top:1.25rem; padding:1rem; background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin:0 0 0.5rem;">Search the Infinite Library</h3>
      <p style="font-size:0.78rem; color:var(--text-muted); margin-bottom:0.75rem;">Enter a number (birthday, phone number, etc.) to fly through a 3D library of digit cubes and find where your sequence appears in pi's decimals.</p>
      <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
        <input id="search-input" type="text" class="input-themed" placeholder="e.g. 19900415 or 5551234567" style="flex:1; min-width:180px; font-family:'Fira Code',monospace; font-size:0.85rem;" maxlength="20" />
        <button id="btn-search" class="btn-primary" type="button">Search</button>
      </div>
      <div id="search-result" style="margin-top:0.75rem; font-size:0.82rem; color:var(--text-secondary); display:none;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Pi Explorer Overview</h2>
    <p class="seo-p">
      Pi is the ratio of a circle's circumference to its diameter, approximately equal to 3.14159265&#x2026;. This interactive 3D tool demonstrates that relationship using a bicycle wheel metaphor: the circumference of a wheel is exactly pi times its diameter. By unrolling the circumference onto a flat line, you can physically see that it takes exactly 3 full lengths of the diameter plus a small remainder of approximately 0.14159 to wrap around the entire tire.
    </p>
    <p class="seo-p">
      The tool renders a three-dimensional bicycle wheel using WebGL and Three.js, with spokes, a tyre, and a rim that can be rotated freely in 3D space. Click <strong>Unroll Circumference</strong> to animate the tyre separating from the rim and laying flat, revealing three complete diameter-length segments plus the fractional pi remainder. Adjust the animation speed with the slider, or drag and scroll to orbit the camera around the scene.
    </p>

    <h3 class="seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Teaching circle geometry in classrooms', 'Educators can project the 3D wheel onto a screen and animate the unrolling process to give students a tangible, visual proof that pi relates circumference to diameter. The animation makes an abstract ratio concrete by showing exactly how many diameter-lengths fit around a circle.'],
        ['Engineering and manufacturing design', 'Mechanical engineers calculating belt lengths, pulley systems, or gear ratios rely on pi to convert between rotational and linear dimensions. This tool helps visualise why that conversion factor exists and how it manifests in physical systems like bicycle wheels or conveyor belts.'],
        ['Understanding irrational number density', 'The library search feature demonstrates that pi is normal in base 10: every finite digit sequence appears somewhere in its decimal expansion. Students can search for their birthday, phone number, or any meaningful sequence to experience the surprising ubiquity of patterns within irrational numbers.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Circumference Geometry and the Digit Library</h2>
    <p class="seo-p">
      The fundamental relationship expressed by pi is <code class="inline-code">C = pi x d</code>, where C is the circumference and d is the diameter. This means if you take the diameter of any circle and lay it end-to-end along the circumference, you need exactly pi copies to cover the full loop. Since pi is approximately 3.14159, that is 3 complete diameter-lengths plus approximately 0.14159 of a fourth.
    </p>
    <h3 class="seo-h3-sm">The Bicycle Wheel Metaphor</h3>
    <p class="seo-p">
      The visualisation models a bicycle wheel with a tyre of configurable radius. The tyre's circumference is computed as <code class="inline-code">2 x pi x r</code>, and the diameter as <code class="inline-code">2r</code>. During the unroll animation, the tyre mesh is deformed from a torus shape into a flat line segment. Three evenly-spaced markers along the flat segment show where each complete diameter-length ends, and the final segment displays the 0.14159&#x2026; remainder. The animation uses cubic easing for smooth deceleration.
    </p>
    <h3 class="seo-h3-sm">The Infinite Digit Library</h3>
    <p class="seo-p">
      The search feature accesses a pre-computed string of pi's decimal digits (first 100,000 digits). When a user enters a sequence, the tool scans this string using a naive substring search and returns the position of the first occurrence. If the sequence is found, the camera animates through a 3D library where each digit of pi is rendered as a floating cube. The camera flies to the cube at the matching position, highlighting it with a glowing outline to mark the discovery.
    </p>
    <h3 class="seo-h3-sm">Normality and Digit Distribution</h3>
    <p class="seo-p-none">
      Pi is conjectured to be a normal number in base 10, meaning every finite digit sequence appears with equal asymptotic frequency. While this has not been formally proven, computational analysis of the first 100,000 digits shows a distribution consistent with normality: each digit 0-9 appears roughly 10% of the time, and all 2-digit, 3-digit, and 4-digit combinations appear with expected frequency. The library search demonstrates this empirically by finding user-provided sequences quickly.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: 'What is pi and why does it matter?',
          a: 'Pi is the mathematical constant representing the ratio of any circle\'s circumference to its diameter. Its value is approximately 3.14159265 and it continues infinitely without repeating. Pi appears throughout mathematics, from basic geometry and trigonometry to Fourier analysis, probability theory, and quantum physics. It is fundamental to any calculation involving circles, spheres, or periodic phenomena.'
        },
        {
          q: 'How many digits of pi does this tool use?',
          a: 'The tool stores the first 100,000 decimal digits of pi, which is sufficient for most educational and recreational searches. This represents pi accurate to about 0.00001%, far beyond the precision needed for any practical engineering calculation. For context, NASA uses only 15 decimal places for interplanetary navigation.'
        },
        {
          q: 'Can I find my birthday in pi?',
          a: 'Yes. Enter your birthdate as a continuous number (e.g., 19900415 for April 15, 1990) into the search box. If the sequence appears within the first 100,000 digits, the tool will locate it and fly the camera to that position in the 3D library. Most 8-digit dates are found, though some may not appear in this range due to the random distribution of digits.'
        },
        {
          q: 'Is pi truly infinite, or does it eventually end?',
          a: 'Pi is a proven irrational number, meaning its decimal representation never terminates and never enters a repeating pattern. This was first proven by Johann Lambert in 1761. The digits continue forever in a sequence that passes every known statistical test for randomness, though no one has proven that pi is a normal number.'
        },
        {
          q: 'Why does the bicycle wheel show exactly 3 full lengths?',
          a: 'The diameter of a circle fits into its circumference exactly pi times. Since pi is approximately 3.14159, that means 3 complete diameter-lengths cover most of the circumference, leaving a remainder of approximately 0.14159 of a diameter. The unroll animation makes this visible by laying the tyre flat and marking where each diameter-length ends.'
        },
        {
          q: 'Does this tool work offline?',
          a: 'The tool runs entirely in the browser using WebGL for 3D rendering and vanilla JavaScript for pi digit search. No server communication is required after the initial page load. Once the page is cached, all calculations, animations, and searches happen locally on your device with zero data sent externally.'
        }
      ].map((item) => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
             class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7">
      <strong class="text-primary" style="color:var(--text-secondary)">Disclaimer:</strong> This tool is for educational and visualisation purposes only. Pi digit data is sourced from published computational results. The 3D visualisation is an approximation and should not be used for precision engineering calculations.
    </div>
  </div>

</ToolLayout>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script is:inline src="/pi-digits.js"></script>
<script is:inline>
(function() {
  var PI_DIGITS = window.PI_DIGITS || '';
  var THREE = window.THREE;
  if (!THREE || PI_DIGITS.length < 100) {
    var st = document.getElementById('pi-status');
    if (st) st.textContent = 'Failed to load 3D engine or pi digits';
    return;
  }

  var canvas = document.getElementById('pi-canvas');
  var wrap = document.getElementById('pi-canvas-wrap');
  var statusEl = document.getElementById('pi-status');
  var resultEl = document.getElementById('search-result');
  var searchInput = document.getElementById('search-input');
  var speedSlider = document.getElementById('speed-slider');
  var W, H;

  function resize() {
    W = wrap.clientWidth; H = wrap.clientHeight;
    canvas.width = W * devicePixelRatio;
    canvas.height = H * devicePixelRatio;
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    renderer.setSize(W, H);
    camera.aspect = W / H;
    camera.updateProjectionMatrix();
  }

  var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: false });
  renderer.setPixelRatio(devicePixelRatio);
  renderer.setClearColor(0x0a1628);

  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(50, W / H, 0.1, 500);
  resize();
  camera.position.set(0, 4, 10);
  camera.lookAt(0, 0, 0);

  scene.add(new THREE.AmbientLight(0xffffff, 0.5));
  var dl = new THREE.DirectionalLight(0xffffff, 0.8);
  dl.position.set(5, 8, 5);
  scene.add(dl);

  var wheelGroup = new THREE.Group();
  scene.add(wheelGroup);

  var R = 2;
  var tyreMat = new THREE.MeshPhongMaterial({ color: 0x222222, emissive: 0x111111 });
  var rimMat = new THREE.MeshPhongMaterial({ color: 0x888888, emissive: 0x333333 });
  var spokeMat = new THREE.MeshPhongMaterial({ color: 0xaaaaaa });

  var tyreGeo = new THREE.TorusGeometry(R, 0.12, 16, 64);
  var tyreMesh = new THREE.Mesh(tyreGeo, tyreMat);
  wheelGroup.add(tyreMesh);

  var rimGeo = new THREE.TorusGeometry(R - 0.15, 0.06, 8, 64);
  var rimMesh = new THREE.Mesh(rimGeo, rimMat);
  wheelGroup.add(rimMesh);

  var hubGeo = new THREE.CylinderGeometry(0.15, 0.15, 0.3, 16);
  var hub = new THREE.Mesh(hubGeo, rimMat);
  hub.rotation.x = Math.PI / 2;
  wheelGroup.add(hub);

  for (var i = 0; i < 16; i++) {
    var a = (i / 16) * Math.PI * 2;
    var sg = new THREE.CylinderGeometry(0.015, 0.015, R - 0.2, 4);
    var sp = new THREE.Mesh(sg, spokeMat);
    sp.position.set(Math.cos(a) * (R / 2 - 0.1), Math.sin(a) * (R / 2 - 0.1), 0);
    sp.rotation.z = a - Math.PI / 2;
    wheelGroup.add(sp);
  }

  var diam = 2 * R;
  var circ = Math.PI * diam;

  var lineGeo = new THREE.BufferGeometry();
  var lineVerts = new Float32Array([0, 0, 0, circ, 0, 0]);
  lineGeo.setAttribute('position', new THREE.BufferAttribute(lineVerts, 3));
  var lineMat = new THREE.LineBasicMaterial({ color: 0x4444ff, linewidth: 2 });
  var lineMesh = new THREE.Line(lineGeo, lineMat);
  lineMesh.visible = false;
  scene.add(lineMesh);

  var markMat = new THREE.MeshBasicMaterial({ color: 0xffcc00 });
  var markers = [];
  for (var m = 1; m <= 3; m++) {
    var mg = new THREE.SphereGeometry(0.08, 12, 12);
    var mk = new THREE.Mesh(mg, markMat);
    mk.position.set(m * diam, 0.15, 0);
    mk.visible = false;
    scene.add(mk);
    markers.push(mk);
  }

  var remGeo = new THREE.BoxGeometry((Math.PI - 3) * diam, 0.1, 0.1);
  var remMat2 = new THREE.MeshBasicMaterial({ color: 0xff4444 });
  var remMesh = new THREE.Mesh(remGeo, remMat2);
  remMesh.position.set(3 * diam + ((Math.PI - 3) * diam) / 2, -0.15, 0);
  remMesh.visible = false;
  scene.add(remMesh);

  var labelCanvas = document.createElement('canvas');
  labelCanvas.width = 512;
  labelCanvas.height = 64;
  var lctx = labelCanvas.getContext('2d');
  lctx.fillStyle = 'rgba(10,22,40,0.85)';
  lctx.fillRect(0, 0, 512, 64);
  lctx.fillStyle = '#ffffff';
  lctx.font = 'bold 28px monospace';
  lctx.textAlign = 'center';
  lctx.fillText('3\u00D7d + 0.14159\u2026 = \u03C0\u00D7d', 256, 42);
  var labelTex = new THREE.CanvasTexture(labelCanvas);
  var labelMat = new THREE.SpriteMaterial({ map: labelTex, transparent: true });
  var labelSprite = new THREE.Sprite(labelMat);
  labelSprite.position.set(circ / 2, 0.6, 0);
  labelSprite.scale.set(4, 0.5, 1);
  labelSprite.visible = false;
  scene.add(labelSprite);

  var unrolling = false;
  var unrollProgress = 0;
  var unrollTarget = 0;
  var searchMode = false;
  var cubes = [];
  var cubeGroup = new THREE.Group();
  scene.add(cubeGroup);

  var digitColors = [
    0xff4444, 0xff8844, 0xffcc00, 0x88ff00, 0x00cc88,
    0x0088ff, 0x4444ff, 0x8844ff, 0xcc44ff, 0xff4488
  ];

  document.getElementById('btn-unroll').addEventListener('click', function() {
    if (unrolling) return;
    searchMode = false;
    cubeGroup.visible = false;
    camera.position.set(0, 4, 10);
    camera.lookAt(0, 0, 0);
    wheelGroup.visible = true;
    lineMesh.visible = true;
    remMesh.visible = true;
    labelSprite.visible = true;
    markers.forEach(function(mk) { mk.visible = true; });
    unrolling = true;
    unrollTarget = 1;
  });

  document.getElementById('btn-reset').addEventListener('click', function() {
    unrolling = false;
    unrollProgress = 0;
    unrollTarget = 0;
    searchMode = false;
    tyreMesh.scale.set(1, 1, 1);
    tyreMesh.rotation.set(0, 0, 0);
    lineMesh.visible = false;
    remMesh.visible = false;
    labelSprite.visible = false;
    markers.forEach(function(mk) { mk.visible = false; });
    cubeGroup.visible = false;
    cubes.forEach(function(c) { cubeGroup.remove(c); });
    cubes = [];
    wheelGroup.visible = true;
    camera.position.set(0, 4, 10);
    camera.lookAt(0, 0, 0);
    statusEl.textContent = 'Drag to orbit \u00B7 Scroll to zoom';
  });

  document.getElementById('btn-search').addEventListener('click', doSearch);
  searchInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') doSearch(); });

  function doSearch() {
    var q = searchInput.value.trim();
    if (!q || !/^\d+$/.test(q)) {
      resultEl.style.display = 'block';
      resultEl.textContent = 'Please enter digits only (e.g. 19900415).';
      return;
    }
    var idx = PI_DIGITS.indexOf(q);
    if (idx === -1) {
      resultEl.style.display = 'block';
      resultEl.textContent = '"' + q + '" not found in the first 100,000 digits of pi.';
      return;
    }
    resultEl.style.display = 'block';
    resultEl.textContent = 'Found! ' + q + ' appears at position ' + (idx + 1) + ' after the decimal point. Flying to digit ' + (idx + 1) + '...';

    unrolling = false;
    unrollProgress = 0;
    wheelGroup.visible = false;
    lineMesh.visible = false;
    remMesh.visible = false;
    labelSprite.visible = false;
    markers.forEach(function(mk) { mk.visible = false; });
    cubes.forEach(function(c) { cubeGroup.remove(c); });
    cubes = [];
    cubeGroup.visible = true;
    searchMode = true;

    var startPos = Math.max(0, idx - 40);
    var endPos = Math.min(PI_DIGITS.length, idx + 40);
    var spacing = 0.8;

    for (var i = startPos; i < endPos; i++) {
      var d = parseInt(PI_DIGITS[i]);
      var geo = new THREE.BoxGeometry(0.5, 0.5, 0.5);
      var mat = new THREE.MeshPhongMaterial({
        color: digitColors[d],
        emissive: digitColors[d],
        emissiveIntensity: 0.2
      });
      var cube = new THREE.Mesh(geo, mat);
      var x = (i - idx) * spacing;
      var y = Math.sin(i * 0.3) * 1.5;
      var z = Math.cos(i * 0.3) * 1.5;
      cube.position.set(x, y, z);
      cube.userData.digit = d;
      cube.userData.pos = i;
      cubeGroup.add(cube);
      cubes.push(cube);

      if (i === idx) {
        var glowMat = new THREE.MeshBasicMaterial({ color: 0xffff00, wireframe: true });
        var glow = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.7, 0.7), glowMat);
        cube.add(glow);
        cube.scale.set(1.5, 1.5, 1.5);
      }
    }

    camera.position.set(0, 10, 18);
    camera.lookAt(0, 0, 0);
    targetCamPos = { x: 0, y: 0, z: 4 };
    targetLookAt = { x: 0, y: 0, z: 0 };
    camAnimating = true;
    camT = 0;
  }

  var camAnimating = false;
  var camT = 0;
  var camFrom = { x: 0, y: 10, z: 18 };
  var camTo = { x: 0, y: 0, z: 4 };
  var lookFrom = { x: 0, y: 0, z: 0 };
  var lookTo = { x: 0, y: 0, z: 0 };
  var targetCamPos, targetLookAt;

  function lerp(a, b, t) { return a + (b - a) * t; }
  function ease(t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }

  var dragging = false;
  var lastMouse = { x: 0, y: 0 };
  var spherical = { r: 10, theta: Math.PI / 6, phi: Math.PI / 2 };

  function updateCameraFromSpherical() {
    camera.position.x = spherical.r * Math.sin(spherical.phi) * Math.cos(spherical.theta);
    camera.position.y = spherical.r * Math.cos(spherical.phi);
    camera.position.z = spherical.r * Math.sin(spherical.phi) * Math.sin(spherical.theta);
    camera.lookAt(0, 0, 0);
  }

  canvas.addEventListener('mousedown', function(e) {
    dragging = true;
    camAnimating = false;
    lastMouse.x = e.clientX;
    lastMouse.y = e.clientY;
  });
  canvas.addEventListener('mousemove', function(e) {
    if (!dragging) return;
    var dx = e.clientX - lastMouse.x;
    var dy = e.clientY - lastMouse.y;
    spherical.theta -= dx * 0.005;
    spherical.phi = Math.max(0.1, Math.min(Math.PI - 0.1, spherical.phi - dy * 0.005));
    lastMouse.x = e.clientX;
    lastMouse.y = e.clientY;
    updateCameraFromSpherical();
  });
  canvas.addEventListener('mouseup', function() { dragging = false; });
  canvas.addEventListener('mouseleave', function() { dragging = false; });
  canvas.addEventListener('wheel', function(e) {
    e.preventDefault();
    spherical.r = Math.max(3, Math.min(30, spherical.r + e.deltaY * 0.01));
    updateCameraFromSpherical();
  }, { passive: false });

  window.addEventListener('resize', resize);

  var clock = new THREE.Clock();

  function animate() {
    requestAnimationFrame(animate);
    var dt = clock.getDelta();
    var speed = parseFloat(speedSlider.value) || 1;

    if (unrolling && unrollProgress < unrollTarget) {
      unrollProgress = Math.min(unrollProgress + dt * speed * 0.4, unrollTarget);
      var t = ease(unrollProgress);
      tyreMesh.rotation.x = t * Math.PI * 2;
      tyreMesh.scale.x = 1 - t * 0.7;
      tyreMesh.scale.y = 1 + t * 0.3;
      tyreMesh.position.x = t * circ * 0.05;
      statusEl.textContent = 'Unrolling: ' + Math.round(t * 100) + '% \u00B7 C = 3d + 0.14159\u2026d';
    }

    if (camAnimating) {
      camT = Math.min(camT + dt * 0.8, 1);
      var et = ease(camT);
      camera.position.x = lerp(camFrom.x, targetCamPos.x, et);
      camera.position.y = lerp(camFrom.y, targetCamPos.y, et);
      camera.position.z = lerp(camFrom.z, targetCamPos.z, et);
      camera.lookAt(
        lerp(lookFrom.x, targetLookAt.x, et),
        lerp(lookFrom.y, targetLookAt.y, et),
        lerp(lookFrom.z, targetLookAt.z, et)
      );
      if (camT >= 1) camAnimating = false;
    }

    if (searchMode && !camAnimating) {
      var t2 = clock.elapsedTime * 0.5;
      camera.position.x = Math.sin(t2) * 3;
      camera.position.y = Math.cos(t2 * 0.7) * 1.5;
      camera.position.z = 4 + Math.sin(t2 * 0.3);
      camera.lookAt(0, 0, 0);
    }

    cubes.forEach(function(c) {
      c.rotation.y += dt * 0.5;
      c.rotation.x += dt * 0.3;
    });

    renderer.render(scene, camera);
  }
  animate();
})();
</script>
