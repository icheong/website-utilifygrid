---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'bulk-case-mutator')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">

    <!-- ── Header ── -->
    <div style="display:flex; align-items:center; gap:0.875rem; margin-bottom:1.5rem;">
      <div style="width:2.5rem; height:2.5rem; border-radius:0.625rem; background:linear-gradient(135deg,#312e81,#4338ca); display:flex; align-items:center; justify-content:center; flex-shrink:0; box-shadow:0 4px 14px rgba(99,102,241,0.4); border:1px solid rgba(196,157,78,0.4);">
        <span style="font-family:'Fira Code',monospace; font-size:0.7rem; font-weight:800; color:#c49d4e; letter-spacing:-0.03em;">Aa</span>
      </div>
      <div>
        <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin:0 0 0.15rem;">Bulk String Case Mutator</h2>
        <p style="font-size:0.76rem; color:var(--text-muted); margin:0;">Paste identifiers — see every case variant instantly. Click a row to copy.</p>
      </div>
    </div>

    <!-- ── Input ── -->
    <div style="margin-bottom:1rem;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.45rem;">
        <label style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted);">Input — one identifier per line</label>
        <div style="display:flex; gap:0.5rem;">
          <button id="bcm-sample" style="font-size:0.68rem; color:#818cf8; background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">sample</button>
          <button id="bcm-clear" style="font-size:0.68rem; color:var(--text-muted); background:none; border:none; cursor:pointer; font-weight:700; padding:0; transition:opacity 0.15s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';">clear</button>
        </div>
      </div>
      <textarea id="bcm-input"
        placeholder="getUserProfile&#10;fetch_api_data&#10;MyComponentName&#10;background-color"
        rows="4"
        style="width:100%; box-sizing:border-box; resize:vertical; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.82rem; color:var(--text-primary); line-height:1.65; outline:none; transition:border-color 0.15s;"
        onfocus="this.style.borderColor='#818cf8'; this.style.boxShadow='0 0 0 3px rgba(129,140,248,0.12)';"
        onblur="this.style.borderColor='var(--border)'; this.style.boxShadow='none';"
      ></textarea>
    </div>

    <!-- ── Case format selector bar ── -->
    <div style="display:flex; flex-wrap:wrap; gap:0.4rem; margin-bottom:1.1rem; padding:0.625rem 0.875rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem; align-items:center;">
      <span style="font-size:0.65rem; font-weight:800; text-transform:uppercase; letter-spacing:0.09em; color:var(--text-muted); margin-right:0.25rem; flex-shrink:0;">Show:</span>
      <label id="toggle-camel" class="case-toggle case-active" data-case="camel"
        style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.65rem; border-radius:999px; border:1.5px solid #818cf8; background:rgba(129,140,248,0.12); cursor:pointer; user-select:none; transition:all 0.15s;">
        <input type="checkbox" checked style="display:none;"/>
        <span style="font-size:0.68rem; font-weight:700; color:#818cf8; font-family:'Fira Code',monospace;">camelCase</span>
      </label>
      <label id="toggle-pascal" class="case-toggle case-active" data-case="pascal"
        style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.65rem; border-radius:999px; border:1.5px solid #818cf8; background:rgba(129,140,248,0.12); cursor:pointer; user-select:none; transition:all 0.15s;">
        <input type="checkbox" checked style="display:none;"/>
        <span style="font-size:0.68rem; font-weight:700; color:#818cf8; font-family:'Fira Code',monospace;">PascalCase</span>
      </label>
      <label id="toggle-snake" class="case-toggle case-active" data-case="snake"
        style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.65rem; border-radius:999px; border:1.5px solid #818cf8; background:rgba(129,140,248,0.12); cursor:pointer; user-select:none; transition:all 0.15s;">
        <input type="checkbox" checked style="display:none;"/>
        <span style="font-size:0.68rem; font-weight:700; color:#818cf8; font-family:'Fira Code',monospace;">snake_case</span>
      </label>
      <label id="toggle-screaming" class="case-toggle case-active" data-case="screaming"
        style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.65rem; border-radius:999px; border:1.5px solid #818cf8; background:rgba(129,140,248,0.12); cursor:pointer; user-select:none; transition:all 0.15s;">
        <input type="checkbox" checked style="display:none;"/>
        <span style="font-size:0.68rem; font-weight:700; color:#818cf8; font-family:'Fira Code',monospace;">SCREAMING_SNAKE</span>
      </label>
      <label id="toggle-kebab" class="case-toggle case-active" data-case="kebab"
        style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.65rem; border-radius:999px; border:1.5px solid #818cf8; background:rgba(129,140,248,0.12); cursor:pointer; user-select:none; transition:all 0.15s;">
        <input type="checkbox" checked style="display:none;"/>
        <span style="font-size:0.68rem; font-weight:700; color:#818cf8; font-family:'Fira Code',monospace;">kebab-case</span>
      </label>
      <label id="toggle-title" class="case-toggle case-active" data-case="title"
        style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.65rem; border-radius:999px; border:1.5px solid #818cf8; background:rgba(129,140,248,0.12); cursor:pointer; user-select:none; transition:all 0.15s;">
        <input type="checkbox" checked style="display:none;"/>
        <span style="font-size:0.68rem; font-weight:700; color:#818cf8; font-family:'Fira Code',monospace;">Title Case</span>
      </label>
      <label id="toggle-upper" class="case-toggle case-active" data-case="upper"
        style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.65rem; border-radius:999px; border:1.5px solid #818cf8; background:rgba(129,140,248,0.12); cursor:pointer; user-select:none; transition:all 0.15s;">
        <input type="checkbox" checked style="display:none;"/>
        <span style="font-size:0.68rem; font-weight:700; color:#818cf8; font-family:'Fira Code',monospace;">UPPER</span>
      </label>
      <label id="toggle-lower" class="case-toggle case-active" data-case="lower"
        style="display:flex; align-items:center; gap:0.3rem; padding:0.25rem 0.65rem; border-radius:999px; border:1.5px solid #818cf8; background:rgba(129,140,248,0.12); cursor:pointer; user-select:none; transition:all 0.15s;">
        <input type="checkbox" checked style="display:none;"/>
        <span style="font-size:0.68rem; font-weight:700; color:#818cf8; font-family:'Fira Code',monospace;">lower</span>
      </label>
    </div>

    <!-- ── Type specimen output ── -->
    <div id="specimen-grid" style="display:flex; flex-direction:column; gap:0; border:1.5px solid var(--border); border-radius:0.875rem; overflow:hidden;">
      <!-- Empty state -->
      <div id="specimen-empty" style="padding:2.5rem; text-align:center; color:var(--text-muted); font-size:0.82rem;">
        <div style="font-size:2rem; margin-bottom:0.5rem;">Aa</div>
        Type or paste identifiers above to see all case variants here.<br/>
        <span style="font-size:0.72rem; opacity:0.7;">Click any row to copy that variant.</span>
      </div>
    </div>

    <!-- ── Copy-all footer ── -->
    <div id="copy-all-bar" style="display:none; margin-top:0.75rem; padding:0.625rem 0.875rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.625rem; display:none; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem;">
      <span id="copy-all-hint" style="font-size:0.72rem; color:var(--text-muted);">Click a row to copy · or copy all of one format:</span>
      <div id="copy-all-btns" style="display:flex; flex-wrap:wrap; gap:0.35rem;">
      </div>
    </div>

  </div>

  <!-- HOW TO USE ───────────────────────────────── -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Bulk Case Mutator</h2>
    <p class="seo-p">Paste one or more identifiers into the input area and instantly see every case variant side by side. The tool detects the original format automatically and renders all enabled conversions in real time.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Paste Text</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Enter identifiers with any original casing — camelCase, snake_case, kebab-case, PascalCase, or mixed formats. Each line is processed independently.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Select Case</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Toggle the format chips to show or hide UPPERCASE, lowercase, Title Case, Sentence case, camelCase, snake_case, PascalCase, SCREAMING_SNAKE, and kebab-case outputs.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Set Options</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Acronyms like HTTP and URL are preserved as single uppercase tokens. Hyphens and underscores are recognized as word boundaries. Small words such as a, an, and, the are lowercased in Title Case output.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Copy Result</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Click any row in the specimen grid to copy that format's values to your clipboard. Use the footer buttons to copy all lines for a single format at once.</p>
      </div>
    </div>
  </div>

  <!-- HOW IT WORKS ────────────────────────────── -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Bulk Case Mutator Works</h2>
    <p class="seo-p">The tool splits each input identifier into individual word tokens, then reassembles those tokens into every enabled target format. The process is fully Unicode-aware and handles the most common programming naming conventions.</p>
    <h3 class="font-display seo-h3-sm">Character Case Transformation</h3>
    <p class="seo-p">Each token is converted using Unicode-aware case mapping. Characters like <code class="inline-code">é</code> or <code class="inline-code">ñ</code> are lowercased and uppercased correctly using the browser's built-in <code class="inline-code">toLocaleLowerCase</code> and <code class="inline-code">toLocaleUpperCase</code> methods. This means identifiers containing non-ASCII characters are handled reliably across locales.</p>
    <h3 class="font-display seo-h3-sm">Title Case Rules</h3>
    <p class="seo-p">When generating Title Case output, the first and last words are always capitalized regardless of their part of speech. Articles (a, an, the), short prepositions (of, in, on, at, to, for, by), and coordinating conjunctions (and, or, but, nor, yet, so) remain lowercase unless they appear at the start or end of the identifier. All other words receive initial capitalization.</p>
    <h3 class="font-display seo-h3-sm">Programmatic Cases</h3>
    <p class="seo-p">camelCase is formed by lowering the first token and title-casing the rest, then concatenating without separators. PascalCase title-cases every token and joins them directly. snake_case and SCREAMING_SNAKE join tokens with underscores — lowercase and uppercase respectively. kebab-case joins lowercase tokens with hyphens. The tokenizer splits on uppercase boundaries, underscores, hyphens, and dots, so identifiers like <code class="inline-code">parseHTTPSResponse</code> or <code class="inline-code">fetch_api_data</code> are parsed correctly into their component words.</p>
  </div>

  <!-- FAQ ─────────────────────────────────────── -->
  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does Title Case handle small words like a, an, and, the?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Short articles, prepositions, and coordinating conjunctions are kept lowercase in Title Case output. The first and last words are always capitalized regardless. For example, "a tale of two cities" becomes "A Tale of Two Cities" — the word "of" stays lowercase because it sits in the middle of the phrase.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does the tool support Unicode and non-English characters?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. Case conversion uses the browser's Unicode-aware case mapping, so characters like é, ñ, ü, and Cyrillic or Greek letters are transformed correctly. Identifiers containing non-ASCII characters will produce accurate outputs in every enabled format.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between Sentence case and Title Case?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Sentence case capitalizes only the first letter of the first word, treating the input as a single sentence. Title Case capitalizes the first letter of every significant word. For identifiers, Sentence case is less common but useful when generating human-readable labels from code-style names.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How are acronyms like HTTP, URL, and API handled?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The tokenizer detects runs of consecutive uppercase letters and preserves them as a single token. In PascalCase, an acronym remains fully uppercase within the word: parseHTTPSResponse becomes ParseHTTPSRequest. In camelCase, the first token is lowered but acronyms in later positions stay uppercase.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I paste multiple identifiers at once?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. Each line in the input is treated as a separate identifier. All lines are processed in parallel and every enabled case format shows the full list. You can paste hundreds of lines and see them all converted simultaneously.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What happens with numbers and special characters in identifiers?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Numbers adjacent to letters are treated as separate tokens. For example, rgb2hex tokenizes to rgb, 2, hex. Underscores and hyphens are recognized as word delimiters and are not included in the output tokens. Special characters outside common word boundaries are stripped during tokenization.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<style>
  /* Row hover */
  .specimen-row { transition: background 0.12s; cursor: pointer; }
  .specimen-row:hover { background: rgba(129,140,248,0.07) !important; }
  .specimen-row:active { background: rgba(129,140,248,0.14) !important; }
</style>

<script>
  // ── Case definitions ──────────────────────────────────────
  type CaseKey = 'camel'|'pascal'|'snake'|'screaming'|'kebab'|'title'|'upper'|'lower';

  const CASE_META: Record<CaseKey, { label: string; example: string; color: string }> = {
    camel:     { label: 'camelCase',      example: 'getUserProfile',    color: '#818cf8' },
    pascal:    { label: 'PascalCase',     example: 'GetUserProfile',    color: '#a78bfa' },
    snake:     { label: 'snake_case',     example: 'get_user_profile',  color: '#34d399' },
    screaming: { label: 'SCREAMING_SNAKE',example: 'GET_USER_PROFILE',  color: '#f87171' },
    kebab:     { label: 'kebab-case',     example: 'get-user-profile',  color: '#fbbf24' },
    title:     { label: 'Title Case',     example: 'Get User Profile',  color: '#60a5fa' },
    upper:     { label: 'UPPER',          example: 'GET USER PROFILE',  color: '#e879f9' },
    lower:     { label: 'lower',          example: 'get user profile',  color: '#94a3b8' },
  };

  const ALL_CASES: CaseKey[] = ['camel','pascal','snake','screaming','kebab','title','upper','lower'];

  // ── Toggle state ──────────────────────────────────────────
  const caseEnabled: Record<CaseKey, boolean> = {
    camel: true, pascal: true, snake: true, screaming: true,
    kebab: true, title: true, upper: true, lower: true,
  };

  document.querySelectorAll<HTMLLabelElement>('.case-toggle').forEach(lbl => {
    lbl.addEventListener('click', e => {
      e.preventDefault();
      const key = lbl.dataset.case as CaseKey;
      // Don't allow disabling all
      const activeCount = ALL_CASES.filter(k => caseEnabled[k]).length;
      if (caseEnabled[key] && activeCount <= 1) return;
      caseEnabled[key] = !caseEnabled[key];
      const chk  = lbl.querySelector('input') as HTMLInputElement;
      const span = lbl.querySelector('span')!;
      chk.checked = caseEnabled[key];
      const col = CASE_META[key].color;
      if (caseEnabled[key]) {
        lbl.style.borderColor = col;
        lbl.style.background  = `${col}1a`;
        span.style.color      = col;
      } else {
        lbl.style.borderColor = 'var(--border)';
        lbl.style.background  = 'var(--bg-surface-2)';
        span.style.color      = 'var(--text-muted)';
      }
      render();
    });
  });

  // Init toggle colours
  ALL_CASES.forEach(key => {
    const lbl  = document.getElementById(`toggle-${key}`)!;
    const col  = CASE_META[key].color;
    const span = lbl.querySelector('span')!;
    lbl.style.borderColor = col;
    lbl.style.background  = `${col}1a`;
    span.style.color      = col;
  });

  // ── Tokeniser ─────────────────────────────────────────────
  function tokenise(s: string): string[] {
    if (!s.trim()) return [];
    // Split on separators first
    let str = s.trim();
    // Replace separators with space
    str = str.replace(/[-_.]+/g, ' ');
    // Split camelCase / PascalCase boundaries
    // Insert space before uppercase letters preceded by lowercase
    str = str.replace(/([a-z\d])([A-Z])/g, '$1 $2');
    // Insert space before uppercase run followed by lowercase (e.g. HTTPSRequest → HTTPS Request)
    str = str.replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2');
    // Split on spaces/multiple spaces
    return str.split(/\s+/).filter(Boolean);
  }

  // ── Converters ────────────────────────────────────────────
  const titleCase = (w: string) => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase();

  const converters: Record<CaseKey, (tokens: string[]) => string> = {
    camel:     ts => ts.map((t,i) => i === 0 ? t.toLowerCase() : titleCase(t)).join(''),
    pascal:    ts => ts.map(t => titleCase(t)).join(''),
    snake:     ts => ts.map(t => t.toLowerCase()).join('_'),
    screaming: ts => ts.map(t => t.toUpperCase()).join('_'),
    kebab:     ts => ts.map(t => t.toLowerCase()).join('-'),
    title:     ts => ts.map(t => titleCase(t)).join(' '),
    upper:     ts => ts.map(t => t.toUpperCase()).join(' '),
    lower:     ts => ts.map(t => t.toLowerCase()).join(' '),
  };

  function convert(input: string, key: CaseKey): string {
    const tokens = tokenise(input);
    if (tokens.length === 0) return '';
    return converters[key](tokens);
  }

  // ── Render ────────────────────────────────────────────────
  const specimenGrid  = document.getElementById('specimen-grid')!;
  const specimenEmpty = document.getElementById('specimen-empty')!;
  const copyAllBar    = document.getElementById('copy-all-bar')!;
  const copyAllBtns   = document.getElementById('copy-all-btns')!;
  const bcmInput      = document.getElementById('bcm-input') as HTMLTextAreaElement;

  // Results cache for copy-all
  const allResults: Record<CaseKey, string[]> = {} as any;
  ALL_CASES.forEach(k => allResults[k] = []);

  function render() {
    const lines = bcmInput.value.split('\n');
    const nonEmpty = lines.filter(l => l.trim());

    if (nonEmpty.length === 0) {
      specimenEmpty.style.display = 'block';
      // Remove all rows except empty state
      Array.from(specimenGrid.children).forEach(c => {
        if (c.id !== 'specimen-empty') c.remove();
      });
      copyAllBar.style.display = 'none';
      return;
    }

    specimenEmpty.style.display = 'none';
    specimenGrid.innerHTML = '';

    const activeCases = ALL_CASES.filter(k => caseEnabled[k]);

    // Compute all results
    ALL_CASES.forEach(k => {
      allResults[k] = nonEmpty.map(line => convert(line.trim(), k));
    });

    // Render a row per case format
    activeCases.forEach((key, idx) => {
      const meta    = CASE_META[key];
      const results = allResults[key];
      const values  = results.join('\n');

      const row = document.createElement('div');
      row.className = 'specimen-row';
      row.setAttribute('role', 'button');
      row.setAttribute('tabindex', '0');
      row.setAttribute('aria-label', `Copy ${meta.label} variants`);
      row.style.cssText = `
        display:grid; grid-template-columns:7.5rem 1fr auto;
        align-items:start; gap:0.75rem;
        padding:0.75rem 1rem;
        background:var(--bg-surface);
        border-bottom:1px solid var(--border);
        ${idx === activeCases.length - 1 ? 'border-bottom:none;' : ''}
      `;
      row.innerHTML = `
        <div style="display:flex; flex-direction:column; gap:0.2rem; padding-top:0.1rem; flex-shrink:0;">
          <span style="font-family:'Fira Code',monospace; font-size:0.7rem; font-weight:800; color:${meta.color}; letter-spacing:0.03em;">${meta.label}</span>
          <span style="font-family:'Fira Code',monospace; font-size:0.6rem; color:var(--text-muted); opacity:0.7;">${meta.example}</span>
        </div>
        <div style="font-family:'Fira Code',monospace; font-size:0.82rem; font-weight:600; color:var(--text-primary); line-height:1.7; word-break:break-all; white-space:pre-wrap;">${escHtml(values)}</div>
        <div class="copy-badge" style="opacity:0; font-size:0.65rem; font-weight:700; color:${meta.color}; white-space:nowrap; padding-top:0.15rem; transition:opacity 0.15s; pointer-events:none;">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline; vertical-align:middle; margin-right:2px;"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          copy
        </div>
      `;

      // Show/hide copy badge on hover
      row.addEventListener('mouseenter', () => {
        (row.querySelector('.copy-badge') as HTMLElement).style.opacity = '1';
      });
      row.addEventListener('mouseleave', () => {
        (row.querySelector('.copy-badge') as HTMLElement).style.opacity = '0';
      });

      // Click to copy
      const copyFeedback = (el: HTMLElement) => {
        const badge = el.querySelector('.copy-badge') as HTMLElement;
        const prev = badge.innerHTML;
        badge.innerHTML = `<svg width="11" height="11" viewBox="0 0 10 10" fill="none"><path d="M2 5l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> copied!`;
        badge.style.opacity = '1';
        setTimeout(() => { badge.innerHTML = prev; badge.style.opacity = '0'; }, 1800);
      };

      row.addEventListener('click', () => {
        navigator.clipboard.writeText(values).then(() => copyFeedback(row));
      });
      row.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          navigator.clipboard.writeText(values).then(() => copyFeedback(row));
        }
      });

      specimenGrid.appendChild(row);
    });

    // Copy-all bar
    copyAllBar.style.display = 'flex';
    copyAllBtns.innerHTML = '';
    activeCases.forEach(key => {
      const meta = CASE_META[key];
      const btn  = document.createElement('button');
      btn.style.cssText = `
        padding:0.22rem 0.6rem; border-radius:999px;
        border:1px solid ${meta.color}44; background:${meta.color}0f;
        font-family:'Fira Code',monospace; font-size:0.65rem; font-weight:700;
        color:${meta.color}; cursor:pointer; transition:all 0.15s;
      `;
      btn.textContent = meta.label;
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(allResults[key].join('\n')).then(() => {
          btn.textContent = '✓ copied';
          setTimeout(() => { btn.textContent = meta.label; }, 1800);
        });
      });
      copyAllBtns.appendChild(btn);
    });
  }

  function escHtml(s: string) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── Events ────────────────────────────────────────────────
  bcmInput.addEventListener('input', render);

  document.getElementById('bcm-sample')!.addEventListener('click', () => {
    bcmInput.value = `getUserProfile\nfetch_api_data\nMyComponentName\nbackground-color\nMAX_RETRY_COUNT\nparse https response`;
    render();
  });

  document.getElementById('bcm-clear')!.addEventListener('click', () => {
    bcmInput.value = '';
    render();
  });

  // Initial render
  bcmInput.value = `getUserProfile\nfetch_api_data\nMyComponentName\nbackground-color`;
  render();
</script>