---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'heat-flux-density-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Heat Flux Density Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="W_m2">Watt per Square Meter (W/m²)</option>
          <option value="kW_m2">Kilowatt per Square Meter (kW/m²)</option>
          <option value="BTU_hft2">BTU per Hour-Square Foot (BTU/(h·ft²))</option>
          <option value="cal_scm2">Calorie per Second-Square Centimeter (cal/(s·cm²))</option>
          <option value="cal_mincm2">Calorie per Minute-Square Centimeter (cal/(min·cm²))</option>
          <option value="cal_hcm2">Calorie per Hour-Square Centimeter (cal/(h·cm²))</option>
          <option value="W_cm2">Watt per Square Centimeter (W/cm²)</option>
          <option value="ch_ft2">Cheval-Vapeur per Square Foot (ch/ft²)</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Heat Flux Density Converter</h2>
    <p class="seo-p">A solar panel specification sheet lists the peak power output as 1000 watts per square metre under standard test conditions. Your European engineering document requires the value in BTU per hour per square foot. The numbers are in completely different unit systems and the conversion is not intuitive. Enter the value, pick the source unit, and the converter shows the equivalent in all eight supported heat flux density units.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Solar energy engineers rating panel performance</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A solar panel datasheet lists peak irradiance as 1000 watts per square metre. Enter 1000 in W per m squared and the converter shows 317 BTU per hour per square foot. This value matches the standard test condition rating used worldwide for photovoltaic panel comparisons.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">HVAC engineers sizing radiator output</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A hydronic radiator specification lists heat flux as 500 watts per square metre. Convert to kilowatts per square metre and the result is 0.5. The converter also shows 158.4 BTU per hour per square foot for the American HVAC specification document.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Electronics engineers evaluating heat sink performance</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A high-performance heat sink dissipates 50 watts per square centimetre. Enter 50 in W per cm squared and the converter shows 500,000 watts per square metre. This value is well above the 100,000 threshold that classifies it as a high-flux cooling solution suitable for power electronics.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Industrial engineers reading legacy calorie data</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A 1960s heat transfer paper reports heat flux as 0.01 calorie per second per square centimetre. Enter 0.01 in cal per s per cm squared and the converter shows 418.4 watts per square metre. The calorie-based unit is rarely used in modern papers but still appears in older literature.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Heat Flux Density Converter Works</h2>
    <p class="seo-p">Every conversion uses a factor-based approach, normalising all units through a common base to ensure accurate results across imperial, metric, and CGS systems. All calculations run instantly in your browser with no server calls.</p>
    <h3 class="font-display seo-h3-sm">Heat Flux Density Units</h3>
    <p class="seo-p">Heat flux density measures the rate of thermal energy transfer per unit area. <code class="inline-code">W per square metre</code> is the SI standard used in most scientific and engineering contexts. <code class="inline-code">BTU per hour per square foot</code> is the imperial equivalent used in US building and mechanical engineering. <code class="inline-code">calorie per second per square centimetre</code> is the CGS unit found in older literature. <code class="inline-code">kilowatt per square metre</code> is used for high-power applications. <code class="inline-code">cheval-vapeur per square foot</code> is a French horsepower-based unit still found in some European references.</p>
    <h3 class="font-display seo-h3-sm">Conversion Factor Mathematics</h3>
    <p class="seo-p">Each unit has a fixed conversion factor relative to W per square metre. The converter multiplies your input by the source factor and divides by the target factor. For example, 1 BTU per hour per square foot equals 3.15248 W per square metre, so converting BTU to W per square metre means multiplying by that factor. The formula is <code class="inline-code">Result = Input x (FromFactor / ToFactor)</code>.</p>
    <h3 class="font-display seo-h3-sm">Engineering Applications</h3>
    <p class="seo-p">Engineers use heat flux density values when designing solar panels (typical peak output around 1000 W per square metre), sizing industrial heat exchangers, and modelling thermal loads on building envelopes. The solar constant at Earth orbit is approximately 1361 W per square metre, while a household radiator typically produces 500 to 2000 W per square metre.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between heat flux and heat flux density?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">In practice, the terms are often used interchangeably, but strictly speaking heat flux refers to total energy flow in watts, while heat flux density refers to energy flow per unit area in W per square metre. This converter handles the per-area form, which is the standard measure used in thermal engineering and solar energy calculations. Always check which form a specification sheet is referring to before comparing values.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What are typical heat flux density values for solar radiation?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The solar constant at Earth orbit is approximately 1,361 W per square metre. At Earth surface, peak solar irradiance on a clear day reaches about 1,000 W per square metre, which is the standard test condition rating for photovoltaic panels. On cloudy days, solar heat flux can drop to 100 to 300 W per square metre depending on cloud thickness and type.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does convection heat flux differ from radiation heat flux?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Convection heat flux involves energy transfer through fluid motion such as air or water and depends on temperature difference and flow velocity. Radiation heat flux is electromagnetic energy transfer that requires no medium and scales with the fourth power of absolute temperature. Both are measured in W per square metre and can occur simultaneously on the same surface.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why does this converter use W per square metre as the base unit?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">W per square metre is the SI-derived unit for heat flux density and the international standard in engineering, physics, and energy industries. Using it as the base ensures all conversions are traceable to a single reference, minimising rounding errors and maintaining consistency across metric, imperial, and CGS unit systems. This approach also simplifies the mathematics since every conversion requires only one multiplication and one division.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What heat flux density values are typical for household radiators?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A typical household radiator produces a heat flux density of 500 to 2,000 W per square metre depending on its surface temperature and design. Industrial heat exchangers can reach 10,000 to 100,000 W per square metre, while high-performance electronics cooling systems may dissipate heat at fluxes exceeding 100 W per square centimetre, which equals 1,000,000 W per square metre.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I convert between imperial and metric heat flux units?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes, this converter seamlessly handles conversions between imperial units like BTU per hour per square foot and metric units like W per square metre and kW per square metre. It also supports CGS units such as cal per second per square centimetre and the French horsepower unit ch per square foot, making it useful for international engineering projects and cross-system documentation.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'W_m2',      label: 'Watt per Square Meter (W/m²)',                    abbr: 'W/m²',           factor: 1 },
    { id: 'kW_m2',     label: 'Kilowatt per Square Meter (kW/m²)',               abbr: 'kW/m²',          factor: 1000 },
    { id: 'BTU_hft2',  label: 'BTU per Hour-Square Foot (BTU/(h·ft²))',          abbr: 'BTU/(h·ft²)',    factor: 3.15248 },
    { id: 'cal_scm2',  label: 'Calorie per Second-Square Centimeter (cal/(s·cm²))', abbr: 'cal/(s·cm²)',  factor: 41840 },
    { id: 'cal_mincm2', label: 'Calorie per Minute-Square Centimeter (cal/(min·cm²))', abbr: 'cal/(min·cm²)', factor: 697.333 },
    { id: 'cal_hcm2',  label: 'Calorie per Hour-Square Centimeter (cal/(h·cm²))',  abbr: 'cal/(h·cm²)',    factor: 11.6222 },
    { id: 'W_cm2',     label: 'Watt per Square Centimeter (W/cm²)',               abbr: 'W/cm²',          factor: 10000 },
    { id: 'ch_ft2',    label: 'Cheval-Vapeur per Square Foot (ch/ft²)',           abbr: 'ch/ft²',         factor: 13562.5 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
