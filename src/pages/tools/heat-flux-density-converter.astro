---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'heat-flux-density-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Heat Flux Density Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="W_m2">Watt per Square Meter (W/m²)</option>
          <option value="kW_m2">Kilowatt per Square Meter (kW/m²)</option>
          <option value="BTU_hft2">BTU per Hour-Square Foot (BTU/(h·ft²))</option>
          <option value="cal_scm2">Calorie per Second-Square Centimeter (cal/(s·cm²))</option>
          <option value="cal_mincm2">Calorie per Minute-Square Centimeter (cal/(min·cm²))</option>
          <option value="cal_hcm2">Calorie per Hour-Square Centimeter (cal/(h·cm²))</option>
          <option value="W_cm2">Watt per Square Centimeter (W/cm²)</option>
          <option value="ch_ft2">Cheval-Vapeur per Square Foot (ch/ft²)</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Heat Flux Density Converter</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Enter a <strong>numeric value</strong> and select its <strong>unit</strong> from the dropdown. All other heat flux density units update instantly — no buttons to click.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      This converter handles <strong>heat flux density</strong> — the rate of heat energy transfer through a surface per unit area. It is used in heat transfer engineering, solar energy calculations, and thermal system design.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      Click any <strong>Copy</strong> button to copy that unit's result to your clipboard — handy for pasting into documents, code, or messages.
    </p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How heat flux density conversions work</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.875rem;">
      All conversions go through <strong>W/m²</strong> as the base unit. Each unit has a fixed conversion factor:
    </p>
    <pre style="font-family:'Fira Code',monospace;font-size:.85rem;padding:1rem;border-radius:.5rem;background:var(--bg-surface-2);color:var(--text-primary);overflow-x:auto;white-space:pre-wrap;">1 kW/m²          = 1000 W/m²
1 BTU/(h·ft²)    = 3.15248 W/m²
1 cal/(s·cm²)    = 41840 W/m²
1 cal/(min·cm²)  = 697.333 W/m²
1 cal/(h·cm²)    = 11.6222 W/m²
1 W/cm²          = 10000 W/m²
1 ch/ft²         = 13562.5 W/m²

Result = Input × (FromFactor / ToFactor)</pre>
    <p style="color:var(--text-secondary); font-size:0.85rem; line-height:1.75;">
      Heat flux (also called thermal flux) measures the rate of heat energy flow through a surface. The solar constant is about 1361 W/m² (the heat flux from the Sun at Earth's orbit). A typical household radiator might produce 500-2000 W/m². All calculations run in your browser.
    </p>
  </div>

  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is heat flux density?",
          "acceptedAnswer": { "@type": "Answer", "text": "Heat flux density is the rate of heat energy transfer through a surface per unit area, measured in W/m² (watts per square meter). It describes how much thermal energy passes through each square meter of a surface per second. Higher values indicate more intense heat transfer." }
        },
        {
          "@type": "Question",
          "name": "What is the solar heat flux on Earth?",
          "acceptedAnswer": { "@type": "Answer", "text": "The solar constant (heat flux from the Sun at Earth's orbit) is about 1361 W/m². At Earth's surface, after atmospheric absorption, peak solar irradiance is about 1000 W/m² on a clear day. This value is critical for solar energy system design." }
        },
        {
          "@type": "Question",
          "name": "How does heat flux differ from heat flux density?",
          "acceptedAnswer": { "@type": "Answer", "text": "In practice, 'heat flux' and 'heat flux density' are often used interchangeably — both refer to energy per unit area per unit time (W/m²). Strictly speaking, 'heat flux' could mean total energy flow (W), while 'heat flux density' means flow per area (W/m²). This converter handles the density (per-area) form." }
        }
      ]
    }
    </script>

    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What is heat flux density?', a: 'Heat flux density is the rate of heat energy transfer through a surface per unit area, measured in W/m² (watts per square meter). It describes how much thermal energy passes through each square meter of a surface per second. Higher values indicate more intense heat transfer.' },
        { q: 'What is the solar heat flux on Earth?', a: 'The solar constant (heat flux from the Sun at Earth\'s orbit) is about 1361 W/m². At Earth\'s surface, after atmospheric absorption, peak solar irradiance is about 1000 W/m² on a clear day. This value is critical for solar energy system design.' },
        { q: 'How does heat flux differ from heat flux density?', a: 'In practice, \'heat flux\' and \'heat flux density\' are often used interchangeably — both refer to energy per unit area per unit time (W/m²). Strictly speaking, \'heat flux\' could mean total energy flow (W), while \'heat flux density\' means flow per area (W/m²). This converter handles the density (per-area) form.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'W_m2',      label: 'Watt per Square Meter (W/m²)',                    abbr: 'W/m²',           factor: 1 },
    { id: 'kW_m2',     label: 'Kilowatt per Square Meter (kW/m²)',               abbr: 'kW/m²',          factor: 1000 },
    { id: 'BTU_hft2',  label: 'BTU per Hour-Square Foot (BTU/(h·ft²))',          abbr: 'BTU/(h·ft²)',    factor: 3.15248 },
    { id: 'cal_scm2',  label: 'Calorie per Second-Square Centimeter (cal/(s·cm²))', abbr: 'cal/(s·cm²)',  factor: 41840 },
    { id: 'cal_mincm2', label: 'Calorie per Minute-Square Centimeter (cal/(min·cm²))', abbr: 'cal/(min·cm²)', factor: 697.333 },
    { id: 'cal_hcm2',  label: 'Calorie per Hour-Square Centimeter (cal/(h·cm²))',  abbr: 'cal/(h·cm²)',    factor: 11.6222 },
    { id: 'W_cm2',     label: 'Watt per Square Centimeter (W/cm²)',               abbr: 'W/cm²',          factor: 10000 },
    { id: 'ch_ft2',    label: 'Cheval-Vapeur per Square Foot (ch/ft²)',           abbr: 'ch/ft²',         factor: 13562.5 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
