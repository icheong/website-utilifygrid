---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'heat-flux-density-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Heat Flux Density Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="W_m2">Watt per Square Meter (W/m²)</option>
          <option value="kW_m2">Kilowatt per Square Meter (kW/m²)</option>
          <option value="BTU_hft2">BTU per Hour-Square Foot (BTU/(h·ft²))</option>
          <option value="cal_scm2">Calorie per Second-Square Centimeter (cal/(s·cm²))</option>
          <option value="cal_mincm2">Calorie per Minute-Square Centimeter (cal/(min·cm²))</option>
          <option value="cal_hcm2">Calorie per Hour-Square Centimeter (cal/(h·cm²))</option>
          <option value="W_cm2">Watt per Square Centimeter (W/cm²)</option>
          <option value="ch_ft2">Cheval-Vapeur per Square Foot (ch/ft²)</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Heat Flux Density Converter</h2>
    <p class="seo-p">Enter a heat flux value in any supported unit and see the equivalent in all other units instantly. This tool handles conversions across W/m², BTU/h·ft², kcal/h·m², cal/s·cm², and kW/m².</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Enter Heat Flux Value</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Type any positive numeric value into the input field. The converter accepts decimals and scientific notation for precision engineering calculations.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Select Target Unit</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Choose the unit you are converting from using the dropdown. Supported units include W/m², kW/m², BTU/(h·ft²), cal/(s·cm²), cal/(min·cm²), cal/(h·cm²), W/cm², and ch/ft².</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">View All Conversions</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">All other heat flux density units update in real time as you type. Results appear in a clean grid so you can compare values across unit systems at a glance.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Copy Result</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Click the Copy button next to any result to copy that value to your clipboard. Paste it directly into reports, code, specifications, or thermal design documents.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Heat Flux Density Converter Works</h2>
    <p class="seo-p">Every conversion uses a simple factor-based approach, normalizing all units through a common base to ensure accurate results across imperial, metric, and CGS systems.</p>
    <h3 class="font-display seo-h3-sm">Heat Flux Density Units</h3>
    <p class="seo-p">Heat flux density measures the rate of thermal energy transfer per unit area, expressed in watts per square meter <code class="inline-code">W/m²</code> as the SI standard. Other common units include <code class="inline-code">BTU/(h·ft²)</code> for imperial systems, <code class="inline-code">cal/(s·cm²)</code> for CGS systems, and <code class="inline-code">kW/m²</code> for high-power applications. Each unit represents the same physical quantity at different scales.</p>
    <h3 class="font-display seo-h3-sm">Conversion Factor Mathematics</h3>
    <p class="seo-p">The converter multiplies your input by the <code class="inline-code">fromFactor</code> of the source unit and divides by the <code class="inline-code">toFactor</code> of the target unit. For example, converting 1 BTU/(h·ft²) to W/m² means multiplying by 3.15248. All factors are defined relative to <code class="inline-code">W/m²</code> as the base unit, so the formula <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code> works for any pair of units in the list.</p>
    <h3 class="font-display seo-h3-sm">Engineering Applications</h3>
    <p class="seo-p">Engineers use heat flux density values when designing solar panels (typical peak output around 1000 W/m²), sizing industrial heat exchangers, and modeling thermal loads on building envelopes. The solar constant at Earth's orbit is approximately 1361 W/m², while a household radiator typically produces 500–2000 W/m². All calculations in this tool run instantly in your browser with no server calls.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between heat flux and heat flux density?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">In practice, the terms are often used interchangeably, but strictly speaking heat flux refers to total energy flow in watts, while heat flux density refers to energy flow per unit area in W/m². This converter handles the per-area (density) form, which is the standard measure used in thermal engineering and solar energy calculations.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What are typical heat flux density values for solar radiation?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">The solar constant at Earth's orbit is approximately 1361 W/m². At Earth's surface, peak solar irradiance on a clear day reaches about 1000 W/m², which is the standard test condition (STC) rating for photovoltaic panels. On cloudy days, solar heat flux can drop to 100–300 W/m².</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does convection heat flux differ from radiation heat flux?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Convection heat flux involves energy transfer through fluid motion (air, water) and depends on temperature difference and flow velocity. Radiation heat flux is electromagnetic energy transfer that requires no medium and scales with the fourth power of absolute temperature. Both are measured in W/m² and can occur simultaneously on the same surface.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why does this converter use W/m² as the base unit?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">W/m² is the SI-derived unit for heat flux density and the international standard in engineering, physics, and energy industries. Using it as the base ensures all conversions are traceable to a single reference, minimizing rounding errors and maintaining consistency across metric, imperial, and CGS unit systems.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What heat flux density values are typical for household radiators?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">A typical household radiator produces a heat flux density of 500–2000 W/m² depending on its surface temperature and design. Industrial heat exchangers can reach 10,000–100,000 W/m², while high-performance electronics cooling systems may dissipate heat at fluxes exceeding 100 W/cm² (1,000,000 W/m²).</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I convert between imperial and metric heat flux units?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes, this converter seamlessly handles conversions between imperial units like BTU/(h·ft²) and metric units like W/m² and kW/m². It also supports CGS units such as cal/(s·cm²) and the French horsepower unit ch/ft², making it useful for international engineering projects and cross-system documentation.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'W_m2',      label: 'Watt per Square Meter (W/m²)',                    abbr: 'W/m²',           factor: 1 },
    { id: 'kW_m2',     label: 'Kilowatt per Square Meter (kW/m²)',               abbr: 'kW/m²',          factor: 1000 },
    { id: 'BTU_hft2',  label: 'BTU per Hour-Square Foot (BTU/(h·ft²))',          abbr: 'BTU/(h·ft²)',    factor: 3.15248 },
    { id: 'cal_scm2',  label: 'Calorie per Second-Square Centimeter (cal/(s·cm²))', abbr: 'cal/(s·cm²)',  factor: 41840 },
    { id: 'cal_mincm2', label: 'Calorie per Minute-Square Centimeter (cal/(min·cm²))', abbr: 'cal/(min·cm²)', factor: 697.333 },
    { id: 'cal_hcm2',  label: 'Calorie per Hour-Square Centimeter (cal/(h·cm²))',  abbr: 'cal/(h·cm²)',    factor: 11.6222 },
    { id: 'W_cm2',     label: 'Watt per Square Centimeter (W/cm²)',               abbr: 'W/cm²',          factor: 10000 },
    { id: 'ch_ft2',    label: 'Cheval-Vapeur per Square Foot (ch/ft²)',           abbr: 'ch/ft²',         factor: 13562.5 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
