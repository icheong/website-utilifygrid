---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'pdf-merge')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Merge PDF</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Drag and drop PDF files, reorder them, preview pages, and download the merged result — all in your browser.</p>

    <!-- Drop zone -->
    <div id="drop-zone" style="border:2px dashed var(--border);border-radius:0.875rem;padding:2.5rem 1rem;text-align:center;cursor:pointer;transition:border-color 0.2s,background 0.2s;background:var(--bg-surface);">
      <p style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:0.4rem;">Drop PDF files here</p>
      <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:0.75rem;">or click to browse</p>
      <input id="file-input" type="file" accept=".pdf" multiple style="display:none;" />
      <button id="browse-btn" class="btn-secondary" type="button" style="font-size:0.82rem;">Browse Files</button>
    </div>

    <!-- File list -->
    <div id="file-list-wrap" style="margin-top:1.25rem;display:none;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem;">
        <p style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;">
          Files to Merge (<span id="file-count">0</span>)
        </p>
        <button id="clear-all-btn" class="btn-secondary" type="button" style="font-size:0.7rem;padding:0.25rem 0.6rem;">Clear All</button>
      </div>
      <div id="file-list" style="display:flex;flex-direction:column;gap:0.5rem;"></div>

      <!-- Merge button -->
      <div style="margin-top:1.25rem;text-align:center;">
        <button id="merge-btn" class="btn-primary" type="button" style="font-size:0.95rem;padding:0.7rem 2rem;">
          Merge PDFs
        </button>
        <p id="merge-status" style="font-size:0.78rem;color:var(--text-muted);margin-top:0.5rem;display:none;"></p>
      </div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Merge PDF tool</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      <strong>Step 1:</strong> Drop PDF files onto the upload zone, or click <strong>Browse Files</strong> to select them. You can add as many files as you need.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      <strong>Step 2:</strong> Drag files up or down to reorder them. Click the <strong>×</strong> button to remove a file. Click a file name to preview its pages in the panel on the right.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      <strong>Step 3:</strong> Click <strong>Merge PDFs</strong> to combine all files in order. The merged PDF downloads automatically to your device. Nothing is uploaded — everything runs in your browser.
    </p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How Merge PDF works</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.875rem;">
      This tool uses <strong>pdf-lib</strong> (for merging) and <strong>PDF.js</strong> (for preview rendering) — both running entirely in your browser via WebAssembly and Canvas. No files leave your device.
    </p>
    <pre style="font-family:'Fira Code',monospace;font-size:.85rem;padding:1rem;border-radius:.5rem;background:var(--bg-surface-2);color:var(--text-primary);overflow-x:auto;white-space:pre-wrap;">1. User drops/selects PDF files
2. Each file is read as ArrayBuffer
3. PDF.js renders page thumbnails for preview
4. User drags to reorder files
5. pdf-lib copies pages from each source
   into a new PDF document in order
6. Merged PDF is downloaded as a single file

All processing happens client-side (WASM).
No server upload — your files stay private.</pre>
    <p style="color:var(--text-secondary); font-size:0.85rem; line-height:1.75;">
      The merge preserves bookmarks, annotations, and embedded fonts where possible. Page size, orientation, and metadata from the first file are used as defaults for the merged document.
    </p>
  </div>

  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is my data uploaded to a server?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. All processing happens entirely in your browser using WebAssembly (pdf-lib) and Canvas (PDF.js). Your files never leave your device — there is no server upload at any point." }
        },
        {
          "@type": "Question",
          "name": "What PDF features are preserved during merge?",
          "acceptedAnswer": { "@type": "Answer", "text": "The merge preserves page content, text, images, bookmarks, and annotations. Embedded fonts are kept where possible. Page size and orientation from the first file are used as defaults. Some interactive form fields may lose functionality in the merged output." }
        },
        {
          "@type": "Question",
          "name": "Is there a file size limit?",
          "acceptedAnswer": { "@type": "Answer", "text": "There is no hard limit, but very large files (hundreds of MB) may slow down your browser due to memory constraints. For best results, keep individual files under 50 MB each and the total under 200 MB." }
        },
        {
          "@type": "Question",
          "name": "Can I merge password-protected PDFs?",
          "acceptedAnswer": { "@type": "Answer", "text": "This tool can merge encrypted PDFs only if they are encrypted without a user password (i.e., they open freely but restrict editing). PDFs protected with an owner password can be merged. PDFs with a user password (requiring a password to open) cannot be processed." }
        },
        {
          "@type": "Question",
          "name": "Does merging reduce PDF quality?",
          "acceptedAnswer": { "@type: "Answer", "text": "No. The merge is a lossless copy of pages — text, vectors, and images are copied byte-for-byte. There is no re-encoding or recompression. The merged PDF is the same quality as the originals." }
        }
      ]
    }
    </script>

    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'Is my data uploaded to a server?', a: 'No. All processing happens entirely in your browser using WebAssembly (pdf-lib) and Canvas (PDF.js). Your files never leave your device — there is no server upload at any point.' },
        { q: 'What PDF features are preserved during merge?', a: 'The merge preserves page content, text, images, bookmarks, and annotations. Embedded fonts are kept where possible. Page size and orientation from the first file are used as defaults. Some interactive form fields may lose functionality in the merged output.' },
        { q: 'Is there a file size limit?', a: 'There is no hard limit, but very large files (hundreds of MB) may slow down your browser due to memory constraints. For best results, keep individual files under 50 MB each and the total under 200 MB.' },
        { q: 'Can I merge password-protected PDFs?', a: 'This tool can merge encrypted PDFs only if they are encrypted without a user password (i.e., they open freely but restrict editing). PDFs protected with an owner password can be merged. PDFs with a user password (requiring a password to open) cannot be processed.' },
        { q: 'Does merging reduce PDF quality?', a: 'No. The merge is a lossless copy of pages — text, vectors, and images are copied byte-for-byte. There is no re-encoding or recompression. The merged PDF is the same quality as the originals.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<!-- CDN libs -->
<script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
<script is:inline src="https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.min.js"></script>

<script>
(function () {
  const { PDFDocument } = (window as any).PDFLib;
  const pdfjsLib = (window as any).pdfjsLib;
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.worker.min.js';

  const dropZone     = document.getElementById('drop-zone')!;
  const fileInput    = document.getElementById('file-input') as HTMLInputElement;
  const browseBtn    = document.getElementById('browse-btn')!;
  const fileListWrap = document.getElementById('file-list-wrap')!;
  const fileList     = document.getElementById('file-list')!;
  const fileCount    = document.getElementById('file-count')!;
  const clearAllBtn  = document.getElementById('clear-all-btn')!;
  const mergeBtn     = document.getElementById('merge-btn')!;
  const mergeStatus  = document.getElementById('merge-status')!;

  type FileEntry = { id: number; file: File; name: string; pageCount: number; thumbnails: string[]; };
  let entries: FileEntry[] = [];
  let nextId = 0;
  let activePreview: number | null = null;
  let draggedIdx: number | null = null;

  // ── Drop zone events ────────────────────────────────────────────
  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.style.borderColor = 'var(--color-brand-blue)'; dropZone.style.background = 'rgba(29,78,216,0.04)'; });
  dropZone.addEventListener('dragleave', () => { dropZone.style.borderColor = ''; dropZone.style.background = ''; });
  dropZone.addEventListener('drop', e => { e.preventDefault(); dropZone.style.borderColor = ''; dropZone.style.background = ''; handleFiles(e.dataTransfer!.files); });
  browseBtn.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('click', e => { if (e.target === dropZone || e.target === browseBtn) fileInput.click(); });
  fileInput.addEventListener('change', () => { if (fileInput.files.length) handleFiles(fileInput.files); fileInput.value = ''; });
  clearAllBtn.addEventListener('click', () => { entries = []; renderList(); });

  // ── Handle new files ────────────────────────────────────────────
  async function handleFiles(files: FileList) {
    for (const file of Array.from(files)) {
      if (file.type !== 'application/pdf') continue;
      const id = nextId++;
      const entry: FileEntry = { id, file, name: file.name.replace(/\.pdf$/i, ''), pageCount: 0, thumbnails: [] };
      entries.push(entry);
      // Load thumbnails
      try {
        const buf = await file.arrayBuffer();
        const pdf = await pdfjsLib.getDocument({ data: buf }).promise;
        entry.pageCount = pdf.numPages;
        const maxThumbs = Math.min(pdf.numPages, 5);
        for (let i = 1; i <= maxThumbs; i++) {
          const page = await pdf.getPage(i);
          const viewport = page.getViewport({ scale: 0.25 });
          const canvas = document.createElement('canvas');
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          await page.render({ canvasContext: canvas.getContext('2d')!, viewport }).promise;
          entry.thumbnails.push(canvas.toDataURL('image/png'));
        }
      } catch { entry.pageCount = 0; }
    }
    renderList();
  }

  // ── Render file list ────────────────────────────────────────────
  function renderList() {
    fileListWrap.style.display = entries.length ? '' : 'none';
    fileCount.textContent = String(entries.length);
    fileList.innerHTML = '';
    if (!entries.length) { activePreview = null; return; }

    entries.forEach((entry, idx) => {
      const row = document.createElement('div');
      row.className = 'info-row';
      row.draggable = true;
      row.dataset.idx = String(idx);
      row.style.cssText = 'padding:0.6rem 0.75rem;cursor:grab;transition:background 0.15s;';
      row.innerHTML = `
        <div style="display:flex;align-items:center;gap:0.6rem;flex:1;min-width:0;">
          <span style="font-size:0.85rem;color:var(--text-muted);cursor:grab;flex-shrink:0;" title="Drag to reorder">⠿</span>
          <div style="min-width:0;">
            <div style="font-size:0.85rem;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${entry.name}</div>
            <div style="font-size:0.72rem;color:var(--text-muted);">${entry.pageCount ? entry.pageCount + ' page' + (entry.pageCount > 1 ? 's' : '') : 'Loading…'}</div>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:0.4rem;flex-shrink:0;">
          <span style="font-size:0.72rem;color:var(--text-muted);">#${idx + 1}</span>
          <button class="btn-secondary preview-btn" type="button" style="font-size:0.65rem;padding:0.15rem 0.45rem;" data-id="${entry.id}">Preview</button>
          <button class="btn-secondary remove-btn" type="button" style="font-size:0.7rem;padding:0.15rem 0.4rem;color:#EF4444;" data-id="${entry.id}">✕</button>
        </div>
      `;
      // Drag events
      row.addEventListener('dragstart', e => {
        e.dataTransfer!.effectAllowed = 'move';
        draggedIdx = idx;
        row.style.opacity = '0.4';
      });
      row.addEventListener('dragend', () => { row.style.opacity = ''; draggedIdx = null; });
      row.addEventListener('dragover', e => { e.preventDefault(); e.dataTransfer!.dropEffect = 'move'; row.style.borderColor = 'var(--color-brand-blue)'; });
      row.addEventListener('dragleave', () => { row.style.borderColor = ''; });
      row.addEventListener('drop', e => {
        e.preventDefault();
        row.style.borderColor = '';
        const toIdx = idx;
        if (draggedIdx === null || draggedIdx === toIdx) return;
        const [moved] = entries.splice(draggedIdx, 1);
        entries.splice(toIdx, 0, moved);
        draggedIdx = null;
        renderList();
      });
      // Remove
      row.querySelector('.remove-btn')!.addEventListener('click', e => {
        e.stopPropagation();
        const id = parseInt((e.target as HTMLElement).dataset.id!);
        entries = entries.filter(en => en.id !== id);
        if (activePreview === id) activePreview = null;
        renderList();
      });
      // Preview
      row.querySelector('.preview-btn')!.addEventListener('click', e => {
        e.stopPropagation();
        activePreview = entry.id;
        renderPreview(entry);
      });
      fileList.appendChild(row);
    });

    if (activePreview !== null) {
      const entry = entries.find(en => en.id === activePreview);
      if (entry) renderPreview(entry);
    }
  }

  // ── Render preview panel ────────────────────────────────────────
  function renderPreview(entry: FileEntry) {
    let panel = document.getElementById('preview-panel');
    if (!panel) {
      panel = document.createElement('div');
      panel.id = 'preview-panel';
      panel.style.cssText = 'margin-top:1rem;background:var(--bg-surface);border:1.5px solid var(--border);border-radius:0.875rem;padding:1rem;';
      fileListWrap.after(panel);
    }
    if (!entry.thumbnails.length) {
      panel.innerHTML = `<p style="font-size:0.82rem;color:var(--text-muted);">No preview available for "${entry.name}".</p>`;
      return;
    }
    panel.innerHTML = `
      <p style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Preview — ${entry.name} (${entry.pageCount} pages)</p>
      <div style="display:flex;gap:0.5rem;overflow-x:auto;padding-bottom:0.5rem;">
        ${entry.thumbnails.map((src, i) => `
          <div style="flex-shrink:0;text-align:center;">
            <img src="${src}" alt="Page ${i + 1}" style="width:100px;height:auto;border:1px solid var(--border);border-radius:4px;" />
            <div style="font-size:0.65rem;color:var(--text-muted);margin-top:0.2rem;">Page ${i + 1}</div>
          </div>
        `).join('')}
        ${entry.pageCount > 5 ? `<div style="flex-shrink:0;display:flex;align-items:center;font-size:0.75rem;color:var(--text-muted);">+${entry.pageCount - 5} more</div>` : ''}
      </div>
    `;
  }

  // ── Merge & download ────────────────────────────────────────────
  mergeBtn.addEventListener('click', async () => {
    if (entries.length < 2) { showStatus('Add at least 2 PDF files to merge.', false); return; }
    mergeBtn.setAttribute('disabled', '');
    mergeBtn.textContent = 'Merging…';
    showStatus('Reading files…', true);

    try {
      const merged = await PDFDocument.create();
      let totalPages = 0;
      for (let i = 0; i < entries.length; i++) {
        showStatus(`Processing file ${i + 1} of ${entries.length}…`, true);
        const buf = await entries[i].file.arrayBuffer();
        const srcDoc = await PDFDocument.load(buf);
        const pages = await merged.copyPages(srcDoc, srcDoc.getPageIndices());
        pages.forEach(p => merged.addPage(p));
        totalPages += pages.length;
      }
      showStatus(`Merged ${totalPages} pages. Preparing download…`, true);
      const pdfBytes = await merged.save();
      const blob = new Blob([pdfBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'merged.pdf';
      a.click();
      URL.revokeObjectURL(url);
      showStatus(`Done! Downloaded merged.pdf (${totalPages} pages).`, false);
    } catch (err: any) {
      showStatus('Error: ' + (err.message || 'Merge failed.'), false);
    } finally {
      mergeBtn.removeAttribute('disabled');
      mergeBtn.textContent = 'Merge PDFs';
    }
  });

  function showStatus(msg: string, loading: boolean) {
    mergeStatus.style.display = '';
    mergeStatus.textContent = msg;
    mergeStatus.style.color = loading ? 'var(--text-muted)' : '#10B981';
  }
})();
</script>
