---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'colour-palette-css-generator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Colour Palette &amp; CSS Generator</h2>

    <!-- Inputs: picker + HEX / RGB / HSL all visible -->
    <div style="display:grid; grid-template-columns:auto 0.55fr 1fr 1fr; gap:0.75rem; margin-bottom:1.25rem; align-items:end;" class="input-grid">

      <!-- Colour picker -->
      <div>
        <label style="display:block; font-size:0.72rem; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Pick</label>
        <input id="color-picker" type="color" value="#3B82F6"
          style="width:3rem; height:2.75rem; border-radius:0.5rem; border:1.5px solid var(--border); background:var(--bg-surface); cursor:pointer; padding:0.2rem;" />
      </div>

      <!-- HEX -->
      <div>
        <label style="display:block; font-size:0.72rem; font-weight:700; color:#1D4ED8; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;" for="color-text">HEX</label>
        <input id="color-text" type="text" value="#3B82F6" placeholder="#3B82F6"
          class="input-themed"
          style="font-family:'Fira Code',monospace; font-size:0.9rem; font-weight:600; letter-spacing:0.05em;" />
      </div>

      <!-- RGB -->
      <div>
        <div style="font-size:0.72rem; font-weight:700; color:#10B981; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">RGB</div>
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:0.3rem;">
          <input id="rgb-r" type="number" min="0" max="255" value="59" placeholder="R"
            class="input-themed"
            style="font-family:'Fira Code',monospace; font-size:0.85rem; padding:0.55rem 0.4rem; text-align:center;" title="Red (0-255)" />
          <input id="rgb-g" type="number" min="0" max="255" value="130" placeholder="G"
            class="input-themed"
            style="font-family:'Fira Code',monospace; font-size:0.85rem; padding:0.55rem 0.4rem; text-align:center;" title="Green (0-255)" />
          <input id="rgb-b" type="number" min="0" max="255" value="246" placeholder="B"
            class="input-themed"
            style="font-family:'Fira Code',monospace; font-size:0.85rem; padding:0.55rem 0.4rem; text-align:center;" title="Blue (0-255)" />
        </div>
      </div>

      <!-- HSL -->
      <div>
        <div style="font-size:0.72rem; font-weight:700; color:#8B5CF6; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">HSL</div>
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:0.3rem;">
          <input id="hsl-h" type="number" min="0" max="360" value="217" placeholder="H"
            class="input-themed"
            style="font-family:'Fira Code',monospace; font-size:0.85rem; padding:0.55rem 0.4rem; text-align:center;" title="Hue (0-360)" />
          <input id="hsl-s" type="number" min="0" max="100" value="91" placeholder="S"
            class="input-themed"
            style="font-family:'Fira Code',monospace; font-size:0.85rem; padding:0.55rem 0.4rem; text-align:center;" title="Saturation (0-100)" />
          <input id="hsl-l" type="number" min="0" max="100" value="59" placeholder="L"
            class="input-themed"
            style="font-family:'Fira Code',monospace; font-size:0.85rem; padding:0.55rem 0.4rem; text-align:center;" title="Lightness (0-100)" />
        </div>
      </div>

    </div>

    <!-- Colour preview -->
    <div id="color-preview" style="height:3rem; border-radius:0.75rem; border:1.5px solid var(--border); margin-bottom:1.25rem; transition:background 0.2s;"></div>

    <!-- Four output sections: HEX · RGB · HSL · Tailwind -->
    <div style="display:grid; grid-template-columns:1fr; gap:0.875rem; margin-bottom:1rem;" class="output-grid">

      <!-- ── HEX section ── -->
      <div class="result-card">
        <div style="font-size:0.68rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.75rem; display:flex; align-items:center; gap:0.4rem;">
          <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#1D4ED8;"></span>
          HEX
        </div>
        <div style="display:flex; flex-direction:column; gap:0.4rem;">
          <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
            <span style="font-size:0.7rem; color:var(--text-muted); font-weight:500;">Hex</span>
            <div style="display:flex; align-items:center; gap:0.4rem;">
              <span class="info-value" id="out-hex" style="font-size:0.82rem;"></span>
              <button class="btn-secondary copy-btn" data-copy="" type="button" style="font-size:0.68rem; padding:0.15rem 0.45rem;">Copy</button>
            </div>
          </div>
          <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
            <span style="font-size:0.7rem; color:var(--text-muted); font-weight:500;">CSS var</span>
            <div style="display:flex; align-items:center; gap:0.4rem;">
              <code id="out-css-var" style="font-family:'Fira Code',monospace; font-size:0.72rem; color:var(--text-primary); word-break:break-all; text-align:right;"></code>
              <button class="btn-secondary copy-btn" data-copy="" type="button" style="font-size:0.68rem; padding:0.15rem 0.45rem; flex-shrink:0;">Copy</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ── RGB section ── -->
      <div class="result-card">
        <div style="font-size:0.68rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.75rem; display:flex; align-items:center; gap:0.4rem;">
          <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#10B981;"></span>
          RGB
        </div>
        <div style="display:flex; flex-direction:column; gap:0.4rem;">
          <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
            <span style="font-size:0.7rem; color:var(--text-muted); font-weight:500;">Values</span>
            <div style="display:flex; align-items:center; gap:0.4rem;">
              <span class="info-value" id="out-rgb" style="font-size:0.82rem;"></span>
              <button class="btn-secondary copy-btn" data-copy="" type="button" style="font-size:0.68rem; padding:0.15rem 0.45rem;">Copy</button>
            </div>
          </div>
          <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
            <span style="font-size:0.7rem; color:var(--text-muted); font-weight:500;">css rgb()</span>
            <div style="display:flex; align-items:center; gap:0.4rem;">
              <span class="info-value" id="out-css-rgb" style="font-size:0.78rem;"></span>
              <button class="btn-secondary copy-btn" data-copy="" type="button" style="font-size:0.68rem; padding:0.15rem 0.45rem;">Copy</button>
            </div>
          </div>
          <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem; padding-top:0.35rem; border-top:1px solid var(--border);">
            <div style="display:flex; align-items:center; gap:0.375rem; flex:1; min-width:0;">
              <span style="font-size:0.7rem; color:var(--text-muted); font-weight:500; white-space:nowrap;">rgba</span>
              <input id="rgba-slider" type="range" min="0" max="100" value="100"
                style="flex:1; accent-color:#10B981; height:4px; min-width:0;" />
              <span id="rgba-val" style="font-family:'Fira Code',monospace; font-size:0.68rem; color:var(--text-muted); min-width:2rem; text-align:right;">100%</span>
            </div>
          </div>
          <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
            <span style="font-size:0.7rem; color:var(--text-muted); font-weight:500;">css rgba()</span>
            <div style="display:flex; align-items:center; gap:0.4rem;">
              <code id="out-css-rgba" style="font-family:'Fira Code',monospace; font-size:0.72rem; color:var(--text-primary); word-break:break-all; text-align:right;"></code>
              <button class="btn-secondary copy-btn" data-copy="" type="button" style="font-size:0.68rem; padding:0.15rem 0.45rem; flex-shrink:0;">Copy</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ── HSL section ── -->
      <div class="result-card">
        <div style="font-size:0.68rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.75rem; display:flex; align-items:center; gap:0.4rem;">
          <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#8B5CF6;"></span>
          HSL
        </div>
        <div style="display:flex; flex-direction:column; gap:0.4rem;">
          <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
            <span style="font-size:0.7rem; color:var(--text-muted); font-weight:500;">Values</span>
            <div style="display:flex; align-items:center; gap:0.4rem;">
              <span class="info-value" id="out-hsl" style="font-size:0.78rem;"></span>
              <button class="btn-secondary copy-btn" data-copy="" type="button" style="font-size:0.68rem; padding:0.15rem 0.45rem;">Copy</button>
            </div>
          </div>
          <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
            <span style="font-size:0.7rem; color:var(--text-muted); font-weight:500;">css hsl()</span>
            <div style="display:flex; align-items:center; gap:0.4rem;">
              <span class="info-value" id="out-css-hsl" style="font-size:0.78rem;"></span>
              <button class="btn-secondary copy-btn" data-copy="" type="button" style="font-size:0.68rem; padding:0.15rem 0.45rem;">Copy</button>
            </div>
          </div>
          <div style="display:flex; flex-direction:column; gap:0.3rem; padding-top:0.35rem; border-top:1px solid var(--border);">
            <div style="display:flex; align-items:center; gap:0.375rem;">
              <span style="font-size:0.7rem; color:var(--text-muted); font-weight:500; white-space:nowrap;">Gradient</span>
              <input id="grad-angle" type="range" min="0" max="360" value="180"
                style="flex:1; accent-color:#8B5CF6; height:4px;" />
              <span id="grad-angle-val" style="font-family:'Fira Code',monospace; font-size:0.68rem; color:var(--text-muted); min-width:2.75rem; text-align:right;">180deg</span>
            </div>
            <div id="gradient-preview" style="height:1.5rem; border-radius:0.375rem; border:1px solid var(--border); transition:background 0.2s;"></div>
            <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
              <code id="out-css-gradient" style="font-family:'Fira Code',monospace; font-size:0.68rem; color:var(--text-secondary); word-break:break-all; flex:1; min-width:0;"></code>
              <button class="btn-secondary copy-btn" data-copy="" type="button" style="font-size:0.68rem; padding:0.15rem 0.45rem; flex-shrink:0;">Copy</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Tailwind section ── -->
      <div class="result-card">
        <div style="font-size:0.68rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.75rem; display:flex; align-items:center; gap:0.4rem;">
          <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#F59E0B;"></span>
          Tailwind
        </div>
        <div id="tw-match" style="display:flex; flex-direction:column; gap:0.375rem;"></div>
      </div>

    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >Colour Palette &amp; CSS Generator Overview &amp; Technical Context</h2>
    <p class="text-secondary seo-p" >
      This all-in-one colour conversion and CSS generation tool combines HEX-to-RGB conversion, RGB-to-HEX conversion, HSL translation, Tailwind CSS palette matching, and live CSS output generation into a single interface. Built entirely with vanilla JavaScript and running 100% client-side in the browser, every computation happens locally using standard browser APIs — no colour data is transmitted to any server, and no cookies or tracking scripts execute. The zero-server-latency architecture ensures instant updates as you type, providing complete privacy for your design workflow.
    </p>
    <p class="text-secondary seo-p" >
      Switch between HEX, RGB, and HSL input modes using the toggle tabs, or type any valid colour format directly into the text field. The tool automatically parses HEX codes (with or without the <code>#</code> prefix, including 3-digit shorthand), RGB functions like <code>rgb(59, 130, 246)</code>, and HSL functions like <code>hsl(217, 91%, 59%)</code>. All output formats update simultaneously, and every result includes a one-click copy button. The CSS Outputs section provides ready-to-paste custom properties, rgba values with an opacity slider, and linear gradients with adjustable angles.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Front-end development and CSS authoring', 'Developers frequently receive brand colours as HEX codes from designers but need the RGB equivalent for CSS functions like rgba(), gradients, or dynamic colour manipulation with JavaScript. This tool eliminates manual base-16 arithmetic by converting instantly and providing copy-ready strings for direct insertion into stylesheets, including CSS custom properties and linear gradients.'],
        ['Tailwind CSS integration', 'When migrating a design system to Tailwind CSS, developers need to find the closest utility class for brand colours that may not align exactly with Tailwind\'s predefined palette. The tool uses CIELAB colour space Delta-E distance calculations to identify the five most visually similar Tailwind classes, ranked by perceptual similarity, enabling rapid palette alignment without manual visual comparison.'],
        ['Design system auditing and accessibility', 'Teams standardising a design system often inherit colour palettes in mixed formats — some assets use HEX, others use RGB, and component libraries may require HSL for CSS custom properties. This converter enables rapid format normalisation across an entire palette, while the opacity slider and gradient generator support creating accessible colour combinations with proper contrast ratios.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >Deep-Dive: Colour Conversion Mechanics &amp; Mathematical Logic</h2>

    <h3 class="font-display seo-h3-sm" >Core Conversion Formulas</h3>
    <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1rem">
      <div class="info-row">
        <span class="info-label">HEX to RGB</span>
        <span class="info-value">R = parseInt(hex[0..1], 16); G = parseInt(hex[2..3], 16); B = parseInt(hex[4..5], 16)</span>
      </div>
      <div class="info-row">
        <span class="info-label">RGB to HEX</span>
        <span class="info-value">HEX = '#' + R.toString(16).padStart(2,'0') + G.toString(16).padStart(2,'0') + B.toString(16).padStart(2,'0')</span>
      </div>
      <div class="info-row">
        <span class="info-label">RGB to HSL</span>
        <span class="info-value">Normalise channels to [0,1], find max/min, compute hue via sector formula, derive saturation and lightness</span>
      </div>
      <div class="info-row">
        <span class="info-label">HSL to RGB</span>
        <span class="info-value">Compute chroma = (1 - |2L - 1|) * S, then hue sector to find intermediate X and m values per channel</span>
      </div>
    </div>

    <h3 class="font-display seo-h3-sm" >Tailwind Matching via CIELAB Delta-E</h3>
    <p class="text-secondary seo-p" >
      The Tailwind matching algorithm converts both the input colour and every palette entry from sRGB to the CIELAB (L*a*b*) colour space, which models human colour perception more accurately than RGB. It first applies inverse sRGB companding to linearise the channel values, then transforms through the CIE XYZ intermediate using D65 illuminant reference points. The Delta-E (Euclidean distance in L*a*b* space) between the input and each palette entry is computed, and the five smallest distances are returned as matches. A Delta-E under 2 is perceptually indistinguishable to most observers; under 5 is a close match.
    </p>

    <h3 class="font-display seo-h3-sm" >Edge Cases and Input Validation</h3>
    <p class="text-secondary seo-p-none" >
      Three-character hex codes like <code>#F0A</code> are automatically expanded to <code>#FF00AA</code> per the CSS specification where each digit is doubled. RGB channel values are clamped to 0-255, HSL hue to 0-360, and saturation/lightness to 0-100%. Invalid inputs produce a clear error state rather than <code>NaN</code>. The conversion uses IEEE 754 double-precision arithmetic internally, with final integer values rounded to the nearest whole number. The opacity slider operates independently of the base colour conversion, appending an alpha value to the CSS output without affecting the underlying RGB/HSL calculations.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What colour formats does this tool accept as input?",
          a: "The tool accepts three primary formats: HEX codes (with or without the # prefix, including 3-digit shorthand like #F0A), RGB functions (e.g. rgb(59, 130, 246) or comma-separated values 59, 130, 246), and HSL functions (e.g. hsl(217, 91%, 59%) or comma-separated 217, 91, 59). You can also use the native colour picker to select any colour visually. All formats are parsed in real time as you type."
        },
        {
          q: "How does the Tailwind colour matching work?",
          a: "The tool converts your colour to the CIELAB (L*a*b*) colour space, which models human colour perception more accurately than RGB. It calculates the Delta-E (Euclidean distance) between your colour and every entry in the Tailwind CSS v3 default palette. The five colours with the smallest Delta-E are returned as matches, ranked by visual similarity. A score under 2 is perceptually indistinguishable; under 5 is a close match."
        },
        {
          q: "What is the difference between HEX and RGB colour codes?",
          a: "Both represent the same colours using different numeral systems. HEX uses a six-character base-16 string (e.g. #3B82F6) where each pair of digits encodes one channel as a value 00-FF. RGB separates the red, green, and blue channels into three decimal integers (e.g. 59, 130, 246) in the 0-255 range. HEX is more compact for CSS and design handoffs; RGB is more intuitive when adjusting individual channel values programmatically."
        },
        {
          q: "What is HSL and why would I use it instead of RGB?",
          a: "HSL (Hue, Saturation, Lightness) describes colour in a way that is more intuitive for humans. Hue is the colour angle on the 360-degree colour wheel (0 = red, 120 = green, 240 = blue), saturation controls the intensity from 0% (grey) to 100% (vivid), and lightness ranges from 0% (black) to 100% (white). HSL makes it easier to create harmonious colour palettes by adjusting hue while keeping saturation and lightness constant, which is harder to achieve by manipulating raw RGB channel values."
        },
        {
          q: "Can I use this for colours with transparency (alpha)?",
          a: "The base converter handles opaque colours and does not process an alpha channel in the conversion itself. However, the CSS Outputs section includes an opacity slider that generates rgba() values with any alpha level from 0% to 100%. You can also manually append alpha values to the converted output — for example, rgba(59, 130, 246, 0.5) adds 50% transparency. The alpha channel is independent of the RGB-to-hex conversion and does not affect the computed colour values."
        },
        {
          q: "Why does my hex code look different in another application?",
          a: "Colour appearance can vary between applications due to colour profile differences. This converter uses the sRGB colour space, which is the default for web browsers and CSS. Applications that operate in Display P3, Adobe RGB, or other wide-gamut colour spaces may render the same numeric values differently. Additionally, screen calibration, gamma settings, and ambient lighting affect perceived colour. The tool's output is accurate for web-standard sRGB contexts."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

<style>
  @media (max-width: 600px) {
    .input-grid {
      grid-template-columns: auto 1fr !important;
    }
    .input-grid > div:nth-child(3),
    .input-grid > div:nth-child(4) {
      grid-column: 1 / -1;
    }
  }
</style>

</ToolLayout>

<script>
  // ── Tailwind v3 colour palette ──────────────────────────────
  const PALETTE: Record<string, string> = {
    'slate-50':'#f8fafc','slate-100':'#f1f5f9','slate-200':'#e2e8f0','slate-300':'#cbd5e1','slate-400':'#94a3b8','slate-500':'#64748b','slate-600':'#475569','slate-700':'#334155','slate-800':'#1e293b','slate-900':'#0f172a','slate-950':'#020617',
    'gray-50':'#f9fafb','gray-100':'#f3f4f6','gray-200':'#e5e7eb','gray-300':'#d1d5db','gray-400':'#9ca3af','gray-500':'#6b7280','gray-600':'#4b5563','gray-700':'#374151','gray-800':'#1f2937','gray-900':'#111827','gray-950':'#030712',
    'red-50':'#fef2f2','red-100':'#fee2e2','red-200':'#fecaca','red-300':'#fca5a5','red-400':'#f87171','red-500':'#ef4444','red-600':'#dc2626','red-700':'#b91c1c','red-800':'#991b1b','red-900':'#7f1d1d','red-950':'#450a0a',
    'orange-50':'#fff7ed','orange-100':'#ffedd5','orange-200':'#fed7aa','orange-300':'#fdba74','orange-400':'#fb923c','orange-500':'#f97316','orange-600':'#ea580c','orange-700':'#c2410c','orange-800':'#9a3412','orange-900':'#7c2d12','orange-950':'#431407',
    'yellow-50':'#fefce8','yellow-100':'#fef9c3','yellow-200':'#fef08a','yellow-300':'#fde047','yellow-400':'#facc15','yellow-500':'#eab308','yellow-600':'#ca8a04','yellow-700':'#a16207','yellow-800':'#854d0e','yellow-900':'#713f12','yellow-950':'#422006',
    'green-50':'#f0fdf4','green-100':'#dcfce7','green-200':'#bbf7d0','green-300':'#86efac','green-400':'#4ade80','green-500':'#22c55e','green-600':'#16a34a','green-700':'#15803d','green-800':'#166534','green-900':'#14532d','green-950':'#052e16',
