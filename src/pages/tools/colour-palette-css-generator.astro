  // ── Parsing ─────────────────────────────────────────────────
  function parseHex(raw: string): [number,number,number] | null {
    let h = raw.replace(/^#/, '').trim().toLowerCase();
    if (h.length === 3) h = h.split('').map(c => c + c).join('');
    if (!/^[0-9a-f]{6}$/.test(h)) return null;
    const n = parseInt(h, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  function parseRgb(raw: string): [number,number,number] | null {
    const m = raw.match(/rgb\s*\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})\s*\)/i);
    if (m) return [Math.min(255,+m[1]), Math.min(255,+m[2]), Math.min(255,+m[3])];
    const parts = raw.split(',').map(s => s.trim());
    if (parts.length === 3 && parts.every(p => /^\d{1,3}$/.test(p))) {
      return parts.map(p => Math.min(255, +p)) as [number,number,number];
    }
    return null;
  }

  function parseHsl(raw: string): [number,number,number] | null {
    const m = raw.match(/hsl\s*\(\s*(\d{1,3})\s*,\s*(\d{1,3})%?\s*,\s*(\d{1,3})%?\s*\)/i);
    if (m) return [+m[1], Math.min(100,+m[2]), Math.min(100,+m[3])];
    const parts = raw.split(',').map(s => s.trim().replace('%',''));
    if (parts.length === 3 && parts.every(p => /^\d{1,3}$/.test(p))) {
      return [+parts[0], Math.min(100,+parts[1]), Math.min(100,+parts[2])];
    }
    return null;
  }

  function parseAnyInput(val: string): { r:number; g:number; b:number; h:number; s:number; l:number } | null {
    val = val.trim();
    if (!val) return null;
    const hex = parseHex(val);
    if (hex) { const [h,s,l] = rgbToHsl(...hex); return { r:hex[0], g:hex[1], b:hex[2], h, s, l }; }
    const rgb = parseRgb(val);
    if (rgb) { const [h,s,l] = rgbToHsl(...rgb); return { r:rgb[0], g:rgb[1], b:rgb[2], h, s, l }; }
    const hsl = parseHsl(val);
    if (hsl) { const [r,g,b] = hslToRgb(...hsl); return { r, g, b, h:hsl[0], s:hsl[1], l:hsl[2] }; }
    return null;
  }

  // ── Conversions ─────────────────────────────────────────────
  function rgbToHex(r: number, g: number, b: number): string {
    return '#' + [r,g,b].map(v => v.toString(16).padStart(2,'0')).join('');
  }

  function rgbToHsl(r: number, g: number, b: number): [number, number, number] {
    const rn = r/255, gn = g/255, bn = b/255;
    const max = Math.max(rn,gn,bn), min = Math.min(rn,gn,bn);
    const l = (max + min) / 2;
    if (max === min) return [0, 0, Math.round(l * 100)];
    const d = max - min;
    const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    let h = 0;
    if (max === rn) h = ((gn - bn) / d + (gn < bn ? 6 : 0)) / 6;
    else if (max === gn) h = ((bn - rn) / d + 2) / 6;
    else h = ((rn - gn) / d + 4) / 6;
    return [Math.round(h * 360), Math.round(s * 100), Math.round(l * 100)];
  }

  function hslToRgb(h: number, s: number, l: number): [number, number, number] {
    const sn = s / 100, ln = l / 100;
    const c = (1 - Math.abs(2 * ln - 1)) * sn;
    const x = c * (1 - Math.abs((h / 60) % 2 - 1));
    const m = ln - c / 2;
    let rp = 0, gp = 0, bp = 0;
    if (h < 60)      { rp = c; gp = x; }
    else if (h < 120) { rp = x; gp = c; }
    else if (h < 180) { gp = c; bp = x; }
    else if (h < 240) { gp = x; bp = c; }
    else if (h < 300) { rp = x; bp = c; }
    else              { rp = c; bp = x; }
    return [
      Math.round((rp + m) * 255),
      Math.round((gp + m) * 255),
      Math.round((bp + m) * 255)
    ];
  }

  // ── CIELAB for Tailwind matching ────────────────────────────
  function rgbToLab(r: number, g: number, b: number): [number,number,number] {
    const lin = (c: number) => { const s = c/255; return s > 0.04045 ? Math.pow((s+0.055)/1.055,2.4) : s/12.92; };
    const rl = lin(r), gl = lin(g), bl = lin(b);
    const X = rl*0.4124+gl*0.3576+bl*0.1805;
    const Y = rl*0.2126+gl*0.7152+bl*0.0722;
    const Z = rl*0.0193+gl*0.1192+bl*0.9505;
    const f = (t: number) => t > 0.008856 ? Math.cbrt(t) : 7.787*t+16/116;
    const fx = f(X/0.95047), fy = f(Y), fz = f(Z/1.08883);
    return [116*fy-16, 500*(fx-fy), 200*(fy-fz)];
  }

  function deltaE(lab1: [number,number,number], lab2: [number,number,number]): number {
    return Math.sqrt(Math.pow(lab1[0]-lab2[0],2)+Math.pow(lab1[1]-lab2[1],2)+Math.pow(lab1[2]-lab2[2],2));
  }

  // ── DOM refs ────────────────────────────────────────────────
  const picker      = document.getElementById('color-picker')      as HTMLInputElement;
  const textInput   = document.getElementById('color-text')        as HTMLInputElement;
  const rgbR        = document.getElementById('rgb-r')             as HTMLInputElement;
  const rgbG        = document.getElementById('rgb-g')             as HTMLInputElement;
  const rgbB        = document.getElementById('rgb-b')             as HTMLInputElement;
  const hslH        = document.getElementById('hsl-h')             as HTMLInputElement;
  const hslS        = document.getElementById('hsl-s')             as HTMLInputElement;
  const hslL        = document.getElementById('hsl-l')             as HTMLInputElement;
  const rgbaSlider  = document.getElementById('rgba-slider')       as HTMLInputElement;
  const rgbaVal     = document.getElementById('rgba-val')!;
  const gradAngle   = document.getElementById('grad-angle')        as HTMLInputElement;
  const gradAngleVl = document.getElementById('grad-angle-val')!;
  const preview     = document.getElementById('color-preview')!;
  const outHex      = document.getElementById('out-hex')!;
  const outRgb      = document.getElementById('out-rgb')!;
  const outHsl      = document.getElementById('out-hsl')!;
  const outCssRgb   = document.getElementById('out-css-rgb')!;
  const outCssHsl   = document.getElementById('out-css-hsl')!;
  const outCssVar   = document.getElementById('out-css-var')!;
  const outCssRgba  = document.getElementById('out-css-rgba')!;
  const outCssGrad  = document.getElementById('out-css-gradient')!;
  const gradPreview = document.getElementById('gradient-preview')!;
  const twMatch     = document.getElementById('tw-match')!;

  // ── Master update ───────────────────────────────────────────
  function update() {
    const data = parseAnyInput(textInput.value);
    if (!data) return;
    const { r, g, b, h, s, l } = data;
    const hex = rgbToHex(r, g, b).toUpperCase();

    // Sync all inputs
    picker.value = rgbToHex(r, g, b);
    textInput.value = hex;
    rgbR.value = String(r);
    rgbG.value = String(g);
    rgbB.value = String(b);
    hslH.value = String(h);
    hslS.value = String(s);
    hslL.value = String(l);

    // Preview
    preview.style.background = hex;

    // Format outputs
    outHex.textContent = hex;
    outRgb.textContent = `${r}, ${g}, ${b}`;
    outHsl.textContent = `hsl(${h}, ${s}%, ${l}%)`;
    outCssRgb.textContent = `rgb(${r}, ${g}, ${b})`;
    outCssHsl.textContent = `hsl(${h}, ${s}%, ${l}%)`;
    outCssVar.textContent = `--color-primary: ${hex.toLowerCase()};`;

    // RGBA with opacity
    const alpha = parseInt(rgbaSlider.value) / 100;
    rgbaVal.textContent = rgbaSlider.value + '%';
    outCssRgba.textContent = `rgba(${r}, ${g}, ${b}, ${alpha.toFixed(2)})`;

    // Gradient
    const angle = gradAngle.value;
    gradAngleVl.textContent = angle + 'deg';
    outCssGrad.textContent = `linear-gradient(${angle}deg, ${hex.toLowerCase()}, ${rgbToHsl(h, s, l > 50 ? l - 20 : l + 20).join(',')})`;
    // Simpler: use a darker/lighter version
    const darkHex = rgbToHex(Math.max(0, r - 60), Math.max(0, g - 60), Math.max(0, b - 60));
    outCssGrad.textContent = `linear-gradient(${angle}deg, ${hex.toLowerCase()}, ${darkHex.toLowerCase()})`;
    gradPreview.style.background = `linear-gradient(${angle}deg, ${hex.toLowerCase()}, ${darkHex.toLowerCase()})`;

    // Tailwind match
    const lab = rgbToLab(r, g, b);
    const scores = Object.entries(PALETTE).map(([name, ph]) => {
      const pRgb = parseHex(ph)!;
      return { name, hex: ph, score: deltaE(lab, rgbToLab(...pRgb)) };
    }).sort((a,b) => a.score - b.score).slice(0, 5);

    twMatch.innerHTML = scores.map(s => `
      <div onclick="navigator.clipboard.writeText('${s.name}');this.querySelector('.tw-copy-lbl').textContent='Copied!';setTimeout(()=>{this.querySelector('.tw-copy-lbl').textContent='copy'},1500)" style="display:flex; align-items:center; gap:0.625rem; background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.5rem; padding:0.45rem 0.625rem; cursor:pointer; transition:border-color 0.12s;" onmouseover="this.style.borderColor='var(--text-muted)'" onmouseout="this.style.borderColor='var(--border)'">
        <div style="width:24px; height:24px; border-radius:0.3rem; background:${s.hex}; flex-shrink:0; border:1px solid rgba(0,0,0,0.1);"></div>
        <div style="flex:1; min-width:0; overflow:hidden;">
          <div style="font-family:'Fira Code',monospace; font-size:0.75rem; font-weight:600; color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${s.name}</div>
          <div style="font-size:0.65rem; color:var(--text-muted); margin-top:0.05rem;">dE ${s.score.toFixed(1)}</div>
        </div>
        <span class="tw-copy-lbl" style="font-size:0.65rem; color:var(--text-muted); flex-shrink:0;">copy</span>
      </div>`).join('');

    // Update copy button data-copy attributes
    document.querySelectorAll<HTMLElement>('.copy-btn[data-copy]').forEach(btn => {
      const codeEl = btn.previousElementSibling as HTMLElement;
      if (codeEl) btn.dataset.copy = codeEl.textContent || '';
    });
  }

  // ── Event listeners ────────────────────────────────────────
  picker.addEventListener('input', () => { textInput.value = picker.value.toUpperCase(); update(); });
  textInput.addEventListener('input', update);
  [rgbR, rgbG, rgbB].forEach(el => el.addEventListener('input', () => {
    textInput.value = `rgb(${rgbR.value}, ${rgbG.value}, ${rgbB.value})`;
    update();
  }));
  [hslH, hslS, hslL].forEach(el => el.addEventListener('input', () => {
    textInput.value = `hsl(${hslH.value}, ${hslS.value}%, ${hslL.value}%)`;
    update();
  }));
  rgbaSlider.addEventListener('input', update);
  gradAngle.addEventListener('input', update);

  // ── Copy buttons ────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy || '';
      if (!text) return;
      await navigator.clipboard.writeText(text);
      const original = btn.textContent || 'Copy';
      btn.textContent = 'Copied!';
      btn.classList.add('btn-success');
      setTimeout(() => { btn.textContent = original; btn.classList.remove('btn-success'); }, 2000);
    });
  });

  // Initial render
  update();
</script>
