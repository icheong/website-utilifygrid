</style>

<script>
// ============================================================
// Enhanced PII Redactor & Replacer — fully client-side
// ============================================================

// -- DOM refs -------------------------------------------------
const inputEl       = document.getElementById('pr-input') as HTMLTextAreaElement;
const outputEl      = document.getElementById('pr-output') as HTMLTextAreaElement;
const inMetaEl      = document.getElementById('pr-in-meta')!;
const outMetaEl     = document.getElementById('pr-out-meta')!;
const syntheticEl   = document.getElementById('pr-synthetic') as HTMLInputElement;
const typeToggles   = document.querySelectorAll<HTMLInputElement>('.pr-type-toggle');
const statEntities  = document.getElementById('pr-stat-entities')!;
const statInstances = document.getElementById('pr-stat-instances')!;
const statDelta     = document.getElementById('pr-stat-delta')!;
const copyBtn       = document.getElementById('pr-copy') as HTMLButtonElement;
const clearBtn      = document.getElementById('pr-clear') as HTMLButtonElement;
const registryList  = document.getElementById('pr-registry-list')!;
const registryEmpty = document.getElementById('pr-registry-empty')!;
const registryCount = document.getElementById('pr-registry-count')!;

// -- Detection patterns -----------------------------------------
// Order matters: more specific patterns (email, ip, card) run before
// the looser name pattern so we don't double-tag substrings.
const PATTERNS: Record<string, RegExp> = {
  email: /\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b/g,
  ip:    /\b(?:(?:25[0-5]|2[0-4]\d|1?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|1?\d?\d)\b|\b(?:[A-Fa-f0-9]{1,4}:){7}[A-Fa-f0-9]{1,4}\b/g,
  card:  /\b(?:4\d{3}|5[1-5]\d{2}|3[47]\d{2}|6011)[ -]?\d{4}[ -]?\d{4}[ -]?\d{1,4}\b/g,
  phone: /\b(?:\+?\d{1,3}[ .-]?)?\(?\d{2,4}\)?[ .-]?\d{3,4}[ .-]?\d{3,4}\b/g,
  name:  /\b[A-Z][a-z]+(?:\s[A-Z][a-z]+){1,2}\b/g,
};

const CATEGORY_LABEL: Record<string, string> = {
  email: 'EMAIL', ip: 'IP', card: 'CARD', phone: 'PHONE', name: 'USER',
};

// Words that look like a capitalised pair but are not names (avoid noise)
const NAME_STOPWORDS = new Set([
  'Dear Sir', 'Best Regards', 'Kind Regards', 'Thank You', 'United States',
  'New York', 'Los Angeles', 'San Francisco',
]);

// -- Synthetic data banks (deterministic, no external calls) ---
const FIRST_NAMES = ['Alice','Brian','Carla','Derek','Elena','Felix','Grace','Hassan','Irene','Jacob','Karen','Leo','Maria','Noah','Olivia','Pavel','Quinn','Rosa','Sam','Tina'];
const LAST_NAMES  = ['Smith','Johnson','Garcia','Brown','Davis','Miller','Wilson','Moore','Taylor','Clark','Lewis','Walker','Hall','Allen','Young','King','Wright','Scott','Green','Baker'];
const DOMAINS     = ['example.net','mailbox.io','sample.org','testmail.com','inboxly.dev'];

function seededRand(seed: number) {
  let s = seed % 2147483647;
  if (s <= 0) s += 2147483646;
  return () => (s = (s * 16807) % 2147483647) / 2147483647;
}
function hashStr(str: string) {
  let h = 0;
  for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) >>> 0;
  return h;
}

function makeSynthetic(category: string, original: string): string {
  const rnd = seededRand(hashStr(original) || 1);
  switch (category) {
    case 'name': {
      const f = FIRST_NAMES[Math.floor(rnd() * FIRST_NAMES.length)];
      const l = LAST_NAMES[Math.floor(rnd() * LAST_NAMES.length)];
      return `${f} ${l}`;
    }
    case 'email': {
      const f = FIRST_NAMES[Math.floor(rnd() * FIRST_NAMES.length)].toLowerCase();
      const l = LAST_NAMES[Math.floor(rnd() * LAST_NAMES.length)].toLowerCase();
      const d = DOMAINS[Math.floor(rnd() * DOMAINS.length)];
      return `${f}.${l}@${d}`;
    }
    case 'phone': {
      const n = () => Math.floor(rnd() * 9000 + 1000);
      return `(${Math.floor(rnd()*800+200)}) ${n()}`;
    }
    case 'ip': {
      const o = () => Math.floor(rnd() * 254 + 1);
      return `10.${o()}.${o()}.${o()}`;
    }
    case 'card': {
      const g = () => String(Math.floor(rnd() * 9000 + 1000));
      return `4111 ${g()} ${g()} ${g()}`;
    }
    default:
      return original;
  }
}

// -- State --------------------------------------------------------
// map: category -> Map(originalValue -> { index, placeholder, synthetic })
type Entry = { index: number; placeholder: string; synthetic: string };
let map: Record<string, Map<string, Entry>> = {};
let debounceTimer: ReturnType<typeof setTimeout> | null = null;

function resetMap() {
  map = { name: new Map(), email: new Map(), phone: new Map(), ip: new Map(), card: new Map() };
}
resetMap();

function activeCategories(): string[] {
  return Array.from(typeToggles).filter(t => t.checked).map(t => t.dataset.type!);
}

function estimateTokens(text: string): number {
  return text.trim() ? Math.round(text.length / 4) : 0;
}

// -- Core redaction pass -------------------------------------------
function redact(text: string): string {
  if (!text) return '';
  const categories = activeCategories();
  // Collect all matches across enabled categories with position info,
  // then resolve overlaps by earliest-start, longest-match priority.
  type Match = { start: number; end: number; value: string; category: string };
  let matches: Match[] = [];

  for (const cat of categories) {
    const re = PATTERNS[cat];
    re.lastIndex = 0;
    let m: RegExpExecArray | null;
    while ((m = re.exec(text)) !== null) {
      const value = m[0];
      if (cat === 'name' && NAME_STOPWORDS.has(value)) continue;
      matches.push({ start: m.index, end: m.index + value.length, value, category: cat });
      if (m.index === re.lastIndex) re.lastIndex++;
    }
  }

  // Sort by start asc, then by length desc (prefer longer/more specific matches)
  matches.sort((a, b) => a.start - b.start || (b.end - b.start) - (a.end - a.start));

  // Remove overlaps: keep first (already specific-category-first ordering
  // doesn't matter here since categories don't overlap in pattern shape,
  // but a name could overlap inside an email/IP — drop ones inside a kept span)
  const kept: Match[] = [];
  let lastEnd = -1;
  for (const m of matches) {
    if (m.start >= lastEnd) {
      kept.push(m);
      lastEnd = m.end;
    }
  }

  const useSynthetic = syntheticEl.checked;
  let out = '';
  let cursor = 0;
  for (const m of kept) {
    out += text.slice(cursor, m.start);
    const catMap = map[m.category];
    let entry = catMap.get(m.value);
    if (!entry) {
      const index = catMap.size + 1;
      const placeholder = `[${CATEGORY_LABEL[m.category]}_${index}]`;
      const synthetic = makeSynthetic(m.category, m.value);
      entry = { index, placeholder, synthetic };
      catMap.set(m.value, entry);
    }
    out += useSynthetic ? entry.synthetic : entry.placeholder;
    cursor = m.end;
  }
  out += text.slice(cursor);
  return out;
}

// -- Registry rendering ----------------------------------------------
function renderRegistry() {
  let totalEntries = 0;
  let totalInstances = 0; // approximated as total unique entities for now, refined below
  registryList.innerHTML = '';

  const rows: { token: string; value: string; cat: string; index: number }[] = [];
  for (const cat of Object.keys(map)) {
    map[cat].forEach((entry, original) => {
      rows.push({
        token: syntheticEl.checked ? entry.synthetic : entry.placeholder,
        value: original,
        cat,
        index: entry.index,
      });
      totalEntries++;
    });
  }

  statEntities.textContent = String(totalEntries);

  if (rows.length === 0) {
    registryEmpty.style.display = '';
    registryList.appendChild(registryEmpty);
    registryCount.textContent = '0 active mappings';
    return;
  }

  registryEmpty.style.display = 'none';
  registryCount.textContent = `${rows.length} active mapping${rows.length === 1 ? '' : 's'}`;

  rows.forEach(r => {
    const row = document.createElement('div');
    row.className = 'pr-registry-row';
    row.innerHTML = `
      <span class="pr-registry-token">${escapeHtml(r.token)}</span>
      <span class="pr-registry-value" title="${escapeHtml(r.value)}">${escapeHtml(r.value)}</span>
      <span class="pr-registry-cat">${escapeHtml(CATEGORY_LABEL[r.cat])}</span>
    `;
    registryList.appendChild(row);
  });
}

function escapeHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

// -- Main update ----------------------------------------------------
function update() {
  const text = inputEl.value;
  const inChars = text.length;
  const inTokens = estimateTokens(text);
  inMetaEl.textContent = `${inChars.toLocaleString()} chars \u00b7 ~${inTokens.toLocaleString()} tokens`;

  resetMap();
  const protectedText = redact(text);
  outputEl.value = protectedText;

  const outChars = protectedText.length;
  const outTokens = estimateTokens(protectedText);
  outMetaEl.textContent = `${outChars.toLocaleString()} chars \u00b7 ~${outTokens.toLocaleString()} tokens`;

  let totalInstances = 0;
  for (const cat of Object.keys(map)) totalInstances += map[cat].size;
  // Count actual replacement instances (occurrences), not just unique entities
  let occurrences = 0;
  for (const cat of activeCategories()) {
    const re = PATTERNS[cat];
    re.lastIndex = 0;
    let m: RegExpExecArray | null;
    while ((m = re.exec(text)) !== null) {
      if (cat === 'name' && NAME_STOPWORDS.has(m[0])) continue;
      occurrences++;
      if (m.index === re.lastIndex) re.lastIndex++;
    }
  }
  statInstances.textContent = String(occurrences);

  const delta = inTokens > 0 ? Math.round(((outTokens - inTokens) / inTokens) * 100) : 0;
  statDelta.textContent = `${delta > 0 ? '+' : ''}${delta}%`;

  renderRegistry();
}

function debouncedUpdate() {
  if (debounceTimer) clearTimeout(debounceTimer);
  debounceTimer = setTimeout(update, 200);
}

// -- Events -----------------------------------------------------------
inputEl.addEventListener('input', debouncedUpdate);
syntheticEl.addEventListener('change', update);
typeToggles.forEach(t => t.addEventListener('change', update));

copyBtn.addEventListener('click', () => {
  navigator.clipboard.writeText(outputEl.value).then(() => {
    copyBtn.textContent = '\u2713 Copied!';
    copyBtn.classList.add('btn-success');
    setTimeout(() => {
      copyBtn.textContent = 'Copy Protected Text';
      copyBtn.classList.remove('btn-success');
    }, 2000);
  });
});

clearBtn.addEventListener('click', () => {
  inputEl.value = '';
  outputEl.value = '';
  resetMap();
  statEntities.textContent = '0';
  statInstances.textContent = '0';
  statDelta.textContent = '0%';
  inMetaEl.textContent = '0 chars \u00b7 ~0 tokens';
  outMetaEl.textContent = '0 chars \u00b7 ~0 tokens';
  renderRegistry();
  inputEl.focus();
});

// -- Boot ---------------------------------------------------------------
update();
</script>
