  }
  :root.dark .pr-chip:has(input:checked) { border-color: #3B82F6; background: rgba(59,130,246,0.12); }

  /* -- Split panes ----------------------------------------------- */
  .pr-panes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 0.875rem;
  }
  @media (max-width: 720px) {
    .pr-panes { grid-template-columns: 1fr; }
  }
  .pr-pane-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .pr-count {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-family: 'Fira Code', monospace;
