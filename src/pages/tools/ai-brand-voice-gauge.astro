---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'ai-brand-voice-gauge')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">AI Brand Voice Gauge</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:0.875rem;">
      <div>
        <label style="display:block; font-size:0.78rem; font-weight:700; color:#BE185D; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.375rem;">Reference Brand Text</label>
        <textarea id="brand-text" placeholder="Paste your brand's own writing — website copy, case studies, emails…"
          style="width:100%; height:180px; padding:0.75rem; border:1.5px solid #FBCFE8; border-radius:0.625rem; font-size:0.82rem; color:var(--text-primary); resize:vertical; box-sizing:border-box; outline:none; line-height:1.65; font-family:inherit; background:var(--bg-surface);"
          onfocus="this.style.borderColor='#BE185D'" onblur="this.style.borderColor='#FBCFE8'"></textarea>
      </div>
      <div>
        <label style="display:block; font-size:0.78rem; font-weight:700; color:#7C3AED; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.375rem;">AI-Generated Output</label>
        <textarea id="ai-output" placeholder="Paste the AI-generated text to compare against your brand voice…"
          style="width:100%; height:180px; padding:0.75rem; border:1.5px solid #DDD6FE; border-radius:0.625rem; font-size:0.82rem; color:var(--text-primary); resize:vertical; box-sizing:border-box; outline:none; line-height:1.65; font-family:inherit; background:var(--bg-surface);"
          onfocus="this.style.borderColor='#7C3AED'" onblur="this.style.borderColor='#DDD6FE'"></textarea>
      </div>
    </div>

    <button id="gauge-btn" style="width:100%; padding:0.75rem; background:linear-gradient(135deg,#BE185D,#7C3AED); color:#fff; border:none; border-radius:0.625rem; font-size:0.9rem; font-weight:700; cursor:pointer; margin-bottom:1.25rem;">Analyse Brand Voice Match</button>

    <!-- Score -->
    <div id="score-section" style="display:none;">
      <div style="text-align:center; margin-bottom:1.25rem; padding:1.25rem; background:linear-gradient(135deg,#FDF4FF,#FFF1F2); border-radius:1rem; border:1.5px solid #E9D5FF;">
        <div id="match-pct" style="font-family:'Sora',sans-serif; font-size:3rem; font-weight:800; background:linear-gradient(135deg,#BE185D,#7C3AED); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">0%</div>
        <div style="font-size:0.875rem; font-weight:600; color:var(--text-muted);">Brand Voice Match Score</div>
        <div style="height:10px; background:#E9D5FF; border-radius:9999px; overflow:hidden; margin-top:0.875rem;">
          <div id="match-bar" style="height:100%; background:linear-gradient(90deg,#BE185D,#7C3AED); border-radius:9999px; transition:width 0.6s; width:0%;"></div>
        </div>
      </div>

      <!-- Metrics grid -->
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.625rem; margin-bottom:1rem;">
        {[['m-sent','Avg Sentence Length','words'],['m-vocab','Vocabulary Overlap','% shared'],['m-words','Power Words','match']].map(([id,label,unit]) => (
          <div class="result-card" style="text-align:center;">
            <div id={id} style="font-family:'Sora',sans-serif; font-size:1.25rem; font-weight:700; color:var(--text-primary);">—</div>
            <div style="font-size:0.7rem; font-weight:600; color:var(--text-muted); margin-top:0.2rem;">{label}</div>
            <div style="font-size:0.65rem; color:var(--text-muted);">{unit}</div>
          </div>
        ))}
      </div>

      <!-- Discrepancies -->
      <div style="font-size:0.78rem; font-weight:700; color:#BE185D; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.5rem;">Discrepancies</div>
      <div id="discrepancies" style="display:flex; flex-direction:column; gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to use the Brand Voice Gauge</h2>
    <p class="seo-p">Paste the AI-generated content you want to evaluate into the input field. Enter your brand's style guidelines or voice description in the reference field. Click Analyse to score the content across four dimensions: tone consistency, vocabulary match, formality level, and emotional register.</p>
    <div style="display:flex; flex-direction:column; gap:0.75rem;">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Content quality control</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Before publishing AI-generated marketing copy, verify it matches your brand's established tone, vocabulary, and formality standards across all channels.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Multi-writer alignment</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Ensure content produced by different team members or different AI models maintains a consistent brand voice by comparing outputs against the same reference guidelines.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Localization review</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Check whether translated or adapted content preserves the original brand voice while accounting for cultural and linguistic differences in tone expectations.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Brand voice analysis framework</h2>
    <p class="seo-p">The tool applies a multi-dimensional analysis to measure how closely content matches brand guidelines.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem;">
      <div class="result-card">
        <h3 class="font-display seo-h3-sm">Tone detection</h3>
        <p style="font-size:0.85rem; color:var(--text-muted); line-height:1.65; margin:0;">Analyses the content's overall tone along axes of formality, confidence, warmth, and urgency. Uses word choice, sentence structure, and punctuation patterns to classify the detected tone.</p>
      </div>
      <div class="result-card">
        <h3 class="font-display seo-h3-sm">Vocabulary matching</h3>
        <p style="font-size:0.85rem; color:var(--text-muted); line-height:1.65; margin:0;">Compares the content's word choices against the brand's preferred terminology and prohibited words. Flags jargon, slang, or competitors' terminology that deviates from brand standards.</p>
      </div>
      <div class="result-card">
        <h3 class="font-display seo-h3-sm">Formality scoring</h3>
        <p style="font-size:0.85rem; color:var(--text-muted); line-height:1.65; margin:0;">Measures formality level from casual to formal based on contractions, sentence length, passive voice usage, and technical term density. Compares against the brand's specified formality target.</p>
      </div>
      <div class="result-card">
        <h3 class="font-display seo-h3-sm">Emotional register</h3>
        <p style="font-size:0.85rem; color:var(--text-muted); line-height:1.65; margin:0;">Identifies the emotional undertone of the content: enthusiastic, neutral, professional, playful, or authoritative. Checks alignment with the brand's intended emotional positioning.</p>
      </div>
    </div>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently asked questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I define my brand voice for the reference field?</h3>
        <p itemprop="text" class="seo-faq-a">Describe your brand's personality, tone preferences, vocabulary rules, and formality level in plain text. Include examples of on-brand and off-brand writing if possible. The more specific your guidelines, the more accurate the analysis.</p>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does this work for non-English content?</h3>
        <p itemprop="text" class="seo-faq-a">The current analysis focuses on English-language content. Tone and formality patterns are language-specific, so results may be less accurate for other languages. Multilingual support is planned for future updates.</p>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can it compare multiple pieces of content?</h3>
        <p itemprop="text" class="seo-faq-a">Yes. Run the analysis on each piece separately using the same reference guidelines. Compare the scores to identify which pieces are most aligned and which need revision. Batch comparison for large content sets is a planned feature.</p>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What score indicates good brand alignment?</h3>
        <p itemprop="text" class="seo-faq-a">Scores above 75 indicate strong alignment. Scores between 50 and 75 suggest moderate alignment with room for improvement. Below 50 indicates significant deviation from brand guidelines that should be addressed before publishing.</p>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
  const STOPWORDS = new Set(['the','a','an','and','or','but','in','on','at','to','for','of','is','it','that','this','was','are','be','by','with','as','from','have','has','had','not','do','did','will','would','could','should','can','may','its','their','they','we','you','i','he','she','what','which','who','been','were','so','if','about','more','also','than','then','when','all','one','there','up','out','no','my','your','our','his','her']);

  const POWER_WORDS = ['proven','exclusive','effortless','transform','guarantee','instant','free','new','save','discover','secret','boost','unlock','ultimate','powerful','amazing','simple','fast','easy','best','top','award','trusted','results','success','grow','win','impact','driven','focused'];

  function tokenise(text: string): string[] {
    return text.toLowerCase().replace(/[^a-z\s]/g, ' ').split(/\s+/).filter(w => w.length > 2 && !STOPWORDS.has(w));
  }

  function avgSentenceLength(text: string): number {
    const sentences = text.split(/[.!?]+/).filter(s => s.trim().length > 0);
    if (!sentences.length) return 0;
    const total = sentences.reduce((sum, s) => sum + s.trim().split(/\s+/).length, 0);
    return Math.round(total / sentences.length);
  }

  function topTokens(tokens: string[], n: number): Set<string> {
    const freq = new Map<string, number>();
    tokens.forEach(t => freq.set(t, (freq.get(t) || 0) + 1));
    return new Set([...freq.entries()].sort((a, b) => b[1] - a[1]).slice(0, n).map(([t]) => t));
  }

  function powerDensity(tokens: string[]): number {
    if (!tokens.length) return 0;
    const hits = tokens.filter(t => POWER_WORDS.includes(t)).length;
    return (hits / tokens.length) * 100;
  }

  document.getElementById('gauge-btn')?.addEventListener('click', () => {
    const brandText = (document.getElementById('brand-text') as HTMLTextAreaElement).value;
    const aiText    = (document.getElementById('ai-output') as HTMLTextAreaElement).value;
    if (!brandText.trim() || !aiText.trim()) return;

    const brandTokens = tokenise(brandText);
    const aiTokens    = tokenise(aiText);

    const brandTop  = topTokens(brandTokens, 50);
    const aiTop     = topTokens(aiTokens, 50);
    const overlap   = [...brandTop].filter(t => aiTop.has(t)).length;
    const vocabPct  = brandTop.size > 0 ? Math.round((overlap / brandTop.size) * 100) : 0;

    const brandAvg  = avgSentenceLength(brandText);
    const aiAvg     = avgSentenceLength(aiText);
    const sentDiff  = Math.abs(brandAvg - aiAvg);
    const sentScore = Math.max(0, 100 - sentDiff * 5);

    const brandPow  = powerDensity(brandTokens);
    const aiPow     = powerDensity(aiTokens);
    const powDiff   = Math.abs(brandPow - aiPow);
    const powScore  = Math.max(0, 100 - powDiff * 8);

    const overall   = Math.round((vocabPct + sentScore + powScore) / 3);

    document.getElementById('score-section')!.style.display = 'block';
    (document.getElementById('match-pct') as HTMLElement).textContent = overall + '%';
    (document.getElementById('match-bar') as HTMLElement).style.width  = overall + '%';
    (document.getElementById('m-sent') as HTMLElement).textContent     = `${brandAvg}→${aiAvg}`;
    (document.getElementById('m-vocab') as HTMLElement).textContent    = vocabPct + '%';
    (document.getElementById('m-words') as HTMLElement).textContent    = brandPow.toFixed(1) + '→' + aiPow.toFixed(1) + '%';

    const disc = document.getElementById('discrepancies')!;
    disc.innerHTML = '';
    const issues: { label: string; detail: string; severity: 'warn'|'ok' }[] = [];

    if (sentDiff >= 5) issues.push({ label: 'Sentence length mismatch', detail: `Brand avg ${brandAvg} words/sentence vs AI ${aiAvg} — difference of ${sentDiff} words. ${aiAvg > brandAvg ? 'AI sentences are longer/more complex.' : 'AI sentences are shorter/punchier.'}`, severity: 'warn' });
    else issues.push({ label: 'Sentence length', detail: `Closely matched (${brandAvg} vs ${aiAvg} words/sentence).`, severity: 'ok' });

    if (vocabPct < 30) issues.push({ label: 'Low vocabulary overlap', detail: `Only ${vocabPct}% of brand keywords appear in AI output. AI may be using different terminology or jargon.`, severity: 'warn' });
    else issues.push({ label: 'Vocabulary overlap', detail: `${vocabPct}% shared top keywords — good alignment.`, severity: 'ok' });

    if (powDiff >= 2) issues.push({ label: 'Power word density gap', detail: `Brand density ${brandPow.toFixed(1)}% vs AI ${aiPow.toFixed(1)}% — ${powDiff.toFixed(1)}pp gap. ${aiPow < brandPow ? 'AI output lacks brand\'s emotive vocabulary.' : 'AI output is more hyperbolic than the brand.'}`, severity: 'warn' });
    else issues.push({ label: 'Power word density', detail: `Closely matched (${brandPow.toFixed(1)}% vs ${aiPow.toFixed(1)}%).`, severity: 'ok' });

    issues.forEach(issue => {
      const row = document.createElement('div');
      const isWarn = issue.severity === 'warn';
      row.style.cssText = `background:${isWarn?'#FFF7ED':'#F0FDF4'};border:1px solid ${isWarn?'#FED7AA':'#BBF7D0'};border-radius:0.5rem;padding:0.625rem 0.875rem;`;
      row.innerHTML = `
        <div style="font-size:0.82rem;font-weight:700;color:${isWarn?'#C2410C':'#15803D'};margin-bottom:0.2rem;">${isWarn?'⚠':' ✓'} ${issue.label}</div>
        <div style="font-size:0.78rem;color:var(--text-secondary);line-height:1.55;">${issue.detail}</div>
      `;
      disc.appendChild(row);
    });
  });
</script>
