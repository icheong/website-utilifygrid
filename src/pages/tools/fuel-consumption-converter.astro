---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'fuel-consumption-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Fuel Consumption Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a fuel economy value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="fuel-input">Fuel Economy</label>
        <input id="fuel-input" type="number" value="8" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="fuel-unit">Unit</label>
        <select id="fuel-unit" class="select-themed" style="min-width:12rem;">
          <option value="l100" selected>L/100km (lower = better)</option>
          <option value="kml">km/L (higher = better)</option>
          <option value="mpgus">US mpg (higher = better)</option>
          <option value="mpguk">UK mpg (higher = better)</option>
          <option value="ml100">mL/100m (lower = better)</option>
          <option value="mpml">m/mL (higher = better)</option>
          <option value="migal">mi/US gal (higher = better)</option>
          <option value="miigal">mi/imp gal (higher = better)</option>
        </select>
      </div>
    </div>

    <!-- Direction hint -->
    <div class="seo-p-sm" style="margin-bottom:1rem;">
      L/100km, mL/100m: <strong>lower is better</strong> · All others: <strong>higher is better</strong>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Convert Between MPG, L/100km, and km/L</h2>
    <p class="seo-p">
      A rental car in Europe is rated 6.5 L/100km. You want to know if that is better or worse than your 28 mpg sedan at home. Type 6.5, select L/100km, and see that it equals 31.0 UK mpg or 26.2 US mpg. The European car is slightly more efficient than your sedan. The copy button lets you paste the converted value into a spreadsheet or email.
    </p>
    <p class="seo-p">
      The converter handles 8 units: L/100km, km/L, US mpg, UK mpg, mL/100m, m/mL, mi/US gal, and mi/imp gal. A buyer comparing a Toyota Prius (40.6 US mpg) to a Honda Civic (35.2 US mpg) sees the Prius travels 5.4 more miles per gallon. A fleet manager in Australia converting a truck rated at 45 L/100km to US mpg gets 5.2 mpg, which looks terrible until you remember trucks consume far more fuel than cars. The quick-reference row shows real vehicle benchmarks: Prius at 3.4 L/100km, Civic at 6.2 L/100km, F-150 at 12.4 L/100km.
    </p>

    <h3 class="font-display seo-h3-sm">When the wrong unit makes a huge difference</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['US mpg vs UK mpg confuses car buyers', 'A car dealer advertises "50 mpg" without specifying US or UK. In US mpg that equals 41.6 UK mpg. In UK mpg that equals 41.7 US mpg. The difference is 20% because a UK (imperial) gallon holds 4.546 litres while a US gallon holds 3.785 litres. A buyer who assumes the wrong standard will overestimate fuel savings by 20%. This converter eliminates that ambiguity by showing both values side by side.'],
        ['L/100km and mpg are not simple inverses', 'A car rated 5 L/100km does not equal "1/5 = 0.2 mpg." The correct conversion is 47.0 US mpg because you must account for the mile-to-kilometre and gallon-to-litre conversions simultaneously. The formula is US mpg = 235.215 / (L/100km). Entering 5 L/100km gives 47.0 US mpg, not 0.2. This is the single most common fuel economy conversion mistake.'],
        ['Electric vehicle equivalents confuse consumers', 'A Tesla Model 3 uses about 15 kWh/100km. To compare with a petrol car, you need to know that 1 litre of petrol contains about 8.9 kWh of energy. Dividing: 15 kWh / 8.9 kWh/L = 1.69 L/100km equivalent. The quick-reference shows Tesla Model 3 at 1.7 L/100km equivalent, which is 4x better than a Prius. This helps buyers compare EVs to petrol cars on equal footing.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/length-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Length Converter</a>
        <a href="/tools/volume-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Volume Converter</a>
        <a href="/tools/area-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Area Converter</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Fuel Consumption Converter Handles MPG and L/100km</h2>
    <p class="seo-p">
      All conversions pass through a single base unit: kilometres per litre (km/L). When you enter 30 US mpg, the tool first converts to km/L by multiplying by 2.352145833 (derived from 1 mile = 1.609344 km and 1 US gallon = 3.785411784 L). The result is 70.56 km/L. Then it converts from km/L to each target unit. For L/100km, the formula inverts: 100 / 70.56 = 1.42 L/100km. For UK mpg, it divides by 2.824809703: 70.56 / 2.8248 = 25.0 UK mpg.
    </p>

    <h3 class="font-display seo-h3-sm">Why L/100km and mpg require reciprocal math</h3>
    <p class="seo-p-sm">
      L/100km measures volume per distance (how many litres to travel 100 km). US mpg measures distance per volume (how many miles on one gallon). These are inverse relationships. To convert between them, you cannot just multiply by a constant. You must divide by the value. This is why the converter has special handling for L/100km and mL/100m: it detects these units and applies the reciprocal formula instead of a direct multiplication.
    </p>
    <p class="seo-p-sm">
      The shortcut formula for L/100km to US mpg is: US mpg = 235.215 / (L/100km). This 235.215 constant combines the mile-to-km conversion (1.609344), the gallon-to-L conversion (3.785411784), and the 100-km factor. For UK mpg, the constant is 282.481 instead, because an imperial gallon is 4.54609 L instead of 3.78541 L. The 20% difference between US and UK mpg comes entirely from this gallon size difference.
    </p>

    <h3 class="font-display seo-h3-sm">Quick-reference vehicles and how they compare</h3>
    <p class="seo-p-sm">
      The converter shows real vehicle fuel consumption benchmarks below the results. A Toyota Prius at 3.4 L/100km equals 69.2 US mpg. A Honda Civic at 6.2 L/100km equals 37.9 US mpg. A Ford F-150 at 12.4 L/100km equals 19.0 US mpg. The Bugatti Chiron at 22.5 L/100km equals 10.5 US mpg. These references help you understand whether a converted number is reasonable for the vehicle type.
    </p>
    <p class="seo-p-none">
      The conversion factors are derived from exact international definitions: 1 mile = 1.609344 km, 1 US gallon = 3.785411784 L, 1 imperial gallon = 4.54609 L. The JavaScript factors are IEEE 754 double-precision approximations providing 15-17 significant digits, which is far more precision than any real-world fuel measurement (typically 1-5% uncertainty depending on driving conditions).
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How do I convert 7 L/100km to US mpg?",
          a: "Divide 235.215 by the L/100km value: 235.215 / 7 = 33.6 US mpg. For UK mpg, divide 282.481 by 7 = 40.4 UK mpg. A compact car rated at 7 L/100km is about average for a non-hybrid petrol vehicle. The quick-reference below the results shows this falls between a Honda Civic (6.2 L/100km) and a Toyota Camry (7.4 L/100km)."
        },
        {
          q: "Why is 50 mpg different in the US and UK?",
          a: "A US gallon holds 3.785 litres. An imperial (UK) gallon holds 4.546 litres. So 50 US mpg = 60.0 UK mpg. The UK number is always about 20% higher because the gallon is larger. When a car review says '50 mpg' without specifying the standard, ask which gallon they mean. European reviews typically use UK mpg, while American reviews use US mpg."
        },
        {
          q: "What is a good fuel economy for a family car?",
          a: "A petrol Honda Civic achieves about 6.2 L/100km (37.9 US mpg). A diesel version might get 4.8 L/100km (49.0 US mpg). A hybrid Toyota Prius gets 3.4 L/100km (69.2 US mpg). If you drive 15,000 km per year at $1.50/L, the Prius costs $765 per year in fuel while the Civic costs $1,400. The Prius saves $635 annually, which adds up to $6,350 over 10 years."
        },
        {
          q: "Can I compare electric cars to petrol cars using this converter?",
          a: "Yes, with a conversion step. Electric cars use kWh/100km instead of L/100km. One litre of petrol contains about 8.9 kWh of energy. So a Tesla Model 3 using 15 kWh/100km equals about 1.7 L/100km equivalent (15 / 8.9 = 1.69). The quick-reference includes a Tesla Model 3 entry at 1.7 L/100km equivalent, which is 4x more efficient than a Prius."
        },
        {
          q: "Why does my car use more fuel in winter?",
          a: "Cold weather increases fuel consumption by 15-25% for several reasons: the engine takes longer to reach optimal temperature, denser air increases aerodynamic drag, and winter tyres rolling resistance is higher. If your car gets 6 L/100km in summer, expect 7-7.5 L/100km in winter. This converter helps you compare summer and winter ratings by converting between the units your dashboard displays and the units your dealer quoted."
        },
        {
          q: "How accurate are manufacturer fuel economy ratings?",
          a: "Official ratings are measured under lab conditions (NEDC or WLTP cycles) that do not match real driving. Real-world fuel consumption is typically 20-40% worse than the advertised figure. The WLTP standard introduced in 2018 is more realistic than the old NEDC, but still does not account for aggressive driving, heavy loads, or steep hills. Use the converter to translate between units, but expect actual consumption to be higher than any official rating."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors: all relative to km/L (distance per volume) ──
  // For "higher is better" units, factor = how many km/L that unit equals
  // For "lower is better" units, factor = 100 / (how many L per 100km that unit equals)
  const TO_KML = {
    kml:   1,                                    // 1 km/L = 1 km/L
    l100:  -1,                                   // special: reciprocal
    mpgus: 2.352145833,                          // 1 US mpg → km/L: 235.215 / value
    mpguk: 2.824809703,                          // 1 UK mpg → km/L: 282.481 / value
    ml100: -1,                                   // special: reciprocal
    mpml:  1,                                    // 1 m/mL = 1 km/L
    migal: 0.425143707,                          // 1 mi/US gal → km/L: 1.60934 / 3.78541
    miigal: 0.354006044,                         // 1 mi/imp gal → km/L: 1.60934 / 4.54609
  };

  const UNITS = [
    { id: 'l100',   label: 'L/100km',    name: 'Liters per 100 km',  reciprocal: true },
    { id: 'kml',    label: 'km/L',        name: 'Kilometers per Liter', reciprocal: false },
    { id: 'mpgus',  label: 'US mpg',      name: 'Miles per US Gallon', reciprocal: false },
    { id: 'mpguk',  label: 'UK mpg',      name: 'Miles per Imp Gallon', reciprocal: false },
    { id: 'ml100',  label: 'mL/100m',     name: 'mL per 100 m',       reciprocal: true },
    { id: 'mpml',   label: 'm/mL',        name: 'Meters per mL',      reciprocal: false },
    { id: 'migal',  label: 'mi/US gal',   name: 'Miles per US Gallon', reciprocal: false },
    { id: 'miigal', label: 'mi/imp gal',  name: 'Miles per Imp Gallon', reciprocal: false },
  ];

  // ── Quick-reference vehicles (stored as L/100km) ────────────────
  const REFS = [
    { name: 'Toyota Prius (Hybrid)',   l100: 3.4 },
    { name: 'Honda Civic',             l100: 6.2 },
    { name: 'Toyota Camry',            l100: 7.4 },
    { name: 'Tesla Model 3 (equiv.)',  l100: 1.7 },
    { name: 'Ford F-150',              l100: 12.4 },
    { name: 'Jeep Wrangler',           l100: 13.8 },
    { name: 'Chevrolet Suburban',      l100: 14.7 },
    { name: 'Bugatti Chiron',          l100: 22.5 },
  ];

  const input  = document.getElementById('fuel-input') as HTMLInputElement;
  const select = document.getElementById('fuel-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  function toKML(val: number, fromId: string): number {
    if (fromId === 'l100') return val > 0 ? 100 / val : 0;
    if (fromId === 'ml100') return val > 0 ? 100_000 / val : 0;
    if (fromId === 'mpgus') return val * 2.352145833;
    if (fromId === 'mpguk') return val * 2.824809703;
    return val * TO_KML[fromId];
  }

  function fromKML(kml: number, toId: string): number {
    if (toId === 'l100') return kml > 0 ? 100 / kml : 0;
    if (toId === 'ml100') return kml > 0 ? 100_000 / kml : 0;
    if (toId === 'mpgus') return kml > 0 ? kml / 2.352145833 : 0;
    if (toId === 'mpguk') return kml > 0 ? kml / 2.824809703 : 0;
    return kml / TO_KML[toId];
  }

  function fmt(value: number): string {
    if (Number.isNaN(value) || !isFinite(value)) return '—';
    if (value === 0) return '0';
    return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const kml      = toKML(val, fromUnit);

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = fromKML(kml, u.id);
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    refs.innerHTML = '';
    REFS.forEach(r => {
      const targetKml = toKML(r.l100, 'l100');
      const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
      const converted = fromKML(targetKml, fromUnit);
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
