---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'fuel-consumption-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Fuel Consumption Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a fuel economy value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="fuel-input">Fuel Economy</label>
        <input id="fuel-input" type="number" value="8" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="fuel-unit">Unit</label>
        <select id="fuel-unit" class="select-themed" style="min-width:12rem;">
          <option value="l100" selected>L/100km (lower = better)</option>
          <option value="kml">km/L (higher = better)</option>
          <option value="mpgus">US mpg (higher = better)</option>
          <option value="mpguk">UK mpg (higher = better)</option>
          <option value="ml100">mL/100m (lower = better)</option>
          <option value="mpml">m/mL (higher = better)</option>
          <option value="migal">mi/US gal (higher = better)</option>
          <option value="miigal">mi/imp gal (higher = better)</option>
        </select>
      </div>
    </div>

    <!-- Direction hint -->
    <div class="seo-p-sm" style="margin-bottom:1rem;">
      L/100km, mL/100m: <strong>lower is better</strong> · All others: <strong>higher is better</strong>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Fuel Consumption Converter Overview</h2>
    <p class="seo-p">
      This fuel consumption converter computes precise conversions between 8 fuel economy units covering both metric and imperial systems entirely within your browser. Built with modern vanilla JavaScript, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your calculations, whether you are comparing vehicle specifications, analysing fleet efficiency, or researching international fuel standards.
    </p>
    <p class="seo-p">
      The converter supports the most commonly used fuel economy units across global automotive and engineering contexts: <strong>L/100km</strong> (liters per 100 kilometers) is the standard metric used in most countries worldwide, <strong>km/L</strong> (kilometers per liter) is common in parts of Asia, <strong>US mpg</strong> and <strong>UK mpg</strong> are used in North America and the United Kingdom respectively, and <strong>mL/100m</strong>, <strong>m/mL</strong>, <strong>mi/US gal</strong>, and <strong>mi/imp gal</strong> serve niche engineering and regulatory applications. The tool handles the critical distinction between "lower is better" units (L/100km, mL/100m) and "higher is better" units (all others), where converting between the two types always involves a reciprocal operation.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['International vehicle purchasing and fleet management', 'When importing vehicles or comparing specifications across markets, fuel economy ratings are reported in different units. A European car rated at 5.8 L/100km equals approximately 40.6 US mpg, while a Japanese car rated at 15 km/L equals 6.2 L/100km. Fleet managers overseeing multinational operations need to normalise fuel consumption data across regions to make informed procurement decisions and calculate total cost of ownership accurately.'],
        ['Regulatory compliance and emissions reporting', 'Government agencies and environmental regulators report fleet average fuel economy in different units depending on jurisdiction. The US Environmental Protection Agency (EPA) uses US mpg, while the European Union uses L/100km. Automotive manufacturers must report compliance figures in the local unit and convert between them when submitting cross-border regulatory filings. This tool provides the precise reciprocal conversions needed for accurate compliance documentation.'],
        ['Automotive journalism and consumer comparison', 'Automotive journalists and car-review websites frequently need to convert fuel economy figures when reporting on vehicles sold in different markets. A reviewer testing a European-market vehicle at 4.5 L/100km needs to communicate that as approximately 52.3 US mpg for American readers. The quick-reference section provides real-world vehicle benchmarks — from the Toyota Prius at 3.4 L/100km to the Ford F-150 at 12.4 L/100km — helping readers contextualise converted values.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      The converter employs a hub-and-spoke conversion model using kilometers per liter (km/L) as the universal base unit. Every supported fuel economy unit is defined by a fixed conversion factor relative to km/L. To convert from unit A to unit B, the tool converts the input value to km/L first, then converts from km/L to the target unit. This approach guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">l100</code>, <code class="inline-code">mpgus</code>, <code class="inline-code">kml</code>) to its conversion factor relative to km/L. For "higher is better" units, the factor is a direct multiplier. For "lower is better" units (L/100km, mL/100m), the factor is <code class="inline-code">-1</code> as a sentinel, and special reciprocal logic applies.
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion to km/L:</strong> The input value is converted to km/L using the source unit's factor. For direct units like km/L or m/mL, this is a simple multiplication. For reciprocal units, the tool applies the reciprocal formula: <code class="inline-code">km/L = 100 / (L/100km)</code> for L/100km, or <code class="inline-code">km/L = 100000 / (mL/100m)</code> for mL/100m. For US mpg, the formula is <code class="inline-code">km/L = US mpg × 2.352145833</code>, derived from <code class="inline-code">1 mile / 1 US gal = 1.60934 km / 3.78541 L</code>.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion from km/L:</strong> The km/L value is divided by the target unit's factor. For reciprocal units, the formula is inverted: <code class="inline-code">L/100km = 100 / (km/L)</code>. For direct units like US mpg, the formula is <code class="inline-code">US mpg = km/L / 2.352145833</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code> for direct units, with reciprocal handling for volume-per-distance units.
    </p>
    <p class="seo-p-sm">
      <strong>4. Dynamic formatting:</strong> The display format adapts to the magnitude of the result. Very large values use scientific notation. Values between 1,000 and 1 trillion use locale-formatted numbers with 2 decimal places. Values between 1 and 1,000 use 2 to 4 decimal places. Values below 0.01 use scientific notation. This ensures readability across the full range from mL/100m to high-mpg hypermiling vehicles.
    </p>
    <p class="seo-p-none">
      <strong>Exact conversion factors:</strong> The conversion factors are derived from exact international definitions: <code class="inline-code">1 mile = 1.609344 km</code> (exactly), <code class="inline-code">1 US gallon = 3.785411784 L</code> (exactly), and <code class="inline-code">1 imperial gallon = 4.54609 L</code> (exactly). The US mpg factor of <code class="inline-code">2.352145833</code> comes from <code class="inline-code">1.609344 / 3.785411784</code>, and the UK mpg factor of <code class="inline-code">2.824809703</code> comes from <code class="inline-code">1.609344 / 4.54609</code>. These factors are IEEE 754 double-precision approximations of the exact rational values, providing approximately 15 to 17 significant decimal digits of precision — far beyond the precision of any real-world fuel measurement.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is the difference between US mpg and UK mpg?",
          a: "US mpg uses US gallons (3.785 L) while UK mpg uses imperial gallons (4.546 L). Since an imperial gallon is about 20% larger, the same car will show a higher UK mpg number than US mpg. For example, 30 US mpg is approximately 36 UK mpg. This is why it is critical to specify which mpg standard is being used when comparing vehicle fuel economy ratings."
        },
        {
          q: "What does L/100km mean?",
          a: "L/100km (liters per 100 kilometers) measures how many liters of fuel a vehicle consumes to travel 100 km. Lower values mean better fuel efficiency. It is the standard metric used in most countries worldwide, including the European Union, Australia, and much of Asia. A compact car typically achieves 5-7 L/100km, while a large SUV may use 10-15 L/100km."
        },
        {
          q: "Is higher mpg always better?",
          a: "For distance-per-volume units (mpg, km/L), yes — higher means the vehicle travels further on the same amount of fuel. For volume-per-distance units (L/100km, mL/100m), lower is better because it means less fuel is consumed per distance. The key distinction is that L/100km and mL/100m are reciprocal measures — converting between the two types always involves dividing by the value rather than multiplying."
        },
        {
          q: "How do I convert km/L to L/100km?",
          a: "Divide 100 by the km/L value: L/100km = 100 / km/L. For example, a car that gets 12.5 km/L consumes 8 L/100km (100 / 12.5 = 8). Conversely, to convert L/100km to km/L, divide 100 by the L/100km value. This reciprocal relationship means the conversion is not linear — halving L/100km does not double km/L."
        },
        {
          q: "What is a good fuel economy value?",
          a: "A compact car typically gets 5-7 L/100km (35-50 US mpg). SUVs and trucks use 9-15 L/100km (16-26 US mpg). Hybrid cars can achieve 3-4 L/100km (58-78 US mpg). Electric vehicles do not consume liquid fuel but consume about 15-20 kWh/100km, which is roughly equivalent to 1.5-2.0 L/100km when energy content is compared. The quick-reference section below the results shows real-world vehicle benchmarks for context."
        },
        {
          q: "Why is converting between L/100km and mpg not a simple ratio?",
          a: "L/100km and mpg are reciprocal measures, not linear ones. L/100km measures volume per distance, while mpg measures distance per volume. Converting between them requires dividing by the value (the reciprocal operation), not multiplying. For example, doubling km/L does not halve L/100km — it actually quarters it. This non-linear relationship is why the converter uses special reciprocal handling for these unit pairs."
        },
        {
          q: "How accurate are the conversion factors?",
          a: "The conversion factors are derived from exact international definitions: 1 mile = 1.609344 km exactly, 1 US gallon = 3.785411784 L exactly, and 1 imperial gallon = 4.54609 L exactly. The JavaScript factors are IEEE 754 double-precision approximations, providing approximately 15 to 17 significant decimal digits of precision. This is far more accurate than any real-world fuel measurement, which typically has uncertainty of 1-5% depending on driving conditions, fuel quality, and measurement method."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors: all relative to km/L (distance per volume) ──
  // For "higher is better" units, factor = how many km/L that unit equals
  // For "lower is better" units, factor = 100 / (how many L per 100km that unit equals)
  const TO_KML = {
    kml:   1,                                    // 1 km/L = 1 km/L
    l100:  -1,                                   // special: reciprocal
    mpgus: 2.352145833,                          // 1 US mpg → km/L: 235.215 / value
    mpguk: 2.824809703,                          // 1 UK mpg → km/L: 282.481 / value
    ml100: -1,                                   // special: reciprocal
    mpml:  1,                                    // 1 m/mL = 1 km/L
    migal: 0.425143707,                          // 1 mi/US gal → km/L: 1.60934 / 3.78541
    miigal: 0.354006044,                         // 1 mi/imp gal → km/L: 1.60934 / 4.54609
  };

  const UNITS = [
    { id: 'l100',   label: 'L/100km',    name: 'Liters per 100 km',  reciprocal: true },
    { id: 'kml',    label: 'km/L',        name: 'Kilometers per Liter', reciprocal: false },
    { id: 'mpgus',  label: 'US mpg',      name: 'Miles per US Gallon', reciprocal: false },
    { id: 'mpguk',  label: 'UK mpg',      name: 'Miles per Imp Gallon', reciprocal: false },
    { id: 'ml100',  label: 'mL/100m',     name: 'mL per 100 m',       reciprocal: true },
    { id: 'mpml',   label: 'm/mL',        name: 'Meters per mL',      reciprocal: false },
    { id: 'migal',  label: 'mi/US gal',   name: 'Miles per US Gallon', reciprocal: false },
    { id: 'miigal', label: 'mi/imp gal',  name: 'Miles per Imp Gallon', reciprocal: false },
  ];

  // ── Quick-reference vehicles (stored as L/100km) ────────────────
  const REFS = [
    { name: 'Toyota Prius (Hybrid)',   l100: 3.4 },
    { name: 'Honda Civic',             l100: 6.2 },
    { name: 'Toyota Camry',            l100: 7.4 },
    { name: 'Tesla Model 3 (equiv.)',  l100: 1.7 },
    { name: 'Ford F-150',              l100: 12.4 },
    { name: 'Jeep Wrangler',           l100: 13.8 },
    { name: 'Chevrolet Suburban',      l100: 14.7 },
    { name: 'Bugatti Chiron',          l100: 22.5 },
  ];

  const input  = document.getElementById('fuel-input') as HTMLInputElement;
  const select = document.getElementById('fuel-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  function toKML(val: number, fromId: string): number {
    if (fromId === 'l100') return val > 0 ? 100 / val : 0;
    if (fromId === 'ml100') return val > 0 ? 100_000 / val : 0;
    if (fromId === 'mpgus') return val * 2.352145833;
    if (fromId === 'mpguk') return val * 2.824809703;
    return val * TO_KML[fromId];
  }

  function fromKML(kml: number, toId: string): number {
    if (toId === 'l100') return kml > 0 ? 100 / kml : 0;
    if (toId === 'ml100') return kml > 0 ? 100_000 / kml : 0;
    if (toId === 'mpgus') return kml > 0 ? kml / 2.352145833 : 0;
    if (toId === 'mpguk') return kml > 0 ? kml / 2.824809703 : 0;
    return kml / TO_KML[toId];
  }

  function fmt(value: number): string {
    if (Number.isNaN(value) || !isFinite(value)) return '—';
    if (value === 0) return '0';
    return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const kml      = toKML(val, fromUnit);

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = fromKML(kml, u.id);
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    refs.innerHTML = '';
    REFS.forEach(r => {
      const targetKml = toKML(r.l100, 'l100');
      const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
      const converted = fromKML(targetKml, fromUnit);
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
