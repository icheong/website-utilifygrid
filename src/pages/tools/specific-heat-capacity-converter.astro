---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'specific-heat-capacity-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Specific Heat Capacity Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="J_kgK">Joule per Kilogram-Kelvin (J/(kg·K))</option>
          <option value="kJ_kgK">Kilojoule per Kilogram-Kelvin (kJ/(kg·K))</option>
          <option value="cal_gC">Calorie per Gram-°C (cal/(g·°C))</option>
          <option value="kcal_kgC">Kilocalorie per Kilogram-°C (kcal/(kg·°C))</option>
          <option value="BTU_lbF">BTU per Pound-°F (BTU/(lb·°F))</option>
          <option value="J_gK">Joule per Gram-Kelvin (J/(g·K))</option>
          <option value="Wh_kgK">Watt-Hour per Kilogram-Kelvin (Wh/(kg·K))</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Specific Heat Capacity Converter</h2>
    <p class="seo-p">A materials science lab report lists the specific heat of an unknown alloy as 0.21 BTU per pound per degree Fahrenheit. Your thermal simulation software requires the value in joules per kilogram per kelvin. The numbers are in completely different unit systems and the conversion is not intuitive. Enter the value, pick the source unit, and the converter shows the equivalent in all seven supported specific heat capacity units.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">HVAC engineers sizing cooling systems</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A chilled water system specification lists the coolant specific heat as 1.0 kilocalorie per kilogram per degree C. Convert to joules per kilogram per kelvin and the result is 4184 — exactly the value of pure water. The converter also shows 0.999 BTU per pound per degree F for the American engineering specification document.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Chemists interpreting legacy calorie data</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A 1970s chemistry reference reports a compound specific heat as 0.58 calories per gram per degree C. Enter 0.58 in cal per g per degree C and the converter shows 2426.7 joules per kilogram per kelvin. The calorie-based unit is rarely used in modern papers but still appears in older literature and some food science references.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Battery engineers comparing thermal management fluids</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">A battery thermal management spec requires a coolant with specific heat above 3000 joules per kilogram per kelvin. Water at 4186 qualifies easily. Enter 4186 in J per kg per K and the converter shows 0.999 kilocalorie per kilogram per degree C and 0.999 BTU per pound per degree F — values you can cite in the US procurement document.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Mechanical engineers selecting engine coolants</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">An engine coolant datasheet lists specific heat as 3500 joules per kilogram per kelvin. Convert to watt-hours per kilogram per kelvin and the result is 0.972 — still well above the 0.8 threshold that separates effective coolants from marginal ones. The converter also shows 0.836 BTU per pound per degree F for the American automotive engineering specification.</p>
      </div>
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/thermal-conductivity-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Thermal Conductivity Converter</a>
        <a href="/tools/heat-density-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Heat Density Converter</a>
        <a href="/tools/thermal-resistance-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Thermal Resistance Converter</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Specific Heat Capacity Converter Works</h2>
    <p class="seo-p">This converter translates values between seven specific heat capacity units using a fixed-factor hub-and-spoke model with J/(kg·K) as the base. Every calculation runs locally in the browser.</p>

    <h3 class="font-display seo-h3-sm">Specific Heat Capacity Units</h3>
    <p class="seo-p">The tool supports seven units: <code class="inline-code">J/(kg·K)</code> (SI), <code class="inline-code">kJ/(kg·K)</code> (kilojoule), <code class="inline-code">cal/(g·°C)</code> (thermochemical calorie), <code class="inline-code">kcal/(kg·°C)</code> (kilocalorie), <code class="inline-code">BTU/(lb·°F)</code> (British thermal unit), <code class="inline-code">J/(g·K)</code> (gram-based joule), and <code class="inline-code">Wh/(kg·K)</code> (watt-hour). Each unit maps to a fixed factor relative to J/(kg·K): kJ/(kg·K) = 1000, cal/(g·°C) = 4184, kcal/(kg·°C) = 4184, BTU/(lb·°F) = 4186.8, J/(g·K) = 1000, Wh/(kg·K) = 3600.</p>

    <h3 class="font-display seo-h3-sm">Conversion Mathematics</h3>
    <p class="seo-p">To convert from unit A to unit B, the tool multiplies the input by A's factor to reach J/(kg·K), then divides by B's factor. The formula is <code class="inline-code">Result = Input × (FromFactor ÷ ToFactor)</code>. Because both mass and temperature scale factors are baked into each unit's conversion constant, a single multiplication and division handles the full conversion — no separate mass or temperature unit steps are needed.</p>

    <h3 class="font-display seo-h3-sm">Physical Significance</h3>
    <p class="seo-p">Specific heat capacity measures how much energy a material absorbs per unit mass for a given temperature rise. Materials with high specific heat, like water at 4186 J/(kg·K), resist temperature changes and are used as coolants and heat buffers. Metals have low specific heats (copper ~385 J/(kg·K), aluminum ~897 J/(kg·K)) because their atomic lattices transfer thermal energy efficiently. This property is fundamental in thermodynamics, HVAC design, and materials engineering.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is specific heat capacity?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Specific heat capacity is the amount of thermal energy required to raise the temperature of one kilogram of a substance by one degree Celsius (or one Kelvin). It is measured in J/(kg·K) in SI units. Water has one of the highest specific heat capacities at about 4186 J/(kg·K), which is why it absorbs so much heat before warming up.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why does water have such a high specific heat?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Water's high specific heat comes from hydrogen bonding between its molecules. Energy is needed to break these bonds before the molecules can move faster and raise the temperature. This property makes water an excellent coolant and explains why coastal regions have milder climates than inland areas.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between Cp and Cv?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Cp is specific heat at constant pressure, where the substance is free to expand. Cv is specific heat at constant volume, where expansion is prevented. For ideal gases, Cp is always greater than Cv because some energy goes into work against atmospheric pressure during expansion.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What are typical specific heat values for metals?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Most metals have specific heats well below 1000 J/(kg·K). Aluminum is about 897, iron is 449, copper is 385, and lead is only 128 J/(kg·K). These low values mean metals heat up and cool down quickly, which is why metal cookware responds rapidly to stove temperature changes.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do cal/(g·°C) and kcal/(kg·°C) relate?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">These two units are numerically identical. Multiplying both the mass and the energy in cal/(g·°C) by 1000 gives kcal/(kg·°C), so the prefix 'kilo-' cancels on both sides. This means 1 cal/(g·°C) equals exactly 1 kcal/(kg·°C), and both equal 4184 J/(kg·K).</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why is specific heat important in engineering?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Specific heat determines how much energy must be supplied to change a material's temperature. Engineers use it to size HVAC systems, design heat exchangers, select engine coolants, and predict thermal behavior in electronics cooling. Materials with high specific heat are preferred for thermal storage, while low-specific-heat materials are chosen for rapid thermal response.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'J_kgK',   label: 'Joule per Kilogram-Kelvin (J/(kg·K))',           abbr: 'J/(kg·K)',     factor: 1 },
    { id: 'kJ_kgK',  label: 'Kilojoule per Kilogram-Kelvin (kJ/(kg·K))',      abbr: 'kJ/(kg·K)',    factor: 1000 },
    { id: 'cal_gC',  label: 'Calorie per Gram-°C (cal/(g·°C))',               abbr: 'cal/(g·°C)',   factor: 4184 },
    { id: 'kcal_kgC', label: 'Kilocalorie per Kilogram-°C (kcal/(kg·°C))',    abbr: 'kcal/(kg·°C)', factor: 4184 },
    { id: 'BTU_lbF', label: 'BTU per Pound-°F (BTU/(lb·°F))',                 abbr: 'BTU/(lb·°F)',  factor: 4186.8 },
    { id: 'J_gK',    label: 'Joule per Gram-Kelvin (J/(g·K))',                 abbr: 'J/(g·K)',      factor: 1000 },
    { id: 'Wh_kgK',  label: 'Watt-Hour per Kilogram-Kelvin (Wh/(kg·K))',       abbr: 'Wh/(kg·K)',    factor: 3600 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
