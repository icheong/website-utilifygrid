---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'json-to-typescript')!;
---
<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">JSON to TypeScript Generator</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Paste any JSON payload to generate TypeScript interfaces or Zod schemas instantly.</p>

    <!-- Output mode toggle -->
    <div class="toggle-group" style="margin-bottom:1.25rem;" role="group" aria-label="Output mode">
      <button class="toggle-btn active" data-mode="interface" type="button">TypeScript Interface</button>
      <button class="toggle-btn" data-mode="zod" type="button">Zod Schema</button>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.875rem;margin-bottom:1rem;">
      <div>
        <label style="display:block;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);margin-bottom:0.4rem;">JSON Input</label>
        <textarea id="json-input" class="input-themed"
          placeholder='{"id":1,"name":"Alice","active":true}'
          rows="10"
          style="width:100%;box-sizing:border-box;resize:vertical;border-radius:0.625rem;padding:0.875rem 1rem;font-family:'Fira Code',monospace;font-size:0.78rem;line-height:1.65;"
        ></textarea>
      </div>
      <div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
          <label style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);">Output</label>
          <button id="btn-copy-output" class="btn-secondary" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;">Copy</button>
        </div>
        <textarea id="ts-output" class="input-themed" readonly rows="10"
          placeholder="TypeScript output will appear here…"
          style="width:100%;box-sizing:border-box;resize:vertical;border-radius:0.625rem;padding:0.875rem 1rem;font-family:'Fira Code',monospace;font-size:0.78rem;line-height:1.65;background:var(--bg-surface-2);"
        ></textarea>
      </div>
    </div>

    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
      <button id="btn-generate" class="btn-primary" type="button">Generate</button>
      <button id="btn-sample"   class="btn-secondary" type="button" style="font-size:0.82rem;">Load sample</button>
      <button id="btn-clear"    class="btn-secondary" type="button" style="font-size:0.82rem;">Clear</button>
    </div>

    <p id="json-error" style="display:none;color:#EF4444;font-size:0.82rem;margin-top:0.75rem;"></p>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >Paste JSON — get TypeScript interfaces or Zod schemas in one click</h2>
    <p class="seo-p" >
      You're consuming a REST API and the response is a 40-line JSON object with nested objects and arrays. You need to write TypeScript interfaces for every level of nesting, name each one correctly, handle the nullable fields, and deal with the mixed-type array. Instead of typing it all manually — which takes 15 minutes and you'll probably miss a field — paste the JSON here and get a complete set of exported interfaces in one click. Toggle to Zod mode if you also need runtime validation schemas.
    </p>
    <p class="seo-p" >
      Paste JSON into the left panel — the output updates automatically. The tool handles nested objects (generating sub-interfaces with PascalCase names), arrays (inferring element types), mixed-type arrays (producing union types), and null values (marking fields as optional). Click <strong>Copy</strong> to export the result directly into your codebase.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Who uses this generator</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Developers typing API responses', 'A developer receives a 200-line JSON response from a payments API and needs TypeScript interfaces for every endpoint. Instead of manually writing each interface — which is tedious and error-prone — they paste a sample response and get a complete, correctly-nested interface in seconds. For 30 endpoints, that\'s 30 pastes instead of 30 minutes of manual typing.'],
        ['Teams adding Zod validation to config files', 'A Node.js application loads configuration from a JSON file. A TypeScript interface gives compile-time safety, but Zod schemas add runtime validation — catching malformed config at startup instead of at an unpredictable point during execution. The Zod mode generates importable schemas with .nullable().optional() chains for null values and z.union() for mixed arrays.'],
        ['Test fixture authors creating mock data', 'When writing integration tests, you need typed mock data that matches the API contract. Paste a real API response, generate the interface, and your test fixtures are type-safe. The generated types will catch mismatches at compile time — a typo in a field name or a wrong type becomes a TypeScript error instead of a flaky test.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/json-yaml-toml-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">JSON to YAML / TOML Converter</a>
        <a href="/tools/json-prettifier" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">JSON Prettifier</a>
        <a href="/tools/json-schema-validator" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">JSON Payload Schema Validator</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >How the generator infers types from your JSON</h2>

    <h3 class="font-display seo-h3-sm" >Basic type mapping</h3>
    <p class="seo-p" >
      The generator reads each value in your JSON and maps it to a TypeScript type: strings become <code>string</code>, numbers become <code>number</code>, booleans become <code>boolean</code>, and null marks a field as optional with type <code>string | null</code>. Arrays are typed by looking at the first element — an array of objects becomes <code>Item[]</code>, an array of strings becomes <code>string[]</code>. Objects trigger a new interface block with the property name converted to PascalCase.
    </p>

    <h3 class="font-display seo-h3-sm" >Worked example: the sample payload</h3>
    <p class="seo-p" >
      The sample JSON contains an id (number), name, email (strings), age (null), roles (array of strings), address (nested object with street, city, postcode), and active (boolean). The generator produces: an <code>export interface Root</code> with <code>id: number</code>, <code>name: string</code>, <code>email: string</code>, <code>age?: string | null</code> (optional because null), <code>roles: string[]</code>, <code>address: Address</code> (a new sub-interface), and <code>active: boolean</code>. The Address interface contains <code>street: string</code>, <code>city: string</code>, <code>postcode: string</code>.
    </p>

    <h3 class="font-display seo-h3-sm" >What happens with arrays</h3>
    <p class="seo-p" >
      If all elements in an array have the same type, it generates a typed array — <code>string[]</code>, <code>number[]</code>, or <code>Item[]</code> for objects. If the array mixes types (like <code>[1, "hello", true]</code>), it collects the unique inferred types and produces a union: <code>(string | number | boolean)[]</code>. Empty arrays produce <code>unknown[]</code> because there's nothing to infer the element type from.
    </p>

    <h3 class="font-display seo-h3-sm" >Zod mode: runtime validation</h3>
    <p class="seo-p" >
      In Zod mode, the same traversal generates <code>z.string()</code>, <code>z.number()</code>, <code>z.boolean()</code> for primitives. Null values produce <code>.nullable().optional()</code>. Arrays become <code>z.array()</code>. Objects become <code>z.object()</code> with nested schemas exported as standalone constants. The output includes an import statement and a type inference line: <code>export type Root = z.infer&lt;typeof rootSchema&gt;</code> — giving you both runtime validation and compile-time type safety from a single source.
    </p>

    <h3 class="font-display seo-h3-sm" >Edge cases</h3>
    <p class="seo-p" >
      Top-level arrays are wrapped in a root type alias (<code>type Root = Item[]</code>) rather than an interface, because TypeScript doesn't allow interfaces to extend arrays. Nested object names are derived from the property key using PascalCase — <code>address</code> becomes <code>Address</code>, <code>shipping_info</code> becomes <code>ShippingInfo</code>. The generator handles any nesting depth — the recursion terminates naturally when it reaches primitives or empty arrays.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {q:'Does it handle deeply nested JSON?',a:'Yes. The generator recurses through nested objects and creates sub-interfaces (or nested Zod objects) for each level. Interface names are derived from the property name using PascalCase — a field called shipping_info becomes ShippingInfo. There is no practical depth limit; the recursion terminates when it reaches primitives (string, number, boolean, null) or empty arrays.'},
        {q:'What happens with arrays of mixed types?',a:'If an array contains elements of different types, the generator collects the unique inferred types and produces a union type — for example, (string | number)[] for a mixed array. In Zod mode, it uses z.union() with the detected member schemas. The deduction is based on the actual runtime types present in the elements.'},
        {q:'Why use Zod instead of a TypeScript interface?',a:'TypeScript interfaces are erased at compile time — they provide no runtime safety. Zod schemas validate data at runtime, which matters for API responses, form inputs, user uploads, or any external data where the shape can\'t be guaranteed. Both are complementary: Zod schemas infer TypeScript types via z.infer<typeof schema>, giving you both runtime validation and compile-time type safety from a single source.'},
        {q:'Can I paste a JSON array at the top level?',a:'Yes. If the top-level value is an array, the generator wraps it in a root type alias. For interfaces it produces type Root = Item[]; for Zod it produces z.array(itemSchema). The item type is inferred from the array elements.'},
        {q:'How does the tool handle null values?',a:'JSON null is not a TypeScript primitive. When the generator encounters null, it marks the field as optional using the ? syntax and types it as string | null (the most common intent). In Zod mode, null values produce .nullable().optional(), allowing both null and undefined at runtime.'},
        {q:'Is the generated code production-ready?',a:'The output follows TypeScript and Zod best practices: exported interfaces, proper nesting, correct union types, and valid Zod schema composition. For production use, review the generated types against your actual data contracts — the tool infers from the shape of the sample JSON you provide, so ensure your sample represents all possible response shapes.'},
        {q:'What if my JSON has duplicate keys?',a:'JSON parsers handle duplicate keys by keeping the last value. If your JSON has {"name":"Alice","name":"Bob"}, the parser sees only name: "Bob". The generator will produce name: string — it can\'t detect the duplicate because the parser already resolved it. For most real-world JSON (from APIs or config files), duplicate keys aren\'t an issue.'},
      ].map(item=>(
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a" set:html={item.a} />
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLE = JSON.stringify({id:1,name:"Alice",email:"alice@example.com",age:null,roles:["admin","editor"],address:{street:"123 Main St",city:"Sydney",postcode:"2000"},active:true},null,2);

  let outputMode = 'interface';
  const modeBtns  = document.querySelectorAll<HTMLButtonElement>('[data-mode]');
  modeBtns.forEach(btn => btn.addEventListener('click', () => {
    outputMode = btn.dataset.mode!;
    modeBtns.forEach(b => { b.classList.toggle('active', b.dataset.mode === outputMode); b.setAttribute('aria-pressed', String(b.dataset.mode === outputMode)); });
    generate();
  }));

  function toPascal(s: string): string { return s.charAt(0).toUpperCase() + s.slice(1); }

  function inferInterface(obj: any, name = 'Root', lines: string[] = []): string {
    if (Array.isArray(obj)) {
      const itemType = obj.length ? inferType(obj[0], name + 'Item', lines) : 'unknown';
      lines.push(`export type ${name} = ${itemType}[];`);
      return name;
    }
    lines.push(`export interface ${name} {`);
    for (const [key, val] of Object.entries(obj)) {
      const t = inferType(val, toPascal(key), lines);
      const opt = val === null ? '?' : '';
      lines.push(`  ${key}${opt}: ${t};`);
    }
    lines.push('}');
    return name;
  }

  function inferType(val: any, name: string, lines: string[]): string {
    if (val === null)              return 'string | null';
    if (typeof val === 'string')   return 'string';
    if (typeof val === 'number')   return 'number';
    if (typeof val === 'boolean')  return 'boolean';
    if (Array.isArray(val)) {
      if (!val.length) return 'unknown[]';
      const types = [...new Set(val.map((v: any) => inferType(v, name + 'Item', lines)))];
      const inner = types.length === 1 ? types[0] : `(${types.join(' | ')})`;
      return `${inner}[]`;
    }
    if (typeof val === 'object') { inferInterface(val, name, lines); return name; }
    return 'unknown';
  }

  function inferZod(obj: any, name = 'rootSchema', lines: string[] = []): string {
    if (Array.isArray(obj)) {
      const itemName = name + 'Item';
      const itemSchema = obj.length ? inferZodType(obj[0], itemName, lines) : 'z.unknown()';
      lines.push(`export const ${name} = z.array(${itemSchema});`);
      return name;
    }
    const fields: string[] = [];
    for (const [key, val] of Object.entries(obj)) {
      const t = inferZodType(val, toPascal(key) + 'Schema', lines);
      const schema = val === null ? `${t}.nullable().optional()` : t;
      fields.push(`  ${key}: ${schema}`);
    }
    lines.push(`export const ${name} = z.object({\n${fields.join(',\n')}\n});`);
    return name;
  }

  function inferZodType(val: any, name: string, lines: string[]): string {
    if (val === null)              return 'z.string()';
    if (typeof val === 'string')   return 'z.string()';
    if (typeof val === 'number')   return 'z.number()';
    if (typeof val === 'boolean')  return 'z.boolean()';
    if (Array.isArray(val)) {
      if (!val.length) return 'z.array(z.unknown())';
      const types = [...new Set(val.map((v: any) => inferZodType(v, name + 'Item', lines)))];
      const inner = types.length === 1 ? types[0] : `z.union([${types.join(', ')}])`;
      return `z.array(${inner})`;
    }
    if (typeof val === 'object') { inferZod(val, name, lines); return name; }
    return 'z.unknown()';
  }

  function generate() {
    const raw = (document.getElementById('json-input') as HTMLTextAreaElement).value.trim();
    const errEl = document.getElementById('json-error')!;
    const out   = document.getElementById('ts-output') as HTMLTextAreaElement;
    errEl.style.display = 'none';
    if (!raw) { out.value = ''; return; }
    try {
      const parsed = JSON.parse(raw);
      const lines: string[] = [];
      if (outputMode === 'interface') {
        inferInterface(parsed, 'Root', lines);
      } else {
        lines.unshift('import { z } from "zod";', '');
        inferZod(parsed, 'rootSchema', lines);
        lines.push('', `export type Root = z.infer<typeof rootSchema>;`);
      }
      out.value = lines.join('\n');
    } catch(e) {
      errEl.textContent = 'Invalid JSON: ' + (e as Error).message;
      errEl.style.display = 'block';
      out.value = '';
    }
  }

  document.getElementById('btn-generate')!.addEventListener('click', generate);
  document.getElementById('json-input')!.addEventListener('input', generate);
  document.getElementById('btn-sample')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = SAMPLE;
    generate();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = '';
    (document.getElementById('ts-output') as HTMLTextAreaElement).value = '';
    document.getElementById('json-error')!.style.display = 'none';
  });
  document.getElementById('btn-copy-output')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy-output')!;
    const text = (document.getElementById('ts-output') as HTMLTextAreaElement).value;
    navigator.clipboard.writeText(text).then(() => {
      btn.textContent = '✓ Copied!'; btn.classList.add('btn-success');
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
    });
  });
</script>
