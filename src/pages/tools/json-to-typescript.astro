---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'json-to-typescript')!;
---
<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">JSON to TypeScript Generator</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Paste any JSON payload to generate TypeScript interfaces or Zod schemas instantly.</p>

    <!-- Output mode toggle -->
    <div class="toggle-group" style="margin-bottom:1.25rem;" role="group" aria-label="Output mode">
      <button class="toggle-btn active" data-mode="interface" type="button">TypeScript Interface</button>
      <button class="toggle-btn" data-mode="zod" type="button">Zod Schema</button>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.875rem;margin-bottom:1rem;">
      <div>
        <label style="display:block;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);margin-bottom:0.4rem;">JSON Input</label>
        <textarea id="json-input" class="input-themed"
          placeholder='{"id":1,"name":"Alice","active":true}'
          rows="10"
          style="width:100%;box-sizing:border-box;resize:vertical;border-radius:0.625rem;padding:0.875rem 1rem;font-family:'Fira Code',monospace;font-size:0.78rem;line-height:1.65;"
        ></textarea>
      </div>
      <div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
          <label style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);">Output</label>
          <button id="btn-copy-output" class="btn-secondary" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;">Copy</button>
        </div>
        <textarea id="ts-output" class="input-themed" readonly rows="10"
          placeholder="TypeScript output will appear here…"
          style="width:100%;box-sizing:border-box;resize:vertical;border-radius:0.625rem;padding:0.875rem 1rem;font-family:'Fira Code',monospace;font-size:0.78rem;line-height:1.65;background:var(--bg-surface-2);"
        ></textarea>
      </div>
    </div>

    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
      <button id="btn-generate" class="btn-primary" type="button">Generate</button>
      <button id="btn-sample"   class="btn-secondary" type="button" style="font-size:0.82rem;">Load sample</button>
      <button id="btn-clear"    class="btn-secondary" type="button" style="font-size:0.82rem;">Clear</button>
    </div>

    <p id="json-error" style="display:none;color:#EF4444;font-size:0.82rem;margin-top:0.75rem;"></p>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >JSON to TypeScript Generator — Overview &amp; Modern Technical Context</h2>
    <p class="text-secondary seo-p" >
      TypeScript has become the dominant typed superset of JavaScript, with over 80% of new JavaScript projects adopting it for compile-time type safety. A frequent workflow bottleneck is manually translating JSON payloads — from API responses, configuration files, or test fixtures — into TypeScript type definitions. This generator automates that process entirely in the browser using vanilla JavaScript. Paste any JSON object, and the tool recursively infers TypeScript interfaces or Zod validation schemas in real time. No data leaves your browser; no server calls are made; no cookies or tracking scripts execute.
    </p>
    <p class="text-secondary seo-p" >
      The tool supports two output modes: <strong>TypeScript Interface</strong> (generates exported interface declarations with proper nesting) and <strong>Zod Schema</strong> (generates runtime validation schemas using the Zod library). Both modes handle nested objects, arrays of any depth, optional fields detected from <code>null</code> values, and union types derived from mixed-type arrays. Paste JSON into the left panel and the output updates automatically — no manual "Generate" click required, though one is available. Click <strong>Copy</strong> to export the result directly into your codebase.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['API response typing', 'When consuming REST or GraphQL APIs, developers receive JSON payloads that must be typed in the application. Instead of manually writing interfaces for each endpoint — which is error-prone and tedious — paste a sample response into this generator to produce a complete, ready-to-use TypeScript interface. This is particularly valuable when working with large API surfaces (e.g., Stripe, Twilio, or internal microservices) where dozens of response types need definitions.'],
        ['Configuration file validation', 'Projects that load configuration from JSON or YAML files benefit from both TypeScript types and Zod schemas. The interface mode provides compile-time safety when accessing config properties, while the Zod mode adds runtime validation that catches malformed config at application startup. This dual approach is standard practice in production Node.js applications.'],
        ['Test fixture generation', 'When writing integration tests, developers often need typed mock data that matches API contracts. Generating a TypeScript interface from a real API response ensures test fixtures are type-safe and will compile against the actual data shape. The Zod mode is equally useful for creating test schemas that validate mock data matches expected structures.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >Deep-Dive: Type Inference Rules &amp; Schema Generation Mechanics</h2>

    <h3 class="font-display seo-h3-sm" >TypeScript Interface Inference</h3>
    <div style="display:flex;flex-direction:column;gap:0.5rem;margin-bottom:1rem">
      <div class="info-row"><span class="info-label">string</span><span class="info-value">JSON string → <code>string</code></span></div>
      <div class="info-row"><span class="info-label">number</span><span class="info-value">JSON number → <code>number</code> (IEEE 754 double-precision)</span></div>
      <div class="info-row"><span class="info-label">boolean</span><span class="info-value">JSON boolean → <code>boolean</code></span></div>
      <div class="info-row"><span class="info-label">null</span><span class="info-value">JSON null → field marked optional (<code>?</code>) with type <code>string | null</code></span></div>
      <div class="info-row"><span class="info-label">array</span><span class="info-value">Infers element type from first element, generates <code>Type[]</code>. Mixed arrays produce union types.</span></div>
      <div class="info-row"><span class="info-label">object</span><span class="info-value">Recursively generates nested interface with PascalCase naming derived from property key</span></div>
    </div>

    <h3 class="font-display seo-h3-sm" >Zod Schema Generation</h3>
    <div style="display:flex;flex-direction:column;gap:0.5rem;margin-bottom:1rem">
      <div class="info-row"><span class="info-label">Primitives</span><span class="info-value"><code>z.string()</code>, <code>z.number()</code>, <code>z.boolean()</code> map directly from JSON types</span></div>
      <div class="info-row"><span class="info-label">Nullable</span><span class="info-value">Fields with <code>null</code> values produce <code>.nullable().optional()</code> chain</span></div>
      <div class="info-row"><span class="info-label">Arrays</span><span class="info-value"><code>z.array()</code> wrapping inferred element type or <code>z.union()</code> for mixed arrays</span></div>
      <div class="info-row"><span class="info-label">Objects</span><span class="info-value"><code>z.object()</code> with recursive field schemas; nested objects generate separate exported schemas</span></div>
    </div>

    <h3 class="font-display seo-h3-sm" >How the Generator Processes Input</h3>
    <p class="text-secondary seo-p" >
      The generator listens to <code>input</code> events on the JSON textarea. On each keystroke, it attempts <code>JSON.parse()</code> on the trimmed content. If parsing succeeds, the resulting JavaScript object is passed to either <code>inferInterface()</code> or <code>inferZod()</code> depending on the selected output mode. Both functions perform a single-pass recursive traversal of the object tree. For interface mode, each object key generates a property line with its inferred type, and nested objects trigger a new <code>export interface</code> block appended to the output. For Zod mode, the same traversal produces <code>z.object()</code> calls with nested schemas exported as standalone constants.
    </p>
    <p class="text-secondary seo-p-none" >
      <strong>Edge cases handled:</strong> Empty arrays produce <code>unknown[]</code> (interface) or <code>z.array(z.unknown())</code> (Zod) since no element type can be inferred. Mixed-type arrays produce union types by collecting unique inferred types via a <code>Set</code>. Top-level arrays are wrapped in a root type alias (<code>type Root = Item[]</code>) rather than an interface, since TypeScript does not allow interfaces to extend arrays. Nested object names are derived from the property key using PascalCase conversion, ensuring valid TypeScript identifiers.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {q:'Does it handle deeply nested JSON?',a:'Yes. The generator recurses through nested objects and creates sub-interfaces (or nested Zod objects) for each level. Interface names are derived from the property name using PascalCase. There is no practical depth limit — the recursion terminates naturally when it reaches primitive values (string, number, boolean, null) or empty arrays.'},
        {q:'What happens with arrays of mixed types?',a:'If an array contains elements of different types, the generator collects the unique inferred types and produces a union type (e.g., <code>(string | number)[]</code>). For Zod mode, it uses <code>z.union()</code> with the detected member schemas. The type deduction is based on the actual runtime types present in the first few elements of the array.'},
        {q:'Why use Zod instead of a TypeScript interface?',a:'TypeScript interfaces are erased at compile time — they provide no runtime safety. Zod schemas validate data at runtime, which is critical for API responses, form inputs, user uploads, or any external data source where the shape cannot be guaranteed. Both approaches are complementary: Zod schemas can infer TypeScript types automatically via <code>z.infer<typeof schema></code>, giving you both runtime validation and compile-time type safety from a single source.'},
        {q:'Can I paste a JSON array at the top level?',a:'Yes. If the top-level JSON value is an array, the generator wraps it in a root type alias. For interfaces it produces <code>type Root = Item[]</code>; for Zod it produces <code>z.array(itemSchema)</code>. The item type is inferred from the first element of the array.'},
        {q:'How does the tool handle null values in JSON?',a:'JSON <code>null</code> is not a TypeScript primitive. When the generator encounters a <code>null</code> value, it marks the field as optional using the <code>?</code> syntax and types it as <code>string | null</code> (the most common intent). In Zod mode, null values produce <code>.nullable().optional()</code>, allowing both <code>null</code> and <code>undefined</code> at runtime.'},
        {q:'Is the generated code production-ready?',a:'The output follows TypeScript and Zod best practices: exported interfaces, proper nesting, correct union types, and valid Zod schema composition. For production use, review the generated types against your actual data contracts — the tool infers from the shape of the sample JSON you provide, so ensure your sample is representative of all possible response shapes.'},
      ].map(item=>(
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a" set:html={item.a} />
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLE = JSON.stringify({id:1,name:"Alice",email:"alice@example.com",age:null,roles:["admin","editor"],address:{street:"123 Main St",city:"Sydney",postcode:"2000"},active:true},null,2);

  let outputMode = 'interface';
  const modeBtns  = document.querySelectorAll<HTMLButtonElement>('[data-mode]');
  modeBtns.forEach(btn => btn.addEventListener('click', () => {
    outputMode = btn.dataset.mode!;
    modeBtns.forEach(b => { b.classList.toggle('active', b.dataset.mode === outputMode); b.setAttribute('aria-pressed', String(b.dataset.mode === outputMode)); });
    generate();
  }));

  function toPascal(s: string): string { return s.charAt(0).toUpperCase() + s.slice(1); }

  function inferInterface(obj: any, name = 'Root', lines: string[] = []): string {
    if (Array.isArray(obj)) {
      const itemType = obj.length ? inferType(obj[0], name + 'Item', lines) : 'unknown';
      lines.push(`export type ${name} = ${itemType}[];`);
      return name;
    }
    lines.push(`export interface ${name} {`);
    for (const [key, val] of Object.entries(obj)) {
      const t = inferType(val, toPascal(key), lines);
      const opt = val === null ? '?' : '';
      lines.push(`  ${key}${opt}: ${t};`);
    }
    lines.push('}');
    return name;
  }

  function inferType(val: any, name: string, lines: string[]): string {
    if (val === null)              return 'string | null';
    if (typeof val === 'string')   return 'string';
    if (typeof val === 'number')   return 'number';
    if (typeof val === 'boolean')  return 'boolean';
    if (Array.isArray(val)) {
      if (!val.length) return 'unknown[]';
      const types = [...new Set(val.map((v: any) => inferType(v, name + 'Item', lines)))];
      const inner = types.length === 1 ? types[0] : `(${types.join(' | ')})`;
      return `${inner}[]`;
    }
    if (typeof val === 'object') { inferInterface(val, name, lines); return name; }
    return 'unknown';
  }

  function inferZod(obj: any, name = 'rootSchema', lines: string[] = []): string {
    if (Array.isArray(obj)) {
      const itemName = name + 'Item';
      const itemSchema = obj.length ? inferZodType(obj[0], itemName, lines) : 'z.unknown()';
      lines.push(`export const ${name} = z.array(${itemSchema});`);
      return name;
    }
    const fields: string[] = [];
    for (const [key, val] of Object.entries(obj)) {
      const t = inferZodType(val, toPascal(key) + 'Schema', lines);
      const schema = val === null ? `${t}.nullable().optional()` : t;
      fields.push(`  ${key}: ${schema}`);
    }
    lines.push(`export const ${name} = z.object({\n${fields.join(',\n')}\n});`);
    return name;
  }

  function inferZodType(val: any, name: string, lines: string[]): string {
    if (val === null)              return 'z.string()';
    if (typeof val === 'string')   return 'z.string()';
    if (typeof val === 'number')   return 'z.number()';
    if (typeof val === 'boolean')  return 'z.boolean()';
    if (Array.isArray(val)) {
      if (!val.length) return 'z.array(z.unknown())';
      const types = [...new Set(val.map((v: any) => inferZodType(v, name + 'Item', lines)))];
      const inner = types.length === 1 ? types[0] : `z.union([${types.join(', ')}])`;
      return `z.array(${inner})`;
    }
    if (typeof val === 'object') { inferZod(val, name, lines); return name; }
    return 'z.unknown()';
  }

  function generate() {
    const raw = (document.getElementById('json-input') as HTMLTextAreaElement).value.trim();
    const errEl = document.getElementById('json-error')!;
    const out   = document.getElementById('ts-output') as HTMLTextAreaElement;
    errEl.style.display = 'none';
    if (!raw) { out.value = ''; return; }
    try {
      const parsed = JSON.parse(raw);
      const lines: string[] = [];
      if (outputMode === 'interface') {
        inferInterface(parsed, 'Root', lines);
      } else {
        lines.unshift('import { z } from "zod";', '');
        inferZod(parsed, 'rootSchema', lines);
        lines.push('', `export type Root = z.infer<typeof rootSchema>;`);
      }
      out.value = lines.join('\n');
    } catch(e) {
      errEl.textContent = 'Invalid JSON: ' + (e as Error).message;
      errEl.style.display = 'block';
      out.value = '';
    }
  }

  document.getElementById('btn-generate')!.addEventListener('click', generate);
  document.getElementById('json-input')!.addEventListener('input', generate);
  document.getElementById('btn-sample')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = SAMPLE;
    generate();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('json-input') as HTMLTextAreaElement).value = '';
    (document.getElementById('ts-output') as HTMLTextAreaElement).value = '';
    document.getElementById('json-error')!.style.display = 'none';
  });
  document.getElementById('btn-copy-output')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy-output')!;
    const text = (document.getElementById('ts-output') as HTMLTextAreaElement).value;
    navigator.clipboard.writeText(text).then(() => {
      btn.textContent = '✓ Copied!'; btn.classList.add('btn-success');
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
    });
  });
</script>
