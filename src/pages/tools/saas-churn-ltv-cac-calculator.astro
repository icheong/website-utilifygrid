---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'saas-churn-ltv-cac-calculator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="text-primary" style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; margin-bottom:1.25rem;">SaaS Business Health Metrics</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.25rem;">
      <div>
        <label class="text-secondary" style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">ARPU ($/month)</label>
        <input id="arpu" type="number" value="79" min="0.01" step="1" class="input-themed"/>
      </div>
      <div>
        <label class="text-secondary" style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Monthly Churn Rate (%)</label>
        <input id="churn" type="number" value="2.5" min="0.01" max="100" step="0.1" class="input-themed"/>
      </div>
      <div>
        <label class="text-secondary" style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Gross Margin (%)</label>
        <input id="margin" type="number" value="75" min="1" max="100" step="1" class="input-themed"/>
      </div>
      <div>
        <label class="text-secondary" style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">CAC ($)</label>
        <input id="cac" type="number" value="420" min="0" step="10" class="input-themed"/>
      </div>
    </div>

    <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:0.75rem; margin-bottom:1rem;">
      <div class="result-card accent-blue">
        <div id="out-ltv" class="result-value">$0</div>
        <div class="result-label" style="margin-top:0.25rem;">Customer LTV</div>
      </div>
      <div class="result-card accent-warning">
        <div id="out-ratio" class="result-value">$0</div>
        <div class="result-label" style="margin-top:0.25rem;">LTV : CAC Ratio</div>
      </div>
      <div class="result-card accent-blue">
        <div id="out-payback" class="result-value">0 mo</div>
        <div class="result-label" style="margin-top:0.25rem;">CAC Payback Period</div>
      </div>
      <div class="result-card accent-warning">
        <div id="out-annual-churn" class="result-value">0%</div>
        <div class="result-label" style="margin-top:0.25rem;">Annual Churn Rate</div>
      </div>
    </div>

    <div id="health-bar-wrap" class="surface-2 border" style="border-radius:0.75rem; padding:1rem;">
      <div class="text-secondary" style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.5rem;">LTV:CAC Health</div>
      <div style="height:8px; background:var(--border); border-radius:999px; overflow:hidden; margin-bottom:0.5rem;">
        <div id="health-fill" style="height:100%; width:0%; background:var(--color-brand-blue); border-radius:999px; transition:width 0.3s ease;"></div>
      </div>
      <div id="health-label" class="text-muted" style="font-size:0.82rem;">Enter values above</div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="seo-h2" >Overview and Technical Context</h2>
    <p class="seo-p" >
      The SaaS Churn, LTV and CAC Calculator is a client-side business metrics tool that computes four core SaaS health indicators from user inputs. Running entirely in the browser, it calculates Customer Lifetime Value, LTV:CAC ratio, CAC payback period, and annualised churn rate — the standard metrics investors and founders use to evaluate unit economics. No data is sent to any server — your inputs remain entirely private.
    </p>
    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Evaluating unit economics before fundraising', 'Investors screen SaaS decks for LTV:CAC above 3x and payback under 12 months. Run your numbers through this calculator before a pitch so you know exactly where you stand and which levers to pull if the ratios are weak.'],
        ['Modelling pricing or margin changes', 'Considering a price increase or switching to annual billing? Adjust ARPU and gross margin to see how the change ripples through LTV and the payback period. A $10 ARPU increase often doubles LTV at the same churn rate.'],
        ['Comparing channels or cohorts', 'Run the calculator for each acquisition channel (paid ads vs. organic vs. referral) using channel-specific CAC and churn figures. The side-by-side comparison reveals which channels deliver the healthiest, most sustainable growth.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:#0F172A; font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="seo-h2" >Deep-Dive Technical Mechanics</h2>
    <p style="font-size:0.9rem; line-height:1.75; margin-bottom:0.875rem">
      The four metrics are interconnected: churn rate feeds directly into LTV, LTV feeds into the ratio, and the ratio determines whether your acquisition spend is sustainable. Understanding each formula helps you identify exactly which lever to pull.
    </p>
    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Core metric definitions</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Customer LTV', 'LTV = (ARPU x Gross Margin %) / Monthly Churn Rate. This represents the average total gross profit you earn from a single customer over their lifetime. A higher LTV means each customer is worth more to your business.'],
        ['LTV : CAC Ratio', 'LTV divided by your Customer Acquisition Cost. This is the fundamental efficiency metric for SaaS. Investors typically look for ratios above 3x. Below 1x means you are losing money on every new customer.'],
        ['CAC Payback Period', 'CAC / (ARPU x Gross Margin % / 100). The number of months required to recover the cost of acquiring one customer. Best-in-class SaaS targets under 12 months. Longer payback means more cash tied up in growth.'],
        ['Annual Churn Rate', 'Calculated as 1 - (1 - monthly churn)^12. This converts monthly churn to an annual figure, which gives a clearer picture of year-over-year customer retention and revenue erosion.'],
      ].map(([label, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <div style="font-size:0.82rem; font-weight:700; color:#0F172A; margin-bottom:0.3rem">{label}</div>
          <p style="font-size:0.82rem; line-height:1.6; margin:0">{desc}</p>
        </div>
      ))}
    </div>
    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Why these metrics matter together</h3>
    <p class="seo-p" >
      A high LTV is meaningless if CAC is also high. A low churn rate is great but not if gross margins are razor-thin. The ratio and payback period tie everything together into a single picture of whether your growth engine is sustainable. The health bar in the calculator visualises this combined view so you can see at a glance whether adjustments are needed.
    </p>
    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Improving your numbers</h3>
    <p class="seo-p" >
      There are only three ways to improve SaaS unit economics: increase revenue per customer (raise prices, upsell, cross-sell), reduce churn (better onboarding, product improvements, win-back campaigns), or lower acquisition cost (organic channels, referrals, product-led growth). The calculator lets you model the impact of each lever instantly.
    </p>
  </div>

  <div slot="faq">
    <h2 class="seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What is a good LTV:CAC ratio for SaaS?', a: 'A ratio of 3:1 or higher is generally considered healthy. Below 1:1 means you are spending more to acquire customers than they are worth, which is unsustainable without significant funding. Above 5:1 may indicate under-investment in growth and an opportunity to spend more aggressively on acquisition.' },
        { q: 'What is a good monthly churn rate?', a: 'For SMB-focused SaaS, monthly churn of 2 to 5 percent is typical. Enterprise SaaS with longer contracts often sees under 1 percent monthly churn. World-class SaaS products achieve negative net revenue churn, meaning expansion revenue from existing customers outpaces losses from churned ones.' },
        { q: 'How do I reduce CAC?', a: 'Improve conversion rates through better onboarding and free trials, invest in content marketing and SEO for lower-cost channels, build a referral programme, and optimise your sales funnel. Product-led growth models often achieve the lowest CAC by letting the product itself drive acquisition.' },
        { q: 'What should I include in CAC?', a: 'CAC should include all sales and marketing expenses: salaries, ad spend, tooling, events, and agency fees. Divide the total period cost by the number of new customers acquired in that period. Many companies calculate both blended CAC across all channels and paid CAC for paid channels separately.' },
        { q: 'How does gross margin affect LTV?', a: 'LTV is directly proportional to gross margin. A SaaS company with 80 percent gross margin will have an LTV roughly double that of one with 40 percent margin at the same churn rate. Improving margin through infrastructure optimisation or pricing adjustments therefore has a linear impact on customer lifetime value.' },
        { q: 'Should I use monthly or annual churn in the formula?', a: 'This calculator takes monthly churn as input because most SaaS businesses track churn on a monthly basis. The formula then annualises it automatically. If you only have annual churn figures, divide by 12 to get an approximate monthly rate, though this is a simplification that assumes even distribution across months.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a good LTV:CAC ratio for SaaS?",
          "acceptedAnswer": { "@type": "Answer", "text": "A ratio of 3:1 or higher is generally considered healthy. Below 1:1 means you are spending more to acquire customers than they are worth, which is unsustainable without significant funding. Above 5:1 may indicate under-investment in growth." }
        },
        {
          "@type": "Question",
          "name": "What is a good monthly churn rate?",
          "acceptedAnswer": { "@type": "Answer", "text": "For SMB-focused SaaS, monthly churn of 2 to 5 percent is typical. Enterprise SaaS with longer contracts often sees under 1 percent monthly churn." }
        },
        {
          "@type": "Question",
          "name": "How do I reduce CAC?",
          "acceptedAnswer": { "@type": "Answer", "text": "Improve conversion rates through better onboarding, invest in content marketing and SEO, build a referral programme, and optimise your sales funnel." }
        },
        {
          "@type": "Question",
          "name": "What should I include in CAC?",
          "acceptedAnswer": { "@type": "Answer", "text": "CAC should include all sales and marketing expenses: salaries, ad spend, tooling, events, and agency fees divided by new customers acquired in the period." }
        },
        {
          "@type": "Question",
          "name": "How does gross margin affect LTV?",
          "acceptedAnswer": { "@type": "Answer", "text": "LTV is directly proportional to gross margin. A company with 80 percent margin has roughly double the LTV of one with 40 percent margin at the same churn rate." }
        },
        {
          "@type": "Question",
          "name": "Should I use monthly or annual churn in the formula?",
          "acceptedAnswer": { "@type": "Answer", "text": "This calculator takes monthly churn as input and annualises it automatically. If you only have annual churn, divide by 12 for an approximate monthly rate." }
        }
      ]
    })} />

    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7">
      <strong style="color:var(--text-secondary)">Disclaimer:</strong> This calculator is provided for educational and illustrative purposes only. It does not constitute financial, business, or investment advice. The results are estimates based on simplified mathematical models. Actual business metrics will vary depending on market conditions, customer behaviour, and operational factors. Always consult a qualified financial advisor or business consultant before making strategic business decisions.
    </div>
  </div>

</ToolLayout>

<script>
  function calc() {
    const arpu   = parseFloat((document.getElementById('arpu') as HTMLInputElement).value)   || 0;
    const churn  = parseFloat((document.getElementById('churn') as HTMLInputElement).value)  || 0;
    const margin = parseFloat((document.getElementById('margin') as HTMLInputElement).value) || 0;
    const cac    = parseFloat((document.getElementById('cac') as HTMLInputElement).value)    || 0;

    const ltv         = churn > 0 ? (arpu * margin / 100) / (churn / 100) : 0;
    const ratio       = cac > 0 && ltv > 0 ? ltv / cac : 0;
    const payback     = (arpu * margin / 100) > 0 ? cac / (arpu * margin / 100) : 0;
    const annualChurn = (1 - Math.pow(1 - churn / 100, 12)) * 100;

    document.getElementById('out-ltv')!.textContent          = '$' + Math.round(ltv).toLocaleString('en-US');
    document.getElementById('out-ratio')!.textContent        = ratio.toFixed(1) + 'x';
    document.getElementById('out-payback')!.textContent      = Math.ceil(payback) + ' mo';
    document.getElementById('out-annual-churn')!.textContent = annualChurn.toFixed(1) + '%';

    const pct  = Math.min((ratio / 5) * 100, 100);
    const fill = document.getElementById('health-fill')!;
    fill.style.width    = pct + '%';
    fill.style.background = ratio >= 3 ? '#10B981' : ratio >= 1 ? '#F59E0B' : '#EF4444';

    const lbl = document.getElementById('health-label')!;
    if (ratio >= 5)      lbl.textContent = '🚀 Excellent — highly efficient growth engine';
    else if (ratio >= 3) lbl.textContent = '✅ Healthy — benchmark LTV:CAC range';
    else if (ratio >= 1) lbl.textContent = '⚠️ Marginal — needs improvement';
    else                 lbl.textContent = '🔴 Unsustainable — spending exceeds customer value';
  }

  ['arpu','churn','margin','cac'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));
  calc();
</script>