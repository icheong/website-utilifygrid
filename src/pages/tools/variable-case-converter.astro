---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'variable-case-converter')!;
---
<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Variable String Case Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Paste any identifier — instantly see every case format side by side.</p>

    <div style="margin-bottom:1rem;">
      <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;">Input string</label>
      <input id="str-input" type="text" placeholder="e.g. getUserProfile or get_user_profile"
        class="input-themed"
        style="width:100%;padding:0.7rem 1rem;border-radius:0.5rem;font-size:1rem;font-family:'Fira Code',monospace;font-weight:600;box-sizing:border-box;" />
    </div>

    <div id="results" style="display:none;flex-direction:column;gap:0.375rem;">
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.2rem;font-weight:700;color:var(--text-primary);margin-bottom:0.75rem;">How to use the Case Converter</h2>
    <p style="color:var(--text-secondary);font-size:0.9rem;line-height:1.75;margin-bottom:0.75rem;">Type or paste any string — the converter recognises camelCase, PascalCase, snake_case, kebab-case, SCREAMING_SNAKE, and space-separated words automatically. All case formats appear instantly. Click any Copy button to copy that format.</p>
    <p style="color:var(--text-secondary);font-size:0.9rem;line-height:1.75;">For bulk conversion of many identifiers at once, use the <a href="/tools/bulk-case-mutator" style="color:#1D4ED8;">Bulk Case Mutator</a> tool.</p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.2rem;font-weight:700;color:var(--text-primary);margin-bottom:0.875rem;">Case format reference</h2>
    <div style="display:flex;flex-direction:column;gap:0.375rem;">
      <div class="info-row"><span class="info-label">camelCase</span><span class="info-value">getUserProfile — first word lower, rest title</span></div>
      <div class="info-row"><span class="info-label">PascalCase</span><span class="info-value">GetUserProfile — all words title-cased</span></div>
      <div class="info-row"><span class="info-label">snake_case</span><span class="info-value">get_user_profile — all lower, underscores</span></div>
      <div class="info-row"><span class="info-label">SCREAMING</span><span class="info-value">GET_USER_PROFILE — all upper, underscores</span></div>
      <div class="info-row"><span class="info-label">kebab-case</span><span class="info-value">get-user-profile — all lower, hyphens</span></div>
      <div class="info-row"><span class="info-label">Title Case</span><span class="info-value">Get User Profile — space separated</span></div>
    </div>
  </div>

  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.2rem;font-weight:700;color:var(--text-primary);margin-bottom:1.25rem;">Frequently asked questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {q:'What case should I use for CSS class names?',a:'CSS class names conventionally use kebab-case (e.g. .nav-item, .btn-primary). BEM methodology uses a combination: .block__element--modifier. Tailwind and utility-first CSS frameworks also use kebab-case.'},
        {q:'What case should I use for JavaScript variables?',a:'JavaScript variables and function names conventionally use camelCase (getUserData). Class names and constructors use PascalCase (UserService). Constants often use SCREAMING_SNAKE_CASE (MAX_RETRIES). This follows the ECMAScript conventions.'},
        {q:'What case should Python variables use?',a:'Python follows PEP 8: variables and functions use snake_case, class names use PascalCase (CapWords), and module-level constants use SCREAMING_SNAKE_CASE. Using the correct convention makes Python code immediately readable to other Python developers.'},
        {q:'Does it handle acronyms correctly?',a:'Acronyms in input (like HTTP, API, URL) are treated as separate word tokens. In camelCase output they become parseHttpRequest; in PascalCase ParseHttpRequest. This is the most widely used convention though some style guides capitalise the full acronym (parseHTTPRequest).'},
      ].map(item=>(
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" style="background:var(--bg-surface);border:1.5px solid var(--border);border-radius:0.875rem;padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem;font-weight:600;color:var(--text-primary);margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem;color:var(--text-secondary);line-height:1.7;margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  const FORMATS: {label:string; fn:(t:string[])=>string; color:string}[] = [
    {label:'camelCase',      fn:t=>t.map((w,i)=>i===0?w.toLowerCase():w.charAt(0).toUpperCase()+w.slice(1).toLowerCase()).join(''),       color:'#818cf8'},
    {label:'PascalCase',     fn:t=>t.map(w=>w.charAt(0).toUpperCase()+w.slice(1).toLowerCase()).join(''),                                  color:'#a78bfa'},
    {label:'snake_case',     fn:t=>t.map(w=>w.toLowerCase()).join('_'),                                                                     color:'#34d399'},
    {label:'SCREAMING_SNAKE',fn:t=>t.map(w=>w.toUpperCase()).join('_'),                                                                     color:'#f87171'},
    {label:'kebab-case',     fn:t=>t.map(w=>w.toLowerCase()).join('-'),                                                                     color:'#fbbf24'},
    {label:'Title Case',     fn:t=>t.map(w=>w.charAt(0).toUpperCase()+w.slice(1).toLowerCase()).join(' '),                                  color:'#60a5fa'},
    {label:'UPPER CASE',     fn:t=>t.map(w=>w.toUpperCase()).join(' '),                                                                     color:'#e879f9'},
    {label:'lower case',     fn:t=>t.map(w=>w.toLowerCase()).join(' '),                                                                     color:'#94a3b8'},
    {label:'dot.case',       fn:t=>t.map(w=>w.toLowerCase()).join('.'),                                                                     color:'#fb923c'},
  ];

  function tokenise(s: string): string[] {
    let str = s.trim();
    str = str.replace(/[-_.]+/g,' ');
    str = str.replace(/([a-z\d])([A-Z])/g,'$1 $2');
    str = str.replace(/([A-Z]+)([A-Z][a-z])/g,'$1 $2');
    return str.split(/\s+/).filter(Boolean);
  }

  const results = document.getElementById('results')!;

  function update(raw: string) {
    if (!raw.trim()) { results.style.display='none'; results.innerHTML=''; return; }
    const tokens = tokenise(raw);
    if (!tokens.length) { results.style.display='none'; return; }

    results.innerHTML = '';
    FORMATS.forEach(({label, fn, color}) => {
      const value = fn(tokens);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.cursor = 'default';
      row.innerHTML = `
        <span class="info-label" style="color:${color};min-width:8rem;">${label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;">
          <span class="info-value" style="word-break:break-all;" data-value="${escHtml(value)}">${escHtml(value)}</span>
          <button class="btn-secondary copy-row" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-row')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-row')!;
        navigator.clipboard.writeText(value).then(() => {
          btn.textContent='✓'; btn.classList.add('btn-success');
          setTimeout(()=>{ btn.textContent='Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      results.appendChild(row);
    });
    results.style.display = 'flex';
  }

  function escHtml(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  document.getElementById('str-input')!.addEventListener('input', e => update((e.target as HTMLInputElement).value));
</script>
