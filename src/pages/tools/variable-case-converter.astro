---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'variable-case-converter')!;
---
<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Variable String Case Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Paste any identifier — instantly see every case format side by side.</p>

    <div style="margin-bottom:1rem;">
      <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;">Input string</label>
      <input id="str-input" type="text" placeholder="e.g. getUserProfile or get_user_profile"
        class="input-themed"
        style="width:100%;padding:0.7rem 1rem;border-radius:0.5rem;font-size:1rem;font-family:'Fira Code',monospace;font-weight:600;box-sizing:border-box;" />
    </div>

    <div id="results" style="display:none;flex-direction:column;gap:0.375rem;">
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Variable Case Converter</h2>
    <p class="seo-p">Convert any identifier or variable name between standard programming case formats in seconds.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Paste Variable Names</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Enter one identifier at a time. The converter accepts camelCase, snake_case, PascalCase, kebab-case, or any other delimited format as input.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Select Target Case</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Every supported case format is displayed at once — camelCase, PascalCase, snake_case, SCREAMING_SNAKE, kebab-case, Title Case, dot.case, and more.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Copy Results</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Click the Copy button next to any format to copy that converted name straight to your clipboard for immediate use in your code.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Variable Case Converter Works</h2>
    <p class="seo-p">The converter uses a three-stage pipeline to split raw input into words and reassemble them in any target format.</p>

    <h3 class="font-display seo-h3-sm">Word Tokenization</h3>
    <p class="seo-p">Input strings are split on common delimiters such as underscores, hyphens, and dots. Capitalization boundaries — where a lowercase letter meets an uppercase letter — are also treated as split points. Consecutive capitals are grouped intelligently so acronyms like <code class="inline-code">HTTP</code> or <code class="inline-code">XMLParser</code> separate into <code class="inline-code">HTTP</code> and <code class="inline-code">XML</code> + <code class="inline-code">Parser</code> rather than fragmenting each letter.</p>

    <h3 class="font-display seo-h3-sm">Case Transformation Rules</h3>
    <p class="seo-p">Once tokens are identified, each target format applies its own rules. <code class="inline-code">camelCase</code> lowercases the first word and capitalizes every subsequent word. <code class="inline-code">PascalCase</code> capitalizes every word. <code class="inline-code">snake_case</code> and <code class="inline-code">kebab-case</code> join all-lower tokens with underscores or hyphens. <code class="inline-code">SCREAMING_SNAKE_CASE</code> uppercases every token before joining with underscores.</p>

    <h3 class="font-display seo-h3-sm">Batch Processing</h3>
    <p class="seo-p">Every supported format is computed and displayed simultaneously on a single keystroke. The entire pipeline — tokenization, transformation, and rendering — runs client-side in the browser with no server round-trip, so conversions are effectively instantaneous.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What case should I use for CSS class names?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">CSS class names conventionally use kebab-case (e.g. .nav-item, .btn-primary). BEM methodology extends this with double underscores and double hyphens (block__element--modifier). Utility-first frameworks like Tailwind also stick with kebab-case.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What case should I use for JavaScript variables?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">JavaScript variables and function names conventionally use camelCase (getUserData). Class names and constructors use PascalCase (UserService). Constants often use SCREAMING_SNAKE_CASE (MAX_RETRIES). Following these conventions makes your code immediately recognizable to other developers.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What case should Python variables use?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Python follows PEP 8: variables and functions use snake_case, class names use PascalCase (CapWords), and module-level constants use SCREAMING_SNAKE_CASE. Using the correct convention makes Python code immediately readable to other Python developers.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does it handle acronyms correctly?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. Acronyms in input (like HTTP, API, URL) are recognized as single word tokens during tokenization. In camelCase output they become parseHttp; in PascalCase ParseHttp. Consecutive capitals are grouped so the acronym stays intact.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I convert between any case formats?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. The converter first tokenizes your input into words regardless of the source format, then reassembles them into every target format. So camelCase, snake_case, PascalCase, kebab-case, and even dot.case inputs all work as starting points.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Does the converter handle abbreviations and acronyms?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. Abbreviations and acronyms are preserved as coherent tokens. For example, parseXMLHttpRequest produces camelCase parseXmlHttpRequest and PascalCase ParseXmlHttpRequest, keeping the multi-letter caps sequences grouped rather than splitting them.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
  const FORMATS: {label:string; fn:(t:string[])=>string; color:string}[] = [
    {label:'camelCase',      fn:t=>t.map((w,i)=>i===0?w.toLowerCase():w.charAt(0).toUpperCase()+w.slice(1).toLowerCase()).join(''),       color:'#818cf8'},
    {label:'PascalCase',     fn:t=>t.map(w=>w.charAt(0).toUpperCase()+w.slice(1).toLowerCase()).join(''),                                  color:'#a78bfa'},
    {label:'snake_case',     fn:t=>t.map(w=>w.toLowerCase()).join('_'),                                                                     color:'#34d399'},
    {label:'SCREAMING_SNAKE',fn:t=>t.map(w=>w.toUpperCase()).join('_'),                                                                     color:'#f87171'},
    {label:'kebab-case',     fn:t=>t.map(w=>w.toLowerCase()).join('-'),                                                                     color:'#fbbf24'},
    {label:'Title Case',     fn:t=>t.map(w=>w.charAt(0).toUpperCase()+w.slice(1).toLowerCase()).join(' '),                                  color:'#60a5fa'},
    {label:'UPPER CASE',     fn:t=>t.map(w=>w.toUpperCase()).join(' '),                                                                     color:'#e879f9'},
    {label:'lower case',     fn:t=>t.map(w=>w.toLowerCase()).join(' '),                                                                     color:'#94a3b8'},
    {label:'dot.case',       fn:t=>t.map(w=>w.toLowerCase()).join('.'),                                                                     color:'#fb923c'},
  ];

  function tokenise(s: string): string[] {
    let str = s.trim();
    str = str.replace(/[-_.]+/g,' ');
    str = str.replace(/([a-z\d])([A-Z])/g,'$1 $2');
    str = str.replace(/([A-Z]+)([A-Z][a-z])/g,'$1 $2');
    return str.split(/\s+/).filter(Boolean);
  }

  const results = document.getElementById('results')!;

  function update(raw: string) {
    if (!raw.trim()) { results.style.display='none'; results.innerHTML=''; return; }
    const tokens = tokenise(raw);
    if (!tokens.length) { results.style.display='none'; return; }

    results.innerHTML = '';
    FORMATS.forEach(({label, fn, color}) => {
      const value = fn(tokens);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.cursor = 'default';
      row.innerHTML = `
        <span class="info-label" style="color:${color};min-width:8rem;">${label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;">
          <span class="info-value" style="word-break:break-all;" data-value="${escHtml(value)}">${escHtml(value)}</span>
          <button class="btn-secondary copy-row" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-row')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-row')!;
        navigator.clipboard.writeText(value).then(() => {
          btn.textContent='✓'; btn.classList.add('btn-success');
          setTimeout(()=>{ btn.textContent='Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      results.appendChild(row);
    });
    results.style.display = 'flex';
  }

  function escHtml(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  document.getElementById('str-input')!.addEventListener('input', e => update((e.target as HTMLInputElement).value));
</script>
