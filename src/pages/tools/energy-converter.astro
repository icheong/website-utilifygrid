---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'energy-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Energy Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter an energy value and select its unit — all other units update instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="energy-input">Energy</label>
        <input id="energy-input" type="number" value="1000" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label class="tool-label" for="energy-unit">Unit</label>
        <select id="energy-unit" class="select-themed" style="min-width:10rem;">
          <option value="j" selected>Joule (J)</option>
          <option value="kj">Kilojoule (kJ)</option>
          <option value="mj">Megajoule (MJ)</option>
          <option value="cal">Calorie (cal)</option>
          <option value="kcal">Kilocalorie (kcal)</option>
          <option value="wh">Watt-hour (Wh)</option>
          <option value="kwh">Kilowatt-hour (kWh)</option>
          <option value="ev">Electronvolt (eV)</option>
          <option value="btu">BTU</option>
          <option value="therm">Therm</option>
          <option value="ftlb">Foot-pound (ft·lb)</option>
        </select>
      </div>
    </div>

    <!-- Results -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Energy Converter Overview</h2>
    <p class="seo-p">
      This energy converter computes precise conversions between 11 metric, scientific, electrical, and imperial energy units entirely within your browser. Built with modern vanilla JavaScript, the tool executes every calculation locally using standard browser APIs — no data is transmitted to any server, no cookies are set, and no tracking scripts execute during conversion. The 100% client-side architecture ensures zero server latency and complete privacy for your calculations, whether you are working in nutrition, physics, electrical engineering, or HVAC systems.
    </p>
    <p class="seo-p">
      The converter supports the most commonly used energy units across scientific and everyday contexts: joules, kilojoules, and megajoules for SI; calories and kilocalories for nutrition and chemistry; watt-hours and kilowatt-hours for electrical energy; electronvolts for atomic and particle physics; BTU and therm for heating and cooling; and foot-pounds for mechanical work. Results are dynamically formatted based on magnitude, switching between fixed notation, locale-formatted numbers, and scientific notation as appropriate.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Nutrition and dietary planning', 'Food labels list energy content in kilocalories (kcal), which are often called "Calories" with a capital C. A typical meal provides 600–800 kcal, equivalent to approximately 2,510–3,347 kJ. Athletes and dietitians convert between kcal and kJ to compare products from different countries — European food labels use kJ while US labels use kcal. This tool handles the full range from a single food calorie (4,184 J) to daily intake targets (2,000–3,000 kcal).'],
        ['Electrical energy and utility billing', 'Your electric utility bills you in kilowatt-hours (kWh). Running a 1,500-watt air conditioner for 8 hours consumes 12 kWh. Converting 12 kWh to joules gives 43,200,000 J, while converting to BTU yields approximately 40,946 BTU — useful for comparing electric heating to gas heating costs. The quick-reference section helps visualise everyday energy values like an AA battery (10,800 J), a smartphone charge (36,000 J), or a gallon of gasoline (120 million J) for intuitive scale comparison.'],
        ['Physics and scientific research', 'Particle physicists measure energy in electronvolts (eV). A typical chemical bond has an energy of 1–5 eV, while nuclear reactions release millions of eV (MeV). Converting 1 MeV to joules gives 1.602 × 10⁻¹³ J. Researchers studying photon energies, particle collisions, or semiconductor band gaps frequently convert between eV and joules. This tool provides IEEE 754 double-precision accuracy across the full 19-order-of-magnitude range from electronvolts to megajoules.']
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Conversion Factors and Mathematical Logic</h2>
    <p class="seo-p">
      The converter employs a hub-and-spoke conversion model using joules as the universal base unit. Every supported energy unit is defined by a fixed conversion factor relative to one joule. To convert from unit A to unit B, the tool multiplies the input value by A's factor to obtain joules, then divides by B's factor to obtain the target value. This approach guarantees that any two-unit conversion inherits the exactness of the underlying definitions — no cumulative rounding errors accumulate through intermediate steps.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Conversion Process</h3>
    <p class="seo-p-sm">
      <strong>1. Factor lookup:</strong> The tool maintains a lookup table mapping each unit identifier (e.g. <code class="inline-code">j</code>, <code class="inline-code">kwh</code>, <code class="inline-code">btu</code>) to its exact factor in joules. Metric units use powers of 10 (e.g. <code class="inline-code">1 kJ = 1,000 J</code>, <code class="inline-code">1 MJ = 1,000,000 J</code>), while scientific and imperial units use internationally defined values.
    </p>
    <p class="seo-p-sm">
      <strong>2. Hub conversion:</strong> The input value is multiplied by the source unit's factor to convert to joules. For example, converting 1 kWh to joules: <code class="inline-code">1 × 3,600,000 = 3,600,000 J</code>. This intermediate result is an IEEE 754 double-precision floating-point number, which provides approximately 15 to 17 significant decimal digits of precision.
    </p>
    <p class="seo-p-sm">
      <strong>3. Target conversion:</strong> The joule value is divided by the target unit's factor. Converting 3,600,000 J to BTU: <code class="inline-code">3,600,000 / 1055.06 = 3,412.14 BTU</code>. The combined formula is: <code class="inline-code">Result = Input × (FromFactor / ToFactor)</code>.
    </p>
    <p class="seo-p-sm">
      <strong>4. Dynamic formatting:</strong> The display format adapts to the magnitude of the result. Very large values (1 quadrillion or greater) use scientific notation. Values between 1 billion and 1 quadrillion use locale-formatted numbers with 2 decimal places. Values between 1,000 and 1 billion use 2 to 4 decimal places. Values between 0.001 and 1,000 use 6 to 8 decimal places. Values below 0.001 use scientific notation. This ensures readability across the full range from electronvolts to therms.
    </p>
    <p class="seo-p-none">
      <strong>Exact vs. approximate factors:</strong> The thermochemical calorie is defined as exactly 4.184 J, making <code class="inline-code">1 cal = 4.184 J</code> exact. The kilowatt-hour is defined as exactly 3,600,000 J (1,000 W × 3,600 s). The electronvolt is defined exactly as <code class="inline-code">1.602176634 × 10⁻¹⁹ J</code>. The BTU uses the ISO standard value of 1,055.06 J (IT BTU). The therm is defined as exactly 100,000 BTU, making <code class="inline-code">1 therm = 105,506,000 J</code> approximate but consistent with utility billing standards.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is the difference between a calorie and a kilocalorie?",
          a: "A calorie (cal) is the energy needed to raise 1 gram of water by 1 degree Celsius. A kilocalorie (kcal) equals 1,000 calories and is what food labels call a 'Calorie' (capital C). One kcal equals 4,184 joules or about 3.968 BTU. When reading nutrition labels, a 2,000 kcal daily diet means 2,000,000 small calories."
        },
        {
          q: "What is a kilowatt-hour?",
          a: "A kilowatt-hour (kWh) is the energy consumed by a 1,000-watt device running for one hour. It equals 3.6 million joules and is the unit your electric utility uses to bill you. Running a 100W light bulb for 10 hours uses 1 kWh. The average US household consumes about 900 kWh per month."
        },
        {
          q: "What is an electronvolt?",
          a: "An electronvolt (eV) is the energy gained by an electron moving through a potential difference of one volt. It equals about 1.602 × 10⁻¹⁹ joules and is commonly used in atomic, nuclear, and particle physics. A typical visible-light photon has an energy of about 2 eV, while gamma-ray photons can have energies of millions of eV (MeV)."
        },
        {
          q: "What is a BTU?",
          a: "A BTU (British thermal unit) is the energy needed to raise the temperature of one pound of water by one degree Fahrenheit. It equals about 1,055 joules. BTUs are commonly used to rate furnaces, air conditioners, and the energy content of natural gas. A standard ton of air conditioning equals 12,000 BTU per hour."
        },
        {
          q: "How many calories are in a food Calorie?",
          a: "One food Calorie (with a capital C) is actually one kilocalorie (kcal) = 1,000 thermochemical calories. So a 200 kcal snack contains 200,000 small calories. Food labels use the term 'Calorie' to mean kilocalorie. This convention can be confusing — a 200 Calorie snack has enough energy to heat 200 grams of water by 100 degrees Celsius."
        },
        {
          q: "How do I convert joules to calories?",
          a: "To convert joules to calories, divide by 4.184 (the exact conversion factor). For example, 1,000 J equals approximately 239 cal. To convert to kilocalories, divide by 4,184 instead. A quick mental shortcut: divide joules by about 4,200 to get kcal. So 8,400 J is roughly 2 kcal."
        },
        {
          q: "What is the difference between a therm and a BTU?",
          a: "A therm is a unit of energy equal to exactly 100,000 BTU. It is commonly used by natural gas utilities to bill customers. One therm equals approximately 105,506,000 joules or 29.3 kWh. A typical household uses 50–100 therms per month for heating, cooking, and hot water. The therm is convenient because it represents a practical amount of gas energy."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Conversion factors to joules ────────────────────────────────
  const TO_J = {
    j:     1,
    kj:    1_000,
    mj:    1_000_000,
    cal:   4.184,
    kcal:  4_184,
    wh:    3_600,
    kwh:   3_600_000,
    ev:    1.602176634e-19,
    btu:   1055.06,
    therm: 105_506_000,
    ftlb:  1.355818,
  };

  const UNITS = [
    { id: 'j',     label: 'J',     name: 'Joule',            decimals: 2 },
    { id: 'kj',    label: 'kJ',    name: 'Kilojoule',        decimals: 4 },
    { id: 'mj',    label: 'MJ',    name: 'Megajoule',        decimals: 6 },
    { id: 'cal',   label: 'cal',   name: 'Calorie',          decimals: 2 },
    { id: 'kcal',  label: 'kcal',  name: 'Kilocalorie',      decimals: 4 },
    { id: 'wh',    label: 'Wh',    name: 'Watt-hour',        decimals: 4 },
    { id: 'kwh',   label: 'kWh',   name: 'Kilowatt-hour',    decimals: 6 },
    { id: 'ev',    label: 'eV',    name: 'Electronvolt',      decimals: 2 },
    { id: 'btu',   label: 'BTU',   name: 'British Thermal Unit', decimals: 4 },
    { id: 'therm', label: 'therm', name: 'Therm',            decimals: 6 },
    { id: 'ftlb',  label: 'ft·lb', name: 'Foot-pound',       decimals: 4 },
  ];

  // ── Quick-reference objects (stored in joules) ──────────────────
  const REFS = [
    { name: 'LED Bulb (1 hr)',          j: 36_000 },
    { name: 'AA Battery',               j: 10_800 },
    { name: 'Food Calorie (1 kcal)',    j: 4_184 },
    { name: 'Smartphone Charge',        j: 36_000 },
    { name: '1 kWh (Utility Billing)',  j: 3_600_000 },
    { name: 'Gasoline Gallon',          j: 120_000_000 },
    { name: 'Ton of TNT',               j: 4_184_000_000 },
    { name: 'Nuclear Bomb (1 MT)',      j: 4_184_000_000_000_000 },
  ];

  const input  = document.getElementById('energy-input') as HTMLInputElement;
  const select = document.getElementById('energy-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  function fmt(value: number): string {
    if (Number.isNaN(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e15) return value.toExponential(4);
    if (abs >= 1e9)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    return value.toExponential(4);
  }

  function update() {
    const val      = parseFloat(input.value);
    const fromUnit = select.value;
    const jVal     = val * TO_J[fromUnit];

    grid.innerHTML = '';

    UNITS.forEach(u => {
      if (u.id === fromUnit) return;
      const converted = jVal / TO_J[u.id];
      const display = fmt(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${u.label}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.label;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = r.j / TO_J[fromUnit];
      const display = fmt(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
