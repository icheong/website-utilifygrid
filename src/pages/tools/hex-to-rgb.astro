---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'hex-to-rgb')!;
---

<ToolLayout tool={tool}>

  <!-- ══════════════════════════════════════════════
       TOOL SLOT
  ══════════════════════════════════════════════ -->
  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">
      HEX ↔ RGB Converter
    </h2>

    <!-- Direction tabs -->
    <div class="toggle-group" style="margin-bottom:1.5rem; width:100%;" role="group" aria-label="Conversion direction">
      <button class="toggle-btn active" data-dir="hex-to-rgb" type="button" style="flex:1; text-align:center;">HEX → RGB</button>
      <button class="toggle-btn" data-dir="rgb-to-hex" type="button" style="flex:1; text-align:center;">RGB → HEX</button>
    </div>

    <!-- HEX → RGB panel -->
    <div id="panel-hex-to-rgb">
      <div style="display:grid; grid-template-columns:auto 1fr; gap:0.875rem; align-items:end; margin-bottom:1rem;">
        <!-- Color swatch picker -->
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;">Pick</label>
          <input id="hex-picker" type="color" value="#1D4ED8"
            style="width:3rem; height:2.75rem; border-radius:0.5rem; border:1.5px solid var(--border); background:var(--bg-surface); cursor:pointer; padding:0.2rem;" />
        </div>
        <div>
          <label style="display:block; font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem;" for="hex-input">HEX value</label>
          <input id="hex-input" type="text" value="#1D4ED8" placeholder="#rrggbb" maxlength="9"
            class="input-themed"
            style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:1rem; font-family:'Fira Code',monospace; font-weight:600; box-sizing:border-box; letter-spacing:0.05em; text-transform:uppercase;" />
        </div>
      </div>

      <!-- Colour preview + results -->
      <div id="color-preview-wrap" style="display:none; margin-bottom:1rem;">
        <div id="color-preview" style="height:5rem; border-radius:0.75rem; border:1.5px solid var(--border); margin-bottom:0.875rem; transition:background 0.2s;"></div>

        <div style="display:flex; flex-direction:column; gap:0.5rem;">
          <div class="info-row">
            <span class="info-label">HEX</span>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <span class="info-value" id="out-hex"></span>
              <button class="btn-secondary copy-btn" data-target="out-hex" type="button" style="font-size:0.72rem; padding:0.2rem 0.55rem;">Copy</button>
            </div>
          </div>
          <div class="info-row">
            <span class="info-label">RGB</span>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <span class="info-value" id="out-rgb"></span>
              <button class="btn-secondary copy-btn" data-target="out-rgb" type="button" style="font-size:0.72rem; padding:0.2rem 0.55rem;">Copy</button>
            </div>
          </div>
          <div class="info-row">
            <span class="info-label">CSS rgb()</span>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <span class="info-value" id="out-css-rgb"></span>
              <button class="btn-secondary copy-btn" data-target="out-css-rgb" type="button" style="font-size:0.72rem; padding:0.2rem 0.55rem;">Copy</button>
            </div>
          </div>
          <div class="info-row">
            <span class="info-label">HSL</span>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <span class="info-value" id="out-hsl"></span>
              <button class="btn-secondary copy-btn" data-target="out-hsl" type="button" style="font-size:0.72rem; padding:0.2rem 0.55rem;">Copy</button>
            </div>
          </div>
        </div>
      </div>

      <p id="hex-error" style="display:none; color:#EF4444; font-size:0.82rem; margin:0;"></p>
    </div>

    <!-- RGB → HEX panel -->
    <div id="panel-rgb-to-hex" style="display:none;">
      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:0.75rem; margin-bottom:1rem;">
        {['r','g','b'].map((ch, i) => (
          <div>
            <label style={`display:block; font-size:0.75rem; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.4rem; color:${i===0?'#EF4444':i===1?'#10B981':'#3B82F6'}`}>{ch.toUpperCase()} (0–255)</label>
            <input id={`rgb-${ch}`} type="number" min="0" max="255" value={i===0?29:i===1?78:216} placeholder="0"
              class="input-themed"
              style="width:100%; padding:0.6rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box; font-family:'Fira Code',monospace;" />
          </div>
        ))}
      </div>

      <div id="rgb-preview-wrap" style="display:none;">
        <div id="rgb-preview" style="height:5rem; border-radius:0.75rem; border:1.5px solid var(--border); margin-bottom:0.875rem; transition:background 0.2s;"></div>
        <div style="display:flex; flex-direction:column; gap:0.5rem;">
          <div class="info-row">
            <span class="info-label">HEX</span>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <span class="info-value" id="out2-hex"></span>
              <button class="btn-secondary copy-btn" data-target="out2-hex" type="button" style="font-size:0.72rem; padding:0.2rem 0.55rem;">Copy</button>
            </div>
          </div>
          <div class="info-row">
            <span class="info-label">CSS rgb()</span>
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <span class="info-value" id="out2-css"></span>
              <button class="btn-secondary copy-btn" data-target="out2-css" type="button" style="font-size:0.72rem; padding:0.2rem 0.55rem;">Copy</button>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- HOW TO USE ───────────────────────────────── -->
  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">HEX ↔ RGB Converter Overview &amp; Technical Context</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      This bidirectional colour converter translates hexadecimal colour codes to RGB (Red, Green, Blue) decimal values and back again. Built with vanilla JavaScript and running entirely in-browser, the tool performs all computations locally using standard browser APIs — no colour data is transmitted to any server, and no cookies or tracking scripts execute. The 100% client-side architecture ensures zero server latency and complete privacy for your design workflow.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      In <strong>HEX → RGB</strong> mode, type or paste a hex colour code into the input field (with or without the <code>#</code> prefix), or use the colour picker to select any colour visually. The converter updates instantly to show the normalised HEX, RGB decimal tuple, CSS <code>rgb()</code> function, and HSL equivalent. Click any Copy button to copy that format to your clipboard. In <strong>RGB → HEX</strong> mode, enter individual Red, Green, and Blue channel values (0–255) and the tool produces a HEX code and CSS <code>rgb()</code> string in real time.
    </p>

    <h3 style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:var(--text-primary); margin:1.5rem 0 0.75rem;">Real-World Applications &amp; Use Cases</h3>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.5rem;">
      <strong>Front-end development and CSS authoring:</strong> Developers frequently receive brand colours as HEX codes from designers but need the RGB equivalent for CSS functions like <code>rgba()</code>, gradients, or dynamic colour manipulation with JavaScript. This tool eliminates manual base-16 arithmetic by converting instantly and providing copy-ready strings for direct insertion into stylesheets.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.5rem;">
      <strong>Design system migration and auditing:</strong> Teams standardising a design system often inherit colour palettes in mixed formats — some assets use HEX, others use RGB, and component libraries may require HSL for CSS custom properties. This converter enables rapid format normalisation across an entire palette, ensuring consistency without spreadsheet overhead.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      <strong>Accessibility contrast checking:</strong> When evaluating colour contrast ratios against WCAG 2.1 guidelines, designers need precise RGB channel values to feed into contrast calculators. Converting a HEX brand colour to its RGB components provides the exact numeric inputs required for luminance ratio calculations.
    </p>
  </div>

  <!-- HOW IT WORKS ────────────────────────────── -->
  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">Deep-Dive: Colour Conversion Mechanics &amp; Mathematical Logic</h2>

    <h3 style="font-size:0.95rem; font-weight:600; color:var(--text-primary); margin:1rem 0 0.5rem;">Core Formulas</h3>
    <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1rem;">
      <div class="info-row">
        <span class="info-label">HEX → RGB</span>
        <span class="info-value">R = parseInt(hex[0..1], 16); G = parseInt(hex[2..3], 16); B = parseInt(hex[4..5], 16)</span>
      </div>
      <div class="info-row">
        <span class="info-label">RGB → HEX</span>
        <span class="info-value">HEX = '#' + R.toString(16).padStart(2,'0') + G.toString(16).padStart(2,'0') + B.toString(16).padStart(2,'0')</span>
      </div>
      <div class="info-row">
        <span class="info-label">RGB → HSL</span>
        <span class="info-value">Normalise channels to [0,1], find max/min, compute hue via sector formula</span>
      </div>
    </div>

    <h3 style="font-size:0.95rem; font-weight:600; color:var(--text-primary); margin:1rem 0 0.5rem;">How the Computation Works</h3>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      A hex colour code encodes three colour channels — red, green, and blue — as consecutive pairs of base-16 (hexadecimal) digits. The string <code>#1D4ED8</code> contains three pairs: <code>1D</code> (red = 29), <code>4E</code> (green = 78), and <code>D8</code> (blue = 216). The conversion uses JavaScript's <code>parseInt(string, 16)</code> to parse each two-character pair from base-16 into a decimal integer in the 0–255 range. The three resulting values define the exact colour in the sRGB colour space.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      <strong>Three-character shorthand expansion:</strong> The CSS specification defines three-digit hex codes as shorthand where each single digit is doubled — <code>#F0A</code> becomes <code>#FF00AA</code>. This tool detects inputs of length 3 (after stripping the <code>#</code>) and expands them before parsing, ensuring compatibility with both shorthand and full-length formats.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      <strong>RGB to HSL conversion:</strong> The HSL (Hue, Saturation, Lightness) model is derived by first normalising each RGB channel to the [0, 1] range. The maximum and minimum channel values determine the lightness (their average) and saturation (their difference relative to the lightness). The hue is computed by identifying which channel is dominant and applying the appropriate sector formula from the 60° colour wheel. This produces a human-readable representation where hue indicates the colour angle (0–360°), saturation the intensity, and lightness the brightness.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      <strong>Edge cases handled:</strong> The calculator validates that hex inputs contain only valid characters [0-9A-F] after stripping the <code>#</code> prefix. RGB channel values are clamped to the 0–255 range to prevent overflow. Empty or malformed hex strings produce a clear error message rather than <code>NaN</code>. The conversion uses IEEE 754 double-precision arithmetic internally, with final integer values rounded to the nearest whole number.
    </p>
  </div>

  <!-- FAQ ─────────────────────────────────────── -->
  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What is the difference between HEX and RGB colour codes?",
          a: "Both represent the same colours using different numeral systems. HEX uses a six-character base-16 string (e.g. #1D4ED8) where each pair of digits encodes one channel as a value 00–FF. RGB separates the red, green, and blue channels into three decimal integers (e.g. 29, 78, 216) in the 0–255 range. HEX is more compact for CSS and design handoffs; RGB is more intuitive when adjusting individual channel values programmatically."
        },
        {
          q: "Does this converter support 3-character hex shorthand?",
          a: "Yes. Three-character hex codes like #F0A are automatically expanded to their 6-character equivalents (#FF00AA) before conversion, following the CSS specification where each single digit is doubled. This means #FFF expands to #FFFFFF (pure white) and #000 expands to #000000 (pure black). The tool accepts both prefixed (#RRGGBB) and unprefixed (RRGGBB) input."
        },
        {
          q: "What is HSL and why would I use it instead of RGB?",
          a: "HSL (Hue, Saturation, Lightness) describes colour in a way that is more intuitive for humans. Hue is the colour angle on the 360° colour wheel (0° = red, 120° = green, 240° = blue), saturation controls the intensity from 0% (grey) to 100% (vivid), and lightness ranges from 0% (black) to 100% (white). HSL makes it easier to create harmonious colour palettes by adjusting hue while keeping saturation and lightness constant, which is harder to achieve by manipulating raw RGB channel values."
        },
        {
          q: "Can I use this for colours with transparency (alpha)?",
          a: "This converter handles opaque colours and does not process an alpha channel. For CSS rgba() or 8-digit hex (#RRGGBBAA), you can manually append the alpha value after conversion — for example, rgba(29, 78, 216, 0.5) adds 50% transparency to the converted result. The alpha channel is independent of the RGB-to-hex conversion and does not affect the computed colour values."
        },
        {
          q: "Why does my hex code look different in another application?",
          a: "Colour appearance can vary between applications due to colour profile differences. This converter uses the sRGB colour space, which is the default for web browsers and CSS. Applications that operate in Display P3, Adobe RGB, or other wide-gamut colour spaces may render the same numeric values differently. Additionally, screen calibration, gamma settings, and ambient lighting affect perceived colour. The tool's output is accurate for web-standard sRGB contexts."
        },
        {
          q: "How do I convert a hex code to Tailwind CSS configuration values?",
          a: "Convert the hex to RGB using this tool, then use the three channel values in Tailwind's configuration. For Tailwind v3+, you can also use the hex value directly in your <code>tailwind.config.js</code> theme extension. If you need to decompose the colour for opacity modifiers (e.g. <code>bg-blue-500/50</code>), you will need the RGB channel values to define the colour using Tailwind's CSS variable syntax."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  // ── Direction toggle ──────────────────────────────────────
  const dirBtns = document.querySelectorAll<HTMLButtonElement>('[data-dir]');
  let activeDir = 'hex-to-rgb';

  dirBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeDir = btn.dataset.dir!;
      dirBtns.forEach(b => {
        b.classList.toggle('active', b.dataset.dir === activeDir);
        b.setAttribute('aria-pressed', String(b.dataset.dir === activeDir));
      });
      document.getElementById('panel-hex-to-rgb')!.style.display = activeDir === 'hex-to-rgb' ? '' : 'none';
      document.getElementById('panel-rgb-to-hex')!.style.display = activeDir === 'rgb-to-hex' ? '' : 'none';
      if (activeDir === 'rgb-to-hex') updateRgbToHex();
    });
  });

  // ── HEX → RGB ─────────────────────────────────────────────
  const hexInput  = document.getElementById('hex-input')  as HTMLInputElement;
  const hexPicker = document.getElementById('hex-picker') as HTMLInputElement;
  const hexError  = document.getElementById('hex-error')!;

  function parseHex(raw: string): [number,number,number] | null {
    let h = raw.replace(/^#/, '').trim().toUpperCase();
    if (h.length === 3) h = h.split('').map(c => c + c).join('');
    if (!/^[0-9A-F]{6}$/.test(h)) return null;
    const n = parseInt(h, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  function rgbToHsl(r: number, g: number, b: number): [number, number, number] {
    const rn = r/255, gn = g/255, bn = b/255;
    const max = Math.max(rn,gn,bn), min = Math.min(rn,gn,bn);
    const l = (max + min) / 2;
    if (max === min) return [0, 0, Math.round(l * 100)];
    const d = max - min;
    const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    let h = 0;
    if (max === rn) h = ((gn - bn) / d + (gn < bn ? 6 : 0)) / 6;
    else if (max === gn) h = ((bn - rn) / d + 2) / 6;
    else h = ((rn - gn) / d + 4) / 6;
    return [Math.round(h * 360), Math.round(s * 100), Math.round(l * 100)];
  }

  function updateHexToRgb(hex: string) {
    const rgb = parseHex(hex);
    hexError.style.display = 'none';
    const wrap = document.getElementById('color-preview-wrap')!;

    if (!rgb) {
      if (hex.replace('#','').length > 2) {
        hexError.textContent = 'Invalid hex colour. Use #RRGGBB or #RGB format.';
        hexError.style.display = 'block';
      }
      wrap.style.display = 'none';
      return;
    }

    const [r, g, b] = rgb;
    const fullHex = '#' + [r,g,b].map(n => n.toString(16).padStart(2,'0').toUpperCase()).join('');
    const [h, s, l] = rgbToHsl(r, g, b);

    document.getElementById('color-preview')!.style.background = fullHex;
    document.getElementById('out-hex')!.textContent = fullHex;
    document.getElementById('out-rgb')!.textContent = `${r}, ${g}, ${b}`;
    document.getElementById('out-css-rgb')!.textContent = `rgb(${r}, ${g}, ${b})`;
    document.getElementById('out-hsl')!.textContent = `hsl(${h}, ${s}%, ${l}%)`;

    // Sync picker
    hexPicker.value = fullHex.toLowerCase();
    wrap.style.display = '';
  }

  hexInput.addEventListener('input', () => updateHexToRgb(hexInput.value));
  hexPicker.addEventListener('input', () => {
    hexInput.value = hexPicker.value.toUpperCase();
    updateHexToRgb(hexPicker.value);
  });

  // Initial render
  updateHexToRgb(hexInput.value);

  // ── RGB → HEX ─────────────────────────────────────────────
  function updateRgbToHex() {
    const r = Math.max(0, Math.min(255, parseInt((document.getElementById('rgb-r') as HTMLInputElement).value) || 0));
    const g = Math.max(0, Math.min(255, parseInt((document.getElementById('rgb-g') as HTMLInputElement).value) || 0));
    const b = Math.max(0, Math.min(255, parseInt((document.getElementById('rgb-b') as HTMLInputElement).value) || 0));
    const hex = '#' + [r,g,b].map(n => n.toString(16).padStart(2,'0').toUpperCase()).join('');
    document.getElementById('rgb-preview')!.style.background = hex;
    document.getElementById('out2-hex')!.textContent = hex;
    document.getElementById('out2-css')!.textContent = `rgb(${r}, ${g}, ${b})`;
    document.getElementById('rgb-preview-wrap')!.style.display = '';
  }

  ['r','g','b'].forEach(ch => {
    document.getElementById(`rgb-${ch}`)?.addEventListener('input', updateRgbToHex);
  });

  // ── Copy buttons — 2s flash ───────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target!;
      const text = document.getElementById(targetId)?.textContent || '';
      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = '✓ Copied!';
        btn.classList.add('btn-success');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('btn-success');
        }, 2000);
      });
    });
  });
</script>
