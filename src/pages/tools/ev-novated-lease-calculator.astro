---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'ev-novated-lease-calculator')!;

const FYS = [
  { value: '2022-23', label: 'FY 2022-23', threshold: 84916 },
  { value: '2023-24', label: 'FY 2023-24', threshold: 89332 },
  { value: '2024-25', label: 'FY 2024-25', threshold: 91387 },
  { value: '2025-26', label: 'FY 2025-26', threshold: 91387 },
  { value: '2026-27', label: 'FY 2026-27', threshold: 91661 },
];
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:#0F172A; margin-bottom:0.25rem;">EV Novated Lease Calculator</h2>
    <p style="font-size:0.82rem; color:#475569; margin-bottom:1.25rem;">Compare salary packaging an EV vs buying out-of-pocket under Australia's <a href="https://www.ato.gov.au/businesses-and-organisations/hiring-and-paying-your-workers/fringe-benefits-tax/types-of-fringe-benefits/fbt-on-cars-other-vehicles-parking-and-tolls/electric-cars-exemption" target="_blank" rel="noopener" style="color:#1D4ED8; text-decoration:underline; text-underline-offset:2px;">FBT exemption rules</a> — with LCT threshold check, smart running cost estimator, lease hidden costs, and opportunity-cost comparison against using your own cash or housing equity.</p>

    <!-- SECTION 1: POLICY & COMPLIANCE -->
    <div style="background:linear-gradient(135deg,#EFF6FF,#DBEAFE); border:1.5px solid #BFDBFE; border-radius:0.75rem; padding:1rem 1.1rem; margin-bottom:1rem;">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;">
        <span style="font-size:0.95rem;">🛡️</span>
        <h3 style="font-family:'Sora',sans-serif; font-size:0.78rem; font-weight:700; color:#1E40AF; text-transform:uppercase; letter-spacing:0.07em; margin:0;">Policy &amp; Compliance</h3>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#1E40AF; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Financial Year</label>
          <select id="fy" class="select-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem;">
            {FYS.map(fy => (
              <option value={fy.value} selected={fy.value === '2024-25'}>📅 {fy.label}</option>
            ))}
          </select>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#1E40AF; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">LCT Threshold (Fuel-Efficient)</label>
          <div style="display:flex; align-items:center; gap:0.5rem; height:2.25rem; padding:0 0.75rem; background:#fff; border:1.5px solid #E2E8F0; border-radius:0.5rem; box-sizing:border-box;">
            <span style="font-family:'Fira Code',monospace; font-size:0.9rem; font-weight:700; color:#0F172A;">$<span id="lct-threshold">91,387</span></span>
          </div>
        </div>
      </div>

      <div id="lct-status" style="display:flex; align-items:center; justify-content:space-between; padding:0.625rem 0.875rem; background:#fff; border:1px solid #E2E8F0; border-radius:0.5rem; font-size:0.78rem; flex-wrap:wrap; gap:0.5rem;">
        <span style="color:#475569;">LCT &amp; FBT eligibility:</span>
        <span id="lct-badge" style="font-family:'Fira Code',monospace; font-weight:700; font-size:0.85rem;">—</span>
      </div>
    </div>

    <!-- SECTION 2: VEHICLE & INCOME -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.875rem; margin-bottom:1rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Annual Gross Salary ($)</label>
        <input id="salary" type="number" value="120000" min="30000" step="1000" class="input-themed" style="width:100%; padding:0.625rem 0.875rem; border-radius:0.625rem; font-size:0.95rem; box-sizing:border-box;"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Vehicle Price ($)</label>
        <input id="vehicle-price" type="number" value="65000" min="10000" step="500" class="input-themed" style="width:100%; padding:0.625rem 0.875rem; border-radius:0.625rem; font-size:0.95rem; box-sizing:border-box;"/>
        <div style="font-size:0.68rem; color:#64748B; margin-top:0.25rem;">Drive-away price (before LCT)</div>
      </div>
    </div>

    <!-- SECTION 3: SMART RUNNING COST ESTIMATOR -->
    <div style="background:linear-gradient(135deg,#F0FDF4,#DCFCE7); border:1.5px solid #BBF7D0; border-radius:0.75rem; padding:1rem 1.1rem; margin-bottom:1rem;">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;">
        <span style="font-size:0.95rem;">⚡</span>
        <h3 style="font-family:'Sora',sans-serif; font-size:0.78rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.07em; margin:0;">Smart Running Cost Estimator</h3>
        <span style="font-size:0.66rem; color:#065F46; background:#D1FAE5; padding:0.15rem 0.55rem; border-radius:999px; margin-left:auto; font-weight:700; letter-spacing:0.04em;">DATA-DRIVEN</span>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Annual km Driven</label>
          <input id="km" type="number" value="15000" min="0" step="500" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">EV Efficiency (kWh/100km)</label>
          <div style="display:flex; align-items:center; gap:0.5rem; height:2.25rem; padding:0 0.5rem 0 0.75rem; background:#fff; border:1.5px solid #E2E8F0; border-radius:0.5rem; box-sizing:border-box;">
            <input id="efficiency" type="range" min="12" max="25" value="18" step="0.5" style="flex:1; accent-color:#10B981;"/>
            <span id="efficiency-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#065F46; min-width:2.5rem; text-align:right;">18.0</span>
          </div>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Home Charging ($/kWh)</label>
          <input id="home-rate" type="number" value="0.30" min="0" step="0.01" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Public Charging ($/kWh)</label>
          <input id="public-rate" type="number" value="0.55" min="0" step="0.01" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
      </div>

      <div style="margin-bottom:0.75rem;">
        <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:0.4rem;">
          <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em;">Home vs Public Charging Ratio</label>
          <span id="home-ratio-val" style="font-family:'Fira Code',monospace; font-size:0.78rem; font-weight:700; color:#065F46;">80% home / 20% public</span>
        </div>
        <input id="home-ratio" type="range" min="0" max="100" value="80" step="5" style="width:100%; accent-color:#10B981;"/>
      </div>

      <div style="margin-bottom:0.75rem;">
        <label style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Other Fixed Costs — insurance, rego, tyres, servicing ($/yr)</label>
        <input id="other-costs" type="number" value="2000" min="0" step="100" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
      </div>

      <div style="background:#fff; border:1.5px solid #10B981; border-radius:0.5rem; padding:0.75rem 0.875rem; display:flex; align-items:center; justify-content:space-between; gap:0.75rem; flex-wrap:wrap;">
        <div style="min-width:0; flex:1;">
          <div style="font-size:0.7rem; font-weight:700; color:#065F46; text-transform:uppercase; letter-spacing:0.05em;">Estimated Annual Running Cost</div>
          <div id="energy-detail" style="font-size:0.72rem; color:#64748B; margin-top:0.2rem; font-family:'Fira Code',monospace; line-height:1.5;">—</div>
        </div>
        <div style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:800; color:#059669; white-space:nowrap;">$<span id="running-total">0</span></div>
      </div>
    </div>

    <!-- SECTION 4: LEASE TERMS & HIDDEN COSTS -->
    <div style="background:linear-gradient(135deg,#F8FAFC,#F1F5F9); border:1.5px solid #E2E8F0; border-radius:0.75rem; padding:1rem 1.1rem; margin-bottom:1rem;">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;">
        <span style="font-size:0.95rem;">📋</span>
        <h3 style="font-family:'Sora',sans-serif; font-size:0.78rem; font-weight:700; color:#334155; text-transform:uppercase; letter-spacing:0.07em; margin:0;">Lease Terms &amp; Hidden Costs</h3>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Lease Term</label>
          <select id="lease-term" class="select-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem;">
            <option value="1">1 year</option>
            <option value="2">2 years</option>
            <option value="3" selected>3 years</option>
            <option value="4">4 years</option>
            <option value="5">5 years</option>
          </select>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Finance Rate (% p.a.)</label>
          <div style="display:flex; align-items:center; gap:0.5rem; height:2.25rem; padding:0 0.5rem 0 0.75rem; background:#fff; border:1.5px solid #E2E8F0; border-radius:0.5rem; box-sizing:border-box;">
            <input id="finance-rate" type="range" min="3" max="14" value="6" step="0.5" style="flex:1; accent-color:#1D4ED8;"/>
            <span id="finance-rate-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#0F172A; min-width:2.5rem;">6%</span>
          </div>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Residual Value (%)</label>
          <div style="display:flex; align-items:center; gap:0.5rem; height:2.25rem; padding:0 0.5rem 0 0.75rem; background:#fff; border:1.5px solid #E2E8F0; border-radius:0.5rem; box-sizing:border-box;">
            <input id="residual" type="range" min="10" max="60" value="30" step="1" style="flex:1; accent-color:#1D4ED8;"/>
            <span id="residual-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:#0F172A; min-width:2.75rem;">30%</span>
          </div>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Monthly Provider Admin Fee ($)</label>
          <input id="admin-fee" type="number" value="8" min="0" step="1" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
      </div>
      <div>
        <label style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Upfront Setup Fee ($) — once-off, pre-tax deductible</label>
        <input id="setup-fee" type="number" value="350" min="0" step="50" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        <div style="font-size:0.7rem; color:#64748B; margin-top:0.25rem;">Typical novated lease setup fees range from $0–$500 (provider-dependent)</div>
      </div>
    </div>

    <!-- SECTION 5: ALTERNATIVE CASH / OFFSET COMPARISON -->
    <div style="background:linear-gradient(135deg,#FEF3C7,#FDE68A); border:1.5px solid #FCD34D; border-radius:0.75rem; padding:1rem 1.1rem; margin-bottom:1rem;">
      <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem; flex-wrap:wrap;">
        <span style="font-size:0.95rem;">💰</span>
        <h3 style="font-family:'Sora',sans-serif; font-size:0.78rem; font-weight:700; color:#92400E; text-transform:uppercase; letter-spacing:0.07em; margin:0;">Alternative: Use Your Own Cash / Housing Equity</h3>
        <label style="display:flex; align-items:center; gap:0.4rem; margin-left:auto; cursor:pointer; font-size:0.78rem; color:#78350F; font-weight:600;">
          <input id="enable-cash" type="checkbox" style="accent-color:#D97706; width:1rem; height:1rem;"/>
          Enable comparison
        </label>
      </div>

      <div id="cash-inputs" style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; opacity:0.4; pointer-events:none; transition:opacity 0.2s ease;">
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#92400E; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Cash Reserves / Equity Available ($)</label>
          <input id="cash-available" type="number" value="80000" min="0" step="1000" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
        <div>
          <label style="font-size:0.7rem; font-weight:700; color:#92400E; text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.3rem;">Offset / Mortgage Interest Rate (% p.a.)</label>
          <input id="offset-rate" type="number" value="5.5" min="0" step="0.1" class="input-themed" style="width:100%; padding:0.5rem 0.75rem; border-radius:0.5rem; font-size:0.875rem; box-sizing:border-box;"/>
        </div>
        <div style="grid-column:span 2;">
          <div style="font-size:0.72rem; color:#78350F; background:rgba(255,255,255,0.7); border:1px dashed #D97706; border-radius:0.4rem; padding:0.5rem 0.75rem; line-height:1.55;">
            💡 The opportunity cost is the offset interest your cash would have <strong>saved</strong> on your mortgage (or <strong>earned</strong> in a high-yield saver) over the term, if it had stayed in the account instead of being spent on the car.
          </div>
        </div>
      </div>
    </div>

    <!-- RESULTS -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:0.75rem;">
      <div class="result-card accent-blue">
        <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.08em; color:#475569; margin-bottom:0.5rem;">📦 Novated Lease</div>
        <div style="display:flex; flex-direction:column; gap:0.375rem; font-size:0.8rem;">
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#64748B;">Pre-tax deduction/yr</span>
            <span id="out-pretax" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#64748B;">Tax saved/yr</span>
            <span id="out-tax-saved" style="font-family:'Fira Code',monospace; font-weight:700; color:#16A34A;">—</span>
          </div>
          <div id="fbt-row" style="display:none; justify-content:space-between;">
            <span style="color:#64748B;">FBT payable/yr</span>
            <span id="out-fbt" style="font-family:'Fira Code',monospace; font-weight:700; color:#DC2626;">—</span>
          </div>
          <div id="net-benefit-row" style="display:none; justify-content:space-between; padding-top:0.375rem; border-top:1px dashed #E2E8F0;">
            <span style="color:#475569; font-weight:600;">Net tax benefit/yr</span>
            <span id="out-net-benefit" style="font-family:'Fira Code',monospace; font-weight:700; color:#16A34A;">—</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding-top:0.375rem; border-top:1px dashed #E2E8F0;">
            <span style="color:#475569; font-weight:600;">Net cost over term</span>
            <span id="out-lease-net" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
          </div>
        </div>
      </div>

      <div class="result-card" style="border-left:3px solid #64748B;">
        <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.08em; color:#475569; margin-bottom:0.5rem;">💳 Out-of-Pocket Purchase</div>
        <div style="display:flex; flex-direction:column; gap:0.375rem; font-size:0.8rem;">
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#64748B;">Purchase (incl. LCT)</span>
            <span id="out-purchase" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#64748B;">Running costs over term</span>
            <span id="out-running-total" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#64748B;">Total net cost</span>
            <span id="out-oop-net" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
          </div>
        </div>
      </div>
    </div>

    <div id="cash-card" class="result-card" style="border-left:3px solid #D97706; margin-bottom:0.75rem; display:none;">
      <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.08em; color:#475569; margin-bottom:0.5rem;">🏦 Buy with Cash / Housing Equity (incl. opportunity cost)</div>
      <div style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0.5rem 1rem; font-size:0.8rem;">
        <div style="display:flex; justify-content:space-between; gap:0.5rem;">
          <span style="color:#64748B;">Purchase (incl. LCT)</span>
          <span id="out-cash-purchase" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
        </div>
        <div style="display:flex; justify-content:space-between; gap:0.5rem;">
          <span style="color:#64748B;">Lost offset interest</span>
          <span id="out-cash-opp" style="font-family:'Fira Code',monospace; font-weight:700; color:#DC2626;">—</span>
        </div>
        <div style="display:flex; justify-content:space-between; gap:0.5rem;">
          <span style="color:#64748B;">Running costs over term</span>
          <span id="out-cash-running" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
        </div>
        <div style="display:flex; justify-content:space-between; gap:0.5rem;">
          <span style="color:#64748B;">Total true cost</span>
          <span id="out-cash-net" style="font-family:'Fira Code',monospace; font-weight:700; color:#0F172A;">—</span>
        </div>
      </div>
    </div>

    <div id="savings-bar" style="border-radius:0.875rem; padding:1.25rem; text-align:center; background:linear-gradient(135deg,#1E3A8A,#1D4ED8); color:#fff;">
      <div id="savings-label" style="font-size:0.75rem; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; opacity:0.85; margin-bottom:0.35rem;">Estimated Saving with Novated Lease</div>
      <div id="out-saving" style="font-family:'Sora',sans-serif; font-size:2rem; font-weight:800; letter-spacing:-0.02em;">—</div>
      <div style="font-size:0.8rem; opacity:0.75; margin-top:0.25rem;">over the lease term · indicative only</div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display text-primary seo-h2" >Is a novated EV lease actually cheaper? Here's the real maths</h2>
    <p class="seo-p" >
      Your employer offers salary packaging. You've heard EVs get an FBT exemption. But the lease provider's sales pitch says you'll save "up to 30%" and you don't know whether that's real or marketing. This calculator shows you the actual numbers — pre-tax deductions, tax saved, LCT if your vehicle breaches the threshold, hidden admin fees, running costs, and the opportunity cost if you'd otherwise use your own cash or housing equity. Enter your salary, vehicle price, and driving habits — the results show side-by-side: novated lease vs out-of-pocket vs cash purchase (with offset interest cost).
    </p>
    <p class="seo-p" >
      The calculator applies current Australian tax rates and ATO-published LCT thresholds across FY 2022-23 to FY 2026-27. It automatically detects whether your vehicle breaches the LCT threshold — and if it does, removes the FBT exemption and shows the FBT cost in the results. Toggle the <strong>Alternative Cash / Housing Equity</strong> comparison to see whether the novated lease tax advantage genuinely beats leaving your money in the offset account.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Who uses this calculator</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Employees deciding on salary packaging', 'A salaried worker on $120,000 is looking at a $65,000 BEV. The novated lease provider says they\'ll save $8,000 over three years. But does that account for the $350 setup fee, the $8/month admin fee, and the opportunity cost of not keeping $65,000 in their mortgage offset? This calculator shows the true net cost of each option — novated lease, out-of-pocket, and cash with offset — so you can make a decision based on real numbers, not a sales pitch.'],
        ['Fleet managers evaluating employee benefits', 'HR managers modelling whether to offer novated EV leases across different salary levels need to understand the FBT implications. The marginal tax rate engine (0%–45% brackets) and dynamic FBT detection let you model scenarios from junior staff at $60,000 to executives at $200,000+ — and quantify the FBT exposure at each level.'],
        ['Financial advisers demonstrating EV strategies', 'Tax agents advising clients on EV acquisition can show the impact of LCT thresholds, the interplay between novated lease deductions and reportable fringe benefits, and how the cash/offset comparison changes at different mortgage rates. The calculator provides the numbers; you provide the advice.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display text-primary seo-h2" >How the EV novated lease calculation works</h2>

    <h3 class="font-display text-primary seo-h3-sm" >LCT and FBT: the two taxes that make or break the deal</h3>
    <p class="seo-card-body" style="margin-bottom:0.5rem">
      <strong>Luxury Car Tax (LCT)</strong> is 33% on the amount above the fuel-efficient threshold for the chosen financial year. Unlike FBT, LCT is not exempt for EVs — it's added to the vehicle cost before calculating the lease. The threshold changes each year: $84,916 (2022-23), $89,332 (2023-24), $91,387 (2024-25 and 2025-26), $91,661 (2026-27). If your $65,000 BEV sits under the threshold, you pay $0 LCT. If you buy a $95,000 BEV in FY 2024-25, LCT is ($95,000 − $91,387) × 33% = $1,192 — and you lose the FBT exemption entirely.
    </p>
    <p class="seo-card-body" style="margin-bottom:0.5rem">
      <strong>FBT exemption logic:</strong> If the vehicle price (drive-away, before LCT) is under the LCT threshold, the novated lease pre-tax deduction is fully FBT-exempt (0% FBT). If the price exceeds the threshold, the exemption is lost and standard FBT applies at ~37.7% of the taxable value (20% statutory rate × 1.8868 Type 1 gross-up). This is a binary outcome — there's no partial exemption.
    </p>

    <h3 class="font-display text-primary seo-h3-sm" >Worked example: $65,000 BEV on $120,000 salary, 3-year term</h3>
    <p class="seo-card-body" style="margin-bottom:0.5rem">
      Vehicle price $65,000, under the $91,387 LCT threshold → $0 LCT, full FBT exemption. Residual at 30% = $19,500. Loan amount = $65,000 − $19,500 = $45,500. At 6% finance rate, annual interest = $2,730. Annual lease repayment = $45,500 ÷ 3 + $2,730 = $17,930. Add $96/yr admin fee and $3,000/yr running costs → annual pre-tax deduction ≈ $21,026. At the 32.5% marginal tax rate ($120,000 salary), tax saved ≈ $6,833/yr. Net cost over 3 years ≈ $63,078 − $20,500 tax saved + $19,500 residual = ~$62,078.
    </p>
    <p class="seo-card-body" style="margin-bottom:0.5rem">
      <strong>Out-of-pocket comparison:</strong> Buying the same car outright costs $65,000 + $9,000 running costs = $74,000. The novated lease saves approximately $11,922 — or about 16% — over three years. But if you'd used that $65,000 to offset a 5.5% mortgage, you'd save $10,725 in interest over three years. The true novated saving vs the cash+offset scenario is smaller — and that's what this calculator reveals.
    </p>

    <h3 class="font-display text-primary seo-h3-sm" >Marginal tax rates used</h3>
    <p class="seo-card-body" style="margin-bottom:0.5rem">
      ≤$18,200 → 0%, $18,201–$45,000 → 19%, $45,001–$120,000 → 32.5%, $120,001–$180,000 → 37%, >$180,000 → 45% (excluding Medicare levy). This is a simplified estimate — actual savings depend on your employer's novated lease arrangements, Reportable Fringe Benefits Amount (RFBA) impact, and GST treatment.
    </p>

    <h3 class="font-display text-primary seo-h3-sm" >Running costs and hidden fees</h3>
    <p class="seo-card-body" style="margin-bottom:0.5rem">
      <strong>Energy cost:</strong> annual km × efficiency (kWh/100km) ÷ 100 = total kWh. Split by home vs public charging ratio, multiplied by respective rates. Typical EVs: 15–22 kWh/100km. Home electricity: $0.25–$0.35/kWh. Public fast charging: $0.50–$0.70/kWh. <strong>Hidden fees:</strong> A $8/month admin fee adds $288 over a 3-year term. A $350 setup fee is pre-tax deductible, so its net cost is reduced by your marginal tax rate. These line items are commonly missed in provider quotes but materially reduce your saving.
    </p>
    <p class="seo-card-body" >
      <strong>Residual value:</strong> ATO minimums range from ~65.63% (1-year lease) to ~28.13% (5-year lease). The residual is paid at end-of-term to own the vehicle, re-financed, or traded in. The calculator includes the residual in the net novated cost.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display text-primary seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'Which vehicles qualify for the FBT exemption?', a: 'Battery electric vehicles (BEVs) and hydrogen fuel cell vehicles (FCEVs) with a drive-away price below the LCT threshold qualify. PHEVs only qualified for new leases entered before 1 April 2025 — from that date, only zero-emission vehicles qualify. The LCT threshold for fuel-efficient vehicles is $91,387 in FY 2024-25 and $91,661 in FY 2026-27. See the ATO\'s electric cars exemption page for full eligibility criteria.' },
        { q: 'What is the LCT threshold and how does it affect my lease?', a: 'Luxury Car Tax is 33% on the amount above the fuel-efficient threshold. Unlike FBT, LCT is not waived for EVs — it\'s added to your vehicle cost before calculating the lease. The threshold changes each financial year ($89,332 in 2023-24, $91,387 in 2024-25, $91,661 in 2026-27). If your vehicle price exceeds the threshold, you pay LCT on the excess AND lose the FBT exemption.' },
        { q: 'How does the LCT threshold affect my FBT exemption?', a: 'The LCT threshold is the hard eligibility ceiling — there is no partial exemption. Under the threshold: full FBT exemption (0% FBT on the pre-tax deduction). Over the threshold: FBT exemption lost entirely, standard FBT applies at ~37.7% of the taxable value. A $65,000 BEV sits under the threshold and gets full exemption. A $95,000 BEV breaches it and loses the exemption completely.' },
        { q: 'How much do hidden lease fees cost over a term?', a: 'A $8/month admin fee adds $288 over a 3-year term. A $350 setup fee is usually charged once but is pre-tax deductible, so its net cost is reduced by your marginal rate — at 32.5%, the setup fee costs $236 after tax. These line items are easy to miss in provider quotes but can reduce your saving by 3-5%. Always confirm the full fee schedule before signing.' },
        { q: 'How is the running cost estimator calculated?', a: 'Energy use = annual km × efficiency (kWh/100km) ÷ 100. The total kWh is split by your home vs public charging ratio, then multiplied by the per-kWh rate. Add insurance, rego, tyres, and servicing. Typical EVs: 15-22 kWh/100km. Home electricity: $0.25-$0.35/kWh. Public fast charging: $0.50-$0.70/kWh. If your provider quotes GST-inclusive figures, divide by 1.1 before entering them.' },
        { q: 'Should I use my own cash or housing equity instead?', a: 'It depends on the opportunity cost. If your cash sits in a 5.5% offset account, spending $65,000 on a car costs ~$10,725 in lost interest over 3 years. A novated lease typically saves 3-7% (your marginal tax rate), but admin fees, setup fees, and LCT can narrow or reverse the gap. Use the Alternative Cash comparison to see the true net cost in your scenario.' },
        { q: 'Does the FBT exemption affect reportable fringe benefits?', a: 'Yes. Even though eligible EVs are FBT-exempt, the pre-tax amount is still recorded as a Reportable Fringe Benefit Amount (RFBA) on your payment summary. This can affect HECS/HELP repayments, childcare subsidy, Medicare levy surcharge, and certain Centrelink payments. Factor this into your personal assessment.' },
        { q: 'What is a residual value?', a: 'The residual (guaranteed future value) is the agreed vehicle value at end of lease, set as a percentage of the effective price. ATO minimums: ~65.63% (1-year) to ~28.13% (5-year). You can pay it to own the vehicle, re-finance, or trade in. The calculator includes the residual in the net novated cost.' },
        { q: 'What happens if my salary changes during the lease?', a: 'This calculator uses a static salary for the marginal tax rate. Salary changes (promotions, bonuses) shift your bracket and alter the tax saving each year. Recalculate at each change point for a more accurate multi-year model. The single-salary approach provides a conservative baseline.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" set:html={item.a} style="font-size:0.875rem; line-height:1.7; margin:0"></p>
          </div>
        </div>
      ))}
    </div>

    <div style="margin-top:1.25rem; padding-top:1rem; border-top:1px solid #E2E8F0; font-size:0.78rem; line-height:1.8">
      <strong class="text-primary" >Disclaimer:</strong> This calculator is provided for educational and informational purposes only. It does not constitute financial, taxation, or legal advice. The calculations are estimates based on simplified assumptions — actual savings depend on your employer's novated lease arrangements, your complete financial situation, RFBA impact, GST treatment, and current ATO rulings. Tax thresholds, LCT rates, and FBT rules may change. Always consult a qualified financial adviser or registered tax agent before making financial decisions. ATO data sourced from <a href="https://www.ato.gov.au/rates/luxury-car-tax-rate-and-thresholds/" target="_blank" rel="noopener" style="color:#1D4ED8; text-decoration:underline">ato.gov.au</a>.
    </div>
  </div>

</ToolLayout>

<script>
  const LCT_FY: Record<string, number> = {
    '2022-23': 84916,
    '2023-24': 89332,
    '2024-25': 91387,
    '2025-26': 91387,
    '2026-27': 91661,
  };
  const LCT_RATE = 0.33;

  function fmt(n: number) {
    return Math.round(n).toLocaleString('en-AU');
  }
  function money(n: number) {
    return '$' + Math.round(n).toLocaleString('en-AU');
  }
  function money1(n: number) {
    return '$' + n.toLocaleString('en-AU', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function getMarginalRate(salary: number): number {
    if (salary <= 18200) return 0;
    if (salary <= 45000) return 0.19;
    if (salary <= 120000) return 0.325;
    if (salary <= 180000) return 0.37;
    return 0.45;
  }

  function calc() {
    const salary      = parseFloat((document.getElementById('salary') as HTMLInputElement).value) || 0;
    const price       = parseFloat((document.getElementById('vehicle-price') as HTMLInputElement).value) || 0;
    const fy          = (document.getElementById('fy') as HTMLSelectElement).value;
    const threshold   = LCT_FY[fy] ?? 91387;

    const lctAmount     = Math.max(0, (price - threshold) * LCT_RATE);
    const effectivePrice = price + lctAmount;

    (document.getElementById('lct-threshold') as HTMLElement).textContent = threshold.toLocaleString('en-AU');
    const lctBadge = document.getElementById('lct-badge')!;
    const fbtExempt = lctAmount === 0;
    if (lctAmount > 0) {
      lctBadge.innerHTML = `<span style="color:#D97706;">+${money(lctAmount)} LCT</span> <span style="color:#64748B; font-weight:500;">(${(price > 0 ? ((lctAmount / price) * 100).toFixed(1) : '0.0')}% of price)</span> <span style="color:#DC2626;">· ✗ Over LCT → no FBT exemption</span>`;
    } else {
      lctBadge.innerHTML = `<span style="color:#16A34A;">$0 LCT · ✓ Under LCT → Full FBT Exemption applies</span>`;
    }

    const km          = parseFloat((document.getElementById('km') as HTMLInputElement).value) || 0;
    const efficiency  = parseFloat((document.getElementById('efficiency') as HTMLInputElement).value) || 0;
    const homeRate    = parseFloat((document.getElementById('home-rate') as HTMLInputElement).value) || 0;
    const publicRate  = parseFloat((document.getElementById('public-rate') as HTMLInputElement).value) || 0;
    const homeRatio   = parseInt((document.getElementById('home-ratio') as HTMLInputElement).value) / 100;
    const otherCosts  = parseFloat((document.getElementById('other-costs') as HTMLInputElement).value) || 0;

    const totalKwh    = (km * efficiency) / 100;
    const homeKwh     = totalKwh * homeRatio;
    const publicKwh   = totalKwh * (1 - homeRatio);
    const energyCost  = homeKwh * homeRate + publicKwh * publicRate;
    const running     = energyCost + otherCosts;

    (document.getElementById('efficiency-val') as HTMLElement).textContent = efficiency.toFixed(1);
    (document.getElementById('home-ratio-val') as HTMLElement).textContent =
      `${Math.round(homeRatio * 100)}% home / ${Math.round((1 - homeRatio) * 100)}% public`;
    (document.getElementById('energy-detail') as HTMLElement).textContent =
      `${fmt(totalKwh)} kWh/yr · $${energyCost.toFixed(0)} energy + $${otherCosts.toFixed(0)} fixed`;
    (document.getElementById('running-total') as HTMLElement).textContent = fmt(running);

    const term        = parseInt((document.getElementById('lease-term') as HTMLSelectElement).value) || 3;
    const residualPct = parseInt((document.getElementById('residual') as HTMLInputElement).value) / 100;
    const rate        = parseFloat((document.getElementById('finance-rate') as HTMLInputElement).value) / 100;
    const adminFee    = parseFloat((document.getElementById('admin-fee') as HTMLInputElement).value) || 0;
    const setupFee    = parseFloat((document.getElementById('setup-fee') as HTMLInputElement).value) || 0;

    (document.getElementById('residual-val') as HTMLElement).textContent = (residualPct * 100) + '%';
    (document.getElementById('finance-rate-val') as HTMLElement).textContent = (rate * 100) + '%';

    const cashEnabled   = (document.getElementById('enable-cash') as HTMLInputElement).checked;
    const cashAvailable = parseFloat((document.getElementById('cash-available') as HTMLInputElement).value) || 0;
    const offsetRate    = (parseFloat((document.getElementById('offset-rate') as HTMLInputElement).value) || 0) / 100;

    const cashInputs = document.getElementById('cash-inputs')! as HTMLElement;
    const cashCard   = document.getElementById('cash-card')! as HTMLElement;
    if (cashEnabled) {
      cashInputs.style.opacity = '1';
      cashInputs.style.pointerEvents = 'auto';
      cashCard.style.display = 'block';
    } else {
      cashInputs.style.opacity = '0.4';
      cashInputs.style.pointerEvents = 'none';
      cashCard.style.display = 'none';
    }

    const FBT_STATUTORY = 0.20;
    const FBT_GROSSUP   = 1.8868;
    const fbtCostRate   = fbtExempt ? 0 : FBT_STATUTORY * FBT_GROSSUP;

    const annualAdmin    = adminFee * 12;
    const residualAmt    = effectivePrice * residualPct;
    const loanAmt        = effectivePrice - residualAmt;
    const annualInt      = loanAmt * rate;
    const annualLease    = loanAmt / term + annualInt;
    const annualPreTax   = annualLease + annualAdmin + running;
    const marginalRate   = getMarginalRate(salary);
    const taxSavedAnnual = annualPreTax * marginalRate;
    const fbtAnnual      = annualPreTax * fbtCostRate;
    const netBenefitYr   = taxSavedAnnual - fbtAnnual;

    const totalPreTax    = annualPreTax * term + setupFee;
    const totalTaxSaved  = totalPreTax * marginalRate;
    const totalFbt       = totalPreTax * fbtCostRate;
    const leaseNetTotal  = totalPreTax - totalTaxSaved + totalFbt + residualAmt;

    const oopRunning     = running * term;
    const oopTotal       = effectivePrice + oopRunning;

    const cashUsed       = Math.min(effectivePrice, cashAvailable);
    const cashOppInt     = cashUsed * offsetRate * term;
    const cashRunning    = running * term;
    const cashNet        = effectivePrice + cashRunning + cashOppInt;

    (document.getElementById('out-pretax') as HTMLElement).textContent       = money(annualPreTax);
    (document.getElementById('out-tax-saved') as HTMLElement).textContent    = money(taxSavedAnnual);
    (document.getElementById('out-lease-net') as HTMLElement).textContent    = money(leaseNetTotal);

    const fbtRow = document.getElementById('fbt-row')! as HTMLElement;
    const netBenefitRow = document.getElementById('net-benefit-row')! as HTMLElement;
    if (fbtAnnual > 0) {
      fbtRow.style.display = 'flex';
      netBenefitRow.style.display = 'flex';
      (document.getElementById('out-fbt') as HTMLElement).textContent = '−' + money(fbtAnnual);
      (document.getElementById('out-net-benefit') as HTMLElement).textContent = (netBenefitYr >= 0 ? '+' : '') + money(netBenefitYr);
    } else {
      fbtRow.style.display = 'none';
      netBenefitRow.style.display = 'none';
    }
    (document.getElementById('out-purchase') as HTMLElement).textContent     = money(effectivePrice);
    (document.getElementById('out-running-total') as HTMLElement).textContent = money(oopRunning);
    (document.getElementById('out-oop-net') as HTMLElement).textContent      = money(oopTotal);

    if (cashEnabled) {
      (document.getElementById('out-cash-purchase') as HTMLElement).textContent = money(effectivePrice);
      (document.getElementById('out-cash-opp') as HTMLElement).textContent      = '+' + money(cashOppInt);
      (document.getElementById('out-cash-running') as HTMLElement).textContent  = money(cashRunning);
      (document.getElementById('out-cash-net') as HTMLElement).textContent      = money(cashNet);
    }

    let bestAlt = oopTotal;
    let altLabel = 'vs Out-of-Pocket';
    if (cashEnabled && cashNet < bestAlt) {
      bestAlt = cashNet;
      altLabel = 'vs Cash + Offset';
    }
    const saving = bestAlt - leaseNetTotal;

    (document.getElementById('out-saving') as HTMLElement).textContent = (saving >= 0 ? '+' : '') + money(saving);
    const bar = document.getElementById('savings-bar')! as HTMLElement;
    bar.style.background = saving >= 0
      ? 'linear-gradient(135deg,#1E3A8A,#1D4ED8)'
      : 'linear-gradient(135deg,#7F1D1D,#DC2626)';
    (document.getElementById('savings-label') as HTMLElement).textContent =
      cashEnabled ? `Estimated Saving (Novated ${altLabel})` : 'Estimated Saving with Novated Lease';
  }

  ['fy','salary','vehicle-price','km','efficiency','home-rate','public-rate','home-ratio','other-costs',
   'lease-term','residual','finance-rate','admin-fee','setup-fee','cash-available','offset-rate'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calc);
  });
  (document.getElementById('enable-cash') as HTMLInputElement).addEventListener('change', calc);

  calc();
</script>
