---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'ev-novated-lease-calculator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:0.25rem;">EV Novated Lease Calculator</h2>
    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:1.25rem;">Compare salary packaging an EV vs buying out-of-pocket under Australia's FBT exemption rules.</p>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1rem;">

      <div>
        <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.375rem;">Annual Gross Salary ($)</label>
        <input id="salary" type="number" value="120000" min="30000" step="1000" class="input-themed" style="width:100%; padding:0.625rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;"/>
      </div>

      <div>
        <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.375rem;">Vehicle Price ($)</label>
        <input id="vehicle-price" type="number" value="65000" min="10000" step="500" class="input-themed" style="width:100%; padding:0.625rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;"/>
      </div>

      <div>
        <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.375rem;">Annual Running Costs ($)</label>
        <input id="running-costs" type="number" value="4000" min="0" step="100" class="input-themed" style="width:100%; padding:0.625rem 0.875rem; border-radius:0.5rem; font-size:0.95rem; box-sizing:border-box;"/>
        <div style="font-size:0.68rem; color:var(--text-muted); margin-top:0.25rem;">Insurance, rego, charging, maintenance</div>
      </div>

      <div>
        <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.375rem;">Lease Term (years)</label>
        <select id="lease-term" class="select-themed" style="width:100%; padding:0.625rem 0.875rem; border-radius:0.5rem; font-size:0.875rem;">
          <option value="1">1 year</option>
          <option value="2">2 years</option>
          <option value="3" selected>3 years</option>
          <option value="4">4 years</option>
          <option value="5">5 years</option>
        </select>
      </div>

      <div>
        <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.375rem;">Residual Value (%)</label>
        <div style="display:flex; align-items:center; gap:0.625rem;">
          <input id="residual" type="range" min="10" max="60" value="30" style="flex:1; accent-color:#1D4ED8;"/>
          <span id="residual-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:var(--text-primary); min-width:2.5rem;">30%</span>
        </div>
      </div>

      <div>
        <label style="display:block; font-size:0.72rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.375rem;">Finance Rate (% p.a.)</label>
        <div style="display:flex; align-items:center; gap:0.625rem;">
          <input id="finance-rate" type="range" min="3" max="14" value="6" step="0.5" style="flex:1; accent-color:#1D4ED8;"/>
          <span id="finance-rate-val" style="font-family:'Fira Code',monospace; font-size:0.85rem; font-weight:700; color:var(--text-primary); min-width:2.5rem;">6%</span>
        </div>
      </div>

    </div>

    <!-- Results -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:1rem;">

      <div class="result-card accent-blue">
        <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin-bottom:0.5rem;">📦 Novated Lease</div>
        <div style="display:flex; flex-direction:column; gap:0.375rem; font-size:0.82rem;">
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">Pre-tax deduction/yr</span>
            <span id="out-pretax" style="font-family:'Fira Code',monospace; font-weight:700; color:var(--text-primary);">—</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">Tax saved/yr</span>
            <span id="out-tax-saved" style="font-family:'Fira Code',monospace; font-weight:700; color:#16A34A;">—</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">Net cost over term</span>
            <span id="out-lease-net" style="font-family:'Fira Code',monospace; font-weight:700; color:var(--text-primary);">—</span>
          </div>
        </div>
      </div>

      <div class="result-card" style="border:1.5px solid var(--border);">
        <div style="font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin-bottom:0.5rem;">💳 Out-of-Pocket Purchase</div>
        <div style="display:flex; flex-direction:column; gap:0.375rem; font-size:0.82rem;">
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">Purchase price</span>
            <span id="out-purchase" style="font-family:'Fira Code',monospace; font-weight:700; color:var(--text-primary);">—</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">Running costs over term</span>
            <span id="out-running-total" style="font-family:'Fira Code',monospace; font-weight:700; color:var(--text-primary);">—</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-secondary);">Total net cost</span>
            <span id="out-oop-net" style="font-family:'Fira Code',monospace; font-weight:700; color:var(--text-primary);">—</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Savings highlight -->
    <div id="savings-bar" style="border-radius:0.875rem; padding:1.25rem; text-align:center; background:linear-gradient(135deg,#1E3A8A,#1D4ED8); color:#fff;">
      <div style="font-size:0.75rem; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; opacity:0.8; margin-bottom:0.35rem;">Estimated Saving with Novated Lease</div>
      <div id="out-saving" style="font-family:'Sora',sans-serif; font-size:2rem; font-weight:800; letter-spacing:-0.02em;">—</div>
      <div style="font-size:0.8rem; opacity:0.75; margin-top:0.25rem;">over the lease term · indicative only</div>
    </div>

  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use this calculator</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Enter your annual gross salary, the vehicle price (drive-away), estimated annual running costs (insurance, registration, electricity/fuel, maintenance), desired lease term, residual value percentage, and the finance rate your novated lease provider has quoted. All inputs update the comparison in real time.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      The calculator uses Australia's current FBT exemption for battery electric vehicles (BEVs) and plug-in hybrids (PHEVs) under the Fringe Benefits Tax Assessment Act. Since eligible EVs are FBT-exempt, the full vehicle cost and running costs are pre-tax — meaning the effective cost is reduced by your marginal tax rate.
    </p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How the calculation works</h2>
    <div style="background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.625rem; padding:0.875rem 1rem; font-family:'Fira Code',monospace; font-size:0.78rem; color:var(--text-primary); line-height:1.9; margin-bottom:0.875rem;">
      Annual lease payment = (Vehicle − Residual) / Term + Interest<br/>
      Total pre-tax deduction/yr = Lease + Running costs<br/>
      Tax saved/yr = Pre-tax deduction × Marginal tax rate<br/>
      Net novated cost = (Pre-tax deduction × Term) − (Tax saved × Term) + Residual<br/>
      Saving = OOP total − Net novated cost
    </div>
    <p style="color:var(--text-secondary); font-size:0.85rem; line-height:1.7;">
      Marginal tax rates used: ≤$18,200 → 0%, $18,201–$45,000 → 19%, $45,001–$120,000 → 32.5%, $120,001–$180,000 → 37%, >$180,000 → 45% (excluding Medicare levy). This is a simplified estimate — actual savings depend on your employer's novated lease arrangements and GST treatment.
    </p>
  </div>

  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'Which vehicles qualify for the FBT exemption?', a: 'As of 2024–25, the FBT exemption applies to battery electric vehicles (BEVs), hydrogen fuel cell vehicles, and plug-in hybrid electric vehicles (PHEVs) with a drive-away price below the luxury car tax threshold (~$89,332 for fuel-efficient vehicles). PHEVs only qualify until 1 April 2025 for new leases.' },
        { q: 'Does the FBT exemption affect my reportable fringe benefits?', a: 'Even though eligible EVs are FBT-exempt, the pre-tax amount is still recorded as a Reportable Fringe Benefit Amount (RFBA) on your payment summary. This can affect income-tested thresholds for Medicare levy surcharge, HECS/HELP repayments, childcare subsidy, and certain Centrelink payments. Factor this into your personal assessment.' },
        { q: 'What is a residual value?', a: 'The residual value (also called guaranteed future value) is the agreed value of the vehicle at the end of the lease term. It is set as a percentage of the vehicle\'s purchase price. ATO minimum residuals range from ~65.63% for a 1-year lease to ~28.13% for a 5-year lease. You can pay the residual to own the vehicle, re-finance it, or trade in.' },
        { q: 'Can I include GST savings in the calculation?', a: 'Yes — one significant benefit of novated leasing is that your employer can claim back the GST on the vehicle purchase and running costs, effectively reducing the cost by 1/11th. This calculator uses pre-GST running cost inputs; if your provider quotes inclusive figures, divide by 1.1 before entering them here for a more accurate result.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  function fmt(n: number) {
    return '$' + Math.round(n).toLocaleString('en-AU');
  }

  function getMarginalRate(salary: number): number {
    if (salary <= 18200) return 0;
    if (salary <= 45000) return 0.19;
    if (salary <= 120000) return 0.325;
    if (salary <= 180000) return 0.37;
    return 0.45;
  }

  function calc() {
    const salary      = parseFloat((document.getElementById('salary') as HTMLInputElement).value) || 0;
    const price       = parseFloat((document.getElementById('vehicle-price') as HTMLInputElement).value) || 0;
    const running     = parseFloat((document.getElementById('running-costs') as HTMLInputElement).value) || 0;
    const term        = parseInt((document.getElementById('lease-term') as HTMLSelectElement).value) || 3;
    const residualPct = parseInt((document.getElementById('residual') as HTMLInputElement).value) / 100;
    const rate        = parseFloat((document.getElementById('finance-rate') as HTMLInputElement).value) / 100;

    const residualAmt = price * residualPct;
    const loanAmt     = price - residualAmt;
    const annualInt   = (loanAmt * rate);
    const annualLease = loanAmt / term + annualInt;
    const preTaxTotal = annualLease + running;
    const marginalRate = getMarginalRate(salary);
    const taxSavedAnnual = preTaxTotal * marginalRate;
    const leaseNetTotal  = (preTaxTotal * term) - (taxSavedAnnual * term) + residualAmt;

    const oopRunning = running * term;
    const oopTotal   = price + oopRunning;

    const saving = oopTotal - leaseNetTotal;

    (document.getElementById('out-pretax') as HTMLElement).textContent    = fmt(preTaxTotal);
    (document.getElementById('out-tax-saved') as HTMLElement).textContent = fmt(taxSavedAnnual);
    (document.getElementById('out-lease-net') as HTMLElement).textContent = fmt(leaseNetTotal);
    (document.getElementById('out-purchase') as HTMLElement).textContent  = fmt(price);
    (document.getElementById('out-running-total') as HTMLElement).textContent = fmt(oopRunning);
    (document.getElementById('out-oop-net') as HTMLElement).textContent   = fmt(oopTotal);

    const savingEl = document.getElementById('out-saving')!;
    savingEl.textContent = (saving >= 0 ? '+' : '') + fmt(saving);
    const bar = document.getElementById('savings-bar')!;
    bar.style.background = saving >= 0
      ? 'linear-gradient(135deg,#1E3A8A,#1D4ED8)'
      : 'linear-gradient(135deg,#7F1D1D,#DC2626)';
  }

  // Slider displays
  ['residual','finance-rate'].forEach(id => {
    const slider  = document.getElementById(id) as HTMLInputElement;
    const display = document.getElementById(`${id}-val`)!;
    slider.addEventListener('input', () => {
      display.textContent = slider.value + '%';
      calc();
    });
    display.textContent = slider.value + '%';
  });

  ['salary','vehicle-price','running-costs','lease-term'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calc);
  });

  calc();
</script>
