---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'weight-mass-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Weight &amp; Mass Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly. All calculations run in your browser.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="weight-input">Value</label>
        <input id="weight-input" type="number" value="1" min="0" step="any" placeholder="Enter value"
          class="input-themed" />
      </div>
      <div>
        <label class="tool-label" for="weight-unit">Unit</label>
        <select id="weight-unit" class="select-themed" style="min-width:10rem;">
          <option value="mg">Milligrams (mg)</option>
          <option value="g">Grams (g)</option>
          <option value="kg" selected>Kilograms (kg)</option>
          <option value="t">Metric Tons (t)</option>
          <option value="oz">Ounces (oz)</option>
          <option value="lb">Pounds (lb)</option>
          <option value="st">Stones (st)</option>
          <option value="us-ton">US Tons (short)</option>
          <option value="uk-ton">Imperial Tons (long)</option>
        </select>
      </div>
    </div>

    <!-- Results grid -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Convert Between Kilograms, Pounds, Stones, and Other Mass Units</h2>
    <p class="seo-p">
      A customs declaration form asks for your shipment weight in kilograms, but the scale in your warehouse reads 340 pounds. Submit the wrong number and you risk a customs hold or incorrect duty calculation. Type the weight, choose the unit you have, and every other mass unit updates at once — kilograms, grams, stones, metric tons, US tons, imperial tons. The copy button beside each result lets you paste directly into the declaration form without second-guessing the digits.
    </p>
    <p class="seo-p">
      The converter handles nine units covering everyday cooking weights through heavy industrial freight. A nutritionist comparing a 6 oz chicken breast to its gram equivalent (roughly 170 g), a gym tracking body weight in stones versus kilograms, or a freight forwarder quoting 4.5 metric tons of cargo in US short tons — all get their answers in one click. The quick-reference row at the bottom translates the current value into everyday objects: a smartphone at 175 g, an average human at 62 kg, an African elephant at 6000 kg.
    </p>

    <h3 class="font-display seo-h3-sm">International shipping where kilograms and pounds collide</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Customs declarations and freight quotes', 'An importer in Chicago receives a pallet of electronics from Shenzhen marked 220 kg. The US customs form asks for weight in pounds. Converting 220 kg to pounds gives 485.02 lb. That number determines the per-pound freight rate, which at $0.75/lb changes the shipping cost from $165 to $363.75 — a difference that matters when you are processing dozens of pallets per week. Getting the conversion right the first time avoids reprocessing fees and delayed clearances.'],
        ['UK body weight tracking in stones vs kilograms', 'A personal trainer in London logs client weights in kilograms, but their clients report weight in stones. A client who says they weigh "12 stone" is actually 76.2 kg (or 168 lb). The trainer needs to record 76.2 kg in the fitness app, while the client tracks progress on their bathroom scale showing 12 st. This converter bridges the gap instantly — enter 12, select stones, and 76.2007 kg appears alongside 168.000 lb.'],
        ['Recipe scaling from imperial to metric', 'A baker in New York follows a British recipe that lists butter as 8 oz. The kitchen scale only reads grams. Converting 8 oz gives exactly 226.796 g — not the 225 g approximation some cookbooks suggest. That 1.8 g difference matters in pastry work where butter-to-flour ratios affect lamination. The tool shows the precise figure so you can decide whether 227 g is close enough or whether to measure exactly.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/length-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Length Converter</a>
        <a href="/tools/volume-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Volume Converter</a>
        <a href="/tools/density-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Density Converter</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Weight Converter Handles Nine Different Mass Scales</h2>
    <p class="seo-p">
      The converter stores every unit as a multiple of one kilogram. When you type 150 pounds, it multiplies 150 by 0.45359237 to get 68.0388555 kg, then divides by each target unit's factor to produce grams, stones, metric tons, and so on. Because the kilogram is the hub of every conversion, the result never accumulates rounding from chained multiplications. Converting 1 pound to stones and back to pounds gives exactly 1 lb — the factors are consistent.
    </p>

    <h3 class="font-display seo-h3-sm">Where the imperial mass factors come from</h3>
    <p class="seo-p-sm">
      The 1959 International Yard and Pound Agreement defined the pound (avoirdupois) as exactly 0.45359237 kg. From that single definition, all other imperial mass factors follow: 1 ounce = 1/16 lb = 0.028349523125 kg (exact), 1 stone = 14 lb = 6.35029318 kg (exact), 1 US short ton = 2000 lb = 907.18474 kg (exact), and 1 Imperial long ton = 2240 lb = 1016.0469088 kg (exact). These are not rounded numbers — they are exact rational values derived from the pound's definition. The metric factors are even simpler: 1 g = 0.001 kg, 1 mg = 0.000001 kg, 1 metric ton = 1000 kg.
    </p>
    <p class="seo-p-sm">
      The kilogram itself was redefined in 2019 by fixing the Planck constant at exactly 6.62607015 × 10⁻³⁴ J·s. Before that, the kilogram was defined by a physical platinum-iridium cylinder stored in a vault in Sèvres, France. The redefinition means the kilogram is now anchored to a fundamental constant of nature, making it reprocible anywhere in the universe without reference to a physical artifact.
    </p>

    <h3 class="font-display seo-h3-sm">Why the stone is still used for body weight</h3>
    <p class="seo-p-sm">
      The stone (14 lb) persists in the UK, Ireland, and Australia exclusively for human body weight. No grocery store sells produce in stones, no gym weighs equipment in stones — it is a social convention for one specific use case. A person who says "I weigh 10 stone" means 140 lb or 63.5 kg. The stone has no official SI status and was never standardized for commercial trade, which is why it does not appear in scientific or industrial contexts. The converter supports it because millions of people still think in stones when they step on a scale.
    </p>
    <p class="seo-p-none">
      The difference between US tons (short tons) and Imperial tons (long tons) matters in heavy industry. A US dump truck rated at 20 short tons carries 18,143.7 kg, while the same truck rated in Imperial long tons would be 18,288.7 kg — about 145 kg more. For mining, shipping, and construction, that 0.8% difference affects load planning and regulatory compliance.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How many kilograms is 150 pounds?",
          a: "150 pounds equals exactly 68.0389 kg. The conversion factor is 1 lb = 0.45359237 kg, defined by international agreement in 1959. For a quick mental estimate, divide the pound value by 2.2 — 150 ÷ 2.2 ≈ 68.2 kg, which is close enough for most purposes. The exact figure matters more in clinical or pharmaceutical contexts where dosage depends on precise body mass."
        },
        {
          q: "What is the difference between a US ton and an Imperial ton?",
          a: "A US ton (short ton) is exactly 2,000 pounds or 907.185 kg. An Imperial ton (long ton) is exactly 2,240 pounds or 1,016.047 kg — about 12% heavier. In US mining and trucking, a payload rated at 25 short tons is 22,679.6 kg. The same rating in the UK would be 25 long tons, or 25,401.2 kg. Always check which ton is being used when quoting freight across the Atlantic."
        },
        {
          q: "Why do British people weigh themselves in stones?",
          a: "The stone (14 lb) has been used for body weight in Britain since the Middle Ages. It survived metrication because it produces convenient numbers: a person who weighs 70 kg can say 11 stone rather than 154 lb. The stone is not used for anything else in the UK — nobody buys 2 stones of apples. It exists purely as a social convention for personal weight, and most bathroom scales in the UK have a stone toggle switch."
        },
        {
          q: "How do I convert grams to ounces for a recipe?",
          a: "Divide the gram value by 28.3495. A 200 g block of butter is approximately 7.055 oz. Most American cookbooks round this to 7 oz, which is a 0.8% error — acceptable for cookies but potentially problematic for precision baking like macarons where ratios are critical. This tool shows the exact result so you can decide whether the rounded version is close enough for your recipe."
        },
        {
          q: "Is 1 kg the same as 2.2 pounds?",
          a: "Almost. 1 kg equals exactly 2.20462 lb, so 2.2 lb is a 0.21% underestimate. For everyday purposes — estimating luggage weight, comparing grocery prices, tracking fitness progress — 2.2 is close enough. For pharmaceutical dosing, engineering load calculations, or customs declarations, use the exact 2.20462 factor. This tool provides the precise result to 6+ significant digits."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Unit definitions: factor to kilograms ────────────────────────
  const UNITS = [
    { id: 'mg',     label: 'Milligrams',      abbr: 'mg',     factor: 0.000001 },
    { id: 'g',      label: 'Grams',            abbr: 'g',      factor: 0.001 },
    { id: 'kg',     label: 'Kilograms',        abbr: 'kg',     factor: 1 },
    { id: 't',      label: 'Metric Tons',      abbr: 't',      factor: 1000 },
    { id: 'oz',     label: 'Ounces',           abbr: 'oz',     factor: 0.028349523125 },
    { id: 'lb',     label: 'Pounds',           abbr: 'lb',     factor: 0.45359237 },
    { id: 'st',     label: 'Stones',           abbr: 'st',     factor: 6.35029318 },
    { id: 'us-ton', label: 'US Tons (short)',  abbr: 'US ton', factor: 907.18474 },
    { id: 'uk-ton', label: 'Imperial Tons (long)', abbr: 'UK ton', factor: 1016.0469088 },
  ];

  const input  = document.getElementById('weight-input') as HTMLInputElement;
  const select = document.getElementById('weight-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  // ── Quick-reference objects (stored in kilograms) ───────────────
  const REFS = [
    { name: 'US Penny',        kg: 0.0025 },
    { name: 'AA Battery',      kg: 0.023 },
    { name: 'Smartphone',      kg: 0.175 },
    { name: 'Laptop',          kg: 1.5 },
    { name: 'Average Human',   kg: 62.0 },
    { name: 'Giraffe',         kg: 1200.0 },
    { name: 'African Elephant',kg: 6000.0 },
    { name: 'Blue Whale',      kg: 150_000.0 },
  ];

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9)  return value.toExponential(4);
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6)  return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;

    grid.innerHTML = '';

    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.abbr;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = (r.kg * 1) / fromFactor;
      const display = formatResult(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
