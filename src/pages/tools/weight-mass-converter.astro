---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'weight-mass-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Weight & Mass Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="weight-input">Value</label>
        <input id="weight-input" type="number" value="1" min="0" step="any" placeholder="Enter value"
          class="input-themed"
          style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="weight-unit">Unit</label>
        <select id="weight-unit" class="select-themed" style="min-width:10rem;">
          <option value="mg">Milligrams (mg)</option>
          <option value="g">Grams (g)</option>
          <option value="kg" selected>Kilograms (kg)</option>
          <option value="t">Metric Tons (t)</option>
          <option value="oz">Ounces (oz)</option>
          <option value="lb">Pounds (lb)</option>
          <option value="st">Stones (st)</option>
          <option value="us-ton">US Tons (short)</option>
          <option value="uk-ton">Imperial Tons (long)</option>
        </select>
      </div>
    </div>

    <!-- Results grid -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Weight & Mass Converter</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Enter a <strong>numeric value</strong> and select its <strong>unit</strong> from the dropdown. All other weight and mass units update instantly — no buttons to click.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      The converter covers <strong>metric</strong> units (milligrams through metric tons) and <strong>imperial</strong> units (ounces through imperial tons), plus stones used in the UK and Australia. Results use high-precision floating-point math.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      Click any <strong>Copy</strong> button to copy that unit's result to your clipboard — handy for pasting into documents, recipes, or messages.
    </p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How weight conversions work</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.875rem;">
      All conversions go through <strong>kilograms</strong> as the base unit. Each unit has a fixed factor relative to one kilogram:
    </p>
    <pre style="font-family:'Fira Code',monospace;font-size:.85rem;padding:1rem;border-radius:.5rem;background:var(--bg-surface-2);color:var(--text-primary);overflow-x:auto;white-space:pre-wrap;">1 ounce  = 0.028349523125 kg   (exact)
1 pound  = 0.45359237 kg        (exact)
1 stone  = 6.35029318 kg        (exact)
1 US ton = 907.18474 kg         (exact)
1 UK ton = 1016.0469088 kg      (exact)
1 mg     = 0.000001 kg
1 g      = 0.001 kg
1 kg     = 1 kg
1 t      = 1000 kg

Result = Input × (FromFactor / ToFactor)</pre>
    <p style="color:var(--text-secondary); font-size:0.85rem; line-height:1.75;">
      The pound-to-kilogram conversion (0.45359237) is an <strong>exact definition</strong> established by international agreement in 1959. All calculations run in your browser — no data is sent anywhere.
    </p>
  </div>

  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the difference between a kilogram and a pound?",
          "acceptedAnswer": { "@type": "Answer", "text": "One kilogram equals approximately 2.20462 pounds. The kilogram is the base unit of mass in the metric system (SI), while the pound is an imperial unit commonly used in the United States and United Kingdom for everyday weight measurements." }
        },
        {
          "@type": "Question",
          "name": "How many ounces are in a pound?",
          "acceptedAnswer": { "@type": "Answer", "text": "There are exactly 16 ounces in one pound. This is an exact conversion, not an approximation. The ounce is commonly used for smaller weight measurements, especially in cooking and packaging." }
        },
        {
          "@type": "Question",
          "name": "What is a stone used for?",
          "acceptedAnswer": { "@type": "Answer", "text": "A stone (st) equals 14 pounds or approximately 6.35 kilograms. It is commonly used in the United Kingdom, Ireland, and Australia for measuring human body weight. For example, a person might say they weigh '10 stone' rather than '140 pounds'." }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a US ton and an Imperial ton?",
          "acceptedAnswer": { "@type": "Answer", "text": "A US ton (short ton) equals 2,000 pounds (907.18 kg). An Imperial ton (long ton) equals 2,240 pounds (1,016.05 kg). The Imperial ton is about 12% heavier. The US ton is used in the United States, while the Imperial ton is used in the UK for certain industries." }
        },
        {
          "@type": "Question",
          "name": "Why is the kilogram the SI base unit for mass?",
          "acceptedAnswer": { "@type": "Answer", "text": "The kilogram was chosen as the SI base unit of mass in 1795. Since 2019, it is defined by fixing the numerical value of the Planck constant (h = 6.62607015 × 10⁻³⁴ J·s), making it based on a fundamental constant of nature rather than a physical artifact." }
        }
      ]
    }
    </script>

    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What is the difference between a kilogram and a pound?', a: 'One kilogram equals approximately 2.20462 pounds. The kilogram is the base unit of mass in the metric system (SI), while the pound is an imperial unit commonly used in the United States and United Kingdom for everyday weight measurements.' },
        { q: 'How many ounces are in a pound?', a: 'There are exactly 16 ounces in one pound. This is an exact conversion, not an approximation. The ounce is commonly used for smaller weight measurements, especially in cooking and packaging.' },
        { q: 'What is a stone used for?', a: 'A stone (st) equals 14 pounds or approximately 6.35 kilograms. It is commonly used in the United Kingdom, Ireland, and Australia for measuring human body weight. For example, a person might say they weigh \'10 stone\' rather than \'140 pounds\'.' },
        { q: 'What is the difference between a US ton and an Imperial ton?', a: 'A US ton (short ton) equals 2,000 pounds (907.18 kg). An Imperial ton (long ton) equals 2,240 pounds (1,016.05 kg). The Imperial ton is about 12% heavier. The US ton is used in the United States, while the Imperial ton is used in the UK for certain industries.' },
        { q: 'Why is the kilogram the SI base unit for mass?', a: 'The kilogram was chosen as the SI base unit of mass in 1795. Since 2019, it is defined by fixing the numerical value of the Planck constant (h = 6.62607015 × 10⁻³⁴ J·s), making it based on a fundamental constant of nature rather than a physical artifact.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Unit definitions: factor to kilograms ────────────────────────
  const UNITS = [
    { id: 'mg',     label: 'Milligrams',      abbr: 'mg',     factor: 0.000001 },
    { id: 'g',      label: 'Grams',            abbr: 'g',      factor: 0.001 },
    { id: 'kg',     label: 'Kilograms',        abbr: 'kg',     factor: 1 },
    { id: 't',      label: 'Metric Tons',      abbr: 't',      factor: 1000 },
    { id: 'oz',     label: 'Ounces',           abbr: 'oz',     factor: 0.028349523125 },
    { id: 'lb',     label: 'Pounds',           abbr: 'lb',     factor: 0.45359237 },
    { id: 'st',     label: 'Stones',           abbr: 'st',     factor: 6.35029318 },
    { id: 'us-ton', label: 'US Tons (short)',  abbr: 'US ton', factor: 907.18474 },
    { id: 'uk-ton', label: 'Imperial Tons (long)', abbr: 'UK ton', factor: 1016.0469088 },
  ];

  const input  = document.getElementById('weight-input') as HTMLInputElement;
  const select = document.getElementById('weight-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  // ── Quick-reference objects (stored in kilograms) ───────────────
  const REFS = [
    { name: 'US Penny',        kg: 0.0025 },
    { name: 'AA Battery',      kg: 0.023 },
    { name: 'Smartphone',      kg: 0.175 },
    { name: 'Laptop',          kg: 1.5 },
    { name: 'Average Human',   kg: 62.0 },
    { name: 'Giraffe',         kg: 1200.0 },
    { name: 'African Elephant',kg: 6000.0 },
    { name: 'Blue Whale',      kg: 150_000.0 },
  ];

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9)  return value.toExponential(4);
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6)  return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;

    grid.innerHTML = '';

    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.abbr;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = (r.kg * 1) / fromFactor;
      const display = formatResult(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
