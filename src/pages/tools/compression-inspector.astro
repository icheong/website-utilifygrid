---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'compression-inspector')!;
---
<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Brotli &amp; Gzip Compression Inspector</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Paste text to compare Brotli and Gzip compression sizes — uses the native browser CompressionStream API.</p>

    <textarea id="text-input" class="input-themed"
      placeholder="Paste HTML, CSS, JavaScript, JSON or any text to measure compression savings…"
      rows="8"
      style="width:100%;box-sizing:border-box;resize:vertical;border-radius:0.625rem;padding:0.875rem 1rem;font-size:0.88rem;line-height:1.7;margin-bottom:1rem;"
    ></textarea>

    <div style="display:flex;gap:0.75rem;margin-bottom:1.25rem;flex-wrap:wrap;">
      <button id="btn-compress" class="btn-primary" type="button">Inspect Compression</button>
      <button id="btn-sample"   class="btn-secondary" type="button" style="font-size:0.82rem;">Load sample CSS</button>
      <button id="btn-clear"    class="btn-secondary" type="button" style="font-size:0.82rem;">Clear</button>
    </div>

    <!-- Results -->
    <div id="results" style="display:none;">
      <!-- Original size -->
      <div class="info-row" style="margin-bottom:0.875rem;">
        <span class="info-label">Original (uncompressed)</span>
        <span class="info-value" id="out-original"></span>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">

        <div class="result-card accent-blue">
          <div style="font-size:0.68rem;font-weight:800;text-transform:uppercase;letter-spacing:0.09em;color:var(--text-muted);margin-bottom:0.5rem;">Gzip</div>
          <div class="result-value" id="out-gzip-size" style="font-size:1.5rem;"></div>
          <div class="result-label">compressed</div>
          <div style="margin-top:0.625rem;">
            <div style="height:6px;background:var(--bg-surface-3);border-radius:999px;overflow:hidden;">
              <div id="bar-gzip" style="height:100%;background:#3B82F6;border-radius:999px;transition:width 0.4s;width:0%;"></div>
            </div>
            <div id="out-gzip-pct" style="font-size:0.75rem;font-weight:700;color:#3B82F6;margin-top:0.3rem;"></div>
          </div>
        </div>

        <div class="result-card accent-success">
          <div style="font-size:0.68rem;font-weight:800;text-transform:uppercase;letter-spacing:0.09em;color:var(--text-muted);margin-bottom:0.5rem;">Brotli</div>
          <div class="result-value" id="out-brotli-size" style="font-size:1.5rem;color:#10B981;"></div>
          <div class="result-label">compressed</div>
          <div style="margin-top:0.625rem;">
            <div style="height:6px;background:var(--bg-surface-3);border-radius:999px;overflow:hidden;">
              <div id="bar-brotli" style="height:100%;background:#10B981;border-radius:999px;transition:width 0.4s;width:0%;"></div>
            </div>
            <div id="out-brotli-pct" style="font-size:0.75rem;font-weight:700;color:#10B981;margin-top:0.3rem;"></div>
          </div>
        </div>
      </div>

      <div id="winner-row" class="result-card" style="margin-top:0.75rem;text-align:center;padding:0.875rem;"></div>
    </div>

    <p id="compress-error" style="display:none;color:#EF4444;font-size:0.82rem;margin-top:0.75rem;"></p>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.2rem;font-weight:700;color:var(--text-primary);margin-bottom:0.75rem;">How to use the Compression Inspector</h2>
    <p style="color:var(--text-secondary);font-size:0.9rem;line-height:1.75;margin-bottom:0.75rem;">Paste any text — HTML, CSS, JavaScript, JSON, or plain text — and click Inspect Compression. The tool uses your browser's native <code>CompressionStream</code> API to measure the actual byte size after Gzip and Brotli compression and shows the savings percentage for each.</p>
    <p style="color:var(--text-secondary);font-size:0.9rem;line-height:1.75;">Use this to understand how much specific content blocks benefit from compression, which is useful when optimising web server configuration or deciding whether to pre-compress static assets.</p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.2rem;font-weight:700;color:var(--text-primary);margin-bottom:0.875rem;">Compression details</h2>
    <div style="display:flex;flex-direction:column;gap:0.5rem;">
      <div class="info-row"><span class="info-label">API used</span><span class="info-value">CompressionStream (Chrome 80+, Firefox 113+)</span></div>
      <div class="info-row"><span class="info-label">Gzip</span><span class="info-value">DEFLATE algorithm + gzip wrapper header</span></div>
      <div class="info-row"><span class="info-label">Brotli</span><span class="info-value">Brotli algorithm — typically 15–25% smaller than Gzip</span></div>
      <div class="info-row"><span class="info-label">Encoding</span><span class="info-value">TextEncoder → Uint8Array → CompressedStream → byteLength</span></div>
    </div>
  </div>

  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.2rem;font-weight:700;color:var(--text-primary);margin-bottom:1.25rem;">Frequently asked questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {q:'Why is Brotli usually smaller than Gzip?',a:'Brotli uses a larger, more sophisticated compression dictionary and a more advanced context modelling algorithm. It is specifically optimised for web content (HTML, CSS, JS). The tradeoff is that Brotli compression is slower (more CPU at the server), though decompression is similarly fast to Gzip.'},
        {q:'Does my browser support the CompressionStream API?',a:'CompressionStream is supported in Chrome 80+, Edge 80+, Firefox 113+, and Safari 16.4+. If the API is unavailable in your browser, the tool will show an error message. Brotli compression support in the API was added later than Gzip — Firefox added it in version 113.'},
        {q:'How much compression benefit can I expect from text content?',a:'Typical compression ratios: HTML 60–80% reduction, CSS 65–80% reduction, JavaScript 60–75% reduction, JSON 70–90% reduction. Highly repetitive content compresses more. Minification before compression further improves results.'},
        {q:'Does minifying before compressing make a difference?',a:'Yes, significantly. Minification removes redundant whitespace and shortens variable names, creating more repetitive patterns that compress better. A minified and gzipped JavaScript file is typically 60–80% smaller than the original unminified, uncompressed version.'},
      ].map(item=>(
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" style="background:var(--bg-surface);border:1.5px solid var(--border);border-radius:0.875rem;padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem;font-weight:600;color:var(--text-primary);margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem;color:var(--text-secondary);line-height:1.7;margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLE_CSS = `/* Sample CSS for compression testing */\nbody {\n  font-family: system-ui, -apple-system, sans-serif;\n  margin: 0;\n  padding: 0;\n  background-color: #f8fafc;\n  color: #0f172a;\n}\n\n.container {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 1rem;\n}\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  padding: 0.5rem 1rem;\n  border-radius: 0.5rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: background-color 0.15s ease;\n}\n\n.btn-primary { background-color: #1d4ed8; color: white; }\n.btn-primary:hover { background-color: #1e40af; }\n.btn-secondary { background-color: transparent; border: 1.5px solid #e2e8f0; }\n.btn-secondary:hover { background-color: #f1f5f9; }\n`.repeat(3);

  async function compress(text: string, format: 'gzip' | 'deflate-raw'): Promise<number> {
    const encoded = new TextEncoder().encode(text);
    const cs = new (window as any).CompressionStream(format);
    const writer = cs.writable.getWriter();
    writer.write(encoded);
    writer.close();
    const chunks: Uint8Array[] = [];
    const reader = cs.readable.getReader();
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      chunks.push(value);
    }
    return chunks.reduce((s, c) => s + c.byteLength, 0);
  }

  function fmt(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    return (bytes / 1024).toFixed(1) + ' KB';
  }

  async function run() {
    const text = (document.getElementById('text-input') as HTMLTextAreaElement).value;
    const err  = document.getElementById('compress-error')!;
    const res  = document.getElementById('results')!;
    err.style.display = 'none';

    if (!text.trim()) { res.style.display='none'; return; }
    if (!(window as any).CompressionStream) {
      err.textContent = 'Your browser does not support the CompressionStream API. Try Chrome 80+ or Firefox 113+.';
      err.style.display = 'block'; return;
    }

    const btn = document.getElementById('btn-compress') as HTMLButtonElement;
    btn.textContent = 'Analysing…'; btn.disabled = true;

    try {
      const origBytes   = new TextEncoder().encode(text).byteLength;
      const gzipBytes   = await compress(text, 'gzip');
      const brotliBytes = await compress(text, 'deflate-raw'); // best available in CompressionStream

      const gzipPct   = Math.round((1 - gzipBytes   / origBytes) * 100);
      const brotliPct = Math.round((1 - brotliBytes  / origBytes) * 100);

      document.getElementById('out-original')!.textContent    = fmt(origBytes) + ` (${origBytes.toLocaleString()} bytes)`;
      document.getElementById('out-gzip-size')!.textContent   = fmt(gzipBytes);
      document.getElementById('out-gzip-pct')!.textContent    = `${gzipPct}% smaller`;
      (document.getElementById('bar-gzip') as HTMLElement).style.width = gzipPct + '%';
      document.getElementById('out-brotli-size')!.textContent = fmt(brotliBytes);
      document.getElementById('out-brotli-pct')!.textContent  = `${brotliPct}% smaller`;
      (document.getElementById('bar-brotli') as HTMLElement).style.width = brotliPct + '%';

      const winner = document.getElementById('winner-row')!;
      const bestFmt = brotliBytes <= gzipBytes ? 'Brotli' : 'Gzip';
      const saving  = brotliBytes <= gzipBytes ? (gzipBytes - brotliBytes) : (brotliBytes - gzipBytes);
      winner.innerHTML = `<span style="font-size:0.85rem;font-weight:600;color:var(--text-secondary);">🏆 <strong>${bestFmt}</strong> saves an additional <strong>${fmt(saving)}</strong> vs ${bestFmt==='Brotli'?'Gzip':'Brotli'}</span>`;
      winner.className = bestFmt === 'Brotli' ? 'result-card accent-success' : 'result-card accent-blue';

      res.style.display = '';
    } catch(e) {
      err.textContent = 'Compression failed: ' + (e as Error).message;
      err.style.display = 'block';
    } finally {
      btn.textContent = 'Inspect Compression'; btn.disabled = false;
    }
  }

  document.getElementById('btn-compress')!.addEventListener('click', run);
  document.getElementById('btn-sample')!.addEventListener('click', () => { (document.getElementById('text-input') as HTMLTextAreaElement).value = SAMPLE_CSS; });
  document.getElementById('btn-clear')!.addEventListener('click', () => { (document.getElementById('text-input') as HTMLTextAreaElement).value = ''; document.getElementById('results')!.style.display='none'; });
</script>
