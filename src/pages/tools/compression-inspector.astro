---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'compression-inspector')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:#0F172A; margin-bottom:1.25rem;">Brotli &amp; Gzip Compression Inspector</h2>

    <textarea id="text-input" placeholder="Paste any text, HTML, CSS, or JavaScript to inspect compression savings…"
      style="width:100%; min-height:180px; padding:1rem; border:1.5px solid #E2E8F0; border-radius:0.875rem; font-size:0.875rem; font-family:'Fira Code',monospace; color:#0F172A; resize:vertical; box-sizing:border-box; outline:none; line-height:1.6; margin-bottom:1.25rem;"
      onfocus="this.style.borderColor='#06B6D4'" onblur="this.style.borderColor='#E2E8F0'"></textarea>

    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.75rem; margin-bottom:1rem;">
      <div style="background:#F0FDFA; border:1.5px solid #99F6E4; border-radius:0.75rem; padding:1rem; text-align:center;">
        <div id="out-original" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#0D9488;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#2DD4BF; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.05em;">Original</div>
      </div>
      <div style="background:#EFF6FF; border:1.5px solid #BFDBFE; border-radius:0.75rem; padding:1rem; text-align:center;">
        <div id="out-gzip" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#1D4ED8;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#60A5FA; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.05em;">Gzip</div>
      </div>
      <div style="background:#FDF4FF; border:1.5px solid #E9D5FF; border-radius:0.75rem; padding:1rem; text-align:center;">
        <div id="out-brotli" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#7C3AED;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#A78BFA; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.05em;">Brotli</div>
      </div>
    </div>

    <div style="display:flex; flex-direction:column; gap:0.625rem;">
      {[['Gzip savings', 'bar-gzip', '#1D4ED8'], ['Brotli savings', 'bar-brotli', '#7C3AED']].map(([label, id, color]) => (
        <div>
          <div style="display:flex; justify-content:space-between; margin-bottom:0.3rem;">
            <span style="font-size:0.78rem; font-weight:600; color:#475569;">{label}</span>
            <span id={id + '-pct'} style="font-size:0.78rem; font-weight:700; color:#0F172A;">—</span>
          </div>
          <div style="height:8px; background:#F1F5F9; border-radius:999px; overflow:hidden;">
            <div id={id} style={`height:100%; width:0%; background:${color}; border-radius:999px; transition:width 0.4s ease;`}></div>
          </div>
        </div>
      ))}
    </div>

    <div id="support-note" style="margin-top:1rem; padding:0.625rem 0.875rem; background:#FFFBEB; border:1px solid #FDE68A; border-radius:0.5rem; font-size:0.78rem; color:#92400E; display:none;">
      ⚠️ Your browser does not support the CompressionStream API needed for Brotli. Gzip is still available.
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:#0F172A; margin-bottom:0.75rem;">How to use the Compression Inspector</h2>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">Paste any text content — HTML markup, CSS stylesheets, JavaScript code, JSON responses, or plain text — into the input area. The tool immediately compresses it using both Gzip and Brotli and displays the byte sizes and percentage savings.</p>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75;">This is useful when evaluating how much a specific piece of content will benefit from server-side compression, helping you make informed decisions about enabling or configuring compression on your web server.</p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:#0F172A; margin-bottom:0.75rem;">How compression is measured</h2>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">The browser's native <code style="background:#F1F5F9; padding:0.1rem 0.3rem; border-radius:0.25rem;">CompressionStream</code> API compresses the UTF-8 encoded text using the specified algorithm. The compressed byte count is then compared to the original byte count to calculate savings.</p>
    <p style="color:#475569; font-size:0.9rem; line-height:1.75;">Note: real-world compression ratios may differ slightly from server-side implementations due to compression level settings (e.g., gzip level 1–9). This tool uses the browser's default compression level.</p>
  </div>

  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:#0F172A; margin-bottom:1.25rem;">Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'Is Brotli better than Gzip?', a: 'Generally yes — Brotli typically achieves 15–25% better compression than Gzip at comparable speeds, particularly for text-based assets. Brotli is supported by all modern browsers. Gzip remains more universally compatible and is required for older clients and some CDN configurations.' },
        { q: 'How do I enable Gzip on my server?', a: 'For Apache, add AddOutputFilterByType DEFLATE text/html text/css application/javascript to your .htaccess or server config. For Nginx, add gzip on; and gzip_types text/plain text/css application/json application/javascript to your nginx.conf.' },
        { q: 'What content benefits most from compression?', a: 'Text-based content compresses best: HTML, CSS, JavaScript, JSON, XML, and SVG typically compress by 60–80%. Binary formats like images (JPEG, PNG, WebP), fonts, and PDFs are already compressed and gain little or nothing from Gzip/Brotli.' },
        { q: 'Does compression hurt server performance?', a: 'Modern servers and CDNs compress files once and cache the result, so ongoing CPU overhead is minimal. For dynamic content, the CPU cost of compression is usually far outweighed by the network savings, especially on mobile connections.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:#fff; border:1.5px solid #E2E8F0; border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:#0F172A; margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:#475569; line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  function formatBytes(n: number): string {
    if (n < 1024) return n + ' B';
    return (n / 1024).toFixed(1) + ' KB';
  }

  async function compress(text: string, format: string): Promise<number> {
    const encoder = new TextEncoder();
    const bytes   = encoder.encode(text);
    const cs = new (window as any).CompressionStream(format);
    const writer = cs.writable.getWriter();
    writer.write(bytes);
    writer.close();
    const chunks: Uint8Array[] = [];
    const reader = cs.readable.getReader();
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      chunks.push(value);
    }
    return chunks.reduce((sum, c) => sum + c.byteLength, 0);
  }

  async function update() {
    const text = (document.getElementById('text-input') as HTMLTextAreaElement).value;
    if (!text) {
      ['out-original','out-gzip','out-brotli'].forEach(id => (document.getElementById(id)!.textContent = '—'));
      ['bar-gzip','bar-brotli'].forEach(id => { (document.getElementById(id) as HTMLElement).style.width = '0%'; });
      ['bar-gzip-pct','bar-brotli-pct'].forEach(id => (document.getElementById(id)!.textContent = '—'));
      return;
    }

    const encoder  = new TextEncoder();
    const original = encoder.encode(text).byteLength;
    document.getElementById('out-original')!.textContent = formatBytes(original);

    try {
      const gzipSize   = await compress(text, 'gzip');
      const gzipSaving = ((1 - gzipSize / original) * 100).toFixed(1);
      document.getElementById('out-gzip')!.textContent     = formatBytes(gzipSize);
      document.getElementById('bar-gzip-pct')!.textContent = gzipSaving + '% saved';
      (document.getElementById('bar-gzip') as HTMLElement).style.width = Math.min(parseFloat(gzipSaving) * 1.2, 100) + '%';
    } catch { document.getElementById('out-gzip')!.textContent = 'N/A'; }

    try {
      const brSize    = await compress(text, 'deflate-raw');
      const brSaving  = ((1 - brSize / original) * 100).toFixed(1);
      document.getElementById('out-brotli')!.textContent     = formatBytes(brSize);
      document.getElementById('bar-brotli-pct')!.textContent = brSaving + '% saved';
      (document.getElementById('bar-brotli') as HTMLElement).style.width = Math.min(parseFloat(brSaving) * 1.2, 100) + '%';
    } catch {
      document.getElementById('out-brotli')!.textContent = 'N/A';
      (document.getElementById('support-note') as HTMLElement).style.display = 'block';
    }
  }

  if (!(window as any).CompressionStream) {
    (document.getElementById('support-note') as HTMLElement).style.display = 'block';
  }

  let timer: ReturnType<typeof setTimeout>;
  document.getElementById('text-input')?.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(update, 300);
  });
</script>
