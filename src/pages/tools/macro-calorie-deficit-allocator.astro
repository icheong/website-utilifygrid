---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'macro-calorie-deficit-allocator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Macro Nutrient Allocator</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Daily Calorie Target</label>
        <input id="calories" type="number" value="2000" min="800" max="6000" step="50"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Body Weight (kg)</label>
        <input id="weight" type="number" value="75" min="30" max="300" step="0.5"
          class="input-themed"/>
      </div>
    </div>

    <div style="margin-bottom:1.25rem;">
      <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.5rem;">Goal</label>
      <div style="display:flex; gap:0.5rem;">
        {[['cut','Cut (deficit)','#3B82F6'],['maintain','Maintain','#059669'],['bulk','Bulk (surplus)','#F97316']].map(([val, label, color]) => (
          <button
            class="goal-btn toggle-btn"
            data-val={val}
            style={`flex:1; ${val === 'maintain' ? `background:${color}; color:#fff; border-color:${color};` : ''}`}>
            {label}
          </button>
        ))}
      </div>
    </div>

    <div style="display:flex; flex-direction:column; gap:0.75rem;">
      {[
        ['Protein', 'out-protein', '#3B82F6', '#EFF6FF', '#BFDBFE'],
        ['Carbohydrates', 'out-carbs', '#F97316', '#FFF7ED', '#FED7AA'],
        ['Fat', 'out-fat', '#EAB308', '#FEFCE8', '#FEF08A'],
      ].map(([label, id, fg, bg, border]) => (
        <div class="result-card" style={`background:${bg}; border-color:${border};`}>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
            <span style={`font-size:0.82rem; font-weight:700; color:${fg};`}>{label}</span>
            <span id={id + '-kcal'} style="font-size:0.78rem; color:var(--text-muted);"></span>
          </div>
          <div style="display:flex; align-items:center; gap:0.875rem;">
            <div id={id + '-bar-wrap'} style="flex:1; height:8px; background:rgba(0,0,0,0.08); border-radius:999px; overflow:hidden;">
              <div id={id + '-bar'} style={`height:100%; background:${fg}; border-radius:999px; transition:width 0.3s ease; width:0%;`}></div>
            </div>
            <span id={id} style={`font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:${fg}; min-width:60px; text-align:right;`}>— g</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to use the Macro Nutrient Allocator</h2>
    <p class="seo-p">Enter your target daily calorie intake and body weight. Select your goal: Cut (calorie deficit), Maintain, or Bulk (calorie surplus). The macro distribution updates instantly with protein allocated first based on body weight, then remaining calories split between carbohydrates and fat.</p>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Diet planning</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Convert a daily calorie target into specific gram targets for protein, carbohydrates, and fat, giving you a concrete meal plan framework.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Goal-based adjustments</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Compare how macro ratios shift between cutting, maintaining, and bulking to understand the nutritional strategy behind each phase.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Tracking app calibration</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Generate macro targets to enter into MyFitnessPal, Cronometer, or other tracking apps, ensuring your daily targets align with evidence-based recommendations.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How macros are calculated</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:0.75rem;">
      <div>
        <h3 class="font-display seo-h3-sm">Protein allocation</h3>
        <p class="seo-p">Cut: <code class="inline-code">2.2g</code> per kg bodyweight. Maintain: <code class="inline-code">1.8g/kg</code>. Bulk: <code class="inline-code">2.0g/kg</code>. Each gram of protein provides <code class="inline-code">4 kcal</code>. Protein is allocated first because it is the most critical macronutrient for muscle preservation.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Carbohydrate allocation</h3>
        <p class="seo-p">Cut: <code class="inline-code">30%</code> of remaining calories. Maintain: <code class="inline-code">50%</code>. Bulk: <code class="inline-code">55%</code>. Each gram provides <code class="inline-code">4 kcal</code>. Higher carbs support workout performance and recovery during surplus phases.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Fat allocation</h3>
        <p class="seo-p">Fills remaining calorie allocation. Each gram provides <code class="inline-code">9 kcal</code>. Fat is kept at a minimum of <code class="inline-code">20%</code> of total calories for hormonal health and fat-soluble vitamin absorption.</p>
      </div>
      <div>
        <h3 class="font-display seo-h3-sm">Caloric density</h3>
        <p class="seo-p">1g Protein equals <code class="inline-code">4 kcal</code>. 1g Carbohydrate equals <code class="inline-code">4 kcal</code>. 1g Fat equals <code class="inline-code">9 kcal</code>. These are the standard Atwater values used by all major dietary tracking applications.</p>
      </div>
    </div>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently asked questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'How do I know my daily calorie target?', a: 'Calculate your Total Daily Energy Expenditure (TDEE) using a BMR calculator based on your age, sex, weight, and activity level. Your TDEE is your maintenance calories. For a cut, subtract 300-500 kcal from TDEE (a 500 kcal deficit loses about 0.45 kg per week). For a lean bulk, add 200-300 kcal above TDEE. The tool lets you enter any target, so experiment with different values.' },
        { q: 'How much protein do I actually need?', a: 'For general health, 0.8 g/kg is the minimum RDA -- a 75 kg person needs at least 60 g per day. For athletes and people doing resistance training, 1.6-2.2 g/kg supports muscle protein synthesis. The tool allocates 2.2 g/kg during a cut (to preserve muscle), 2.0 g/kg during a bulk, and 1.8 g/kg during maintenance. Going above 2.2 g/kg shows diminishing returns for most people.' },
        { q: 'Are carbs or fats more important?', a: 'Both serve essential functions that the other cannot replace. Carbs are the preferred fuel for high-intensity exercise and brain function -- glycogen stores power your workouts. Fats are critical for hormone production (testosterone, estrogen), cell membrane integrity, and absorption of vitamins A, D, E, and K. The tool never drops either below minimum viable levels.' },
        { q: 'Should I use net carbs or total carbs?', a: 'Net carbs (total minus fibre and sugar alcohols) are used for ketogenic diets where the goal is staying under 20-50 g of digestible carbs per day. For general fitness goals -- losing fat, building muscle, or maintaining weight -- tracking total carbohydrates is standard practice. Fibre is included in total carbs on nutrition labels in most countries.' },
        { q: 'Why does protein get allocated first?', a: 'Protein is the most critical macronutrient for preserving lean muscle mass during a calorie deficit. If you cut calories without adequate protein, up to 25-30% of weight lost can be muscle rather than fat. By allocating protein first at 2.2 g/kg, the tool ensures you hit the evidence-based minimum before remaining calories are split between carbs and fat.' },
        { q: 'Can I use this tool for a ketogenic diet?', a: 'The default allocations are not keto-specific. For keto, you would need approximately 70-75% of calories from fat, 20-25% from protein, and 5-10% from carbs (under 50 g net carbs per day). This tool does not currently support custom macro ratios, but you can use the output gram values as a starting point and adjust manually.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7"><strong class="text-primary" style="color:var(--text-secondary)">Disclaimer:</strong> This tool provides general educational estimates only. Consult a registered dietitian or healthcare professional before making significant changes to your diet or nutrition plan.</div>
  </div>

</ToolLayout>

<script>
  let goal = 'maintain';
  const RATIOS: Record<string, { protein_per_kg: number; carb_pct: number }> = {
    cut:      { protein_per_kg: 2.2, carb_pct: 0.30 },
    maintain: { protein_per_kg: 1.8, carb_pct: 0.50 },
    bulk:     { protein_per_kg: 2.0, carb_pct: 0.55 },
  };
  const GOAL_COLORS: Record<string, string> = { cut:'#3B82F6', maintain:'#059669', bulk:'#F97316' };

  document.querySelectorAll('.goal-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      goal = (btn as HTMLElement).dataset.val!;
      document.querySelectorAll('.goal-btn').forEach((b: Element) => {
        const el = b as HTMLElement; const v = el.dataset.val!;
        if (v === goal) {
          el.style.background  = GOAL_COLORS[v];
          el.style.color       = '#fff';
          el.style.borderColor = GOAL_COLORS[v];
        } else {
          el.style.background  = '';
          el.style.color       = '';
          el.style.borderColor = '';
        }
      });
      calc();
    });
  });

  function calc() {
    const cals   = parseFloat((document.getElementById('calories') as HTMLInputElement).value) || 0;
    const weight = parseFloat((document.getElementById('weight') as HTMLInputElement).value)   || 0;
    const r      = RATIOS[goal];

    const proteinG = weight * r.protein_per_kg;
    const proteinKcal = proteinG * 4;
    const remaining   = Math.max(cals - proteinKcal, 0);
    const carbsKcal   = remaining * r.carb_pct;
    const fatKcal     = remaining * (1 - r.carb_pct);
    const carbsG      = carbsKcal / 4;
    const fatG        = fatKcal / 9;

    const maxG = Math.max(proteinG, carbsG, fatG, 1);
    [
      ['out-protein', proteinG, proteinKcal],
      ['out-carbs',   carbsG,   carbsKcal],
      ['out-fat',     fatG,     fatKcal],
    ].forEach(([id, grams, kcal]) => {
      (document.getElementById(id as string) as HTMLElement).textContent          = Math.round(grams as number) + 'g';
      (document.getElementById(id + '-kcal') as HTMLElement).textContent          = Math.round(kcal as number) + ' kcal';
      (document.getElementById(id + '-bar') as HTMLElement).style.width           = ((grams as number) / maxG * 100) + '%';
    });
  }

  ['calories','weight'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));
  calc();
</script>
