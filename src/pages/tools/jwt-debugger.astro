---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'jwt-debugger')!;
---
<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">JWT Debugger</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Paste a JSON Web Token to decode its header, payload and inspect the signature.</p>

    <div style="display:flex;gap:0.5rem;margin-bottom:0.625rem;flex-wrap:wrap;">
      <button id="btn-sample" class="btn-secondary" type="button" style="font-size:0.78rem;padding:0.35rem 0.75rem;">Load sample</button>
      <button id="btn-clear"  class="btn-secondary" type="button" style="font-size:0.78rem;padding:0.35rem 0.75rem;">Clear</button>
    </div>

    <textarea id="jwt-input" class="input-themed"
      placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
      rows="4"
      style="width:100%;box-sizing:border-box;resize:vertical;border-radius:0.625rem;padding:0.875rem 1rem;font-family:'Fira Code',monospace;font-size:0.78rem;line-height:1.65;margin-bottom:1rem;"
    ></textarea>

    <!-- Token parts colour legend -->
    <div id="token-coloured" style="display:none;font-family:'Fira Code',monospace;font-size:0.78rem;line-height:1.6;word-break:break-all;padding:0.75rem 1rem;background:var(--bg-surface-2);border:1.5px solid var(--border);border-radius:0.625rem;margin-bottom:1.25rem;"></div>

    <!-- Decoded sections -->
    <div id="decoded-sections" style="display:none;display:flex;flex-direction:column;gap:0.875rem;">

      <!-- Header -->
      <div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
          <span style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.09em;color:#F59E0B;">Header</span>
          <button class="btn-secondary copy-btn" data-section="header" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;">Copy</button>
        </div>
        <pre id="out-header" style="margin:0;padding:0.875rem 1rem;background:var(--bg-surface-2);border:1.5px solid rgba(245,158,11,0.3);border-radius:0.625rem;font-family:'Fira Code',monospace;font-size:0.78rem;color:var(--text-primary);overflow-x:auto;line-height:1.6;white-space:pre-wrap;word-break:break-all;"></pre>
      </div>

      <!-- Payload -->
      <div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
          <span style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.09em;color:#3B82F6;">Payload</span>
          <button class="btn-secondary copy-btn" data-section="payload" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;">Copy</button>
        </div>
        <pre id="out-payload" style="margin:0;padding:0.875rem 1rem;background:var(--bg-surface-2);border:1.5px solid rgba(59,130,246,0.3);border-radius:0.625rem;font-family:'Fira Code',monospace;font-size:0.78rem;color:var(--text-primary);overflow-x:auto;line-height:1.6;white-space:pre-wrap;word-break:break-all;"></pre>
      </div>

      <!-- Signature -->
      <div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
          <span style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.09em;color:#10B981;">Signature</span>
          <button class="btn-secondary copy-btn" data-section="sig" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;">Copy</button>
        </div>
        <div id="out-sig" style="padding:0.875rem 1rem;background:var(--bg-surface-2);border:1.5px solid rgba(16,185,129,0.3);border-radius:0.625rem;font-family:'Fira Code',monospace;font-size:0.78rem;color:var(--text-muted);word-break:break-all;line-height:1.6;"></div>
      </div>

      <!-- Claims info rows -->
      <div id="claims-rows" style="display:flex;flex-direction:column;gap:0.375rem;"></div>
    </div>

    <p id="jwt-error" style="display:none;color:#EF4444;font-size:0.82rem;margin-top:0.75rem;"></p>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >JWT Debugger Overview &amp; Modern Technical Context</h2>
    <p class="text-secondary seo-p" >
      JSON Web Tokens (JWTs) are the dominant stateless authentication mechanism used across modern web APIs, single-sign-on (SSO) implementations, and microservice architectures. This JWT Debugger provides instant, client-side decoding of any standard-compliant token, allowing developers to inspect headers, payloads, and signature segments without transmitting sensitive data to external servers. The tool is built with modern vanilla JavaScript and the Web Crypto API-compatible Base64url decoding routines — every operation executes entirely within your browser with zero network requests, zero cookies, and zero data retention.
    </p>
    <p class="text-secondary seo-p" >
      Paste any JWT into the input field or click <strong>Load sample</strong> to see a demonstration token. The debugger instantly splits the token at its two dot delimiters, decodes each Base64url-encoded segment, and renders the header and payload as formatted JSON. Standard claims — such as <code>iat</code> (issued at), <code>exp</code> (expiration), <code>sub</code> (subject), <code>iss</code> (issuer), and <code>aud</code> (audience) — are automatically extracted and displayed as labelled info rows. A colour-coded token preview highlights the three segments in amber, blue, and green for immediate visual identification. Copy buttons allow you to export individual sections to your clipboard for integration into logs, documentation, or debugging workflows.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['API authentication debugging', 'When integrating with third-party APIs that use Bearer token authentication (OAuth 2.0, OpenID Connect), developers frequently encounter 401 Unauthorized errors caused by malformed tokens, expired exp claims, or mismatched iss fields. Pasting the token into this debugger instantly reveals the payload contents, allowing you to verify claims without contacting the identity provider's introspection endpoint.'],
        ['Security auditing and penetration testing', 'Security engineers reviewing JWT implementations need to verify that tokens do not contain sensitive data in the payload (JWTs are Base64url-encoded, not encrypted). This tool enables rapid inspection of token contents to confirm whether PII, session identifiers, or privilege escalation claims are exposed in the clear — a critical step in OWASP Top 10 assessments.'],
        ['Educational and training contexts', 'Students learning about modern authentication protocols benefit from visualising the internal structure of JWTs. This debugger demystifies the three-segment format, demonstrates how Base64url encoding preserves URL safety, and illustrates the relationship between header algorithm declarations (alg) and the corresponding signature verification requirements.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >Deep-Dive: JWT Structure, Base64url Encoding &amp; Signature Mechanics</h2>

    <h3 class="font-display seo-h3-sm" >Core Structure</h3>
    <div style="display:flex;flex-direction:column;gap:0.5rem;margin-bottom:1rem">
      <div class="info-row"><span class="info-label">Format</span><span class="info-value">header.payload.signature — three Base64url-encoded segments separated by dots</span></div>
      <div class="info-row"><span class="info-label">Encoding</span><span class="info-value">Base64url (RFC 4648 §5) — replaces + with -, / with _, and strips trailing =</span></div>
      <div class="info-row"><span class="info-label">Header</span><span class="info-value">JSON object: <code>alg</code> (signing algorithm) and <code>typ</code> (token type, typically "JWT")</span></div>
      <div class="info-row"><span class="info-label">Payload</span><span class="info-value">JSON object containing registered claims (sub, iat, exp, iss, aud) and custom claims</span></div>
      <div class="info-row"><span class="info-label">Signature</span><span class="info-value">Cryptographic hash of header+payload using the algorithm declared in <code>alg</code></span></div>
    </div>

    <h3 class="font-display seo-h3-sm" >How the Decoding Process Works</h3>
    <p class="text-secondary seo-p" >
      The JWT specification (RFC 7519) defines a compact, URL-safe means of representing claims between two parties. The decoder first splits the raw token string at each <code>.</code> delimiter. A valid JWT must produce exactly three segments; any other count triggers an immediate error. Each segment is then Base64url-decoded — a process that reverses the URL-safe encoding by substituting standard Base64 characters back (+ becomes -, / becomes _) and re-appending any stripped <code>=</code> padding characters before invoking <code>atob()</code>. The decoded bytes are then parsed as UTF-8 and deserialised from JSON into a JavaScript object.
    </p>
    <p class="text-secondary seo-p" >
      The <strong>header</strong> typically contains two fields: <code>alg</code> (e.g., HS256, RS256, ES256) specifying the signing algorithm, and <code>typ</code> declaring the media type. The <strong>payload</strong> carries the claims — standardised fields defined by the JWT specification plus any application-specific key-value pairs. The <strong>signature</strong> segment is the raw output of the signing algorithm applied to the ASCII bytes of <code>base64url(header) + "." + base64url(payload)</code> using a secret key (HMAC) or private key (RSA/ECDSA). This debugger decodes the first two segments and displays the third as-is, since signature verification requires the original signing secret.
    </p>
    <p class="text-secondary seo-p" >
      <strong>Edge cases handled:</strong> The tool rejects tokens that do not contain exactly three dot-separated segments. Malformed Base64url sequences that produce invalid JSON trigger a descriptive error rather than an unhandled exception. The <code>exp</code> claim is automatically cross-referenced against the current system time — expired tokens are flagged with a warning indicator in the decoded output. Tokens with missing or unexpected claim structures are decoded gracefully; the tool displays whatever fields are present without requiring a rigid schema.
    </p>
    <p class="text-secondary seo-p-none" >
      <strong>Important limitation:</strong> This tool performs <em>decoding only</em> — it does not verify the cryptographic signature. Signature verification requires the original secret key (for HMAC algorithms) or the public key (for RSA/ECDSA), which only the token issuer possesses. A decoded payload is trustworthy only if you trust the issuer; the presence of a valid-looking <code>exp</code> or <code>iss</code> claim does not guarantee authenticity. Always verify tokens server-side against your application's signing key.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {q:'Can this tool verify the JWT signature?',a:'No. Signature verification requires the secret key or RSA public key, which is a server-side operation. This tool decodes and displays the header and payload, but cannot confirm the signature is valid — only your server can do that. A decoded JWT is readable, but authenticity can only be confirmed by cryptographic verification against the original signing key.'},
        {q:'Is it safe to paste my JWT here?',a:'Yes. This tool runs entirely in your browser using client-side JavaScript — no data is transmitted to any server, no cookies are set, and no network requests are made. However, as a best practice, avoid pasting production JWTs containing sensitive claims into any online tool. Use test tokens where possible, and never expose tokens with PII or elevated privileges in shared environments.'},
        {q:'What does the exp claim mean?',a:'The <code>exp</code> (expiration time) claim is a Unix timestamp (seconds since 1970-01-01T00:00:00Z) indicating when the token expires. This debugger automatically converts it to a human-readable UTC date and flags tokens that have already expired by comparing the timestamp against your local system clock. Expired tokens should be rejected by consuming services, though some implementations may allow a grace period.'},
        {q:'What is the difference between HS256 and RS256?',a:'HS256 uses a shared HMAC secret (symmetric cryptography), meaning both the issuer and verifier use the same key. RS256 uses RSA public/private key pairs (asymmetric cryptography) — the server signs with the private key and any party can verify with the corresponding public key. RS256 is preferred for distributed systems where multiple services need to verify tokens without sharing a secret.'},
        {q:'Why is the payload not encrypted?',a:'JWTs are Base64url-encoded, not encrypted. The payload is readable by anyone who intercepts the token — this is by design. The signature ensures integrity (the payload hasn\'t been tampered with) and authenticity (it was signed by the expected issuer), but does not provide confidentiality. If the payload contains sensitive data, use JWE (JSON Web Encryption) or transmit the JWT over an encrypted channel (TLS).'},
        {q:'What happens if I paste a JWE or non-JWT token?',a:'The tool expects standard JWS (JSON Web Signature) tokens following the RFC 7519 three-segment format. JWE (JSON Web Encryption) tokens have five segments and will trigger a validation error. Non-JWT tokens (such as opaque session identifiers or SAML assertions) do not follow the dot-separated structure and will also be rejected with a descriptive error message.'},
      ].map(item=>(
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLE = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyLCJleHAiOjE3MzUwODk2MDB9.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c';

  const jwtInput       = document.getElementById('jwt-input') as HTMLTextAreaElement;
  const tokenColoured  = document.getElementById('token-coloured')!;
  const decodedSection = document.getElementById('decoded-sections')!;
  const outHeader      = document.getElementById('out-header')!;
  const outPayload     = document.getElementById('out-payload')!;
  const outSig         = document.getElementById('out-sig')!;
  const claimsRows     = document.getElementById('claims-rows')!;
  const jwtError       = document.getElementById('jwt-error')!;

  // Storage for copy buttons
  const sectionData: Record<string,string> = {};

  function b64urlDecode(str: string): string {
    const b64 = str.replace(/-/g,'+').replace(/_/g,'/');
    const padded = b64.padEnd(b64.length + (4 - b64.length % 4) % 4, '=');
    return decodeURIComponent(atob(padded).split('').map(c=>'%'+c.charCodeAt(0).toString(16).padStart(2,'0')).join(''));
  }

  function formatUnix(ts: number): string {
    try { return new Date(ts*1000).toISOString().replace('T',' ').replace('.000Z',' UTC'); } catch { return String(ts); }
  }

  function decode(raw: string) {
    jwtError.style.display = 'none';
    const token = raw.trim();
    if (!token) { tokenColoured.style.display='none'; decodedSection.style.display='none'; return; }

    const parts = token.split('.');
    if (parts.length !== 3) {
      jwtError.textContent = 'Invalid JWT — expected 3 dot-separated parts.';
      jwtError.style.display = 'block';
      tokenColoured.style.display = 'none';
      decodedSection.style.display = 'none';
      return;
    }

    // Coloured token display — these are data encoding colours, not UI chrome
    tokenColoured.style.display = 'block';
    tokenColoured.innerHTML =
      `<span style="color:#F59E0B">${escHtml(parts[0])}</span>` +
      `<span style="color:var(--text-muted)">.</span>` +
      `<span style="color:#3B82F6">${escHtml(parts[1])}</span>` +
      `<span style="color:var(--text-muted)">.</span>` +
      `<span style="color:#10B981">${escHtml(parts[2])}</span>`;

    let header: any, payload: any;
    try {
      header  = JSON.parse(b64urlDecode(parts[0]));
      payload = JSON.parse(b64urlDecode(parts[1]));
    } catch {
      jwtError.textContent = 'Failed to decode JWT parts — check the token is well-formed.';
      jwtError.style.display = 'block';
      decodedSection.style.display = 'none';
      return;
    }

    const headerStr  = JSON.stringify(header, null, 2);
    const payloadStr = JSON.stringify(payload, null, 2);

    outHeader.textContent  = headerStr;
    outPayload.textContent = payloadStr;
    outSig.textContent     = parts[2];

    sectionData['header']  = headerStr;
    sectionData['payload'] = payloadStr;
    sectionData['sig']     = parts[2];

    // Well-known claims
    claimsRows.innerHTML = '';
    const claims: [string, string][] = [];
    if (payload.iat) claims.push(['Issued at',   formatUnix(payload.iat)]);
    if (payload.exp) {
      const expired = Date.now() > payload.exp * 1000;
      claims.push(['Expires',  formatUnix(payload.exp) + (expired ? '  ⚠ EXPIRED' : '  ✓ valid')]);
    }
    if (payload.sub) claims.push(['Subject',     String(payload.sub)]);
    if (payload.iss) claims.push(['Issuer',      String(payload.iss)]);
    if (payload.aud) claims.push(['Audience',    Array.isArray(payload.aud) ? payload.aud.join(', ') : String(payload.aud)]);
    if (header.alg)  claims.push(['Algorithm',   String(header.alg)]);

    claims.forEach(([label, value]) => {
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `<span class="info-label">${escHtml(label)}</span><span class="info-value">${escHtml(value)}</span>`;
      claimsRows.appendChild(row);
    });

    decodedSection.style.display = 'flex';
  }

  function escHtml(s: string): string {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  jwtInput.addEventListener('input', () => decode(jwtInput.value));
  document.getElementById('btn-sample')!.addEventListener('click', () => { jwtInput.value = SAMPLE; decode(SAMPLE); });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    jwtInput.value = '';
    tokenColoured.style.display = 'none';
    decodedSection.style.display = 'none';
    jwtError.style.display = 'none';
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.section!;
      navigator.clipboard.writeText(sectionData[key] || '').then(() => {
        btn.textContent = '✓ Copied!';
        btn.classList.add('btn-success');
        setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
      });
    });
  });

  // Auto-decode if pre-filled
  if (jwtInput.value) decode(jwtInput.value);
</script>
