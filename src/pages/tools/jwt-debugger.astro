---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'jwt-debugger')!;
---
<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">JWT Debugger</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Paste a JSON Web Token to decode its header, payload and inspect the signature.</p>

    <div style="display:flex;gap:0.5rem;margin-bottom:0.625rem;flex-wrap:wrap;">
      <button id="btn-sample" class="btn-secondary" type="button" style="font-size:0.78rem;padding:0.35rem 0.75rem;">Load sample</button>
      <button id="btn-clear"  class="btn-secondary" type="button" style="font-size:0.78rem;padding:0.35rem 0.75rem;">Clear</button>
    </div>

    <textarea id="jwt-input" class="input-themed"
      placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
      rows="4"
      style="width:100%;box-sizing:border-box;resize:vertical;border-radius:0.625rem;padding:0.875rem 1rem;font-family:'Fira Code',monospace;font-size:0.78rem;line-height:1.65;margin-bottom:1rem;"
    ></textarea>

    <!-- Token parts colour legend -->
    <div id="token-coloured" style="display:none;font-family:'Fira Code',monospace;font-size:0.78rem;line-height:1.6;word-break:break-all;padding:0.75rem 1rem;background:var(--bg-surface-2);border:1.5px solid var(--border);border-radius:0.625rem;margin-bottom:1.25rem;"></div>

    <!-- Decoded sections -->
    <div id="decoded-sections" style="display:none;display:flex;flex-direction:column;gap:0.875rem;">

      <!-- Header -->
      <div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
          <span style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.09em;color:#F59E0B;">Header</span>
          <button class="btn-secondary copy-btn" data-section="header" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;">Copy</button>
        </div>
        <pre id="out-header" style="margin:0;padding:0.875rem 1rem;background:var(--bg-surface-2);border:1.5px solid rgba(245,158,11,0.3);border-radius:0.625rem;font-family:'Fira Code',monospace;font-size:0.78rem;color:var(--text-primary);overflow-x:auto;line-height:1.6;white-space:pre-wrap;word-break:break-all;"></pre>
      </div>

      <!-- Payload -->
      <div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
          <span style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.09em;color:#3B82F6;">Payload</span>
          <button class="btn-secondary copy-btn" data-section="payload" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;">Copy</button>
        </div>
        <pre id="out-payload" style="margin:0;padding:0.875rem 1rem;background:var(--bg-surface-2);border:1.5px solid rgba(59,130,246,0.3);border-radius:0.625rem;font-family:'Fira Code',monospace;font-size:0.78rem;color:var(--text-primary);overflow-x:auto;line-height:1.6;white-space:pre-wrap;word-break:break-all;"></pre>
      </div>

      <!-- Signature -->
      <div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
          <span style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.09em;color:#10B981;">Signature</span>
          <button class="btn-secondary copy-btn" data-section="sig" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;">Copy</button>
        </div>
        <div id="out-sig" style="padding:0.875rem 1rem;background:var(--bg-surface-2);border:1.5px solid rgba(16,185,129,0.3);border-radius:0.625rem;font-family:'Fira Code',monospace;font-size:0.78rem;color:var(--text-muted);word-break:break-all;line-height:1.6;"></div>
      </div>

      <!-- Claims info rows -->
      <div id="claims-rows" style="display:flex;flex-direction:column;gap:0.375rem;"></div>
    </div>

    <p id="jwt-error" style="display:none;color:#EF4444;font-size:0.82rem;margin-top:0.75rem;"></p>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >Paste a JWT — see what's inside in two seconds</h2>
    <p class="seo-p" >
      Your API keeps returning 401 Unauthorized but the token looks fine at first glance. You copied a JWT from a login response and need to check whether the <code>exp</code> claim has expired. You're integrating with a third-party OAuth provider and want to verify the <code>sub</code> and <code>aud</code> claims before wiring up your auth middleware. Paste the token into the text box and the header, payload, and signature decode instantly — formatted JSON, colour-coded segments, and standard claims extracted into labelled rows.
    </p>
    <p class="seo-p" >
      Click <strong>Load sample</strong> to see a demonstration token with an expired <code>exp</code> claim, or paste your own token. The three segments appear colour-coded — amber for header, blue for payload, green for signature — so you can visually identify where each part begins and ends. Each decoded section has a <strong>Copy</strong> button for exporting to your clipboard.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Who uses this JWT debugger</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Developers debugging 401 errors', 'A developer receives a 401 from a protected endpoint. The token exists in the Authorization header but something is wrong. Paste it here and the decoded payload shows whether the exp claim expired three hours ago, whether the iss claim doesn\'t match the expected issuer, or whether the aud claim points to the wrong service. The answer is visible in two seconds instead of adding debug logs and redeploying.'],
        ['Security auditors inspecting token contents', 'JWTs are Base64url-encoded, not encrypted — anyone with the token can read the payload. A security reviewer pasting a production token into this tool can immediately see whether sensitive data like email addresses, internal user IDs, or role assignments are exposed in the clear. This is a critical check during OWASP assessments and penetration tests.'],
        ['Teams learning OAuth and OIDC flows', 'Students and junior developers working through OAuth 2.0 or OpenID Connect tutorials benefit from seeing the actual structure of the tokens they receive. The colour-coded three-segment display makes the header.payload.signature format intuitive, and the extracted claims rows show what iat, exp, sub, iss, and aud actually contain in practice.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >How a JWT is decoded — and what each part means</h2>

    <h3 class="font-display seo-h3-sm" >The three-part structure</h3>
    <p class="seo-p" >
      A JWT looks like a long random string, but it's actually three pieces of data joined by dots: <code>header.payload.signature</code>. Each piece is Base64url-encoded — a URL-safe encoding that converts binary data into printable ASCII characters. The encoding is not encryption; it's a reversible transformation, like Base64 but with two character substitutions (<code>+</code> becomes <code>-</code>, <code>/</code> becomes <code>_</code>) and the trailing <code>=</code> padding stripped. Anyone with the token can decode it.
    </p>

    <h3 class="font-display seo-h3-sm" >What happens when you paste a token</h3>
    <p class="seo-p" >
      The debugger splits the string at each dot. A valid JWT has exactly three segments — if you get two or four, it's not a standard JWT. Each segment is Base6url-decoded by restoring the padding, reversing the character substitutions, and decoding the resulting bytes as UTF-8. The header and payload are then parsed as JSON. The signature is displayed as-is, because verifying it requires the original signing key which only the issuer has.
    </p>

    <h3 class="font-display seo-h3-sm" >Worked example: the sample token</h3>
    <p class="seo-p" >
      The sample token's header decodes to show alg: HS256 and typ: JWT — it's an HMAC-SHA256 signed token of type JWT. The payload decodes to show sub: 1234567890, name: John Doe, iat: 1516239022, and exp: 1735089600. The <code>iat</code> (issued at) is January 19, 2018. The <code>exp</code> (expiration) is December 25, 2024 — which means this token is expired. The debugger flags it with a warning. The signature segment is the cryptographic proof that the payload hasn't been tampered with, but the tool can't verify it without the server's secret key.
    </p>

    <h3 class="font-display seo-h3-sm" >What the decoded claims tell you</h3>
    <p class="seo-p" >
      The <code>sub</code> claim identifies who the token belongs to — usually a user ID. The <code>iss</code> claim (if present) identifies who issued it. The <code>aud</code> claim identifies which service it's intended for. The <code>exp</code> claim is a Unix timestamp indicating when the token expires. The <code>iat</code> claim records when it was created. If any of these claims don't match what your server expects — wrong issuer, expired timestamp, unexpected audience — your API will reject the token with a 401.
    </p>

    <h3 class="font-display seo-h3-sm" >Important: this tool decodes but does not verify</h3>
    <p class="seo-p" >
      The signature is displayed but not validated. To verify a signature, you'd need the server's secret key (for HMAC algorithms) or public key (for RSA/ECDSA). This is a deliberate limitation — the debugger is for inspection, not security validation. A decoded payload is only trustworthy if you trust the issuer. An attacker can craft a JWT with any payload they want; the signature is what makes it valid, and only the signing party can produce a valid one.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {q:'Can this tool verify the JWT signature?',a:'No. Signature verification requires the secret key or RSA public key, which is a server-side operation. This tool decodes and displays the header and payload, but cannot confirm the signature is valid — only your server can do that. A decoded JWT is readable, but authenticity can only be confirmed by cryptographic verification against the original signing key.'},
        {q:'Is it safe to paste my JWT here?',a:'Yes. The decoding happens entirely in your browser — no data is sent to any server, no cookies are set, no network requests are made. The token stays in your browser\'s memory and is gone when you close the tab. That said, avoid pasting production tokens with sensitive claims (like admin privileges or personal data) into any online tool as a general security practice.'},
        {q:'What does the exp claim mean?',a:'The exp (expiration time) claim is a Unix timestamp — seconds since 1 January 1970 — indicating when the token expires. The debugger converts it to a human-readable UTC date and flags expired tokens by comparing against your system clock. A token with exp 1735089600 expired on 25 December 2024. Consuming services should reject expired tokens, though some implementations allow a short grace period.'},
        {q:'What is the difference between HS256 and RS256?',a:'HS256 uses a shared secret (symmetric) — the same key signs and verifies. RS256 uses RSA key pairs (asymmetric) — the server signs with a private key, anyone can verify with the public key. RS256 is preferred when multiple services need to verify tokens without sharing a secret, such as in microservice architectures or when third-party services need to validate your tokens.'},
        {q:'Why is the payload not encrypted?',a:'JWTs are Base64url-encoded, not encrypted. The payload is readable by anyone who intercepts the token — this is by design. The signature ensures integrity (the payload hasn\'t been tampered with) and authenticity (it was signed by the expected issuer), but does not provide confidentiality. If the payload contains sensitive data, use JWE (JSON Web Encryption) or transmit the JWT over TLS only.'},
        {q:'What happens if I paste a JWE or non-JWT token?',a:'JWE tokens have five dot-separated segments and will trigger a validation error because this tool expects the three-segment JWS format. Non-JWT tokens like opaque session IDs or SAML assertions don\'t follow the dot-separated structure and will also be rejected with a descriptive error message.'},
        {q:'What is Base64url and why is it different from Base64?',a:'Base64url (RFC 4648 §5) is a URL-safe variant of Base64 encoding. It replaces the + character with - and / with _, then strips trailing = padding. Standard Base64 uses + and / which are not safe in URLs and filenames. JWTs use Base64url so the token can be safely included in HTTP headers, query parameters, and URLs without additional escaping.'},
      ].map(item=>(
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  const SAMPLE = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyLCJleHAiOjE3MzUwODk2MDB9.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c';

  const jwtInput       = document.getElementById('jwt-input') as HTMLTextAreaElement;
  const tokenColoured  = document.getElementById('token-coloured')!;
  const decodedSection = document.getElementById('decoded-sections')!;
  const outHeader      = document.getElementById('out-header')!;
  const outPayload     = document.getElementById('out-payload')!;
  const outSig         = document.getElementById('out-sig')!;
  const claimsRows     = document.getElementById('claims-rows')!;
  const jwtError       = document.getElementById('jwt-error')!;

  // Storage for copy buttons
  const sectionData: Record<string,string> = {};

  function b64urlDecode(str: string): string {
    const b64 = str.replace(/-/g,'+').replace(/_/g,'/');
    const padded = b64.padEnd(b64.length + (4 - b64.length % 4) % 4, '=');
    return decodeURIComponent(atob(padded).split('').map(c=>'%'+c.charCodeAt(0).toString(16).padStart(2,'0')).join(''));
  }

  function formatUnix(ts: number): string {
    try { return new Date(ts*1000).toISOString().replace('T',' ').replace('.000Z',' UTC'); } catch { return String(ts); }
  }

  function decode(raw: string) {
    jwtError.style.display = 'none';
    const token = raw.trim();
    if (!token) { tokenColoured.style.display='none'; decodedSection.style.display='none'; return; }

    const parts = token.split('.');
    if (parts.length !== 3) {
      jwtError.textContent = 'Invalid JWT — expected 3 dot-separated parts.';
      jwtError.style.display = 'block';
      tokenColoured.style.display = 'none';
      decodedSection.style.display = 'none';
      return;
    }

    // Coloured token display — these are data encoding colours, not UI chrome
    tokenColoured.style.display = 'block';
    tokenColoured.innerHTML =
      `<span style="color:#F59E0B">${escHtml(parts[0])}</span>` +
      `<span style="color:var(--text-muted)">.</span>` +
      `<span style="color:#3B82F6">${escHtml(parts[1])}</span>` +
      `<span style="color:var(--text-muted)">.</span>` +
      `<span style="color:#10B981">${escHtml(parts[2])}</span>`;

    let header: any, payload: any;
    try {
      header  = JSON.parse(b64urlDecode(parts[0]));
      payload = JSON.parse(b64urlDecode(parts[1]));
    } catch {
      jwtError.textContent = 'Failed to decode JWT parts — check the token is well-formed.';
      jwtError.style.display = 'block';
      decodedSection.style.display = 'none';
      return;
    }

    const headerStr  = JSON.stringify(header, null, 2);
    const payloadStr = JSON.stringify(payload, null, 2);

    outHeader.textContent  = headerStr;
    outPayload.textContent = payloadStr;
    outSig.textContent     = parts[2];

    sectionData['header']  = headerStr;
    sectionData['payload'] = payloadStr;
    sectionData['sig']     = parts[2];

    // Well-known claims
    claimsRows.innerHTML = '';
    const claims: [string, string][] = [];
    if (payload.iat) claims.push(['Issued at',   formatUnix(payload.iat)]);
    if (payload.exp) {
      const expired = Date.now() > payload.exp * 1000;
      claims.push(['Expires',  formatUnix(payload.exp) + (expired ? '  ⚠ EXPIRED' : '  ✓ valid')]);
    }
    if (payload.sub) claims.push(['Subject',     String(payload.sub)]);
    if (payload.iss) claims.push(['Issuer',      String(payload.iss)]);
    if (payload.aud) claims.push(['Audience',    Array.isArray(payload.aud) ? payload.aud.join(', ') : String(payload.aud)]);
    if (header.alg)  claims.push(['Algorithm',   String(header.alg)]);

    claims.forEach(([label, value]) => {
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `<span class="info-label">${escHtml(label)}</span><span class="info-value">${escHtml(value)}</span>`;
      claimsRows.appendChild(row);
    });

    decodedSection.style.display = 'flex';
  }

  function escHtml(s: string): string {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  jwtInput.addEventListener('input', () => decode(jwtInput.value));
  document.getElementById('btn-sample')!.addEventListener('click', () => { jwtInput.value = SAMPLE; decode(SAMPLE); });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    jwtInput.value = '';
    tokenColoured.style.display = 'none';
    decodedSection.style.display = 'none';
    jwtError.style.display = 'none';
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.section!;
      navigator.clipboard.writeText(sectionData[key] || '').then(() => {
        btn.textContent = '✓ Copied!';
        btn.classList.add('btn-success');
        setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
      });
    });
  });

  // Auto-decode if pre-filled
  if (jwtInput.value) decode(jwtInput.value);
</script>
