---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'length-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Length Converter</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly. All calculations run in your browser.</p>

    <!-- Input row -->
    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label class="tool-label" for="length-input">Value</label>
        <input id="length-input" type="number" value="1" min="0" step="any" placeholder="Enter value"
          class="input-themed" />
      </div>
      <div>
        <label class="tool-label" for="length-unit">Unit</label>
        <select id="length-unit" class="select-themed" style="min-width:10rem;">
          <option value="mm">Millimeters (mm)</option>
          <option value="cm">Centimeters (cm)</option>
          <option value="m" selected>Meters (m)</option>
          <option value="km">Kilometers (km)</option>
          <option value="in">Inches (in)</option>
          <option value="ft">Feet (ft)</option>
          <option value="yd">Yards (yd)</option>
          <option value="mi">Miles (mi)</option>
          <option value="nmi">Nautical Miles (nmi)</option>
          <option value="um">Micrometers (μm)</option>
          <option value="nm">Nanometers (nm)</option>
        </select>
      </div>
    </div>

    <!-- Results grid -->
    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>

    <!-- Quick references -->
    <div style="margin-top:1.5rem;">
      <p class="text-secondary" style="font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Quick References</p>
      <div id="refs" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Convert Between Metric and Imperial Length Units</h2>
    <p class="seo-p">
      You just received a supplier quote for a steel bracket in millimeters, but your CAD drawing is in inches. Typing the wrong conversion into a purchase order can cost hundreds of dollars in rework. Enter your value, pick the source unit from the dropdown, and every other length unit updates instantly — no need to hit a calculate button or wait for a page refresh. The copy-to-clipboard button on each result means you can paste the converted value straight into your spreadsheet or email.
    </p>
    <p class="seo-p">
      The converter covers 11 units spanning nanometers to kilometers and inches to nautical miles. Whether you are matching a pipe fitting spec in millimeters to a catalogue listing in inches, or comparing a hiking trail measured in miles against a fitness tracker reporting kilometers, the tool gives you every equivalent at a glance. The quick-reference strip at the bottom translates the current value into familiar objects — a credit card, a smartphone, a football pitch — so you can sanity-check whether the number makes intuitive sense before using it.
    </p>

    <h3 class="font-display seo-h3-sm">When you need quick imperial-to-metric swaps for procurement</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        ['Buying parts from international suppliers', 'A procurement officer at a US manufacturer orders a 25 mm bearing from a German supplier. The internal spec sheet lists the clearance as 0.010 inches. Converting 0.010 in to mm gives 0.254 mm — a critical tolerance that determines whether the bearing fits. Getting this wrong means a delayed production line. The tool shows the conversion instantly, and the copy button eliminates transcription errors between the converter and the purchase order.'],
        ['Real estate listings across borders', 'A British expat comparing London flats listed in square feet against Sydney apartments listed in square metres needs a quick length sanity check: a room described as 12 ft wide converts to 3.6576 m. That is narrower than the 4 m rooms they are used to. When your estate agent says the garden is 150 ft deep, converting to metres (45.72 m) helps you visualise the actual space without a tape measure.'],
        ['Fitness and sports training', 'A marathon runner training for the London Marathon knows the race is 26.2 miles, but their GPS watch displays distance in kilometres. Converting 26.2 mi to km gives 42.1648 km — matching the official 42.195 km course (the small difference accounts for the measured certified distance). Cyclists planning a century ride (100 mi) can instantly see that equals 160.934 km, helping them set realistic training targets.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/weight-mass-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Weight & Mass Converter</a>
        <a href="/tools/temperature-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Temperature Converter</a>
        <a href="/tools/area-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Area Converter</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Length Converter Calculates Exact Conversions</h2>
    <p class="seo-p">
      Every length unit in the converter is stored as a fixed number of meters. When you type 5 inches, the tool multiplies 5 by 0.0254 (the exact meter value of one inch) to get 0.127 m, then divides by the target unit's factor to produce the result. Because every conversion passes through meters in a single step, there is no chain of intermediate conversions that could introduce rounding drift. The result for 5 inches to centimeters is exactly 12.7 cm — not an approximation rounded at an intermediate stage.
    </p>

    <h3 class="font-display seo-h3-sm">Why imperial-to-metric factors are exact (not rounded)</h3>
    <p class="seo-p-sm">
      In 1959, six English-speaking nations signed the International Yard and Pound Agreement, defining the inch as exactly 25.4 millimeters. That single definition cascades: 1 foot becomes exactly 0.3048 m, 1 yard exactly 0.9144 m, and 1 mile exactly 1609.344 m. These are not rounded approximations — they are exact rational numbers. The nautical mile was defined independently in 1929 as exactly 1852 m. Because the factors are exact, converting 1 mile to feet gives exactly 5280, not 5279.9999.
    </p>
    <p class="seo-p-sm">
      For metric units, the factors are powers of ten by definition: 1 mm = 0.001 m, 1 cm = 0.01 m, 1 km = 1000 m. Converting between two metric units (say, millimeters to kilometers) simply shifts the decimal point — no floating-point arithmetic is needed at all for these cases. The only time IEEE 754 rounding can appear is when converting between metric and imperial, and even then it only affects digits beyond the 15th significant figure.
    </p>

    <h3 class="font-display seo-h3-sm">How the display adapts to very large and very small numbers</h3>
    <p class="seo-p-sm">
      A length of 0.000000001 meters (1 nanometer) is meaningful in semiconductor manufacturing — Intel's current process nodes are below 5 nm. Converting that to kilometers gives 0.000000000000001 km, which is unreadable in fixed notation. The tool switches to scientific notation (1 × 10⁻¹² km) for any result below 0.001. Conversely, the distance from Earth to the Moon is about 384,400,000 m. Displaying that in inches yields roughly 15,133,858,267,716.5 inches, which the tool formats with locale separators and two decimal places for readability.
    </p>
    <p class="seo-p-none">
      The formatting thresholds are: values below 0.001 and above 1 billion use scientific notation; values between 1,000 and 1 billion use locale-formatted numbers with 2-4 decimal places; values between 0.001 and 1,000 use 6-8 decimal places. This keeps the output scannable whether you are measuring transistor features or interplanetary distances.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "How many centimeters are in 5 inches?",
          a: "Five inches equals exactly 12.7 centimeters. The conversion factor is exact: 1 inch = 2.54 cm, established by international agreement in 1959. This is not an approximation — it is a precise rational number used in manufacturing, machining, and engineering worldwide. For quick mental estimates, each inch is about 2.5 cm, so multiply the inch value by 2.5 for a ballpark figure."
        },
        {
          q: "Why does this tool show different results than Google's built-in converter?",
          a: "Google's converter uses the same exact conversion factors, so results should match to 15+ significant digits. If you see a difference, it is likely due to display rounding — Google might round 1.60934 km/mi to 1.61, while this tool shows more decimal places. For practical purposes (cooking, fitness, construction), the results are identical. The difference only matters in scientific or engineering contexts requiring extreme precision."
        },
        {
          q: "What is a nautical mile and why is it different from a regular mile?",
          a: "A nautical mile equals exactly 1852 meters, while a regular (statute) mile is 1609.344 meters. The nautical mile was designed for navigation: it equals one minute of latitude along the Earth's meridian. This means a navigator can measure the distance between two latitude lines on a chart and know the nautical distance directly. Speed at sea is measured in knots (nautical miles per hour), and aviation uses nautical miles for the same reason — it aligns with the coordinate system used on navigation charts."
        },
        {
          q: "Can I use this for construction material estimates?",
          a: "Yes. If your lumber supplier sells boards measured in feet but your project plans are in meters, enter the foot measurement and the meter equivalent appears instantly. For example, a 10 ft board is exactly 3.048 m. Flooring, tiling, and drywall estimates all benefit from quick unit swaps, especially when sourcing materials internationally or following plans from a different country's standards."
        },
        {
          q: "Why does converting 1 mile to feet give exactly 5280?",
          a: "The mile-to-foot relationship is exact by definition: 1 mile = 5280 feet. This comes from the chain of exact definitions: 1 mile = 8 furlongs, 1 furlong = 660 feet, and 8 × 660 = 5280. Since 1959, the foot has been defined as exactly 0.3048 meters, and the mile as exactly 1609.344 meters. Dividing 1609.344 by 0.3048 gives exactly 5280 — no rounding involved."
        },
        {
          q: "How do I convert kilometers to miles for a road trip?",
          a: "Divide the kilometer value by 1.609344. For example, a 300 km drive equals approximately 186.41 miles. A quick mental shortcut: 100 km is roughly 62.1 miles, so multiply the km value by 0.621 for a ballpark figure. This tool gives the precise result, but the 0.621 rule of thumb is accurate to within about 0.1% for quick planning."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  // ── Unit definitions: factor to meters ──────────────────────────
  const UNITS = [
    { id: 'nm',  label: 'Nanometers',      abbr: 'nm',  factor: 1e-9 },
    { id: 'um',  label: 'Micrometers',     abbr: 'μm',  factor: 1e-6 },
    { id: 'mm',  label: 'Millimeters',     abbr: 'mm',  factor: 0.001 },
    { id: 'cm',  label: 'Centimeters',     abbr: 'cm',  factor: 0.01 },
    { id: 'm',   label: 'Meters',          abbr: 'm',   factor: 1 },
    { id: 'km',  label: 'Kilometers',      abbr: 'km',  factor: 1000 },
    { id: 'in',  label: 'Inches',          abbr: 'in',  factor: 0.0254 },
    { id: 'ft',  label: 'Feet',            abbr: 'ft',  factor: 0.3048 },
    { id: 'yd',  label: 'Yards',           abbr: 'yd',  factor: 0.9144 },
    { id: 'mi',  label: 'Miles',           abbr: 'mi',  factor: 1609.344 },
    { id: 'nmi', label: 'Nautical Miles',  abbr: 'nmi', factor: 1852 },
  ];

  const input  = document.getElementById('length-input') as HTMLInputElement;
  const select = document.getElementById('length-unit') as HTMLSelectElement;
  const grid   = document.getElementById('results')!;
  const refs   = document.getElementById('refs')!;

  // ── Quick-reference objects (stored in meters) ──────────────────
  const REFS = [
    { name: 'Credit Card',      m: 0.0856 },
    { name: 'Smartphone',       m: 0.146 },
    { name: 'Guitar',           m: 1.0 },
    { name: 'Car',              m: 4.5 },
    { name: 'Bus',              m: 12.0 },
    { name: 'Football Pitch',   m: 105.0 },
    { name: 'Marathon',         m: 42195.0 },
    { name: 'Distance to Moon', m: 384_400_000 },
  ];

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9)  return value.toExponential(4);
    if (abs >= 1e6)  return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1)    return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6)  return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;

    grid.innerHTML = '';

    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector<HTMLButtonElement>('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector<HTMLButtonElement>('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });

    // ── Quick references ──────────────────────────────────────────
    const unitLabel = UNITS.find(u => u.id === fromUnit)!.abbr;
    refs.innerHTML = '';
    REFS.forEach(r => {
      const value = (r.m * 1) / fromFactor;
      const display = formatResult(value);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.style.padding = '0.5rem 0.75rem';
      row.innerHTML = `
        <span class="info-label" style="min-width:auto;">${r.name}</span>
        <span class="info-value" style="font-size:0.82rem;">${display} ${unitLabel}</span>
      `;
      refs.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
