---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'structured-data-ai-formatter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Structured Data AI Formatter</h2>

    <textarea id="raw-text" placeholder="Paste raw AI-generated text here. Include product details, FAQ pairs, or recipe steps…"
      style="width:100%; height:180px; padding:0.875rem; border:1.5px solid #E9D5FF; border-radius:0.625rem; font-size:0.875rem; color:var(--text-primary); resize:vertical; box-sizing:border-box; outline:none; line-height:1.65; margin-bottom:0.875rem; font-family:inherit; background:var(--bg-surface);"
      onfocus="this.style.borderColor='#9333EA'" onblur="this.style.borderColor='#E9D5FF'"></textarea>

    <div style="display:flex; gap:0.5rem; margin-bottom:1rem; flex-wrap:wrap;">
      <button class="schema-btn" data-type="Product"
        style="padding:0.5rem 1rem; background:#7C3AED; color:#fff; border:none; border-radius:0.5rem; font-size:0.82rem; font-weight:600; cursor:pointer;">Product</button>
      <button class="schema-btn btn-secondary" data-type="FAQPage"
        style="padding:0.5rem 1rem;">FAQ</button>
      <button class="schema-btn btn-secondary" data-type="Recipe"
        style="padding:0.5rem 1rem;">Recipe</button>
      <button id="copy-ld" class="btn-secondary" style="margin-left:auto;">Copy JSON-LD</button>
    </div>

    <div id="preview-tag" style="font-size:0.7rem; font-family:'Fira Code',monospace; color:#9333EA; margin-bottom:0.25rem;">&lt;script type="application/ld+json"&gt;</div>
    <pre id="ld-output" style="margin:0; background:#1E1E2E; border-radius:0.875rem; padding:1rem; font-family:'Fira Code',monospace; font-size:0.75rem; color:#E2E8F0; white-space:pre-wrap; word-break:break-all; max-height:320px; overflow-y:auto; line-height:1.7;"></pre>
    <div style="font-size:0.7rem; font-family:'Fira Code',monospace; color:#9333EA; margin-top:0.25rem;">&lt;/script&gt;</div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to generate structured data for AI</h2>
    <p class="seo-p">Paste your raw product details, FAQ pairs, or recipe text into the input field. Click Product, FAQ, or Recipe to generate valid JSON-LD schema markup that search engines and AI models can parse. The output is ready to embed in your HTML — copy it with one click.</p>
    <p class="seo-p">For example, pasting "Blue Wireless Headphones, Premium sound quality with 30-hour battery, $129.99" and clicking Product generates a complete schema.org Product object with name, description, price, and availability fields. The FAQ button detects Q:/A: patterns and produces a valid FAQPage schema. The Recipe button extracts ingredients from bullet points and numbered steps.</p>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem;">Dataset preparation</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0;">Convert messy product descriptions, FAQ text, or recipe notes into structured JSON-LD that Google, ChatGPT, and other AI systems can parse without losing structure or introducing encoding errors.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem;">SEO schema generation</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0;">Generate valid JSON-LD markup for Product, FAQ, and Recipe schemas that Google's Rich Snippet guidelines require. The copy button wraps output in script tags ready to paste into your HTML head.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem;">Content auditing</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0;">Review AI-generated product pages or recipe content by seeing how the structured data extractor interprets the text — if fields are missing or misaligned, the source content needs revision.</p>
      </div>
    </div>
  

    <!-- Related tools -->
    <div style="margin-top:1.5rem; padding:1rem 1.25rem; background:var(--bg-surface-2); border:1px solid var(--border); border-radius:0.75rem;">
      <h3 style="font-size:0.85rem; font-weight:700; color:var(--text-primary); margin-bottom:0.5rem;">Related tools</h3>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem;">
        <a href="/tools/prompt-architect-tokenizer" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">Cross-Model Prompt Architect & Tokenizer</a>
        <a href="/tools/json-yaml-toml-converter" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">JSON to YAML / TOML Converter</a>
        <a href="/tools/json-prettifier" style="font-size:0.85rem; color:#1D4ED8; text-decoration:none; font-weight:500;">JSON Prettifier</a>
      </div>
    </div>
</div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Structured data formatting pipeline</h2>
    <p class="seo-p">The tool applies a three-stage pipeline to transform raw data into AI-optimised text.</p>
    <h3 class="font-display seo-h3-sm">Input parsing</h3>
    <p class="seo-p">Raw data is parsed into an internal representation regardless of source format. JSON is parsed natively. CSV is split into headers and rows. Key-value pairs are normalised into a consistent schema.</p>
    <h3 class="font-display seo-h3-sm">Optimisation</h3>
    <p class="seo-p">The parsed data is formatted according to the selected style. Table format uses aligned columns with headers. List format uses hierarchical bullet points. JSON format produces minified or pretty-printed output based on token budget.</p>
    <h3 class="font-display seo-h3-sm">Token budgeting</h3>
    <p class="seo-p">The tool estimates token count using the <code class="inline-code">chars/4</code> approximation and warns if the formatted output exceeds typical context windows. Compact formatting options reduce token usage by 20-40% compared to raw data.</p>
    <h3 class="font-display seo-h3-sm">Model-specific adaptation</h3>
    <p class="seo-p">Output is adapted for the selected model's preferences. Claude receives XML-tagged sections. ChatGPT receives system/user role markers. Gemini receives markdown-structured sections. Llama receives plain text with clear delimiters.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently asked questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What data formats are supported?', a: 'JSON (objects and arrays), CSV with headers, and plain key-value pairs separated by colons or equals signs. The parser is lenient with formatting and handles missing quotes, trailing commas, and inconsistent whitespace.' },
        { q: 'How does formatting affect model performance?', a: 'Well-structured input reduces hallucination because the model can clearly distinguish between data fields. Consistent formatting also improves extraction accuracy when you ask the model to parse results back into structured data.' },
        { q: 'Can I use this with custom API pipelines?', a: 'Yes. The JSON output mode produces a clean, parseable format that can be embedded directly into API request payloads. The formatted text output works with any LLM provider\'s text input endpoint.' },
        { q: 'Does compression lose information?', a: 'No. The formatting changes presentation, not content. All values are preserved exactly. Compression reduces whitespace, abbreviates headers, and removes redundant formatting while maintaining data fidelity.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <p itemprop="text" class="seo-faq-a">{item.a}</p>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  let currentType = 'Product';

  function extractProduct(text: string): object {
    const nameMatch  = text.match(/^(.+)/m);
    const priceMatch = text.match(/\$?\s*(\d[\d,]*(?:\.\d{1,2})?)/);
    const lines      = text.split('\n').filter(Boolean);
    return {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: nameMatch?.[1]?.trim() || 'Product Name',
      description: lines.slice(1, 3).join(' ').trim() || 'Product description',
      offers: {
        '@type': 'Offer',
        price: priceMatch?.[1]?.replace(',','') || '0.00',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock'
      }
    };
  }

  function extractFAQ(text: string): object {
    const qaPairs: { q: string; a: string }[] = [];
    const qRe = /[Qq]:\s*(.+)/g;
    const aRe = /[Aa]:\s*(.+)/g;
    const qs: string[] = [], as: string[] = [];
    let m: RegExpExecArray | null;
    while ((m = qRe.exec(text)) !== null) qs.push(m[1].trim());
    while ((m = aRe.exec(text)) !== null) as.push(m[1].trim());
    const count = Math.max(qs.length, as.length, 1);
    for (let i = 0; i < count; i++) {
      qaPairs.push({ q: qs[i] || `Question ${i+1}`, a: as[i] || 'Answer not detected — please fill in.' });
    }
    return {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: qaPairs.map(p => ({
        '@type': 'Question', name: p.q,
        acceptedAnswer: { '@type': 'Answer', text: p.a }
      }))
    };
  }

  function extractRecipe(text: string): object {
    const lines       = text.split('\n').filter(Boolean);
    const title       = lines[0]?.trim() || 'Recipe';
    const ingredients = lines.filter(l => /^\s*[-•*]|\d+\s+(cup|tbsp|tsp|g|oz|ml)/i.test(l)).map(l => l.replace(/^\s*[-•*]\s*/,'').trim());
    const steps       = lines.filter(l => /^\d+[.)]\s/.test(l)).map(l => l.replace(/^\d+[.)]\s*/,'').trim());
    const timeMatch   = text.match(/(\d+)\s*min/i);
    return {
      '@context': 'https://schema.org',
      '@type': 'Recipe',
      name: title,
      totalTime: timeMatch ? `PT${timeMatch[1]}M` : 'PT30M',
      recipeIngredient: ingredients.length ? ingredients : ['Ingredient list not detected — please edit'],
      recipeInstructions: steps.length
        ? steps.map((s, i) => ({ '@type': 'HowToStep', text: s, position: i + 1 }))
        : [{ '@type': 'HowToStep', text: 'Instructions not detected — please edit', position: 1 }]
    };
  }

  function generate() {
    const text = (document.getElementById('raw-text') as HTMLTextAreaElement).value.trim();
    let schema: object;
    if (currentType === 'Product')  schema = extractProduct(text);
    else if (currentType === 'FAQPage') schema = extractFAQ(text);
    else schema = extractRecipe(text);
    (document.getElementById('ld-output') as HTMLElement).textContent = JSON.stringify(schema, null, 2);
  }

  document.querySelectorAll('.schema-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentType = (btn as HTMLElement).dataset.type!;
      document.querySelectorAll('.schema-btn').forEach(b => {
        const isActive = b === btn;
        (b as HTMLButtonElement).style.background = isActive ? '#7C3AED' : 'var(--bg-surface-2)';
        (b as HTMLButtonElement).style.color      = isActive ? '#fff' : 'var(--text-secondary)';
        (b as HTMLButtonElement).style.border     = isActive ? 'none' : '1.5px solid var(--border)';
      });
      generate();
    });
  });

  document.getElementById('copy-ld')?.addEventListener('click', () => {
    const inner = (document.getElementById('ld-output') as HTMLElement).textContent || '';
    navigator.clipboard.writeText(`<script type="application/ld+json">\n${inner}\n<\/script>`);
    const btn = document.getElementById('copy-ld')!;
    btn.textContent = '✓ Copied'; setTimeout(() => { btn.textContent = 'Copy JSON-LD'; }, 1500);
  });

  document.getElementById('raw-text')?.addEventListener('input', generate);

  (document.getElementById('raw-text') as HTMLTextAreaElement).value =
    'Blue Wireless Noise-Cancelling Headphones\nPremium sound quality with 30-hour battery life. Foldable design for easy travel. $129.99. Available in black and blue.';
  generate();
</script>
