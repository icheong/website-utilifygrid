---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'pdf-ocr')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">OCR PDF</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Extract text from scanned PDFs using client-side OCR. Preview pages, run recognition, and download the extracted text.</p>

    <div id="drop-zone" style="border:2px dashed var(--border);border-radius:0.875rem;padding:2.5rem 1rem;text-align:center;cursor:pointer;transition:border-color 0.2s,background 0.2s;background:var(--bg-surface);">
      <p style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:0.4rem;">Drop a PDF file here</p>
      <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:0.75rem;">or click to browse</p>
      <input id="file-input" type="file" accept=".pdf" style="display:none;" />
      <button id="browse-btn" class="btn-secondary" type="button" style="font-size:0.82rem;">Browse File</button>
    </div>

    <div id="workspace" style="display:none;margin-top:1.25rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;flex-wrap:wrap;gap:0.5rem;">
        <p class="seo-p-sm" style="font-weight:600;">
          <span id="doc-name"></span> — <span id="doc-pages" style="font-weight:400;"></span>
        </p>
        <button id="reset-btn" class="btn-secondary" type="button" style="font-size:0.7rem;padding:0.25rem 0.6rem;">New File</button>
      </div>

      <div style="display:flex;gap:0.5rem;align-items:center;margin-bottom:1rem;flex-wrap:wrap;">
        <label style="font-size:0.78rem;color:var(--text-secondary);font-weight:600;">Language:</label>
        <select id="lang-select" class="select-themed" style="min-width:10rem;font-size:0.82rem;">
          <option value="eng" selected>English</option>
          <option value="fra">French</option>
          <option value="deu">German</option>
          <option value="spa">Spanish</option>
          <option value="ita">Italian</option>
          <option value="por">Portuguese</option>
          <option value="nld">Dutch</option>
          <option value="jpn">Japanese</option>
          <option value="chi_sim">Chinese (Simplified)</option>
          <option value="chi_tra">Chinese (Traditional)</option>
          <option value="kor">Korean</option>
        </select>
        <button id="ocr-btn" class="btn-primary" type="button" style="font-size:0.82rem;">Run OCR</button>
        <button id="download-txt-btn" class="btn-secondary" type="button" style="font-size:0.75rem;display:none;">Download .txt</button>
      </div>

      <div id="progress-wrap" style="display:none;margin-bottom:1rem;">
        <div style="display:flex;justify-content:space-between;margin-bottom:0.3rem;">
          <span id="progress-label" style="font-size:0.75rem;color:var(--text-secondary);">Processing…</span>
          <span id="progress-pct" style="font-size:0.75rem;color:var(--text-muted);">0%</span>
        </div>
        <div style="width:100%;height:6px;background:var(--bg-surface-2);border-radius:3px;overflow:hidden;">
          <div id="progress-bar" style="height:100%;width:0%;background:var(--color-brand-blue);border-radius:3px;transition:width 0.3s;"></div>
        </div>
      </div>

      <div id="ocr-results" style="display:flex;flex-direction:column;gap:1rem;"></div>

      <div id="full-text-wrap" style="display:none;margin-top:1.25rem;">
        <p class="tool-label" style="margin-bottom:0.5rem;">Extracted Text</p>
        <pre id="full-text" style="font-family:'Fira Code',monospace;font-size:0.82rem;padding:1rem;border-radius:.5rem;background:var(--bg-surface-2);color:var(--text-primary);max-height:400px;overflow:auto;white-space:pre-wrap;word-break:break-word;"></pre>
      </div>

      <p id="status" style="font-size:0.78rem;color:var(--text-muted);margin-top:0.75rem;display:none;"></p>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">OCR PDF Overview</h2>
    <p class="seo-p">
      This OCR PDF tool extracts text from scanned documents and image-based PDFs using client-side optical character recognition — entirely within your browser. Built with <strong>Tesseract.js</strong> (Google’s Tesseract OCR engine compiled to WebAssembly) and <strong>PDF.js</strong> (for page rendering), the tool provides complete privacy and zero server latency. Whether you are digitising paper contracts, extracting text from scanned receipts, or making archived documents searchable, the OCR is performed client-side with no file uploads.
    </p>
    <p class="seo-p">
      The tool supports 11 languages (English, French, German, Spanish, Italian, Portuguese, Dutch, Japanese, Chinese Simplified/Traditional, and Korean), renders each page at 2x scale for optimal recognition accuracy, and displays results both per-page and as a concatenated full document. The extracted text is downloadable as a plain text file.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        [`Document digitisation and archival`, `Organisations with large archives of paper documents — legal filings, medical records, historical manuscripts — need to convert scanned images into searchable text. This tool processes scanned PDFs page by page, extracting text that can be indexed, searched, and repurposed. The client-side processing ensures sensitive documents never leave the organisation’s network.`],
        [`Multi-language document processing`, `International businesses frequently handle documents in multiple languages — French contracts, German technical manuals, Japanese correspondence. The language selector lets you specify the document language for optimal recognition accuracy. Tesseract.js uses language-specific training data to recognise characters, ligatures, and common word patterns for each supported language.`],
        [`Receipt and invoice data extraction`, `Accounting teams extract text from scanned receipts and invoices to populate spreadsheets or accounting software. The OCR tool processes batches of receipt PDFs, outputting plain text that can be parsed for vendor names, dates, amounts, and line items. The downloadable .txt format integrates easily with data processing pipelines and text analysis tools.`]
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Technical Architecture and OCR Pipeline</h2>
    <p class="seo-p">
      The tool uses a two-library architecture: <strong>PDF.js</strong> (Mozilla’s PDF renderer) renders each page onto an HTML Canvas element at 2x scale (for optimal OCR accuracy), while <strong>Tesseract.js</strong> (Google’s Tesseract OCR engine compiled to WebAssembly) performs the actual character recognition on each page image. Both libraries execute entirely in the browser — no server round-trips occur at any stage.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step OCR Process</h3>
    <p class="seo-p-sm">
      <strong>1. File ingestion:</strong> When the user drops or selects a PDF file, the file is read as an <code class="inline-code">ArrayBuffer</code> using the File API. PDF.js parses the document and extracts the page count. The file data is held in browser memory — no network requests are made.
    </p>
    <p class="seo-p-sm">
      <strong>2. Page rendering:</strong> For each page, PDF.js renders the content onto a Canvas element at 2x scale (approximately 144 DPI). Higher scale factors improve OCR accuracy by providing more pixel data to the recognition engine. The rendered canvas is passed directly to Tesseract.js as an image source.
    </p>
    <p class="seo-p-sm">
      <strong>3. OCR recognition:</strong> Tesseract.js initialises the Tesseract OCR engine with the selected language training data (downloaded once from a CDN and cached in the browser). It processes each page image through three stages: image pre-processing (thresholding, noise removal), character segmentation (identifying individual characters), and character recognition (matching segments to known character patterns).
    </p>
    <p class="seo-p-sm">
      <strong>4. Text extraction:</strong> The recognised text from each page is stored in an array and displayed in the UI. A progress bar tracks the OCR status across all pages. The full text is concatenated with page break markers and displayed in a scrollable pre element.
    </p>
    <p class="seo-p-none">
      <strong>Output formats:</strong> The extracted text is available for copying from the UI or downloading as a plain text (.txt) file. Each page is separated by a page break marker for easy parsing. The tool does not create searchable PDFs — it outputs raw text only.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "Is my file uploaded for OCR?",
          a: "No. Tesseract.js runs entirely in your browser via WebAssembly. Your PDF never leaves your device — there is no server upload at any point. The OCR engine is downloaded once and cached locally for subsequent use."
        },
        {
          q: "How accurate is the OCR?",
          a: "Accuracy depends on scan quality, resolution, and language. Clean, high-resolution scans (300 DPI or higher) in English typically achieve 95%+ accuracy. Handwritten text, low-resolution scans, or documents with complex layouts may have lower accuracy. The tool renders pages at 2x scale to maximise recognition quality."
        },
        {
          q: "What languages are supported?",
          a: "The tool supports 11 languages: English, French, German, Spanish, Italian, Portuguese, Dutch, Japanese, Chinese (Simplified and Traditional), and Korean. Each language requires its own training data, which is downloaded from a CDN on first use and cached in the browser."
        },
        {
          q: "Does OCR create a searchable PDF?",
          a: "This tool extracts text as plain text (.txt format). To create a searchable PDF with text overlay, you would need to position the extracted text over the original images at the correct coordinates, which requires additional processing not included in this tool."
        },
        {
          q: "How long does OCR take?",
          a: "Processing time depends on the number of pages, page complexity, and your device’s processing power. A typical 10-page document takes 30-60 seconds. The progress bar shows the current page and overall percentage. Each page is processed sequentially to manage memory usage."
        },
        {
          q: "Can I OCR password-protected PDFs?",
          a: "This tool can process PDFs that open without a password. PDFs requiring a user password to open cannot be processed because PDF.js cannot render the pages for OCR without first decrypting the document."
        },
        {
          q: "What text formatting is preserved?",
          a: "The OCR output is plain text — formatting such as bold, italic, font sizes, and column layouts are not preserved. The tool extracts the raw character sequence from each page. For complex layouts with multiple columns, the text may flow across column boundaries. Use the per-page results to manually reorder text if needed."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script is:inline src="https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script is:inline src="https://unpkg.com/tesseract.js@5/dist/tesseract.min.js"></script>

<script>
(function () {
  const pdfjsLib = (window as any).pdfjsLib;
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
  const Tesseract = (window as any).Tesseract;

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const browseBtn = document.getElementById('browse-btn')!;
  const workspace = document.getElementById('workspace')!;
  const docName = document.getElementById('doc-name')!;
  const docPages = document.getElementById('doc-pages')!;
  const resetBtn = document.getElementById('reset-btn')!;
  const langSelect = document.getElementById('lang-select') as HTMLSelectElement;
  const ocrBtn = document.getElementById('ocr-btn')!;
  const downloadTxtBtn = document.getElementById('download-txt-btn')!;
  const progressWrap = document.getElementById('progress-wrap')!;
  const progressLabel = document.getElementById('progress-label')!;
  const progressPct = document.getElementById('progress-pct')!;
  const progressBar = document.getElementById('progress-bar')!;
  const ocrResults = document.getElementById('ocr-results')!;
  const fullTextWrap = document.getElementById('full-text-wrap')!;
  const fullText = document.getElementById('full-text')!;
  const statusEl = document.getElementById('status')!;

  let pdfDoc: any = null;
  let totalPages = 0;
  let allText: string[] = [];

  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.style.borderColor = 'var(--color-brand-blue)'; });
  dropZone.addEventListener('dragleave', () => { dropZone.style.borderColor = ''; });
  dropZone.addEventListener('drop', e => { e.preventDefault(); dropZone.style.borderColor = ''; if (e.dataTransfer!.files.length) loadFile(e.dataTransfer!.files[0]); });
  browseBtn.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('click', e => { if (e.target === dropZone || e.target === browseBtn) fileInput.click(); });
  fileInput.addEventListener('change', () => { if (fileInput.files.length) loadFile(fileInput.files[0]); fileInput.value = ''; });
  resetBtn.addEventListener('click', () => { pdfDoc = null; allText = []; workspace.style.display = 'none'; dropZone.style.display = ''; });

  async function loadFile(file: File) {
    if (file.type !== 'application/pdf') return;
    const buf = await file.arrayBuffer();
    pdfDoc = await pdfjsLib.getDocument({ data: buf }).promise;
    totalPages = pdfDoc.numPages;
    docName.textContent = file.name.replace(/\.pdf$/i, '');
    docPages.textContent = totalPages + ' page' + (totalPages > 1 ? 's' : '');
    allText = new Array(totalPages).fill('');
    dropZone.style.display = 'none';
    workspace.style.display = '';
    fullTextWrap.style.display = 'none';
    downloadTxtBtn.style.display = 'none';
    ocrResults.innerHTML = '';
    for (let i = 1; i <= totalPages; i++) {
      const page = await pdfDoc.getPage(i);
      const viewport = page.getViewport({ scale: 0.3 });
      const canvas = document.createElement('canvas');
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      canvas.style.cssText = 'width:90px;height:auto;border:1px solid var(--border);border-radius:4px;background:#fff;';
      await page.render({ canvasContext: canvas.getContext('2d')!, viewport }).promise;
      const wrap = document.createElement('div');
      wrap.style.cssText = 'text-align:center;flex-shrink:0;';
      const num = document.createElement('div');
      num.style.cssText = 'font-size:0.6rem;color:var(--text-muted);margin-top:0.15rem;';
      num.textContent = 'P.' + i;
      wrap.appendChild(canvas);
      wrap.appendChild(num);
      ocrResults.appendChild(wrap);
    }
  }

  ocrBtn.addEventListener('click', async () => {
    if (!pdfDoc) return;
    ocrBtn.setAttribute('disabled', '');
    ocrBtn.textContent = 'Running\u2026';
    progressWrap.style.display = '';
    fullTextWrap.style.display = 'none';
    downloadTxtBtn.style.display = 'none';
    allText = new Array(totalPages).fill('');

    const lang = langSelect.value;

    for (let i = 1; i <= totalPages; i++) {
      progressLabel.textContent = `Page ${i} of ${totalPages}`;
      const pct = Math.round(((i - 1) / totalPages) * 100);
      progressPct.textContent = pct + '%';
      progressBar.style.width = pct + '%';

      const page = await pdfDoc.getPage(i);
      const viewport = page.getViewport({ scale: 2 });
      const canvas = document.createElement('canvas');
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      await page.render({ canvasContext: canvas.getContext('2d')!, viewport }).promise;

      try {
        const result = await Tesseract.recognize(canvas, lang, {});
        allText[i - 1] = result.data.text.trim();
      } catch { allText[i - 1] = '[OCR failed for this page]'; }
    }

    progressPct.textContent = '100%';
    progressBar.style.width = '100%';
    progressLabel.textContent = 'Complete';

    fullTextWrap.style.display = '';
    downloadTxtBtn.style.display = '';
    fullText.textContent = allText.join('\n\n--- Page Break ---\n\n');
    statusEl.style.display = ''; statusEl.style.color = '#10B981';
    statusEl.textContent = `OCR complete. Extracted text from ${totalPages} page${totalPages > 1 ? 's' : ''}.`;

    ocrBtn.removeAttribute('disabled');
    ocrBtn.textContent = 'Run OCR';
  });

  downloadTxtBtn.addEventListener('click', () => {
    const blob = new Blob([fullText.textContent || ''], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = (docName.textContent || 'ocr') + '.txt'; a.click();
    URL.revokeObjectURL(url);
  });
})();
</script>
