---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'pdf-organize')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">Organize PDF</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Drag pages to reorder, click to duplicate or remove — visual workspace for your PDF.</p>

    <div id="drop-zone" style="border:2px dashed var(--border);border-radius:0.875rem;padding:2.5rem 1rem;text-align:center;cursor:pointer;transition:border-color 0.2s,background 0.2s;background:var(--bg-surface);">
      <p style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:0.4rem;">Drop a PDF file here</p>
      <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:0.75rem;">or click to browse</p>
      <input id="file-input" type="file" accept=".pdf" style="display:none;" />
      <button id="browse-btn" class="btn-secondary" type="button" style="font-size:0.82rem;">Browse File</button>
    </div>

    <div id="workspace" style="display:none;margin-top:1.25rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
        <p class="seo-p-sm" style="font-weight:600;">
          <span id="doc-name"></span> — <span id="doc-pages" style="font-weight:400;"></span>
        </p>
        <div style="display:flex;gap:0.5rem;">
          <button id="undo-btn" class="btn-secondary" type="button" style="font-size:0.7rem;padding:0.25rem 0.6rem;" disabled>Undo</button>
          <button id="reset-btn" class="btn-secondary" type="button" style="font-size:0.7rem;padding:0.25rem 0.6rem;">New File</button>
        </div>
      </div>
      <div id="pages-grid" style="display:flex;flex-wrap:wrap;gap:0.6rem;"></div>
      <div style="margin-top:1.25rem;text-align:center;">
        <button id="download-btn" class="btn-primary" type="button" style="font-size:0.95rem;padding:0.7rem 2rem;">Download Organized PDF</button>
        <p id="status" style="font-size:0.78rem;color:var(--text-muted);margin-top:0.5rem;display:none;"></p>
      </div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Organize PDF Overview</h2>
    <p class="seo-p">
      This PDF organize tool gives you a visual drag-and-drop workspace to reorder, duplicate, and delete pages within a PDF document — entirely within your browser. Built with <strong>pdf-lib</strong> (for page manipulation) and <strong>PDF.js</strong> (for thumbnail rendering), both running via WebAssembly and Canvas, the tool provides complete privacy and zero server latency. Whether you are rearranging chapters in a report, removing unwanted pages from a scan, or duplicating key pages for a presentation, the organize operation is performed client-side with full lossless quality preservation.
    </p>
    <p class="seo-p">
      Every page is rendered as a thumbnail card with drag-and-drop reordering, inline duplicate and delete buttons, and an undo stack for reverting changes. The page count updates dynamically as you modify the document. The final download produces a new PDF with pages in your specified order, preserving all original content byte-for-byte.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        [`Report and document restructuring`, `Business teams frequently receive reports where sections are out of order — for example, a quarterly review with the appendix before the executive summary. The drag-and-drop interface lets you visually rearrange pages into the correct sequence without technical knowledge. The undo button provides safety for experimentation, and the page count updates in real time as you work.`],
        [`Scan cleanup and page removal`, `When scanning physical documents, blank pages, upside-down scans, or duplicate captures are common. The delete button removes unwanted pages instantly, and the duplicate button lets you replicate key pages (e.g., a signature page that needs to appear in multiple sections). The thumbnail preview helps you identify which pages to keep or remove before committing to the download.`],
        [`Presentation and handout assembly`, `Trainers and presenters assemble custom handouts by combining specific pages from multiple source PDFs. After merging source documents with the PDF merge tool, this organize tool lets you reorder the combined pages into the correct presentation sequence, remove irrelevant pages, and duplicate frequently referenced pages. The visual workspace makes it easy to see the final document flow before downloading.`]
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Technical Architecture and Organize Process</h2>
    <p class="seo-p">
      The tool uses a two-library architecture: <strong>PDF.js</strong> (Mozilla's PDF renderer) handles page thumbnail rendering by drawing each page onto an HTML Canvas element, while <strong>pdf-lib</strong> (a lightweight PDF manipulation library) performs the actual reorganisation by copying page objects from the source document into a new document in the specified order. Both libraries execute entirely in the browser via WebAssembly — no server round-trips occur at any stage.
    </p>

    <h3 class="font-display seo-h3-sm">Step-by-Step Organize Process</h3>
    <p class="seo-p-sm">
      <strong>1. File ingestion:</strong> When the user drops or selects a PDF file, the file is read as an <code class="inline-code">ArrayBuffer</code> using the File API. The file data is held in browser memory — no network requests are made. Each page is assigned a unique ID and an initial index mapping to the source document.
    </p>
    <p class="seo-p-sm">
      <strong>2. Thumbnail generation:</strong> PDF.js renders every page at 30% scale onto temporary Canvas elements, converting them to inline thumbnail cards. Each card displays a numbered badge, a drag handle, and duplicate/delete action buttons. The visual workspace provides instant feedback without uploading anything.
    </p>
    <p class="seo-p-sm">
      <strong>3. Drag-and-drop reordering:</strong> The page grid uses HTML5 Drag and Drop API. When a page card is dropped onto a new position, the internal items array is spliced and re-ordered. The grid re-renders to reflect the new sequence with updated page numbers. An undo stack (up to 50 levels) records each action for reverting.
    </p>
    <p class="seo-p-sm">
      <strong>4. Duplicate and delete:</strong> The duplicate button inserts a copy of the page (with a new unique ID) immediately after the current position. The delete button removes the page from the items array. Both operations trigger a history snapshot for undo support. The page count label updates dynamically.
    </p>
    <p class="seo-p-none">
      <strong>5. Download execution:</strong> When the user clicks "Download Organized PDF", pdf-lib creates a new empty <code class="inline-code">PDFDocument</code>. For each item in the items array, it copies the corresponding page from the source document using <code class="inline-code">copyPages()</code>, applies any rotation, and adds it to the new document. The merged PDF is serialised to bytes and offered as a download via a Blob URL.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "Is my file uploaded to a server?",
          a: "No. All processing happens entirely in your browser using WebAssembly (pdf-lib) and Canvas (PDF.js). Your file never leaves your device — there is no server upload at any point. This provides complete privacy for confidential documents."
        },
        {
          q: "Can I undo changes?",
          a: "Yes. Click the Undo button to revert the last action (reorder, duplicate, or delete). The undo stack stores up to 50 levels of history, so you can undo multiple times to restore earlier states."
        },
        {
          q: "Does organizing reduce PDF quality?",
          a: "No. Pages are copied losslessly — text, vectors, images, and bookmarks are preserved byte-for-byte. There is no re-encoding, recompression, or rasterisation. The organized PDF has exactly the same visual quality as the original."
        },
        {
          q: "Can I duplicate the same page multiple times?",
          a: "Yes. Each click of the Duplicate button creates an independent copy of the page. You can duplicate a page as many times as needed — for example, to include a signature page in multiple sections of a document."
        },
        {
          q: "Is there a limit to how many pages I can organize?",
          a: "There is no artificial limit. You can organize PDFs with any number of pages. However, very large documents (hundreds of pages) may slow down thumbnail rendering because PDF.js must draw each page onto a Canvas element. Most devices handle 100-200 pages comfortably."
        },
        {
          q: "Can I rotate pages while organizing?",
          a: "The current interface focuses on reordering, duplicating, and deleting pages. Page rotation is applied during the download step if any rotation metadata exists in the source PDF. For dedicated rotation operations, use the separate Rotate PDF tool."
        },
        {
          q: "What happens to bookmarks and annotations?",
          a: "Bookmarks and annotations from the source PDF are preserved where the source structure allows. However, because the organize operation creates a new PDF document, the bookmark hierarchy may need manual adjustment in a dedicated PDF editor if you require a unified table of contents."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
<script is:inline src="https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.min.js"></script>

<script>
(function () {
  const { PDFDocument } = (window as any).PDFLib;
  const pdfjsLib = (window as any).pdfjsLib;
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.worker.min.js';

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const browseBtn = document.getElementById('browse-btn')!;
  const workspace = document.getElementById('workspace')!;
  const docName = document.getElementById('doc-name')!;
  const docPages = document.getElementById('doc-pages')!;
  const resetBtn = document.getElementById('reset-btn')!;
  const undoBtn = document.getElementById('undo-btn')!;
  const downloadBtn = document.getElementById('download-btn')!;
  const pagesGrid = document.getElementById('pages-grid')!;
  const statusEl = document.getElementById('status')!;

  type PageItem = { id: number; srcPageIndex: number; rotation: number; };
  let items: PageItem[] = [];
  let history: PageItem[][] = [];
  let nextId = 0;
  let pdfBytes: ArrayBuffer | null = null;
  let pdfDoc: any = null;
  let totalPages = 0;
  let draggedItem: number | null = null;

  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.style.borderColor = 'var(--color-brand-blue)'; });
  dropZone.addEventListener('dragleave', () => { dropZone.style.borderColor = ''; });
  dropZone.addEventListener('drop', e => { e.preventDefault(); dropZone.style.borderColor = ''; if (e.dataTransfer!.files.length) loadFile(e.dataTransfer!.files[0]); });
  browseBtn.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('click', e => { if (e.target === dropZone || e.target === browseBtn) fileInput.click(); });
  fileInput.addEventListener('change', () => { if (fileInput.files.length) loadFile(fileInput.files[0]); fileInput.value = ''; });
  resetBtn.addEventListener('click', () => { pdfBytes = null; pdfDoc = null; items = []; history = []; workspace.style.display = 'none'; dropZone.style.display = ''; });
  undoBtn.addEventListener('click', () => { if (history.length) { items = history.pop()!; renderPages(); } });

  async function loadFile(file: File) {
    if (file.type !== 'application/pdf') return;
    pdfBytes = await file.arrayBuffer();
    pdfDoc = await pdfjsLib.getDocument({ data: pdfBytes.slice(0) }).promise;
    totalPages = pdfDoc.numPages;
    docName.textContent = file.name.replace(/\.pdf$/i, '');
    docPages.textContent = totalPages + ' page' + (totalPages > 1 ? 's' : '');
    items = [];
    history = [];
    for (let i = 0; i < totalPages; i++) items.push({ id: nextId++, srcPageIndex: i, rotation: 0 });
    dropZone.style.display = 'none';
    workspace.style.display = '';
    renderPages();
  }

  function saveHistory() { history.push(items.map(i => ({ ...i }))); if (history.length > 50) history.shift(); undoBtn.disabled = history.length === 0; }

  async function renderPages() {
    pagesGrid.innerHTML = '';
    docPages.textContent = items.length + ' page' + (items.length !== 1 ? 's' : '');
    for (let idx = 0; idx < items.length; idx++) {
      const item = items[idx];
      const page = await pdfDoc.getPage(item.srcPageIndex + 1);
      const viewport = page.getViewport({ scale: 0.3 });
      const canvas = document.createElement('canvas');
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      canvas.style.cssText = 'width:110px;height:auto;border:2px solid var(--border);border-radius:6px;cursor:grab;transition:border-color 0.15s,box-shadow 0.15s;background:#fff;';
      await page.render({ canvasContext: canvas.getContext('2d')!, viewport }).promise;

      const wrap = document.createElement('div');
      wrap.className = 'page-card';
      wrap.draggable = true;
      wrap.dataset.idx = String(idx);
      wrap.style.cssText = 'position:relative;flex-shrink:0;text-align:center;';

      const numBadge = document.createElement('div');
      numBadge.style.cssText = 'position:absolute;top:-6px;left:-6px;background:var(--color-brand-blue);color:#fff;font-size:0.6rem;font-weight:700;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;z-index:2;';
      numBadge.textContent = String(idx + 1);

      const btnRow = document.createElement('div');
      btnRow.style.cssText = 'display:flex;gap:0.25rem;justify-content:center;margin-top:0.3rem;';

      const dupBtn = document.createElement('button');
      dupBtn.className = 'btn-secondary';
      dupBtn.type = 'button';
      dupBtn.style.cssText = 'font-size:0.6rem;padding:0.15rem 0.4rem;';
      dupBtn.textContent = '⧉ Duplicate';
      dupBtn.addEventListener('click', e => { e.stopPropagation(); saveHistory(); items.splice(idx + 1, 0, { ...item, id: nextId++ }); renderPages(); });

      const delBtn = document.createElement('button');
      delBtn.className = 'btn-secondary';
      delBtn.type = 'button';
      delBtn.style.cssText = 'font-size:0.6rem;padding:0.15rem 0.4rem;color:#EF4444;';
      delBtn.textContent = '✕ Delete';
      delBtn.addEventListener('click', e => { e.stopPropagation(); saveHistory(); items.splice(idx, 1); renderPages(); });

      btnRow.appendChild(dupBtn);
      btnRow.appendChild(delBtn);
      wrap.appendChild(numBadge);
      wrap.appendChild(canvas);
      wrap.appendChild(btnRow);

      wrap.addEventListener('dragstart', e => { draggedItem = idx; canvas.style.opacity = '0.4'; e.dataTransfer!.effectAllowed = 'move'; });
      wrap.addEventListener('dragend', () => { draggedItem = null; canvas.style.opacity = ''; pagesGrid.querySelectorAll('.page-card').forEach(c => (c.firstChild as HTMLElement).style.borderColor = 'var(--border)'); });
      wrap.addEventListener('dragover', e => { e.preventDefault(); e.dataTransfer!.dropEffect = 'move'; (canvas).style.borderColor = 'var(--color-brand-blue)'; });
      wrap.addEventListener('dragleave', () => { canvas.style.borderColor = 'var(--border)'; });
      wrap.addEventListener('drop', e => {
        e.preventDefault();
        canvas.style.borderColor = 'var(--border)';
        if (draggedItem === null || draggedItem === idx) return;
        saveHistory();
        const [moved] = items.splice(draggedItem, 1);
        items.splice(idx, 0, moved);
        renderPages();
      });

      pagesGrid.appendChild(wrap);
    }
    undoBtn.disabled = history.length === 0;
  }

  downloadBtn.addEventListener('click', async () => {
    if (!items.length) return;
    downloadBtn.setAttribute('disabled', '');
    downloadBtn.textContent = 'Building…';
    try {
      const srcDoc = await PDFDocument.load(pdfBytes!);
      const newDoc = await PDFDocument.create();
      for (const item of items) {
        const [copied] = await newDoc.copyPages(srcDoc, [item.srcPageIndex]);
        if (item.rotation) copied.setRotation(item.rotation);
        newDoc.addPage(copied);
      }
      const bytes = await newDoc.save();
      const blob = new Blob([bytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = 'organized.pdf'; a.click();
      URL.revokeObjectURL(url);
      statusEl.style.display = ''; statusEl.style.color = '#10B981'; statusEl.textContent = 'Downloaded organized.pdf (' + items.length + ' pages).';
    } catch (e: any) { statusEl.style.display = ''; statusEl.style.color = '#EF4444'; statusEl.textContent = 'Error: ' + e.message; }
    finally { downloadBtn.removeAttribute('disabled'); downloadBtn.textContent = 'Download Organized PDF'; }
  });
})();
</script>
