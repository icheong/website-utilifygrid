---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'torque-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Torque Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="nm">Newton Meter (N·m)</option>
          <option value="knm">Kilonewton Meter (kN·m)</option>
          <option value="dynm">Dyne Meter (dyn·m)</option>
          <option value="kgcm">Kilogram-Force Centimeter (kgf·cm)</option>
          <option value="kgm">Kilogram-Force Meter (kgf·m)</option>
          <option value="ozin">Ounce-Force Inch (ozf·in)</option>
          <option value="lbin">Pound-Force Inch (lbf·in)</option>
          <option value="lbft">Pound-Force Foot (lbf·ft)</option>
          <option value="pdlft">Poundal Foot (pdl·ft)</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Torque Converter</h2>
    <p class="seo-p">Enter a torque value, pick your source unit, and instantly see the converted result across all supported units.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Enter Torque Value</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Type the torque amount into the numeric input field and select the correct source unit from the dropdown.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Select Target Unit</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Choose the unit you want to convert to from the dropdown menu. The converter supports SI, metric gravitational, and imperial torque units.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">View Results</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">The converted value appears instantly, along with every equivalent unit displayed in the results grid for quick comparison.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Copy or Swap</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Click the Copy button next to any result to copy it to your clipboard, or change the source unit to swap the conversion direction.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Torque Converter Works</h2>
    <p class="seo-p">The converter normalizes every torque unit to a common base, applies the exact conversion ratio, and outputs the result — all client-side in your browser.</p>
    <h3 class="font-display seo-h3-sm">Torque Unit Definitions</h3>
    <p class="seo-p">The <code class="inline-code">Newton meter (N·m)</code> is the SI derived unit of torque, representing one newton of force applied at a lever arm of one meter. <code class="inline-code">Foot-pounds (lbf·ft)</code> express torque in imperial units as one pound-force applied at a one-foot lever arm. <code class="inline-code">Inch-pounds (lbf·in)</code> scale that down to an inch lever arm, useful for smaller fasteners. <code class="inline-code">Kilogram-force centimeter (kgf·cm)</code> uses gravitational force at one kilogram applied at one centimeter, common in Japanese and European automotive specs.</p>
    <h3 class="font-display seo-h3-sm">Conversion Factor Mathematics</h3>
    <p class="seo-p">Each unit stores a factor relative to <code class="inline-code">N·m</code>. Converting from unit A to unit B follows the formula: <code class="inline-code">Result = Input × (FactorA / FactorB)</code>. For example, converting 100 lbf·ft to N·m computes <code class="inline-code">100 × (1.355818 / 1) = 135.5818 N·m</code>. All nine supported units convert through this single-ratio approach with no intermediate rounding.</p>
    <h3 class="font-display seo-h3-sm">Precision and Rounding</h3>
    <p class="seo-p">Results use adaptive decimal formatting: large values display up to two decimal places, mid-range values show up to six, and small values render up to ten decimal places. Values outside the 10⁻⁶ to 10⁹ range switch to scientific notation with four significant figures, ensuring readability across all scales.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between N·m and lbf·ft?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Newton meters (N·m) are the SI unit of torque, using metric force and distance. Pound-feet (lbf·ft) are the imperial equivalent, using pound-force and feet. One lbf·ft equals approximately 1.35582 N·m, so imperial torque values are numerically smaller than their metric counterparts.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Which torque unit is used for car engine specifications?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Most manufacturers list engine torque in Newton meters (N·m) in metric markets and pound-feet (lbf·ft) in the United States. Japanese and European specs may also use kilogram-force meters (kgf·m). This converter supports all common automotive torque units so you can compare specs across regions.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I convert between metric and imperial torque units?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">To convert metric to imperial, multiply the N·m value by the appropriate factor — for example, divide by 1.355818 to get lbf·ft. To convert imperial to metric, multiply by the inverse factor. This tool handles the math automatically for all unit pairs without manual calculation.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between lbf·ft and pdl·ft?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Foot-pounds force (lbf·ft) use one pound-force applied at a one-foot lever arm, while foot-poundals (pdl·ft) use the smaller poundal unit of force. One lbf·ft equals approximately 32.174 pdl·ft, so poundal-foot values are significantly larger numerically. The poundal system is rarely used outside physics textbooks.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why does this converter support so many torque units?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Different industries and regions prefer different torque units. Automotive shops use lbf·ft or N·m, aerospace engineers may work in in-lb, and physics problems sometimes reference dyn·m or pdl·ft. Supporting all nine common units means you can convert between any pair without looking up conversion tables.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Is this torque converter accurate enough for engineering calculations?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes. The converter uses high-precision conversion factors stored as floating-point values and applies them with no intermediate rounding. Results display up to ten decimal places for small values, ensuring sufficient precision for engineering, automotive, and physics applications.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'nm',    label: 'Newton Meter (N·m)',              abbr: 'N·m',    factor: 1 },
    { id: 'knm',   label: 'Kilonewton Meter (kN·m)',         abbr: 'kN·m',   factor: 1000 },
    { id: 'dynm',  label: 'Dyne Meter (dyn·m)',              abbr: 'dyn·m',  factor: 1e-7 },
    { id: 'kgcm',  label: 'Kilogram-Force Centimeter (kgf·cm)', abbr: 'kgf·cm', factor: 0.0980665 },
    { id: 'kgm',   label: 'Kilogram-Force Meter (kgf·m)',    abbr: 'kgf·m',  factor: 0.980665 },
    { id: 'ozin',  label: 'Ounce-Force Inch (ozf·in)',        abbr: 'ozf·in', factor: 0.00706155 },
    { id: 'lbin',  label: 'Pound-Force Inch (lbf·in)',        abbr: 'lbf·in', factor: 0.1129848 },
    { id: 'lbft',  label: 'Pound-Force Foot (lbf·ft)',        abbr: 'lbf·ft', factor: 1.355818 },
    { id: 'pdlft', label: 'Poundal Foot (pdl·ft)',            abbr: 'pdl·ft', factor: 0.04214011 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
