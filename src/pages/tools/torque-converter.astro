---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'torque-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Torque Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="nm">Newton Meter (N·m)</option>
          <option value="knm">Kilonewton Meter (kN·m)</option>
          <option value="dynm">Dyne Meter (dyn·m)</option>
          <option value="kgcm">Kilogram-Force Centimeter (kgf·cm)</option>
          <option value="kgm">Kilogram-Force Meter (kgf·m)</option>
          <option value="ozin">Ounce-Force Inch (ozf·in)</option>
          <option value="lbin">Pound-Force Inch (lbf·in)</option>
          <option value="lbft">Pound-Force Foot (lbf·ft)</option>
          <option value="pdlft">Poundal Foot (pdl·ft)</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Torque Converter</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      Enter a <strong>numeric value</strong> and select its <strong>unit</strong> from the dropdown. All other torque units update instantly — no buttons to click.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">
      The converter covers <strong>SI</strong> torque units (N·m, kN·m, dyn·m), <strong>metric gravitational</strong> units (kgf·cm, kgf·m), and <strong>imperial</strong> units (ozf·in, lbf·in, lbf·ft, pdl·ft). Results use high-precision conversion factors so engineering calculations stay accurate.
    </p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">
      Click any <strong>Copy</strong> button to copy that unit's result to your clipboard — handy for pasting into documents, code, or messages.
    </p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How torque conversions work</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.875rem;">
      All conversions go through <strong>Newton meters (N·m)</strong> as the base unit. Each unit has a fixed factor relative to one N·m:
    </p>
    <pre style="font-family:'Fira Code',monospace;font-size:.85rem;padding:1rem;border-radius:.5rem;background:var(--bg-surface-2);color:var(--text-primary);overflow-x:auto;white-space:pre-wrap;">1 kN·m     = 1000 N·m
1 dyn·m    = 1e-7 N·m
1 kgf·cm   = 0.0980665 N·m
1 kgf·m    = 0.980665 N·m
1 ozf·in   = 0.00706155 N·m
1 lbf·in   = 0.1129848 N·m
1 lbf·ft   = 1.355818 N·m
1 pdl·ft   = 0.04214011 N·m

Result = Input × (FromFactor / ToFactor)</pre>
    <p style="color:var(--text-secondary); font-size:0.85rem; line-height:1.75;">
      Torque is the rotational equivalent of force — it measures how much a force acting on an object causes that object to rotate. All calculations run in your browser — no data is sent anywhere.
    </p>
  </div>

  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is torque?",
          "acceptedAnswer": { "@type": "Answer", "text": "Torque is a measure of rotational force — it describes how much a force acting on an object causes that object to rotate about an axis. It is commonly expressed in Newton meters (N·m) or pound-feet (lbf·ft). Torque is a key specification for engines, motors, and fasteners." }
        },
        {
          "@type": "Question",
          "name": "How do you convert N·m to lbf·ft?",
          "acceptedAnswer": { "@type": "Answer", "text": "To convert Newton meters to pound-force feet, divide by approximately 1.35582. For example, 100 N·m × (1 / 1.355818) ≈ 73.76 lbf·ft. This converter does the math automatically for you." }
        },
        {
          "@type": "Question",
          "name": "What unit is used for car engine torque?",
          "acceptedAnswer": { "@type": "Answer", "text": "Car engine torque is typically expressed in Newton meters (N·m) in metric countries and pound-feet (lbf·ft) in the United States. Some manufacturers also use kilogram-force meters (kgf·m). This converter handles all common automotive torque units." }
        }
      ]
    }
    </script>

    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What is torque?', a: 'Torque is a measure of rotational force — it describes how much a force acting on an object causes that object to rotate about an axis. It is commonly expressed in Newton meters (N·m) or pound-feet (lbf·ft). Torque is a key specification for engines, motors, and fasteners.' },
        { q: 'How do you convert N·m to lbf·ft?', a: 'To convert Newton meters to pound-force feet, divide by approximately 1.35582. For example, 100 N·m × (1 / 1.355818) ≈ 73.76 lbf·ft. This converter does the math automatically for you.' },
        { q: 'What unit is used for car engine torque?', a: 'Car engine torque is typically expressed in Newton meters (N·m) in metric countries and pound-feet (lbf·ft) in the United States. Some manufacturers also use kilogram-force meters (kgf·m). This converter handles all common automotive torque units.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          style="background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.875rem; padding:1.1rem 1.25rem;">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'nm',    label: 'Newton Meter (N·m)',              abbr: 'N·m',    factor: 1 },
    { id: 'knm',   label: 'Kilonewton Meter (kN·m)',         abbr: 'kN·m',   factor: 1000 },
    { id: 'dynm',  label: 'Dyne Meter (dyn·m)',              abbr: 'dyn·m',  factor: 1e-7 },
    { id: 'kgcm',  label: 'Kilogram-Force Centimeter (kgf·cm)', abbr: 'kgf·cm', factor: 0.0980665 },
    { id: 'kgm',   label: 'Kilogram-Force Meter (kgf·m)',    abbr: 'kgf·m',  factor: 0.980665 },
    { id: 'ozin',  label: 'Ounce-Force Inch (ozf·in)',        abbr: 'ozf·in', factor: 0.00706155 },
    { id: 'lbin',  label: 'Pound-Force Inch (lbf·in)',        abbr: 'lbf·in', factor: 0.1129848 },
    { id: 'lbft',  label: 'Pound-Force Foot (lbf·ft)',        abbr: 'lbf·ft', factor: 1.355818 },
    { id: 'pdlft', label: 'Poundal Foot (pdl·ft)',            abbr: 'pdl·ft', factor: 0.04214011 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
