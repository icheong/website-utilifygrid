---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'fuel-efficiency-mass-converter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:0.25rem;">Fuel Efficiency — Mass Converter</h2>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:1.25rem;">Enter a value in any unit — see the conversion in all others instantly.</p>

    <div style="display:grid;grid-template-columns:1fr auto;gap:0.75rem;align-items:end;margin-bottom:1.5rem;">
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="inp">Value</label>
        <input id="inp" type="number" value="1" min="0" step="any" placeholder="Enter value" class="input-themed" style="font-family:'Fira Code',monospace;font-weight:600;font-size:1.1rem;" />
      </div>
      <div>
        <label style="display:block;font-size:0.75rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;" for="sel">Unit</label>
        <select id="sel" class="select-themed" style="min-width:10rem;">
          <option value="kmkg">Kilometer per Kilometer (km/kg)</option>
          <option value="mkg">Meter per Kilogram (m/kg)</option>
          <option value="milb">Mile per Pound (mi/lb)</option>
          <option value="nmikg">Nautical Mile per Kilometer (nmi/kg)</option>
        </select>
      </div>
    </div>

    <div id="results" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.5rem;"></div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to Use the Fuel Efficiency — Mass Converter</h2>
    <p class="seo-p">Enter a fuel economy value and instantly see it converted across all supported mass-based units.</p>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Enter Fuel Economy Value</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Type your fuel economy number into the input field and select the source unit from the dropdown menu.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Select Target Unit</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Choose the mass-based fuel economy unit you want to convert to — km/kg, m/kg, mi/lb, or nmi/kg.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">View All Conversions</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">See your value displayed in every supported mass-based unit simultaneously, updated in real time.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Copy Result</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Click the Copy button next to any result to copy that value to your clipboard for use in documents, code, or messages.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">How the Fuel Efficiency — Mass Converter Works</h2>
    <p class="seo-p">This tool converts between different ways of expressing fuel economy as distance traveled per unit of fuel mass.</p>
    <h3 class="font-display seo-h3-sm">Mass-Based Fuel Economy Units</h3>
    <p class="seo-p">Common mass-based units include <code class="inline-code">km/kg</code> (kilometers per kilogram, used in aviation and military contexts), <code class="inline-code">mi/lb</code> (miles per pound, used in some industrial applications), and <code class="inline-code">nmi/kg</code> (nautical miles per kilogram, used in maritime and naval operations). The base unit <code class="inline-code">m/kg</code> (meters per kilogram) provides a standard reference for all conversions.</p>
    <h3 class="font-display seo-h3-sm">Conversion Mathematics</h3>
    <p class="seo-p">All conversions go through <code class="inline-code">m/kg</code> as the base unit. Each unit has a fixed factor relative to one m/kg. The formula is: Result = Input × (FromFactor / ToFactor). Because fuel economy is the inverse of fuel consumption, higher values indicate better efficiency — the vehicle travels farther per kilogram of fuel consumed.</p>
    <h3 class="font-display seo-h3-sm">Volume vs Mass Differences</h3>
    <p class="seo-p">Mass-based efficiency differs from volume-based efficiency (like L/100km or MPG) because fuel density varies with temperature, altitude, and composition. Measuring fuel by weight eliminates density-related inaccuracies, which is why aviation and marine industries prefer mass-based units for critical fuel planning and consumption tracking.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">When should I use km/kg instead of L/100km?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Use km/kg when fuel is measured by weight rather than volume, such as in aviation, military vehicles, or industrial machinery. Volume-based measures like L/100km are affected by fuel density changes due to temperature, while mass-based units provide consistent accuracy regardless of environmental conditions.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Why is mass-based fuel economy used in aviation?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Aviation fuel is measured by weight because aircraft mass directly affects performance, range, and safety. Fuel density varies significantly with altitude and temperature, so weighing fuel ensures accurate flight planning and fuel load calculations that volume measurements cannot reliably provide.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How does nautical mile per kilogram apply to marine vessels?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Maritime operations use nautical miles as the standard distance unit, and fuel is often measured by mass for accuracy. Nautical mile per kilogram helps ship operators calculate range based on fuel weight, which is critical for voyage planning, compliance with international maritime fuel regulations, and efficient cargo loading.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">What is the difference between fuel efficiency and specific fuel consumption?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Fuel efficiency measures distance per unit of fuel (higher is better), while specific fuel consumption measures fuel per unit of distance or power (lower is better). They are mathematical inverses of each other. This converter works with efficiency values where a higher number means the vehicle travels farther on less fuel.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">Can I use this converter for industrial fuel tracking?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">Yes, mass-based fuel efficiency is commonly used in industrial settings such as generators, heavy machinery, and locomotives where fuel consumption is tracked by weight. Converting between km/kg, mi/lb, and other mass units helps standardize reporting across different equipment and operational regions.</p>
        </div>
      </div>
      <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
        <h3 itemprop="name" class="seo-faq-q">How do I convert mass-based fuel economy back to volume-based?</h3>
        <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
          <p itemprop="text" class="seo-faq-a">To convert from mass-based to volume-based units, you need the fuel density. For example, to convert km/kg to km/L, divide the km/kg value by the fuel density in kg/L. Standard diesel density is about 0.85 kg/L and standard gasoline is about 0.75 kg/L, though actual density varies with temperature and blend.</p>
        </div>
      </div>
    </div>
  </div>

</ToolLayout>

<script>
(function () {
  const UNITS = [
    { id: 'kmkg',  label: 'Kilometer per Kilometer (km/kg)',  abbr: 'km/kg',  factor: 1000 },
    { id: 'mkg',   label: 'Meter per Kilogram (m/kg)',        abbr: 'm/kg',   factor: 1 },
    { id: 'milb',  label: 'Mile per Pound (mi/lb)',           abbr: 'mi/lb',  factor: 2204.62 },
    { id: 'nmikg', label: 'Nautical Mile per Kilometer (nmi/kg)', abbr: 'nmi/kg', factor: 1852 },
  ];

  const input = document.getElementById('inp') as HTMLInputElement;
  const select = document.getElementById('sel') as HTMLSelectElement;
  const grid = document.getElementById('results')!;

  function formatResult(value: number): string {
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs >= 1e9) return value.toExponential(4);
    if (abs >= 1e6) return value.toLocaleString('en-US', { maximumFractionDigits: 2 });
    if (abs >= 1000) return value.toLocaleString('en-US', { maximumFractionDigits: 4 });
    if (abs >= 1) return value.toLocaleString('en-US', { maximumFractionDigits: 6 });
    if (abs >= 0.001) return value.toLocaleString('en-US', { maximumFractionDigits: 8 });
    if (abs >= 1e-6) return value.toLocaleString('en-US', { maximumFractionDigits: 10 });
    return value.toExponential(4);
  }

  function update() {
    const val = parseFloat(input.value);
    const fromUnit = select.value;
    const fromFactor = UNITS.find(u => u.id === fromUnit)!.factor;
    grid.innerHTML = '';
    UNITS.forEach(unit => {
      const converted = (val * fromFactor) / unit.factor;
      const display = formatResult(converted);
      const row = document.createElement('div');
      row.className = 'info-row';
      row.innerHTML = `
        <span class="info-label">${unit.abbr}</span>
        <div style="display:flex;align-items:center;gap:0.5rem;flex:1;justify-content:flex-end;min-width:0;">
          <span class="info-value" style="word-break:break-all;" data-val="${display}">${display}</span>
          <button class="btn-secondary copy-btn" type="button" style="font-size:0.7rem;padding:0.2rem 0.55rem;flex-shrink:0;">Copy</button>
        </div>
      `;
      row.querySelector('.copy-btn')!.addEventListener('click', () => {
        const btn = row.querySelector('.copy-btn')!;
        navigator.clipboard.writeText(display).then(() => {
          btn.textContent = '✓';
          btn.classList.add('btn-success');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
        });
      });
      grid.appendChild(row);
    });
  }

  input.addEventListener('input', update);
  select.addEventListener('change', update);
  update();
})();
</script>
