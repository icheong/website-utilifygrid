---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'bmr-katch-mcardle-calculator')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">BMR &amp; TDEE Calculator (Katch-McArdle)</h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1rem;">
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Total Weight (kg)</label>
        <input id="total-weight" type="number" value="80" min="30" max="300" step="0.5"
          class="input-themed"/>
      </div>
      <div>
        <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Body Fat %</label>
        <input id="body-fat" type="number" value="20" min="3" max="60" step="0.5"
          class="input-themed"/>
      </div>
    </div>

    <div style="margin-bottom:1.25rem;">
      <label style="font-size:0.78rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.4rem;">Activity Level</label>
      <select id="activity" class="select-themed">
        <option value="1.2">Sedentary (desk job, little exercise)</option>
        <option value="1.375">Lightly active (1–3 days/week)</option>
        <option value="1.55" selected>Moderately active (3–5 days/week)</option>
        <option value="1.725">Very active (6–7 days/week)</option>
        <option value="1.9">Extremely active (athlete / physical job)</option>
      </select>
    </div>

    <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:0.75rem; margin-bottom:1rem;">
      <div class="result-card" style="background:#FFF7ED; border-color:#FED7AA; text-align:center;">
        <div id="out-lbm" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#F97316;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#FB923C; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.05em;">Lean Body Mass</div>
      </div>
      <div class="result-card" style="background:#FEF2F2; border-color:#FECACA; text-align:center;">
        <div id="out-bmr" style="font-family:'Sora',sans-serif; font-size:1.5rem; font-weight:700; color:#DC2626;">—</div>
        <div style="font-size:0.72rem; font-weight:600; color:#F87171; margin-top:0.25rem; text-transform:uppercase; letter-spacing:0.05em;">BMR (kcal/day)</div>
      </div>
    </div>

    <div style="background:linear-gradient(135deg,#F97316,#DC2626); border-radius:0.875rem; padding:1.25rem; text-align:center; color:#fff;">
      <div style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; opacity:0.85; margin-bottom:0.35rem;">TDEE — Maintenance Calories</div>
      <div id="out-tdee" style="font-family:'Sora',sans-serif; font-size:2.25rem; font-weight:700; letter-spacing:-0.02em;">—</div>
      <div style="font-size:0.82rem; opacity:0.8; margin-top:0.25rem;">kcal / day</div>
    </div>

    <div style="margin-top:1rem; display:grid; grid-template-columns:1fr 1fr 1fr; gap:0.5rem;">
      {[['Cut','-400 kcal','#3B82F6'],['Lean Bulk','+200 kcal','#059669'],['Aggressive Bulk','+500 kcal','#F97316']].map(([label, adj, color]) => (
        <div class="result-card" style="text-align:center;">
          <div style={`font-size:0.72rem; font-weight:600; color:${color}; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.2rem;`}>{label}</div>
          <div id={`out-${(label as string).toLowerCase().replace(' ','-')}`} style="font-family:'Sora',sans-serif; font-size:0.95rem; font-weight:700; color:var(--text-primary);">—</div>
          <div style="font-size:0.68rem; color:var(--text-muted); margin-top:0.1rem;">{adj}</div>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">How to use the BMR & TDEE Calculator (Katch-McArdle)</h2>
    <p class="seo-p">Enter your total body weight in kilograms and body fat percentage. If you don't know your body fat percentage, a DEXA scan or body composition scale can measure it. Select your activity level that best matches your weekly exercise.</p>
    <div style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;">
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Calorie target setting</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Calculate your precise TDEE to establish the exact calorie intake needed to maintain, lose, or gain weight based on your individual body composition.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Cut vs bulk planning</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Determine your maintenance calories, then subtract for a deficit or add for a surplus to create a evidence-based nutrition plan for your goals.</p>
      </div>
      <div class="border-theme surface-2 seo-card-sm">
        <strong style="color:var(--text-primary); font-size:0.875rem">Athlete baseline assessment</strong>
        <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">Establish an accurate BMR baseline for athletes or muscular individuals where lean body mass makes the Katch-McArdle formula more accurate than height-based estimates.</p>
      </div>
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">The Katch-McArdle formula</h2>
    <h3 class="font-display seo-h3-sm">Why Katch-McArdle?</h3>
    <p class="seo-p">Unlike Harris-Benedict or Mifflin-St Jeor, the Katch-McArdle formula uses <code class="inline-code">Lean Body Mass</code> directly, making it more accurate for muscular athletes or those with higher body fat percentages.</p>
    <h3 class="font-display seo-h3-sm">Lean Body Mass</h3>
    <p class="seo-p"><code class="inline-code">LBM = Total Weight × (1 − Body Fat% / 100)</code> — This is the portion of your body mass that is not fat tissue.</p>
    <h3 class="font-display seo-h3-sm">BMR calculation</h3>
    <p class="seo-p"><code class="inline-code">BMR = 370 + (21.6 × LBM in kg)</code> — This is the calories your body burns at complete rest to keep organs functioning.</p>
    <h3 class="font-display seo-h3-sm">TDEE calculation</h3>
    <p class="seo-p"><code class="inline-code">TDEE = BMR × Activity Multiplier</code> — Sedentary is 1.2, lightly active is 1.375, moderately active is 1.55, very active is 1.725, extra active is 1.9.</p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently asked questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'How accurate is the Katch-McArdle formula?', a: 'It is generally considered the most accurate BMR formula when you know your body fat percentage, within 5-8% of measured RMR for most individuals. The main source of error is inaccurate body fat measurement.' },
        { q: 'What is the difference between BMR and TDEE?', a: 'BMR is the calories your body burns at complete rest. TDEE adds calories burned through all daily activity, including exercise and non-exercise activity thermogenesis.' },
        { q: 'Which activity multiplier should I choose?', a: 'Most people overestimate their activity level. Moderately active (1.55x) applies to genuine 45-60 minute workouts 4-5 times per week. If your job is mostly sitting, choose lightly active.' },
        { q: 'Why is my BMR different from other calculators?', a: 'Other calculators estimate lean mass from height, weight, age, and sex. Katch-McArdle uses measured body fat directly, so it will differ. It tends to be more accurate for unusual body compositions.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7"><strong class="text-primary" style="color:var(--text-secondary)">Disclaimer:</strong> This calculator provides general educational estimates only. BMR and TDEE values are approximations. Consult a healthcare professional or registered dietitian before making significant changes to your diet or exercise routine.</div>
  </div>

</ToolLayout>

<script>
  function calc() {
    const wt      = parseFloat((document.getElementById('total-weight') as HTMLInputElement).value) || 0;
    const bf      = parseFloat((document.getElementById('body-fat') as HTMLInputElement).value)     || 0;
    const act     = parseFloat((document.getElementById('activity') as HTMLSelectElement).value)    || 1.55;

    const lbm  = wt * (1 - bf / 100);
    const bmr  = 370 + 21.6 * lbm;
    const tdee = bmr * act;

    (document.getElementById('out-lbm') as HTMLElement).textContent  = lbm.toFixed(1) + ' kg';
    (document.getElementById('out-bmr') as HTMLElement).textContent  = Math.round(bmr) + ' kcal';
    (document.getElementById('out-tdee') as HTMLElement).textContent = Math.round(tdee).toLocaleString();

    (document.getElementById('out-cut') as HTMLElement).textContent            = Math.round(tdee - 400) + ' kcal';
    (document.getElementById('out-lean-bulk') as HTMLElement).textContent      = Math.round(tdee + 200) + ' kcal';
    (document.getElementById('out-aggressive-bulk') as HTMLElement).textContent = Math.round(tdee + 500) + ' kcal';
  }

  ['total-weight','body-fat','activity'].forEach(id => document.getElementById(id)?.addEventListener('input', calc));
  calc();
</script>
