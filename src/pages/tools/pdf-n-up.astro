---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'pdf-n-up')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2" style="margin-bottom:0.25rem;">N-Up PDF</h2>
    <p class="seo-p-sm" style="margin-bottom:1.25rem;">Layout multiple PDF pages onto a single sheet — 2-up, 4-up, 6-up, 8-up, or 9-up.</p>

    <div id="drop-zone" style="border:2px dashed var(--border);border-radius:0.875rem;padding:2.5rem 1rem;text-align:center;cursor:pointer;transition:border-color 0.2s,background 0.2s;background:var(--bg-surface);">
      <p style="font-size:1rem;font-weight:600;color:var(--text-primary);margin-bottom:0.4rem;">Drop a PDF file here</p>
      <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:0.75rem;">or click to browse</p>
      <input id="file-input" type="file" accept=".pdf" style="display:none;" />
      <button id="browse-btn" class="btn-secondary" type="button" style="font-size:0.82rem;">Browse File</button>
    </div>

    <div id="workspace" style="display:none;margin-top:1.25rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;flex-wrap:wrap;gap:0.5rem;">
        <p class="seo-p-sm" style="font-weight:600;">
          <span id="doc-name"></span> — <span id="doc-pages" style="font-weight:400;"></span>
        </p>
        <button id="reset-btn" class="btn-secondary" type="button" style="font-size:0.7rem;padding:0.25rem 0.6rem;">New File</button>
      </div>

      <div style="margin-bottom:1rem;">
        <p class="tool-label" style="margin-bottom:0.5rem;">Layout</p>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          <button class="btn-secondary layout-btn active" type="button" data-n="2" style="font-size:0.82rem;padding:0.5rem 1rem;">2-Up</button>
          <button class="btn-secondary layout-btn" type="button" data-n="4" style="font-size:0.82rem;padding:0.5rem 1rem;">4-Up</button>
          <button class="btn-secondary layout-btn" type="button" data-n="6" style="font-size:0.82rem;padding:0.5rem 1rem;">6-Up</button>
          <button class="btn-secondary layout-btn" type="button" data-n="8" style="font-size:0.82rem;padding:0.5rem 1rem;">8-Up</button>
          <button class="btn-secondary layout-btn" type="button" data-n="9" style="font-size:0.82rem;padding:0.5rem 1rem;">9-Up</button>
        </div>
      </div>

      <div id="layout-preview" style="margin-bottom:1rem;"></div>

      <div style="text-align:center;">
        <button id="process-btn" class="btn-primary" type="button" style="font-size:0.95rem;padding:0.7rem 2rem;">Create N-Up PDF</button>
        <p id="status" style="font-size:0.78rem;color:var(--text-muted);margin-top:0.5rem;display:none;"></p>
      </div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">N-Up PDF Overview</h2>
    <p class="seo-p">
      This N-Up PDF tool lays out multiple pages from a PDF document onto a single output sheet — entirely within your browser. Built with <strong>pdf-lib</strong> (for page composition) and <strong>PDF.js</strong> (for layout preview), both running via WebAssembly, the tool provides complete privacy and zero server latency. Choose from 2-Up (side by side), 4-Up (2×2 grid), 6-Up (2×3), 8-Up (2×4), or 9-Up (3×3) to print handouts, save paper, or create overview sheets.
    </p>
    <p class="seo-p">
      The tool displays a visual grid preview showing how pages will be arranged on each output sheet, including the total number of sheets required. Each original page is scaled down proportionally and positioned in a grid cell on the output sheet. The output sheet retains the same dimensions as the original page, so the result prints cleanly on standard paper.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications and Use Cases</h3>
    <div style="display:flex;flex-direction:column;gap:0.625rem;margin-bottom:0.75rem">
      {[
        [`Handout and presentation printing`, `Trainers and educators create 2-up or 4-up handouts to save paper when distributing presentation slides. A 40-slide deck becomes a 10-page handout at 4-up, or a 20-page handout at 2-up. The visual preview lets you verify the layout before printing, and the output sheet matches standard paper dimensions for clean printing.`],
        [`Document overview and proofreading`, `Editors and designers use 6-up or 9-up layouts to view an entire document at a glance. A 30-page report at 9-up produces 4 overview sheets, making it easy to spot layout inconsistencies, check page numbering, and verify visual flow across the entire document. This bird’s-eye view is invaluable for quality assurance before final printing.`],
        [`Paper-efficient document review`, `Legal and business teams review large documents more efficiently by printing multiple pages per sheet. A 200-page contract at 4-up produces 50 sheets instead of 200, reducing paper costs and making it easier to navigate during meetings. The 8-up layout is particularly useful for dense text documents where readability at reduced size is acceptable.`]
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary);font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem;line-height:1.65;margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Technical Architecture and Layout Algorithm</h2>
    <p class="seo-p">
      The tool uses a two-library architecture: <strong>PDF.js</strong> (Mozilla’s PDF renderer) generates the visual layout preview, while <strong>pdf-lib</strong> (a lightweight PDF manipulation library) performs the actual page composition by embedding and drawing source pages onto output sheets at scaled positions. Both libraries execute entirely in the browser via WebAssembly — no server round-trips occur at any stage.
    </p>

    <h3 class="font-display seo-h3-sm">The Layout Algorithm</h3>
    <p class="seo-p-sm">
      The layout is defined by a grid of <code class="inline-code">cols × rows</code> cells. For each output sheet, the tool embeds up to <code class="inline-code">cols × rows</code> source pages, scaling each to fit its grid cell. The cell dimensions are calculated as <code class="inline-code">cellW = pageWidth / cols</code> and <code class="inline-code">cellH = pageHeight / rows</code>. Each source page is drawn at its cell position using <code class="inline-code">drawPage()</code> with the calculated width and height.
    </p>
    <p class="seo-p-sm">
      <strong>1. File ingestion:</strong> When the user drops or selects a PDF file, the file is read as an <code class="inline-code">ArrayBuffer</code>. The tool extracts the page count and the dimensions of the first page (used as the output sheet size). The file data is held in browser memory — no network requests are made.
    </p>
    <p class="seo-p-sm">
      <strong>2. Layout preview:</strong> The tool generates a visual preview showing up to 3 output sheets as grid diagrams. Each cell displays its page number (or empty if no page exists for that position). The preview shows the grid dimensions, pages per sheet, and total sheet count. Switching layouts updates the preview in real time.
    </p>
    <p class="seo-p-sm">
      <strong>3. N-Up processing:</strong> When the user clicks “Create N-Up PDF”, pdf-lib creates a new empty <code class="inline-code">PDFDocument</code>. For each output sheet, it adds a new page with the original page dimensions, then iterates through the grid cells. For each cell, it embeds the corresponding source page using <code class="inline-code">embedPage()</code> and draws it at the calculated position using <code class="inline-code">drawPage()</code> with the cell dimensions.
    </p>
    <p class="seo-p-none">
      <strong>Quality preservation:</strong> Source pages are embedded using pdf-lib’s <code class="inline-code">embedPage()</code> method, which preserves the original content without re-encoding. Vector content (text, lines, shapes) remains sharp at any scale. Raster images are scaled by the PDF viewer at display time. The output sheet uses the same page dimensions as the source, ensuring clean printing on standard paper.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div style="display:flex;flex-direction:column;gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        {
          q: "What does N-Up mean?",
          a: "N-Up means placing N original pages onto a single output sheet. 2-Up puts 2 pages side by side. 4-Up arranges 4 pages in a 2×2 grid. 6-Up uses a 2×3 grid, 8-Up uses 2×4, and 9-Up uses a 3×3 grid. It is commonly used for printing handouts, saving paper, or creating document overviews."
        },
        {
          q: "Is my file uploaded to a server?",
          a: "No. All processing happens entirely in your browser using WebAssembly (pdf-lib) and Canvas (PDF.js). Your file never leaves your device — there is no server upload at any point."
        },
        {
          q: "Does N-Up reduce PDF quality?",
          a: "Pages are scaled down geometrically — no re-encoding occurs. Vector content (text, lines, shapes) remains sharp at any scale because it is redrawn by the PDF viewer. Raster images are scaled by the PDF viewer at display time, same as zooming out. There is no quality loss from the N-Up operation itself."
        },
        {
          q: "What output paper size is used?",
          a: "The output sheet uses the same dimensions as the first page of the source PDF. If your source is letter size (612×792 points), the output is also letter size. If your source is A4, the output is A4. The tool does not change paper size — it only scales and positions pages within the existing dimensions."
        },
        {
          q: "How are incomplete sheets handled?",
          a: "If the total page count is not evenly divisible by the N-Up factor, the last sheet will have empty cells. For example, a 10-page document at 4-Up produces 3 sheets: the first two sheets have 4 pages each, and the third sheet has 2 pages with 2 empty cells."
        },
        {
          q: "Can I create custom N-Up layouts like 3-Up or 5-Up?",
          a: "The tool currently supports five predefined layouts: 2, 4, 6, 8, and 9. These cover the most common N-Up configurations. Custom layouts would require different grid calculations and are not currently available."
        },
        {
          q: "Is the output suitable for double-sided printing?",
          a: "The N-Up operation creates a single-sided layout. For double-sided printing, you would need to print the N-Up output and then flip the pages manually, or use a separate duplex printing configuration in your printer settings. The tool does not handle duplex layout logic."
        }
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
<script is:inline src="https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.min.js"></script>

<script>
(function () {
  const { PDFDocument } = (window as any).PDFLib;
  const pdfjsLib = (window as any).pdfjsLib;
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.worker.min.js';

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const browseBtn = document.getElementById('browse-btn')!;
  const workspace = document.getElementById('workspace')!;
  const docName = document.getElementById('doc-name')!;
  const docPages = document.getElementById('doc-pages')!;
  const resetBtn = document.getElementById('reset-btn')!;
  const layoutPreview = document.getElementById('layout-preview')!;
  const processBtn = document.getElementById('process-btn')!;
  const statusEl = document.getElementById('status')!;

  let pdfBytes: ArrayBuffer | null = null;
  let totalPages = 0;
  let selectedN = 2;

  const LAYOUTS: Record<number, { cols: number; rows: number }> = {
    2: { cols: 2, rows: 1 },
    4: { cols: 2, rows: 2 },
    6: { cols: 2, rows: 3 },
    8: { cols: 2, rows: 4 },
    9: { cols: 3, rows: 3 },
  };

  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.style.borderColor = 'var(--color-brand-blue)'; });
  dropZone.addEventListener('dragleave', () => { dropZone.style.borderColor = ''; });
  dropZone.addEventListener('drop', e => { e.preventDefault(); dropZone.style.borderColor = ''; if (e.dataTransfer!.files.length) loadFile(e.dataTransfer!.files[0]); });
  browseBtn.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('click', e => { if (e.target === dropZone || e.target === browseBtn) fileInput.click(); });
  fileInput.addEventListener('change', () => { if (fileInput.files.length) loadFile(fileInput.files[0]); fileInput.value = ''; });
  resetBtn.addEventListener('click', () => { pdfBytes = null; workspace.style.display = 'none'; dropZone.style.display = ''; });

  document.querySelectorAll('.layout-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.layout-btn').forEach(b => { b.className = 'btn-secondary layout-btn'; });
      btn.className = 'btn-primary layout-btn';
      selectedN = parseInt((btn as HTMLElement).dataset.n!);
      renderLayoutPreview();
    });
  });

  async function loadFile(file: File) {
    if (file.type !== 'application/pdf') return;
    pdfBytes = await file.arrayBuffer();
    const pdf = await pdfjsLib.getDocument({ data: pdfBytes.slice(0) }).promise;
    totalPages = pdf.numPages;
    docName.textContent = file.name.replace(/\.pdf$/i, '');
    docPages.textContent = totalPages + ' page' + (totalPages > 1 ? 's' : '');
    dropZone.style.display = 'none';
    workspace.style.display = '';
    renderLayoutPreview();
  }

  function renderLayoutPreview() {
    const { cols, rows } = LAYOUTS[selectedN];
    const totalSlots = cols * rows;
    const sheets = Math.ceil(totalPages / totalSlots);
    let html = `<p style="font-size:0.75rem;color:var(--text-secondary);margin-bottom:0.5rem;">${cols}×${rows} grid — ${totalSlots} pages per sheet — ${sheets} sheet${sheets > 1 ? 's' : ''} total</p>`;
    html += '<div style="display:flex;gap:1rem;flex-wrap:wrap;">';
    for (let s = 0; s < Math.min(sheets, 3); s++) {
      html += `<div style="border:1.5px solid var(--border);border-radius:6px;padding:0.4rem;display:inline-grid;grid-template-columns:repeat(${cols},1fr);gap:0.25rem;background:var(--bg-surface-2);">`;
      for (let i = 0; i < totalSlots; i++) {
        const pageNum = s * totalSlots + i + 1;
        const hasPage = pageNum <= totalPages;
        html += `<div style="width:28px;height:38px;border:1px solid ${hasPage ? 'var(--color-brand-blue)' : 'var(--border)'};border-radius:2px;display:flex;align-items:center;justify-content:center;font-size:0.5rem;font-weight:600;color:${hasPage ? 'var(--color-brand-blue)' : 'var(--text-muted)'};background:${hasPage ? 'rgba(29,78,216,0.06)' : 'transparent'};">${hasPage ? pageNum : ''}</div>`;
      }
      html += '</div>';
    }
    if (sheets > 3) html += `<div style="display:flex;align-items:center;font-size:0.72rem;color:var(--text-muted);">+${sheets - 3} more sheets</div>`;
    html += '</div>';
    layoutPreview.innerHTML = html;
  }

  processBtn.addEventListener('click', async () => {
    if (!pdfBytes) return;
    processBtn.setAttribute('disabled', '');
    processBtn.textContent = 'Processing\u2026';
    try {
      const srcDoc = await PDFDocument.load(pdfBytes);
      const newDoc = await PDFDocument.create();
      const { cols, rows } = LAYOUTS[selectedN];
      const perSheet = cols * rows;
      const srcPages = srcDoc.getPageIndices();

      const firstPage = srcDoc.getPage(0);
      const { width: pw, height: ph } = firstPage.getSize();

      for (let sheetStart = 0; sheetStart < srcPages.length; sheetStart += perSheet) {
        const newPage = newDoc.addPage([pw, ph]);
        const sheetIndices = srcPages.slice(sheetStart, sheetStart + perSheet);

        for (let i = 0; i < sheetIndices.length; i++) {
          const col = i % cols;
          const row = Math.floor(i / cols);
          const flippedRow = rows - 1 - row;

          const cellW = pw / cols;
          const cellH = ph / rows;
          const x = col * cellW;
          const y = flippedRow * cellH;

          const embedded = await newDoc.embedPage(srcDoc.getPage(sheetIndices[i]));
          newPage.drawPage(embedded, {
            x, y,
            width: cellW,
            height: cellH,
          });
        }
      }

      const bytes = await newDoc.save();
      const blob = new Blob([bytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = `${selectedN}-up.pdf`; a.click();
      URL.revokeObjectURL(url);
      const sheets = Math.ceil(totalPages / perSheet);
      statusEl.style.display = ''; statusEl.style.color = '#10B981'; statusEl.textContent = `Created ${sheets} sheet${sheets > 1 ? 's' : ''} (${selectedN}-up). Downloaded ${selectedN}-up.pdf.`;
    } catch (e: any) { statusEl.style.display = ''; statusEl.style.color = '#EF4444'; statusEl.textContent = 'Error: ' + e.message; }
    finally { processBtn.removeAttribute('disabled'); processBtn.textContent = 'Create N-Up PDF'; }
  });
})();
</script>
