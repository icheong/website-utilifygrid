---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'compound-interest-retirement')!;
---

<ToolLayout tool={tool}>

  <!-- ── INTERACTIVE TOOL ─────────────────────────────────────────── -->
  <div slot="tool">
    <div class="tool-card-surface" style="display:flex;flex-direction:column;gap:1.5rem;">

      <!-- Inputs grid -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem;">

        <!-- Current Age -->
        <div class="input-group">
          <div class="input-label-row">
            <label for="inp-age" style="color:var(--text-secondary);font-size:.875rem;font-weight:600;">Current Age</label>
            <output id="out-age" class="input-badge">30</output>
          </div>
          <input id="inp-age" type="range" min="18" max="70" value="30" class="ctrl-slider" aria-label="Current age">
          <div class="range-bounds"><span>18</span><span>70</span></div>
        </div>

        <!-- Current Savings -->
        <div class="input-group">
          <div class="input-label-row">
            <label for="inp-savings" style="color:var(--text-secondary);font-size:.875rem;font-weight:600;">Current Savings</label>
            <output id="out-savings" class="input-badge">$25,000</output>
          </div>
          <input id="inp-savings" type="range" min="0" max="1000000" step="1000" value="25000" class="ctrl-slider" aria-label="Current savings">
          <div class="range-bounds"><span>$0</span><span>$1M</span></div>
        </div>

        <!-- Monthly Contribution -->
        <div class="input-group">
          <div class="input-label-row">
            <label for="inp-contrib" style="color:var(--text-secondary);font-size:.875rem;font-weight:600;">Monthly Contribution</label>
            <output id="out-contrib" class="input-badge">$1,000</output>
          </div>
          <input id="inp-contrib" type="range" min="0" max="10000" step="50" value="1000" class="ctrl-slider" aria-label="Monthly contribution">
          <div class="range-bounds"><span>$0</span><span>$10k</span></div>
        </div>

        <!-- Annual Return -->
        <div class="input-group">
          <div class="input-label-row">
            <label for="inp-return" style="color:var(--text-secondary);font-size:.875rem;font-weight:600;">Expected Annual Return</label>
            <output id="out-return" class="input-badge">7%</output>
          </div>
          <input id="inp-return" type="range" min="1" max="15" step="0.5" value="7" class="ctrl-slider" aria-label="Expected annual return">
          <div class="range-bounds"><span>1%</span><span>15%</span></div>
        </div>

        <!-- Monthly Expenses -->
        <div class="input-group">
          <div class="input-label-row">
            <label for="inp-expenses" style="color:var(--text-secondary);font-size:.875rem;font-weight:600;">Monthly Expenses at Retirement</label>
            <output id="out-expenses" class="input-badge">$3,500</output>
          </div>
          <input id="inp-expenses" type="range" min="500" max="20000" step="100" value="3500" class="ctrl-slider" aria-label="Monthly expenses at retirement">
          <div class="range-bounds"><span>$500</span><span>$20k</span></div>
        </div>

        <!-- Safe Withdrawal Rate -->
        <div class="input-group">
          <div class="input-label-row">
            <label for="inp-swr" style="color:var(--text-secondary);font-size:.875rem;font-weight:600;">Safe Withdrawal Rate</label>
            <output id="out-swr" class="input-badge">4%</output>
          </div>
          <input id="inp-swr" type="range" min="2" max="6" step="0.1" value="4" class="ctrl-slider" aria-label="Safe withdrawal rate">
          <div class="range-bounds"><span>2%</span><span>6%</span></div>
        </div>

      </div>

      <!-- KPI cards -->
      <div id="kpi-row" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;">
        <div class="kpi-card">
          <div id="kpi-fire-age" class="kpi-value" style="color:var(--text-primary);">—</div>
          <div class="kpi-label">FIRE Age</div>
        </div>
        <div class="kpi-card">
          <div id="kpi-years" class="kpi-value" style="color:var(--text-primary);">—</div>
          <div class="kpi-label">Years to FIRE</div>
        </div>
        <div class="kpi-card">
          <div id="kpi-portfolio" class="kpi-value" style="color:var(--text-primary);">—</div>
          <div class="kpi-label">Portfolio at FIRE</div>
        </div>
        <div class="kpi-card">
          <div id="kpi-income" class="kpi-value" style="color:var(--text-primary);">—</div>
          <div class="kpi-label">Monthly Passive Income</div>
        </div>
      </div>

      <!-- No-FIRE warning -->
      <div id="no-fire-msg" style="display:none;padding:.75rem 1rem;border-radius:.5rem;background:color-mix(in srgb,var(--text-muted) 10%,transparent);color:var(--text-muted);font-size:.875rem;">
        ⚠️ With current settings, passive income won't exceed expenses before age 80. Try increasing contributions or return rate.
      </div>

      <!-- Chart -->
      <div style="position:relative;">
        <canvas id="fire-chart" height="320" style="width:100%;display:block;border-radius:.5rem;"></canvas>
        <div id="chart-tooltip" style="position:absolute;pointer-events:none;opacity:0;transition:opacity .15s;background:var(--bg-surface);border:1px solid var(--border);border-radius:.5rem;padding:.6rem .85rem;font-size:.8rem;color:var(--text-primary);min-width:180px;line-height:1.7;z-index:10;"></div>
      </div>

      <!-- Legend -->
      <div style="display:flex;flex-wrap:wrap;gap:1.25rem;font-size:.8rem;color:var(--text-secondary);">
        <span style="display:flex;align-items:center;gap:.4rem;"><span style="width:12px;height:12px;border-radius:3px;background:#6366f1;flex-shrink:0;"></span>Portfolio Growth</span>
        <span style="display:flex;align-items:center;gap:.4rem;"><span style="width:12px;height:12px;border-radius:50%;background:#10b981;flex-shrink:0;"></span>Monthly Passive Income</span>
        <span style="display:flex;align-items:center;gap:.4rem;"><span style="width:12px;height:4px;background:#f59e0b;flex-shrink:0;border-radius:2px;"></span>Monthly Expenses (threshold)</span>
      </div>

    </div>
  </div>

  <!-- ── HOW TO USE ────────────────────────────────────────────────── -->
  <div slot="how-to-use">
    <h2 class="font-display seo-h2" >Compound Interest &amp; Retirement Calculator Overview</h2>
    <p class="seo-p" >
      This compound interest and retirement calculator visualises how consistent contributions, investment returns, and the safe withdrawal rate interact to determine when you can achieve financial independence. The tool runs entirely in your browser using modern vanilla JavaScript and the Canvas API — no data is transmitted to any server, and no cookies or analytics scripts track your inputs. The 100% client-side architecture ensures complete financial privacy and zero latency.
    </p>
    <p class="seo-p" >
      The calculator models the future value of an existing portfolio supplemented by recurring monthly contributions, then determines the year at which the portfolio's passive income (derived from the safe withdrawal rate) meets or exceeds your projected retirement expenses. The interactive chart updates in real time as you adjust any input, and the crossover point — where passive income surpasses expenses — is highlighted as your FIRE (Financial Independence, Retire Early) date.
    </p>

    <h3 style="font-size:1rem; font-weight:600; margin:1rem 0 0.5rem">Real-World Applications and Use Cases</h3>
    <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:0.75rem">
      {[
        ['Early-career professionals planning savings targets', 'A 25-year-old earning $80,000 annually can model how saving $1,500 per month at a 7% real return affects their FIRE timeline. The tool immediately reveals whether their current savings rate is sufficient or whether adjustments to contribution amounts or retirement expense assumptions are needed.'],
        ['Couples evaluating dual-income retirement strategies', 'Partners can combine their individual portfolios and contributions into a single model, adjusting the monthly expense figure to reflect shared living costs. Running scenarios with different return assumptions (conservative 5% vs. moderate 7%) provides a range of possible FIRE dates for informed planning discussions.'],
        ['Financial educators and FIRE community workshops', 'The transparent formulas and real-time chart make this tool suitable for classroom or workshop demonstrations. Because all calculations occur client-side with no external dependencies, presenters can use it offline and verify every output against the displayed mathematical model.'],
      ].map(([title, desc]) => (
        <div class="border-theme surface-2 seo-card-sm" >
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- ── HOW IT WORKS ──────────────────────────────────────────────── -->
  <div slot="how-it-works">
    <h2 class="font-display seo-h2" >Deep-Dive: Compound Interest Mechanics &amp; Mathematical Logic</h2>
    <p class="seo-p" >
      The portfolio at any future point in time is computed using the standard future-value equation for a lump sum plus the future value of an annuity (recurring contributions). This dual-component model is the foundation of retirement projection mathematics used by financial planners worldwide.
    </p>
    <pre style="font-family:'Fira Code',monospace;font-size:.85rem;padding:1rem;border-radius:.5rem;background:var(--bg-surface-2);color:var(--text-primary);overflow-x:auto;white-space:pre-wrap">Portfolio(t) = S × (1 + r/12)^(12t)
             + C × [((1 + r/12)^(12t) − 1) / (r/12)]

Monthly Passive Income(t) = Portfolio(t) × SWR / 12

FIRE crossover when: MonthlyPassiveIncome(t) ≥ MonthlyExpenses</pre>
    <p class="seo-p-sm" >
      Where <strong>S</strong> is current savings, <strong>r</strong> is the annual return rate (decimal), <strong>t</strong> is years elapsed, <strong>C</strong> is monthly contribution, and <strong>SWR</strong> is the safe withdrawal rate (decimal). The first term compounds your existing savings monthly over the projection horizon. The second term accumulates each monthly contribution with compound growth — each deposit earns returns for the remaining months until the projection endpoint.
    </p>
    <p class="seo-p-sm" >
      <strong>Monthly compounding precision:</strong> The model compounds at a monthly interval (r/12 per month, 12t total periods), which is the standard convention for retirement projections and aligns with how most index funds and superannuation accounts report returns. This produces more accurate results than annual compounding, particularly for high-contribution scenarios.
    </p>
    <p class="seo-p-sm" >
      <strong>The Safe Withdrawal Rate (SWR):</strong> The SWR determines how much of your portfolio can be withdrawn each year without depleting the principal over a given horizon. The Trinity Study (Cooley, Hubbard, and Walz, 1998) found that a 4% withdrawal rate sustained a 30-year retirement period with high probability across historical US market data. For early retirements spanning 40–50 years, many financial researchers recommend 3–3.5%.
    </p>
    <p class="seo-p-none" >
      <strong>Edge cases:</strong> The calculator handles a 0% return rate (linear accumulation), very high contribution-to-portfolio ratios, and scenarios where FIRE is not achievable before age 80. When no crossover is found within the projection window, the tool displays a warning indicating that contributions or return assumptions need adjustment.
    </p>
  </div>

  <!-- ── FAQ ──────────────────────────────────────────────────────── -->
  <div slot="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is FIRE?",
          "acceptedAnswer": { "@type": "Answer", "text": "FIRE stands for Financial Independence, Retire Early. It describes the point at which your invested assets generate enough passive income to cover living expenses indefinitely, freeing you from the need to work for money." }
        },
        {
          "@type": "Question",
          "name": "What is the 4% rule?",
          "acceptedAnswer": { "@type": "Answer", "text": "The 4% rule originates from the 1998 Trinity Study, which found that a retirement portfolio invested in stocks and bonds could sustain a 4% annual withdrawal rate over a 30-year horizon with a high probability of not running out of money. It remains a popular planning benchmark, though some advisors recommend 3–3.5% for longer retirement periods." }
        },
        {
          "@type": "Question",
          "name": "Is a 7% annual return realistic?",
          "acceptedAnswer": { "@type": "Answer", "text": "The US stock market has returned roughly 10% annually before inflation and around 7% after inflation over the long run. 7% is a commonly used real (inflation-adjusted) return estimate for a diversified equity portfolio. Your actual returns will vary year to year, and past performance does not guarantee future results." }
        },
        {
          "@type": "Question",
          "name": "Does this account for inflation?",
          "acceptedAnswer": { "@type": "Answer", "text": "This tool does not separately model inflation. To account for it, use a return rate that is already adjusted for inflation (e.g. 7% real return rather than 10% nominal) and enter your expenses in today's dollars. This gives you a conservative, inflation-adjusted crossover estimate." }
        },
        {
          "@type": "Question",
          "name": "How do I factor in government pension or superannuation?",
          "acceptedAnswer": { "@type": "Answer", "text": "You can approximate this by reducing your monthly expenses figure by the expected monthly pension or super drawdown amount. For example, if you expect $1,000/month from superannuation and need $4,000/month total, enter $3,000 as your monthly expenses — representing the gap your portfolio needs to cover." }
        },
        {
          "@type": "Question",
          "name": "What if I plan to increase my contributions over time?",
          "acceptedAnswer": { "@type": "Answer", "text": "This visualizer models a fixed monthly contribution. To approximate increasing contributions, you can run the tool twice — once with your current contribution to estimate your portfolio at a mid-point, then use that as the starting savings with a higher contribution rate. A staged model gives a rough upper bound on how much earlier increasing contributions moves your FIRE date." }
        }
      ]
    }
    </script>

    <h2 class="font-display seo-h2-faq" >Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What is FIRE?', a: 'FIRE stands for Financial Independence, Retire Early. It describes the point at which your invested assets generate enough passive income to cover living expenses indefinitely, freeing you from the need to work for money. The concept originated in the 1990s with Vicki Robin and Joe Dominguez\'s book "Your Money or Your Life" and has since grown into a global movement focused on aggressive saving and mindful investing.' },
        { q: 'What is the 4% rule?', a: 'The 4% rule originates from the 1998 Trinity Study, which found that a retirement portfolio invested in a mix of stocks and bonds could sustain a 4% annual withdrawal rate over a 30-year horizon with a high historical success rate. Some financial advisors recommend 3–3.5% for longer early-retirement periods spanning 40–50 years, as the Trinity Study was designed around a conventional retirement timeline.' },
        { q: 'Is a 7% annual return realistic?', a: 'The US stock market has returned roughly 10% annually before inflation and approximately 7% after inflation over the long run. 7% is a commonly used real return estimate for a diversified equity portfolio. Your actual returns will vary year to year — some years may see 20%+ gains while others may lose value. Past performance does not guarantee future results, and international markets may perform differently.' },
        { q: 'Does this account for inflation?', a: 'Not automatically. To account for inflation, use a return rate that is already adjusted for inflation (e.g. 7% real return rather than 10% nominal) and enter your expenses in today\'s dollars. This gives you a conservative, inflation-adjusted crossover estimate. Alternatively, you can use the nominal return and inflate your expense figure by your expected inflation rate to model a nominal-value scenario.' },
        { q: 'How do I factor in superannuation or government pension?', a: 'Reduce your monthly expenses by the expected monthly pension or super drawdown. If you need $4,000/month total and expect $1,000 from superannuation, enter $3,000 as monthly expenses — the gap your personal portfolio needs to cover. Note that Australian superannuation has preservation rules and contribution caps that may affect your accessible balance at different ages.' },
        { q: 'What if I plan to increase contributions over time?', a: 'This tool models a fixed monthly contribution. To approximate stepped increases, run the tool to a mid-point age, note the portfolio value, then re-run using that as starting savings with a higher contribution rate. A staged model provides a reasonable upper-bound estimate of how much earlier increasing contributions moves your FIRE date.' },
        { q: 'How does tax on investment returns affect my FIRE timeline?', a: 'This calculator does not model tax on capital gains or dividends. In practice, tax-advantaged accounts (such as superannuation or tax-free savings accounts) can shelter returns from taxation, while taxable brokerage accounts will reduce effective returns. To approximate the impact, use a lower return rate that reflects your after-tax yield — for example, 5% instead of 7% if you expect significant capital gains tax.' },
        { q: 'What withdrawal rate is safe for a 40+ year retirement?', a: 'The original Trinity Study was designed around a 30-year retirement horizon. For early retirees with 40–50 year horizons, research suggests a 3–3.5% withdrawal rate provides a higher margin of safety. You can test this directly in the tool by adjusting the SWR slider downward and observing how the FIRE age shifts later as a result.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="seo-disclaimer" style="margin-top:1.5rem; background:var(--bg-surface-2); border:1px solid var(--border); font-size:0.8rem; color:var(--text-muted); line-height:1.7">
      <strong class="text-primary" style="color:var(--text-secondary)">Disclaimer:</strong> This calculator is provided for educational and illustrative purposes only. It does not constitute financial, investment, or tax advice. The projections are based on simplified mathematical models and historical return averages, which may not reflect future market performance. Actual investment returns will vary, and factors such as taxes, fees, inflation, and market volatility are not separately modelled. Always consult a licensed financial advisor before making investment or retirement planning decisions.
    </div>
  </div>

</ToolLayout>

<style>
  .input-group { display: flex; flex-direction: column; gap: .4rem; }
  .input-label-row { display: flex; justify-content: space-between; align-items: center; }
  .input-badge {
    font-family: 'Fira Code', monospace;
    font-size: .8rem;
    font-weight: 700;
    padding: .15rem .5rem;
    border-radius: .375rem;
    background: color-mix(in srgb, var(--text-muted) 15%, transparent);
    color: var(--text-primary);
    min-width: 70px;
    text-align: right;
  }
  .ctrl-slider {
    width: 100%;
    accent-color: #6366f1;
    cursor: pointer;
  }
  .range-bounds {
    display: flex;
    justify-content: space-between;
    font-size: .72rem;
    color: var(--text-muted);
  }
  .kpi-card {
    background: var(--bg-surface-2);
    border: 1px solid var(--border);
    border-radius: .75rem;
    padding: 1rem;
    text-align: center;
  }
  .kpi-value {
    font-family: 'Sora', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .kpi-label {
    font-size: .75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-top: .25rem;
  }
  details { border-top: 1px solid var(--border); }
  details:last-child { border-bottom: 1px solid var(--border); }
  details summary { list-style: none; }
  details summary::-webkit-details-marker { display: none; }
</style>

<script>
(function () {
  // ── Helpers ──────────────────────────────────────────────────────
  const fmtUSD = (n) =>
    n >= 1_000_000
      ? '$' + (n / 1_000_000).toFixed(2) + 'M'
      : n >= 1_000
      ? '$' + (n / 1_000).toFixed(1) + 'k'
      : '$' + Math.round(n).toLocaleString();

  const fmtFull = (n) =>
    '$' + Math.round(n).toLocaleString();

  // ── DOM refs ──────────────────────────────────────────────────────
  const sliders = {
    age:      document.getElementById('inp-age'),
    savings:  document.getElementById('inp-savings'),
    contrib:  document.getElementById('inp-contrib'),
    ret:      document.getElementById('inp-return'),
    expenses: document.getElementById('inp-expenses'),
    swr:      document.getElementById('inp-swr'),
  };
  const outputs = {
    age:      document.getElementById('out-age'),
    savings:  document.getElementById('out-savings'),
    contrib:  document.getElementById('out-contrib'),
    ret:      document.getElementById('out-return'),
    expenses: document.getElementById('out-expenses'),
    swr:      document.getElementById('out-swr'),
  };
  const kpi = {
    fireAge:   document.getElementById('kpi-fire-age'),
    years:     document.getElementById('kpi-years'),
    portfolio: document.getElementById('kpi-portfolio'),
    income:    document.getElementById('kpi-income'),
  };
  const noFireMsg  = document.getElementById('no-fire-msg');
  const canvas     = document.getElementById('fire-chart');
  const tooltip    = document.getElementById('chart-tooltip');
  const ctx        = canvas.getContext('2d');

  // ── Model ─────────────────────────────────────────────────────────
  function buildSeries(age, savings, contrib, annualReturn, expenses, swr) {
    const r        = annualReturn / 100;
    const maxYears = 80 - age;
    const points   = [];

    for (let t = 0; t <= maxYears; t++) {
      const months   = t * 12;
      const factor   = Math.pow(1 + r / 12, months);
      const portfolio =
        savings * factor +
        (r === 0
          ? contrib * months
          : contrib * ((factor - 1) / (r / 12)));
      const passiveIncome = (portfolio * swr) / 100 / 12;
      points.push({ age: age + t, t, portfolio, passiveIncome });
    }

    let crossover = null;
    for (let i = 1; i < points.length; i++) {
      if (points[i].passiveIncome >= expenses) {
        crossover = points[i];
        break;
      }
    }

    return { points, crossover, expenses };
  }

  // ── Chart ─────────────────────────────────────────────────────────
  const C = {
    portfolio: '#6366f1',
    income:    '#10b981',
    expenses:  '#f59e0b',
    grid:      'rgba(255,255,255,0.06)',
    tick:      '#9ca3af',
    crossover: '#f43f5e',
    bg:        'transparent',
  };

  let lastPoints = [];

  function drawChart(points, crossover, expenses) {
    lastPoints = points;
    const dpr  = window.devicePixelRatio || 1;
    const W    = canvas.parentElement.clientWidth;
    const H    = 320;
    canvas.style.width  = W + 'px';
    canvas.style.height = H + 'px';
    canvas.width  = W * dpr;
    canvas.height = H * dpr;
    ctx.scale(dpr, dpr);
    ctx.clearRect(0, 0, W, H);

    const ML = 72, MR = 20, MT = 20, MB = 36;
    const cW = W - ML - MR;
    const cH = H - MT - MB;
    const n  = points.length;

    // Y axis: scale on passive income (secondary axis); portfolio on a hidden scale
    const maxIncome   = Math.max(...points.map(p => p.passiveIncome), expenses * 1.5);
    const maxPortfolio = Math.max(...points.map(p => p.portfolio));

    const xOf = (i) => ML + (i / (n - 1)) * cW;
    const yOfIncome = (v) => MT + cH - (v / maxIncome) * cH;
    const yOfPortfolio = (v) => MT + cH - (v / maxPortfolio) * cH;

    // Grid
    ctx.font = "11px 'Inter',sans-serif";
    for (let g = 0; g <= 4; g++) {
      const v = (maxIncome / 4) * g;
      const y = yOfIncome(v);
      ctx.beginPath();
      ctx.strokeStyle = C.grid;
      ctx.lineWidth   = 1;
      ctx.moveTo(ML, y);
      ctx.lineTo(ML + cW, y);
      ctx.stroke();
      ctx.fillStyle   = C.tick;
      ctx.textAlign   = 'right';
      ctx.fillText(fmtUSD(v) + '/mo', ML - 6, y + 4);
    }

    // X axis labels
    ctx.textAlign   = 'center';
    ctx.fillStyle   = C.tick;
    const step = Math.ceil(n / 10);
    points.forEach((p, i) => {
      if (i % step !== 0 && i !== n - 1) return;
      ctx.fillText(p.age, xOf(i), H - MB + 16);
    });

    // Axis lines
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(255,255,255,0.12)';
    ctx.lineWidth   = 1;
    ctx.moveTo(ML, MT);
    ctx.lineTo(ML, MT + cH);
    ctx.lineTo(ML + cW, MT + cH);
    ctx.stroke();

    // Portfolio area + line
    ctx.beginPath();
    ctx.moveTo(xOf(0), yOfPortfolio(points[0].portfolio));
    points.forEach((p, i) => ctx.lineTo(xOf(i), yOfPortfolio(p.portfolio)));
    ctx.lineTo(xOf(n - 1), MT + cH);
    ctx.lineTo(xOf(0), MT + cH);
    ctx.closePath();
    const gradP = ctx.createLinearGradient(0, MT, 0, MT + cH);
    gradP.addColorStop(0, 'rgba(99,102,241,0.25)');
    gradP.addColorStop(1, 'rgba(99,102,241,0.02)');
    ctx.fillStyle = gradP;
    ctx.fill();

    ctx.beginPath();
    ctx.strokeStyle = C.portfolio;
    ctx.lineWidth   = 2;
    ctx.lineJoin    = 'round';
    points.forEach((p, i) => i === 0 ? ctx.moveTo(xOf(i), yOfPortfolio(p.portfolio)) : ctx.lineTo(xOf(i), yOfPortfolio(p.portfolio)));
    ctx.stroke();

    // Expenses threshold dashed line
    const yExp = yOfIncome(expenses);
    ctx.beginPath();
    ctx.setLineDash([6, 4]);
    ctx.strokeStyle = C.expenses;
    ctx.lineWidth   = 1.5;
    ctx.moveTo(ML, yExp);
    ctx.lineTo(ML + cW, yExp);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle  = C.expenses;
    ctx.textAlign  = 'left';
    ctx.font       = "10px 'Inter',sans-serif";
    ctx.fillText('Expenses: ' + fmtFull(expenses) + '/mo', ML + 4, yExp - 5);

    // Passive income line
    ctx.beginPath();
    ctx.strokeStyle = C.income;
    ctx.lineWidth   = 2.5;
    ctx.lineJoin    = 'round';
    points.forEach((p, i) => i === 0 ? ctx.moveTo(xOf(i), yOfIncome(p.passiveIncome)) : ctx.lineTo(xOf(i), yOfIncome(p.passiveIncome)));
    ctx.stroke();

    // Dots on passive income
    points.forEach((p, i) => {
      if (i % step !== 0 && i !== n - 1) return;
      ctx.beginPath();
      ctx.arc(xOf(i), yOfIncome(p.passiveIncome), 3, 0, Math.PI * 2);
      ctx.fillStyle   = C.income;
      ctx.fill();
      ctx.strokeStyle = 'var(--bg-surface)';
      ctx.lineWidth   = 1.5;
      ctx.stroke();
    });

    // Crossover marker
    if (crossover) {
      const cx = xOf(crossover.t);
      const cy = yOfIncome(crossover.passiveIncome);
      ctx.beginPath();
      ctx.arc(cx, cy, 8, 0, Math.PI * 2);
      ctx.fillStyle   = C.crossover;
      ctx.fill();
      ctx.strokeStyle = 'var(--bg-surface)';
      ctx.lineWidth   = 2;
      ctx.stroke();

      ctx.fillStyle  = C.crossover;
      ctx.font       = "bold 11px 'Sora',sans-serif";
      ctx.textAlign  = cx > W - 100 ? 'right' : 'left';
      ctx.fillText('FIRE ✦ Age ' + crossover.age, cx + (ctx.textAlign === 'right' ? -14 : 14), cy - 10);
    }

    // Tooltip on mousemove
    canvas.onmousemove = (e) => {
      const rect = canvas.getBoundingClientRect();
      const mx   = e.clientX - rect.left;
      let   best = -1, bd = Infinity;
      points.forEach((p, i) => {
        const d = Math.abs(xOf(i) - mx);
        if (d < bd) { bd = d; best = i; }
      });
      if (best === -1 || bd > cW / n) { tooltip.style.opacity = '0'; return; }
      const p  = points[best];
      const tx = xOf(best);
      const ty = yOfIncome(p.passiveIncome);
      tooltip.innerHTML = `
        <strong style="color:var(--text-primary);">Age ${p.age}</strong><br>
        <span style="color:${C.portfolio};">■</span> Portfolio: ${fmtFull(p.portfolio)}<br>
        <span style="color:${C.income};">●</span> Passive Income: ${fmtFull(p.passiveIncome)}/mo<br>
        <span style="color:${C.expenses};">—</span> Expenses: ${fmtFull(expenses)}/mo
      `;
      const tW = 200, tH = 80;
      let left = tx + 14, top = ty - tH / 2;
      if (left + tW > W) left = tx - tW - 14;
      if (top < 0) top = 4;
      tooltip.style.left    = left + 'px';
      tooltip.style.top     = top + 'px';
      tooltip.style.opacity = '1';
    };
    canvas.onmouseleave = () => { tooltip.style.opacity = '0'; };
  }

  // ── Update ────────────────────────────────────────────────────────
  function update() {
    const age      = parseInt(sliders.age.value, 10);
    const savings  = parseFloat(sliders.savings.value);
    const contrib  = parseFloat(sliders.contrib.value);
    const ret      = parseFloat(sliders.ret.value);
    const expenses = parseFloat(sliders.expenses.value);
    const swr      = parseFloat(sliders.swr.value);

    // Update output badges
    outputs.age.value      = age;
    outputs.savings.value  = fmtFull(savings);
    outputs.contrib.value  = fmtFull(contrib);
    outputs.ret.value      = ret + '%';
    outputs.expenses.value = fmtFull(expenses);
    outputs.swr.value      = swr + '%';

    const { points, crossover } = buildSeries(age, savings, contrib, ret, expenses, swr);

    if (crossover) {
      noFireMsg.style.display        = 'none';
      kpi.fireAge.textContent        = 'Age ' + crossover.age;
      kpi.years.textContent          = (crossover.age - age) + ' yrs';
      kpi.portfolio.textContent      = fmtUSD(crossover.portfolio);
      kpi.income.textContent         = fmtFull(crossover.passiveIncome) + '/mo';

      // Accent the FIRE age card
      kpi.fireAge.style.color        = '#f43f5e';
      kpi.years.style.color          = '#f59e0b';
      kpi.portfolio.style.color      = '#6366f1';
      kpi.income.style.color         = '#10b981';
    } else {
      noFireMsg.style.display        = 'block';
      kpi.fireAge.textContent        = '> 80';
      kpi.years.textContent          = '—';
      kpi.portfolio.textContent      = '—';
      kpi.income.textContent         = '—';
      kpi.fireAge.style.color        = 'var(--text-muted)';
      kpi.years.style.color          = 'var(--text-muted)';
      kpi.portfolio.style.color      = 'var(--text-muted)';
      kpi.income.style.color         = 'var(--text-muted)';
    }

    drawChart(points, crossover, expenses);
  }

  // ── Wire up sliders ───────────────────────────────────────────────
  Object.values(sliders).forEach(s => s.addEventListener('input', update));

  // ── Resize ────────────────────────────────────────────────────────
  window.addEventListener('resize', update);

  // ── Init ──────────────────────────────────────────────────────────
  update();
})();
</script>
