---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';

const tool = tools.find(t => t.slug === 'regex-pattern-filter')!;
---

<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Regex Pattern Filter</h2>

    <div style="display:flex; gap:0.5rem; align-items:flex-end; margin-bottom:0.75rem;">
      <div style="flex:1;">
        <label style="font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.35rem;">Pattern</label>
        <input id="regex-input" type="text" placeholder="e.g. \b[A-Z][a-z]+\b" value="\b\d{4}\b"
          style="width:100%; padding:0.625rem 0.875rem; border:1.5px solid #FDE68A; border-radius:0.625rem; font-family:'Fira Code',monospace; font-size:0.875rem; color:var(--text-primary); box-sizing:border-box; outline:none; background:var(--bg-surface);"
          onfocus="this.style.borderColor='#EAB308'" onblur="this.style.borderColor='#FDE68A'"/>
      </div>
      <div>
        <label style="font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:0.35rem;">Flags</label>
        <div style="display:flex; gap:0.25rem;">
          {['g','i','m'].map(f => (
            <label style="display:flex; align-items:center; gap:0.25rem; background:var(--bg-surface-2); border:1.5px solid var(--border); border-radius:0.375rem; padding:0.4rem 0.625rem; cursor:pointer; font-family:'Fira Code',monospace; font-size:0.8rem; font-weight:600; color:var(--text-secondary);">
              <input type="checkbox" class="flag-box" value={f} checked={f === 'g'} style="accent-color:#EAB308;"/>
              {f}
            </label>
          ))}
        </div>
      </div>
    </div>

    <div id="regex-error" style="display:none; margin-bottom:0.625rem; padding:0.5rem 0.75rem; background:#FEF2F2; border:1px solid #FECACA; border-radius:0.5rem; font-size:0.78rem; color:#DC2626; font-family:'Fira Code',monospace;"></div>

    <textarea id="text-input" placeholder="Paste text to filter and highlight matches…"
      style="width:100%; height:160px; padding:0.75rem; border:1.5px solid var(--border); border-radius:0.625rem; font-size:0.85rem; color:var(--text-primary); resize:vertical; box-sizing:border-box; outline:none; line-height:1.6; margin-bottom:0.875rem; font-family:inherit; background:var(--bg-surface);">In 2019 the project began with a budget of $1,200 and by 2021 it grew to $4,500. There were 123 participants in 2022 and 456 in 2023.</textarea>

    <div style="display:flex; gap:0.75rem; margin-bottom:0.875rem;">
      <div class="result-card" style="padding:0.75rem 1.25rem; border-color:#FEF08A; background:#FEFCE8;">
        <span id="match-count" style="font-family:'Sora',sans-serif; font-size:1.25rem; font-weight:700; color:#CA8A04;">0</span>
        <span style="font-size:0.75rem; font-weight:600; color:#EAB308; margin-left:0.35rem; text-transform:uppercase; letter-spacing:0.04em;">Matches</span>
      </div>
    </div>

    <!-- Highlighted output -->
    <div style="margin-bottom:0.875rem;">
      <div style="font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.4rem;">Highlighted Text</div>
      <div id="highlighted" style="background:var(--bg-surface); border:1.5px solid #FEF08A; border-radius:0.625rem; padding:0.875rem; font-size:0.875rem; line-height:1.75; min-height:60px; word-break:break-word;"></div>
    </div>

    <!-- Matches list -->
    <div>
      <div style="font-size:0.75rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.4rem;">Extracted Matches</div>
      <div id="matches-list" style="display:flex; flex-wrap:wrap; gap:0.375rem;"></div>
    </div>
  </div>

  <div slot="how-to-use">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How to use the Regex Filter</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75; margin-bottom:0.75rem;">Enter a regular expression pattern in the pattern field. Toggle flags: <code style="background:var(--bg-surface-2); padding:0.1rem 0.3rem; border-radius:0.25rem;">g</code> for global (find all matches), <code style="background:var(--bg-surface-2); padding:0.1rem 0.3rem; border-radius:0.25rem;">i</code> for case-insensitive, <code style="background:var(--bg-surface-2); padding:0.1rem 0.3rem; border-radius:0.25rem;">m</code> for multiline. Paste your text and matches will be highlighted and listed in real time.</p>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">Useful for extracting data from logs, testing patterns against sample text, or learning regex.</p>
  </div>

  <div slot="how-it-works">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:0.75rem;">How it works</h2>
    <p style="color:var(--text-secondary); font-size:0.9rem; line-height:1.75;">The pattern is compiled using JavaScript's native <code style="background:var(--bg-surface-2); padding:0.1rem 0.3rem; border-radius:0.25rem;">RegExp</code> constructor with the selected flags. The text is split at match boundaries to interleave highlighted and unhighlighted spans. Any syntax error in the pattern is caught and displayed. Matching always includes the global flag for counting purposes.</p>
  </div>

  <div slot="faq">
    <h2 style="font-family:'Sora',sans-serif; font-size:1.2rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Frequently asked questions</h2>
    <div style="display:flex; flex-direction:column; gap:0.75rem;" itemscope itemtype="https://schema.org/FAQPage">
      {[
        { q: 'What does the \\b word boundary metacharacter do?', a: '\\b matches the position between a word character (\\w: letters, digits, underscore) and a non-word character. It does not consume any characters. \\bcat\\b matches "cat" but not "catfish" or "concatenate". It is useful for matching whole words only.' },
        { q: 'How do I match a literal dot or bracket?', a: 'Metacharacters (., *, +, ?, (, ), [, ], {, }, ^, $, |, \\) must be escaped with a backslash. To match a literal dot, use \\. To match a literal bracket, use \\[. In the pattern field, enter the backslash as a literal backslash character.' },
        { q: 'What is the difference between greedy and lazy matching?', a: 'Greedy quantifiers (*, +, {n,}) match as many characters as possible. Lazy quantifiers (*?, +?, {n,}?) match as few as possible. For example, on <b>bold</b>, the greedy <.+> matches the entire string, while the lazy <.+?> matches just <b>. Use lazy matching when extracting HTML tags or quoted strings.' },
        { q: 'Why are my newlines not matching?', a: 'By default, the dot (.) metacharacter does not match newline characters. To match any character including newlines, use [\\s\\S] instead of .. Enable the multiline flag (m) to make ^ and $ match the start and end of each line rather than the entire string.' },
      ].map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
          class="result-card">
          <h3 itemprop="name" style="font-size:0.9rem; font-weight:600; color:var(--text-primary); margin:0 0 0.5rem;">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" style="font-size:0.875rem; color:var(--text-secondary); line-height:1.7; margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<script>
  function esc(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function getFlags(): string {
    return Array.from(document.querySelectorAll('.flag-box'))
      .filter(el => (el as HTMLInputElement).checked)
      .map(el => (el as HTMLInputElement).value).join('');
  }

  function update() {
    const pattern = (document.getElementById('regex-input') as HTMLInputElement).value;
    const text    = (document.getElementById('text-input') as HTMLTextAreaElement).value;
    const errBox  = document.getElementById('regex-error') as HTMLElement;

    if (!pattern) {
      (document.getElementById('highlighted') as HTMLElement).textContent = text;
      (document.getElementById('matches-list') as HTMLElement).innerHTML = '';
      (document.getElementById('match-count') as HTMLElement).textContent = '0';
      return;
    }

    let flags = getFlags();
    if (!flags.includes('g')) flags += 'g';

    let re: RegExp;
    try {
      re = new RegExp(pattern, flags);
      errBox.style.display = 'none';
    } catch (e: any) {
      errBox.textContent = e.message;
      errBox.style.display = 'block';
      return;
    }

    const matches: string[] = [];
    let html = '';
    let lastIdx = 0;
    let m: RegExpExecArray | null;
    re.lastIndex = 0;

    while ((m = re.exec(text)) !== null) {
      html += esc(text.slice(lastIdx, m.index));
      html += `<mark style="background:#FEF08A;color:#713F12;border-radius:2px;padding:0 1px;">${esc(m[0])}</mark>`;
      matches.push(m[0]);
      lastIdx = re.lastIndex;
      if (!flags.includes('g')) break;
      if (re.lastIndex === m.index) re.lastIndex++;
    }
    html += esc(text.slice(lastIdx));

    (document.getElementById('highlighted') as HTMLElement).innerHTML = html;
    (document.getElementById('match-count') as HTMLElement).textContent = String(matches.length);

    const ml = document.getElementById('matches-list')!;
    ml.innerHTML = matches.map(m =>
      `<code style="background:#FEFCE8;border:1px solid #FEF08A;border-radius:0.375rem;padding:0.2rem 0.5rem;font-size:0.78rem;color:#713F12;">${esc(m)}</code>`
    ).join('');
  }

  document.getElementById('regex-input')?.addEventListener('input', update);
  document.getElementById('text-input')?.addEventListener('input', update);
  document.querySelectorAll('.flag-box').forEach(el => el.addEventListener('change', update));
  update();
</script>
