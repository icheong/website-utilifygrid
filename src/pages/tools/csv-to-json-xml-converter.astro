---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../data/tools.json';
const tool = tools.find(t => t.slug === 'csv-to-json-xml-converter')!;

const useCases = [
  {
    title: 'Data Migration and System Integration',
    desc: 'When migrating legacy systems to modern platforms, CSV exports from older databases often need to be transformed into JSON for REST API consumption or XML for SOAP-based services. This converter enables rapid transformation without writing custom scripts, reducing integration time from hours to minutes. A backend engineer moving data from an aging CRM into a microservices architecture can validate the structure visually before committing to a pipeline.'
  },
  {
    title: 'Configuration File Generation',
    desc: 'Many applications accept configuration in JSON or XML format. Instead of manually crafting these files from spreadsheet data, administrators can export settings from Excel or Google Sheets as CSV, paste them into the converter, and generate ready-to-use config files in seconds. This is especially useful for deploying environment-specific settings across staging and production environments without touching application code.'
  },
  {
    title: 'Academic Research and Data Analysis',
    desc: 'Researchers frequently collect survey data in CSV format but require JSON for use with JavaScript visualisation libraries (e.g., D3.js, Chart.js) or XML for metadata standards like TEI. The tool provides a quick, reliable bridge between collection and analysis pipelines. Because all processing is client-side, sensitive survey responses never touch a third-party server, satisfying institutional ethics board requirements.'
  }
];

const faqs = [
  {
    q: 'Does it handle quoted fields with commas inside?',
    a: 'Yes. The parser follows RFC 4180 and correctly handles fields wrapped in double quotes that contain commas or newlines. For example, a field like "New, York, USA" is parsed as a single column value rather than being split at the comma. Escaped double-quote sequences ("") inside quoted fields are also resolved to a literal quote character, ensuring data integrity across complex payloads.'
  },
  {
    q: 'What delimiter does it use?',
    a: 'The tool expects comma-delimited data as defined by RFC 4180. If your data uses tabs, semicolons, or pipes, you must convert the delimiter to a comma before pasting — this can be done quickly with a find-and-replace operation in any text editor or spreadsheet application. For TSV data, most spreadsheet tools offer a "Save As CSV" option that handles this conversion automatically.'
  },
  {
    q: 'Are numbers converted to JSON number type?',
    a: 'Currently all values are treated as strings for maximum compatibility and to preserve leading zeros or formatting. If you require numeric types in the JSON output, you can post-process the result using a simple JavaScript map or a schema-aware converter that includes type inference. This conservative approach avoids silent data corruption for identifiers like "00123" or ISO timestamps like "2024-01-01 00:00:00".'
  },
  {
    q: 'Is there a row or file size limit?',
    a: 'No hard limit is imposed — the tool runs entirely in your browser and will process as many rows as your device\'s memory allows. For very large files (e.g., >100,000 rows), performance may degrade due to DOM and V8 heap constraints; in such cases, consider a streaming Node.js solution using the csv-parse library or a server-side pipeline. Modern laptops handle files up to approximately 50,000 rows without noticeable lag.'
  },
  {
    q: 'Why does my XML output contain escaped characters like &lt; and &gt;?',
    a: 'XML requires certain characters to be escaped to maintain well-formed markup. The converter automatically replaces < with &lt;, > with &gt;, & with &amp;, and " with &quot; to ensure the output is valid XML. This escaping is reversible and does not alter the underlying data — any XML parser will decode these entities back to their original characters during consumption.'
  },
  {
    q: 'Can I convert CSV files that lack a header row?',
    a: 'The current implementation assumes the first row contains column headers, which become JSON object keys or XML element names. If your CSV lacks headers, insert a dummy header row (e.g., col1,col2,col3) before conversion, then rename the keys in the resulting JSON or XML as needed in a post-processing step. This approach keeps the tool lean and avoids ambiguous auto-naming heuristics.'
  }
];
---
<ToolLayout tool={tool}>

  <div slot="tool">
    <h2 class="font-display seo-h2">CSV to JSON &amp; XML Converter</h2>
    <p class="seo-p">
      Instantly convert CSV data into structured JSON or XML formats. This client-side tool parses comma-separated values according to RFC 4180 standards, handles quoted fields containing commas or newlines, and outputs clean, indented JSON or XML trees. All processing occurs entirely within your browser — no data is uploaded, stored, or transmitted — ensuring complete privacy for sensitive datasets.
    </p>

    <!-- Output format toggle -->
    <div class="toggle-group" role="group" aria-label="Output format">
      <button class="toggle-btn active" data-fmt="json" type="button">JSON</button>
      <button class="toggle-btn" data-fmt="xml" type="button">XML</button>
    </div>

    <div class="csv-grid">
      <div>
        <div class="csv-label-row">
          <label class="csv-label" for="csv-input">CSV Input</label>
          <button id="btn-sample" class="btn-secondary" type="button">Sample</button>
        </div>
        <textarea id="csv-input" class="input-themed csv-textarea"
          placeholder="name,age,city&#10;Alice,30,Sydney&#10;Bob,25,Melbourne"
          rows="10"
        ></textarea>
      </div>
      <div>
        <div class="csv-label-row">
          <label class="csv-label" for="out-area">Output</label>
          <button id="btn-copy" class="btn-secondary" type="button">Copy</button>
        </div>
        <textarea id="out-area" class="input-themed csv-textarea csv-output" readonly rows="10"
          placeholder="Output will appear here…"
        ></textarea>
      </div>
    </div>

    <div class="csv-actions">
      <button id="btn-convert" class="btn-primary" type="button">Convert</button>
      <button id="btn-clear" class="btn-secondary" type="button">Clear</button>
    </div>
    <p id="csv-error" class="csv-error-msg"></p>
  </div>

  <div slot="how-to-use">
    <h2 class="font-display seo-h2">Overview &amp; Technical Context</h2>
    <p class="seo-p">
      The CSV to JSON &amp; XML Converter is a lightweight, client-side utility designed for developers, data analysts, and anyone working with tabular data who needs to migrate CSV exports into formats suitable for APIs, configuration files, or document storage. Built with modern vanilla JavaScript and the browser's built-in string manipulation APIs, the tool operates with zero server calls — your CSV data never leaves your device, guaranteeing full compliance with GDPR, HIPAA, and other data-protection regulations.
    </p>
    <p class="seo-p">
      Unlike server-hosted converters that log uploaded files or impose size restrictions through paid tiers, this tool processes data entirely within the V8 JavaScript engine running in your browser tab. There is no authentication, no account creation, and no network latency — conversion of a 10,000-row dataset typically completes in under 50 milliseconds on a modern machine.
    </p>

    <h3 class="font-display seo-h3-sm">Real-World Applications &amp; Use Cases</h3>
    <div class="seo-cards-col">
      {useCases.map(({ title, desc }) => (
        <div class="border-theme surface-2 seo-card-sm">
          <strong style="color:var(--text-primary); font-size:0.875rem">{title}</strong>
          <p style="font-size:0.85rem; line-height:1.65; margin:0.35rem 0 0">{desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div slot="how-it-works">
    <h2 class="font-display seo-h2">Deep-Dive: Technical Mechanics &amp; Parsing Logic</h2>

    <h3 class="font-display seo-h3-sm">RFC 4180 State-Machine CSV Parser</h3>
    <p class="seo-p">
      The converter implements a character-by-character state-machine parser that adheres to RFC 4180, the de facto standard for CSV format. It tracks a single boolean <code class="inline-code">inQ</code> flag that toggles when a double-quote character is encountered. Commas and newlines are treated as field and row delimiters only when <code class="inline-code">inQ</code> is false, so values like <code class="inline-code">"New, York"</code> or multi-line addresses are preserved correctly. Escaped double quotes — represented as two consecutive quotes (<code class="inline-code">""</code>) — are collapsed to a single literal quote during parsing, matching the RFC specification exactly.
    </p>

    <h3 class="font-display seo-h3-sm">Header Detection and Conservative Type Handling</h3>
    <p class="seo-p">
      The first non-empty line is interpreted as the header row, providing field names for resulting JSON object keys or XML element tag names. Subsequent rows are mapped positionally to these headers; missing trailing fields default to empty strings rather than <code class="inline-code">null</code> or <code class="inline-code">undefined</code> to maintain consistent object shapes across the output array. All values are intentionally emitted as strings — this conservative approach prevents silent data corruption for identifiers like <code class="inline-code">"00123"</code>, boolean-looking strings like <code class="inline-code">"true"</code>, or ISO 8601 timestamps that some parsers incorrectly coerce to <code class="inline-code">Date</code> objects.
    </p>

    <h3 class="font-display seo-h3-sm">JSON and XML Output Formatting</h3>
    <p class="seo-p">
      For JSON output, the tool calls <code class="inline-code">JSON.stringify(data, null, 2)</code>, producing two-space indented, human-readable output. For XML, it constructs a <code class="inline-code">&lt;root&gt;</code> document with a <code class="inline-code">&lt;row&gt;</code> element per record and one child element per field, named after the trimmed header value. XML-unsafe characters are escaped before insertion: <code class="inline-code">&amp;</code> → <code class="inline-code">&amp;amp;</code>, <code class="inline-code">&lt;</code> → <code class="inline-code">&amp;lt;</code>, <code class="inline-code">&gt;</code> → <code class="inline-code">&amp;gt;</code>, and <code class="inline-code">"</code> → <code class="inline-code">&amp;quot;</code>. This escaping guarantees well-formed XML that passes strict schema validators without manual post-processing.
    </p>
  </div>

  <div slot="faq">
    <h2 class="font-display seo-h2-faq">Frequently Asked Questions</h2>
    <div class="seo-faq-list" itemscope itemtype="https://schema.org/FAQPage">
      {faqs.map(item => (
        <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question"
             class="surface-2 border-theme seo-faq-card">
          <h3 itemprop="name" class="seo-faq-q">{item.q}</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text" class="seo-faq-a">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

</ToolLayout>

<style>
  .csv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.875rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 600px) {
    .csv-grid { grid-template-columns: 1fr; }
  }
  .csv-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
  }
  .csv-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .csv-textarea {
    width: 100%;
    box-sizing: border-box;
    resize: vertical;
    border-radius: 0.625rem;
    padding: 0.875rem 1rem;
    font-family: 'Fira Code', monospace;
    font-size: 0.78rem;
    line-height: 1.65;
  }
  .csv-output {
    background: var(--bg-surface-2);
  }
  .csv-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .csv-error-msg {
    display: none;
    color: #EF4444;
    font-size: 0.82rem;
    margin-top: 0.75rem;
  }
  .seo-cards-col {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
  }
  .seo-faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>

<script>
  const SAMPLE = `name,age,city,active\nAlice,30,Sydney,true\nBob,25,Melbourne,false\nCarol,35,Brisbane,true`;
  let fmt = 'json';

  const fmtBtns = document.querySelectorAll<HTMLButtonElement>('[data-fmt]');
  fmtBtns.forEach(btn => btn.addEventListener('click', () => {
    fmt = btn.dataset.fmt!;
    fmtBtns.forEach(b => { b.classList.toggle('active', b.dataset.fmt === fmt); });
    convert();
  }));

  function parseCSV(text: string): string[][] {
    const rows: string[][] = [];
    let field = '', row: string[] = [], inQ = false;
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (inQ) {
        if (c === '"' && text[i+1] === '"') { field += '"'; i++; }
        else if (c === '"') inQ = false;
        else field += c;
      } else {
        if (c === '"') inQ = true;
        else if (c === ',') { row.push(field); field = ''; }
        else if (c === '\n') { row.push(field); rows.push(row); field = ''; row = []; }
        else if (c !== '\r') field += c;
      }
    }
    if (field || row.length) { row.push(field); rows.push(row); }
    return rows.filter(r => r.some(f => f.trim()));
  }

  function convert() {
    const raw = (document.getElementById('csv-input') as HTMLTextAreaElement).value;
    const err = document.getElementById('csv-error')!;
    const out = document.getElementById('out-area') as HTMLTextAreaElement;
    err.style.display = 'none';
    if (!raw.trim()) { out.value = ''; return; }
    try {
      const rows = parseCSV(raw.trim());
      if (rows.length < 2) { err.textContent = 'Need at least a header row and one data row.'; err.style.display='block'; return; }
      const headers = rows[0];
      const data = rows.slice(1).map(r => {
        const obj: Record<string,string> = {};
        headers.forEach((h,i) => { obj[h.trim()] = (r[i] || '').trim(); });
        return obj;
      });
      if (fmt === 'json') {
        out.value = JSON.stringify(data, null, 2);
      } else {
        const lines = ['<?xml version="1.0" encoding="UTF-8"?>', '<root>'];
        data.forEach(obj => {
          lines.push('  <row>');
          Object.entries(obj).forEach(([k,v]) => { lines.push(`    <${k}>${escXml(v)}</${k}>`); });
          lines.push('  </row>');
        });
        lines.push('</root>');
        out.value = lines.join('\n');
      }
    } catch(e) { err.textContent = 'Parse error: ' + (e as Error).message; err.style.display='block'; }
  }

  function escXml(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  document.getElementById('btn-convert')!.addEventListener('click', convert);
  document.getElementById('csv-input')!.addEventListener('input', convert);
  document.getElementById('btn-sample')!.addEventListener('click', () => {
    (document.getElementById('csv-input') as HTMLTextAreaElement).value = SAMPLE;
    convert();
  });
  document.getElementById('btn-clear')!.addEventListener('click', () => {
    (document.getElementById('csv-input') as HTMLTextAreaElement).value = '';
    (document.getElementById('out-area') as HTMLTextAreaElement).value = '';
    const err = document.getElementById('csv-error')!;
    err.style.display = 'none';
  });
  document.getElementById('btn-copy')!.addEventListener('click', () => {
    const btn = document.getElementById('btn-copy')!;
    navigator.clipboard.writeText((document.getElementById('out-area') as HTMLTextAreaElement).value).then(() => {
      btn.textContent = '✓ Copied!'; btn.classList.add('btn-success');
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('btn-success'); }, 2000);
    });
  });
</script>
