---
import BaseLayout from '../../layouts/BaseLayout.astro';
import tools from '../../data/tools.json';
import categories from '../../data/categories.json';

export async function getStaticPaths() {
  return categories.map(cat => ({
    params: { category: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const categoryTools = tools.filter(t => t.category === category.slug);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${category.name} – Free Online Tools`,
  "description": category.description,
  "url": `https://utilifygrid.com/category/${category.slug}`,
  "hasPart": categoryTools.map(t => ({
    "@type": "WebApplication",
    "name": t.name,
    "url": `https://utilifygrid.com/tools/${t.slug}`
  }))
};
---

<BaseLayout
  title={`${category.name} – Free Online Tools | UtilifyGrid`}
  description={category.description}
  canonicalUrl={`/category/${category.slug}`}
  structuredData={structuredData}
>
  <div style="max-width:80rem; margin:0 auto; padding:2.5rem 1rem 3rem;">

    <!-- Breadcrumb -->
    <nav style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1.5rem;" aria-label="Breadcrumb">
      <ol style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap; list-style:none; padding:0; margin:0;">
        <li><a href="/" style="color:var(--text-secondary); text-decoration:none; transition:color 0.15s;"
          onmouseover="this.style.color='#1D4ED8';" onmouseout="this.style.color='var(--text-secondary)';">Home</a></li>
        <li style="color:var(--text-muted);">›</li>
        <li style="color:var(--text-primary); font-weight:500;">{category.name}</li>
      </ol>
    </nav>

    <!-- Header -->
    <div style="margin-bottom:2rem;">
      <div style="display:flex; align-items:center; gap:0.875rem; margin-bottom:0.625rem;">
        <span style="font-size:2.75rem;">{category.icon}</span>
        <h1 style="font-family:'Sora',sans-serif; font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:var(--text-primary); margin:0;">{category.name}</h1>
      </div>
      <p style="color:var(--text-secondary); max-width:42rem; font-size:0.95rem; line-height:1.65; margin:0 0 0.375rem;">{category.description}</p>
      <p style="font-size:0.8rem; color:var(--text-muted); margin:0;">{categoryTools.length} tool{categoryTools.length !== 1 ? 's' : ''} available</p>
    </div>

    <!-- Tools grid -->
    {categoryTools.length > 0 ? (
      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); gap:1.125rem;">
        {categoryTools.map(tool => (
          <div class="tool-card-themed cat-card-wrap">
            <a
              href={`/tools/${tool.slug}`}
              style="display:flex; align-items:flex-start; gap:1rem; padding:1.125rem 1.25rem; text-decoration:none; padding-right:2.75rem;"
            >
              <span style="font-size:2rem; flex-shrink:0; line-height:1;">{tool.icon}</span>
              <div>
                <div style="font-weight:600; color:var(--text-primary); font-size:0.925rem; line-height:1.3; margin-bottom:0.3rem;">{tool.name}</div>
                <p style="font-size:0.8rem; color:var(--text-secondary); margin:0; line-height:1.5;">{tool.shortDescription}</p>
              </div>
            </a>
            <!-- Star button — z-index:1 keeps it above the <a> layer -->
            <button
              class="cat-star-btn"
              data-fav-slug={tool.slug}
              data-tool-name={tool.name}
              aria-pressed="false"
              aria-label={`Save ${tool.name} to favourites`}
              title="Save to favourites"
            >
              <svg width="14" height="14" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 1.5l2.22 4.52 4.99.72-3.61 3.52.85 4.97L9 12.77l-4.45 2.46.85-4.97L1.79 6.74l4.99-.72L9 1.5z"/>
              </svg>
            </button>
          </div>
        ))}
      </div>
    ) : (
      <div style="text-align:center; padding:5rem 1rem; color:var(--text-muted);">
        <div style="font-size:3rem; margin-bottom:1rem;">🚧</div>
        <p style="font-size:1rem; font-weight:600; color:var(--text-secondary); margin:0 0 0.375rem;">Coming soon</p>
        <p style="font-size:0.875rem; margin:0;">Tools for this category are on the way.</p>
      </div>
    )}

    <!-- Other categories -->
    <div style="margin-top:3.5rem; padding-top:2rem; border-top:1px solid var(--border);">
      <h2 style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:var(--text-primary); margin-bottom:1.25rem;">Browse Other Categories</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(130px,1fr)); gap:0.75rem;">
        {categories
          .filter(c => c.slug !== category.slug)
          .map(cat => (
            <a
              href={`/category/${cat.slug}`}
              class="tool-card-themed"
              style="display:flex; flex-direction:column; align-items:center; text-align:center; padding:1rem 0.75rem; text-decoration:none; gap:0.35rem;"
            >
              <span style="font-size:1.75rem; line-height:1;">{cat.icon}</span>
              <span style="font-size:0.78rem; font-weight:600; color:var(--text-primary); line-height:1.3;">{cat.name}</span>
            </a>
          ))}
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  /* Wrapper carries the card chrome so hover works on the whole card */
  .cat-card-wrap {
    position: relative;
  }
  /* Make the <a> fill the card without being a positioned element (avoids z-index fight) */
  .cat-card-wrap > a {
    display: block;
    text-decoration: none;
  }

  /* Star button on category cards */
  .cat-star-btn {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    z-index: 1;           /* sits above the <a> layer */
    width: 28px;
    height: 28px;
    border-radius: 0.4rem;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.15s, color 0.15s, background 0.15s, border-color 0.15s, transform 0.15s;
  }
  /* Show on wrapper hover OR when already saved */
  .cat-card-wrap:hover .cat-star-btn,
  .cat-star-btn.fav-active {
    opacity: 1;
  }
  .cat-star-btn:hover {
    color: #F59E0B;
    background: rgba(245,158,11,0.08);
    border-color: rgba(245,158,11,0.4);
    transform: scale(1.1);
  }
  .cat-star-btn.fav-active {
    color: #F59E0B;
    background: rgba(245,158,11,0.1);
    border-color: rgba(245,158,11,0.4);
  }
  .cat-star-btn.fav-active svg { fill: #F59E0B; }

  @keyframes favPop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.4); }
    70%  { transform: scale(0.9); }
    100% { transform: scale(1); }
  }
  .fav-pop { animation: favPop 0.35s ease; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cat-star-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const favs = (window as any).UGFavs;
      if (!favs) return;
      favs.toggle(btn.dataset.favSlug!);
      btn.classList.remove('fav-pop');
      void (btn as HTMLElement).offsetWidth;
      btn.classList.add('fav-pop');
      btn.addEventListener('animationend', () => btn.classList.remove('fav-pop'), { once: true });
    });
  });
</script>
