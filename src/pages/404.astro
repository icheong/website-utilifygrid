---
import BaseLayout from '../layouts/BaseLayout.astro';
import tools from '../data/tools.json';
import categories from '../data/categories.json';

const featuredTools = tools.filter(t => t.featured).slice(0, 6);
---

<BaseLayout
  title="Page Not Found | UtilifyGrid"
  description="The page you're looking for doesn't exist. Browse our free browser-based tools — calculators, converters, and developer utilities."
  canonicalUrl="/404"
>
  <div style="max-width:48rem; margin:0 auto; padding:4rem 1rem; text-align:center;">

    <div style="font-size:4rem; margin-bottom:1rem;">🔍</div>
    <h1 style="font-family:'Sora',sans-serif; font-size:2rem; font-weight:700; color:var(--text-primary); margin:0 0 0.5rem;">Page not found</h1>
    <p style="font-size:1rem; color:var(--text-secondary); margin:0 0 2rem; max-width:32rem; margin-left:auto; margin-right:auto; line-height:1.65;">
      The page you requested doesn't exist or may have been moved. Try searching for a tool below or browse by category.
    </p>

    <!-- Search box -->
    <div style="max-width:28rem; margin:0 auto 3rem;">
      <div style="position:relative;">
        <input
          id="search-404"
          type="text"
          placeholder="Search tools…"
          style="width:100%; padding:0.875rem 1.25rem 0.875rem 3rem; border:1.5px solid var(--border); border-radius:0.75rem; background:var(--bg-surface); color:var(--text-primary); font-size:0.95rem; outline:none; box-sizing:border-box; transition:border-color 0.15s;"
          onfocus="this.style.borderColor='#1D4ED8';"
          onblur="this.style.borderColor='var(--border)';"
        />
        <svg style="position:absolute; left:1rem; top:50%; transform:translateY(-50%); color:var(--text-muted);" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </div>
      <div id="search-results-404" style="display:none; margin-top:0.5rem; background:var(--bg-surface); border:1.5px solid var(--border); border-radius:0.75rem; overflow:hidden; text-align:left;"></div>
    </div>

    <!-- Featured tools -->
    <div style="margin-bottom:3rem;">
      <h2 style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:var(--text-primary); margin-bottom:1rem;">Popular tools</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px,1fr)); gap:0.875rem;">
        {featuredTools.map(tool => (
          <a
            href={`/tools/${tool.slug}`}
            class="tool-card-themed"
            style="display:flex; align-items:center; gap:0.75rem; padding:0.875rem 1rem; text-decoration:none; text-align:left;"
          >
            <span style="font-size:1.5rem; flex-shrink:0;">{tool.icon}</span>
            <div>
              <div style="font-weight:600; color:var(--text-primary); font-size:0.85rem; line-height:1.3;">{tool.name}</div>
              <div style="font-size:0.75rem; color:var(--text-muted); line-height:1.4; margin-top:0.15rem;">{tool.shortDescription}</div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Categories -->
    <div>
      <h2 style="font-family:'Sora',sans-serif; font-size:1rem; font-weight:700; color:var(--text-primary); margin-bottom:1rem;">Browse by category</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(130px,1fr)); gap:0.75rem;">
        {categories.map(cat => (
          <a
            href={`/category/${cat.slug}`}
            class="tool-card-themed"
            style="display:flex; flex-direction:column; align-items:center; text-align:center; padding:1rem 0.75rem; text-decoration:none; gap:0.35rem;"
          >
            <span style="font-size:1.75rem; line-height:1;">{cat.icon}</span>
            <span style="font-size:0.78rem; font-weight:600; color:var(--text-primary); line-height:1.3;">{cat.name}</span>
          </a>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>

<script define:vars={{ tools }}>
  (function() {
    var input = document.getElementById('search-404');
    var resultsBox = document.getElementById('search-results-404');
    if (!input || !resultsBox) return;

    var allTools = tools;

    input.addEventListener('input', function() {
      var q = input.value.trim().toLowerCase();
      if (q.length < 2) { resultsBox.style.display = 'none'; return; }

      var matches = allTools.filter(function(t) {
        return t.name.toLowerCase().includes(q) ||
               t.slug.includes(q) ||
               t.shortDescription.toLowerCase().includes(q) ||
               t.tags.some(function(tag) { return tag.includes(q); });
      }).slice(0, 8);

      if (matches.length === 0) { resultsBox.style.display = 'none'; return; }

      resultsBox.innerHTML = matches.map(function(t) {
        return '<a href="/tools/' + t.slug + '" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;text-decoration:none;border-bottom:1px solid var(--border);transition:background 0.12s;" onmouseover="this.style.background=\'var(--bg-surface-2)\'" onmouseout="this.style.background=\'transparent\'">' +
          '<span style="font-size:1.25rem;">' + t.icon + '</span>' +
          '<div><div style="font-weight:600;color:var(--text-primary);font-size:0.85rem;">' + t.name + '</div>' +
          '<div style="font-size:0.75rem;color:var(--text-muted);">' + t.shortDescription + '</div></div></a>';
      }).join('');
      resultsBox.style.display = 'block';
    });

    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        var q = input.value.trim().toLowerCase();
        var match = allTools.find(function(t) {
          return t.name.toLowerCase() === q || t.slug === q;
        });
        if (match) window.location.href = '/tools/' + match.slug;
      }
    });

    document.addEventListener('click', function(e) {
      if (!resultsBox.contains(e.target) && e.target !== input) {
        resultsBox.style.display = 'none';
      }
    });
  })();
</script>
